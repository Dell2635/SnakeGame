                ls = sf.render(line, True, (170, 225, 255))
                self.screen.blit(ls, (p2_box.x + 18, p2_box.y + 48 + i * 33))
            pygame.draw.rect(self.screen, (0, 200, 230),
                pygame.Rect(p2_box.x + 18, p2_box.y + 162, 22, 22), border_radius=4)
            sw_lbl2 = sf.render("Your snake colour", True, (160, 225, 255))
            self.screen.blit(sw_lbl2, (p2_box.x + 46, p2_box.y + 165))

            # ── Seed input ──────────────────────────────────────────────
            seed_lbl_y = int(sh * 0.50)
            seed_lbl_s = sf.render("Seed (leave blank for random):", True, COLORS['light_gray'])
            self.screen.blit(seed_lbl_s,
