    def _run_network_result(self, result):
        """Start the match a finished lobby produced (duel or 3-4 player room)."""
        is_host, conn, net_mode, net_custom_map, net_seed = result
        _save_game_settings('multiplayer_lan', {
            **_load_game_settings('multiplayer_lan', {}),
            'mode': net_mode,
            'seed_mode': 'custom' if net_seed else 'random',
            'seed_value': str(net_seed or '') if net_seed else '',
            'map': net_custom_map,
            'map_hash': _map_fingerprint(net_custom_map),
        })
        lobby = self.network_lobby
        if isinstance(conn, dict) and conn.get('kind') == 'n':
            if is_host:
                match = NetworkMatchN(
                    self.settings, self.screen, True, net_mode, net_seed, net_custom_map,
                    conn['names'], 0, links=[entry['link'] for entry in conn['roster']],
                    tunnel_session=lobby._pending_tunnel_session, session=lobby._pending_session)
                match._announce_start()
            else:
                match = NetworkMatchN(
                    self.settings, self.screen, False, net_mode, net_seed, net_custom_map,
                    conn['names'], conn['you'], link=conn['link'], session=conn['link']._session)
            players = match.count
        else:
            match = NetworkGame(
                self.settings, self.screen, is_host, conn, net_mode,
                custom_map=net_custom_map, seed=net_seed,
                tunnel_session=lobby._pending_tunnel_session,
                session=lobby._pending_session)
            players = 2
        lobby._pending_tunnel_session = None
        lobby._pending_session = None
        match.runtime = self.runtime
        self.runtime.run_game(
            "network_game", match.run,
            metadata={'mode': net_mode, 'is_host': is_host, 'seed': net_seed, 'players': players},
            surface_owner=match)

