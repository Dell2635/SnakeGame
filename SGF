if not getattr(SnakeAI, '_dev_wrapped', False):
    _original_snake_ai_choose_direction = SnakeAI.choose_direction
    def _dev_choose_direction(self, *args, **kwargs):
        dev = globals().get('DEV_TOOLS')
        if dev is None or not dev.active:
            return _original_snake_ai_choose_direction(self, *args, **kwargs)
        started = time.perf_counter()
        result = _original_snake_ai_choose_direction(self, *args, **kwargs)
        try:
            snake = args[0] if args else kwargs.get('snake', [])
            occupied = args[1] if len(args) > 1 else kwargs.get('occupied', [])
            fruit = args[2] if len(args) > 2 else kwargs.get('fruit')
            bw = args[3] if len(args) > 3 else kwargs.get('board_w', 0)
            bh = args[4] if len(args) > 4 else kwargs.get('board_h', 0)
            wall = kwargs.get('wall_collision', True)
            blocked = set(map(tuple, occupied))
            if len(snake) > 1: blocked.update(map(tuple, snake[1:]))
            candidates = []
            for d in SnakeAI.DIRS:
                nxt = self._step(tuple(snake[0]), d, (bw, bh, wall)) if snake else None
                safe = nxt is not None and nxt not in blocked
                score = -1.0
                if safe:
                    score = -float(abs(nxt[0]-fruit[0]) + abs(nxt[1]-fruit[1])) if fruit else 0.0
                candidates.append((d, nxt, score))
            target = None
            try:
                target = self._best_target(tuple(snake[0]), fruit, kwargs.get('powerup_pos'), (bw, bh, wall), margin=2)
            except Exception:
                target = fruit
            path = []
            if target is not None and snake:
                try:
                    path = self._bfs(tuple(snake[0]), tuple(target), blocked, (bw, bh, wall), {}, shuffle=False) or []
                except Exception:
                    path = []
            self.debug_info = {
                'chosen': result, 'target': target, 'path': path,
                'candidates': candidates, 'head': tuple(snake[0]) if snake else None,
                'duration_ms': (time.perf_counter() - started) * 1000.0,
                'difficulty': getattr(self, 'difficulty', 'N/A'),
            }
            dev.ai_debug_history.append(copy.deepcopy(self.debug_info))
        except Exception:
            pass
        return result
    SnakeAI.choose_direction = _dev_choose_direction
    SnakeAI._dev_wrapped = True


