def _map_path(map_name):
    # A digest keeps filenames short and stable for Unicode names and avoids
    # collisions between names that sanitize to the same Windows filename.
    digest = hashlib.sha256(str(map_name).encode('utf-8')).hexdigest()[:24]
    return os.path.join(_user_data_manager.get_maps_created_dir(), f'map_{digest}.json')


def _save_replay_file(replay_id, payload):
    path = _replay_path(replay_id)
    _atomic_write_json(path, payload)
    with open(path, 'r', encoding='utf-8') as replay_file:
        saved = json.load(replay_file)
    if not isinstance(saved, dict) or not isinstance(saved.get('events'), list):
        raise ValueError('Saved replay failed validation')
    return path


def _load_replay_file(replay_id):
    if not replay_id:
        return None
    compressed_path = _compressed_replay_path(replay_id)
    path = compressed_path if os.path.isfile(compressed_path) else _replay_path(replay_id)
    try:
        if path == compressed_path:
            with gzip.open(path, 'rt', encoding='utf-8') as replay_file:
                payload = json.load(replay_file)
        else:
            with open(path, 'r', encoding='utf-8') as replay_file:
                payload = json.load(replay_file)
        return payload if isinstance(payload, dict) and isinstance(payload.get('events'), list) else None
    except (OSError, EOFError, gzip.BadGzipFile, ValueError, TypeError):
        return None


