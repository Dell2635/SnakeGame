    except (KeyError, IndexError, ValueError):
        return text


def _replay_display_name(replay_id):
    """'2026-10-08T15-18-21.725715_game' -> '08/10/2026 - 15:18:21.725715'."""
    stamp = str(replay_id).split('_', 1)[0]
    try:
        day, clock = stamp.split('T', 1)
        year, month, dom = day.split('-')
        hh, mm, rest = clock.split('-', 2)
        int(year), int(month), int(dom), int(hh), int(mm)
        return f"{dom}/{month}/{year} - {hh}:{mm}:{rest}"
    except (ValueError, AttributeError):
        return str(replay_id)


def replay_storage_scan(directory=None, referenced_ids=None):
    """List replay files. `referenced_ids` is the set of replay ids that high
    scores still point to, or None when that is unknown (then nothing is ever
    reported as removable)."""
    directory = directory or _user_data_manager.get_replay_dir()
    entries, by_id, extras = [], {}, []
    try:
        names = sorted(os.listdir(directory))
    except OSError:
        return {'replays': [], 'temp_files': [], 'duplicates': []}
    for name in names:
        full = os.path.join(directory, name)
        if not os.path.isfile(full) or os.path.islink(full):
            continue
        if name.endswith('.tmp') or name.endswith('.part'):
            extras.append({'path': full, 'size': os.path.getsize(full)})
            continue
        if not name.startswith('replay_'):
            continue
        if name.endswith('.json.gz'):
            replay_id, compressed = name[len('replay_'):-len('.json.gz')], True
        elif name.endswith('.json'):
            replay_id, compressed = name[len('replay_'):-len('.json')], False
        else:
            continue
        try:
            stat = os.stat(full)
        except OSError:
            continue
        entry = {'id': replay_id, 'path': full, 'size': stat.st_size,
                 'mtime': stat.st_mtime, 'compressed': compressed,
                 'name': _replay_display_name(replay_id),
                 'referenced': (None if referenced_ids is None
                                else replay_id in referenced_ids)}
        if replay_id in by_id:
            # Both replay_<id>.json and .json.gz exist: keep the compressed
            # one as the replay, the plain copy is redundant.
            first = by_id[replay_id]
            keep, drop = (entry, first) if compressed else (first, entry)
            by_id[replay_id] = keep
            extras.append({'path': drop['path'], 'size': drop['size'], 'duplicate': True})
        else:
            by_id[replay_id] = entry
    entries = sorted(by_id.values(), key=lambda e: e['name'])
    return {'replays': entries,
            'temp_files': [e for e in extras if not e.get('duplicate')],
            'duplicates': [e for e in extras if e.get('duplicate')]}


def replay_storage_referenced_ids():
    """Replay ids still referenced by high scores, or None if unreadable."""
    try:
        data = _load_data()
        scores = data.get('highscores', []) if isinstance(data, dict) else None
        if not isinstance(scores, list):
            return None
        return {score.get('replay_id') for score in scores
                if isinstance(score, dict) and score.get('replay_id')}
    except Exception:
        return None


def replay_storage_clean_candidates(scan):
    """Files Clean would remove: leftovers, redundant copies, orphaned replays."""
    items = [dict(item, reason='temp') for item in scan['temp_files']]
    items += [dict(item, reason='duplicate') for item in scan['duplicates']]
    items += [dict(entry, reason='orphan') for entry in scan['replays']
              if entry['referenced'] is False]
    return items


def replay_storage_estimate_clean(scan):
    items = replay_storage_clean_candidates(scan)
    return len(items), sum(item['size'] for item in items)


def replay_storage_clean(scan):
    """Delete the clean candidates. Returns (files_removed, bytes_freed)."""
    removed = freed = 0
    for item in replay_storage_clean_candidates(scan):
        try:
            os.remove(item['path'])
            removed += 1
            freed += item['size']
        except OSError as exc:
            _logging_mod.getLogger('sgf').warning('Clean could not remove %s: %s', item['path'], exc)
    return removed, freed


def replay_storage_delete(entries):
    """Delete the chosen replays. High scores keep their entry; they simply
    no longer have a replay (`_score_has_replay` checks the file)."""
    removed = freed = 0
    for entry in entries:
        for path in (entry['path'], entry['path'][:-3] if entry['path'].endswith('.gz') else entry['path'] + '.gz'):
            try:
                size = os.path.getsize(path)
                os.remove(path)
                removed += 1
                freed += size
            except OSError:
                pass
    return removed, freed


def _replay_read_payload(entry):
    opener = (lambda: gzip.open(entry['path'], 'rt', encoding='utf-8')) if entry['compressed'] \
        else (lambda: open(entry['path'], 'r', encoding='utf-8'))
    with opener() as handle:
        payload = json.load(handle)
    if not isinstance(payload, dict) or not isinstance(payload.get('events'), list):
        raise ValueError('Replay failed validation')
    return payload


def replay_storage_rewrite(entry, level):
    """Re-serialise one replay in compact form. level=None keeps it as plain
    JSON, otherwise gzip at that level. The new file is verified by reading it
    back; the original is only replaced/removed afterwards and only when the
    result is not larger. Returns bytes saved (>= 0)."""
    payload = _replay_read_payload(entry)
    raw = json.dumps(payload, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
    data = raw if level is None else gzip.compress(raw, compresslevel=level, mtime=0)
    new_path = (entry['path'][:-3] if entry['path'].endswith('.gz') else entry['path']) \
        + ('' if level is None else '.gz')
    if len(data) >= entry['size'] and new_path == entry['path']:
        return 0
    if len(data) >= entry['size'] and level is not None and not entry['compressed']:
        return 0
    _atomic_write_bytes(new_path, data)
    check_entry = dict(entry, path=new_path, compressed=level is not None)
    if _replay_read_payload(check_entry) != payload:
        try:
            if new_path != entry['path']:
                os.remove(new_path)
        except OSError:
            pass
        raise ValueError('Rewritten replay differs from the original')
    if new_path != entry['path']:
        os.remove(entry['path'])
    return max(0, entry['size'] - len(data))


def replay_storage_estimate_compress(scan, profile='balanced', sample=4):
    """Estimated bytes saved by Compress (a '~' value: measured on a sample of
    the smallest files, then scaled to every replay)."""
    level = REPLAY_COMPRESSION_PROFILES.get(profile, 6)
    entries = [e for e in scan['replays'] if e['size'] > 0]
    probe = sorted(entries, key=lambda e: e['size'])[:max(1, sample)]
    before = after = 0
    for entry in probe:
        try:
            payload = _replay_read_payload(entry)
            raw = json.dumps(payload, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
            before += entry['size']
            after += min(entry['size'], len(gzip.compress(raw, compresslevel=level, mtime=0)))
        except Exception:
            continue
    if before <= 0:
        return 0
    ratio = after / before
    return int(sum(e['size'] for e in entries) * max(0.0, 1.0 - ratio))


def replay_storage_compress(entries, profile='balanced', progress=None):
    """Compress/recompress replays (also normalises their layout). Returns
    {'saved': bytes, 'done': n, 'errors': n}. Safe to run in a worker."""
    level = REPLAY_COMPRESSION_PROFILES.get(profile, 6)
    result = {'saved': 0, 'done': 0, 'errors': 0}
    for index, entry in enumerate(entries):
        try:
            result['saved'] += replay_storage_rewrite(entry, level)
            result['done'] += 1
        except Exception as exc:
            result['errors'] += 1
            _logging_mod.getLogger('sgf').warning('Replay compress failed for %s: %s', entry['id'], exc)
        if progress:
            progress(index + 1, len(entries))
    return result


def replay_storage_organize(entries, progress=None):
    """Compact each replay's layout without changing its compression state."""
    result = {'saved': 0, 'done': 0, 'errors': 0}
    for index, entry in enumerate(entries):
        try:
            result['saved'] += replay_storage_rewrite(entry, 6 if entry['compressed'] else None)
            result['done'] += 1
        except Exception as exc:
            result['errors'] += 1
            _logging_mod.getLogger('sgf').warning('Replay organise failed for %s: %s', entry['id'], exc)
        if progress:
            progress(index + 1, len(entries))
    return result


def _migrate_embedded_content(data):
    """Move legacy embedded replays and user maps to their own files.

    Source data is retained unless every extracted file validates, a backup is
    written, and the reduced JSON commits atomically. The migration is safe to
    retry after interruption because each destination has a stable identifier.
    """
    if not isinstance(data, dict):
        return data
    marker = os.path.join(_user_data_manager.get_config_dir(), '.content_files_migrated')
    if os.path.exists(marker):
        return _upgrade_content_schema(data)

    with _content_migration_lock:
        if os.path.exists(marker):
            return _upgrade_content_schema(data)
        updated = copy.deepcopy(data)
        changed = False
        backup_path = None
        commit_started = False
        try:
            highscores = updated.get('highscores', [])
            if isinstance(highscores, list):
                for index, score in enumerate(highscores):
                    if not isinstance(score, dict):
                        continue
                    history = score.get('game_history')
                    if not isinstance(history, list) or not history:
                        history = score.get('mp_history')
                    if isinstance(history, list) and history:
                        replay_id = _score_replay_id(score, 'legacy-' + hashlib.sha256(
                            f'{index}:{score.get("date", "")}'.encode('utf-8')).hexdigest()[:20])
                        _save_replay_file(replay_id, _score_replay_payload(score, history))
                        score['replay_id'] = replay_id
                        score['has_replay'] = True
                        changed = True
                    else:
                        if 'game_history' in score or 'mp_history' in score:
                            score['has_replay'] = False
                            changed = True
                    if 'game_history' in score or 'mp_history' in score:
                        score.pop('game_history', None)
                        score.pop('mp_history', None)
                        changed = True
                    if 'custom_map' in score:
                        # A score without a replay cannot use this snapshot;
                        # custom maps themselves are stored in maps/created.
                        score.pop('custom_map', None)
                        changed = True

            legacy_maps = updated.get('custom_maps', {})
            if isinstance(legacy_maps, dict):
                saved_maps = _load_custom_maps()
                for name, payload in legacy_maps.items():
                    if not isinstance(name, str) or not isinstance(payload, dict):
                        raise ValueError('Legacy map record is invalid')
                    if name not in saved_maps:
                        _save_custom_map_file(name, payload)
                updated.pop('custom_maps', None)
                if 'custom_maps' in data:
                    changed = True

            if os.path.isfile(_DATA_FILE) and updated.get(_SCHEMA_VERSION_KEY, 1) < SAVE_FORMAT_VERSION:
                updated[_SCHEMA_VERSION_KEY] = SAVE_FORMAT_VERSION
                updated['save_format_version'] = SAVE_FORMAT_VERSION
                changed = True

            if changed:
                source = _DATA_FILE
                if os.path.isfile(source):
                    backup_root = _user_data_manager.get_backup_dir()
                    stamp = datetime.now().strftime('%Y%m%d_%H%M%S_%f')
                    backup_path = os.path.join(backup_root, f'pre_content_split_{stamp}.json')
                    import shutil as _shutil
                    _shutil.copy2(source, backup_path)
                    with open(backup_path, 'r', encoding='utf-8') as backup_file:
                        if not isinstance(json.load(backup_file), dict):
                            raise ValueError('Content migration backup failed validation')
                commit_started = True
                _atomic_write_json(_DATA_FILE, updated)
                with open(_DATA_FILE, 'r', encoding='utf-8') as verify_file:
                    verified = json.load(verify_file)
                if not isinstance(verified, dict):
                    raise ValueError('Migrated data did not validate')
                if any(isinstance(s, dict) and ('game_history' in s or 'mp_history' in s)
                       for s in verified.get('highscores', [])):
                    raise ValueError('Replay migration left inline histories behind')
                if 'custom_maps' in verified:
                    raise ValueError('Map migration left inline maps behind')
                data = verified

            os.makedirs(os.path.dirname(marker), exist_ok=True)
            with open(marker, 'w', encoding='utf-8') as marker_file:
                marker_file.write(datetime.now().isoformat())
        except Exception as exc:
            if commit_started and backup_path and os.path.isfile(backup_path):
                try:
                    with open(backup_path, 'r', encoding='utf-8') as backup_file:
                        original = json.load(backup_file)
                    _atomic_write_json(_DATA_FILE, original)
                except Exception as restore_exc:
                    _logging_mod.getLogger('sgf').critical('Could not restore pre-migration JSON from backup: %s', restore_exc)
            _logging_mod.getLogger('sgf').exception('Embedded content migration deferred: %s', exc)
    return data


def _upgrade_content_schema(data):
    """Record the separated-content schema after its one-time migration."""
    if not isinstance(data, dict) or data.get(_SCHEMA_VERSION_KEY, 1) >= SAVE_FORMAT_VERSION:
        return data
    if not os.path.isfile(_DATA_FILE):
        return data
    backup_path = None
    try:
        updated = copy.deepcopy(data)
        updated[_SCHEMA_VERSION_KEY] = SAVE_FORMAT_VERSION
        updated['save_format_version'] = SAVE_FORMAT_VERSION
        backup_root = _user_data_manager.get_backup_dir()
        stamp = datetime.now().strftime('%Y%m%d_%H%M%S_%f')
        backup_path = os.path.join(backup_root, f'pre_schema_upgrade_{stamp}.json')
        import shutil as _shutil
        _shutil.copy2(_DATA_FILE, backup_path)
        with open(backup_path, 'r', encoding='utf-8') as backup_file:
            if not isinstance(json.load(backup_file), dict):
                raise ValueError('Schema-upgrade backup failed validation')
        _atomic_write_json(_DATA_FILE, updated)
        with open(_DATA_FILE, 'r', encoding='utf-8') as upgraded_file:
            verified = json.load(upgraded_file)
        if verified.get(_SCHEMA_VERSION_KEY) != SAVE_FORMAT_VERSION:
            raise ValueError('Schema upgrade failed validation')
        return verified
    except Exception as exc:
        if backup_path and os.path.isfile(backup_path):
            try:
                with open(backup_path, 'r', encoding='utf-8') as backup_file:
                    original = json.load(backup_file)
                _atomic_write_json(_DATA_FILE, original)
            except Exception as restore_exc:
                _logging_mod.getLogger('sgf').critical('Could not restore schema-upgrade backup: %s', restore_exc)
        _logging_mod.getLogger('sgf').exception('Content schema upgrade deferred: %s', exc)
        return data

def _atomic_write_json(path, data):
    """Write JSON to `path` without ever leaving a half-written file behind.

    Writes to a temp file in the same directory first, flushes it to disk,
    then uses os.replace() to atomically swap it into place. os.replace()
    on the same filesystem is atomic at the OS level: a process that
    crashes, loses power, or gets force-killed mid-write will find either
    the old complete file or the new complete file next time it starts,
    never a truncated/corrupt one. Without this, a crash during the plain
    open(...)+write could zero out or truncate snake_game_data.json,
    silently wiping every saved score, achievement, and setting at once."""
    directory = os.path.dirname(os.path.abspath(path)) or '.'
    fd, tmp_path = tempfile.mkstemp(prefix='.snake_data_', suffix='.tmp', dir=directory)
    try:
        with os.fdopen(fd, 'w') as _f:
            json.dump(data, _f, indent=2)
            _f.flush()
            os.fsync(_f.fileno())
        os.replace(tmp_path, path)
    except Exception:
        try:
            os.remove(tmp_path)
        except OSError:
            pass
        raise


def _atomic_write_bytes(path, payload):
    """Atomically replace a binary artifact such as a compressed replay."""
    directory = os.path.dirname(os.path.abspath(path)) or '.'
    os.makedirs(directory, exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(prefix='.sgf_artifact_', suffix='.tmp', dir=directory)
    try:
        with os.fdopen(fd, 'wb') as artifact_file:
            artifact_file.write(payload)
            artifact_file.flush()
            os.fsync(artifact_file.fileno())
        os.replace(tmp_path, path)
    except Exception:
        try:
            os.remove(tmp_path)
        except OSError:
            pass
        raise

def _save_data(data):
    """Write the unified game data JSON (synchronous — use this for saves
    that must complete before continuing, e.g. right before the app exits).
    Shares a lock with _save_data_async so a synchronous save can never be
    clobbered by a slower background save landing right after it."""
    with _data_save_lock:
        try:
            _atomic_write_json(_DATA_FILE, data)
            return True
        except Exception as _e:
            print(f"Error saving data: {_e}")
            return False

def _save_data_async(mutate_fn):
    """Apply mutate_fn(data) -> data to the unified game data on a
    background thread.

    Use this for saves that happen mid-gameplay (like an achievement
    unlocking) where the caller can't afford to block the main loop: the
    unified file contains metadata and progression, while replay histories
    are written to their own files. The background write still keeps
    progression updates from blocking the gameplay loop.

    mutate_fn receives the *freshest* on-disk data (re-read at the moment
    the background thread actually runs, under the lock) rather than a
    snapshot captured back when the save was queued — otherwise a slow
    background write could finish after a newer synchronous write and
    silently clobber it with stale data (e.g. wiping out a high score that
    was saved a moment after an achievement unlock queued this write).
    """
    completed = threading.Event()
    with _async_data_writes_lock:
        _async_data_writes.add(completed)

    def _write():
        with _data_save_lock:
            try:
                data = _load_data()
                data = mutate_fn(data)
                _atomic_write_json(_DATA_FILE, data)
            except Exception as _e:
                print(f"Error saving data (async): {_e}")
            finally:
                completed.set()
                with _async_data_writes_lock:
                    _async_data_writes.discard(completed)
    try:
        threading.Thread(target=_write, daemon=True).start()
    except Exception:
        completed.set()
        with _async_data_writes_lock:
            _async_data_writes.discard(completed)


def _flush_async_data_writes(timeout=5.0):
    deadline = time.monotonic() + max(0.0, float(timeout))
    while True:
        with _async_data_writes_lock:
            pending = tuple(_async_data_writes)
        with _replay_save_jobs_lock:
            pending += tuple(
                job['done'] for job in _replay_save_jobs.values()
                if not job['done'].is_set())
        if not pending:
            return True
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False
        pending[0].wait(min(remaining, 0.1))


# Local profiles keep each player's settings and progress isolated while the
# existing unified JSON remains the single source of truth on disk.
_LOCAL_PROFILES_KEY = 'local_profiles'
_PROFILE_DATA_KEYS = ('settings', 'highscores', 'achievements', 'player_name', 'progression', 'encyclopedia_progress', 'lan_leaderboard')
_LOCAL_PROFILE_SCHEMA = 1


def _profile_snapshot(data):
    return {key: copy.deepcopy(data[key]) for key in _PROFILE_DATA_KEYS if key in data}


def _sync_active_profile_snapshot(data):
    if not isinstance(data, dict):
        return
    store = data.get(_LOCAL_PROFILES_KEY)
    if not isinstance(store, dict) or not isinstance(store.get('profiles'), dict):
        return
    active_id = store.get('active_id')
    profile = store['profiles'].get(active_id)
    if isinstance(profile, dict):
        profile['data'] = _profile_snapshot(data)
        profile['updated_at'] = datetime.now().isoformat(timespec='seconds')


def _clean_local_profile_name(value):
    if not isinstance(value, str):
        raise ValueError('Profile name must be text')
    name = ''.join(ch for ch in value if ch.isprintable()).strip()
    name = ' '.join(name.split())
    if not name:
        raise ValueError('Profile name cannot be empty')
    if len(name) > 24:
        raise ValueError('Profile name must be 24 characters or fewer')
    return name


def _ensure_local_profile_store(data):
    """Add a profile index around existing top-level player data once."""
    if not isinstance(data, dict):
        data = {}
    store = data.get(_LOCAL_PROFILES_KEY)
    if isinstance(store, dict) and isinstance(store.get('profiles'), dict) and store['profiles']:
        profiles = store['profiles']
        valid = {}
        for profile_id, profile in profiles.items():
            if (isinstance(profile_id, str) and profile_id and len(profile_id) <= 64
                    and isinstance(profile, dict) and isinstance(profile.get('data'), dict)):
                try:
                    profile_name = _clean_local_profile_name(profile.get('name', ''))
                except ValueError:
                    continue
                valid[profile_id] = {
                    'id': profile_id, 'name': profile_name,
                    'created_at': str(profile.get('created_at', ''))[:64],
                    'updated_at': str(profile.get('updated_at', ''))[:64],
                    'data': {k: copy.deepcopy(v) for k, v in profile['data'].items()
                             if k in _PROFILE_DATA_KEYS},
                }
        if valid:
            changed = len(valid) != len(profiles)
            store['profiles'] = valid
            active_id = store.get('active_id')
            if active_id not in valid:
                active_id = next(iter(valid))
                # The top-level payload still belongs to an invalid/deleted
                # profile. Restore the valid target snapshot before the next
                # save can associate that payload with the wrong player.
                for key in _PROFILE_DATA_KEYS:
                    data.pop(key, None)
                data.update(copy.deepcopy(valid[active_id]['data']))
                changed = True
            store.update({'schema_version': _LOCAL_PROFILE_SCHEMA, 'active_id': active_id})
            data[_LOCAL_PROFILES_KEY] = store
            return data, store, changed

    existing_name = data.get('player_name')
    try:
        default_name = _clean_local_profile_name(existing_name) if existing_name else 'Player 1'
    except ValueError:
        default_name = 'Player 1'
    now = datetime.now().isoformat(timespec='seconds')
    profile_id = 'default'
    profile_data = _profile_snapshot(data)
    profile_data['player_name'] = profile_data.get('player_name') or default_name
    store = {
        'schema_version': _LOCAL_PROFILE_SCHEMA,
        'active_id': profile_id,
        'profiles': {profile_id: {
            'id': profile_id, 'name': default_name,
            'created_at': now, 'updated_at': now, 'data': profile_data,
        }},
    }
    data[_LOCAL_PROFILES_KEY] = store
    return data, store, True


def initialize_local_profiles():
    """Migrate current single-player data into the local profile index."""
    global ACTIVE_PROFILE_NAME
    data, store, changed = _ensure_local_profile_store(_load_data())
    if SAFE_MODE:
        return list_local_profiles(data)
    requested = str(_CLI_PROFILE_REQUEST or '').strip()
    requested_id = next((pid for pid, profile in store['profiles'].items()
                         if pid == requested or profile['name'].casefold() == requested.casefold()), None) if requested else None
    if requested_id and requested_id != store['active_id']:
        _switch_profile_in_data(data, store, requested_id)
        changed = True
    ACTIVE_PROFILE_NAME = store['active_id']
    if changed:
        _save_data(data)
    return list_local_profiles(data)


def list_local_profiles(data=None):
    if data is None:
        data = _load_data()
    data, store, _changed = _ensure_local_profile_store(data)
    active_id = store['active_id']
    return [
        {'id': pid, 'name': p['name'], 'active': pid == active_id,
         'created_at': p['created_at']}
        for pid, p in store['profiles'].items()
    ]


def _switch_profile_in_data(data, store, profile_id):
    _sync_active_profile_snapshot(data)
    target = store['profiles'][profile_id]
    for key in _PROFILE_DATA_KEYS:
        data.pop(key, None)
    data.update(copy.deepcopy(target['data']))
    data[_LOCAL_PROFILES_KEY] = store
    store['active_id'] = profile_id
    return data


def switch_local_profile(profile_id):
    global ACTIVE_PROFILE_NAME
    if SAFE_MODE:
        return False, 'Profiles cannot be changed in Safe Mode'
    if not _flush_async_data_writes():
        return False, 'Profile data is still being saved; try again shortly'
    with _data_save_lock:
        data, store, changed = _ensure_local_profile_store(_load_data())
        if profile_id not in store['profiles']:
            return False, 'Profile not found'
        _switch_profile_in_data(data, store, profile_id)
        _sync_active_profile_snapshot(data)
        try:
            _atomic_write_json(_DATA_FILE, data)
            ACTIVE_PROFILE_NAME = profile_id
            return True, None
        except Exception as exc:
            return False, type(exc).__name__


def create_local_profile(name):
    global ACTIVE_PROFILE_NAME
    if SAFE_MODE:
        return None, 'Profiles cannot be created in Safe Mode'
    try:
        name = _clean_local_profile_name(name)
    except ValueError as exc:
        return None, str(exc)
    if not _flush_async_data_writes():
        return None, 'Profile data is still being saved; try again shortly'
    with _data_save_lock:
        data, store, _changed = _ensure_local_profile_store(_load_data())
        if len(store['profiles']) >= 32:
            return None, 'The maximum of 32 local profiles has been reached'
        if any(p['name'].casefold() == name.casefold() for p in store['profiles'].values()):
            return None, 'A profile with that name already exists'
        profile_id = _secrets_mod.token_hex(8)
        now = datetime.now().isoformat(timespec='seconds')
        current_settings = copy.deepcopy(data.get('settings', {}))
        profile_data = {
            'settings': current_settings if isinstance(current_settings, dict) else {},
            'highscores': [], 'achievements': {},
            'player_name': name,
            'progression': {
                'schema_version': PROGRESSION_SCHEMA_VERSION,
                'xp_total': 0, 'games_completed': 0, 'highest_score': 0,
                'total_fruits': 0, 'total_portal_uses': 0, 'wins': 0,
                'best_combo': 0, 'unlocked_skins': ['classic'],
                'selected_skin': 'classic', 'recent_award_ids': [],
            },
        }
        store['profiles'][profile_id] = {
            'id': profile_id, 'name': name, 'created_at': now,
            'updated_at': now, 'data': profile_data,
        }
        _switch_profile_in_data(data, store, profile_id)
        try:
            _atomic_write_json(_DATA_FILE, data)
            ACTIVE_PROFILE_NAME = profile_id
            return profile_id, None
        except Exception as exc:
            del store['profiles'][profile_id]
            return None, type(exc).__name__


def rename_local_profile(profile_id, name):
    if SAFE_MODE:
        return False, 'Profiles cannot be renamed in Safe Mode'
    try:
        name = _clean_local_profile_name(name)
    except ValueError as exc:
        return False, str(exc)
    if not _flush_async_data_writes():
        return False, 'Profile data is still being saved; try again shortly'
    with _data_save_lock:
        data, store, _changed = _ensure_local_profile_store(_load_data())
        profile = store['profiles'].get(profile_id)
        if profile is None:
            return False, 'Profile not found'
        if any(pid != profile_id and p['name'].casefold() == name.casefold()
               for pid, p in store['profiles'].items()):
            return False, 'A profile with that name already exists'
        profile['name'] = name
        profile_data = profile.get('data')
        if isinstance(profile_data, dict):
            profile_data['player_name'] = name
        if store['active_id'] == profile_id:
            data['player_name'] = name
        _sync_active_profile_snapshot(data)
        try:
            _atomic_write_json(_DATA_FILE, data)
            return True, None
        except Exception as exc:
            return False, type(exc).__name__


PROGRESSION_SCHEMA_VERSION = 1
_SKIN_LEVEL_UNLOCKS = {'classic': 1, 'neon': 3, 'rainbow': 5, 'camouflage': 10}


def _progression_level_for_xp(total_xp):
    """Return (level, progress within level, XP needed for next level)."""
    try:
        remaining = max(0, min(1_000_000_000, int(total_xp)))
    except (TypeError, ValueError, OverflowError):
        remaining = 0
    level = 1
    needed = 100
    while remaining >= needed:
        remaining -= needed
        level += 1
        needed = 100 + (level - 1) * 25
    return level, remaining, needed


def _normalize_recent_matches(records):
    """Keep a bounded, non-sensitive summary of completed local matches."""
    if not isinstance(records, list):
        return []
    clean = []
    seen = set()
    for record in reversed(records[-200:]):
        if not isinstance(record, dict):
            continue
        match_id = record.get('id')
        stamp = record.get('timestamp')
        outcome = record.get('outcome')
        if any(type(record.get(key)) is not int
               for key in ('score', 'snake_length', 'combo') if key in record):
            continue
        try:
            score = int(record.get('score'))
            length = int(record.get('snake_length', 0))
            combo = int(record.get('combo', 0))
        except (TypeError, ValueError, OverflowError):
            continue
        if (not isinstance(match_id, str) or not re.fullmatch(r'[0-9a-f]{32}', match_id)
                or match_id in seen or not isinstance(stamp, str)
                or len(stamp) > 40 or outcome not in ('win', 'loss', 'draw')
                or not 0 <= score <= 1_000_000
                or not 0 <= length <= 100_000 or not 0 <= combo <= 1_000_000):
            continue
        try:
            datetime.fromisoformat(stamp)
        except ValueError:
            continue
        mode = record.get('mode', 'singleplayer')
        if not isinstance(mode, str):
            mode = 'singleplayer'
        clean.append({
            'id': match_id, 'timestamp': stamp, 'score': score,
            'outcome': outcome, 'mode': mode[:32],
            'snake_length': length, 'combo': combo,
        })
        seen.add(match_id)
        if len(clean) >= 50:
            break
    return list(reversed(clean))


def _load_progression_summary():
    try:
        raw = _load_data().get('progression', {})
        raw = raw if isinstance(raw, dict) else {}
    except Exception:
        raw = {}
    try:
        xp_total = max(0, min(1_000_000_000, int(raw.get('xp_total', 0))))
    except (TypeError, ValueError, OverflowError):
        xp_total = 0
    level, level_xp, next_level_xp = _progression_level_for_xp(xp_total)
    unlocked = [skin for skin, required_level in _SKIN_LEVEL_UNLOCKS.items()
                if level >= required_level]
    def _counter(key):
        try:
            return max(0, min(1_000_000_000, int(raw.get(key, 0) or 0)))
        except (TypeError, ValueError, OverflowError):
            return 0
    def _duration_counter(key, limit):
        value = raw.get(key, 0)
        if type(value) is not int:
            return 0
        return max(0, min(limit, value))
    selected = raw.get('selected_skin', 'classic')
    if not isinstance(selected, str) or selected not in unlocked:
        selected = 'classic'
    games_completed = _counter('games_completed')
    wins = _counter('wins')
    return {
        'schema_version': PROGRESSION_SCHEMA_VERSION,
        'xp_total': xp_total,
        'level': level,
        'level_xp': level_xp,
        'next_level_xp': next_level_xp,
        'games_completed': games_completed,
        'win_rate_percent': int(round(100 * wins / games_completed)) if games_completed else 0,
        'highest_score': _counter('highest_score'),
        'total_score': _counter('total_score'),
        'longest_snake': min(100_000, _counter('longest_snake')),
        'total_fruits': _counter('total_fruits'),
        'total_portal_uses': _counter('total_portal_uses'),
        'total_play_time_ms': _duration_counter(
            'total_play_time_ms', 1_000_000_000_000_000),
        'longest_survival_ms': _duration_counter(
            'longest_survival_ms', 7 * 24 * 60 * 60 * 1000),
