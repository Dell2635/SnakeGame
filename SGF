_REPLAY_SHARE_SETTING_FIELDS = (
    'board_size', 'update_rate_ms', 'wall_collision', 'powerups_enabled',
    'fruit_types_enabled', 'enable_obstacles', 'enable_portals', 'portal_pairs',
    'obstacle_count', 'ghost_mode_enabled',
)


def _replay_share_digest(bundle):
    canonical = json.dumps(bundle, sort_keys=True, separators=(',', ':'),
                           ensure_ascii=False, allow_nan=False).encode('utf-8')
    return hashlib.sha256(canonical).hexdigest()


def export_replay_share_code(score_data):
    """Build a bounded, versioned clipboard code using the canonical replay."""
    if not isinstance(score_data, dict) or not _score_has_replay(score_data):
        raise ValueError('This score has no saved replay.')
    resolved = _history_for_score(score_data)
    if 'mp_history' in resolved:
        events = resolved['mp_history']
    else:
        events = resolved.get('game_history')
    if not isinstance(events, list) or not events or len(events) > _REPLAY_SHARE_MAX_FRAMES:
        raise ValueError('Replay has an unsupported frame count.')
    metadata = _copy_json_safe({k: resolved[k] for k in _REPLAY_SHARE_SCORE_FIELDS
                                if k in resolved})
    settings = resolved.get('settings')
    if isinstance(settings, dict):
        metadata['settings'] = _copy_json_safe({
            key: settings[key] for key in _REPLAY_SHARE_SETTING_FIELDS
            if key in settings and isinstance(settings[key], (bool, int))
        })
    replay = _score_replay_payload(metadata, events)
    bundle = {
        'magic': 'SNAKE-REPLAY', 'share_version': 1,
        'game_version': GAME_VERSION, 'score': metadata, 'replay': replay,
    }
    bundle['sha256'] = _replay_share_digest(bundle)
    raw = json.dumps(bundle, sort_keys=True, separators=(',', ':'),
                     ensure_ascii=False, allow_nan=False).encode('utf-8')
    if len(raw) > _REPLAY_SHARE_MAX_PAYLOAD_BYTES:
        raise ValueError('Replay is too large to share.')
    encoded = _base64_mod.urlsafe_b64encode(_zlib_mod.compress(raw, 9)).decode('ascii').rstrip('=')
    code = _REPLAY_SHARE_PREFIX + encoded
    if len(code.encode('ascii')) > _REPLAY_SHARE_MAX_CODE_BYTES:
        raise ValueError('Replay share code exceeds the size limit.')
    return code


def import_replay_share_code(code):
    """Decode and validate an untrusted share code without writing to disk."""
    if not isinstance(code, str) or len(code.encode('utf-8', 'ignore')) > _REPLAY_SHARE_MAX_CODE_BYTES:
        raise ValueError('Replay share code is invalid or too large.')
    code = code.strip()
    if not code.startswith(_REPLAY_SHARE_PREFIX):
        raise ValueError('Replay share code has an unknown format.')
    encoded = code[len(_REPLAY_SHARE_PREFIX):]
    if not encoded or any(ch.isspace() for ch in encoded):
        raise ValueError('Replay share code is incomplete.')
    try:
        encoded_bytes = encoded.encode('ascii')
        compressed = _base64_mod.b64decode(
            encoded_bytes + b'=' * (-len(encoded_bytes) % 4), altchars=b'-_', validate=True)
        decoder = _zlib_mod.decompressobj()
        raw = decoder.decompress(compressed, _REPLAY_SHARE_MAX_PAYLOAD_BYTES + 1)
        if len(raw) > _REPLAY_SHARE_MAX_PAYLOAD_BYTES or decoder.unconsumed_tail:
            raise ValueError('Replay payload exceeds the size limit.')
        raw += decoder.flush(_REPLAY_SHARE_MAX_PAYLOAD_BYTES + 1 - len(raw))
        if len(raw) > _REPLAY_SHARE_MAX_PAYLOAD_BYTES or not decoder.eof or decoder.unused_data:
            raise ValueError('Replay payload is incomplete or exceeds the size limit.')
        bundle = json.loads(raw.decode('utf-8'))
    except (UnicodeError, ValueError, TypeError, RecursionError, _zlib_mod.error) as exc:
        if isinstance(exc, ValueError) and str(exc).startswith('Replay payload'):
            raise
        raise ValueError('Replay share code could not be decoded.') from exc
    if not isinstance(bundle, dict) or bundle.get('magic') != 'SNAKE-REPLAY' or bundle.get('share_version') != 1:
        raise ValueError('Replay share version is not supported.')
    supplied_digest = bundle.pop('sha256', None)
    if not isinstance(supplied_digest, str) or not _hmac_mod.compare_digest(
            supplied_digest, _replay_share_digest(bundle)):
        raise ValueError('Replay share integrity check failed.')
    score, replay = bundle.get('score'), bundle.get('replay')
    if not isinstance(score, dict) or not isinstance(replay, dict):
        raise ValueError('Replay share data is malformed.')
    try:
        replay_version = int(replay.get('schema_version', 1))
    except (TypeError, ValueError, OverflowError):
        raise ValueError('Replay format version is invalid.')
    if replay_version < 1 or replay_version > REPLAY_FORMAT_VERSION:
        raise ValueError('Replay format version is not supported by this game.')
    events = replay.get('events')
    if not isinstance(events, list) or not events or len(events) > _REPLAY_SHARE_MAX_FRAMES:
        raise ValueError('Replay frame count is invalid.')
    def _valid_cell(cell):
        return (isinstance(cell, (list, tuple)) and len(cell) == 2 and
                all(type(v) is int and -256 <= v <= 256 for v in cell))

    mode = str(score.get('game_mode', replay.get('game_mode', 'single_player')))
    if mode == 'vs_ai':
        valid_events = all(
            isinstance(frame, dict) and
            all(key in frame for key in ('p1', 'p1s', 'p1a', 'ais', 'ass', 'aia')) and
            isinstance(frame['p1'], list) and len(frame['p1']) <= 20000 and
            all(_valid_cell(cell) for cell in frame['p1']) and
            isinstance(frame['ais'], list) and len(frame['ais']) <= 4 and
            all(isinstance(snake, list) and len(snake) <= 20000 and
                all(_valid_cell(cell) for cell in snake) for snake in frame['ais']) and
            isinstance(frame['ass'], list) and len(frame['ass']) <= 4 and
            all(type(value) is int and 0 <= value <= 10**9 for value in frame['ass'])
            for frame in events)
    elif score.get('is_multiplayer'):
        valid_events = all(
            (isinstance(frame, dict) and isinstance(frame.get('snakes'), list) and
             1 <= len(frame['snakes']) <= 4 and
             all(isinstance(snake, list) and len(snake) <= 20000 and
                 all(_valid_cell(cell) for cell in snake) for snake in frame['snakes']))
            or (isinstance(frame, dict) and all(k in frame for k in ('p1', 'p2')) and
                isinstance(frame['p1'], list) and isinstance(frame['p2'], list) and
                len(frame['p1']) <= 20000 and len(frame['p2']) <= 20000 and
                all(_valid_cell(cell) for cell in frame['p1'] + frame['p2']))
            or (isinstance(frame, list) and len(frame) >= 9)
            for frame in events)
    else:
        valid_events = all(isinstance(frame, list) and 5 <= len(frame) <= 12 and
                           isinstance(frame[0], list) and 1 <= len(frame[0]) <= 20000 and
                           all(_valid_cell(cell) for cell in frame[0]) and
                           _valid_cell(frame[4]) and
                           type(frame[3]) is int and 0 <= frame[3] <= 10**9
                           for frame in events)
    if not valid_events:
        raise ValueError('Replay snapshots are malformed for this game mode.')
    resolved = {key: score[key] for key in _REPLAY_SHARE_SCORE_FIELDS if key in score}
    name = score.get('name', 'Imported replay')
    resolved['name'] = name[:80] if isinstance(name, str) else 'Imported replay'
    score_value = score.get('score', 0)
    resolved['score'] = score_value if type(score_value) is int and 0 <= score_value <= 10**9 else 0
    for key in ('date', 'timestamp', 'seed'):
        value = score.get(key)
        if isinstance(value, str):
            resolved[key] = value[:128]
        else:
            resolved.pop(key, None)
    for key in ('board_size', 'actual_board_width', 'actual_board_height'):
        value = score.get(key)
        if type(value) is not int or not 5 <= value <= 200:
            resolved.pop(key, None)
    update_rate = score.get('update_rate_ms')
    resolved['update_rate_ms'] = update_rate if type(update_rate) is int and 20 <= update_rate <= 10000 else 200
    raw_settings = score.get('settings')
    safe_settings = {}
    if isinstance(raw_settings, dict):
        for key, value in raw_settings.items():
            if key in ('wall_collision', 'powerups_enabled', 'fruit_types_enabled',
                       'enable_obstacles', 'enable_portals') and type(value) is bool:
                safe_settings[key] = value
            elif key in ('board_size', 'update_rate_ms', 'obstacle_count', 'portal_pairs') and type(value) is int:
                lower, upper = (20, 10000) if key == 'update_rate_ms' else ((0, 20) if key in ('obstacle_count', 'portal_pairs') else (5, 200))
                if lower <= value <= upper:
                    safe_settings[key] = value
    resolved['settings'] = safe_settings
    for field in ('daily_challenge_id', 'daily_challenge_version',
                  'daily_challenge_modifier'):
        resolved.pop(field, None)
    challenge_id = score.get('daily_challenge_id')
    challenge_version = score.get('daily_challenge_version')
    challenge_modifier = score.get('daily_challenge_modifier')
    challenge_match = (re.fullmatch(
        r'daily-v(?P<version>[12])-\d{4}-\d{2}-\d{2}', challenge_id)
        if isinstance(challenge_id, str) else None)
    if (challenge_match and type(challenge_version) is int and
            challenge_version == int(challenge_match.group('version')) and
            challenge_modifier in ('classic', 'wrap_walls', 'obstacles')):
        resolved['daily_challenge_id'] = challenge_id
        resolved['daily_challenge_version'] = challenge_version
        resolved['daily_challenge_modifier'] = challenge_modifier
    custom_challenge_id = score.get('custom_challenge_id')
    custom_challenge_version = score.get('custom_challenge_version')
    custom_challenge_match = (re.fullmatch(
        r'user-v(?P<version>[12])-[0-9a-f]{24}', custom_challenge_id)
        if isinstance(custom_challenge_id, str) else None)
    if (custom_challenge_match and type(custom_challenge_version) is int and
            custom_challenge_version == int(custom_challenge_match.group('version'))):
        resolved['custom_challenge_id'] = custom_challenge_id
        resolved['custom_challenge_version'] = custom_challenge_version
    custom_map = replay.get('custom_map')
    if custom_map is not None:
        if not isinstance(custom_map, dict):
            raise ValueError('Replay map data is malformed.')
        width, height = custom_map.get('board_width'), custom_map.get('board_height')
        obstacles = custom_map.get('obstacles', [])
        portals = custom_map.get('portals', [])
        if (type(width) is not int or type(height) is not int or not 5 <= width <= 200 or
                not 5 <= height <= 200 or not isinstance(obstacles, list) or len(obstacles) > 5000 or
                not all(_valid_cell(cell) and cell[0] < width and cell[1] < height and
                        cell[0] >= 0 and cell[1] >= 0 for cell in obstacles) or
                not isinstance(portals, list) or len(portals) > 100):
            raise ValueError('Replay map data is outside supported limits.')
        resolved['custom_map'] = custom_map
    resolved['replay_format_version'] = replay_version
    if resolved.get('is_multiplayer'):
        resolved['mp_history'] = events
    else:
        resolved['game_history'] = events
    resolved['has_replay'] = True
    resolved.pop('replay_id', None)
    return resolved


def _load_custom_maps():
    maps = {}
    root = _user_data_manager.get_maps_created_dir()
    try:
        for filename in os.listdir(root):
            if not filename.lower().endswith('.json'):
                continue
            try:
                with open(os.path.join(root, filename), 'r', encoding='utf-8') as map_file:
                    payload = json.load(map_file)
                name = payload.pop('name', None) if isinstance(payload, dict) else None
                if isinstance(name, str) and name:
                    maps[name] = payload
            except (OSError, ValueError, TypeError):
                continue
    except OSError:
        pass
    return maps


def _save_custom_map_file(name, payload):
    record = dict(payload)
    record['name'] = name
    path = _map_path(name)
    _atomic_write_json(path, record)
    with open(path, 'r', encoding='utf-8') as map_file:
        check = json.load(map_file)
    if check.get('name') != name:
        raise ValueError('Saved map failed validation')
    return path


def _delete_custom_map_file(name):
    try:
        os.remove(_map_path(name))
        return True
    except FileNotFoundError:
        return False


def _prune_score_replays(highscores):
    """Remove replay files whose owning scores were removed or trimmed."""
    referenced = {
        score.get('replay_id') for score in highscores
        if isinstance(score, dict) and score.get('replay_id')
    }
    try:
        for filename in os.listdir(_user_data_manager.get_replay_dir()):
            if not filename.startswith('replay_') or not (
                    filename.endswith('.json') or filename.endswith('.json.gz')):
                continue
            suffix = '.json.gz' if filename.endswith('.json.gz') else '.json'
            replay_id = filename[len('replay_'):-len(suffix)]
            if replay_id not in referenced:
                try:
                    os.remove(os.path.join(_user_data_manager.get_replay_dir(), filename))
                except OSError as exc:
                    _logging_mod.getLogger('sgf').warning('Could not remove orphan replay %s: %s', filename, exc)
    except OSError:
        pass


