def _net_send(sock, msg):
    """Send a JSON message over TCP with a 4-byte length prefix."""
    data = json.dumps(msg).encode('utf-8')
    sock.sendall(struct.pack('!I', len(data)) + data)

def _net_recv(sock):
    """Receive one framed message. Returns dict or None on disconnect/error."""
    def _exact(n):
        buf = b''
        while len(buf) < n:
            chunk = sock.recv(n - len(buf))
            if not chunk:
                return None
            buf += chunk
        return buf
    raw_len = _exact(4)
    if raw_len is None:
        return None
    length = struct.unpack('!I', raw_len)[0]
    if length > 4_000_000:        # sanity guard
        return None
    data = _exact(length)
    if data is None:
        return None
    try:
        return json.loads(data.decode('utf-8'))
    except Exception:
        return None

def _get_local_ips():
    """Return a de-duplicated list of likely LAN IPv4 addresses."""
    seen = {}
    # Method 1: route-based (works for Wi-Fi, Ethernet, USB-tethering)
    for target in ('8.8.8.8', '192.168.0.1', '10.0.0.1'):
        try:
            s = _socket_mod.socket(_socket_mod.AF_INET, _socket_mod.SOCK_DGRAM)
            s.connect((target, 80))
            ip = s.getsockname()[0]
            s.close()
            if ip and not ip.startswith('127.'):
                seen[ip] = True
        except Exception:
            pass
    # Method 2: hostname resolution
    try:
        for info in _socket_mod.getaddrinfo(_socket_mod.gethostname(), None):
            ip = info[4][0]
            if ip and not ip.startswith('127.') and ':' not in ip:
                seen[ip] = True
    except Exception:
        pass
    return list(seen.keys())


