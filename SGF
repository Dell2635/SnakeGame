    cell = max(6, min((rect.w - 24) // cells, (rect.h - 24) // cells))
    board_rect = pygame.Rect(0, 0, cell * cells, cell * cells)
    board_rect.center = rect.center
    pygame.draw.rect(surface, board, board_rect)
    for i in range(cells + 1):
        pygame.draw.line(surface, grid, (board_rect.x + i * cell, board_rect.y),
                         (board_rect.x + i * cell, board_rect.bottom))
