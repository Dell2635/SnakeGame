# IA3 integration point: no competing user-data directory is created here.
# IA3 can pass a provider object exposing get_mod_dir(), get_theme_dir(), and
# get_cache_dir(), or a mapping with those keys.
_EXTENSION_DATA_PROVIDER = None


def set_extension_data_provider(provider):
    """Register the centralized user-data provider owned by IA3."""
    global _EXTENSION_DATA_PROVIDER
    _EXTENSION_DATA_PROVIDER = provider
    return provider


def get_extension_data_provider():
    return _EXTENSION_DATA_PROVIDER


def _extension_data_dir(kind):
    provider = _EXTENSION_DATA_PROVIDER
    method_name = f"get_{kind}_dir"
    try:
        if provider is None:
            # IA3 may expose the conceptual getters directly or through a
            # centralized manager. This is an adapter only; IA4 never chooses
            # an alternative persistent root.
            for manager_name in ("DATA_DIRECTORY_MANAGER", "USER_DATA_MANAGER", "data_manager"):
                manager = globals().get(manager_name)
                if manager is not None and callable(getattr(manager, method_name, None)):
                    provider = manager
                    break
            if provider is None:
                direct_getter = globals().get(method_name)
                if callable(direct_getter):
                    return os.path.abspath(os.fspath(direct_getter()))
        if isinstance(provider, dict):
            value = provider.get(method_name) or provider.get(kind)
        else:
            method = getattr(provider, method_name, None)
            value = method() if callable(method) else None
        if not value:
            return None
        path = os.path.abspath(os.fspath(value))
        os.makedirs(path, exist_ok=True)
        return path
    except Exception as exc:
        # Path-provider failure must not bring down the base game.
        print(f"[IA4] data-provider error ({kind}): {exc}")
        return None


class AssetManager:
    """Central asset resolver/cache with source ownership and deterministic priority."""

    SOURCE_PRIORITY = {"builtin": 0, "theme": 10, "mod": 20}

    _IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".bmp", ".webp", ".gif", ".tga"}
    _SOUND_EXTS = {".wav", ".ogg", ".mp3", ".flac", ".mid", ".midi"}
    _FONT_EXTS = {".ttf", ".otf"}

    def __init__(self):
        self._assets = {}
        self._sources = {}
        self._cache = {}
        self.conflicts = []
        self.errors = []

    def register_source(self, owner_id, root_dir, source_type, assets=None):
        source_type = str(source_type)
        if source_type not in self.SOURCE_PRIORITY:
            raise ValueError(f"Unknown asset source type: {source_type}")
        root = os.path.abspath(os.fspath(root_dir)) if root_dir else None
        self._sources[str(owner_id)] = {
            "owner_id": str(owner_id),
            "root_dir": root,
            "source_type": source_type,
        }
        if assets is not None:
            self.register_assets(owner_id, assets)
        return self._sources[str(owner_id)]

    def register_assets(self, owner_id, assets):
        if isinstance(assets, dict):
            pairs = assets.items()
        elif isinstance(assets, list):
            pairs = []
            for entry in assets:
                if isinstance(entry, dict):
                    pairs.append((entry.get("id"), entry.get("path")))
                else:
                    pairs.append((None, entry))
        else:
            raise ContentValidationError(
                "assets must be an object or list",
                code="invalid_assets", component="assets", owner_id=owner_id
            )

        source = self._sources.get(str(owner_id))
        if source is None:
            raise ContentValidationError(
                f"Asset source is not registered: {owner_id}",
                code="unknown_asset_source", component="assets", owner_id=owner_id
            )

        for logical_id, rel_path in pairs:
            if not isinstance(logical_id, str) or not logical_id.strip():
                raise ContentValidationError(
                    f"Asset ids must be stable non-empty strings for {owner_id}",
                    code="missing_asset_id", component="assets", owner_id=owner_id
                )
            logical_id = logical_id.strip()
            rel_path = _validate_relative_asset_path(rel_path, f"{owner_id}.assets.{logical_id}")
            path = os.path.abspath(os.path.join(source["root_dir"], rel_path))
            try:
                inside = os.path.commonpath((path, source["root_dir"])) == source["root_dir"]
            except ValueError:
                inside = False
            if not inside:
                raise ContentValidationError(
                    f"Asset path escapes source root: {rel_path}",
                    code="asset_path_traversal", component="assets", owner_id=owner_id
                )
            if not os.path.isfile(path):
                raise ContentValidationError(
                    f"Asset does not exist: {rel_path}",
                    code="missing_asset", component="assets", owner_id=owner_id,
                    path=path
                )
            self.register_asset(logical_id, path, owner_id=owner_id)

    def register_asset(self, logical_id, path, *, owner_id, source_type=None):
        owner_id = str(owner_id)
        source = self._sources.get(owner_id)
        if source_type is None:
            source_type = source["source_type"] if source else "builtin"
        priority = self.SOURCE_PRIORITY.get(source_type, 0)
        record = {
            "id": str(logical_id),
            "path": os.path.abspath(os.fspath(path)),
            "owner_id": owner_id,
            "source_type": source_type,
            "priority": priority,
        }
        existing = self._assets.get(record["id"])
        if existing is not None:
            if existing["priority"] == record["priority"]:
                conflict = {
                    "asset_id": record["id"],
                    "existing_owner": existing["owner_id"],
                    "new_owner": owner_id,
                    "priority": priority,
                }
                _append_bounded_diagnostic(self.conflicts, conflict)
                # Never silently overwrite same-priority assets. Stable lexical
                # ordering makes the selected source deterministic.
                if owner_id < existing["owner_id"]:
                    self._assets[record["id"]] = record
            elif record["priority"] > existing["priority"]:
                self._assets[record["id"]] = record
            return self._assets[record["id"]]
        self._assets[record["id"]] = record
        return record

    def unregister_owner(self, owner_id):
        owner_id = str(owner_id)
        for asset_id, record in list(self._assets.items()):
            if record["owner_id"] == owner_id:
                self._assets.pop(asset_id, None)
                self._cache.pop(("path", asset_id), None)
                for cache_key in list(self._cache):
                    if cache_key[1] == asset_id:
                        self._cache.pop(cache_key, None)
        self._sources.pop(owner_id, None)

    def has(self, asset_id):
        return str(asset_id) in self._assets

    def resolve(self, asset_id):
        record = self._assets.get(str(asset_id))
        if not record:
            return None
        return record["path"]

    def owner_of(self, asset_id):
        record = self._assets.get(str(asset_id))
        return record["owner_id"] if record else None

    def validate_asset(self, asset_id):
        path = self.resolve(asset_id)
        if not path or not os.path.isfile(path):
            return False
        return True

    def load(self, asset_id, kind=None):
        """Load/cache an asset; returns None on optional asset failure."""
        asset_id = str(asset_id)
        path = self.resolve(asset_id)
        if path is None:
            return None
        ext = os.path.splitext(path)[1].lower()
        if kind is None:
            kind = (
                "image" if ext in self._IMAGE_EXTS else
                "sound" if ext in self._SOUND_EXTS else
                "font" if ext in self._FONT_EXTS else
                "file"
            )
        cache_key = (kind, asset_id)
        if cache_key in self._cache:
            return self._cache[cache_key]
        try:
            if kind == "image":
                loaded = pygame.image.load(path)
                try:
                    loaded = loaded.convert_alpha()
                except Exception:
                    pass
            elif kind == "sound":
                if not pygame.mixer.get_init():
                    pygame.mixer.init()
                loaded = pygame.mixer.Sound(path)
            elif kind == "font":
                loaded = path
            else:
                with open(path, "rb") as handle:
                    loaded = handle.read()
            self._cache[cache_key] = loaded
            return loaded
        except Exception as exc:
            _append_bounded_diagnostic(self.errors, {
                "asset_id": asset_id,
                "owner_id": self.owner_of(asset_id),
                "error": str(exc),
            })
            return None

    def get_image(self, asset_id, fallback=None):
        return self.load(asset_id, "image") or fallback

    def get_sound(self, asset_id, fallback=None):
        return self.load(asset_id, "sound") or fallback

    def get_font_path(self, asset_id, fallback=None):
        value = self.load(asset_id, "font")
        return value or fallback

    def clear_cache(self, owner_id=None):
        if owner_id is None:
            self._cache.clear()
            return
        owner_id = str(owner_id)
        owned_ids = {
            asset_id for asset_id, record in self._assets.items()
            if record["owner_id"] == owner_id
        }
        for cache_key in list(self._cache):
            if cache_key[1] in owned_ids:
                self._cache.pop(cache_key, None)


ASSET_MANAGER = AssetManager()


class ThemeDefinition:
    REQUIRED_FIELDS = (
        "id", "name", "version", "game_version", "theme_api_version"
    )
    OPTIONAL_SECTIONS = (
        "colors", "fonts", "ui", "buttons", "panels", "icons", "board",
        "snake", "fruits", "obstacles", "effects", "sounds", "animations",
        "backgrounds", "assets",
    )

    def __init__(self, manifest, *, root_dir=None, source_owner=None):
        if not isinstance(manifest, dict):
            raise ContentValidationError(
                "Theme manifest must be an object",
                code="invalid_manifest", component="theme"
            )
        for field in self.REQUIRED_FIELDS:
            if field not in manifest:
                raise ContentValidationError(
                    f"Theme manifest missing required field: {field}",
                    code="missing_required_field", component="theme", path=field
                )
        self.id = str(manifest["id"]).strip()
        self.name = str(manifest["name"]).strip()
        self.version = str(manifest["version"]).strip()
        self.game_version = manifest["game_version"]
        self.theme_api_version = str(manifest["theme_api_version"]).strip()
        self.extends = manifest.get("extends", "default")
        self.root_dir = os.path.abspath(root_dir) if root_dir else None
        self.source_owner = str(source_owner or f"theme:{self.id}")
        self.data = copy.deepcopy(manifest)

    def validate(self):
        if not self.id or not self.name or not self.version:
            raise ContentValidationError(
                "Theme id, name, and version must be non-empty",
                code="invalid_manifest", component="theme", owner_id=self.id,
                version=self.version
            )
        if not _version_compatible(GAME_VERSION, self.game_version):
            raise ContentValidationError(
                f"Theme {self.id} is incompatible with game {GAME_VERSION}: {self.game_version}",
                code="incompatible_game_version", component="theme",
                owner_id=self.id, version=self.version
            )
        if not _version_compatible(THEME_API_VERSION, self.theme_api_version):
            raise ContentValidationError(
                f"Theme {self.id} requires theme API {self.theme_api_version}; "
                f"current API is {THEME_API_VERSION}",
                code="incompatible_theme_api", component="theme",
                owner_id=self.id, version=self.version
            )

        assets = self.data.get("assets", {})
        if assets is not None and not isinstance(assets, (dict, list)):
            raise ContentValidationError(
                "Theme assets must be an object or list",
                code="invalid_assets", component="theme", owner_id=self.id
            )

        colors = self.data.get("colors", {})
        if colors is not None and not isinstance(colors, dict):
            raise ContentValidationError(
                "Theme colors must be an object",
                code="invalid_colors", component="theme", owner_id=self.id
            )
        for key, value in (colors or {}).items():
            _validate_theme_color(value, f"colors.{key}")

        for section in self.OPTIONAL_SECTIONS:
            if section in self.data and section != "assets" and self.data[section] is not None:
                if not isinstance(self.data[section], dict):
                    raise ContentValidationError(
                        f"Theme section {section} must be an object",
                        code="invalid_theme_section", component="theme",
                        owner_id=self.id, path=section
                    )
        return True


