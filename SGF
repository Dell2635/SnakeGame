    def draw_screen(self):
        """Draw the high scores screen"""
        # Fill background
        self.screen.fill(COLORS['dark_blue'])
        self.detail_buttons = []
        
        # Title, Back, Filter and Search are solved together in one row so they
        # can never overlap, regardless of window width or translated text length.
        header = self._layout_header()
        title_font = get_font(self.settings.language, 'bold', 30)
        title_text = get_text(self.settings.language, 'high_scores')
        title_surface = render_fit(title_font, title_text, COLORS['white'], header['title'].width)
        self.screen.blit(title_surface, title_surface.get_rect(center=header['title'].center))

        # Load and filter high scores (both cached — see load_highscores()
        # and get_filtered_scores() docstrings for why this used to be slow)
        filtered_scores = self.get_filtered_scores()

        # Draw search box and filter button
        search_rect = self.draw_search_box(header['search'])
        filter_rect = self.draw_filter_button(header['filter'])
        import_rect = header.get('import_replay')
        if import_rect:
            pygame.draw.rect(self.screen, COLORS['blue'], import_rect, border_radius=5)
            import_font = get_font(self.settings.language, 'bold', 16)
            import_text = render_fit(import_font,
                get_text(self.settings.language, 'replay_share_paste'), COLORS['white'],
                import_rect.width - 8)
            self.screen.blit(import_text, import_text.get_rect(center=import_rect.center))
        
        if not filtered_scores:
            # Draw "No high scores yet" message
            no_scores_font = get_font(self.settings.language, 'regular', 24)
            no_scores_text = get_text(self.settings.language, 'no_highscores')
            no_scores_surface = no_scores_font.render(no_scores_text, True, COLORS['white'])
            self.screen.blit(no_scores_surface, (
                self.screen.get_width() // 2 - no_scores_surface.get_width() // 2, 
                self.screen.get_height() // 2 - no_scores_surface.get_height() // 2
            ))
        else:
            # Initialize detail buttons list for interaction
            # Each entry: (rect, score_data, btn_type)  where btn_type = 'view' | 'delete'
            # Draw table headers
            header_font = get_font(self.settings.language, 'bold', 22)
            headers = [
                get_text(self.settings.language, 'rank'),
                get_text(self.settings.language, 'player_name'),
                get_text(self.settings.language, 'score'),
                get_text(self.settings.language, 'date'),
                get_text(self.settings.language, 'board_size'),
                get_text(self.settings.language, 'speed'),
                "",   # view button column
                "",   # delete button column
            ]

            col_widths = [55, 160, 80, 170, 100, 80, 70, 36]
            total_width = sum(col_widths)
            start_x = (self.screen.get_width() - total_width) // 2

            x = start_x
            for i, col_header in enumerate(headers):
                if col_header:
                    hs = header_font.render(col_header, True, COLORS['white'])
                    self.screen.blit(hs, (x + col_widths[i] // 2 - hs.get_width() // 2, 120))
                x += col_widths[i]

            pygame.draw.line(self.screen, COLORS['white'],
                (start_x, 150), (start_x + total_width, 150), 2)

            score_font = get_font(self.settings.language, 'regular', 18)
            btn_font  = get_font(self.settings.language, 'bold', 14)
            MEDAL_COLORS = {0: (255, 215, 0), 1: (192, 192, 192), 2: (205, 127, 50)}

            if self.scrollbar:
                self.scrollbar.content_height = self._content_height_for(len(filtered_scores))
                self.scrollbar.max_scroll = max(0, self.scrollbar.content_height - self.scrollbar.rect.height)
                self.scrollbar.update()

            start_y = self.LIST_TOP
            scroll_offset = self.scrollbar.get_content_offset() if self.scrollbar else 0
            visible_start = max(0, scroll_offset // self.ROW_HEIGHT)
            visible_end = min(len(filtered_scores), visible_start + 15)
            y = start_y - (scroll_offset % self.ROW_HEIGHT)

            for i, score in enumerate(filtered_scores[visible_start:visible_end], visible_start):
                row_bg = MEDAL_COLORS.get(i, None)
                row_rect = pygame.Rect(start_x, y - 4, total_width, 36)
                if row_bg:
                    s = pygame.Surface((total_width, 36), pygame.SRCALPHA)
                    s.fill((*row_bg, 50))
                    self.screen.blit(s, (start_x, y - 4))
                    pygame.draw.rect(self.screen, row_bg, row_rect, width=2, border_radius=4)
                elif i % 2 == 0:
                    s2 = pygame.Surface((total_width, 36), pygame.SRCALPHA)
                    s2.fill((255, 255, 255, 15))
                    self.screen.blit(s2, (start_x, y - 4))

                medal_labels = {0: '#1', 1: '#2', 2: '#3'}
                rank_label = medal_labels.get(i, f'#{i + 1}')

                name_text = str(score.get('name', '') or '')
                if score.get('victory', False):
                    name_text += ' ' + safe_mark(self.settings.language, 'check')

                speed_display = f"{score.get('update_rate_ms', 200)}ms"
                row_data = [
                    rank_label,
                    name_text,
                    str(score.get('score', 0)),
                    str(score.get('date', '') or ''),
                    f"{score.get('board_size', '?')}x{score.get('board_size', '?')}",
                    speed_display,
                ]

                txt_color = MEDAL_COLORS.get(i, COLORS['white'])
                x = start_x
                for j, data in enumerate(row_data):
                    ds = score_font.render(data, True, txt_color)
                    if j <= 1:
                        self.screen.blit(ds, (x + 6, y + 1))
                    else:
                        self.screen.blit(ds, (x + col_widths[j] // 2 - ds.get_width() // 2, y + 1))
                    x += col_widths[j]

                # View / Replay button
                has_replay = _score_has_replay(score)
                view_key = 'highscore_replay' if has_replay else 'highscore_view'
                view_text = get_text(self.settings.language, view_key)
                view_color = COLORS['light_blue'] if has_replay else COLORS['button']
                vw = col_widths[6] - 4
                vh = 28
                vx = x + 2
                vy = y + (36 - vh) // 2 - 4
                view_rect = pygame.Rect(vx, vy, vw, vh)
                pygame.draw.rect(self.screen, view_color, view_rect, border_radius=4)
                vt = render_fit(btn_font, view_text, COLORS['white'], vw - 4, padding=2)
                self.screen.blit(vt, vt.get_rect(center=view_rect.center))
                self.detail_buttons.append((view_rect, score, 'view'))
                x += col_widths[6]

                # Delete (×) button
                dx = x + 2
                dy = y + (36 - vh) // 2 - 4
                del_rect = pygame.Rect(dx, dy, col_widths[7] - 4, vh)
                pygame.draw.rect(self.screen, (180, 50, 50), del_rect, border_radius=4)
                xt = btn_font.render('\u00d7', True, COLORS['white'])
                self.screen.blit(xt, xt.get_rect(center=del_rect.center))
                self.detail_buttons.append((del_rect, score, 'delete'))

                y += self.ROW_HEIGHT

            # Draw delete-confirmation overlay if pending
            if self.confirm_delete is not None:
                ov = pygame.Surface(self.screen.get_size(), pygame.SRCALPHA)
                ov.fill((0, 0, 0, 160))
                self.screen.blit(ov, (0, 0))
                cx, cy = self.screen.get_width() // 2, self.screen.get_height() // 2
                dlg = pygame.Rect(cx - 200, cy - 70, 400, 140)
                pygame.draw.rect(self.screen, (40, 40, 60), dlg, border_radius=10)
                pygame.draw.rect(self.screen, COLORS['red'], dlg, border_radius=10, width=2)
                cf = get_font(self.settings.language, 'bold', 20)
                msg = cf.render(_t_or(self.settings.language, 'confirm_delete_score', 'Delete this score entry?'), True, COLORS['white'])
                self.screen.blit(msg, msg.get_rect(center=(cx, cy - 30)))
                yes_r = pygame.Rect(cx - 110, cy + 10, 90, 34)
                no_r  = pygame.Rect(cx + 20,  cy + 10, 90, 34)
                pygame.draw.rect(self.screen, (180, 50, 50), yes_r, border_radius=6)
                pygame.draw.rect(self.screen, COLORS['button'], no_r, border_radius=6)
                yt = cf.render(_t_or(self.settings.language, 'delete', 'Delete'), True, COLORS['white'])
                nt = cf.render(get_text(self.settings.language, 'cancel'), True, COLORS['white'])
                self.screen.blit(yt, yt.get_rect(center=yes_r.center))
                self.screen.blit(nt, nt.get_rect(center=no_r.center))
                # Store confirm dialog rects for run() to use
                self._confirm_yes_rect = yes_r
                self._confirm_no_rect  = no_r
                
        # Draw back button (rect comes from the shared header layout)
        back_rect = header['back']
        pygame.draw.rect(self.screen, COLORS['button'], back_rect, border_radius=10)
        
        back_font = get_font(self.settings.language, 'bold', 20)
        back_text = get_text(self.settings.language, 'back')
        back_surface = back_font.render(back_text, True, COLORS['white'])
        back_rect_center = back_rect.center
        self.screen.blit(back_surface, (
            back_rect_center[0] - back_surface.get_width() // 2, 
            back_rect_center[1] - back_surface.get_height() // 2
        ))
        
        # Draw scrollbar
        if self.scrollbar:
            self.scrollbar.draw(self.screen)
        
        # Filter menu is drawn LAST so it's always the topmost layer — it
        # previously drew before the score table, which then painted over
        # it, making it illegible.
        filter_menu_rects = self.draw_filter_menu(filter_rect)

        if (getattr(self, '_replay_share_notice', None) and
                time.monotonic() < getattr(self, '_replay_share_notice_until', 0.0)):
            notice = render_fit(get_font(self.settings.language, 'regular', 16),
                self._replay_share_notice, COLORS['light_gray'], self.screen.get_width() - 40)
            self.screen.blit(notice, notice.get_rect(
                center=(self.screen.get_width() // 2, self.screen.get_height() - 42)))
        
        # Update display
        _legacy_nav_draw(locals().get('self'))
        pygame.display.flip()
        
        return back_rect, search_rect, filter_rect, filter_menu_rects, import_rect

    def _paste_replay_share_code(self):
        try:
            score = import_replay_share_code(_read_from_clipboard())
            self._replay_share_notice = None
            self.view_replay(score)
        except (ValueError, TypeError, OSError) as exc:
            _logging_mod.getLogger('sgf').warning('Replay share import rejected: %s', exc)
            self._replay_share_notice = get_text(self.settings.language, 'replay_share_failed')
            self._replay_share_notice_until = time.monotonic() + 5.0
        
    def delete_score(self, score_data):
        """Delete a score and its independent replay file when unreferenced."""
        try:
            _gd = _load_data()
            highscores = _gd.get('highscores', [])
            game_id = score_data.get('game_id')
            if game_id:
                highscores = [s for s in highscores if s.get('game_id') != game_id]
            else:
                # Fallback: match by name + score + date
                highscores = [s for s in highscores if not (
                    s.get('name') == score_data.get('name') and
                    s.get('score') == score_data.get('score') and
                    s.get('date') == score_data.get('date')
                )]
            _gd['highscores'] = highscores
            if not _save_data(_gd):
                return
            _prune_score_replays(highscores)
            self.invalidate_highscores_cache()
        except Exception as e:
            print(f"Error deleting score: {e}")

    def _replay_notice(self, text):
        self._replay_share_notice = text
        self._replay_share_notice_until = time.monotonic() + 5.0

    def _replay_menu_body(self, score_data):
        language = self.settings.language
        board = score_data.get('board_size', '?')
        lines = [f"{get_text(language, 'board_size')}: {board}x{board} · "
                 f"{get_text(language, 'speed')}: {score_data.get('update_rate_ms', 200)}ms"]
        if score_data.get('seed'):
            lines.append(f"Seed: {score_data['seed']}")
        notice = getattr(self, '_replay_share_notice', None)
        if notice and time.monotonic() < getattr(self, '_replay_share_notice_until', 0.0):
            lines.append(notice)
        return '\n'.join(lines)

    def _replay_action_menu(self, score_data):
        """What to do with a replay: watch, race its ghost, copy a code, save a file."""
        language = self.settings.language
        chosen = {'action': None}
        menu = None

        def pick(action):
            chosen['action'] = action
            menu._go_back()

        entries = [('replay_watch', lambda: get_text(language, 'highscore_replay'),
                    COLORS['light_blue'], lambda: pick('watch'))]
        if _ghost_history_for_score(score_data) is not None:
            entries.append(('replay_race', lambda: get_text(language, 'daily_ghost_race'),
                            COLORS['purple'], lambda: pick('race')))
        entries.append(('replay_copy', lambda: get_text(language, 'replay_share_copy'),
                        COLORS['green'], lambda: pick('copy')))
        entries.append(('replay_file', lambda: _replay_ui_text(language, 'save_file'),
                        COLORS['button'], lambda: pick('file')))
        title = f"{score_data.get('name', '')}: {score_data.get('score', 0)}"
        menu = _SimpleMenuScreen(
            self.settings, self.screen, title_fn=lambda: title, entries=entries,
            body_fn=lambda: self._replay_menu_body(score_data))
        menu.runtime = getattr(self, 'runtime', None)
        menu.run()
        return chosen['action']

    def _copy_replay_share_code(self, score_data):
        language = self.settings.language
        try:
            copied = _copy_to_clipboard(export_replay_share_code(score_data))
            self._replay_notice(get_text(language, 'replay_share_copied' if copied else 'replay_share_failed'))
        except (ValueError, TypeError, OSError) as exc:
            _logging_mod.getLogger('sgf').warning('Replay share export failed: %s', exc)
            self._replay_notice(get_text(language, 'replay_share_failed'))

    def _save_replay_file(self, score_data):
        language = self.settings.language
        try:
            path = save_replay_file(score_data)
            self._replay_notice(_replay_ui_text(language, 'file_saved', name=os.path.basename(path)))
        except (ValueError, TypeError, OSError) as exc:
            _logging_mod.getLogger('sgf').warning('Replay file export failed: %s', exc)
            self._replay_notice(_replay_ui_text(language, 'file_failed'))

    def _import_replay_file(self, path):
        """A .sgfr file dropped on the window opens like a pasted share code."""
        try:
            score = load_replay_file(path)
        except (ValueError, TypeError, OSError, UnicodeError) as exc:
            _logging_mod.getLogger('sgf').warning('Replay file import rejected: %s', exc)
            self._replay_notice(_replay_ui_text(self.settings.language, 'file_import_failed'))
            return
        self._replay_share_notice = None
        self.view_replay(score)

    def _race_replay(self, score_data):
        """Play the replay's exact seed/rules live, racing its ghost."""
        history = _ghost_history_for_score(score_data)
        if history is None:
            self._replay_notice(get_text(self.settings.language, 'replay_share_failed'))
            return
        temp_settings = copy.deepcopy(self.settings)
        for key, value in (score_data.get('settings') or {}).items():
            if hasattr(temp_settings, key):
                setattr(temp_settings, key, value)
        if 'update_rate_ms' in score_data:
            temp_settings.update_rate_ms = score_data['update_rate_ms']
        game = SnakeGame(temp_settings, self.screen, seed=score_data.get('seed'),
                         custom_map=score_data.get('custom_map'))
        game.player_name = getattr(self, 'player_name', None) or 'Player'
        game.achievement_manager = getattr(self, 'achievement_manager', None)
        game.runtime = getattr(self, 'runtime', None)
        game._sgf_ghost_history = history
        game.run()
        self.invalidate_highscores_cache()

    def view_replay(self, score_data):
        """Replay actions: watch, race the ghost, copy a share code, save a file."""
        score_data = _history_for_score(score_data)
        if int(score_data.get('replay_format_version', 1) or 1) > _REPLAY_FORMAT_VERSION:
            self.show_details(score_data)
            return
        history = score_data.get('game_history', [])
        if not history and not score_data.get('mp_history'):
            self.show_details(score_data)
            return
        while True:
            action = self._replay_action_menu(score_data)
            if action == 'watch':
                self._play_replay(score_data)
            elif action == 'race':
                self._race_replay(score_data)
            elif action == 'copy':
                self._copy_replay_share_code(score_data)
            elif action == 'file':
                self._save_replay_file(score_data)
            else:
                return

    def _play_replay(self, score_data):
        """Load and play back a saved replay (single-, multi-player, or VS-AI)."""
        score_data = _history_for_score(score_data)
        replay_version = int(score_data.get('replay_format_version', 1) or 1)
        if replay_version > _REPLAY_FORMAT_VERSION:
            # Do not attempt to interpret a newer replay with an older reader.
            # Fall back to the metadata/detail view rather than silently showing
            # an incorrect simulation.
            self.show_details(score_data)
            return
        game_history = score_data.get('game_history', [])

        # ── VS-AI replay path ────────────────────────────────────────────
        if score_data.get('game_mode') == 'vs_ai':
            if not game_history or not isinstance(game_history[0], dict):
                self.show_details(score_data)
                return
            temp_settings = copy.deepcopy(self.settings)
            if 'settings' in score_data:
                for key, value in score_data['settings'].items():
                    if hasattr(temp_settings, key):
                        setattr(temp_settings, key, value)
            if 'update_rate_ms' in score_data:
                temp_settings.update_rate_ms = score_data['update_rate_ms']
            ai_count = score_data.get('ai_count', 1)
            ai_diff  = score_data.get('ai_difficulty', 'medium')
            vs_game  = VSAIGame(temp_settings, self.screen,
                                ai_count=ai_count, ai_difficulty=ai_diff,
                                seed=score_data.get('seed'),
                                custom_map=score_data.get('custom_map'))
            vs_game.start_replay(game_history)
            vs_game.run_replay()
            return

        # ── Multiplayer replay path ───────────────────────────────────────
        if score_data.get('is_multiplayer') and score_data.get('mp_history'):
            mp_history = score_data['mp_history']
            temp_settings = copy.deepcopy(self.settings)
            for key, value in (score_data.get('settings') or {}).items():
                if hasattr(temp_settings, key):
                    setattr(temp_settings, key, value)
            if 'update_rate_ms' in score_data:
                temp_settings.update_rate_ms = score_data['update_rate_ms']
            mode = score_data.get('mp_mode', '1v1')
            if isinstance(score_data.get('player_count'), int) and score_data['player_count'] > 0:
                game = LocalMultiplayerNGame(
                    temp_settings, self.screen, mode,
                    player_count=score_data['player_count'],
                    player_configs=score_data.get('player_configs'),
                    seed=score_data.get('seed'), custom_map=score_data.get('custom_map'))
            else:
                game = MultiplayerGame(temp_settings, self.screen, mode,
                                       custom_map=score_data.get('custom_map'))
            if game.start_replay(mp_history):
                game.run_replay()
            return

        # Single-player replay (existing logic)
        game_history = score_data.get('game_history', [])

        # Fall back to score-details screen for old/missing replays
        if not game_history or not isinstance(game_history[0], list):
            self.show_details(score_data)
            return

        # Recreate the original game settings so board size, speed, etc. match
        temp_settings = copy.deepcopy(self.settings)
        if 'settings' in score_data:
            for key, value in score_data['settings'].items():
                if hasattr(temp_settings, key):
                    setattr(temp_settings, key, value)
        # Also apply top-level convenience fields
        if 'update_rate_ms' in score_data:
            temp_settings.update_rate_ms = score_data['update_rate_ms']

        game = SnakeGame(temp_settings, self.screen, seed=score_data.get('seed'), custom_map=score_data.get('custom_map'))
        game.player_name = score_data.get('name', '')
        game.start_replay(game_history)
        game.run()
        
    def show_details(self, score_data):
        """Show detailed settings for a high score"""
        # Display a window with detailed information about the high score
        running = True
        details_clock = pygame.time.Clock()
        
        while running:
            _pump_audio()
            # Fill background
            self.screen.fill(COLORS['dark_blue'])
            
            # Draw title
            font = get_font(self.settings.language, 'bold', 26)
            title_text = f"{get_text(self.settings.language, 'score_details')}: {score_data['name']}"
            title_surface = font.render(title_text, True, COLORS['white'])
            self.screen.blit(title_surface, (self.screen.get_width() // 2 - title_surface.get_width() // 2, 50))
            
            # Draw score details
            details_font = get_font(self.settings.language, 'regular', 22)
            detail_y = 120
            detail_spacing = 30
            left_margin = self.screen.get_width() // 4
            
            # Basic info
            details = [
                (f"{get_text(self.settings.language, 'score')}: {score_data['score']}", COLORS['white']),
                (f"{get_text(self.settings.language, 'date')}: {score_data['date']}", COLORS['white']),
                (f"{get_text(self.settings.language, 'board_size')}: {score_data['board_size']}x{score_data['board_size']}", COLORS['white']),
                (f"{get_text(self.settings.language, 'speed')}: {score_data.get('update_rate_ms', 200)}ms", COLORS['white']),
                ("", COLORS['white']),  # Spacing
            ]
            _seed_val = score_data.get('seed', '')
            if _seed_val:
                details.insert(4, (f"Seed: {_seed_val}", (120, 150, 200)))
            
            # Game settings
            if 'settings' in score_data:
                settings_data = score_data['settings']
                # Add header for settings
                details.append((f"{get_text(self.settings.language, 'settings')}:", COLORS['light_blue']))
                
                # Display the settings in a readable format
                for key, value in settings_data.items():
                    # Skip complex objects and None values
                    if isinstance(value, (int, float, str, bool)) and value is not None:
                        # Format the key for better readability
                        formatted_key = key.replace('_', ' ').title()
                        details.append((f"{formatted_key}: {value}", COLORS['white']))
            
            # Draw each detail
            for detail, color in details:
                if detail:  # Skip empty strings (used for spacing)
                    detail_surface = details_font.render(detail, True, color)
                    self.screen.blit(detail_surface, (left_margin, detail_y))
                detail_y += detail_spacing
            
            # Draw back button
            back_rect = pygame.Rect(50, 50, 100, 40)
            pygame.draw.rect(self.screen, COLORS['button'], back_rect, border_radius=10)
            
            back_font = get_font(self.settings.language, 'bold', 20)
            back_text = get_text(self.settings.language, 'back')
            back_surface = back_font.render(back_text, True, COLORS['white'])
            self.screen.blit(back_surface, (back_rect.centerx - back_surface.get_width() // 2, 
                                           back_rect.centery - back_surface.get_height() // 2))

            copy_rect = None
            if _score_has_replay(score_data):
                copy_rect = pygame.Rect(max(20, (self.screen.get_width() - 280) // 2),
                                        self.screen.get_height() - 62, 280, 42)
                pygame.draw.rect(self.screen, COLORS['blue'], copy_rect, border_radius=8)
                copy_label = get_text(self.settings.language, 'replay_share_copy')
                copy_surface = render_fit(get_font(self.settings.language, 'bold', 18),
                                          copy_label, COLORS['white'], copy_rect.width - 12)
                self.screen.blit(copy_surface, copy_surface.get_rect(center=copy_rect.center))
            if (getattr(self, '_replay_share_notice', None) and
                    time.monotonic() < getattr(self, '_replay_share_notice_until', 0.0)):
                notice_surface = render_fit(get_font(self.settings.language, 'regular', 16),
                    self._replay_share_notice, COLORS['light_gray'], self.screen.get_width() - 40)
                self.screen.blit(notice_surface, notice_surface.get_rect(
                    center=(self.screen.get_width() // 2, self.screen.get_height() - 82)))
            
            # Update display
            _legacy_nav_draw(locals().get('self'))
            pygame.display.flip()
            
            # Handle events
            for event in pygame.event.get():
                if _legacy_nav_event(locals().get('self'), event, locals()):
                    continue
                if getattr(self, 'runtime', None) is not None:
                    handled, _actions = self.runtime.input.route(event)
                    if handled:
                        continue
                if event.type == pygame.QUIT:
                    running = False
                    
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    if back_rect.collidepoint(event.pos):
                        running = False
                    elif copy_rect and copy_rect.collidepoint(event.pos):
                        try:
                            code = export_replay_share_code(score_data)
                            copied = _copy_to_clipboard(code)
                            self._replay_share_notice = get_text(
                                self.settings.language, 'replay_share_copied') if copied else get_text(
                                self.settings.language, 'replay_share_failed')
                            self._replay_share_notice_until = time.monotonic() + 5.0
                        except (ValueError, TypeError, OSError) as exc:
                            _logging_mod.getLogger('sgf').warning('Replay share export failed: %s', exc)
                            self._replay_share_notice = get_text(
                                self.settings.language, 'replay_share_failed')
                            self._replay_share_notice_until = time.monotonic() + 5.0
                        
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif event.key == pygame.K_ESCAPE:
                        running = False
            
            # Cap frame rate
            details_frame_ms = details_clock.tick(60)
            DEV_TOOLS.telemetry.record_frame(details_frame_ms)
    
    def run(self):
        """Run the high scores screen with scroll support"""
        running = True
        highscores_clock = pygame.time.Clock()
        if self.scrollbar is None:
            self.init_scrollbar()
        # Always reflect on-disk reality on (re)entry — a new game may have
        # added a score since this screen object was last shown.
        self.invalidate_highscores_cache()

        while running:
            _pump_audio()
            back_rect, search_rect, filter_rect, filter_menu_rects, import_rect = self.draw_screen()

            for event in pygame.event.get():
                if _legacy_nav_event(locals().get('self'), event, locals()):
                    continue
                if event.type == pygame.QUIT:
                    running = False

                if self.scrollbar:
                    self.scrollbar.handle_event(event)

                if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    mouse_pos = event.pos

                    # ── Delete confirmation dialog (highest priority) ─────────
                    if self.confirm_delete is not None:
                        yes_r = getattr(self, '_confirm_yes_rect', None)
                        no_r  = getattr(self, '_confirm_no_rect',  None)
                        if yes_r and yes_r.collidepoint(mouse_pos):
                            self.delete_score(self.confirm_delete)
                            self.confirm_delete = None
                        elif no_r and no_r.collidepoint(mouse_pos):
                            self.confirm_delete = None
                        continue  # eat click while dialog is open

                    # ── Primary navigation targets ───────────────────────────
                    primary_handled = False

                    if back_rect.collidepoint(mouse_pos):
                        running = False
                        primary_handled = True
                    elif search_rect.collidepoint(mouse_pos):
                        self.search_active = True
                        self.filter_menu_open = False
                        primary_handled = True
                    elif filter_rect.collidepoint(mouse_pos):
                        self.filter_menu_open = not self.filter_menu_open
                        self.search_active = False
                        primary_handled = True
                    elif import_rect and import_rect.collidepoint(mouse_pos):
                        self.search_active = False
                        primary_handled = True
                        self._paste_replay_share_code()

                    if primary_handled:
                        continue

                    # ── Filter menu items ────────────────────────────────────
                    if self.filter_menu_open:
                        menu_clicked = False
                        for rect, action in filter_menu_rects:
                            if rect.collidepoint(mouse_pos):
                                menu_clicked = True
                                if action == "close_filter":
                                    self.filter_menu_open = False
                                elif action == "reset_filters":
                                    self.filter_options = {
                                        "sort_by": "score",
                                        "order": "desc",
                                        "show_victories": "all",
                                        "difficulty": "all",
                                        "has_replay": "all",
                                        "obstacles": "all",
                                        "powerups": "all",
                                    }
                                elif ':' in action:
                                    key, val = action.split(':', 1)
                                    self.filter_options[key] = val
                                break
                        if not menu_clicked:
                            self.filter_menu_open = False
                        continue

                    # ── Row buttons (View / Delete) ──────────────────────────
                    row_handled = False
                    for btn_rect, score_data, btn_type in self.detail_buttons:
                        if btn_rect.collidepoint(mouse_pos):
                            row_handled = True
                            if btn_type == 'delete':
                                self.confirm_delete = score_data
                            elif score_data.get('has_replay', False):
                                self.view_replay(score_data)
                            else:
                                self.show_details(score_data)
                            break

                    # ── Clicking elsewhere deactivates search ────────────────
                    if not row_handled:
                        self.search_active = False

                elif event.type == pygame.DROPFILE:
                    self._import_replay_file(event.file)
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif event.key == pygame.K_v and event.mod & pygame.KMOD_CTRL and not self.search_active:
                        self._paste_replay_share_code()
                    elif event.key == pygame.K_ESCAPE:
                        if self.confirm_delete is not None:
                            self.confirm_delete = None
                        elif self.filter_menu_open:
                            self.filter_menu_open = False
                        elif self.search_active:
                            self.search_active = False
                        else:
                            running = False
                    elif self.search_active:
                        if event.key == pygame.K_RETURN:
                            self.search_active = False
                        elif event.key == pygame.K_BACKSPACE:
                            self.search_text = self.search_text[:-1]
                        elif event.unicode.isprintable():
                            self.search_text += event.unicode

                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    self.init_scrollbar()

            # Update scrollbar
            if self.scrollbar:
                self.scrollbar.update()
            
            # Cap the frame rate
            highscores_frame_ms = highscores_clock.tick(60)
            DEV_TOOLS.telemetry.record_frame(highscores_frame_ms)

