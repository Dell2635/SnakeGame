    def draw_menu(self):
        """Draw the main menu with animations and effects. Layout is rebuilt only
        when the window size or language changes; everything else is cached."""
        scr = self.screen
        scr.fill(COLORS['dark_blue'])

        # Draw animated background particles
        self.update_particles()
        self.draw_particles()

        sig = (scr.get_width(), scr.get_height(), self.settings.language)
        if sig != self._menu_sig:
            self._menu_sig = sig
            self._build_menu()
        self.ui.language = self.settings.language
        self.ui.update(self._dt)
        self.ui.draw(scr)

        # Apply transition effect if in transition
        if self.transition_alpha > 0:
            if self.transition_surface.get_size() != scr.get_size():
                self.transition_surface = pygame.Surface(scr.get_size())
                self.transition_surface.fill((0, 0, 0))
            self.transition_surface.set_alpha(self.transition_alpha)
            scr.blit(self.transition_surface, (0, 0))

            # Update transition alpha
            if self.transition_in:
                self.transition_alpha = max(0, self.transition_alpha - self.transition_speed)
            else:
                self.transition_alpha = min(255, self.transition_alpha + self.transition_speed)

        # Draw achievement notifications (before the flip so they are actually visible)
        if getattr(self, 'achievement_manager', None):
            self.achievement_manager.draw_notification(scr, scr.get_width(), scr.get_height(), self.settings.language)

        # Update display
        _legacy_nav_draw(locals().get('self'))
        pygame.display.flip()

