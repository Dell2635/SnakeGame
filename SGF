                pygame.draw.rect(self.screen, highlight_color, key_rect, border_radius=5)
                
                # Add a subtle glow effect
                glow_size = 4
                glow_rect = pygame.Rect(
                    key_rect.x - glow_size,
                    key_rect.y - glow_size,
