class MapEditorScreen:
    """
    Map editor: create/edit/save/load/delete/export custom board layouts
    (static obstacles + portal pairs). Persists into the same unified JSON
    data file as everything else, under a 'custom_maps' key, and can also
    export a standalone .json file. Reuses ScrollBar for the map list.
    """

    PORTAL_PALETTE = [
        ((0, 191, 255), (75, 0, 130)),      # sky blue / indigo
        ((255, 105, 180), (0, 170, 90)),    # pink / green
        ((255, 165, 0), (0, 200, 200)),     # orange / teal
        ((220, 20, 60), (255, 215, 0)),     # crimson / gold
    ]

    def __init__(self, settings, screen):
        self.settings = settings
        self.screen = screen
        self.board_width = 20
        self.board_height = 20
        self.obstacles = set()
        self.portals = []            # list of (x1, y1, x2, y2, palette_idx) — one full pair each
        self.pending_portal = None   # (x, y) awaiting its pair, or None
        self.current_tool = 'obstacle'  # 'obstacle' | 'portal' | 'eraser'
        self.map_name = None
        self.dirty = False
        self.history = []
        self.future = []
        self.preview_mode = False
        self.scrollbar = None
        self._status_message = None
        self._status_until = 0
        self._mode = 'edit'   # 'edit' | 'save_prompt' | 'export_prompt' | 'load_list' | 'confirm'
        self._name_input = ""
        self._confirm_message = ""
        self._confirm_action = None
        self._confirm_pending_screen = None  # what to show after a confirm resolves, if not editing

    # ---------- geometry ----------
    def _layout(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        toolbar_h = int(sh * 0.20) if not self.preview_mode else int(sh * 0.06)
        board_area = pygame.Rect(0, toolbar_h, sw, sh - toolbar_h)
        cell = min(board_area.width // max(1, self.board_width),
                   board_area.height // max(1, self.board_height))
        cell = max(4, cell)
        board_px_w = cell * self.board_width
        board_px_h = cell * self.board_height
        ox = board_area.x + (board_area.width - board_px_w) // 2
        oy = board_area.y + (board_area.height - board_px_h) // 2
        return {'toolbar_h': toolbar_h, 'cell': cell, 'ox': ox, 'oy': oy,
                'board_rect': pygame.Rect(ox, oy, board_px_w, board_px_h)}

    def _pixel_to_cell(self, pos, layout):
        cell = layout['cell']
        if cell <= 0:
            return None
        cx = (pos[0] - layout['ox']) // cell
        cy = (pos[1] - layout['oy']) // cell
        if 0 <= cx < self.board_width and 0 <= cy < self.board_height:
            return int(cx), int(cy)
        return None

    # ---------- history (undo/redo) ----------
    def _snapshot(self):
        return {
            'board_width': self.board_width,
            'board_height': self.board_height,
            'obstacles': set(self.obstacles),
            'portals': list(self.portals),
        }

    def _push_history(self):
        self.history.append(self._snapshot())
        if len(self.history) > 50:
            self.history.pop(0)
        self.future.clear()

    def _restore(self, snap):
        self.board_width = snap['board_width']
        self.board_height = snap['board_height']
        self.obstacles = set(snap['obstacles'])
        self.portals = list(snap['portals'])

    def undo(self):
        if not self.history:
            return
        self.future.append(self._snapshot())
        self._restore(self.history.pop())
        self.dirty = True
        self._set_status("Undo")

    def redo(self):
        if not self.future:
            return
        self.history.append(self._snapshot())
        self._restore(self.future.pop())
        self.dirty = True
        self._set_status("Redo")

    def _set_status(self, msg, seconds=1.5):
        self._status_message = msg
        self._status_until = time.time() + seconds

    # ---------- editing actions ----------
    def _occupied(self, cell):
        if cell in self.obstacles:
            return True
        if self.pending_portal == cell:
            return True
        for p in self.portals:
            if (p[0], p[1]) == cell or (p[2], p[3]) == cell:
                return True
        return False

    def place_obstacle(self, cell):
        if self._occupied(cell):
            return
        self._push_history()
        self.obstacles.add(cell)
        self.dirty = True

    def place_portal(self, cell):
        if self._occupied(cell):
            return
        if self.pending_portal is None:
            self.pending_portal = cell
            self._set_status("First portal placed — click again for its pair")
        else:
            self._push_history()
            palette_idx = len(self.portals) % len(self.PORTAL_PALETTE)
            self.portals.append((self.pending_portal[0], self.pending_portal[1],
                                  cell[0], cell[1], palette_idx))
            self.pending_portal = None
            self.dirty = True

    def erase(self, cell):
        changed = False
        if cell in self.obstacles:
            self.obstacles = self.obstacles - {cell}
            changed = True
        for p in list(self.portals):
            if (p[0], p[1]) == cell or (p[2], p[3]) == cell:
                self.portals.remove(p)
                changed = True
        if self.pending_portal == cell:
            self.pending_portal = None
            changed = True
        if changed:
            self._push_history()
            self.dirty = True

    def clear_map(self):
        self._push_history()
        self.obstacles = set()
        self.portals = []
        self.pending_portal = None
        self.dirty = True
        self._set_status("Map cleared")

    def resize_board(self, dw, dh):
        new_w = max(5, min(60, self.board_width + dw))
        new_h = max(5, min(60, self.board_height + dh))
        if new_w == self.board_width and new_h == self.board_height:
            return
        self._push_history()
        self.obstacles = {(x, y) for (x, y) in self.obstacles if x < new_w and y < new_h}
        self.portals = [p for p in self.portals
                        if p[0] < new_w and p[1] < new_h and p[2] < new_w and p[3] < new_h]
        if self.pending_portal and (self.pending_portal[0] >= new_w or self.pending_portal[1] >= new_h):
            self.pending_portal = None
        self.board_width, self.board_height = new_w, new_h
        self.dirty = True

    # ---------- persistence ----------
    def _all_maps(self):
        try:
            gd = _load_data()
            return gd.get('custom_maps', {})
        except Exception:
            return {}

    def save_map(self, name):
        try:
            gd = _load_data()
            maps = gd.get('custom_maps', {})
            maps[name] = {
                'board_width': self.board_width,
                'board_height': self.board_height,
                'obstacles': [list(o) for o in self.obstacles],
                'portals': [list(p) for p in self.portals],
                'saved_at': datetime.now().isoformat(),
            }
            gd['custom_maps'] = maps
            _save_data(gd)
            self.map_name = name
            self.dirty = False
            self._set_status(f"Saved '{name}'")
            return True
        except Exception as e:
            print(f"Error saving map: {e}")
            self._set_status("Save failed")
            return False

    def load_map(self, name):
        data = self._all_maps().get(name)
        if not data:
            return False
        self._push_history()
        self.board_width = data.get('board_width', 20)
        self.board_height = data.get('board_height', 20)
        self.obstacles = {tuple(o) for o in data.get('obstacles', [])}
        self.portals = [tuple(p) for p in data.get('portals', [])]
        self.pending_portal = None
        self.map_name = name
        self.dirty = False
        self._set_status(f"Loaded '{name}'")
        return True

    def delete_map(self, name):
        try:
            gd = _load_data()
            maps = gd.get('custom_maps', {})
            if name in maps:
                del maps[name]
                gd['custom_maps'] = maps
                _save_data(gd)
                if self.map_name == name:
                    self.map_name = None
                self._set_status(f"Deleted '{name}'")
                return True
        except Exception as e:
            print(f"Error deleting map: {e}")
        return False

    def export_json(self, name):
        """Write a standalone .json file the player can back up or share —
        separate from the in-game unified save file."""
        safe_name = "".join(c for c in name if c.isalnum() or c in ('-', '_')) or "map"
        filename = f"map_{safe_name}.json"
        payload = {
            'name': name,
            'board_width': self.board_width,
            'board_height': self.board_height,
            'obstacles': [list(o) for o in self.obstacles],
            'portals': [list(p) for p in self.portals],
            'exported_at': datetime.now().isoformat(),
        }
        try:
            with open(filename, 'w', encoding='utf-8') as f:
                json.dump(payload, f, indent=2)
            self._set_status(f"Exported to {filename}")
            return filename
        except Exception as e:
            print(f"Error exporting map: {e}")
            self._set_status("Export failed")
            return None

    # ---------- drawing ----------
    def _draw_board(self, layout):
        board_rect = layout['board_rect']
        cell = layout['cell']
        pygame.draw.rect(self.screen, (18, 24, 45), board_rect)

        if not self.preview_mode and cell >= 6:
            grid_color = (35, 45, 75)
            for x in range(self.board_width + 1):
                px = board_rect.x + x * cell
                pygame.draw.line(self.screen, grid_color, (px, board_rect.y), (px, board_rect.bottom))
            for y in range(self.board_height + 1):
                py = board_rect.y + y * cell
                pygame.draw.line(self.screen, grid_color, (board_rect.x, py), (board_rect.right, py))

        pygame.draw.rect(self.screen, (80, 110, 170), board_rect, width=2)

        # Obstacles
        for (x, y) in self.obstacles:
            r = pygame.Rect(board_rect.x + x * cell, board_rect.y + y * cell, cell, cell)
            pygame.draw.rect(self.screen, COLORS.get('obstacle', (100, 100, 100)), r)
            if cell > 10:
                hi = COLORS.get('obstacle_highlight', (130, 130, 130))
                pygame.draw.line(self.screen, hi, r.topleft, r.bottomright, max(1, cell // 10))
                pygame.draw.line(self.screen, hi, r.topright, r.bottomleft, max(1, cell // 10))

        # Portals — each pair drawn in its own colour from the palette,
        # so different pairs are visually distinguishable at a glance.
        for (x1, y1, x2, y2, pal_idx) in self.portals:
            c1, c2 = self.PORTAL_PALETTE[pal_idx % len(self.PORTAL_PALETTE)]
            r1 = pygame.Rect(board_rect.x + x1 * cell, board_rect.y + y1 * cell, cell, cell)
            r2 = pygame.Rect(board_rect.x + x2 * cell, board_rect.y + y2 * cell, cell, cell)
            pygame.draw.ellipse(self.screen, c1, r1)
            pygame.draw.ellipse(self.screen, c2, r2)
            pygame.draw.ellipse(self.screen, (255, 255, 255), r1, width=max(1, cell // 12))
            pygame.draw.ellipse(self.screen, (255, 255, 255), r2, width=max(1, cell // 12))

        if self.pending_portal:
            x, y = self.pending_portal
            r = pygame.Rect(board_rect.x + x * cell, board_rect.y + y * cell, cell, cell)
            pygame.draw.ellipse(self.screen, (255, 255, 255), r, width=2)

    def _toolbar_rects(self, layout):
        sw = self.screen.get_width()
        th = layout['toolbar_h']
        pad = 8
        row_h = (th - pad * 3) // 2
        row1_y = pad
        row2_y = pad * 2 + row_h
        rects = {}

        # Row 1 (left): tool selection
        x = pad
        for key in ['tool_obstacle', 'tool_portal', 'tool_eraser']:
            w = max(64, int(sw * 0.09))
            rects[key] = pygame.Rect(x, row1_y, w, row_h)
            x += w + 6

        # Row 1 (right): primary actions
        rx = sw - pad
        for key in ['back', 'export', 'load', 'save', 'preview']:
            w = max(56, int(sw * 0.075))
            rx -= w
            rects[key] = pygame.Rect(rx, row1_y, w, row_h)
            rx -= 6

        # Row 2 (left): undo/redo/clear
        x = pad
        for key in ['undo', 'redo', 'clear']:
            w = max(56, int(sw * 0.07))
            rects[key] = pygame.Rect(x, row2_y, w, row_h)
            x += w + 6

        # Row 2 (middle): resize steppers
        x += 16
        for key in ['w_minus', 'w_plus']:
            rects[key] = pygame.Rect(x, row2_y, 28, row_h)
            x += 28 + 3
        x += 14
        for key in ['h_minus', 'h_plus']:
            rects[key] = pygame.Rect(x, row2_y, 28, row_h)
            x += 28 + 3

        rects['_row2_controls_end'] = pygame.Rect(x, row2_y, 0, row_h)
        rects['_row1_y'] = pygame.Rect(0, row1_y, 0, row_h)
        rects['_row2_y'] = pygame.Rect(0, row2_y, 0, row_h)
        return rects

    def _draw_toolbar(self, layout, rects):
        th = layout['toolbar_h']
        sw = self.screen.get_width()
        pygame.draw.rect(self.screen, (10, 14, 30), pygame.Rect(0, 0, sw, th))
        pygame.draw.line(self.screen, (50, 90, 155), (0, th), (sw, th), 2)

        font = get_font(self.settings.language, 'bold', 13)

        def _btn(key, label, active=False, color=None):
            if key not in rects:
                return
            r = rects[key]
            bg = color or ((55, 110, 190) if active else (35, 45, 70))
            pygame.draw.rect(self.screen, bg, r, border_radius=5)
            pygame.draw.rect(self.screen, (90, 130, 200), r, width=1, border_radius=5)
            s = font.render(label, True, COLORS['white'])
            self.screen.blit(s, s.get_rect(center=r.center))

        _btn('tool_obstacle', 'Obstacle', active=(self.current_tool == 'obstacle'))
        _btn('tool_portal', 'Portal', active=(self.current_tool == 'portal'))
        _btn('tool_eraser', 'Eraser', active=(self.current_tool == 'eraser'))
        _btn('back', 'Back')
        _btn('export', 'Export')
        _btn('load', 'Load')
        _btn('save', 'Save', color=(35, 110, 60))
        _btn('preview', 'Preview' if not self.preview_mode else 'Editing', active=self.preview_mode)

        _btn('undo', 'Undo', color=(45, 45, 45) if not self.history else None)
        _btn('redo', 'Redo', color=(45, 45, 45) if not self.future else None)
        _btn('clear', 'Clear', color=(110, 40, 40))
        _btn('w_minus', '-')
        _btn('w_plus', '+')
        _btn('h_minus', '-')
        _btn('h_plus', '+')

        # Dimension readout, above its own steppers (row 2 has room since
        # row 1 only holds buttons, not a second label line)
        dim_font = get_font(self.settings.language, 'regular', 12)
        dim_s = dim_font.render(f"W:{self.board_width}", True, (180, 200, 230))
        self.screen.blit(dim_s, (rects['w_minus'].x, rects['w_minus'].y - 14))
        dim_s2 = dim_font.render(f"H:{self.board_height}", True, (180, 200, 230))
        self.screen.blit(dim_s2, (rects['h_minus'].x, rects['h_minus'].y - 14))

        # Map name — placed after the resize controls, with a guaranteed
        # minimum gap, and truncated if the window is too narrow to fit it
        # rather than overlapping the buttons before or after it.
        name_font = get_font(self.settings.language, 'regular', 13)
        title = self.map_name or "(unsaved map)"
        if self.dirty:
            title += " *"
        name_x = rects['_row2_controls_end'].x + 16
        max_name_w = sw - name_x - 10
        if max_name_w > 30:
            name_s = name_font.render(title, True, (210, 220, 240))
            if name_s.get_width() > max_name_w:
                # Truncate with an ellipsis rather than overflow
                while len(title) > 1 and name_font.size(title + "…")[0] > max_name_w:
                    title = title[:-1]
                name_s = name_font.render(title + "…", True, (210, 220, 240))
            self.screen.blit(name_s, (name_x, rects['_row2_y'].y + rects['_row2_y'].height // 2 - name_s.get_height() // 2))

    def _draw_status(self):
        if self._status_message and time.time() < self._status_until:
            font = get_font(self.settings.language, 'regular', 15)
            s = font.render(self._status_message, True, (140, 220, 140))
            sw = self.screen.get_width()
            self.screen.blit(s, (sw // 2 - s.get_width() // 2, self.screen.get_height() - 30))

    def _draw_text_prompt(self, title):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        overlay = pygame.Surface((sw, sh), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 180))
        self.screen.blit(overlay, (0, 0))

        box_w, box_h = min(420, int(sw * 0.7)), 140
        box = pygame.Rect(sw // 2 - box_w // 2, sh // 2 - box_h // 2, box_w, box_h)
        pygame.draw.rect(self.screen, (25, 32, 55), box, border_radius=10)
        pygame.draw.rect(self.screen, (90, 130, 200), box, width=2, border_radius=10)

        title_font = get_font(self.settings.language, 'bold', 20)
        ts = title_font.render(title, True, COLORS['white'])
        self.screen.blit(ts, (box.centerx - ts.get_width() // 2, box.y + 16))

        input_rect = pygame.Rect(box.x + 20, box.y + 56, box.width - 40, 34)
        pygame.draw.rect(self.screen, (255, 255, 255), input_rect, border_radius=4)
        input_font = get_font(self.settings.language, 'regular', 18)
        it = input_font.render(self._name_input + "|", True, (20, 20, 20))
        self.screen.blit(it, (input_rect.x + 6, input_rect.y + 6))

        hint_font = get_font(self.settings.language, 'regular', 13)
        hint = hint_font.render("Enter to confirm, Esc to cancel", True, (150, 165, 200))
        self.screen.blit(hint, (box.centerx - hint.get_width() // 2, box.y + box.height - 26))
        return {'input': input_rect}

    def _draw_confirm(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        overlay = pygame.Surface((sw, sh), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 180))
        self.screen.blit(overlay, (0, 0))

        box_w, box_h = min(440, int(sw * 0.75)), 150
        box = pygame.Rect(sw // 2 - box_w // 2, sh // 2 - box_h // 2, box_w, box_h)
        pygame.draw.rect(self.screen, (25, 32, 55), box, border_radius=10)
        pygame.draw.rect(self.screen, (200, 80, 80), box, width=2, border_radius=10)

        msg_font = get_font(self.settings.language, 'regular', 17)
        msg = msg_font.render(self._confirm_message, True, COLORS['white'])
        self.screen.blit(msg, (box.centerx - msg.get_width() // 2, box.y + 24))

        yes_rect = pygame.Rect(box.centerx - 110, box.bottom - 54, 100, 38)
        no_rect = pygame.Rect(box.centerx + 10, box.bottom - 54, 100, 38)
        pygame.draw.rect(self.screen, (110, 40, 40), yes_rect, border_radius=6)
        pygame.draw.rect(self.screen, (60, 60, 70), no_rect, border_radius=6)
        bf = get_font(self.settings.language, 'bold', 16)
        ys = bf.render("Yes", True, COLORS['white'])
        ns = bf.render("Cancel", True, COLORS['white'])
        self.screen.blit(ys, ys.get_rect(center=yes_rect.center))
        self.screen.blit(ns, ns.get_rect(center=no_rect.center))
        return {'yes': yes_rect, 'no': no_rect}

    def _draw_load_list(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        overlay = pygame.Surface((sw, sh), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 190))
        self.screen.blit(overlay, (0, 0))

        box = pygame.Rect(int(sw * 0.15), int(sh * 0.1), int(sw * 0.7), int(sh * 0.8))
        pygame.draw.rect(self.screen, (20, 26, 48), box, border_radius=10)
        pygame.draw.rect(self.screen, (90, 130, 200), box, width=2, border_radius=10)

        title_font = get_font(self.settings.language, 'bold', 22)
        ts = title_font.render("Load Map", True, COLORS['white'])
        self.screen.blit(ts, (box.centerx - ts.get_width() // 2, box.y + 14))

        maps = self._all_maps()
        names = sorted(maps.keys())
        row_h = 44
        content_rect = pygame.Rect(box.x + 10, box.y + 56, box.width - 20, box.height - 110)

        if self.scrollbar is None or getattr(self, '_scrollbar_rect', None) != content_rect:
            self.scrollbar = ScrollBar(content_rect.right - 14, content_rect.y, 14,
                                       content_rect.height, max(len(names) * row_h, content_rect.height))
            self._scrollbar_rect = content_rect
        self.scrollbar.content_height = max(len(names) * row_h, content_rect.height)
        self.scrollbar.max_scroll = max(0, self.scrollbar.content_height - content_rect.height)

        self.screen.set_clip(content_rect)
        offset = self.scrollbar.get_content_offset()
        row_rects = []
        row_font = get_font(self.settings.language, 'regular', 16)
        for i, name in enumerate(names):
            ry = content_rect.y + i * row_h - offset
            row_rect = pygame.Rect(content_rect.x, ry, content_rect.width - 20, row_h - 6)
            if row_rect.bottom < content_rect.top or row_rect.top > content_rect.bottom:
                row_rects.append((name, row_rect, None))
                continue
            pygame.draw.rect(self.screen, (32, 40, 68), row_rect, border_radius=6)
            info = maps[name]
            label = f"{name}  ({info.get('board_width','?')}x{info.get('board_height','?')})"
            ls = row_font.render(label, True, COLORS['white'])
            self.screen.blit(ls, (row_rect.x + 10, row_rect.centery - ls.get_height() // 2))

            del_rect = pygame.Rect(row_rect.right - 60, row_rect.y + 4, 54, row_rect.height - 8)
            pygame.draw.rect(self.screen, (110, 40, 40), del_rect, border_radius=5)
            df = get_font(self.settings.language, 'bold', 13)
            ds = df.render("Delete", True, COLORS['white'])
            self.screen.blit(ds, ds.get_rect(center=del_rect.center))
            row_rects.append((name, row_rect, del_rect))
        self.screen.set_clip(None)
        self.scrollbar.draw(self.screen)

        if not names:
            empty_font = get_font(self.settings.language, 'regular', 16)
            es = empty_font.render("No saved maps yet.", True, (140, 155, 185))
            self.screen.blit(es, (content_rect.centerx - es.get_width() // 2, content_rect.y + 20))

        close_rect = pygame.Rect(box.centerx - 60, box.bottom - 42, 120, 32)
        pygame.draw.rect(self.screen, (60, 60, 70), close_rect, border_radius=6)
        cf = get_font(self.settings.language, 'bold', 15)
        cs = cf.render("Close", True, COLORS['white'])
        self.screen.blit(cs, cs.get_rect(center=close_rect.center))

        return {'rows': row_rects, 'close': close_rect, 'content_rect': content_rect}

    # ---------- main loop ----------
    def run(self):
        clock = pygame.time.Clock()
        running = True
        load_ui = {}
        prompt_ui = {}
        confirm_ui = {}

        while running:
            layout = self._layout()
            self.screen.fill(COLORS['dark_blue'])
            self._draw_board(layout)
            if not self.preview_mode:
                toolbar_rects = self._toolbar_rects(layout)
                self._draw_toolbar(layout, toolbar_rects)
            else:
                toolbar_rects = {}
                hint_font = get_font(self.settings.language, 'regular', 14)
                hs = hint_font.render("Preview — click anywhere or press Esc to go back to editing",
                                      True, (170, 190, 220))
                self.screen.blit(hs, (self.screen.get_width() // 2 - hs.get_width() // 2, 6))
            self._draw_status()

            if self._mode == 'save_prompt':
                prompt_ui = self._draw_text_prompt("Save map as:")
            elif self._mode == 'export_prompt':
                prompt_ui = self._draw_text_prompt("Export map as:")
            elif self._mode == 'load_list':
                load_ui = self._draw_load_list()
            elif self._mode == 'confirm':
                confirm_ui = self._draw_confirm()

            pygame.display.flip()

            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit(); sys.exit()

                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    self.scrollbar = None

                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif self._mode in ('save_prompt', 'export_prompt'):
                        if event.key == pygame.K_RETURN and self._name_input.strip():
                            name = self._name_input.strip()
                            if self._mode == 'save_prompt':
                                existing = self._all_maps()
                                if name in existing:
                                    self._confirm_message = f"Overwrite existing map '{name}'?"
                                    self._confirm_action = ('save', name)
                                    self._mode = 'confirm'
                                else:
                                    self.save_map(name)
                                    self._mode = 'edit'
                            else:
                                self.export_json(name)
                                self._mode = 'edit'
                        elif event.key == pygame.K_ESCAPE:
                            self._mode = 'edit'
                        elif event.key == pygame.K_BACKSPACE:
                            self._name_input = self._name_input[:-1]
                        elif event.unicode and event.unicode.isprintable() and len(self._name_input) < 40:
                            self._name_input += event.unicode
                    elif self._mode == 'load_list':
                        if event.key == pygame.K_ESCAPE:
                            self._mode = 'edit'
                    elif self._mode == 'confirm':
                        if event.key == pygame.K_ESCAPE:
                            self._mode = 'edit'
                    elif self.preview_mode:
                        if event.key == pygame.K_ESCAPE:
                            self.preview_mode = False
                    else:
                        if event.key == pygame.K_ESCAPE:
                            if self.dirty:
                                self._confirm_message = "Discard unsaved changes and go back?"
                                self._confirm_action = ('back', None)
                                self._mode = 'confirm'
                            else:
                                running = False
                        elif event.key == pygame.K_z and (pygame.key.get_mods() & pygame.KMOD_CTRL):
                            self.undo()
                        elif event.key == pygame.K_y and (pygame.key.get_mods() & pygame.KMOD_CTRL):
                            self.redo()

                elif event.type == pygame.MOUSEWHEEL:
                    if self._mode == 'load_list' and self.scrollbar:
                        self.scrollbar.handle_event(event)

                elif event.type in (pygame.MOUSEBUTTONUP, pygame.MOUSEMOTION) and self._mode == 'load_list':
                    if self.scrollbar:
                        self.scrollbar.handle_event(event)

                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    mp = event.pos

                    if self._mode == 'save_prompt' or self._mode == 'export_prompt':
                        continue  # text prompt only accepts keyboard

                    elif self._mode == 'load_list':
                        if load_ui.get('close') and load_ui['close'].collidepoint(mp):
                            self._mode = 'edit'
                        else:
                            for name, row_rect, del_rect in load_ui.get('rows', []):
                                if del_rect and del_rect.collidepoint(mp):
                                    self._confirm_message = f"Delete map '{name}'? This can't be undone."
                                    self._confirm_action = ('delete', name)
                                    self._mode = 'confirm'
                                    break
                                elif row_rect.collidepoint(mp):
                                    if self.dirty:
                                        self._confirm_message = f"Discard unsaved changes and load '{name}'?"
                                        self._confirm_action = ('load', name)
                                        self._mode = 'confirm'
                                    else:
                                        self.load_map(name)
                                        self._mode = 'edit'
                                    break

                    elif self._mode == 'confirm':
                        if confirm_ui.get('yes') and confirm_ui['yes'].collidepoint(mp):
                            action, arg = self._confirm_action
                            if action == 'save':
                                self.save_map(arg)
                                self._mode = 'edit'
                            elif action == 'delete':
                                self.delete_map(arg)
                                self._mode = 'load_list'
                            elif action == 'load':
                                self.load_map(arg)
                                self._mode = 'edit'
                            elif action == 'clear':
                                self.clear_map()
                                self._mode = 'edit'
                            elif action == 'back':
                                running = False
                            self._confirm_action = None
                        elif confirm_ui.get('no') and confirm_ui['no'].collidepoint(mp):
                            self._mode = 'edit' if self._confirm_action and self._confirm_action[0] != 'delete' else 'load_list'
                            self._confirm_action = None

                    elif self.preview_mode:
                        self.preview_mode = False

                    else:
                        # Toolbar clicks
                        if toolbar_rects.get('tool_obstacle') and toolbar_rects['tool_obstacle'].collidepoint(mp):
                            self.current_tool = 'obstacle'
                        elif toolbar_rects.get('tool_portal') and toolbar_rects['tool_portal'].collidepoint(mp):
                            self.current_tool = 'portal'
                        elif toolbar_rects.get('tool_eraser') and toolbar_rects['tool_eraser'].collidepoint(mp):
                            self.current_tool = 'eraser'
                        elif toolbar_rects.get('undo') and toolbar_rects['undo'].collidepoint(mp):
                            self.undo()
                        elif toolbar_rects.get('redo') and toolbar_rects['redo'].collidepoint(mp):
                            self.redo()
                        elif toolbar_rects.get('clear') and toolbar_rects['clear'].collidepoint(mp):
                            self._confirm_message = "Clear the whole map? This can't be undone with Undo history lost."
                            self._confirm_action = ('clear', None)
                            self._mode = 'confirm'
                        elif toolbar_rects.get('w_minus') and toolbar_rects['w_minus'].collidepoint(mp):
                            self.resize_board(-1, 0)
                        elif toolbar_rects.get('w_plus') and toolbar_rects['w_plus'].collidepoint(mp):
                            self.resize_board(1, 0)
                        elif toolbar_rects.get('h_minus') and toolbar_rects['h_minus'].collidepoint(mp):
                            self.resize_board(0, -1)
                        elif toolbar_rects.get('h_plus') and toolbar_rects['h_plus'].collidepoint(mp):
                            self.resize_board(0, 1)
                        elif toolbar_rects.get('back') and toolbar_rects['back'].collidepoint(mp):
                            if self.dirty:
                                self._confirm_message = "Discard unsaved changes and go back?"
                                self._confirm_action = ('back', None)
                                self._mode = 'confirm'
                            else:
                                running = False
                        elif toolbar_rects.get('export') and toolbar_rects['export'].collidepoint(mp):
                            self._name_input = self.map_name or ""
                            self._mode = 'export_prompt'
                        elif toolbar_rects.get('load') and toolbar_rects['load'].collidepoint(mp):
                            self._mode = 'load_list'
                        elif toolbar_rects.get('save') and toolbar_rects['save'].collidepoint(mp):
                            self._name_input = self.map_name or ""
                            self._mode = 'save_prompt'
                        elif toolbar_rects.get('preview') and toolbar_rects['preview'].collidepoint(mp):
                            self.preview_mode = not self.preview_mode
                        else:
                            cell = self._pixel_to_cell(mp, layout)
                            if cell:
                                if self.current_tool == 'obstacle':
                                    self.place_obstacle(cell)
                                elif self.current_tool == 'portal':
                                    self.place_portal(cell)
                                elif self.current_tool == 'eraser':
                                    self.erase(cell)

            clock.tick(60)


class MainMenu:
