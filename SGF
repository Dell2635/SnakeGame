class Achievement:
    def __init__(self, achievement_id, name, description, icon_type='trophy', achievement_type='bronze'):
        """
        Initialize an achievement
        
        Args:
            achievement_id (str): Unique identifier for the achievement
            name (str): Display name of the achievement
            description (str): Detailed description of how to earn the achievement
            icon_type (str): Type of icon to display ('trophy', 'snake', 'fruit', 'settings')
            achievement_type (str): Rarity/tier of the achievement ('bronze', 'silver', 'gold', 'platinum')
        """
        self.id = achievement_id
        self.name = name
        self.description = description
        self.icon_type = icon_type
        self.type = achievement_type
        self.unlocked = False
        self.unlock_time = None
        self.notification_shown = False
    
    def unlock(self):
        """Unlock this achievement and record the time"""
        if not self.unlocked:
            self.unlocked = True
            self.unlock_time = time.time()
            return True
        return False
    
    def draw_icon(self, surface, rect):
        """Draw the achievement icon"""
        # Draw the background
        pygame.draw.rect(surface, COLORS['achievement_bg'], rect, border_radius=max(1, rect.width // 5))
        pygame.draw.rect(surface, COLORS.get(self.type, COLORS['gold']), rect, width=2, border_radius=max(1, rect.width // 5))
        
        # Draw the icon based on type - use integer coordinates to prevent type errors
        padding = rect.width // 5
        icon_rect = pygame.Rect(rect.x + padding, rect.y + padding, 
                                rect.width - (padding * 2), rect.height - (padding * 2))
        
        # Safe color handling to prevent crashes
        icon_color = COLORS.get(self.type, COLORS.get('gold', (255, 215, 0)))
        if self.icon_type == 'trophy':
            create_trophy_icon(surface, icon_rect, icon_color)
        elif self.icon_type == 'snake':
            create_snake_icon(surface, icon_rect, icon_color)
        elif self.icon_type == 'fruit':
            create_fruit_icon(surface, icon_rect, icon_color)
        elif self.icon_type == 'settings':
            create_settings_icon(surface, icon_rect, icon_color)
        
        # If not unlocked, add a lock overlay
        if not self.unlocked:
            lock_color = (60, 60, 80, 180)  # Semi-transparent dark color
            pygame.draw.rect(surface, lock_color, rect, border_radius=max(1, rect.width // 5))
            
            # Draw a lock symbol - use standard RGB (no alpha) to prevent TypeError
            lock_width = int(rect.width * 0.4)
            lock_height = int(rect.height * 0.6)
            lock_body = pygame.Rect(
                rect.centerx - lock_width // 2,
                rect.centery - lock_height // 4,
                lock_width, 
                lock_height // 2
            )
            pygame.draw.rect(surface, (200, 200, 200), lock_body, border_radius=lock_width // 5)
            
            # Lock arch
            lock_arch_radius = lock_width // 2
            arch_rect = pygame.Rect(
                rect.centerx - lock_arch_radius,
                rect.centery - lock_height // 2,
                lock_arch_radius * 2,
                lock_arch_radius
            )
            pygame.draw.arc(surface, (200, 200, 200), arch_rect, 3.14, 6.28, 3)

class AchievementManager:
    def __init__(self):
        """Initialize the achievement manager"""
        self.achievements = {}
        self.pending_notifications = []
        self.notification_duration = 3  # seconds
        self.notification_fade_time = 1  # seconds
        
        # Initialize achievements from the definitions
        for achievement_id, data in ACHIEVEMENTS.items():
            self.achievements[achievement_id] = Achievement(
                achievement_id=data['id'],
                name=data['name'],
                description=data['description'],
                icon_type=data['icon'],
                achievement_type=data['type']
            )

    # ── persistence (writes into snake_game_data.json) ───────────────────
    def save_state(self):
        """Save unlocked achievements into the unified data file."""
        try:
            achievements_snapshot = {
                aid: {
                    'unlocked':    a.unlocked,
                    'unlock_time': a.unlock_time,
                }
                for aid, a in self.achievements.items()
            }

            def _mutate(data):
                data['achievements'] = achievements_snapshot
                return data

            _save_data_async(_mutate)
        except Exception as e:
            print(f"Error saving achievements: {e}")

    def load_state(self):
        """Restore unlocked achievements from the unified data file."""
        try:
            data = _load_data()
            saved = data.get('achievements', {}) or {}
            for aid, info in saved.items():
                if aid in self.achievements and isinstance(info, dict):
                    self.achievements[aid].unlocked    = bool(info.get('unlocked', False))
                    self.achievements[aid].unlock_time = info.get('unlock_time')
        except Exception as e:
            print(f"Error loading achievements: {e}")
    
    def unlock_achievement(self, achievement_id):
        """Unlock an achievement by ID and queue a notification"""
        if achievement_id in self.achievements:
            achievement = self.achievements[achievement_id]
            if achievement.unlock():
                self.pending_notifications.append({
                    'achievement': achievement,
                    'time': time.time(),
                    'alpha': 255
                })
                self.save_state()          # ← persist on every unlock
                return True
        return False
    
