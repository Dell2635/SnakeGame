import logging as _logging_mod
from logging.handlers import RotatingFileHandler as _RotatingFileHandler

_LOG_LEVELS = {
    'DEBUG': _logging_mod.DEBUG, 'INFO': _logging_mod.INFO,
    'WARNING': _logging_mod.WARNING, 'ERROR': _logging_mod.ERROR,
    'CRITICAL': _logging_mod.CRITICAL,
}
_LOG_RING_BUFFER = []
_LOG_RING_BUFFER_MAX = 200
_log_ring_lock = threading.Lock()


class _RingBufferLogHandler(_logging_mod.Handler):
    """Keeps the last N formatted log lines in memory, so a crash report can
    include recent context even without opening the log file."""
    def emit(self, record):
        try:
            msg = self.format(record)
        except Exception:
            return
        with _log_ring_lock:
            _LOG_RING_BUFFER.append(msg)
            if len(_LOG_RING_BUFFER) > _LOG_RING_BUFFER_MAX:
                del _LOG_RING_BUFFER[0:len(_LOG_RING_BUFFER) - _LOG_RING_BUFFER_MAX]


def _init_sgf_logging():
    logger = _logging_mod.getLogger('sgf')
    if logger.handlers:
        return logger

    level_name = _CLI_LOG_LEVEL if _CLI_LOG_LEVEL in _LOG_LEVELS else 'INFO'
    if SAFE_MODE:
        level_name = 'DEBUG'  # Safe Mode always enables debug logging
    logger.setLevel(_LOG_LEVELS[level_name])

    fmt = _logging_mod.Formatter(
        '%(asctime)s [%(levelname)s] %(name)s: %(message)s', datefmt='%Y-%m-%d %H:%M:%S')

    try:
        log_path = os.path.join(_user_data_manager.get_log_dir(), 'sgf.log')
        file_handler = _RotatingFileHandler(log_path, maxBytes=1_000_000, backupCount=3, encoding='utf-8')
        file_handler.setFormatter(fmt)
        logger.addHandler(file_handler)
    except Exception as e:
        print(f"Could not initialize file logging: {e}")

    ring_handler = _RingBufferLogHandler()
    ring_handler.setFormatter(fmt)
    logger.addHandler(ring_handler)

    if DEBUG_MODE or SAFE_MODE:
        console_handler = _logging_mod.StreamHandler()
        console_handler.setFormatter(fmt)
        logger.addHandler(console_handler)

    logger.propagate = False
    return logger


sgf_log = _init_sgf_logging()


