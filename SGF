    def _draw_replay_block(self, block, offset, viewport_top, viewport_bottom,
                           label_font, path_font, controls):
        """Children rows + the replay-only action bar (Clean / Compress /
        Organize / Delete). Estimates are marked with '~'."""
        lang = self.settings.language
        scan = block['scan']
        checks = controls.setdefault('_data_replay_checks', [])
        selected_ids = self.data_replay_selection
        for rect, entry in block['children']:
            rect = rect.move(0, -offset)
            if rect.bottom < viewport_top or rect.top > viewport_bottom:
                continue  # only draw/click what is visible
            chosen = entry['id'] in selected_ids
            pygame.draw.rect(self.screen, (62, 68, 92) if chosen else (46, 50, 70), rect, border_radius=5)
            box = pygame.Rect(rect.x + 6, rect.centery - 7, 14, 14)
            pygame.draw.rect(self.screen, COLORS['white'], box, 2, border_radius=3)
            if chosen:
                pygame.draw.rect(self.screen, COLORS['light_blue'], box.inflate(-6, -6), border_radius=2)
            suffix = ' · gz' if entry['compressed'] else ''
            name = f"Replay {entry['name']}"
            size_text = f"{_format_bytes(entry['size'])}{suffix}"
            size_surf = render_fit(path_font, size_text, COLORS['light_gray'], max(40, rect.width // 3), padding=0)
            name_surf = render_fit(path_font, name, COLORS['white'],
                                   rect.width - size_surf.get_width() - 40, padding=0)
            self.screen.blit(name_surf, (rect.x + 28, rect.centery - name_surf.get_height() // 2))
            self.screen.blit(size_surf, (rect.right - size_surf.get_width() - 8,
                                         rect.centery - size_surf.get_height() // 2))
            checks.append((rect, entry['id']))

        busy = self.data_replay_job is not None
        targets = self._data_replay_targets(scan)
        profile = self.data_replay_profile
        est_key = (profile, tuple(sorted(e['id'] for e in targets)))
        if est_key not in self.data_replay_estimates:
            self.data_replay_estimates[est_key] = replay_storage_estimate_compress(
                dict(scan, replays=targets), profile)
        clean_count, clean_bytes = replay_storage_estimate_clean(scan)
        chosen_entries = [e for e in scan['replays'] if e['id'] in selected_ids]
        delete_bytes = sum(e['size'] for e in chosen_entries)
        specs = {
            'clean': (f"{_replay_tool_label(lang, 'clean')} +~{_format_bytes(clean_bytes)}",
                      clean_count > 0, COLORS['blue']),
            'compress': (f"{_replay_tool_label(lang, 'compress')} +~{_format_bytes(self.data_replay_estimates[est_key])}",
                         bool(targets), COLORS['green']),
            'organize': (_replay_tool_label(lang, 'organize'), bool(targets), COLORS['button']),
            'delete': (f"{_replay_tool_label(lang, 'delete')} +~{_format_bytes(delete_bytes)}",
                       bool(chosen_entries), COLORS['red']),
        }
        actions = controls.setdefault('_data_replay_actions', {})
        for key, rect in block['buttons'].items():
            rect = rect.move(0, -offset)
            label, enabled, color = specs[key]
            enabled = enabled and not busy
            self.create_button(rect, label, color if enabled else COLORS['dark_gray'])
            if enabled and rect.bottom > viewport_top and rect.top < viewport_bottom:
                actions[key] = rect
        prect = block['profile'].move(0, -offset)
        self.create_button(prect, f"{_replay_tool_label(lang, 'profile')}: {_replay_tool_label(lang, profile)}",
                           COLORS['button'])
        if prect.bottom > viewport_top and prect.top < viewport_bottom:
            actions['profile'] = prect
        srect = block['status'].move(0, -offset)
        job = self.data_replay_job
        if job is not None:
            pygame.draw.rect(self.screen, COLORS['dark_gray'], srect, border_radius=5)
            fraction = job['done'] / max(1, job['total'])
            fill = pygame.Rect(srect.x, srect.y, int(srect.width * fraction), srect.height)
            pygame.draw.rect(self.screen, COLORS['light_blue'], fill, border_radius=5)
            text = _replay_tool_label(lang, 'working', done=job['done'], total=job['total'])
        else:
            text = self.data_replay_message or (
                _replay_tool_label(lang, 'scope_selected', count=len(chosen_entries)) if chosen_entries
                else _replay_tool_label(lang, 'scope_all'))
        status = render_fit(path_font, text, COLORS['white'], srect.width - 8, padding=0)
        self.screen.blit(status, (srect.x + 4, srect.centery - status.get_height() // 2))

    def _data_replay_scan(self, force=False):
        """Replay directory scan, cached for a couple of seconds."""
        cached = self.data_replay_scan_cache
        now = time.monotonic()
        if not force and cached and now - cached[0] < 2.0:
            return cached[1]
        scan = replay_storage_scan(referenced_ids=replay_storage_referenced_ids())
        self.data_replay_scan_cache = (now, scan)
        self.data_replay_estimates = {}
        return scan

    def _data_replay_targets(self, scan):
        chosen = [e for e in scan['replays'] if e['id'] in self.data_replay_selection]
        return chosen or list(scan['replays'])

    def _data_replay_invalidate(self):
        self.data_replay_scan_cache = None
        self.data_replay_estimates = {}
        self.data_replay_selection &= {
            e['id'] for e in (self._data_replay_scan(force=True)['replays'])}

    def _data_replay_start_job(self, kind):
        """Run compress/organize in a worker thread. The worker only touches
        replay files and a plain progress dict, never pygame."""
        if self.data_replay_job is not None:
            return
        scan = self._data_replay_scan()
        entries = self._data_replay_targets(scan)
        if not entries:
            return
        profile = self.data_replay_profile
        job = {'kind': kind, 'done': 0, 'total': len(entries), 'result': None}

        def progress(done, total):
            job['done'], job['total'] = done, total

        def work():
            try:
                if kind == 'compress':
                    job['result'] = replay_storage_compress(entries, profile, progress)
                else:
                    job['result'] = replay_storage_organize(entries, progress)
            except Exception as exc:
                _logging_mod.getLogger('sgf').warning('Replay %s job failed: %s', kind, exc)
                job['result'] = {'saved': 0, 'done': 0, 'errors': len(entries)}

        self.data_replay_job = job
        threading.Thread(target=work, name=f'replay-{kind}', daemon=True).start()

    def _handle_replay_click(self, controls, pos):
        """Clicks on the replay rows and the replay-only action bar."""
        lang = self.settings.language
        for rect, replay_id in controls.get('_data_replay_checks', []):
            if rect.collidepoint(pos):
                self.data_replay_selection ^= {replay_id}
                self.data_replay_message = ''
                return True
        actions = controls.get('_data_replay_actions', {})
        for key, rect in actions.items():
            if not rect.collidepoint(pos):
                continue
            scan = self._data_replay_scan()
            self.data_replay_message = ''
            if key == 'profile':
                order = list(REPLAY_COMPRESSION_PROFILES)
                self.data_replay_profile = order[(order.index(self.data_replay_profile) + 1) % len(order)]
            elif key in ('compress', 'organize'):
                self._data_replay_start_job(key)
            elif key == 'clean':
                count, size = replay_storage_estimate_clean(scan)
                self.confirm_data_action = {
                    'kind': 'replay_clean', 'scan': scan,
                    'message_lines': [_replay_tool_label(
                        lang, 'confirm_clean', count=count, size=_format_bytes(size))]}
            elif key == 'delete':
                chosen = [e for e in scan['replays'] if e['id'] in self.data_replay_selection]
                self.confirm_data_action = {
                    'kind': 'replay_delete', 'entries': chosen,
                    'message_lines': [_replay_tool_label(
                        lang, 'confirm_delete', count=len(chosen),
                        size=_format_bytes(sum(e['size'] for e in chosen)))]}
            return True
        return False

    def _data_replay_poll_job(self):
        job = self.data_replay_job
        if job is None or job['result'] is None:
            return
        lang = self.settings.language
        result = job['result']
        self.data_replay_message = _replay_tool_label(
            lang, 'done_compress' if job['kind'] == 'compress' else 'done_organize',
            done=result['done'], size=_format_bytes(result['saved']), errors=result['errors'])
        self.data_replay_job = None
        self._data_replay_invalidate()

    def _draw_storage_cylinder(self, area, groups, total, selected_key, font):
        """Vertical cylinder of stacked discs (one per storage category) with a
        clickable legend. Cheap 2D shapes only: rects and ellipses.
        Returns (segments, legend) as lists of (rect, key, label, size, color)."""
        screen = self.screen
        cw = max(40, min(96, int(area.w * 0.4)))
        eh = max(10, int(cw * 0.3))
        top, height = area.y, max(eh * 3, area.h)
        body_top = top + eh // 2
        body_bottom = top + height - eh // 2
        body_h = max(1, body_bottom - body_top)
        cx = area.x
        shell = (46, 52, 72)
        pygame.draw.ellipse(screen, shell, (cx, body_bottom - eh // 2, cw, eh))
        pygame.draw.rect(screen, shell, (cx, body_top, cw, body_h))
        pygame.draw.ellipse(screen, (64, 72, 98), (cx, top, cw, eh))
        shown = [g for g in groups if int(g[2] or 0) > 0]
        segments = []
        if total > 0 and shown:
            heights = [max(3, int(round(body_h * int(g[2]) / total))) for g in shown]
            while sum(heights) > body_h and max(heights) > 3:
                heights[heights.index(max(heights))] -= 1
            y = body_bottom
            for index, ((key, label, size, color), h) in enumerate(zip(shown, heights)):
                seg_top = max(body_top, y - h)
                dark = tuple(max(0, int(c * 0.78)) for c in color)
                light = tuple(min(255, int(c * 1.18) + 12) for c in color)
                if index == 0:
                    pygame.draw.ellipse(screen, dark, (cx, y - eh // 2, cw, eh))
                pygame.draw.rect(screen, color, (cx, seg_top, cw, y - seg_top))
                pygame.draw.ellipse(screen, light, (cx, seg_top - eh // 2, cw, eh))
                seg_rect = pygame.Rect(cx, seg_top - eh // 2, cw, (y - seg_top) + eh)
                seg_rect = seg_rect.clip(screen.get_rect())
                if key == selected_key:
                    pygame.draw.rect(screen, COLORS['white'], seg_rect, 2, border_radius=4)
                segments.append((seg_rect, key, label, int(size), color))
                y = seg_top
            # Soft vertical highlight and shade give the cylinder its volume.
            # Only the straight body is shaded, so the elliptical top and
            # bottom keep clean curved edges.
            shade = pygame.Surface((cw, body_h), pygame.SRCALPHA)
            pygame.draw.rect(shade, (255, 255, 255, 38), (int(cw * 0.12), 0, max(3, int(cw * 0.14)), shade.get_height()))
            pygame.draw.rect(shade, (0, 0, 0, 52), (int(cw * 0.78), 0, cw - int(cw * 0.78), shade.get_height()))
            screen.blit(shade, (cx, body_top))

        legend = []
        lx = cx + cw + 18
        lw = area.right - lx
        row_h = max(font.get_height() + 6, 20)
        if lw > 50:
            ly = top
            for key, label, size, color in shown:
                row = pygame.Rect(lx, ly, lw, row_h)
                if row.bottom > top + height:
                    break
                if key == selected_key:
                    pygame.draw.rect(screen, (50, 60, 90), row, border_radius=4)
                pygame.draw.rect(screen, color, (row.x + 4, row.centery - 5, 10, 10), border_radius=2)
                text = render_fit(font, f"{label}  {_format_bytes(size)}",
                                  COLORS['white'] if key == selected_key else COLORS['light_gray'],
                                  max(10, lw - 22), padding=0)
                screen.blit(text, (row.x + 20, row.centery - text.get_height() // 2))
                legend.append((row, key, label, int(size), color))
                ly += row_h + 2
        return segments, legend

    def draw_data_settings(self, screen_width, screen_height, margin_x, content_width, start_y, spacing, controls):
        """IA3: Settings > Data — the SGF Data folder page. Shows where data
        lives, lets the player open the folder, delete individual
        categories, reset persisted settings, or run a Factory Reset."""
        lang = self.settings.language
        title_font = get_font(lang, 'bold', max(18, int(spacing * 0.28)))
        label_font = get_font(lang, 'regular', max(14, int(spacing * 0.20)))
        path_font = get_font(lang, 'regular', max(12, int(spacing * 0.16)))

        title = title_font.render(_t_or(lang, 'data_management', 'Data Management'), True, COLORS['white'])
        self.screen.blit(title, (margin_x, start_y))

        path_label = _t_or(lang, 'data_folder_location', 'SGF Data folder:')
        path_surface = render_fit(path_font, f"{path_label} {_user_data_manager.get_data_dir()}",
                                   COLORS['light_gray'], screen_width - 2 * margin_x)
        # Stack the lines from the real font heights; fixed fractions of
        # `spacing` made the title and the path line overlap in small windows.
        path_y = start_y + title.get_height() + 4
        self.screen.blit(path_surface, (margin_x, path_y))

        row_h = max(42, min(54, int(screen_height * 0.09)))
        row_gap = max(5, int(row_h * 0.12))
        categories = [
            ('saves', 'data_cat_saves'),
            ('replays', 'data_cat_replays'),
            ('maps_created', 'data_cat_maps_created'),
            ('maps_imported', 'data_cat_maps_imported'),
            ('cache', 'data_cat_cache'),
            ('logs', 'data_cat_logs'),
            ('mods_installed', 'data_cat_mods'),
            ('themes_installed', 'data_cat_themes'),
            ('profiles', 'data_cat_profiles'),
            ('game_settings', 'data_cat_game_settings'),
            ('diagnostics', 'data_cat_diagnostics'),
            ('crashes', 'data_cat_crashes'),
        ]
        category_rows = []
        for cat_key, label_key in categories:
            category_rows.append((cat_key, get_text(lang, label_key),
                                  _user_data_manager.get_category_stats(cat_key)))

        summary_y = path_y + path_surface.get_height() + 6
        category_bytes = sum(stats['size_bytes'] for _key, _label, stats in category_rows)
        category_files = sum(stats['file_count'] for _key, _label, stats in category_rows)
        root_stats = _user_data_manager.get_total_stats()
        # Category walks have a shorter TTL than the all-root walk. Taking the
        # larger value keeps newly written files visible until both caches
        # converge instead of briefly reporting a total smaller than a part.
        sgf_data_bytes = max(category_bytes, root_stats['size_bytes'])
        sgf_file_count = max(category_files, root_stats['file_count'])
        summary_font = get_font(lang, 'regular', max(11, min(14, int(spacing * 0.22))))
        summary = f"{get_text(lang, 'storage_sgf_data')}: {_format_bytes(sgf_data_bytes)}"
        summary_surface = render_fit(summary_font, summary, COLORS['white'], content_width, padding=0)
        # The total is already shown below the bar (also when a segment is
        # selected), so it is not repeated above it.

        # A compact rounded cylinder with category-colored slices. The bright
        # rim and soft lower edge suggest volume without expensive 3D effects.
        bar_y = summary_y
        cyl_x = margin_x + content_width + max(36, int(screen_width * 0.05))
        cyl_area = pygame.Rect(cyl_x, start_y + 4, screen_width - cyl_x - margin_x,
                               int(screen_height * 0.62))
        use_cylinder = cyl_area.w >= 140 and cyl_area.h >= 120
        bar_h = 0 if use_cylinder else max(15, min(22, int(spacing * 0.34)))
        bar_rect = pygame.Rect(margin_x, bar_y, content_width, bar_h)
        pygame.draw.rect(self.screen, COLORS['dark_gray'], bar_rect, border_radius=bar_h // 2)
        visual_groups = [
            ('saves', get_text(lang, 'data_cat_saves'), category_rows[0][2]['size_bytes'], (90, 160, 230)),
            ('replays', get_text(lang, 'data_cat_replays'), category_rows[1][2]['size_bytes'], (175, 110, 220)),
            ('maps', get_text(lang, 'data_cat_maps_created'),
             category_rows[2][2]['size_bytes'] + category_rows[3][2]['size_bytes'], (90, 190, 150)),
            ('cache', get_text(lang, 'data_cat_cache'), category_rows[4][2]['size_bytes'], (210, 170, 80)),
            ('logs', get_text(lang, 'data_cat_logs'), category_rows[5][2]['size_bytes'], (170, 180, 190)),
            ('mods', get_text(lang, 'data_cat_mods'), category_rows[6][2]['size_bytes'], (220, 110, 95)),
            ('themes', get_text(lang, 'data_cat_themes'), category_rows[7][2]['size_bytes'], (100, 190, 210)),
            ('diagnostics', get_text(lang, 'data_cat_diagnostics'),
             category_rows[10][2]['size_bytes'] + category_rows[11][2]['size_bytes'],
             (130, 145, 190)),
        ]
        visible_category_bytes = sum(max(0, int(item[2] or 0))
                                     for item in visual_groups)
        visual_groups.append((
            'other', get_text(lang, 'data_cat_other'),
            max(0, sgf_data_bytes - visible_category_bytes), (145, 150, 175)))
        group_total = sum(max(0, int(item[2] or 0)) for item in visual_groups)
        controls['_storage_segments'] = []
        cursor_x = bar_rect.x
        for group_key, label, size_bytes, color in visual_groups:
            if group_total > 0 and size_bytes > 0:
                segment_w = max(1, int(bar_rect.w * size_bytes / group_total))
                segment_w = min(segment_w, bar_rect.right - cursor_x)
                segment = pygame.Rect(cursor_x, bar_rect.y, segment_w, bar_rect.h)
                previous_clip = self.screen.get_clip()
                self.screen.set_clip(segment.clip(bar_rect))
                pygame.draw.rect(self.screen, color, bar_rect)
                self.screen.set_clip(previous_clip)
                if self.storage_selected_category == group_key:
                    pygame.draw.rect(self.screen, COLORS['white'], segment, 2)
                controls['_storage_segments'].append(
                    (segment, group_key, label, size_bytes, color))
                cursor_x += segment_w
        if bar_h:
            pygame.draw.line(self.screen, (235, 240, 250),
                             (bar_rect.x + bar_h // 2, bar_rect.y + 2),
                             (max(bar_rect.x + bar_h // 2, bar_rect.right - bar_h // 2),
                              bar_rect.y + 2), 1)
        controls['_storage_legend'] = []
        if use_cylinder:
            controls['_storage_segments'], controls['_storage_legend'] = (
                self._draw_storage_cylinder(
                    cyl_area, visual_groups, group_total,
                    self.storage_selected_category, summary_font))
        selected = next((item for item in visual_groups
                         if item[0] == self.storage_selected_category), None)
        if selected:
            selected_text = f"{selected[1]} — {_format_bytes(selected[2])}"
        else:
            selected_text = f"{get_text(lang, 'storage_sgf_data')}: {_format_bytes(sgf_data_bytes)}"
        selected_surface = render_fit(summary_font, selected_text, COLORS['white'], content_width, padding=0)
        selected_y = bar_rect.bottom + 3
        self.screen.blit(selected_surface, (margin_x, selected_y))

        row_y = selected_y + summary_font.get_height() + 3
        viewport_top = row_y
        viewport_bottom = screen_height - max(12, int(screen_height * 0.03))
        controls['_data_rows'] = []
        for _stale_key in ('_data_arrows', '_data_replay_checks', '_data_replay_actions'):
            controls.pop(_stale_key, None)
        controls['_data_storage_summary'] = {
            'size_bytes': sgf_data_bytes,
            'file_count': sgf_file_count,
        }
        del_btn_w = max(80, int(content_width * 0.18))
        row_rects = []
        replay_block = None
        self._data_replay_poll_job()
        for (cat_key, label, cat_stats) in category_rows:
            size_bytes = cat_stats['size_bytes']
            row_rect = pygame.Rect(margin_x, row_y, content_width, row_h)
            row_rects.append((row_rect, cat_key, label, cat_stats, del_btn_w))
            row_y += row_h + row_gap
            if cat_key == 'replays' and 'replays' in self.data_expanded:
                # Expanded replay list plus the actions that only act on it.
                scan = self._data_replay_scan()
                child_h = max(24, int(row_h * 0.55))
                children = []
                for entry in scan['replays']:
                    children.append((pygame.Rect(margin_x + 18, row_y, content_width - 18, child_h), entry))
                    row_y += child_h + 2
                btn_h = max(32, int(row_h * 0.72))
                half_w = (content_width - 18 - 6) // 2
                grid_x = margin_x + 18
                row_y += 4
                buttons = {
                    'clean': pygame.Rect(grid_x, row_y, half_w, btn_h),
                    'compress': pygame.Rect(grid_x + half_w + 6, row_y, half_w, btn_h),
                    'organize': pygame.Rect(grid_x, row_y + btn_h + 6, half_w, btn_h),
                    'delete': pygame.Rect(grid_x + half_w + 6, row_y + btn_h + 6, half_w, btn_h),
                }
