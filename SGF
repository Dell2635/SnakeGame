    def _workspace_frame_height(self):
        return max(30, min(38, int(self._display_surface.get_height() * 0.045)))

    def _workspace_clamp_rect(self, rect):
        sw, sh = self._display_surface.get_size()
        minimum_w, minimum_h = min(sw, 480), min(sh, 320)
        rect = pygame.Rect(rect)
        rect.w = max(minimum_w, min(sw, rect.w))
        rect.h = max(minimum_h, min(sh, rect.h))
        rect.x = max(0, min(sw - rect.w, rect.x))
        rect.y = max(0, min(sh - rect.h, rect.y))
        snap = 14
        if rect.x <= snap:
            rect.x = 0
        if rect.y <= snap:
            rect.y = 0
        if sw - rect.right <= snap:
            rect.right = sw
        if sh - rect.bottom <= snap:
            rect.bottom = sh
        return rect

    def _persist_workspace_layout(self):
        rect = self._workspace_restore_rect if self._workspace_maximized else self._workspace_rect
        self._workspace_layout = _dev_workspace_layout_for_rect(
            rect, self._display_surface.get_size())
        self.tools.state.workspace_layout = dict(self._workspace_layout)
        self.tools.state.save()

    def _workspace_control_rects(self):
        rect = self._workspace_rect
        frame_h = self._workspace_frame_height()
        return {
            'reset': pygame.Rect(rect.right - 204, rect.y + 5, 70, frame_h - 10),
            'minimize': pygame.Rect(rect.right - 126, rect.y + 5, 27, frame_h - 10),
            'maximize': pygame.Rect(rect.right - 93, rect.y + 5, 27, frame_h - 10),
            'close': pygame.Rect(rect.right - 60, rect.y + 5, 50, frame_h - 10),
        }

    def _workspace_content_target(self):
        if not self._workspace_enabled:
            return self._display_surface.get_rect(), 1.0
        rect = self._workspace_rect.copy()
        frame_h = self._workspace_frame_height()
        if self._workspace_minimized:
            return pygame.Rect(rect.x, rect.y + frame_h, 0, 0), 1.0
        client = pygame.Rect(rect.x, rect.y + frame_h,
                             rect.w, max(1, rect.h - frame_h))
        canvas_w, canvas_h = self._workspace_canvas.get_size()
        scale = min(client.w / max(1, canvas_w), client.h / max(1, canvas_h))
        target = pygame.Rect(0, 0,
                             max(1, int(canvas_w * scale)),
                             max(1, int(canvas_h * scale)))
        target.center = client.center
        return target, scale

    def _draw_workspace_chrome(self, display):
        rect = self._workspace_rect.copy()
        frame_h = self._workspace_frame_height()
        frame_rect = pygame.Rect(rect.x, rect.y, rect.w,
                                 frame_h if self._workspace_minimized else rect.h)
        # Only the title bar is filled here. This runs AFTER the content has
        # been blitted, so filling the whole frame would paint over it and the
        # window would look empty; the body background is filled before the
        # content in _draw_workspace().
        title_bar = pygame.Rect(rect.x, rect.y, rect.w, frame_h)
        pygame.draw.rect(display, (18, 23, 39), title_bar, border_radius=7)
        pygame.draw.rect(display, (100, 125, 165), frame_rect, 2, border_radius=7)
        title = render_fit(self._font(15, True), 'DEV Workspace',
                           (245, 95, 95), max(40, rect.w - 230), padding=4)
        display.blit(title, (rect.x + 10, rect.y + (frame_h-title.get_height())//2))
        buttons = self._workspace_control_rects()
        labels = {'reset': 'Reset', 'minimize': '—',
                  'maximize': '□' if not self._workspace_maximized else '↙',
                  'close': 'Close'}
        for key, button in buttons.items():
            color = (120, 45, 45) if key == 'close' else (45, 55, 78)
            pygame.draw.rect(display, color, button, border_radius=4)
            pygame.draw.rect(display, (95, 110, 140), button, 1, border_radius=4)
            text_surface = render_fit(self._font(12, True), labels[key],
                                      COLORS['white'], button.w - 4, padding=2)
            display.blit(text_surface, text_surface.get_rect(center=button.center))
        if not self._workspace_minimized:
            grip = pygame.Rect(rect.right - 18, rect.bottom - 18, 14, 14)
            for offset in (4, 8, 12):
                pygame.draw.line(display, (150, 165, 190),
                                 (grip.right - offset, grip.bottom - 2),
                                 (grip.right - 2, grip.bottom - offset), 1)
        return buttons

    def _draw_workspace(self, display):
        if not self._workspace_enabled:
            return
        if self._workspace_hidden:
            chip = pygame.Rect(max(8, display.get_width() - 190), 8, 180, 30)
            pygame.draw.rect(display, (18, 23, 39), chip, border_radius=6)
            pygame.draw.rect(display, (100, 125, 165), chip, 1, border_radius=6)
            label = render_fit(self._font(12, True),
                               'DEV Workspace hidden · F8 restore',
                               COLORS['white'], chip.w - 8, padding=3)
            display.blit(label, label.get_rect(center=chip.center))
            self._workspace_restore_chip = chip
            self._workspace_content_rect = pygame.Rect(0, 0, 0, 0)
            return
        if self._workspace_shade is None or self._workspace_shade.get_size() != display.get_size():
            self._workspace_shade = pygame.Surface(display.get_size(), pygame.SRCALPHA)
            self._workspace_shade.fill((0, 0, 0, 112))
        display.blit(self._workspace_shade, (0, 0))
        target, self._workspace_scale = self._workspace_content_target()
        self._workspace_content_rect = target
        if not self._workspace_minimized:
            body = self._workspace_rect.copy()
            body.y += self._workspace_frame_height()
            body.h = max(0, body.h - self._workspace_frame_height())
            pygame.draw.rect(display, (18, 23, 39), body, border_radius=7)
        if target.w and target.h:
            scaled = pygame.transform.scale(self._workspace_canvas, target.size)
            display.blit(scaled, target.topleft)
        self._workspace_buttons = self._draw_workspace_chrome(display)

    def _workspace_mouse_to_canvas(self, pos):
        if not self._workspace_enabled:
            return tuple(pos)
        target = self._workspace_content_rect
        if target.w <= 0 or target.h <= 0 or not target.collidepoint(pos):
            return (-1, -1)
        canvas_w, canvas_h = self._workspace_canvas.get_size()
        return (int((pos[0] - target.x) * canvas_w / target.w),
                int((pos[1] - target.y) * canvas_h / target.h))

    def _save_workspace_on_resize(self, old_size):
        if self._workspace_maximized:
            self._workspace_restore_rect = _dev_workspace_rect(
                self._workspace_layout, self._display_surface.get_size())
            self._workspace_rect = self._display_surface.get_rect()
        else:
            self._workspace_rect = _dev_workspace_rect(
                self._workspace_layout, self._display_surface.get_size())
        self._workspace_canvas = pygame.Surface(self._display_surface.get_size())

    def _workspace_route_events(self, raw_events):
        forwarded = []
        for event in raw_events:
            if not self._workspace_enabled:
                if event.type == pygame.KEYDOWN and event.key in (
                        pygame.K_ESCAPE, pygame.K_F8):
                    self.running = False
                    continue
                if event.type == pygame.VIDEORESIZE:
                    self._display_surface = pygame.display.set_mode(
                        (event.w, event.h), pygame.RESIZABLE)
                    self.screen = self._display_surface
                    self._workspace_canvas = pygame.Surface(
                        self._display_surface.get_size())
                    continue
                forwarded.append(event)
                continue
            if event.type == pygame.VIDEORESIZE:
                old_size = self._display_surface.get_size()
                self._persist_workspace_layout()
                self._display_surface = pygame.display.set_mode(
                    (event.w, event.h), pygame.RESIZABLE)
                self.screen = self._display_surface
                if self.game is not None:
                    self.game.screen = self._display_surface
                self._save_workspace_on_resize(old_size)
                continue
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_F9:
                    self._workspace_hidden = not self._workspace_hidden
                    continue
                if event.key == pygame.K_F8:
                    if self._workspace_hidden:
                        self._workspace_hidden = False
                    else:
                        self.running = False
                    continue
                if event.key == pygame.K_ESCAPE:
                    self.running = False
                    continue
                if self._workspace_hidden:
                    continue
                forwarded.append(event)
                continue
            if self._workspace_hidden:
                if (event.type == pygame.MOUSEBUTTONDOWN and event.button == 1 and
                        self._workspace_restore_chip.collidepoint(event.pos)):
                    self._workspace_hidden = False
                continue
            if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                pos = event.pos
                controls = self._workspace_control_rects()
                if controls['close'].collidepoint(pos):
                    self.running = False
                    continue
                if controls['reset'].collidepoint(pos):
                    self._workspace_maximized = False
                    self._workspace_minimized = False
                    self._workspace_rect = _dev_workspace_rect(
                        _DEV_WORKSPACE_DEFAULT_LAYOUT,
                        self._display_surface.get_size())
                    self._workspace_restore_rect = self._workspace_rect.copy()
                    self._persist_workspace_layout()
                    continue
                if controls['minimize'].collidepoint(pos):
                    self._workspace_minimized = not self._workspace_minimized
                    continue
                if controls['maximize'].collidepoint(pos):
                    if self._workspace_maximized:
                        self._workspace_rect = self._workspace_clamp_rect(
                            self._workspace_restore_rect)
                        self._workspace_maximized = False
                    else:
                        self._workspace_restore_rect = self._workspace_rect.copy()
                        self._workspace_rect = self._display_surface.get_rect()
                        self._workspace_maximized = True
                    self._workspace_minimized = False
                    self._persist_workspace_layout()
                    continue
                frame_h = self._workspace_frame_height()
                title_rect = pygame.Rect(self._workspace_rect.x,
                                         self._workspace_rect.y,
                                         self._workspace_rect.w, frame_h)
                if self._workspace_minimized:
                    if title_rect.collidepoint(pos):
                        self._workspace_minimized = False
                    continue
                resize_grip = pygame.Rect(self._workspace_rect.right - 20,
                                          self._workspace_rect.bottom - 20, 20, 20)
                if resize_grip.collidepoint(pos) and not self._workspace_maximized:
                    self._workspace_resize_origin = (pos, self._workspace_rect.copy())
                    continue
                if title_rect.collidepoint(pos) and not self._workspace_maximized:
                    self._workspace_drag_offset = (
                        pos[0] - self._workspace_rect.x,
                        pos[1] - self._workspace_rect.y)
                    continue
                mapped = self._workspace_mouse_to_canvas(pos)
                if mapped[0] < 0:
                    continue
                attrs = dict(event.dict)
                attrs['pos'] = mapped
                forwarded.append(pygame.event.Event(event.type, attrs))
                continue
            if event.type == pygame.MOUSEMOTION:
                if self._workspace_drag_offset is not None:
                    ox, oy = self._workspace_drag_offset
                    moved = self._workspace_rect.copy()
                    moved.topleft = (event.pos[0] - ox, event.pos[1] - oy)
                    self._workspace_rect = self._workspace_clamp_rect(moved)
                elif self._workspace_resize_origin is not None:
                    start_pos, start_rect = self._workspace_resize_origin
                    resized = start_rect.copy()
                    resized.size = (start_rect.w + event.pos[0] - start_pos[0],
                                    start_rect.h + event.pos[1] - start_pos[1])
                    self._workspace_rect = self._workspace_clamp_rect(resized)
                continue
            if event.type == pygame.MOUSEBUTTONUP:
                if self._workspace_drag_offset is not None:
                    self._workspace_drag_offset = None
