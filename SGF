    def _tabs(self):
        sw = self.screen.get_width(); n = len(DEV_CATEGORIES)
        visible = max(4, min(7, sw // 150))
        self._visible_tab_start = max(0, min(self.tab, max(0, n - visible)))
        self._visible_tab_end = min(n, self._visible_tab_start + visible)
        count = max(1, self._visible_tab_end - self._visible_tab_start)
        w = max(90, (sw - 40) // count)
        y = 54
        for i in range(self._visible_tab_start, self._visible_tab_end):
            x = 20 + (i - self._visible_tab_start) * w
            self._button(pygame.Rect(x, y, w - 5, 32), DEV_CATEGORIES[i], active=(i == self.tab))
