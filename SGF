# Font object cache (final pygame.font.Font instances, keyed by language+style+size)
font_cache = {}

# Resolved font-file-path cache (one filesystem search per script+style, not
# per language+style+size — many languages share a script).
_resolved_font_path_cache = {}

# Which broad script each language code needs. Anything not listed here
# defaults to 'latin', which already covers Vietnamese, the Nordic
# languages, Central European diacritics, etc. via Noto Sans / DejaVu Sans.
_LANGUAGE_SCRIPT = {
    'zh': 'cjk', 'ja': 'cjk', 'ko': 'cjk',
    'ar': 'arabic',
    'he': 'hebrew',
    'hi': 'devanagari',
    'th': 'thai',
    'ru': 'cyrillic', 'uk': 'cyrillic',
    'el': 'greek',
}

# Ordered font-family candidates per script, tried with pygame.font.match_font
# against whatever's actually installed on the player's system. No font
# files are bundled (this is a single .py file) — instead we search for a
# reliable, broad-coverage family, preferring the Noto Sans family since
# it's purpose-built for wide Unicode coverage and ships on most Linux
# desktops; Segoe UI/Yu Gothic/etc. cover the same scripts on Windows.
_SCRIPT_FONT_CANDIDATES = {
    'latin': [
        'noto sans', 'segoe ui', 'dejavu sans', 'liberation sans', 'arial', 'helvetica', 'freesans',
    ],
    'cyrillic': [
        'noto sans', 'segoe ui', 'dejavu sans', 'liberation sans', 'arial',
    ],
    'greek': [
        'noto sans', 'segoe ui', 'dejavu sans', 'liberation sans', 'arial',
    ],
    'cjk': [
        'noto sans cjk sc', 'noto sans cjk tc', 'noto sans cjk jp', 'noto sans cjk kr',
        'noto sans sc', 'noto sans tc', 'noto sans jp', 'noto sans kr',
        'microsoft yahei', 'simhei', 'pingfang sc', 'hiragino sans gb',
        'malgun gothic', 'wenquanyi zen hei', 'ipagothic', 'notosanscjksc',
    ],
    'arabic': [
        'noto sans arabic', 'segoe ui', 'tahoma', 'arial',
    ],
    'hebrew': [
        'noto sans hebrew', 'segoe ui', 'arial',
    ],
    'devanagari': [
        'noto sans devanagari', 'nirmala ui', 'mangal',
    ],
    'thai': [
        'noto sans thai', 'leelawadee ui', 'tahoma', 'loma',
    ],
}

# Final safety-net fonts, tried after the script-specific list if none of
# those matched. GNU Unifont in particular covers almost the entire Unicode
# Basic Multilingual Plane — it's a plain bitmap face, not pretty, but it
# renders real characters instead of broken-glyph squares.
_UNIVERSAL_FALLBACK_CANDIDATES = ['noto sans', 'dejavu sans', 'arial', 'unifont']

# Extra candidates tried first when a monospace face is requested.
_MONO_CANDIDATES = ['dejavu sans mono', 'liberation mono', 'consolas', 'courier new']


def _script_for_language(language):
    return _LANGUAGE_SCRIPT.get(language, 'latin')


# --- Optional glyph-coverage verification via fontTools -------------------
# pygame.font.match_font only matches by family *name* — it says nothing
# about whether that font file actually contains the glyphs we need (many
# "general" fonts claim broad support but are missing whole scripts, which
# is how squares slip through even though a font was "found"). If fontTools
# is installed, we double-check each candidate's cmap table against real
# sample text before accepting it; if it's not installed, resolution still
# works exactly as before (first name match wins) — this is a pure
# enhancement, never a hard requirement.
try:
    from fontTools.ttLib import TTFont as _TTFont
    _FONTTOOLS_AVAILABLE = True
except Exception:
    _FONTTOOLS_AVAILABLE = False


def _activate_fonttools_if_installed():
    """Called after the startup checker successfully pip-installs fontTools,
    so the improved Unicode font selection kicks in immediately instead of
    only on the next launch."""
    global _FONTTOOLS_AVAILABLE, _TTFont
    if _FONTTOOLS_AVAILABLE:
        return
    try:
        from fontTools.ttLib import TTFont as _ImportedTTFont
        _TTFont = _ImportedTTFont
        _FONTTOOLS_AVAILABLE = True
        _resolved_font_path_cache.clear()  # re-resolve fonts now that verification is available
    except Exception:
        pass

_font_cmap_cache = {}       # font path -> set of covered codepoints, or None
_script_sample_cache = None  # script -> sample text built from LANGUAGES


def _build_script_samples():
    """Build a representative sample string per script out of the actual
    native_name strings in LANGUAGES — i.e. exactly the characters the game
    needs to render, with no separate hardcoded list to keep in sync."""
    samples = {}
    for code, info in LANGUAGES.items():
        script = _LANGUAGE_SCRIPT.get(code, 'latin')
        samples.setdefault(script, set()).update(info['native_name'])
    return {script: ''.join(chars) for script, chars in samples.items()}


def _get_script_sample(script):
    global _script_sample_cache
    if _script_sample_cache is None:
        _script_sample_cache = _build_script_samples()
    return _script_sample_cache.get(script, '')


def _get_font_cmap(font_path):
    if font_path in _font_cmap_cache:
        return _font_cmap_cache[font_path]
    coverage = None
    if _FONTTOOLS_AVAILABLE:
        try:
            tt = _TTFont(font_path, lazy=True, fontNumber=0)
            coverage = set(tt.getBestCmap().keys())
        except Exception:
            coverage = None
    _font_cmap_cache[font_path] = coverage
    return coverage


def _coverage_score(font_path, sample_text):
    """How much of sample_text this font can actually render.
    Returns (covers_almost_all, fraction). If fontTools isn't available or
    the font can't be parsed, we can't verify — return a neutral "trust it"
    result so behavior degrades gracefully to plain name-matching."""
    if not sample_text:
        return True, 1.0
    cmap = _get_font_cmap(font_path)
    if cmap is None:
        return True, 1.0
    needed = [ord(c) for c in sample_text if not c.isspace()]
    if not needed:
        return True, 1.0
    covered = sum(1 for cp in needed if cp in cmap)
    fraction = covered / len(needed)
    return fraction >= 0.98, fraction
# ---------------------------------------------------------------------------


def _resolve_font_path(script, style):
    """Search installed system fonts for the best match for this script and
    style, trying a priority list of family names. When fontTools is
    available, candidates are verified against real sample text and the
    best-covering one wins rather than just the first name that resolves.
    Cached per (script, style) so this search only happens once."""
    cache_key = (script, style)
    if cache_key in _resolved_font_path_cache:
        return _resolved_font_path_cache[cache_key]

    is_bold = (style == 'bold')
    is_italic = (style == 'italic')

    candidates = list(_SCRIPT_FONT_CANDIDATES.get(script, []))
    if style == 'mono':
        candidates = _MONO_CANDIDATES + candidates
    candidates += _UNIVERSAL_FALLBACK_CANDIDATES

    sample_text = _get_script_sample(script)

    best_path = None
    best_fraction = -1.0
    for name in candidates:
        try:
            path = pygame.font.match_font(name, bold=is_bold, italic=is_italic)
        except Exception:
            path = None
        if not path:
            continue

        covers_almost_all, fraction = _coverage_score(path, sample_text)
        if fraction > best_fraction:
            best_path, best_fraction = path, fraction
        if covers_almost_all:
            break  # good enough — no need to keep scanning

    _resolved_font_path_cache[cache_key] = best_path
    return best_path


def get_font(language, style, size):
    """
    Get a font with the specified style and size, with Unicode coverage
    appropriate for the language's script.

    Tries a prioritized stack of installed system fonts (Noto Sans family
    preferred) matching the language's script (Latin, Cyrillic, Greek, CJK,
    Arabic, Hebrew, Devanagari, Thai). Falls back to a broad-coverage
    universal font, and finally to pygame's bundled default font, so
    non-Latin text renders correctly instead of showing broken-glyph
    squares wherever a suitable system font is available.

    Args:
        language (str): Language code (e.g., 'en', 'ja', 'zh')
        style (str): Font style ('regular', 'bold', 'italic', 'mono')
        size (int): Font size in points

    Returns:
        pygame.font.Font: A font object for rendering text
    """
    cache_key = f"{language}_{style}_{size}"
    if cache_key in font_cache:
        return font_cache[cache_key]

    script = _script_for_language(language)
    font_path = _resolve_font_path(script, style)

    try:
        if font_path:
            font = pygame.font.Font(font_path, size)
            # Harmless even for faces that don't have a real bold/italic
            # variant — pygame synthesizes it — and covers font files that
            # only ship one weight.
            if style == 'bold':
                font.set_bold(True)
            elif style == 'italic':
                font.set_italic(True)
        else:
            # Nothing matched on this system at all — fall back to pygame's
            # bundled default font rather than fail to render anything.
            font = pygame.font.SysFont(None, size, bold=(style == 'bold'), italic=(style == 'italic'))
    except Exception:
        font = pygame.font.SysFont(None, size, bold=(style == 'bold'), italic=(style == 'italic'))

    font_cache[cache_key] = font
    return font

def clear_font_cache():
    """Clear the font cache (font objects only — resolved font *paths* stay
    cached, since which system fonts are installed doesn't change at runtime)."""
    global font_cache
    font_cache = {}

