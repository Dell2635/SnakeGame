class HighScoresScreen:
    # Real list geometry used by draw_screen()'s row loop — kept here as the
    # single source of truth so the scrollbar's content height can never
    # drift out of sync with what's actually drawn (it previously used two
    # different, both-wrong guesses: 70px/row+100 at init, 40px/row+100 at
    # runtime — the "+100" padding in particular was disconnected from the
    # real 20px gap between the viewport top and the first row, which made
    # the scrollbar appear even when every row already fit on screen).
    LIST_TOP = 170       # y where the first row is drawn (see draw_screen)
    ROW_HEIGHT = 40       # vertical space per row (see draw_screen)
    VIEWPORT_TOP = 150    # y where the scrollable viewport starts
    LIST_BOTTOM_MARGIN = 10  # small breathing room below the last row

    def _content_height_for(self, count):
        """Exact scrollable content height for `count` rows, measured from
        the viewport top — matches draw_screen()'s real row geometry."""
        return (self.LIST_TOP - self.VIEWPORT_TOP) + count * self.ROW_HEIGHT + self.LIST_BOTTOM_MARGIN

    def __init__(self, settings, screen):
        self.settings = settings
        self.screen = screen
        
        # Initialize scroll bar for high scores list
        self.scrollbar = None
        self.detail_buttons = []  # populated each frame in draw_screen
        # Perf fix: load_highscores()/filter_highscores() used to run on
        # every single frame (disk read + json.load() + full re-filter/sort,
        # 60x/sec) — this was the actual cause of the High Scores slowdown,
        # not rendering. Both are now cached and only recomputed when the
        # underlying data or the search/filter/sort settings actually change.
        self._hs_cache = None
        self._hs_cache_dirty = True
        self._filter_cache_sig = None
        self._filter_cache_result = []
        self.init_scrollbar()
        
    def init_scrollbar(self):
        """Initialize the scroll bar for high scores"""
        scores = self.load_highscores()
        content_height = self._content_height_for(len(scores))
        screen_height = self.screen.get_height() - 200  # Account for header/footer
        
        self.scrollbar = ScrollBar(
            self.screen.get_width() - 30,  # Right side
            150,  # Below header
            20,   # Width
            screen_height,
            content_height
        )
        # Wheel scrolling works anywhere over the list, not just over the thin bar.
        self.scrollbar.wheel_rect = pygame.Rect(0, 150, self.screen.get_width(), screen_height)
        self.search_text = ""
        self.search_active = False
        self.filter_options = {
            "sort_by": "score",        # score, date, board_size, speed
            "order": "desc",           # asc, desc
            "show_victories": "all",   # all, victory_only, no_victory
            "difficulty": "all",       # all, easy (>=200ms), medium (100-199ms), hard (<100ms)
            "has_replay": "all",       # all, with_replay, no_replay
            "obstacles": "all",        # all, with_obstacles, no_obstacles
            "powerups": "all",         # all, with_powerups, no_powerups
        }
        self.filter_menu_open = False
        self.confirm_delete = None  # score_data pending delete confirmation
        
    def load_highscores(self):
        """Load high scores from the unified data file.

        Cached: this used to call `_load_data()` (a synchronous disk read +
        `json.load()` of the whole save file on every call — and
        `draw_screen()` called it on every single frame, i.e. up to ~60
        disk reads + full JSON re-parses per second while this screen was
        open. That was the actual root cause of the reported slowdown.
        Now it only re-reads when explicitly invalidated (see
        `invalidate_highscores_cache()`), which happens when a score is
        deleted and each time the screen is (re)entered via run(), so it
        always reflects on-disk reality without paying the cost every
        frame.
        """
        if self._hs_cache is None or self._hs_cache_dirty:
            try:
                _gd = _load_data()
                hs = _gd.get('highscores', [])
                self._hs_cache = hs if isinstance(hs, list) else []
            except Exception as e:
                print(f"Error loading high scores: {e}")
                self._hs_cache = []
            self._hs_cache_dirty = False
        return self._hs_cache

    def invalidate_highscores_cache(self):
        """Force the next load_highscores()/filter_highscores() call to
        re-read from disk. Call after anything that changes saved scores."""
        self._hs_cache_dirty = True

    def get_filtered_scores(self):
        """filter_highscores(), cached against (data identity, search text,
        filter/sort settings) so re-sorting/re-filtering the whole list
        doesn't happen on every frame when nothing has actually changed."""
        highscores = self.load_highscores()
        sig = (id(highscores), len(highscores), self.search_text,
               tuple(sorted(self.filter_options.items())))
        if sig != self._filter_cache_sig:
            self._filter_cache_result = self.filter_highscores(highscores)
            self._filter_cache_sig = sig
        return self._filter_cache_result

    def filter_highscores(self, highscores):
        """Filter and sort highscores based on current filter settings and search text"""
        highscores = [score for score in highscores if isinstance(score, dict)]
        def _number(score, key, default=0.0):
            value = score.get(key, default)
            if isinstance(value, bool):
                return float(default)
            try:
                value = float(value)
                return value if math.isfinite(value) else float(default)
            except (TypeError, ValueError, OverflowError):
                return float(default)

        def _board_size_number(score):
            value = score.get('actual_board_width', score.get('board_size', 0))
            if isinstance(value, str):
                return {'small': 10, 'medium': 15, 'large': 20, 'extra_large': 25}.get(
                    value.casefold(), _number({'v': value}, 'v', 0))
            try:
                return float(value) if not isinstance(value, bool) else 0.0
            except (TypeError, ValueError, OverflowError):
                return 0.0

        # Apply search filter (name, score, date, board size, game mode keywords)
        if self.search_text:
            search_lower = self.search_text.casefold()
            def _text(value):
                return str(value or '').casefold()

            def _board_label(score):
                width = score.get('actual_board_width', score.get('board_size', ''))
                height = score.get('actual_board_height', score.get('board_size', ''))
                return f'{width}x{height}'.casefold()

            def _mode_text(score):
                mode = score.get('game_mode') or score.get('mp_mode')
                if not mode:
                    mode = 'multiplayer' if score.get('is_multiplayer') else 'single_player'
                return f"{mode} {score.get('mp_source', '')}".replace('_', ' ').casefold()

            filtered_scores = [
                score for score in highscores
                if search_lower in _text(score.get('name'))
                or search_lower in _text(score.get('score', ''))
                or search_lower in _text(score.get('date'))
                or search_lower in _board_label(score)
                or search_lower in _mode_text(score)
            ]
        else:
            filtered_scores = highscores.copy()

        # Victory filter
        sv = self.filter_options.get("show_victories", "all")
        if sv == "victory_only":
            filtered_scores = [s for s in filtered_scores if s.get('victory', False)]
        elif sv == "no_victory":
            filtered_scores = [s for s in filtered_scores if not s.get('victory', False)]

        # Difficulty filter (based on update_rate_ms — lower = faster = harder)
        diff = self.filter_options.get("difficulty", "all")
        if diff == "easy":
            filtered_scores = [s for s in filtered_scores if _number(s, 'update_rate_ms', 200) >= 200]
        elif diff == "medium":
            filtered_scores = [s for s in filtered_scores if 100 <= _number(s, 'update_rate_ms', 200) < 200]
        elif diff == "hard":
            filtered_scores = [s for s in filtered_scores if _number(s, 'update_rate_ms', 200) < 100]

        # Replay filter
        rep = self.filter_options.get("has_replay", "all")
        if rep == "with_replay":
            filtered_scores = [s for s in filtered_scores if _score_has_replay(s)]
        elif rep == "no_replay":
            filtered_scores = [s for s in filtered_scores if not _score_has_replay(s)]

        # Obstacles filter
        obs = self.filter_options.get("obstacles", "all")
        if obs == "with_obstacles":
            filtered_scores = [s for s in filtered_scores if s.get('obstacles_enabled', False)]
        elif obs == "no_obstacles":
            filtered_scores = [s for s in filtered_scores if not s.get('obstacles_enabled', False)]

        # Powerups filter
        pwrups = self.filter_options.get("powerups", "all")
        if pwrups == "with_powerups":
            filtered_scores = [s for s in filtered_scores if s.get('powerups_enabled', True)]
        elif pwrups == "no_powerups":
            filtered_scores = [s for s in filtered_scores if not s.get('powerups_enabled', True)]

        # Sorting
        sort_key = self.filter_options.get("sort_by", "score")
        desc = (self.filter_options.get("order", "desc") == "desc")
        if sort_key == "score":
            filtered_scores.sort(key=lambda x: _number(x, 'score'), reverse=desc)
        elif sort_key == "date":
            filtered_scores.sort(key=lambda x: str(x.get('date') or ''), reverse=desc)
        elif sort_key == "board_size":
            filtered_scores.sort(key=_board_size_number, reverse=desc)
        elif sort_key == "speed":
            # Lower update_rate_ms = faster; sort ascending for "fastest first" when desc=True
            filtered_scores.sort(key=lambda x: _number(x, 'update_rate_ms', 200), reverse=not desc)

        return filtered_scores
    
    def _layout_header(self):
        """Back / Title / Filter / Search solved together in one UIHorizontalFlow so
        none of them can overlap: previously each had an independently hardcoded
        pixel position that took no account of the others' width."""
        sw = self.screen.get_width()
        lang = self.settings.language
        back_w = max(90, ui_text_size(lang, 'bold', 20, get_text(lang, 'back'))[0] + 40)
        filter_w = max(90, ui_text_size(lang, 'bold', 20, get_text(lang, 'filter'))[0] + 30)
        flow = UIHorizontalFlow(pygame.Rect(20, 18, max(1, sw - 40), 0), spacing=14,
                                wrap=True, drop_optional=True)
        flow.add('back', back_w, min_w=70, h=40)
        flow.add('title', 260, min_w=90, h=40, flex=1, anchor_center=True)
        flow.add('filter', filter_w, min_w=70, h=30, priority=2)
        flow.add('search', 250, min_w=140, h=30, priority=1)
        import_label = get_text(lang, 'replay_share_paste')
        flow.add('import_replay', max(120, ui_text_size(lang, 'bold', 16, import_label)[0] + 24),
                 min_w=86, h=30, priority=3)
        res = flow.solve()
        self._hs_header_mode = res.mode
        return res.rects

    def draw_search_box(self, rect):
        """Draw the search input box at the given rect (from _layout_header)."""
        font = get_font(self.settings.language, 'regular', 20)
