        # Load or create settings
        self.settings = Settings()
        self.settings.load()
        
        # Set up the display
        self.set_display_mode()
        
        # Check if first time running
        if self.settings.first_time:
            # First show language selection, then tutorial
            self.show_language_selection()
            # Now show the tutorial in selected language
            self.show_tutorial()
            self.settings.first_time = False
            self.settings.save()
        
        self.player_name = self.load_player_name()
        self.name_input_active = False
        self.current_language = self.settings.language
        
        # Start/stop background music to match saved settings
        _apply_bgm_state(self.settings)
        
        # Create achievement manager
        self.achievement_manager = AchievementManager()
        self.achievement_manager.load_state()  # restore previously-unlocked achievements from disk
        
        # Create game objects
