def _normalize_ai_configs(configs, count=None):
    raw = configs if isinstance(configs, list) else []
    target = len(raw) if count is None else max(0, int(count))
    target = min(4, target)
    result = []
    for i in range(target):
        item = raw[i] if i < len(raw) and isinstance(raw[i], dict) else {}
        base = _default_ai_config(i)
        base['name'] = str(item.get('name', base['name']))[:20] or base['name']
        diff = str(item.get('difficulty', base['difficulty'])).lower()
        if diff not in ('easy', 'medium', 'hard', 'impossible'):
            diff = base['difficulty']
        base['difficulty'] = diff
        skin = str(item.get('skin', base['skin'])).lower()
        if skin not in ('red', 'orange', 'purple', 'cyan', 'green', 'blue', 'yellow'):
            skin = base['skin']
        base['skin'] = skin
        result.append(base)
    return result


