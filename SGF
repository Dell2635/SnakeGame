    def draw_notification(self, surface, screen_width, screen_height, language='en'):
        """Draw any pending achievement notifications"""
        current_time = time.time()
        notifications_to_remove = []
        
        for i, notification in enumerate(self.pending_notifications):
            achievement = notification['achievement']
            elapsed = current_time - notification['time']
            
            # Calculate fade in/out alpha
            alpha = 255
            if elapsed < 0.5:  # Fade in
                alpha = int(255 * elapsed / 0.5)
            elif elapsed > self.notification_duration - self.notification_fade_time:  # Fade out
                alpha = int(255 * (self.notification_duration - elapsed) / self.notification_fade_time)
            
            if elapsed > self.notification_duration:
                notifications_to_remove.append(notification)
                continue
                
            notification['alpha'] = alpha
            
            # Create a notification surface with transparency
            notification_width = 400
            notification_height = 80
            notification_surface = pygame.Surface((notification_width, notification_height), pygame.SRCALPHA)
            
            # Draw background with transparency - use safe color access
            try:
                achievement_bg_color = COLORS.get('achievement_bg', (45, 45, 65))
                bg_r, bg_g, bg_b = achievement_bg_color[:3]
                bg_color = (int(bg_r), int(bg_g), int(bg_b), alpha)
            except (TypeError, ValueError, IndexError):
                bg_color = (45, 45, 65, alpha)
            
            # Get achievement type color with safe access
            try:
                achievement_type_color = COLORS.get(achievement.type, COLORS.get('gold', (255, 215, 0)))
                border_r, border_g, border_b = achievement_type_color[:3]
                border_color = (int(border_r), int(border_g), int(border_b), alpha)
            except (TypeError, ValueError, IndexError, AttributeError):
                border_color = (255, 215, 0, alpha)
            
            # Ensure valid border radius
            border_radius = min(10, min(notification_width, notification_height) // 4)
            pygame.draw.rect(notification_surface, bg_color, 
                             (0, 0, notification_width, notification_height), 
                             border_radius=border_radius)
            pygame.draw.rect(notification_surface, border_color[:3], 
                             (0, 0, notification_width, notification_height), 
                             width=2, border_radius=border_radius)
            
            # Draw achievement icon
            icon_rect = pygame.Rect(10, 10, 60, 60)
            # Use RGB values for icon colors (remove alpha)
            icon_color = border_color[:3] if len(border_color) >= 3 else (255, 215, 0)
            if achievement.icon_type == 'trophy':
                create_trophy_icon(notification_surface, icon_rect, icon_color)
            elif achievement.icon_type == 'snake':
                create_snake_icon(notification_surface, icon_rect, icon_color)
            elif achievement.icon_type == 'fruit':
                create_fruit_icon(notification_surface, icon_rect, icon_color)
            elif achievement.icon_type == 'settings':
                create_settings_icon(notification_surface, icon_rect, icon_color)
            
            # Draw achievement text
            title_font = get_font(language, 'bold', 18)
            desc_font = get_font(language, 'regular', 14)
            
            # Safely extract text color
            text_color = COLORS.get('achievement_text', (255, 255, 255))
            if isinstance(text_color, tuple) and len(text_color) >= 3:
                text_r, text_g, text_b = [int(c) for c in text_color[:3]]
                text_color_with_alpha = (text_r, text_g, text_b, alpha)
            else:
                text_color_with_alpha = (255, 255, 255, alpha)  # White with alpha
            
            achievement_title = f"{get_text(language, 'achievement_unlocked')}: {achievement.name}"
            # Use regular RGB color for text rendering (pygame doesn't support alpha in text color)
            title_text = title_font.render(achievement_title, True, text_color[:3])
            desc_text = desc_font.render(achievement.description, True, text_color[:3])
            
            notification_surface.blit(title_text, (80, 15))
            notification_surface.blit(desc_text, (80, 45))
            
            # Position the notification at the top of the screen
            notification_x = (screen_width - notification_width) // 2
            notification_y = 20 + i * (notification_height + 10)
            
            surface.blit(notification_surface, (notification_x, notification_y))
        
        # Remove expired notifications
        for notification in notifications_to_remove:
            self.pending_notifications.remove(notification)
    
