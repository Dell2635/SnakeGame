class Achievement:
    def __init__(self, achievement_id, name, description, icon_type='trophy', achievement_type='bronze'):
        """
        Initialize an achievement
        
        Args:
            achievement_id (str): Unique identifier for the achievement
            name (str): Display name of the achievement
            description (str): Detailed description of how to earn the achievement
            icon_type (str): Type of icon to display ('trophy', 'snake', 'fruit', 'settings')
            achievement_type (str): Rarity/tier of the achievement ('bronze', 'silver', 'gold', 'platinum')
        """
        self.id = achievement_id
        self.name = name
        self.description = description
        self.icon_type = icon_type
        self.type = achievement_type
        self.unlocked = False
        self.unlock_time = None
        self.notification_shown = False
    
    def unlock(self):
        """Unlock this achievement and record the time"""
        if not self.unlocked:
            self.unlocked = True
            self.unlock_time = time.time()
            return True
        return False
    
    def draw_icon(self, surface, rect):
        """Draw the achievement icon"""
        # Draw the background
        pygame.draw.rect(surface, COLORS['achievement_bg'], rect, border_radius=max(1, rect.width // 5))
        pygame.draw.rect(surface, COLORS.get(self.type, COLORS['gold']), rect, width=2, border_radius=max(1, rect.width // 5))
        
        # Draw the icon based on type - use integer coordinates to prevent type errors
        padding = rect.width // 5
        icon_rect = pygame.Rect(rect.x + padding, rect.y + padding, 
                                rect.width - (padding * 2), rect.height - (padding * 2))
        
        # Safe color handling to prevent crashes
        icon_color = COLORS.get(self.type, COLORS.get('gold', (255, 215, 0)))
        if self.icon_type == 'trophy':
            create_trophy_icon(surface, icon_rect, icon_color)
        elif self.icon_type == 'snake':
            create_snake_icon(surface, icon_rect, icon_color)
        elif self.icon_type == 'fruit':
            create_fruit_icon(surface, icon_rect, icon_color)
        elif self.icon_type == 'settings':
            create_settings_icon(surface, icon_rect, icon_color)
        
        # If not unlocked, add a lock overlay
        if not self.unlocked:
            lock_color = (60, 60, 80, 180)  # Semi-transparent dark color
            pygame.draw.rect(surface, lock_color, rect, border_radius=max(1, rect.width // 5))
            
            # Draw a lock symbol - use standard RGB (no alpha) to prevent TypeError
            lock_width = int(rect.width * 0.4)
            lock_height = int(rect.height * 0.6)
            lock_body = pygame.Rect(
                rect.centerx - lock_width // 2,
                rect.centery - lock_height // 4,
                lock_width, 
                lock_height // 2
            )
            pygame.draw.rect(surface, (200, 200, 200), lock_body, border_radius=lock_width // 5)
            
            # Lock arch
            lock_arch_radius = lock_width // 2
            arch_rect = pygame.Rect(
                rect.centerx - lock_arch_radius,
                rect.centery - lock_height // 2,
                lock_arch_radius * 2,
                lock_arch_radius
            )
            pygame.draw.arc(surface, (200, 200, 200), arch_rect, 3.14, 6.28, 3)

class AchievementManager:
    def __init__(self):
        """Initialize the achievement manager"""
        self.achievements = {}
        self.pending_notifications = []
        self.notification_duration = 3  # seconds
        self.notification_fade_time = 1  # seconds
        
        # Initialize achievements from the definitions
        for achievement_id, data in ACHIEVEMENTS.items():
            self.achievements[achievement_id] = Achievement(
                achievement_id=data['id'],
                name=data['name'],
                description=data['description'],
                icon_type=data['icon'],
                achievement_type=data['type']
            )
    
    def unlock_achievement(self, achievement_id):
        """Unlock an achievement by ID and queue a notification"""
        if achievement_id in self.achievements:
            achievement = self.achievements[achievement_id]
            if achievement.unlock():
                self.pending_notifications.append({
                    'achievement': achievement,
                    'time': time.time(),
                    'alpha': 255
                })
                return True
        return False
    
    def check_achievement_progress(self, game_data):
        """
        Check for achievement progress based on game data
        
        Args:
            game_data (dict): Dictionary containing game state data for checking achievements
        """
        # Score-based achievements
        score = game_data.get('score', 0)
        if score >= 10:
            self.unlock_achievement('score_10')
        if score >= 25:
            self.unlock_achievement('score_25')
        if score >= 50:
            self.unlock_achievement('score_50')
        if score >= 75:
            self.unlock_achievement('score_75')
        if score >= 100:
            self.unlock_achievement('score_100')
        
        # First game achievement
        if game_data.get('games_played', 0) > 0:
            self.unlock_achievement('first_game')
        
        # Check for powerup achievements
        powerups_used = game_data.get('powerups_used', [])
        if 'ghost_mode' in powerups_used:
            self.unlock_achievement('ghost_snake')
        if 'invincibility' in powerups_used:
            self.unlock_achievement('invincible_snake')
        
        # Check for portal achievements
        portal_uses = game_data.get('portals_used', 0)
        if portal_uses >= 10:
            self.unlock_achievement('portal_traveler')
        
        # Check for obstacle achievements
        if game_data.get('completed_with_obstacles', False):
            self.unlock_achievement('obstacle_navigator')
        
        # Check for combo achievements
        max_combo = game_data.get('max_combo', 0)
        if max_combo >= 5:
            self.unlock_achievement('combo_master')
        
        # Check for fruit collector achievements
        unique_fruits = game_data.get('unique_fruits_collected', [])
        if len(unique_fruits) >= 5:
            self.unlock_achievement('fruit_collector')
        if len(unique_fruits) >= 25:  # All fruit types
            self.unlock_achievement('fruit_master')
        
        # Check for speed demon achievement
        if game_data.get('max_speed_game', False):
            self.unlock_achievement('speed_demon')
        
        # Check for settings achievements
        settings_changed = game_data.get('settings_changed', [])
        if len(settings_changed) >= 5:
            self.unlock_achievement('settings_explorer')
        
        # Check for colorful snake achievement
        if 'snake_color' in settings_changed:
            self.unlock_achievement('colorful_snake')

        # New extended achievements
        score = game_data.get('score', 0)
        if score >= 200:
            self.unlock_achievement('score_200')

        snake_length = game_data.get('snake_length', 0)
        if snake_length >= 20:
            self.unlock_achievement('long_snake')

        games_played = game_data.get('games_played', 0)
        if games_played >= 10:
            self.unlock_achievement('marathon_runner')

        portal_uses = game_data.get('portal_uses', 0)
        if portal_uses >= 25:
            self.unlock_achievement('portal_expert')

        powerups_used = game_data.get('powerups_used', [])
        if len(set(powerups_used)) >= 3:
            self.unlock_achievement('power_addict')

        board_size = game_data.get('board_size', 10)
        victory = game_data.get('victory', False)
        if victory and board_size > 20:
            self.unlock_achievement('big_board')

        update_rate = game_data.get('update_rate_ms', 200)
        if victory and update_rate <= 100:
            self.unlock_achievement('speed_runner')

        max_combo = game_data.get('max_combo', 0)
        if max_combo >= 10:
            self.unlock_achievement('combo_god')

        used_powerups = game_data.get('powerups_used', [])
        if victory and len(used_powerups) == 0:
            self.unlock_achievement('no_powerup_win')
    
    def draw_notification(self, surface, screen_width, screen_height, language='en'):
        """Draw any pending achievement notifications"""
        current_time = time.time()
        notifications_to_remove = []
        
        for i, notification in enumerate(self.pending_notifications):
            achievement = notification['achievement']
            elapsed = current_time - notification['time']
            
            # Calculate fade in/out alpha
            alpha = 255
            if elapsed < 0.5:  # Fade in
                alpha = int(255 * elapsed / 0.5)
            elif elapsed > self.notification_duration - self.notification_fade_time:  # Fade out
                alpha = int(255 * (self.notification_duration - elapsed) / self.notification_fade_time)
            
            if elapsed > self.notification_duration:
                notifications_to_remove.append(notification)
                continue
                
            notification['alpha'] = alpha
            
            # Create a notification surface with transparency
            notification_width = 400
            notification_height = 80
            notification_surface = pygame.Surface((notification_width, notification_height), pygame.SRCALPHA)
            
            # Draw background with transparency - use safe color access
            try:
                achievement_bg_color = COLORS.get('achievement_bg', (45, 45, 65))
                bg_r, bg_g, bg_b = achievement_bg_color[:3]
                bg_color = (int(bg_r), int(bg_g), int(bg_b), alpha)
            except (TypeError, ValueError, IndexError):
                bg_color = (45, 45, 65, alpha)
            
            # Get achievement type color with safe access
            try:
                achievement_type_color = COLORS.get(achievement.type, COLORS.get('gold', (255, 215, 0)))
                border_r, border_g, border_b = achievement_type_color[:3]
                border_color = (int(border_r), int(border_g), int(border_b), alpha)
            except (TypeError, ValueError, IndexError, AttributeError):
                border_color = (255, 215, 0, alpha)
            
            # Ensure valid border radius
            border_radius = min(10, min(notification_width, notification_height) // 4)
            pygame.draw.rect(notification_surface, bg_color, 
                             (0, 0, notification_width, notification_height), 
                             border_radius=border_radius)
            pygame.draw.rect(notification_surface, border_color[:3], 
                             (0, 0, notification_width, notification_height), 
                             width=2, border_radius=border_radius)
            
            # Draw achievement icon
            icon_rect = pygame.Rect(10, 10, 60, 60)
            # Use RGB values for icon colors (remove alpha)
            icon_color = border_color[:3] if len(border_color) >= 3 else (255, 215, 0)
            if achievement.icon_type == 'trophy':
                create_trophy_icon(notification_surface, icon_rect, icon_color)
            elif achievement.icon_type == 'snake':
                create_snake_icon(notification_surface, icon_rect, icon_color)
            elif achievement.icon_type == 'fruit':
                create_fruit_icon(notification_surface, icon_rect, icon_color)
            elif achievement.icon_type == 'settings':
                create_settings_icon(notification_surface, icon_rect, icon_color)
            
            # Draw achievement text
            title_font = get_font(language, 'bold', 18)
            desc_font = get_font(language, 'regular', 14)
            
            # Safely extract text color
            text_color = COLORS.get('achievement_text', (255, 255, 255))
            if isinstance(text_color, tuple) and len(text_color) >= 3:
                text_r, text_g, text_b = [int(c) for c in text_color[:3]]
                text_color_with_alpha = (text_r, text_g, text_b, alpha)
            else:
                text_color_with_alpha = (255, 255, 255, alpha)  # White with alpha
            
            achievement_title = f"{get_text(language, 'achievement_unlocked')}: {achievement.name}"
            # Use regular RGB color for text rendering (pygame doesn't support alpha in text color)
            title_text = title_font.render(achievement_title, True, text_color[:3])
            desc_text = desc_font.render(achievement.description, True, text_color[:3])
            
            notification_surface.blit(title_text, (80, 15))
            notification_surface.blit(desc_text, (80, 45))
            
            # Position the notification at the top of the screen
            notification_x = (screen_width - notification_width) // 2
            notification_y = 20 + i * (notification_height + 10)
            
            surface.blit(notification_surface, (notification_x, notification_y))
        
        # Remove expired notifications
        for notification in notifications_to_remove:
            self.pending_notifications.remove(notification)
    
    def draw_achievements_screen(self, surface, screen_width, screen_height, language):
        """Draw the achievements screen with all achievements"""
        # Fill background
        surface.fill(COLORS['background'])
        
        # Draw title
        title_font = get_font(language, 'bold', 36)
        title_text = title_font.render(get_text(language, 'achievements'), True, COLORS['white'])
        surface.blit(title_text, (screen_width // 2 - title_text.get_width() // 2, 50))
        
        # Calculate grid layout
        achievements_per_row = 4
        icon_size = 100
        padding = 20
        start_x = (screen_width - (achievements_per_row * icon_size + (achievements_per_row - 1) * padding)) // 2
        start_y = 150
        
        # Track position for each achievement
        x, y = start_x, start_y
        
        # Organize achievements by type
        achievements_by_type = {
            'platinum': [],
            'gold': [],
            'silver': [],
            'bronze': []
        }
        
        for achievement in self.achievements.values():
            achievements_by_type[achievement.type].append(achievement)
        
        # Draw achievements by type in order
        for achievement_type in ['platinum', 'gold', 'silver', 'bronze']:
            # Draw section title if there are achievements of this type
            if achievements_by_type[achievement_type]:
                type_font = get_font(language, 'bold', 24)
                type_text = type_font.render(achievement_type.capitalize(), True, COLORS[achievement_type])
                surface.blit(type_text, (start_x, y))
                y += 40
                
                # Reset x position for new row
                x = start_x
                
                # Draw achievements of this type
                for i, achievement in enumerate(achievements_by_type[achievement_type]):
                    # Create a new row if needed
                    if i > 0 and i % achievements_per_row == 0:
                        x = start_x
                        y += icon_size + padding
                    
                    # Draw achievement icon
                    achievement_rect = pygame.Rect(x, y, icon_size, icon_size)
                    achievement.draw_icon(surface, achievement_rect)
                    
                    # Draw achievement name if unlocked or "???" if locked
                    name_font = get_font(language, 'regular', 14)
                    if achievement.unlocked:
                        name_text = name_font.render(achievement.name, True, COLORS['white'])
                    else:
                        name_text = name_font.render("???", True, COLORS['gray'])
                    
                    text_x = x + (icon_size - name_text.get_width()) // 2
                    surface.blit(name_text, (text_x, y + icon_size + 5))
                    
                    # Move to next position
                    x += icon_size + padding
                
                # Add space before next section
                y += icon_size + padding + 30
        
        # Draw back button
        back_button_rect = pygame.Rect(screen_width // 2 - 100, screen_height - 80, 200, 50)
        pygame.draw.rect(surface, COLORS['button'], back_button_rect, border_radius=10)
        
        back_font = get_font(language, 'bold', 20)
        back_text = back_font.render(get_text(language, 'back'), True, COLORS['white'])
        back_text_x = back_button_rect.centerx - back_text.get_width() // 2
        back_text_y = back_button_rect.centery - back_text.get_height() // 2
        surface.blit(back_text, (back_text_x, back_text_y))
        
        return back_button_rect
    
    def save(self):
        """Save achievements to the unified game data file"""
        achievement_data = {}
        for achievement_id, achievement in self.achievements.items():
            achievement_data[achievement_id] = {
                'unlocked': achievement.unlocked,
                'unlock_time': achievement.unlock_time
            }
        try:
            _gd = _load_data()
            _gd['achievements'] = achievement_data
            _save_data(_gd)
        except (IOError) as e:
            print(f"Error saving achievements: {e}")
    
    def load(self):
        """Load achievements from the unified game data file"""
        try:
            _gd = _load_data()
            achievement_data = _gd.get('achievements', {})
            for achievement_id, data in achievement_data.items():
                if achievement_id in self.achievements:
                    self.achievements[achievement_id].unlocked = data.get('unlocked', False)
                    self.achievements[achievement_id].unlock_time = data.get('unlock_time', None)
        except (json.JSONDecodeError, FileNotFoundError, IOError) as e:
            print(f"Error loading achievements: {e}")

