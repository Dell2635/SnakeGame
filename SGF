def run_full_preflight_check():
    """Validates prerequisites before the full application starts. Uses only
    the standard library (no pygame dependency), so it still produces a
    diagnosable result even when pygame itself is unavailable — a critical
    missing dependency should never cause an opaque crash before this runs."""
    report = {'ok': True, 'checks': []}

    def _check(name, fn):
        try:
            ok, detail = fn()
        except Exception as e:
            ok, detail = False, str(e)
        report['checks'].append({'name': name, 'ok': ok, 'detail': detail})
        if not ok:
            report['ok'] = False

    def _check_python():
        return sys.version_info[:2] >= (3, 8), sys.version.split()[0]

    def _check_pygame_importable():
        try:
            import pygame as _pg
            return True, getattr(getattr(_pg, 'version', None), 'ver', 'unknown')
        except Exception as e:
            return False, str(e)

    def _check_data_dir():
        path = _user_data_manager.get_data_dir()
        probe = os.path.join(path, '.preflight_probe')
        with open(probe, 'w') as _f:
            _f.write('ok')
        os.remove(probe)
        return True, path

    def _check_config_schema():
        data = _load_data()
        return isinstance(data, dict), 'ok'

    _check('python_version', _check_python)
    _check('pygame_importable', _check_pygame_importable)
    _check('data_directory_writable', _check_data_dir)
    _check('config_schema_readable', _check_config_schema)

    try:
        sgf_log.info(f"Preflight check: {report}")
    except Exception:
        pass

    if not report['ok']:
        print("=" * 60)
        print("SGF preflight check found problems:")
        for c in report['checks']:
            if not c['ok']:
                print(f"  - {c['name']}: {c['detail']}")
        print(f"Data directory: {_user_data_manager.get_data_dir()}")
        print(f"Log directory:  {_user_data_manager.get_log_dir()}")
        print("The game will still try to start; try --safe-mode if it fails to launch normally.")
        print("=" * 60)

    return report


