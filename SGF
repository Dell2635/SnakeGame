        content_width = int(screen_width * 0.5)  # Control width 50% of screen
        
        # Scale controls to screen size
        if screen_width < 800:
            content_width = int(screen_width * 0.7)  # Wider controls on small screens
        
        # Vertical spacing/positioning (basic settings at the left)
        title_y = int(screen_height * 0.07)
        
        # Page-independent vertical positions
        item_start_y = int(screen_height * 0.15)  # Starting Y position for controls
        item_spacing = int(screen_height * 0.09)   # Spacing between control groups
        
        # Define common variables for all settings pages to prevent undefined variables
        self.powerups_spacing = int(item_spacing * 0.6)  # Slightly closer together for lists
        self.powerups_title_y = item_start_y
        self.powerups_start_y = item_start_y + self.powerups_spacing
        self.board_size_y = item_start_y + item_spacing * 2
        self.wall_collision_y = item_start_y + item_spacing * 3
        self.language_y = item_start_y + item_spacing
        
        # Button rows at the bottom
        button_row1_y = int(screen_height * 0.70)
        button_row2_y = int(screen_height * 0.80)
        
        # Button sizes based on screen
        button_width = int(content_width * 0.45)
        button_height = int(screen_height * 0.06)
        
        # Draw title
        title_font = get_font(self.settings.language, 'bold', int(screen_height * 0.05))
        title_text = get_text(self.settings.language, 'settings')
        title_surface = title_font.render(title_text, True, COLORS['white'])
        self.screen.blit(title_surface, (screen_width // 2 - title_surface.get_width() // 2, title_y))
        
        # Create controls
        controls = {}
        
        # Determine which page to show based on current_page
        if self.current_page == 0:  # General settings page
            self.draw_general_settings(screen_width, screen_height, margin_x, content_width, item_start_y, item_spacing, controls, language_dropdown_open)
