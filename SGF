        surface.blit(back_text, (back_text_x, back_text_y))
        
        return back_button_rect
    
    def save(self):
        """Save achievements to the unified game data file"""
        achievement_data = {}
        for achievement_id, achievement in self.achievements.items():
            achievement_data[achievement_id] = {
                'unlocked': achievement.unlocked,
                'unlock_time': achievement.unlock_time
            }
        try:
            _gd = _load_data()
            _gd['achievements'] = achievement_data
            _save_data(_gd)
        except (IOError) as e:
            print(f"Error saving achievements: {e}")
    
    def load(self):
        """Load achievements from the unified game data file"""
        try:
            _gd = _load_data()
            achievement_data = _gd.get('achievements', {})
            for achievement_id, data in achievement_data.items():
                if achievement_id in self.achievements:
                    self.achievements[achievement_id].unlocked = data.get('unlocked', False)
                    self.achievements[achievement_id].unlock_time = data.get('unlock_time', None)
        except (json.JSONDecodeError, FileNotFoundError, IOError) as e:
            print(f"Error loading achievements: {e}")

