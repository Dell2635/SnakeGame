def _classify_lan_address(address):
    """Return (family label, scope) for a listed address: scope is 'local' or 'internet'."""
    base = str(address or '').split('%', 1)[0]
    try:
        parsed = _ipaddress_mod.ip_address(base)
    except ValueError:
        return 'IPv4', 'local'
    if parsed.version == 4:
        return 'IPv4', 'local'
    if parsed.is_global:
        return 'IPv6', 'internet'
    return 'IPv6', 'local'


def _order_lan_addresses(addresses):
    """IPv4 first, then global IPv6, then other IPv6 (unique, stable order)."""
    unique = []
    for address in addresses or []:
        if address and address not in unique:
            unique.append(address)
    def rank(address):
        family, scope = _classify_lan_address(address)
        if family == 'IPv4':
            return 0
        return 1 if scope == 'internet' else 2
    return sorted(unique, key=rank)


def _wrap_ui_text(font, text, max_width, max_lines=3):
    """Greedy word wrap that never exceeds max_lines (last line is ellipsised)."""
    words, lines, current = str(text).split(), [], ''
    for word in words:
        trial = f'{current} {word}'.strip()
        if font.size(trial)[0] <= max_width or not current:
            current = trial
        else:
            lines.append(current)
            current = word
    if current:
        lines.append(current)
    if len(lines) > max_lines:
        lines = lines[:max_lines]
        lines[-1] = lines[-1].rstrip('.,;: ') + '…'
    return lines


def _relay_step_index(state):
    """Which of the four relay steps is active (4 = all done, -1 = failed)."""
    if state in ('unavailable', 'not_installed'):
        return -1
    if state == 'ready':
        return 4
    return {'checking': 0, 'downloading': 0, 'starting': 1, 'verifying': 2}.get(state, 0)


