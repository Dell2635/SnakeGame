    def _host_flow(self, mode):
        """Listen for one client. Returns (True, conn, mode, custom_map) or None on cancel."""
        clock = pygame.time.Clock()
        mf = get_font(self.settings.language, 'bold',    22)
        sf = get_font(self.settings.language, 'regular', 15)

        # Host picks the board layout up front — it's sent to the client in
        # the handshake below, so both sides always end up with the exact
        # same map (never two independently-generated layouts).
        chosen_map = MapPickerScreen(self.settings, self.screen).run()

        local_ips = _get_local_ips()
        srv = None
        try:
            srv = _socket_mod.socket(_socket_mod.AF_INET, _socket_mod.SOCK_STREAM)
            srv.setsockopt(_socket_mod.SOL_SOCKET, _socket_mod.SO_REUSEADDR, 1)
            srv.bind(('0.0.0.0', self.PORT))
            srv.listen(1)
            srv.settimeout(0.08)
        except Exception as e:
            self._show_error(get_text(self.settings.language, 'cannot_start_server').format(error=e))
            return None

        dots = 0
        dot_timer = 0
        try:
            lang = self.settings.language
            while True:
                sw, sh = self.screen.get_width(), self.screen.get_height()
                self._draw_bg()

                ts = mf.render(get_text(lang, 'hosting_waiting'), True, COLORS['white'])
                self.screen.blit(ts, (sw // 2 - ts.get_width() // 2, int(sh * 0.08)))

                ip_y = int(sh * 0.22)
                lbl = sf.render(get_text(lang, 'share_ip_hint'), True, (190, 215, 255))
                self.screen.blit(lbl, (sw // 2 - lbl.get_width() // 2, ip_y)); ip_y += 28

                shown = local_ips[:5] if local_ips else ['(could not detect — check your network)']
                for ip in shown:
                    s = mf.render(ip, True, (80, 255, 140))
                    self.screen.blit(s, (sw // 2 - s.get_width() // 2, ip_y)); ip_y += 36

                ps = sf.render(get_text(lang, 'port_label').format(port=self.PORT), True, (190, 190, 190))
                self.screen.blit(ps, (sw // 2 - ps.get_width() // 2, ip_y + 6))

                dot_timer += 1
                if dot_timer > 18: dots = (dots + 1) % 4; dot_timer = 0
                ws = sf.render(get_text(lang, 'waiting_connection') + "." * dots, True, (150, 175, 220))
                self.screen.blit(ws, (sw // 2 - ws.get_width() // 2, int(sh * 0.72)))

                cancel_r = pygame.Rect(sw // 2 - 100, int(sh * 0.83), 200, 46)
                mp = pygame.mouse.get_pos()
                self._mk_btn(cancel_r, get_text(lang, 'cancel'), (90, 30, 30), mp, mf)
                pygame.display.flip(); clock.tick(60)

                # Non-blocking accept
                conn = None
                try:
                    conn, addr = srv.accept()
                    conn.setsockopt(_socket_mod.IPPROTO_TCP, _socket_mod.TCP_NODELAY, 1)
                    conn.setblocking(True)
                    _net_send(conn, {'t': 'hello', 'mode': mode, 'map': chosen_map})
                    ack = _net_recv(conn)
                    if ack and ack.get('t') == 'hello_ack':
                        return (True, conn, mode, chosen_map)
                    conn.close()
                except _socket_mod.timeout:
                    pass
                except Exception:
                    if conn:
                        try: conn.close()
                        except: pass

                for event in pygame.event.get():
                    if event.type == pygame.QUIT:           pygame.quit(); sys.exit()
                    elif event.type == pygame.KEYDOWN:
                        if event.key == pygame.K_ESCAPE:    return None
                    elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                        if cancel_r.collidepoint(event.pos): return None
                    elif event.type == pygame.VIDEORESIZE:
                        self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
        finally:
            try: srv.close()
            except: pass

    def _join_flow(self, mode):
        """IP-entry + connect UI. Returns (False, conn, mode) or None."""
        clock = pygame.time.Clock()
        mf  = get_font(self.settings.language, 'bold',    22)
