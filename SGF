# IA5 protocol constants are defined before the network helpers because
# these helpers execute during module import.
IA5_NET_PROTOCOL_VERSION = 5
# A complete state frame is far smaller than this (the largest supported
# board has at most 5,000 obstacles). Keep a generous ceiling for forward
# compatibility without allowing a peer to force multi-megabyte allocations.
IA5_NET_MAX_FRAME = 1_000_000

class _NetProtocolError(Exception):
    """Remote payload violated the established SGF TCP framing/protocol."""


NET_PROTOCOL_VERSION = IA5_NET_PROTOCOL_VERSION
NET_MAX_FRAME = IA5_NET_MAX_FRAME
NET_MAX_SESSION_INPUT_FRAME = 256
NET_MAX_SESSION_STATE_FRAME = 550_000


def _allow_network_handshake_attempt(peer_ip, attempts_by_ip, now=None,
                                      max_attempts=8, window_seconds=60.0,
                                      max_tracked_ips=256):
    """Bound unauthenticated TLS work per source without unbounded state."""
    now = time.monotonic() if now is None else float(now)
    peer_ip = str(peer_ip or '')[:64]
    if not peer_ip or not isinstance(attempts_by_ip, dict):
        return False
    cutoff = now - max(1.0, float(window_seconds))
    for tracked_ip in list(attempts_by_ip):
        recent = [stamp for stamp in attempts_by_ip[tracked_ip]
                  if isinstance(stamp, (int, float)) and cutoff < stamp <= now]
        if recent:
            attempts_by_ip[tracked_ip] = recent
        else:
            attempts_by_ip.pop(tracked_ip, None)
    recent = attempts_by_ip.get(peer_ip, [])
    if len(recent) >= max(1, int(max_attempts)):
        return False
    if peer_ip not in attempts_by_ip and len(attempts_by_ip) >= max(1, int(max_tracked_ips)):
        oldest_ip = min(attempts_by_ip, key=lambda key: attempts_by_ip[key][0])
        attempts_by_ip.pop(oldest_ip, None)
    attempts_by_ip.setdefault(peer_ip, []).append(now)
    return True


def _network_rate_window(start, count, now, limit, window_seconds=1.0):
    if now - start >= window_seconds:
        start, count = now, 0
    count += 1
    return start, count, count <= limit


def _network_crypto_available():
    try:
        from cryptography import x509  # noqa: F401
        from cryptography.hazmat.primitives.asymmetric import ec  # noqa: F401
        return True
    except ImportError:
        return False


def _create_network_tls_server_context():
    """Create an ephemeral TLS identity; never persist its private key."""
    try:
        from cryptography import x509
        from cryptography.hazmat.primitives import hashes, serialization
        from cryptography.hazmat.primitives.asymmetric import ec
        from cryptography.x509.oid import NameOID
    except ImportError as exc:
        raise RuntimeError('Secure multiplayer requires the cryptography package.') from exc

    key = ec.generate_private_key(ec.SECP256R1())
    now = datetime.now(_datetime_timezone.utc)
    subject = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, 'SGF temporary host')])
    cert = (
        x509.CertificateBuilder()
        .subject_name(subject)
        .issuer_name(subject)
        .public_key(key.public_key())
        .serial_number(x509.random_serial_number())
        .not_valid_before(now - timedelta(minutes=1))
        .not_valid_after(now + timedelta(hours=12))
        .sign(key, hashes.SHA256())
    )
    cert_bytes = cert.public_bytes(serialization.Encoding.PEM)
    key_bytes = key.private_bytes(
        serialization.Encoding.PEM,
        serialization.PrivateFormat.PKCS8,
        serialization.NoEncryption(),
    )
    cert_path = key_path = None
    try:
        with tempfile.NamedTemporaryFile(prefix='sgf-tls-cert-', suffix='.pem', delete=False) as f:
            cert_path = f.name
            f.write(cert_bytes)
        with tempfile.NamedTemporaryFile(prefix='sgf-tls-key-', suffix='.pem', delete=False) as f:
            key_path = f.name
            f.write(key_bytes)
        context = _ssl_mod.SSLContext(_ssl_mod.PROTOCOL_TLS_SERVER)
        context.minimum_version = _ssl_mod.TLSVersion.TLSv1_2
        context.load_cert_chain(certfile=cert_path, keyfile=key_path)
    finally:
        for path in (cert_path, key_path):
            if path:
                try:
                    os.remove(path)
                except OSError:
                    pass
    fingerprint = cert.fingerprint(hashes.SHA256())
    return context, fingerprint


def _network_tls_client_context():
    context = _ssl_mod.SSLContext(_ssl_mod.PROTOCOL_TLS_CLIENT)
    context.minimum_version = _ssl_mod.TLSVersion.TLSv1_2
    # Identity is checked explicitly against the fingerprint in the invite.
    context.check_hostname = False
    context.verify_mode = _ssl_mod.CERT_NONE
    return context


class _RelayConnectError(_NetProtocolError):
    """Relay transport failure carrying a short, language-neutral stage code.

    ``stage`` is one of: dns, edge, relay, tls-edge. ``transient`` marks
    failures that are normal while a fresh Quick Tunnel is still propagating.
    """
    def __init__(self, stage, detail='', status=None, transient=False):
        super().__init__(detail or stage)
        self.stage = str(stage)
        self.status = status
        self.transient = bool(transient)


_RELAY_DOH_ENDPOINT = 'https://1.1.1.1/dns-query'


def _resolve_via_doh(host, port, timeout=3.0, opener=None):
    """Resolve a Cloudflare relay hostname through DNS-over-HTTPS.

    A brand-new trycloudflare.com name is often looked up by the OS resolver
    before it has propagated; Windows then caches that NXDOMAIN for minutes.
    Asking Cloudflare's resolver directly sidesteps that cache. Returns
    getaddrinfo-style tuples ([] when no record exists yet) and raises OSError
    when DNS-over-HTTPS itself cannot be reached.
    """
    import urllib.request as _urlrequest
    import urllib.parse as _urlparse
    host = str(host or '').strip().rstrip('.').lower()
    if not _is_cloudflare_quick_hostname(host):
        raise ValueError('DNS-over-HTTPS fallback is limited to Cloudflare relay hosts')
    open_url = opener or _urlrequest.urlopen
    answers = []
    for record_type, record_code, family in (('A', 1, _socket_mod.AF_INET),
                                             ('AAAA', 28, _socket_mod.AF_INET6)):
        query = _urlparse.urlencode({'name': host, 'type': record_type})
        request = _urlrequest.Request(
            f'{_RELAY_DOH_ENDPOINT}?{query}',
            headers={'Accept': 'application/dns-json', 'User-Agent': 'SGF multiplayer'})
        with open_url(request, timeout=max(0.5, float(timeout))) as response:
            payload = response.read(65537)
        if len(payload) > 65536:
            raise OSError('DNS-over-HTTPS response is too large')
        try:
            document = json.loads(payload.decode('utf-8'))
        except (UnicodeError, ValueError) as exc:
            raise OSError('DNS-over-HTTPS returned an invalid document') from exc
        if not isinstance(document, dict):
            raise OSError('DNS-over-HTTPS returned an invalid document')
        for entry in (document.get('Answer') or [])[:16]:
            if not isinstance(entry, dict) or entry.get('type') != record_code:
                continue
            try:
                address = _ipaddress_mod.ip_address(str(entry.get('data', '')))
            except ValueError:
                continue
            if not address.is_global or address.version != (4 if record_code == 1 else 6):
                continue
            sockaddr = (str(address), int(port)) if record_code == 1 else (str(address), int(port), 0, 0)
            answers.append((family, _socket_mod.SOCK_STREAM, 6, '', sockaddr))
    return answers


def _connect_relay_tcp(host, port, timeout):
    """TCP connect to the Cloudflare edge, tolerating a stale local DNS cache."""
    try:
        return _socket_mod.create_connection((host, port), timeout=timeout)
    except _socket_mod.gaierror as dns_error:
        if not _is_cloudflare_quick_hostname(host):
            raise
        try:
            candidates = _resolve_via_doh(host, port, timeout=min(4.0, float(timeout)))
        except (OSError, ValueError):
            candidates = []
        if not candidates:
            raise _RelayConnectError(
                'dns', 'relay hostname does not resolve yet', transient=True) from dns_error
        last_error = None
        for family, kind, proto, _canonical, sockaddr in candidates[:4]:
            candidate = _socket_mod.socket(family, kind, proto)
            try:
                candidate.settimeout(timeout)
                candidate.connect(sockaddr)
                return candidate
            except OSError as exc:
                last_error = exc
                candidate.close()
        raise _RelayConnectError(
            'edge', 'could not reach the Cloudflare edge', transient=True) from last_error


def _relay_host_header(host, port):
    """Host header for the upgrade request; the default HTTPS port is implicit."""
    host = str(host)
    return host if int(port) == 443 else f'{host}:{int(port)}'


class _WebSocketByteStream:
    """Socket-like byte stream carried by one secure WebSocket connection."""
    _MAX_MESSAGE = 1_000_000

    def __init__(self, host, port, path, timeout=8.0, outer_context=None):
        self.host = str(host)
        self.port = int(port)
        self._sock = None
        self._timeout = timeout
        self._read_buffer = bytearray()
        self._socket_read_buffer = bytearray()
        self._write_lock = threading.Lock()
        self._closed = True

        try:
            raw = _connect_relay_tcp(self.host, self.port, timeout)
        except _RelayConnectError:
            raise
        except OSError as exc:
            raise _RelayConnectError('edge', type(exc).__name__, transient=True) from exc
        try:
            raw.setsockopt(_socket_mod.IPPROTO_TCP, _socket_mod.TCP_NODELAY, 1)
            context = outer_context or _ssl_mod.create_default_context()
            self._sock = context.wrap_socket(raw, server_hostname=self.host)
        except OSError as exc:
            try:
                raw.close()
            except OSError:
                pass
            # A certificate problem (for example a wrong system clock) will not
            # fix itself by retrying; resets and timeouts might.
            fatal = isinstance(exc, _ssl_mod.SSLCertVerificationError)
            raise _RelayConnectError('tls-edge', type(exc).__name__, transient=not fatal) from exc

        key = _base64_mod.b64encode(_secrets_mod.token_bytes(16)).decode('ascii')
        fingerprint, _token = _parse_network_invite(path)
        # Keep the bearer token out of the HTTP request path visible to the
        # Cloudflare edge. Only the public certificate fingerprint is routed.
        request_path = '/sgf/' + fingerprint.hex()
        request = (
            f'GET {request_path} HTTP/1.1\r\n'
            f'Host: {_relay_host_header(self.host, self.port)}\r\n'
            'Upgrade: websocket\r\n'
            'Connection: Upgrade\r\n'
            f'Sec-WebSocket-Key: {key}\r\n'
            'Sec-WebSocket-Version: 13\r\n'
            'Origin: https://' + self.host + '\r\n\r\n'
        ).encode('ascii')
        try:
            self._sock.sendall(request)
            response = bytearray()
            while not response.endswith(b'\r\n\r\n'):
                if len(response) >= 16384:
                    raise _NetProtocolError('Cloudflare returned oversized WebSocket headers')
                chunk = self._sock.recv(1)
                if not chunk:
                    raise _RelayConnectError(
                        'edge', 'Cloudflare closed the WebSocket handshake', transient=True)
                response.extend(chunk)
        except OSError as exc:
            self._abort()
            raise _RelayConnectError('edge', type(exc).__name__, transient=True) from exc
        except _NetProtocolError:
            self._abort()
            raise
        try:
            lines = bytes(response).decode('iso-8859-1').split('\r\n')
            status_match = re.fullmatch(r'HTTP/1\.[01] (\d{3})(?: .*)?', lines[0])
            if not status_match:
                raise ValueError('relay answered with something other than HTTP')
            status = int(status_match.group(1))
            if status != 101:
                # 5xx (including Cloudflare's 530/1033 "tunnel not connected")
                # is normal for a few seconds after a Quick Tunnel is created.
                raise _RelayConnectError(
                    'relay', f'WebSocket upgrade was rejected (HTTP {status})',
                    status=status, transient=(status >= 500 or status == 429))
            headers = {}
            if len(lines) > 128:
                raise ValueError('too many WebSocket response headers')
            for line in lines[1:]:
                if not line:
                    continue
                name, sep, value = line.partition(':')
                lower_name = name.strip().lower()
                if not sep or not lower_name:
                    raise ValueError('invalid WebSocket response headers')
                if lower_name in headers:
                    # Cloudflare repeats informational headers (Set-Cookie and
                    # similar). Merge those as HTTP allows; only the headers
                    # that prove the upgrade must appear exactly once.
                    if lower_name in ('upgrade', 'connection', 'sec-websocket-accept'):
                        raise ValueError('duplicate WebSocket upgrade header')
                    headers[lower_name] = headers[lower_name] + ', ' + value.strip()
                else:
                    headers[lower_name] = value.strip()
            expected = _base64_mod.b64encode(
                _hashlib.sha1((key + '258EAFA5-E914-47DA-95CA-C5AB0DC85B11').encode('ascii')).digest()
            ).decode('ascii')
            if (headers.get('upgrade', '').lower() != 'websocket'
                    or 'upgrade' not in [part.strip() for part in headers.get('connection', '').lower().split(',')]
                    or headers.get('sec-websocket-accept') != expected):
                raise ValueError('invalid WebSocket upgrade confirmation')
        except _RelayConnectError:
            self._abort()
            raise
        except (UnicodeError, ValueError) as exc:
            self._abort()
            raise _NetProtocolError(str(exc)) from exc
        self._closed = False

    def _abort(self):
        """Drop the socket without a WebSocket close frame (upgrade never completed)."""
        self._closed = True
        sock, self._sock = self._sock, None
        if sock is not None:
            try:
                sock.close()
            except OSError:
                pass

    def _read_exact(self, count):
        while len(self._socket_read_buffer) < count:
            chunk = self._sock.recv(max(4096, count - len(self._socket_read_buffer)))
            if not chunk:
                raise ConnectionError('WebSocket connection closed')
            self._socket_read_buffer.extend(chunk)
        result = bytes(self._socket_read_buffer[:count])
        del self._socket_read_buffer[:count]
        return result

    def _send_frame(self, payload, opcode, mask=True):
        payload = bytes(payload)
        first = 0x80 | (int(opcode) & 0x0f)
        mask_bit = 0x80 if mask else 0
        length = len(payload)
        if length < 126:
            header = bytes((first, mask_bit | length))
        elif length <= 65535:
            header = bytes((first, mask_bit | 126)) + struct.pack('!H', length)
        else:
            header = bytes((first, mask_bit | 127)) + struct.pack('!Q', length)
        if mask:
            mask_key = _secrets_mod.token_bytes(4)
            payload = bytes(value ^ mask_key[index & 3] for index, value in enumerate(payload))
            header += mask_key
        with self._write_lock:
            self._sock.sendall(header + payload)

    def _read_message(self):
        pieces = []
        total = 0
        message_opcode = None
        while not self._closed:
            first, second = self._read_exact(2)
            final = bool(first & 0x80)
            if first & 0x70:
                raise _NetProtocolError('WebSocket extensions are not enabled')
            opcode = first & 0x0f
            masked = bool(second & 0x80)
            length = second & 0x7f
            if masked:
                raise _NetProtocolError('server WebSocket frames must not be masked')
            if length == 126:
                length = struct.unpack('!H', self._read_exact(2))[0]
            elif length == 127:
                length = struct.unpack('!Q', self._read_exact(8))[0]
                if length >> 63:
                    raise _NetProtocolError('invalid WebSocket frame length')
            if opcode >= 8 and (not final or length > 125):
                raise _NetProtocolError('invalid WebSocket control frame')
            if length > self._MAX_MESSAGE or total + length > self._MAX_MESSAGE:
                raise _NetProtocolError('WebSocket message exceeds the SGF transport limit')
            payload = self._read_exact(length)
            if opcode == 8:
                try:
                    self._send_frame(payload[:125], 8)
                except OSError:
                    pass
                self._closed = True
                return b''
            if opcode == 9:
                self._send_frame(payload, 10)
                continue
            if opcode == 10:
                continue
            if opcode == 2:
                if message_opcode is not None:
                    raise _NetProtocolError('nested WebSocket data message')
                message_opcode = opcode
            elif opcode == 0:
                if message_opcode is None:
                    raise _NetProtocolError('unexpected WebSocket continuation frame')
            else:
                raise _NetProtocolError('only binary WebSocket messages are accepted')
            pieces.append(payload)
            total += length
            if final:
                return b''.join(pieces)
        return b''

    def recv(self, size):
        size = max(1, int(size))
        if not self._read_buffer:
            message = self._read_message()
            if not message:
                return b''
            self._read_buffer.extend(message)
        result = bytes(self._read_buffer[:size])
        del self._read_buffer[:size]
        return result

    def sendall(self, data):
        view = memoryview(data)
        for offset in range(0, len(view), 65536):
            self._send_frame(view[offset:offset + 65536], 2)

    def settimeout(self, timeout):
        self._timeout = timeout
        self._sock.settimeout(timeout)

    def gettimeout(self):
        return self._timeout

    def fileno(self):
        return self._sock.fileno()

    def pending(self):
        return bool(self._read_buffer) or bool(self._sock.pending())

    def shutdown(self, how):
        if self._closed:
            return
        try:
            self._send_frame(b'', 8)
        except OSError:
            pass
        try:
            self._sock.shutdown(how)
        except OSError:
            pass
        self._closed = True

    def close(self):
        if not self._closed:
            try:
                self._send_frame(b'', 8)
            except OSError:
                pass
            self._closed = True
        try:
            self._sock.close()
        except OSError:
            pass


class _PinnedTLSByteStream:
    """SGF TLS layer inside WSS, preserving host pinning through Cloudflare."""
    def __init__(self, transport, invite, timeout=8.0):
        fingerprint, self.join_token = _parse_network_invite(invite)
        self.transport = transport
        self._incoming = _ssl_mod.MemoryBIO()
        self._outgoing = _ssl_mod.MemoryBIO()
        self._ssl = _network_tls_client_context().wrap_bio(
            self._incoming, self._outgoing, server_hostname='sgf-host')
        self._timeout = timeout
        self.transport.settimeout(timeout)
        try:
            self._handshake()
            peer_cert = self._ssl.getpeercert(binary_form=True)
            actual = _hashlib.sha256(peer_cert).digest()
            if not _hmac_mod.compare_digest(actual, fingerprint):
                raise _NetProtocolError('host identity does not match the secure invite')
        except Exception:
            self.close()
            raise

    def _flush(self):
        while self._outgoing.pending:
            chunk = self._outgoing.read()
            if chunk:
                self.transport.sendall(chunk)

    def _feed(self):
        encrypted = self.transport.recv(65536)
        if not encrypted:
            self._incoming.write_eof()
            return False
        self._incoming.write(encrypted)
        return True

    def _handshake(self):
        while True:
            try:
                self._ssl.do_handshake()
                self._flush()
                return
            except _ssl_mod.SSLWantReadError:
                self._flush()
                if not self._feed():
                    raise ConnectionError('peer closed during secure handshake')
            except _ssl_mod.SSLWantWriteError:
                self._flush()

    def sendall(self, data):
        view = memoryview(data)
        offset = 0
        while offset < len(view):
            try:
                offset += self._ssl.write(view[offset:])
                self._flush()
            except _ssl_mod.SSLWantReadError:
                self._flush()
                if not self._feed():
                    raise ConnectionError('peer closed during secure write')
            except _ssl_mod.SSLWantWriteError:
                self._flush()

    def recv(self, size):
        while True:
            try:
                return self._ssl.read(max(1, int(size)))
            except _ssl_mod.SSLWantReadError:
                self._flush()
                if not self._feed():
                    return b''
            except _ssl_mod.SSLWantWriteError:
                self._flush()
            except _ssl_mod.SSLZeroReturnError:
                return b''

    def pending(self):
        return self._ssl.pending() or self._incoming.pending or self.transport.pending()

    def settimeout(self, timeout):
        self._timeout = timeout
        self.transport.settimeout(timeout)

    def gettimeout(self):
        return self._timeout

    def fileno(self):
        return self.transport.fileno()

    def shutdown(self, how):
        self.close()

    def close(self):
        try:
            self.transport.close()
        except OSError:
            pass


def _make_network_invite(fingerprint, token):
    if len(fingerprint) != 32 or len(token) != 32:
        raise ValueError('invalid secure invite material')
    encoded = _base64_mod.urlsafe_b64encode(fingerprint + token).decode('ascii').rstrip('=')
    return 'SGF1-' + encoded


def _parse_network_invite(invite):
    invite = ''.join(str(invite or '').split())
    if not invite.startswith('SGF1-'):
        raise ValueError('secure invite code is invalid')
    payload = invite[5:]
    if len(payload) != 86 or any(not (ch.isascii() and (ch.isalnum() or ch in '-_')) for ch in payload):
        raise ValueError('secure invite code is invalid')
    try:
        raw = _base64_mod.urlsafe_b64decode(payload + '=' * (-len(payload) % 4))
    except Exception as exc:
        raise ValueError('secure invite code is invalid') from exc
    if len(raw) != 64:
        raise ValueError('secure invite code is invalid')
    return raw[:32], raw[32:]


def _format_network_connection_info(host, port, invite):
    host = str(host or '').strip()
    port = int(port)
    if not host or not (1 <= port <= 65535):
        raise ValueError('invalid network connection information')
    host = host.strip('[]')
    shown_host = f'[{host.replace("%", "%25")}]' if ':' in host else host
    _parse_network_invite(invite)
    return f'sgf://{shown_host}:{port}/{invite}'


def _network_connection_info_ready(*, local_ip_done, local_ips,
                                   public_ip=None, relay_host=None, relay_port=None,
                                   relay_pending=False):
    """Only enable Copy once the clipboard value contains a usable endpoint.

    While a relay is still starting, the only copyable address would be a LAN or
    public-IP one that friends outside the network cannot reach, so Copy stays
    disabled until the relay is ready or has definitively failed.
    """
    if relay_pending:
        return False
    return bool((local_ip_done and local_ips) or public_ip or
                (relay_host and relay_port and 1 <= int(relay_port) <= 65535))


def _lookup_public_ip(timeout=2.5):
    """Best-effort public address discovery; this does not test inbound reachability."""
    import urllib.request as _urlrequest
    for endpoint in ('https://api6.ipify.org', 'https://api.ipify.org'):
        try:
            request = _urlrequest.Request(endpoint, headers={'User-Agent': 'SGF multiplayer'})
            with _urlrequest.urlopen(request, timeout=max(0.5, float(timeout))) as response:
                candidate = response.read(128).decode('ascii', 'strict').strip()
            address = _ipaddress_mod.ip_address(candidate)
            if address.is_global:
                return str(address)
        except Exception:
            continue
    return None


def _parse_network_connection_info(value):
    value = ''.join(str(value or '').split())
    if not value.lower().startswith('sgf://'):
        return None
    try:
        endpoint, invite = value[6:].split('/', 1)
        _parse_network_invite(invite)
        if endpoint.startswith('['):
            close = endpoint.find(']')
            if close < 0 or endpoint[close + 1:close + 2] != ':':
                raise ValueError('invalid network endpoint')
            host = endpoint[1:close].replace('%25', '%')
            port_text = endpoint[close + 2:]
        else:
            host, separator, port_text = endpoint.rpartition(':')
            if not separator:
                raise ValueError('invalid network endpoint')
        if not host or any(not (ch.isascii() and (ch.isalnum() or ch in '.:-%_')) for ch in host):
            raise ValueError('invalid network host')
        literal = host.split('%', 1)[0]
        try:
            parsed_address = _ipaddress_mod.ip_address(literal)
            if parsed_address.is_unspecified or parsed_address.is_multicast:
                raise ValueError('unspecified or multicast address cannot host a game')
            if parsed_address.version == 6 and parsed_address.is_link_local and '%' not in host:
                raise ValueError('link-local IPv6 address requires an interface scope')
        except ValueError as address_error:
            if str(address_error).startswith(('unspecified', 'link-local')):
                raise
            if ':' in host or '%' in host:
                raise ValueError('invalid IP address') from address_error
            if len(host) > 253 or any(not label or len(label) > 63 or label.startswith('-') or label.endswith('-')
                                      for label in host.split('.')):
                raise ValueError('invalid host name') from address_error
        port = int(port_text)
        if not (1 <= port <= 65535):
            raise ValueError('invalid network port')
        return host, port, invite
    except (TypeError, ValueError) as exc:
        raise ValueError('secure connection information is invalid') from exc


def _wrap_and_pin_network_client(sock, invite):
    fingerprint, token = _parse_network_invite(invite)
    tls_sock = _network_tls_client_context().wrap_socket(sock, server_hostname='sgf-host')
    peer_cert = tls_sock.getpeercert(binary_form=True)
    actual_fingerprint = _hashlib.sha256(peer_cert).digest()
    if not _hmac_mod.compare_digest(actual_fingerprint, fingerprint):
        tls_sock.close()
        raise _NetProtocolError('host identity does not match the secure invite')
    return tls_sock, token


def _describe_relay_failure(exc):
    """Short, secret-free description of a relay failure and its root cause."""
    parts = []
    seen = exc
    for _depth in range(3):
        if seen is None:
            break
        parts.append(f'{type(seen).__name__}: {str(seen)[:120]}')
        seen = seen.__cause__
    return ' <- '.join(parts) or 'unknown'


def _split_join_endpoint(text, default_port, game_port=None):
    """Split what the player typed in the address field into (host, port).

    Accepts ``host``, ``host:port``, ``1.2.3.4:port`` and ``[v6]:port``. A bare
    IPv6 literal (several colons, no brackets) is left alone. A Cloudflare relay
    hostname with no explicit port uses 443 (the tunnel's public port), never the
    local game port the tunnel forwards to.
    """
    value = str(text or '').strip()
    explicit = None
    host = value
    if value.startswith('['):
        close = value.find(']')
        if close > 0:
            host = value[1:close]
            rest = value[close + 1:]
            if rest.startswith(':') and rest[1:].isdigit():
                explicit = int(rest[1:])
    elif value.count(':') == 1:
        name, _sep, port_text = value.partition(':')
        if name and port_text.isdigit():
            host, explicit = name, int(port_text)
        elif name and not port_text:
            host = name
    if explicit is not None and not 1 <= explicit <= 65535:
        explicit = None
        host = value
    if explicit is not None:
        return host, explicit
    port = int(default_port)
    if _is_cloudflare_quick_hostname(host) and (game_port is None or port == int(game_port)):
        port = 443
    return host, port


def _open_cloudflare_transport(host, port, invite, timeout=8.0):
    """Create the WSS transport to a relay host (module level so tests can swap the edge)."""
    return _WebSocketByteStream(host, port, invite, timeout=timeout)


def _open_secure_peer_stream(host, port, invite_code, cancel_event=None, budget=30.0,
                             stage_sink=None):
    """Open an identity-pinned TLS stream to a host, directly or through the relay.

    Returns ``(stream, join_token)``. Relay hosts retry the transient failures a
    brand-new Quick Tunnel produces (DNS not propagated, HTTP 5xx/530) within
    ``budget`` seconds; permanent failures (wrong invite, pin mismatch) raise at
    once. ``stage_sink(code)`` receives short language-neutral failure stages.
    """
    def note(stage):
        if stage_sink is not None:
            stage_sink(stage)

    if not _is_cloudflare_quick_hostname(host):
        sock = _socket_mod.create_connection((host, port), timeout=6.0)
        sock.setsockopt(_socket_mod.IPPROTO_TCP, _socket_mod.TCP_NODELAY, 1)
        return _wrap_and_pin_network_client(sock, invite_code)

    deadline = time.monotonic() + float(budget)
    attempt = 0
    last_error = None
    last_stage = ''
    while True:
        attempt += 1
        try:
            transport = _open_cloudflare_transport(host, port, invite_code, timeout=8.0)
        except _RelayConnectError as exc:
            last_error = exc
            last_stage = exc.stage + (f' {exc.status}' if exc.status else '')
            note(last_stage)
            retry = exc.transient
        else:
            try:
                stream = _PinnedTLSByteStream(transport, invite_code, timeout=8.0)
                return stream, stream.join_token
            except _NetProtocolError as exc:
                # Wrong certificate means a different host answered: never retry.
                note('pin' if 'identity' in str(exc) else 'tls')
                raise
            except OSError as exc:
                # The relay carried us to the bridge but the host closed or
                # stalled during TLS (e.g. busy with another guest).
                last_error = exc
                last_stage = 'host'
                note(last_stage)
                retry = attempt < 3
                if not retry:
                    raise
        if (not retry or (cancel_event is not None and cancel_event.is_set())
                or time.monotonic() + 1.5 >= deadline):
            sgf_log.warning('Relay connection gave up (%s: %s)', last_stage,
                            _describe_relay_failure(last_error))
            raise _RelayConnectError(last_stage.split(' ', 1)[0] or 'edge', 'relay unavailable')
        sgf_log.info('Relay not reachable yet (%s: %s); retrying', last_stage,
                     _describe_relay_failure(last_error))
        wake = time.monotonic() + 1.5
        while time.monotonic() < wake:
            if cancel_event is not None and cancel_event.is_set():
                raise _RelayConnectError('edge', 'cancelled')
            time.sleep(0.1)


def _is_cloudflare_quick_hostname(host):
    value = str(host or '').strip().lower().rstrip('.')
    return value.endswith('.trycloudflare.com') and len(value) <= 253


def _authenticate_network_host(conn, expected_token):
    auth = _net_recv(conn)
    if not isinstance(auth, dict) or set(auth) != {'t', 'v', 'token'} or auth.get('t') != 'secure_auth':
        raise _NetProtocolError('secure session authentication required')
    supplied = auth.get('token')
    if not isinstance(supplied, str) or len(supplied) != 64 or any(ch not in '0123456789abcdef' for ch in supplied):
        raise _NetProtocolError('invalid secure session credential')
    if not _hmac_mod.compare_digest(supplied, expected_token.hex()):
        raise _NetProtocolError('secure session credential rejected')


def _new_resume_token():
    """Credential that lets a dropped guest rejoin the *same* match."""
    return _secrets_mod.token_bytes(32)


def _finish_secure_host_handshake(conn, tls_context, expected_token, mode,
                                  chosen_map, authoritative_seed, result_queue,
                                  cancel_event=None, result_lock=None, resume_token=None,
                                  max_players=2):
    """Finish peer TLS/authentication off the pygame thread."""
    if resume_token is None:
        resume_token = _new_resume_token()
    try:
        conn.settimeout(4.0)
        conn = tls_context.wrap_socket(conn, server_side=True)
        if cancel_event is not None and cancel_event.is_set():
            raise _NetProtocolError('host cancelled the pending handshake')
        _authenticate_network_host(conn, expected_token)
        if not _validate_net_map(chosen_map):
            raise _NetProtocolError('host map failed local validation')
        map_hash = _map_fingerprint(chosen_map)
        _net_send(conn, {
            't': 'hello',
            'mode': mode,
            'seed': authoritative_seed,
            'map': chosen_map,
            'map_hash': map_hash,
            'resume': resume_token.hex(),
            'max_players': int(max_players),
        })
        ack = _net_recv(conn)
        if not isinstance(ack, dict) or set(ack) != {'t', 'v', 'map_hash', 'seed'} or ack.get('t') != 'hello_ack':
            raise _NetProtocolError('invalid handshake acknowledgement')
        if (ack.get('map_hash') != map_hash or not isinstance(ack.get('seed'), str)
                or ack.get('seed') != str(authoritative_seed)):
            raise _NetProtocolError('client acknowledgement does not match the authoritative session')
        if cancel_event is not None and cancel_event.is_set():
            raise _NetProtocolError('host cancelled the pending handshake')
        conn.settimeout(15.0)
        if result_lock is None:
            if cancel_event is not None and cancel_event.is_set():
                raise _NetProtocolError('host cancelled the pending handshake')
            result_queue.put((True, conn))
        else:
            # Serialize publication against the UI's cancellation path. This
            # prevents a completed socket being queued just after cleanup ran.
            with result_lock:
                if cancel_event is not None and cancel_event.is_set():
                    raise _NetProtocolError('host cancelled the pending handshake')
                result_queue.put((True, conn))
    except Exception as exc:
        try:
            conn.close()
        except OSError:
            pass
        if result_lock is None:
            try:
                result_queue.put_nowait((False, str(exc)))
            except _queue_mod.Full:
                pass
        else:
            with result_lock:
                if cancel_event is not None and cancel_event.is_set():
                    return
                try:
                    result_queue.put_nowait((False, str(exc)))
                except _queue_mod.Full:
                    pass


def _secure_resume_exchange(conn, tls_context, tokens, cancel_event=None):
    """TLS + resume credential check. Returns (secure_conn, slot) or raises.

    ``tokens`` maps a slot number to the resume credential issued to that guest;
    the invite's join token is never accepted here.
    """
    conn.settimeout(4.0)
    conn = tls_context.wrap_socket(conn, server_side=True)
    request = _net_recv(conn)
    if (not isinstance(request, dict) or set(request) != {'t', 'v', 'token'}
            or request.get('t') != 'secure_resume'):
        raise _NetProtocolError('secure session resume required')
    supplied = request.get('token')
    if (not isinstance(supplied, str) or len(supplied) != 64
            or any(ch not in '0123456789abcdef' for ch in supplied)):
        raise _NetProtocolError('secure session resume credential rejected')
    matched = None
    for slot, token in tokens.items():
        # Compare against every credential so timing does not reveal which slot matched.
        if _hmac_mod.compare_digest(supplied, token.hex()):
            matched = slot
    if matched is None:
        raise _NetProtocolError('secure session resume credential rejected')
    if cancel_event is not None and cancel_event.is_set():
        raise _NetProtocolError('host stopped waiting for the guest')
    _net_send(conn, {'t': 'resumed'})
    conn.settimeout(15.0)
    return conn, matched


def _finish_secure_host_resume(conn, tls_context, resume_token, result_queue, cancel_event=None):
    """Re-admit the original guest of a two-player match (off the UI thread)."""
    try:
        secure, _slot = _secure_resume_exchange(conn, tls_context, {0: resume_token}, cancel_event)
        result_queue.put((True, secure))
    except Exception as exc:
        try:
            conn.close()
        except OSError:
            pass
        try:
            result_queue.put_nowait((False, str(exc)))
        except _queue_mod.Full:
            pass


def _finish_secure_host_resume_any(conn, tls_context, tokens, result_queue, cancel_event=None):
    """Multi-guest version: reports ``(True, connection, slot)`` for whoever came back."""
    try:
        secure, slot = _secure_resume_exchange(conn, tls_context, tokens, cancel_event)
        result_queue.put((True, secure, slot))
    except Exception as exc:
        try:
            conn.close()
        except OSError:
            pass
        try:
            result_queue.put_nowait((False, str(exc), None))
        except _queue_mod.Full:
            pass


def _valid_player_name(name):
    return (isinstance(name, str) and 1 <= len(name) <= 20
            and all(ch.isprintable() for ch in name))


def _clean_player_name(value, fallback):
    """Display name from an untrusted peer: printable, trimmed, at most 20 characters."""
    text = ''.join(ch for ch in str(value or '') if ch.isprintable()).strip()[:20]
    return text or fallback


def _validate_net_direction(direction):
    if not isinstance(direction, (list, tuple)) or len(direction) != 2:
        return False
    if any(type(v) is not int for v in direction):
        return False
    dx, dy = direction
    return (dx, dy) in ((1, 0), (-1, 0), (0, 1), (0, -1))


def _validate_net_cell(position, width=None, height=None):
    if not isinstance(position, (list, tuple)) or len(position) != 2:
        return False
    if any(type(v) is not int for v in position):
        return False
    x, y = position
    if width is not None and not (0 <= x < width):
        return False
    if height is not None and not (0 <= y < height):
        return False
    return True


def _validate_net_map(map_data):
    if map_data is None:
        return True
    if not isinstance(map_data, dict):
        return False
    bw = map_data.get('board_width', 0)
    bh = map_data.get('board_height', 0)
    if type(bw) is not int or type(bh) is not int:
        return False
    if not (5 <= bw <= 100 and 5 <= bh <= 100):
        return False
    obstacles = map_data.get('obstacles', [])
    if not isinstance(obstacles, list) or len(obstacles) > min(bw * bh, 5000):
        return False
    for pos in obstacles:
        if not isinstance(pos, (list, tuple)) or len(pos) != 2:
            return False
        if any(type(v) is not int for v in pos):
            return False
        x, y = pos
        if not (0 <= x < bw and 0 <= y < bh):
            return False
    portals = map_data.get('portals', [])
    if not isinstance(portals, list) or len(portals) > 100:
        return False
    for portal in portals:
        if not isinstance(portal, (list, tuple)) or len(portal) != 5:
            return False
        if any(type(v) is not int for v in portal):
            return False
        x1, y1, x2, y2, color_index = portal
        if not (0 <= x1 < bw and 0 <= x2 < bw and 0 <= y1 < bh and 0 <= y2 < bh):
            return False
        if color_index not in (0, 1):
            return False
    return True


def _validate_net_snapshot(snap):
    """Validate the replay snapshot shape before it can enter persistence."""
    if not isinstance(snap, (list, tuple)) or not (15 <= len(snap) <= 16):
        return False
    bw, bh = snap[12], snap[13]
    if type(bw) is not int or type(bh) is not int:
        return False
    if not (5 <= bw <= 100 and 5 <= bh <= 100):
        return False
    board_area = bw * bh
    for idx in (0, 1, 9):
        positions = snap[idx]
        if not isinstance(positions, list) or len(positions) > board_area:
            return False
        for pos in positions:
            if not _validate_net_cell(pos, bw, bh):
                return False
    if not _validate_net_direction(snap[2]) or not _validate_net_direction(snap[3]):
        return False
    if (not isinstance(snap[4], (int, float)) or isinstance(snap[4], bool)
            or not (0 <= snap[4] <= 1_000_000_000) or not math.isfinite(snap[4])):
        return False
    if (not isinstance(snap[5], (int, float)) or isinstance(snap[5], bool)
            or not (0 <= snap[5] <= 1_000_000_000) or not math.isfinite(snap[5])):
        return False
    if not isinstance(snap[6], bool) or not isinstance(snap[7], bool):
        return False
    if snap[8] is not None and not _validate_net_cell(snap[8], bw, bh):
        return False
    if not isinstance(snap[10], bool):
        return False
    if isinstance(snap[11], bool) or snap[11] not in (None, 1, 2, 'draw', 'coop_win', 'coop_lose'):
        return False
    if snap[14] not in ('1v1', 'coop'):
        return False
    return len(snap) < 16 or (
        isinstance(snap[15], str) and len(snap[15]) <= 32
        and snap[15] in _NET_SAFE_FRUIT_TYPES)


def _validate_net_state_message(msg):
    if not isinstance(msg, dict) or msg.get('t') != 'state':
        return False
    allowed = {
        't', 'v', 'p1', 'p2', 'f', 'ft', 's1', 's2', 'a1', 'a2',
        'go', 'pa', 'w', 'obs', 'bw', 'bh', 'cs', 'ox', 'oy', 'seed', 'snap',
    }
    required = {'t', 'v', 'p1', 'p2', 'obs', 'bw', 'bh'}
    if not required.issubset(msg) or not set(msg).issubset(allowed):
        return False
    bw, bh = msg.get('bw', 0), msg.get('bh', 0)
    if type(bw) is not int or type(bh) is not int:
        return False
    if 'cs' in msg and (type(msg['cs']) is not int or not (1 <= msg['cs'] <= 256)):
        return False
    for key in ('ox', 'oy'):
        if key in msg and (type(msg[key]) is not int or not (-16384 <= msg[key] <= 16384)):
            return False
    if 'seed' in msg and (not isinstance(msg['seed'], str) or len(msg['seed']) > 128):
        return False
    if 'ft' in msg and (not isinstance(msg['ft'], str) or len(msg['ft']) > 64):
        return False
    if not (5 <= bw <= 100 and 5 <= bh <= 100):
        return False
    board_area = bw * bh
    for key in ('p1', 'p2', 'obs'):
        if not isinstance(msg.get(key, []), list) or len(msg.get(key, [])) > board_area:
            return False
        for pos in msg.get(key, []):
            if not _validate_net_cell(pos, bw, bh):
                return False
    if msg.get('f') is not None and not _validate_net_cell(msg.get('f'), bw, bh):
        return False
    snap = msg.get('snap')
    if snap is not None and not _validate_net_snapshot(snap):
        return False
    if msg.get('ft') is not None and (
            not isinstance(msg.get('ft'), str) or len(msg['ft']) > 32
            or msg['ft'] not in _NET_SAFE_FRUIT_TYPES):
        return False
    if not isinstance(msg.get('a1', True), bool) or not isinstance(msg.get('a2', True), bool):
        return False
    if not isinstance(msg.get('go', False), bool):
        return False
    if not isinstance(msg.get('pa', False), bool):
        return False
    if isinstance(msg.get('w'), bool) or msg.get('w') not in (None, 1, 2, 'draw', 'coop_win', 'coop_lose'):
        return False
    for score_key in ('s1', 's2'):
        score = msg.get(score_key, 0)
        if (not isinstance(score, (int, float)) or isinstance(score, bool)
                or not (0 <= score <= 1_000_000_000) or not math.isfinite(score)):
            return False
    return True


def _validate_net_session_message(msg, receiver_is_host):
    """Reject unknown or oversized-in-shape peer messages before queueing."""
    if not isinstance(msg, dict):
        return False
    msg_type = msg.get('t')
    if msg_type == 'bye':
        return set(msg) == {'t', 'v'}
    if receiver_is_host:
        if msg_type in ('pause_req', 'resume_req', 'restart_req'):
            return set(msg) == {'t', 'v'}
        if msg_type == 'input':
            return set(msg) == {'t', 'v', 'd'} and _validate_net_direction(msg.get('d'))
        if msg_type == 'ping':
            return (set(msg) == {'t', 'v', 'n'} and type(msg.get('n')) is int
                    and 0 <= msg['n'] < 2 ** 31)
        if msg_type == 'profile':
            return set(msg) == {'t', 'v', 'name'} and _valid_player_name(msg.get('name'))
        return False
    if msg_type == 'lobby':
        names = msg.get('names')
        return (set(msg) == {'t', 'v', 'names', 'you', 'max'}
                and isinstance(names, list) and 2 <= len(names) <= 4
                and all(_valid_player_name(name) for name in names)
                and type(msg.get('you')) is int and 1 <= msg['you'] <= 3
                and type(msg.get('max')) is int and 2 <= msg['max'] <= 4)
    if msg_type == 'nstart':
        names = msg.get('names')
        return (set(msg) == {'t', 'v', 'count', 'you', 'names'}
                and type(msg.get('count')) is int and 2 <= msg['count'] <= 4
                and type(msg.get('you')) is int and 1 <= msg['you'] < msg['count']
                and isinstance(names, list) and len(names) == msg['count']
                and all(_valid_player_name(name) for name in names))
    if msg_type == 'nstate':
        status = msg.get('st')
        return (set(msg) == {'t', 'v', 'snap', 'pa', 'st'}
                and isinstance(msg.get('snap'), dict) and isinstance(msg.get('pa'), bool)
                and isinstance(status, list) and 2 <= len(status) <= 4
                and all(item in ('ok', 'wait', 'left') for item in status))
    if msg_type == 'pong':
        return (set(msg) == {'t', 'v', 'n'} and type(msg.get('n')) is int
                and 0 <= msg['n'] < 2 ** 31)
    if msg_type == 'state':
        return _validate_net_state_message(msg)
    if msg_type == 'lan_leaderboard':
        return _validate_lan_leaderboard_message(msg)
    if msg_type == 'restart':
        return set(msg) == {'t', 'v'}
    return False


def _clean_lan_score_entry(entry):
    """Return the small, display-only subset allowed in a LAN leaderboard."""
    if not isinstance(entry, dict):
        return None
    game_id = entry.get('game_id')
    name = entry.get('name')
    score = entry.get('score')
    date = entry.get('date', '')
    mode = entry.get('mp_mode', '1v1')
    if (not isinstance(game_id, str) or not game_id or len(game_id) > 64
            or not isinstance(name, str) or not name.strip() or len(name) > 96
            or isinstance(score, bool) or not isinstance(score, (int, float))
            or not (0 <= score <= 1_000_000_000) or not math.isfinite(score)
            or not isinstance(date, str) or len(date) > 32
            or mode not in ('1v1', 'coop')):
        return None
    return {'game_id': game_id, 'name': name[:96], 'score': int(score),
            'date': date, 'mp_mode': mode}


def _lan_entries_for_match(entry):
    """Make player-level 1v1 results or one shared cooperative result."""
    if not isinstance(entry, dict) or entry.get('mp_source') != 'lan_host':
        return []
    game_id = entry.get('game_id')
    mode = entry.get('mp_mode')
    date = entry.get('date', '')
    if not isinstance(game_id, str) or not game_id or len(game_id) > 61:
        return []
    if mode == '1v1':
        candidates = [
            {'game_id': f'{game_id}-p1', 'name': entry.get('p1_name'),
             'score': entry.get('p1_score'), 'date': date, 'mp_mode': mode},
            {'game_id': f'{game_id}-p2', 'name': entry.get('p2_name'),
             'score': entry.get('p2_score'), 'date': date, 'mp_mode': mode},
        ]
    elif mode == 'coop':
        candidates = [{
            'game_id': game_id, 'name': entry.get('name'),
            'score': entry.get('score'), 'date': date, 'mp_mode': mode,
        }]
    else:
        return []
    return [safe for item in candidates if (safe := _clean_lan_score_entry(item)) is not None]


def _validate_lan_leaderboard_message(msg):
    if (not isinstance(msg, dict) or set(msg) != {'t', 'v', 'entries'}
            or msg.get('t') != 'lan_leaderboard'
            or type(msg.get('v')) is not int or msg.get('v') != NET_PROTOCOL_VERSION):
        return False
    entries = msg.get('entries')
    return (isinstance(entries, list) and len(entries) <= 100
            and all(_clean_lan_score_entry(entry) is not None for entry in entries))


def _merge_lan_leaderboard(entries):
    """Merge a verified host snapshot into this profile's bounded LAN board."""
    cleaned = [_clean_lan_score_entry(entry) for entry in entries if isinstance(entry, dict)]
    cleaned = [entry for entry in cleaned if entry is not None]
    if len(cleaned) != len(entries):
        return False
    def mutate(data):
        current = data.get('lan_leaderboard', [])
        if not isinstance(current, list):
            current = []
        merged = {}
        for item in current + cleaned:
            safe = _clean_lan_score_entry(item)
            if safe:
                merged[safe['game_id']] = safe
        data['lan_leaderboard'] = sorted(
            merged.values(), key=lambda item: (item['score'], item['date']), reverse=True)[:100]
        _sync_active_profile_snapshot(data)
        return data
    return _save_data_async(mutate)


def _lan_leaderboard_snapshot():
    data = _load_data()
    entries = data.get('lan_leaderboard', []) if isinstance(data, dict) else []
    return [_clean_lan_score_entry(item) for item in entries[:100]
            if _clean_lan_score_entry(item) is not None] if isinstance(entries, list) else []


def _net_send(sock, msg):
    """Send one length-prefixed JSON message, enforcing the SGF wire limit."""
    if not isinstance(msg, dict):
        raise TypeError('network messages must be dicts')
    wire = dict(msg)
    wire['v'] = NET_PROTOCOL_VERSION
    data = json.dumps(wire, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
    if len(data) > NET_MAX_FRAME:
        raise _NetProtocolError(f'outgoing frame exceeds {NET_MAX_FRAME} bytes')
    sock.sendall(struct.pack('!I', len(data)) + data)


def _net_recv(sock, max_frame=None):
    """Receive one framed message.

    Clean EOF returns None. Malformed framing/JSON/version is a protocol error
    so callers can distinguish remote bad input from an expected disconnect.
    """
    original_timeout = sock.gettimeout()
    deadline = time.monotonic() + original_timeout if original_timeout is not None else None

    def _exact(n):
        buf = bytearray()
        while len(buf) < n:
            if deadline is not None:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise _socket_mod.timeout('network frame deadline exceeded')
                pending = getattr(sock, 'pending', lambda: 0)()
                if not pending and not _select_mod.select([sock], [], [], remaining)[0]:
                    raise _socket_mod.timeout('network frame deadline exceeded')
            chunk = sock.recv(n - len(buf))
            if not chunk:
                return None
            buf.extend(chunk)
        return bytes(buf)

    raw_len = _exact(4)
    if raw_len is None:
        return None
    length = struct.unpack('!I', raw_len)[0]
    frame_limit = NET_MAX_FRAME if max_frame is None else min(NET_MAX_FRAME, max(1, int(max_frame)))
    if length <= 0 or length > frame_limit:
        raise _NetProtocolError(f'invalid frame length: {length}')
    data = _exact(length)
    if data is None:
        return None
    def _reject_constant(value):
        raise ValueError(f'non-standard JSON constant: {value}')

    def _unique_object(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise ValueError(f'duplicate JSON key: {key}')
            result[key] = value
        return result

    try:
        msg = json.loads(
            data.decode('utf-8'),
            parse_constant=_reject_constant,
            object_pairs_hook=_unique_object,
        )
    except (json.JSONDecodeError, UnicodeDecodeError, ValueError, RecursionError) as exc:
        raise _NetProtocolError(f'malformed JSON payload: {exc}') from exc
    if not isinstance(msg, dict):
        raise _NetProtocolError('network payload must be a JSON object')
    version = msg.get('v')
    if type(version) is not int or version != NET_PROTOCOL_VERSION:
        raise _NetProtocolError(f'unsupported protocol version: {version!r}')
    return msg

def _get_local_ips():
    """Return usable assigned LAN addresses, including IPv6 where available."""
    candidates = []
    # Native Windows interface metadata gives us the prefix, so IPv4 network
    # and broadcast addresses (for example 192.168.0.0/24) are never advertised.
    if sys.platform == 'win32':
        try:
            result = subprocess.run(
                ['powershell', '-NoProfile', '-Command',
                 "$up = @(Get-NetAdapter -ErrorAction SilentlyContinue | Where-Object Status -eq 'Up' | "
                 "Select-Object -ExpandProperty InterfaceIndex); "
                 "Get-NetIPAddress -AddressState Preferred -ErrorAction SilentlyContinue | "
                 "Where-Object { $up -contains $_.InterfaceIndex } | "
                 "Select-Object IPAddress,PrefixLength,AddressFamily,InterfaceIndex | ConvertTo-Json -Compress"],
                capture_output=True, text=True, timeout=3, check=False)
            rows = json.loads(result.stdout) if result.returncode == 0 and result.stdout.strip() else []
            if isinstance(rows, dict):
                rows = [rows]
            for row in rows if isinstance(rows, list) else []:
                if isinstance(row, dict) and row.get('IPAddress'):
                    candidates.append((str(row['IPAddress']), row.get('PrefixLength')))
        except Exception:
            pass
    # Optional interface enumeration on other platforms and Windows installs
    # without PowerShell networking cmdlets.
    if not candidates:
        try:
            import psutil as _psutil_mod
            _if_stats = _psutil_mod.net_if_stats()
            for _if_name, addresses in _psutil_mod.net_if_addrs().items():
                _state = _if_stats.get(_if_name)
                if _state is not None and not _state.isup:
                    continue
                for address in addresses:
                    if address.family in (_socket_mod.AF_INET, _socket_mod.AF_INET6):
                        candidates.append((address.address, address.netmask))
        except Exception:
            pass
    # Route probes also discover USB tethering and Bluetooth PAN interfaces,
    # because the OS chooses the source address for each route.
    for target, family in (
            ('8.8.8.8', _socket_mod.AF_INET), ('192.168.0.1', _socket_mod.AF_INET),
            ('10.0.0.1', _socket_mod.AF_INET), ('2001:4860:4860::8888', _socket_mod.AF_INET6)):
        s = None
        try:
            s = _socket_mod.socket(family, _socket_mod.SOCK_DGRAM)
            endpoint = (target, 80, 0, 0) if family == _socket_mod.AF_INET6 else (target, 80)
            s.connect(endpoint)
            source = s.getsockname()
            candidates.append((source[0] + (('%' + str(source[3]))
                                  if family == _socket_mod.AF_INET6 and len(source) > 3 and source[3] else ''), None))
        except Exception:
            pass
        finally:
            if s is not None:
                try:
                    s.close()
                except OSError:
                    pass
    # Method 2: hostname resolution
    try:
        for info in _socket_mod.getaddrinfo(_socket_mod.gethostname(), None,
                                            type=_socket_mod.SOCK_STREAM):
            source = info[4]
            candidates.append((source[0] + (('%' + str(source[3]))
                                  if info[0] == _socket_mod.AF_INET6 and len(source) > 3 and source[3] else ''), None))
    except Exception:
        pass
    seen = set()
    ipv4, ipv6 = [], []
    for raw_ip, prefix in candidates:
        raw_ip = str(raw_ip).split('%', 2)[0] + (('%' + str(raw_ip).split('%', 2)[1])
                   if '%' in str(raw_ip) else '')
        normalized = _usable_advertised_ip(raw_ip, prefix)
        if normalized is None:
            continue
        address = _ipaddress_mod.ip_address(normalized.split('%', 1)[0])
        value = normalized
        if value in seen:
            continue
        seen.add(value)
        (ipv4 if address.version == 4 else ipv6).append(value)
    return ipv4 + ipv6


def _usable_advertised_ip(raw_ip, prefix=None):
    """Normalize a candidate address and reject unusable interface endpoints.

    IPv4 network/broadcast exclusions do not apply to IPv6 (which has no
    broadcast address), or to IPv4 point-to-point /31 and host /32 prefixes.
    """
    raw_ip = str(raw_ip or '').strip()
    address_text, separator, scope = raw_ip.partition('%')
    try:
        address = _ipaddress_mod.ip_address(address_text)
    except ValueError:
        return None
    if address.is_unspecified or address.is_loopback or address.is_multicast:
        return None
    if address.version == 6 and address.is_link_local and not scope:
        return None
    if prefix is not None:
        try:
            prefix_length = int(prefix)
            network = _ipaddress_mod.ip_network(f'{address}/{prefix_length}', strict=False)
            if address.version == 4 and prefix_length <= 30 and address in (
                    network.network_address, network.broadcast_address):
                return None
        except (TypeError, ValueError):
            pass
    elif (address.version == 4 and
          int(address_text.split('.')[-1]) in (0, 255)):
        return None
    return str(address) + (('%' + scope) if separator else '')


def _create_network_listener_sockets(port):
    """Bind IPv4 and IPv6 on one port, preferring a single dual-stack socket."""
    listeners = []
    dual_stack = False
    try:
        v6 = _socket_mod.socket(_socket_mod.AF_INET6, _socket_mod.SOCK_STREAM)
        v6.setsockopt(_socket_mod.SOL_SOCKET, _socket_mod.SO_REUSEADDR, 1)
        v6.setsockopt(_socket_mod.IPPROTO_IPV6, _socket_mod.IPV6_V6ONLY, 0)
        v6.bind(('::', int(port)))
        v6.listen(1)
        v6.setblocking(False)
        listeners.append(v6)
        dual_stack = True
    except OSError:
        try:
            v6.close()
        except Exception:
            pass
        try:
            v6 = _socket_mod.socket(_socket_mod.AF_INET6, _socket_mod.SOCK_STREAM)
            v6.setsockopt(_socket_mod.SOL_SOCKET, _socket_mod.SO_REUSEADDR, 1)
            v6.setsockopt(_socket_mod.IPPROTO_IPV6, _socket_mod.IPV6_V6ONLY, 1)
            v6.bind(('::', int(port)))
            v6.listen(1)
            v6.setblocking(False)
            listeners.append(v6)
        except OSError:
            try:
                v6.close()
            except Exception:
                pass
    if not dual_stack:
        try:
            v4 = _socket_mod.socket(_socket_mod.AF_INET, _socket_mod.SOCK_STREAM)
            v4.setsockopt(_socket_mod.SOL_SOCKET, _socket_mod.SO_REUSEADDR, 1)
            v4.bind(('0.0.0.0', int(port)))
            v4.listen(1)
            v4.setblocking(False)
            listeners.append(v4)
        except OSError:
            try:
                v4.close()
            except Exception:
                pass
    if not listeners:
        raise OSError('No IPv4 or IPv6 network listener could be opened.')
    return listeners


