    def _tutorial_reset_game(self):
        self._tutorial_snake = [(2, 3), (1, 3), (0, 3)]
        self._tutorial_direction = (1, 0)
        self._tutorial_fruit = (5, 3)
        self._tutorial_score = 0
        self._tutorial_move_elapsed = 0.0

    def _tutorial_step_game(self):
        dx, dy = self._tutorial_direction
        head = (self._tutorial_snake[0][0] + dx, self._tutorial_snake[0][1] + dy)
        growing = head == self._tutorial_fruit
        occupied = self._tutorial_snake if growing else self._tutorial_snake[:-1]
        if not (0 <= head[0] < 7 and 0 <= head[1] < 7) or head in occupied:
            self._tutorial_reset_game()
            return
        self._tutorial_snake.insert(0, head)
        if growing:
            self._tutorial_score += 1
            free = [(x, y) for y in range(7) for x in range(7)
                    if (x, y) not in self._tutorial_snake]
            self._tutorial_fruit = self._tutorial_rng.choice(free) if free else (5, 3)
        else:
            self._tutorial_snake.pop()
    
    def draw_tutorial(self, manage_transition=True):
        """Draw the tutorial screen with animations and interactive elements"""
        # Fill background
        self.screen.fill(COLORS['dark_blue'])
        
        reduced_motion = globals().get('_ACCESSIBILITY_REDUCED_MOTION', False)
        if reduced_motion:
            self.highlight_value = 0.0
            self.portal_pulse = 0.0
        else:
            self.highlight_value += 0.03 * self.highlight_direction
            if self.highlight_value >= 1.0:
                self.highlight_value = 1.0
                self.highlight_direction = -1
            elif self.highlight_value <= 0.0:
                self.highlight_value = 0.0
                self.highlight_direction = 1

            self.portal_pulse += 0.05 * self.portal_pulse_dir
            if self.portal_pulse >= 1.0:
                self.portal_pulse = 1.0
                self.portal_pulse_dir = -1
            elif self.portal_pulse <= 0.0:
                self.portal_pulse = 0.0
                self.portal_pulse_dir = 1
        
        # Compute responsive layout dimensions once for all pages
        _sw = self.screen.get_width()
        _sh = self.screen.get_height()
        _ref = min(_sw, _sh)
        _title_y = int(_sh * 0.07)
        _heading_y = int(_sh * 0.175)
        _content_y = int(_sh * 0.26)
        _line_gap = max(30, int(_sh * 0.055))
