    def draw_menu(self):
        """Draw the main menu with animations and effects. Layout is rebuilt only
        when the window size or language changes; everything else is cached."""
        _pump_audio()
        frame_start = time.perf_counter()
        scr = self.screen
        scr.fill(COLORS['dark_blue'])

        # Draw animated background particles
        self.update_particles()
        self.draw_particles()

        sig = (scr.get_width(), scr.get_height(), self.settings.language)
        if sig != self._menu_sig:
            self._menu_sig = sig
            self._build_menu()
        self.ui.language = self.settings.language
        self.ui.update(self._dt)
        self.ui.draw(scr)

        # Apply transition effect if in transition
        if self.transition_alpha > 0:
            if self.transition_surface.get_size() != scr.get_size():
                self.transition_surface = pygame.Surface(scr.get_size())
                self.transition_surface.fill((0, 0, 0))
            self.transition_surface.set_alpha(self.transition_alpha)
            scr.blit(self.transition_surface, (0, 0))

            # Update transition alpha
            if self.transition_in:
                self.transition_alpha = max(0, self.transition_alpha - self.transition_speed)
            else:
                self.transition_alpha = min(255, self.transition_alpha + self.transition_speed)

        if DEV_TOOLS.unlocked and DEV_TOOLS.modified:
            DEV_TOOLS.draw_dev_indicator(scr)

        # Draw achievement notifications (before the flip so they are actually visible)
        if getattr(self, 'achievement_manager', None):
            self.achievement_manager.draw_notification(scr, scr.get_width(), scr.get_height(), self.settings.language)

        # Update display
        _legacy_nav_draw(locals().get('self'))
        pygame.display.flip()
        render_ms = (time.perf_counter() - frame_start) * 1000.0
        DEV_TOOLS.telemetry.record_frame(
            max(self._dt * 1000.0, render_ms), render_ms=render_ms, ui_ms=render_ms)

    def menu_screenshot_layout(self):
        """(mode, {key: rect}) of the last layout solve - used by the reproducible UI checks."""
        res = self._menu_flow
        return res.mode, {k: self._menu_widgets[k].rect.copy() for k in self._menu_order}

    def show_credits(self):
        """Display credits screen"""
        running = True
        credits_clock = pygame.time.Clock()
        
        while running:
            _pump_audio()
            # Fill background
            self.screen.fill(COLORS['dark_blue'])
            
            # Get screen dimensions for responsive layout
            screen_width = self.screen.get_width()
            screen_height = self.screen.get_height()
            center_x = screen_width // 2
            
            # Draw title
            _ref = min(screen_width, screen_height)
            title_font = get_font(self.settings.language, 'bold', max(28, min(52, int(_ref * 0.08))))
            title_text = title_font.render("Credits", True, COLORS['white'])
            self.screen.blit(title_text, (center_x - title_text.get_width() // 2, int(screen_height * 0.13)))
            
            # Draw credits content
            content_font = get_font(self.settings.language, 'regular', max(16, min(26, int(_ref * 0.04))))
            content_y = int(screen_height * 0.30)
            line_spacing = max(30, int(screen_height * 0.06))
            
            wakipiki_text = content_font.render(
                "Original game concept by Wakipiki", True, COLORS['yellow'])
            self.screen.blit(wakipiki_text,
                (center_x - wakipiki_text.get_width() // 2, content_y))
            replit_text = content_font.render(
                "Enhanced and developed on Replit", True, COLORS['light_blue'])
            self.screen.blit(replit_text,
                (center_x - replit_text.get_width() // 2, content_y + line_spacing))
            replit_detail_text = content_font.render(
                "The ultimate platform for creating and sharing software",
                True, COLORS['white'])
            self.screen.blit(replit_detail_text,
                (center_x - replit_detail_text.get_width() // 2,
                 content_y + line_spacing * 2))
            claude_text = content_font.render(
                "AI-assisted development by Claude (Anthropic)",
                True, COLORS['light_blue'])
            self.screen.blit(claude_text,
                (center_x - claude_text.get_width() // 2,
                 content_y + line_spacing * 3))
            codex_text = render_fit(
                content_font,
                get_text(self.settings.language, 'credits_codex_assist'),
                COLORS['light_blue'], max(1, screen_width - 40))
            self.screen.blit(codex_text,
                (center_x - codex_text.get_width() // 2,
                 content_y + line_spacing * 4))
            
            # Back button
            back_button_y = content_y + line_spacing * 6
