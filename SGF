    def run(self, seed=None, transport=None):
        """Show mode → host/join flow. Returns (is_host, conn, mode, map, seed)."""
        self._pending_tunnel_session = None
        self._pending_session = None
        if transport in ('network', 'lan'):
            self.transport = transport
        self._seed = seed if seed else generate_seed()
        net_mode = self._pick_mode()
        if net_mode is None:
            return None
        while True:
            choice = self._pick_host_join()
            if choice is None:
                return None
            elif choice == 'host':
                room_size = self._pick_player_count()
                if room_size is None:
                    continue
                result = self._host_flow(net_mode, self._seed, room_size)
                if result:
                    return result
            elif choice == 'join':
                result = self._join_flow(net_mode, self._seed)
                if result:
                    return result

