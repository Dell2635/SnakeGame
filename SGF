def get_text(language_code, key):
    """Get text in the specified language"""
    # Get the language dictionary
    lang_dict = TRANSLATIONS.get(language_code, TRANSLATIONS['en'])
    
    # Return the text for the key, or fallback to English
    return lang_dict.get(key, TRANSLATIONS['en'].get(key, f"[Missing: {key}]"))

def load_custom_translations():
    """Load additional translations from a file"""
    try:
        if os.path.exists('snake_translations.json'):
            with open('snake_translations.json', 'r', encoding='utf-8') as f:
                custom_translations = json.load(f)
                
                # Merge custom translations with default ones
                for lang_code, translations in custom_translations.items():
                    if lang_code not in TRANSLATIONS:
                        TRANSLATIONS[lang_code] = {}
                    
                    for key, text in translations.items():
                        TRANSLATIONS[lang_code][key] = text
    except (json.JSONDecodeError, FileNotFoundError, IOError) as e:
        print(f"Error loading custom translations: {e}")

