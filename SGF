        relay_edge = _socket_mod.socket(_socket_mod.AF_INET, _socket_mod.SOCK_STREAM)
        relay_edge.bind(('127.0.0.1', 0)); relay_edge.listen(8)
        relay_edge_state = {'attempts': 0, 'fail_first': 1, 'target': relay_bridge}
        def _relay_edge_connection(raw_peer):
            try:
                peer = tls_server_context.wrap_socket(raw_peer, server_side=True)
                request = bytearray()
                while not request.endswith(b'\r\n\r\n'):
                    chunk = peer.recv(1)
                    if not chunk:
                        return
                    request.extend(chunk)
                relay_edge_state['attempts'] += 1
                assert b'Host: ' in request and b':443' not in request.split(b'Host: ')[1].split(b'\r\n')[0] \
                    or relay_edge_state.get('nondefault_port')
                if relay_edge_state['attempts'] <= relay_edge_state['fail_first']:
                    peer.sendall(b'HTTP/1.1 530 \r\nContent-Length: 0\r\n\r\n')
                    peer.close()
                    return
                first_line, _sep, remainder = bytes(request).partition(b'\r\n')
