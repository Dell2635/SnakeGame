class NetworkLobbyScreen:
    """UI for LAN host/join setup. Returns (is_host, conn, mode) or None."""

    PORT = 12345

    def __init__(self, settings, screen):
        self.settings = settings
        self.screen   = screen

    # ── public entry-point ───────────────────────────────────────────────

    def run(self):
        """Show mode → host/join flow. Returns (is_host, conn, mode) or None."""
        net_mode = self._pick_mode()
        if net_mode is None:
            return None
        while True:
            choice = self._pick_host_join()
            if choice is None:
                return None
            elif choice == 'host':
                result = self._host_flow(net_mode)
                if result:
                    return result
            elif choice == 'join':
                result = self._join_flow(net_mode)
                if result:
                    return result

    # ── internal screens ────────────────────────────────────────────────

    def _draw_bg(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        self.screen.fill(COLORS['dark_blue'])
        t = pygame.time.get_ticks() / 1000.0
        for i in range(20):
            px = int(sw * ((i * 137) % 100) / 100)
            py = int(sh * ((i * 97 + t * 12) % 100) / 100)
            pygame.draw.circle(self.screen, (35, 55, 115), (px, py), 2)

    def _mk_btn(self, rect, label, base_col, mp, font):
        col = tuple(min(255, c + 30) for c in base_col) if rect.collidepoint(mp) else base_col
        pygame.draw.rect(self.screen, col, rect, border_radius=10)
        pygame.draw.rect(self.screen, (180, 210, 255), rect, width=1, border_radius=10)
        s = font.render(label, True, COLORS['white'])
        self.screen.blit(s, (rect.centerx - s.get_width() // 2,
                              rect.centery - s.get_height() // 2))

    def _pick_mode(self):
        """Choose Co-op or 1v1. Returns '1v1', 'coop', or None."""
        clock = pygame.time.Clock()
        mf = get_font(self.settings.language, 'bold',    26)
        sf = get_font(self.settings.language, 'regular', 16)
        while True:
            sw, sh = self.screen.get_width(), self.screen.get_height()
            self._draw_bg()
            ts = mf.render("Network Multiplayer — Choose Mode", True, COLORS['white'])
            self.screen.blit(ts, (sw // 2 - ts.get_width() // 2, int(sh * 0.12)))

            d1 = sf.render("Co-op: Both players work together against the game", True, (160, 240, 160))
            d2 = sf.render("1v1:   Compete head-to-head over the network",       True, (255, 180, 180))
            self.screen.blit(d1, (sw // 2 - d1.get_width() // 2, int(sh * 0.32)))
            self.screen.blit(d2, (sw // 2 - d2.get_width() // 2, int(sh * 0.40)))

            bw, bh = 200, 50
            coop_r = pygame.Rect(sw // 2 - bw - 12, int(sh * 0.54), bw, bh)
            v1_r   = pygame.Rect(sw // 2 + 12,       int(sh * 0.54), bw, bh)
            back_r = pygame.Rect(sw // 2 - bw // 2,  int(sh * 0.70), bw, bh)
            mp = pygame.mouse.get_pos()
            self._mk_btn(coop_r, "Co-op",  (25, 110, 65),  mp, mf)
            self._mk_btn(v1_r,   "1v1",    (130, 35, 35),  mp, mf)
            self._mk_btn(back_r, "Back",   (55,  65, 110), mp, mf)
            pygame.display.flip(); clock.tick(60)

            for event in pygame.event.get():
                if event.type == pygame.QUIT:               pygame.quit(); sys.exit()
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_ESCAPE:        return None
                elif event.type == pygame.MOUSEBUTTONDOWN:
                    if   coop_r.collidepoint(event.pos):    return 'coop'
                    elif v1_r.collidepoint(event.pos):      return '1v1'
                    elif back_r.collidepoint(event.pos):    return None
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)

    def _pick_host_join(self):
        """Choose Host or Join. Returns 'host', 'join', or None."""
        clock = pygame.time.Clock()
        mf = get_font(self.settings.language, 'bold',    26)
        sf = get_font(self.settings.language, 'regular', 15)
        while True:
            sw, sh = self.screen.get_width(), self.screen.get_height()
            self._draw_bg()
            ts = mf.render("Network Multiplayer", True, COLORS['white'])
            self.screen.blit(ts, (sw // 2 - ts.get_width() // 2, int(sh * 0.10)))

            for i, line in enumerate([
                "Host:  Start a game and share your IP address with the other player.",
                "Join:  Enter the host's IP address to connect and play."
            ]):
                s = sf.render(line, True, (200, 220, 255))
                self.screen.blit(s, (sw // 2 - s.get_width() // 2, int(sh * 0.30) + i * 28))

            bw, bh = 200, 52
            host_r = pygame.Rect(sw // 2 - bw - 12, int(sh * 0.50), bw, bh)
            join_r = pygame.Rect(sw // 2 + 12,       int(sh * 0.50), bw, bh)
            back_r = pygame.Rect(sw // 2 - bw // 2,  int(sh * 0.66), bw, bh)
            mp = pygame.mouse.get_pos()
            self._mk_btn(host_r, "Host Game",  (20, 100, 160), mp, mf)
            self._mk_btn(join_r, "Join Game",  (100, 60, 20),  mp, mf)
            self._mk_btn(back_r, "Back",       (55,  65, 110), mp, mf)
            pygame.display.flip(); clock.tick(60)

            for event in pygame.event.get():
                if event.type == pygame.QUIT:               pygame.quit(); sys.exit()
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_ESCAPE:        return None
                elif event.type == pygame.MOUSEBUTTONDOWN:
                    if   host_r.collidepoint(event.pos):    return 'host'
                    elif join_r.collidepoint(event.pos):    return 'join'
                    elif back_r.collidepoint(event.pos):    return None
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)

    def _host_flow(self, mode):
        """Listen for one client. Returns (True, conn, mode) or None on cancel."""
        clock = pygame.time.Clock()
        mf = get_font(self.settings.language, 'bold',    22)
        sf = get_font(self.settings.language, 'regular', 15)

        local_ips = _get_local_ips()
        srv = None
        try:
            srv = _socket_mod.socket(_socket_mod.AF_INET, _socket_mod.SOCK_STREAM)
            srv.setsockopt(_socket_mod.SOL_SOCKET, _socket_mod.SO_REUSEADDR, 1)
            srv.bind(('0.0.0.0', self.PORT))
            srv.listen(1)
            srv.settimeout(0.08)
        except Exception as e:
            self._show_error(f"Cannot start server: {e}")
            return None

        dots = 0
        dot_timer = 0
        try:
            while True:
                sw, sh = self.screen.get_width(), self.screen.get_height()
                self._draw_bg()

                ts = mf.render("Hosting — Waiting for Player 2", True, COLORS['white'])
                self.screen.blit(ts, (sw // 2 - ts.get_width() // 2, int(sh * 0.08)))

                ip_y = int(sh * 0.22)
                lbl = sf.render("Share one of these IP addresses with the other player:", True, (190, 215, 255))
                self.screen.blit(lbl, (sw // 2 - lbl.get_width() // 2, ip_y)); ip_y += 28

                shown = local_ips[:5] if local_ips else ['(could not detect — check your network)']
                for ip in shown:
                    s = mf.render(ip, True, (80, 255, 140))
                    self.screen.blit(s, (sw // 2 - s.get_width() // 2, ip_y)); ip_y += 36

                ps = sf.render(f"Port: {self.PORT}", True, (190, 190, 190))
                self.screen.blit(ps, (sw // 2 - ps.get_width() // 2, ip_y + 6))

                dot_timer += 1
                if dot_timer > 18: dots = (dots + 1) % 4; dot_timer = 0
                ws = sf.render("Waiting for connection" + "." * dots, True, (150, 175, 220))
                self.screen.blit(ws, (sw // 2 - ws.get_width() // 2, int(sh * 0.72)))

                cancel_r = pygame.Rect(sw // 2 - 100, int(sh * 0.83), 200, 46)
                mp = pygame.mouse.get_pos()
                self._mk_btn(cancel_r, "Cancel", (90, 30, 30), mp, mf)
                pygame.display.flip(); clock.tick(60)

                # Non-blocking accept
                conn = None
                try:
                    conn, addr = srv.accept()
                    conn.setsockopt(_socket_mod.IPPROTO_TCP, _socket_mod.TCP_NODELAY, 1)
                    conn.setblocking(True)
                    _net_send(conn, {'t': 'hello', 'mode': mode})
                    ack = _net_recv(conn)
                    if ack and ack.get('t') == 'hello_ack':
                        return (True, conn, mode)
                    conn.close()
                except _socket_mod.timeout:
                    pass
                except Exception:
                    if conn:
                        try: conn.close()
                        except: pass

                for event in pygame.event.get():
                    if event.type == pygame.QUIT:           pygame.quit(); sys.exit()
                    elif event.type == pygame.KEYDOWN:
                        if event.key == pygame.K_ESCAPE:    return None
                    elif event.type == pygame.MOUSEBUTTONDOWN:
                        if cancel_r.collidepoint(event.pos): return None
                    elif event.type == pygame.VIDEORESIZE:
                        self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
        finally:
            try: srv.close()
            except: pass

    def _join_flow(self, mode):
        """IP-entry + connect UI. Returns (False, conn, mode) or None."""
        clock = pygame.time.Clock()
        mf  = get_font(self.settings.language, 'bold',    22)
        sf  = get_font(self.settings.language, 'regular', 15)
        ip_str  = ''
        status  = ''
        status_col = (200, 200, 200)
        active  = True  # IP field always active

        while True:
            sw, sh = self.screen.get_width(), self.screen.get_height()
            self._draw_bg()

            ts = mf.render("Join Game", True, COLORS['white'])
            self.screen.blit(ts, (sw // 2 - ts.get_width() // 2, int(sh * 0.09)))

            lbl = sf.render("Host IP Address:", True, (200, 220, 255))
            self.screen.blit(lbl, (sw // 2 - 185, int(sh * 0.28)))

            ip_rect = pygame.Rect(sw // 2 - 185, int(sh * 0.35), 370, 44)
            pygame.draw.rect(self.screen, (22, 33, 68), ip_rect, border_radius=6)
            border_c = (100, 160, 255) if active else (55, 75, 130)
            pygame.draw.rect(self.screen, border_c, ip_rect, width=2, border_radius=6)
            disp = ip_str if ip_str else "e.g.  192.168.1.100"
            dc   = COLORS['white'] if ip_str else (75, 100, 145)
            ds   = sf.render(disp, True, dc)
            self.screen.blit(ds, (ip_rect.x + 12, ip_rect.centery - ds.get_height() // 2))

            ps = sf.render(f"Port: {self.PORT}  (same on both devices)", True, (150, 170, 200))
            self.screen.blit(ps, (sw // 2 - 185, int(sh * 0.50)))

            bw, bh = 200, 50
            conn_r = pygame.Rect(sw // 2 - bw - 10, int(sh * 0.61), bw, bh)
            back_r = pygame.Rect(sw // 2 + 10,       int(sh * 0.61), bw, bh)
            mp = pygame.mouse.get_pos()
            self._mk_btn(conn_r, "Connect", (20, 100, 160), mp, mf)
            self._mk_btn(back_r, "Back",    (55, 65, 110),  mp, mf)

            if status:
                ss = sf.render(status, True, status_col)
                self.screen.blit(ss, (sw // 2 - ss.get_width() // 2, int(sh * 0.76)))

            hint = sf.render("Type the host's IP then press Connect or Enter",
                             True, (80, 108, 160))
            self.screen.blit(hint, (sw // 2 - hint.get_width() // 2, int(sh * 0.88)))

            pygame.display.flip(); clock.tick(60)

            for event in pygame.event.get():
                if event.type == pygame.QUIT:               pygame.quit(); sys.exit()
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_ESCAPE:        return None
                    elif event.key == pygame.K_BACKSPACE:
                        ip_str = ip_str[:-1]; status = ''
                    elif event.key == pygame.K_RETURN:
                        r = self._do_connect(ip_str.strip())
                        if r:
                            return (False, r, mode)
                        status = f"Could not connect to {ip_str}:{self.PORT}"
                        status_col = (255, 100, 100)
                    elif event.unicode in '0123456789.' and len(ip_str) < 40:
                        ip_str += event.unicode; status = ''
                elif event.type == pygame.MOUSEBUTTONDOWN:
                    if conn_r.collidepoint(event.pos):
                        ip = ip_str.strip()
                        if not ip:
                            status = "Please enter the host's IP address"
                            status_col = (255, 185, 80)
                        else:
                            status = f"Connecting to {ip}:{self.PORT}…"
                            status_col = (200, 225, 255)
                            pygame.display.flip()
                            r = self._do_connect(ip)
                            if r:
                                return (False, r, mode)
                            status = f"Could not connect to {ip}:{self.PORT}"
                            status_col = (255, 100, 100)
                    elif back_r.collidepoint(event.pos):    return None
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    mf = get_font(self.settings.language, 'bold',    22)
                    sf = get_font(self.settings.language, 'regular', 15)

    def _do_connect(self, ip):
        """Attempt TCP connect + handshake. Returns socket or None."""
        if not ip:
            return None
        try:
            s = _socket_mod.socket(_socket_mod.AF_INET, _socket_mod.SOCK_STREAM)
            s.settimeout(6)
            s.connect((ip, self.PORT))
            s.setsockopt(_socket_mod.IPPROTO_TCP, _socket_mod.TCP_NODELAY, 1)
            s.setblocking(True)
            msg = _net_recv(s)
            if msg and msg.get('t') == 'hello':
                _net_send(s, {'t': 'hello_ack'})
                return s
            s.close()
        except Exception:
            pass
        return None

    def _show_error(self, text):
        clock = pygame.time.Clock()
        mf = get_font(self.settings.language, 'bold',    22)
        sf = get_font(self.settings.language, 'regular', 17)
        sw, sh = self.screen.get_width(), self.screen.get_height()
        self._draw_bg()
        es = mf.render(text, True, (255, 100, 100))
        self.screen.blit(es, (sw // 2 - es.get_width() // 2, sh // 2 - 30))
        ks = sf.render("Press any key to continue", True, (180, 180, 210))
        self.screen.blit(ks, (sw // 2 - ks.get_width() // 2, sh // 2 + 25))
        pygame.display.flip()
        waiting = True
        while waiting:
            for e in pygame.event.get():
                if e.type in (pygame.KEYDOWN, pygame.MOUSEBUTTONDOWN):
                    waiting = False
            clock.tick(30)


class NetworkGame:
    """
    LAN multiplayer game session.

    is_host=True  → runs the full simulation (authoritative); sends state to client.
    is_host=False → renders state received from host; sends key presses to host.

    Both players use WASD or Arrow keys on their own device.
    """

    def __init__(self, settings, screen, is_host, conn, mode='1v1'):
        self.settings  = settings
        self.screen    = screen
        self.is_host   = is_host
        self.conn      = conn
        self.mode      = mode
        self.connected = True
        self._recv_q   = _queue_mod.Queue()

        # Start background receiver thread
        self._recv_t = threading.Thread(target=self._recv_loop, daemon=True)
        self._recv_t.start()

        if is_host:
            # Host owns the authoritative MultiplayerGame
            self.mp = MultiplayerGame(settings, screen, mode)
        else:
            # Client holds the last rendered state dict
            self.render_state = None
            self._local_dir   = (0, -1)   # for 180° guard

    # ── background receiver ──────────────────────────────────────────────

    def _recv_loop(self):
        while self.connected:
            msg = _net_recv(self.conn)
            if msg is None:
                self.connected = False
                self._recv_q.put(None)   # sentinel
                return
            self._recv_q.put(msg)

    # ── host helpers ────────────────────────────────────────────────────

    def _state_dict(self):
        mp = self.mp
        return {
            't':  'state',
            'p1': [list(s) for s in mp.p1_snake],
            'p2': [list(s) for s in mp.p2_snake],
            'f':  list(mp.fruit_pos) if mp.fruit_pos else None,
            's1': mp.p1_score,
            's2': mp.p2_score,
            'a1': mp.p1_alive,
            'a2': mp.p2_alive,
            'go': mp.game_over,
            'w':  mp.winner,
            'obs': [list(o) for o in mp.obstacles],
            'bw': mp.board_width,
            'bh': mp.board_height,
            'cs': mp.cell_size,
            'ox': mp.board_offset_x,
            'oy': mp.board_offset_y,
        }

    def _apply_client_input(self, d_list):
        """Apply a direction from the client to P2 (avoids 180° reversal)."""
        nd = tuple(d_list)
        cur = self.mp.p2_dir
        if not (nd[0] == -cur[0] and nd[1] == -cur[1]):
            self.mp.p2_next = nd

    def _host_key(self, key):
        """Host controls P1 (WASD or Arrows)."""
        mp = self.mp
        mapping = {
            pygame.K_w: (0,-1), pygame.K_UP:    (0,-1),
            pygame.K_s: (0, 1), pygame.K_DOWN:  (0, 1),
            pygame.K_a: (-1,0), pygame.K_LEFT:  (-1,0),
            pygame.K_d: ( 1,0), pygame.K_RIGHT: ( 1,0),
        }
        if key not in mapping:
            return
        nd = mapping[key]
        cur = mp.p1_dir
        if not (nd[0] == -cur[0] and nd[1] == -cur[1]):
            mp.p1_next = nd

    # ── client helpers ───────────────────────────────────────────────────

    def _client_key(self, key):
        """Client controls P2; sends direction to host."""
        mapping = {
            pygame.K_w: (0,-1), pygame.K_UP:    (0,-1),
            pygame.K_s: (0, 1), pygame.K_DOWN:  (0, 1),
            pygame.K_a: (-1,0), pygame.K_LEFT:  (-1,0),
            pygame.K_d: ( 1,0), pygame.K_RIGHT: ( 1,0),
        }
        if key not in mapping:
            return
        nd = mapping[key]
        cur = self._local_dir
        if nd[0] == -cur[0] and nd[1] == -cur[1]:
            return
        self._local_dir = nd
        if self.connected:
            try:
                _net_send(self.conn, {'t': 'input', 'd': list(nd)})
            except Exception:
                self.connected = False

    # ── rendering (client-side) ─────────────────────────────────────────

    def _draw_client(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        self.screen.fill(COLORS['background'])
        st = self.render_state

        if st is None:
            f = get_font(self.settings.language, 'bold', 30)
            s = f.render("Waiting for host…", True, COLORS['white'])
            self.screen.blit(s, (sw//2 - s.get_width()//2, sh//2 - s.get_height()//2))
            return

        bw = st.get('bw', 15); bh = st.get('bh', 15)
        cs = st.get('cs', 24); ox = st.get('ox', 0); oy = st.get('oy', 62)

        # Board
        pygame.draw.rect(self.screen, COLORS['board_background'],
                         pygame.Rect(ox, oy, bw*cs, bh*cs))
        for x in range(bw+1):
            pygame.draw.line(self.screen, COLORS['grid_line'],
                             (ox+x*cs, oy), (ox+x*cs, oy+bh*cs), 1)
        for y in range(bh+1):
            pygame.draw.line(self.screen, COLORS['grid_line'],
                             (ox, oy+y*cs), (ox+bw*cs, oy+y*cs), 1)

        # Obstacles
        for obs in st.get('obs', []):
            r = pygame.Rect(ox+obs[0]*cs, oy+obs[1]*cs, cs, cs)
            pygame.draw.rect(self.screen, COLORS.get('obstacle', (100,100,100)), r)

        # Fruit
        fp = st.get('f')
        if fp:
            fr = pygame.Rect(ox+fp[0]*cs, oy+fp[1]*cs, cs, cs)
            if cs >= 10 and self.settings.fruit_types_enabled:
                draw_fruit(self.screen, fr, 'regular')
            else:
                pygame.draw.rect(self.screen, COLORS['fruit'], fr)

        # Snakes
        def _ds(seg_list, bc, hc, alive):
            bc2 = bc if alive else (100,100,100)
            hc2 = hc if alive else (70,70,70)
            for i, seg in enumerate(seg_list or []):
                r = pygame.Rect(ox+seg[0]*cs+1, oy+seg[1]*cs+1, cs-2, cs-2)
                pygame.draw.rect(self.screen, hc2 if i==0 else bc2, r,
                                 border_radius=max(1, cs//5))

        _ds(st.get('p2',[]), MultiplayerGame.P2_BODY, MultiplayerGame.P2_HEAD, st.get('a2',True))
        _ds(st.get('p1',[]), MultiplayerGame.P1_BODY, MultiplayerGame.P1_HEAD, st.get('a1',True))

        # HUD
        hf = get_font(self.settings.language, 'bold',    20)
        sf = get_font(self.settings.language, 'regular', 14)
        if self.mode == '1v1':
            p1c = (100,255,100) if st.get('a1',True) else (130,130,130)
            p2c = ( 80,215,255) if st.get('a2',True) else (130,130,130)
            self.screen.blit(hf.render(f"Host (P1): {st.get('s1',0)}", True, p1c), (10, 8))
            s2 = hf.render(f"You (P2): {st.get('s2',0)}", True, p2c)
            self.screen.blit(s2, (sw - s2.get_width() - 10, 8))
        else:
            sc = st.get('s1',0) + st.get('s2',0)
            ss = hf.render(f"Co-op Score: {sc}", True, COLORS['white'])
            self.screen.blit(ss, (sw//2 - ss.get_width()//2, 8))
        tag = "1v1" if self.mode == '1v1' else "Co-op"
        ht = sf.render(f"[LAN {tag}]  WASD / Arrows: move your snake  ESC: disconnect", True, (80,110,160))
        self.screen.blit(ht, (sw//2 - ht.get_width()//2, 44))

        # Game-over overlay
        if st.get('go'):
            ov = pygame.Surface((sw, sh), pygame.SRCALPHA)
            ov.fill((0,0,0,180)); self.screen.blit(ov, (0,0))
            bf = get_font(self.settings.language, 'bold',    50)
            mf2= get_font(self.settings.language, 'bold',    28)
            sf2= get_font(self.settings.language, 'regular', 20)
            w = st.get('w')
            if self.mode == '1v1':
                if   w==1:       txt,col = "HOST WINS!",   (100,255,100)
                elif w==2:       txt,col = "YOU WIN!",     ( 80,215,255)
                elif w=='draw':  txt,col = "IT'S A DRAW!", (255,215,  0)
                else:            txt,col = "GAME OVER",    (200,200,200)
                sc_txt = f"Host: {st.get('s1',0)}     You: {st.get('s2',0)}"
            else:
                if w=='coop_win': txt,col = "YOU WIN!",   (100,255,100)
                else:             txt,col = "GAME OVER",  (255,80,80)
                sc_txt = f"Team Score: {st.get('s1',0)+st.get('s2',0)}"
            for surf, y in [
                (bf.render(txt, True, col), sh//2-110),
                (mf2.render(sc_txt, True, COLORS['white']), sh//2-30),
                (sf2.render("ESC — Back to Menu", True, (190,190,210)), sh//2+50),
            ]:
                self.screen.blit(surf, (sw//2 - surf.get_width()//2, y))

    def _draw_host_net_badge(self):
        sf = get_font(self.settings.language, 'regular', 13)
        tag = "1v1" if self.mode == '1v1' else "Co-op"
        col = (80,255,80) if self.connected else (255,80,80)
        s = sf.render(f"[LAN {tag}] {'● Connected' if self.connected else '✕ Disconnected'}", True, col)
        self.screen.blit(s, (self.screen.get_width() - s.get_width() - 8, 44))

    def _draw_conn_lost(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        self.screen.fill(COLORS['background'])
        ov = pygame.Surface((sw, sh), pygame.SRCALPHA)
        ov.fill((0,0,0,200)); self.screen.blit(ov, (0,0))
        bf = get_font(self.settings.language, 'bold',    38)
        sf = get_font(self.settings.language, 'regular', 20)
        for surf, y in [
            (bf.render("Connection Lost", True, (255,100,100)), sh//2-80),
            (sf.render("The network connection was interrupted.", True, (200,200,200)), sh//2-10),
            (sf.render("Press ESC to return to the menu.", True, (180,180,210)), sh//2+45),
        ]:
            self.screen.blit(surf, (sw//2 - surf.get_width()//2, y))

    # ── main loop ────────────────────────────────────────────────────────

    def run(self):
        running = True
        clock   = pygame.time.Clock()

        while running:
            # Drain receive queue
            while not self._recv_q.empty():
                msg = self._recv_q.get_nowait()
                if msg is None:                       # connection lost
                    self.connected = False
                    break
                t = msg.get('t')
                if self.is_host:
                    if t == 'input':
                        d = msg.get('d')
                        if d and len(d) == 2:
                            self._apply_client_input(d)
                    elif t == 'restart_req' and self.mp.game_over:
                        self.mp.reset()
                        if self.connected:
                            try: _net_send(self.conn, {'t': 'restart'})
                            except: self.connected = False
                else:
                    if t == 'state':
                        self.render_state = msg
                    elif t == 'restart':
                        self.render_state = None

            # Connection-lost screen
            if not self.connected:
                self._draw_conn_lost()
                pygame.display.flip()
                for event in pygame.event.get():
                    if event.type == pygame.QUIT:
                        running = False
                    elif event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                        running = False
                clock.tick(30)
                continue

            # Event handling
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                elif event.type == pygame.KEYDOWN:
                    k = event.key
                    if k == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif k == pygame.K_ESCAPE:
                        running = False
                    elif k == pygame.K_r:
                        if self.is_host and self.mp.game_over:
                            self.mp.reset()
                            try: _net_send(self.conn, {'t': 'restart'})
                            except: self.connected = False
                        elif not self.is_host:
                            try: _net_send(self.conn, {'t': 'restart_req'})
                            except: self.connected = False
                    elif k == pygame.K_p and self.is_host and not self.mp.game_over:
                        self.mp.paused = not self.mp.paused
                    elif self.is_host and not self.mp.game_over and not self.mp.paused:
                        self._host_key(k)
                    elif not self.is_host:
                        go = self.render_state.get('go') if self.render_state else False
                        if not go:
                            self._client_key(k)
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode(
                        (event.w, event.h), pygame.RESIZABLE)
                    if self.is_host:
                        self.mp._init_layout()

            # Host: tick + send state
            if self.is_host:
                now = time.time() * 1000
                if not self.mp.paused and not self.mp.game_over:
                    if now - self.mp.last_tick >= self.settings.update_rate_ms:
                        self.mp.tick()
                        self.mp.last_tick = now
                # Send state every frame so the client stays fresh
                if self.connected:
                    try: _net_send(self.conn, self._state_dict())
                    except: self.connected = False

                self.mp.draw()
                self._draw_host_net_badge()
            else:
                self._draw_client()

            pygame.display.flip()
            clock.tick(60)

        # Cleanup
        try: self.conn.close()
        except: pass


