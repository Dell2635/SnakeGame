                    elif isinstance(controls.get('bgm_enabled'), pygame.Rect) and controls['bgm_enabled'].collidepoint(mouse_pos):
                        self.temp_settings.bgm_enabled = not getattr(self.temp_settings, 'bgm_enabled', False)
                    elif controls['save_button'].collidepoint(mouse_pos):
                        _changed_setting_fields = [
                            field for field in _SETTINGS_SCREEN_ACHIEVEMENT_FIELDS
                            if getattr(self.settings, field, None)
                            != getattr(self.temp_settings, field, None)
                        ]
                        # Apply changes - basic settings
                        self.settings.update_rate_ms = self.temp_settings.update_rate_ms
                        self.settings.board_size = self.temp_settings.board_size
                        self.settings.snake_color = self.temp_settings.snake_color
                        self.settings.language = self.temp_settings.language
                        self.settings.wall_collision = self.temp_settings.wall_collision
                        
                        # Apply changes - power-up settings
                        self.settings.powerups_enabled = self.temp_settings.powerups_enabled
                        self.settings.speed_boost_enabled = self.temp_settings.speed_boost_enabled
                        self.settings.slow_motion_enabled = self.temp_settings.slow_motion_enabled
                        self.settings.size_reduction_enabled = self.temp_settings.size_reduction_enabled
                        self.settings.invincibility_enabled = self.temp_settings.invincibility_enabled
                        self.settings.double_points_enabled = self.temp_settings.double_points_enabled
                        self.settings.ghost_mode_enabled = getattr(self.temp_settings, 'ghost_mode_enabled', True)
                        self.settings.shield_enabled = getattr(self.temp_settings, 'shield_enabled', True)
                        
                        # Apply changes - obstacle settings
                        self.settings.enable_obstacles = self.temp_settings.enable_obstacles
                        self.settings.obstacle_count = self.temp_settings.obstacle_count
                        self.settings.static_obstacles_enabled = self.temp_settings.static_obstacles_enabled
                        self.settings.moving_obstacles_enabled = self.temp_settings.moving_obstacles_enabled
                        
                        # Apply changes - portal settings
                        self.settings.enable_portals = self.temp_settings.enable_portals
                        self.settings.portal_pairs = self.temp_settings.portal_pairs
                        
                        # Apply changes - gameplay features
                        self.settings.fruit_types_enabled = self.temp_settings.fruit_types_enabled
                        self.settings.combo_fruits_enabled = self.temp_settings.combo_fruits_enabled
                        self.settings.levels_enabled = self.temp_settings.levels_enabled
                        self.settings.increasing_speed_enabled = self.temp_settings.increasing_speed_enabled
                        
                        # Apply changes - frequency settings
                        self.settings.powerup_frequency = self.temp_settings.powerup_frequency
                        # Sound settings
                        self.settings.master_volume = getattr(self.temp_settings, 'master_volume', 80)
                        self.settings.sfx_volume = getattr(self.temp_settings, 'sfx_volume', 100)
                        self.settings.bgm_volume = getattr(self.temp_settings, 'bgm_volume', 100)
                        self.settings.sfx_enabled   = getattr(self.temp_settings, 'sfx_enabled',   True)
                        self.settings.bgm_enabled   = getattr(self.temp_settings, 'bgm_enabled',   False)
                        self.settings.reduced_motion = self.temp_settings.reduced_motion
                        self.settings.colorblind_cues = self.temp_settings.colorblind_cues
                        self.settings.high_contrast = self.temp_settings.high_contrast
                        self.settings.ui_scale_percent = self.temp_settings.ui_scale_percent
                        self.settings.control_bindings = _normalize_control_bindings(
