            gap = 16; btn_h = 40
            btn_w = max(96, min(130, int((sw - 2 * gap - 24) / 3)))
            nav_x = (sw - (btn_w * 3 + gap * 2)) // 2
            previous_rect = pygame.Rect(nav_x, sh-54, btn_w, btn_h)
            start_rect = pygame.Rect(nav_x + btn_w + gap, sh-54, btn_w, btn_h)
            back_rect = pygame.Rect(nav_x + 2 * (btn_w + gap), sh-54, btn_w, btn_h)
