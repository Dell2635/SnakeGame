def _record_settings_achievement_progress(settings, changed_keys):
    """Persist distinct user-edited settings and unlock related achievements."""
    allowed = {
        'update_rate_ms', 'board_size', 'snake_color', 'language', 'wall_collision',
        'powerups_enabled', 'enable_obstacles', 'fruit_types_enabled',
        'enable_portals', 'master_volume', 'sfx_volume', 'bgm_volume',
        'sfx_enabled', 'bgm_enabled', 'map_theme',
        'reduced_motion', 'colorblind_cues', 'high_contrast', 'ui_scale_percent',
        'control_bindings',
    }
    changes = {key for key in changed_keys if isinstance(key, str) and key in allowed}
    if not changes:
        return []
    try:
        data = _load_data()
        progression = data.get('progression', {})
        if not isinstance(progression, dict):
            progression = {}
        previous = progression.get('settings_changed', [])
        if not isinstance(previous, list):
            previous = []
        previous = {key for key in previous if isinstance(key, str) and key in allowed}
        accumulated = sorted(previous | changes)
        progression['settings_changed'] = accumulated
        data['progression'] = progression
        if not _save_data(data):
            return []
        manager = getattr(settings, 'achievement_manager', None)
        if manager is None:
            manager = AchievementManager()
            manager.load_state()
            settings.achievement_manager = manager
        manager.check_achievement_progress({'settings_changed': accumulated})
        return accumulated
    except Exception as exc:
        sgf_log.error('Failed to record settings achievement progress: %s', type(exc).__name__)
        return []


def _profile_game_outcome(game, mode):
    """Resolve the local profile outcome without treating ties as losses."""
    override = getattr(game, '_sgf_xp_victory_override', None)
    if override is not None:
        return 'win' if bool(override) else 'loss'
    winner = getattr(game, 'winner', None)
    if winner in ('player', 'coop_win'):
        return 'win'
    if winner == 'draw':
        return 'draw'
    if winner in ('ai', 'coop_lose'):
        return 'loss'
    if type(winner) is int:
        local_player = 2 if mode == 'lan_client' else 1
        return 'win' if winner == local_player else 'loss'
    if bool(getattr(game, 'victory', False)):
        return 'win'
    if mode in ('singleplayer', 'vs_ai'):
        return 'loss'
    return 'draw'


def _profile_won_game(game, mode):
    """Compatibility helper for code that only needs a win/loss boolean."""
    return _profile_game_outcome(game, mode) == 'win'


def _profile_snake_length(game, mode):
    """Return the final snake length belonging to the local profile slot."""
    snakes = getattr(game, 'snakes', None)
    if isinstance(snakes, (list, tuple)):
        profile_index = 1 if mode == 'lan_client' else 0
        if len(snakes) > profile_index:
            return max(0, min(100_000, len(snakes[profile_index] or [])))
    if mode == 'lan_client':
        client_snake = getattr(game, 'p2_snake', None)
        if client_snake is not None:
            return max(0, min(100_000, len(client_snake or [])))
    snake = getattr(game, 'snake', None)
    if snake is None:
        snake = getattr(game, 'p1_snake', [])
    try:
        return max(0, min(100_000, len(snake or [])))
    except (TypeError, OverflowError):
        return 0


def _profile_game_duration_ms(game):
    """Read bounded active simulation time; pauses and menus are excluded."""
    value = getattr(game, '_sim_time_ms', 0.0)
    if type(value) not in (int, float):
        return 0
    duration = float(value)
    if not math.isfinite(duration) or duration <= 0:
        return 0
    return min(7 * 24 * 60 * 60 * 1000, int(duration))


def _award_game_xp(game, mode='singleplayer'):
    """Award local XP once when a real game result is saved; replays never count."""
    if game is None or getattr(game, 'replay_mode', False) or getattr(game, '_replay_mode', False):
        return None
    award_id = getattr(game, '_sgf_xp_award_id', None)
    if not isinstance(award_id, str) or len(award_id) != 32:
        award_id = _secrets_mod.token_hex(16)
        try:
            game._sgf_xp_award_id = award_id
        except Exception:
            return None

    try:
        score_override = getattr(game, '_sgf_xp_score_override', None)
        if score_override is not None:
            score_value = score_override
        else:
            score_value = getattr(game, 'score', getattr(game, 'p1_score', 0))
            scores = getattr(game, 'scores', None)
            if isinstance(scores, (list, tuple)) and scores:
                profile_index = 1 if mode == 'lan_client' else 0
                if len(scores) > profile_index:
                    score_value = scores[profile_index]
            elif hasattr(game, 'p1_score'):
                score_value = game.p1_score
        score = max(0, min(1_000_000, int(score_value or 0)))
        outcome = _profile_game_outcome(game, mode)
        victory = outcome == 'win'
        xp_awarded = 25 + min(100, score // 10) + (25 if victory else 0)
        data = _load_data()
        progress = data.get('progression', {})
        if not isinstance(progress, dict):
            progress = {}
        recent = progress.get('recent_award_ids', [])
        if not isinstance(recent, list):
            recent = []
        if award_id in recent:
            return None

        def _counter(key):
            try:
                return max(0, min(1_000_000_000,
                                  int(progress.get(key, 0) or 0)))
            except (TypeError, ValueError, OverflowError):
                return 0

        total_xp = min(1_000_000_000, _counter('xp_total') + xp_awarded)
        level, level_xp, next_level_xp = _progression_level_for_xp(total_xp)
        games_completed = _counter('games_completed') + 1
        highest_score = max(_counter('highest_score'), score)
        total_score = min(1_000_000_000, _counter('total_score') + score)
        snake_length = _profile_snake_length(game, mode)
        longest_snake = min(100_000,
                            max(_counter('longest_snake'), snake_length))
        fruits_this_game = max(0, min(1_000_000, int(getattr(game, 'fruits_eaten', 0) or 0)))
        portals_this_game = max(0, min(1_000_000, int(getattr(game, 'portals_used', 0) or 0)))
        total_fruits = _counter('total_fruits') + fruits_this_game
        total_portals = _counter('total_portal_uses') + portals_this_game
        duration_this_game = _profile_game_duration_ms(game)
        def _duration_counter(key):
            value = progress.get(key, 0)
            if type(value) is not int:
                return 0
            return max(0, min(1_000_000_000_000_000, value))
        total_play_time_ms = min(
            1_000_000_000_000_000,
            _duration_counter('total_play_time_ms') + duration_this_game)
        longest_survival_ms = max(
            _duration_counter('longest_survival_ms'), duration_this_game)
        best_combo = max(_counter('best_combo'), int(getattr(game, 'max_combo', 0) or 0))
        previous_unique_fruits = progress.get('unique_fruits_collected', [])
        if not isinstance(previous_unique_fruits, list):
            previous_unique_fruits = []
        this_game_unique_fruits = getattr(game, 'unique_fruits_collected', set())
        if not isinstance(this_game_unique_fruits, (list, tuple, set)):
            this_game_unique_fruits = []
        unique_fruits = sorted({str(item)[:32] for item in previous_unique_fruits + list(this_game_unique_fruits)
                                if isinstance(item, str) and item})[:64]
        wins = min(1_000_000_000, _counter('wins') + (1 if victory else 0))
        losses = min(1_000_000_000,
                     _counter('losses') + (1 if outcome == 'loss' else 0))
        unlocked_skins = [skin for skin, required_level in _SKIN_LEVEL_UNLOCKS.items()
                          if level >= required_level]
        selected_skin = progress.get('selected_skin', 'classic')
        if selected_skin not in unlocked_skins:
            selected_skin = 'classic'
        recent = (recent + [award_id])[-256:]
        recent_matches = _normalize_recent_matches(progress.get('recent_matches', []))
        recent_matches.append({
            'id': award_id,
            'timestamp': datetime.now().isoformat(timespec='seconds'),
            'score': score,
            'outcome': outcome,
            'mode': str(mode)[:32],
            'snake_length': snake_length,
            'combo': max(0, min(1_000_000, int(getattr(game, 'max_combo', 0) or 0))),
        })
        recent_matches = _normalize_recent_matches(recent_matches)
        data['progression'] = {
            'schema_version': PROGRESSION_SCHEMA_VERSION,
            'xp_total': total_xp,
            'level': level,
            'level_xp': level_xp,
            'next_level_xp': next_level_xp,
            'games_completed': games_completed,
            'highest_score': highest_score,
            'total_score': total_score,
            'longest_snake': longest_snake,
            'total_fruits': total_fruits,
            'total_portal_uses': total_portals,
            'total_play_time_ms': total_play_time_ms,
            'longest_survival_ms': longest_survival_ms,
            'wins': wins,
            'losses': losses,
            'best_combo': best_combo,
            'recent_matches': recent_matches,
            'unique_fruits_collected': unique_fruits,
            'unlocked_skins': unlocked_skins,
            'selected_skin': selected_skin,
            'recent_award_ids': recent,
            'last_award': {'id': award_id, 'xp': xp_awarded, 'mode': str(mode)[:32]},
        }
        if not _save_data(data):
            return None

        manager = getattr(game, 'achievement_manager', None)
        if manager is None:
            manager = AchievementManager()
            manager.load_state()
            try:
                game.achievement_manager = manager
            except Exception:
                pass
        manager.check_achievement_progress({
            'score': score,
            'highest_score': highest_score,
            'games_played': games_completed,
            'total_fruits': total_fruits,
            'level': level,
            'wins': wins,
            'best_combo': best_combo,
            'total_portal_uses': total_portals,
            'portals_used': portals_this_game,
            'portal_uses': total_portals,
            'snake_length': len(getattr(game, 'snake', getattr(game, 'p1_snake', [])) or []),
            'board_size': getattr(game, 'board_width', getattr(getattr(game, 'settings', None), 'board_size', 10)),
            'victory': victory,
            'game_over': True,
            'max_combo': best_combo,
            'fruits_eaten': fruits_this_game,
            'powerups_used': list(getattr(game, 'powerups_used', []) or []),
            'unique_fruits_collected': unique_fruits,
            'completed_with_obstacles': bool(
                getattr(getattr(game, 'settings', None), 'enable_obstacles', False)
                or getattr(game, 'obstacles', [])),
            'max_speed_game': getattr(getattr(game, 'settings', None), 'update_rate_ms', 200) <= 100,
            'update_rate_ms': getattr(getattr(game, 'settings', None), 'update_rate_ms', 200),
            'settings_changed': _load_progression_summary().get('settings_changed', []),
        })
        result = {'xp_awarded': xp_awarded, 'xp_total': total_xp, 'level': level,
                  'level_xp': level_xp, 'next_level_xp': next_level_xp,
                  'leveled_up': level > _progression_level_for_xp(_counter('xp_total'))[0]}
        game._sgf_xp_award_result = result
        return result
    except Exception as exc:
        sgf_log.error('Failed to award local game progression: %s', type(exc).__name__)
        return None


