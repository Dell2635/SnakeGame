def _clear_game_xp_award(game):
    """Allow the same reusable game object to earn XP in its next match."""
    state = getattr(game, '__dict__', None)
    if isinstance(state, dict):
        state.pop('_sgf_xp_award_id', None)
        state.pop('_sgf_xp_award_result', None)


def _track_game_fruit(game, fruit_type):
    """Track fruit categories eaten by the human player in this match."""
    if game is None:
        return
    fruit_type = str(fruit_type or 'regular').strip().lower()[:32] or 'regular'
    try:
        game.fruits_eaten = max(0, int(getattr(game, 'fruits_eaten', 0))) + 1
    except (TypeError, ValueError, OverflowError, AttributeError):
        pass
    try:
        collected = getattr(game, 'unique_fruits_collected', None)
        if not isinstance(collected, set):
            collected = set(collected or ())
            game.unique_fruits_collected = collected
        collected.add(fruit_type)
    except (TypeError, ValueError, AttributeError):
        pass


