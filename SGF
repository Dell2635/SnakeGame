    import tempfile as _tempfile
    with _tempfile.TemporaryDirectory() as _rt_dir:
        def _rt_make(index, compressed=False):
            payload = {'game_id': f'g{index}', 'events': [{'t': k, 'd': 'UP'} for k in range(300)]}
            stem = f'replay_2026-10-08T15-18-2{index}.725715_g{index}'
            if compressed:
                with open(os.path.join(_rt_dir, stem + '.json.gz'), 'wb') as _fh:
                    _fh.write(gzip.compress(json.dumps(payload, indent=2).encode('utf-8'), 1))
            else:
                with open(os.path.join(_rt_dir, stem + '.json'), 'w', encoding='utf-8') as _fh:
                    json.dump(payload, _fh, indent=2)
            return stem[len('replay_'):]
        _rt_ids = [_rt_make(1), _rt_make(2), _rt_make(3, True), _rt_make(4)]
