    def _draw_paused(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        ov = pygame.Surface((sw, sh), pygame.SRCALPHA)
        ov.fill((0, 0, 0, 110))
        self.screen.blit(ov, (0, 0))
        f  = get_font(self.settings.language, 'bold',    50)
        f2 = get_font(self.settings.language, 'regular', 22)
        s  = f.render(get_text(self.settings.language, 'paused').upper(), True, COLORS['white'])
        s2 = f2.render(get_text(self.settings.language, 'press_p_to_resume'), True, (180, 180, 210))
        self.screen.blit(s,  (sw // 2 - s.get_width()  // 2, sh // 2 - s.get_height()  // 2))
        self.screen.blit(s2, (sw // 2 - s2.get_width() // 2, sh // 2 + 40))

    # ── main loop ────────────────────────────────────────────────────────

    def run(self):
        running = True
        clock   = pygame.time.Clock()
        saved   = False

        while running:
            _pump_audio()
            frame_start = time.perf_counter()
            input_start = frame_start
            for event in pygame.event.get():
                if _legacy_nav_event(locals().get('self'), event, locals()):
                    continue
                if getattr(self, 'runtime', None) is not None:
                    handled, _actions = self.runtime.input.route(event)
                    if handled:
                        continue
                if event.type == pygame.QUIT:
                    running = False
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif event.key == pygame.K_ESCAPE:
                        running = False
                    elif event.key == pygame.K_r and self.game_over:
                        self.reset()
                        saved = False
                    elif event.key == pygame.K_p and not self.game_over:
                        self.paused = not self.paused
                        if getattr(self, 'runtime', None) is not None:
                            self.runtime.set_game_paused(self.paused, {'game': 'multiplayer'})
                    elif not self.game_over and not self.paused:
                        self.handle_key(event.key)
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode(
                        (event.w, event.h), pygame.RESIZABLE)
                    self._init_layout()

            now = time.time() * 1000
            if not self.paused and not self.game_over:
                if now - self.last_tick >= DEV_TOOLS.scaled_update_interval(self.settings.update_rate_ms):
                    DEV_TOOLS.apply_frame_cheats(self)
                    self.tick()
                    self.last_tick = now

            if self.game_over and not saved and not self.replay_mode:
                self.save_match(source='local')
                saved = True

            render_start = time.perf_counter()
            self.draw()
            _legacy_nav_draw(locals().get('self'))
            DEV_TOOLS.draw_dev_indicator(self.screen, replay=bool(getattr(self, 'replay_mode', False)))
            render_ms = (time.perf_counter() - render_start) * 1000.0
            frame_ms = clock.tick(60)
            input_ms = (time.perf_counter() - input_start) * 1000.0
            _dev_game_frame_hook(self, frame_ms, render_ms=render_ms, input_ms=input_ms)
            pygame.display.flip()


_MP_CONTROL_PRESETS = (
    {'up': 'w', 'down': 's', 'left': 'a', 'right': 'd'},
    {'up': 'up', 'down': 'down', 'left': 'left', 'right': 'right'},
    {'up': 't', 'down': 'g', 'left': 'f', 'right': 'h'},
    {'up': 'i', 'down': 'k', 'left': 'j', 'right': 'l'},
)


def _normalize_mp_player_configs(configs, count):
    result = []
    raw = configs if isinstance(configs, list) else []
    for i in range(max(1, min(4, int(count or 1)))):
        src = raw[i] if i < len(raw) and isinstance(raw[i], dict) else {}
        base = dict(_MP_CONTROL_PRESETS[i % len(_MP_CONTROL_PRESETS)])
        bindings = src.get('bindings', {})
        if isinstance(bindings, dict):
            for action in ('up', 'down', 'left', 'right'):
                value = bindings.get(action)
                if isinstance(value, str) and value.strip():
                    base[action] = value.strip().lower()
        result.append({
            'name': str(src.get('name', f'Player {i + 1}'))[:20] or f'Player {i + 1}',
            'bindings': base,
        })
    return result


def _mp_key_matches(key, key_name):
    try:
        return pygame.key.name(int(key)).lower() == str(key_name).lower()
    except Exception:
        return False


class LocalMultiplayerNGame:
    """Deterministic local multiplayer engine supporting one to four players.

    The control table is data-driven and accepts overrides from the shared
    keybind/action-mapping layer. The built-in presets are only defaults.
    """

    PLAYER_COLORS = (
        ((50, 205, 50), (20, 165, 20)),
        ((0, 200, 230), (0, 130, 160)),
        ((225, 100, 225), (155, 45, 155)),
        ((255, 175, 60), (190, 110, 15)),
    )

    def __init__(self, settings, screen, mode='1v1', player_count=2,
                 player_configs=None, seed=None, custom_map=None):
        self.settings = settings
        self.screen = screen
        self.mode = 'coop' if mode == 'coop' else '1v1'
        self.player_count = max(1, min(4, int(player_count or 1)))
        self.player_configs = _normalize_mp_player_configs(player_configs, self.player_count)
        self.seed = seed if seed else generate_seed()
        self.cosmetic_rng = random.Random(seed_to_int(f'{self.seed}:cosmetic'))
        self.custom_map = custom_map
        self.runtime = None
        self.replay_mode = False
        self.replay_index = 0
        self.replay_speed = 1.0
        self._replay_exit = False
        self._match_saved = False
        self.mp_history = []
        self._init_layout()
        self.reset()

    def _board_size(self):
        value = self.settings.board_size
        if isinstance(value, str):
            return {'small': 10, 'medium': 15, 'large': 20, 'extra_large': 25}.get(value, 15)
        return max(10, int(value))

    def _init_layout(self):
        if isinstance(self.custom_map, dict):
            self.board_width = int(self.custom_map.get('board_width', self._board_size()))
            self.board_height = int(self.custom_map.get('board_height', self._board_size()))
        else:
            self.board_width = self.board_height = self._board_size()
        sw, sh = self.screen.get_size()
        hud_h = 72
        self.cell_size = max(4, min(sw, sh - hud_h) // max(self.board_width, self.board_height, 1))
        self.board_offset_x = (sw - self.board_width * self.cell_size) // 2
        self.board_offset_y = hud_h + (sh - hud_h - self.board_height * self.cell_size) // 2

    def _spawn_positions(self):
        bw, bh = self.board_width, self.board_height
        candidates = [
            (max(1, bw // 6), max(1, bh // 2)),
            (min(bw - 2, 5 * bw // 6), max(1, bh // 2)),
            (max(1, bw // 2), max(1, bh // 6)),
            (max(1, bw // 2), min(bh - 2, 5 * bh // 6)),
        ]
        out = []
        used = set()
        for cell in candidates:
            if cell not in used and 0 <= cell[0] < bw and 0 <= cell[1] < bh:
                out.append(cell)
                used.add(cell)
        while len(out) < self.player_count:
            fallback = (len(out) % max(1, bw), (len(out) * 3) % max(1, bh))
            if fallback not in used:
                out.append(fallback)
                used.add(fallback)
        return out[:self.player_count]

    def reset(self):
        _clear_game_xp_award(self)
        self.rng = SeedRNG(self.seed)
        self.cosmetic_rng = random.Random(seed_to_int(f'{self.seed}:cosmetic'))
        self._init_layout()
        self.snakes = [[pos] for pos in self._spawn_positions()]
        dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]
        self.directions = [dirs[i % 4] for i in range(self.player_count)]
        self.next_directions = list(self.directions)
        self.scores = [0] * self.player_count
        self.alive = [True] * self.player_count
        self.obstacles = []
        if isinstance(self.custom_map, dict):
            self.obstacles = [tuple(o) for o in self.custom_map.get('obstacles', [])]
        elif getattr(self.settings, 'enable_obstacles', False):
            self._gen_obstacles()
        self.portals = []
        if isinstance(self.custom_map, dict):
            self.portals = [tuple(p) for p in self.custom_map.get('portals', []) if len(p) == 5]
        self.fruit_pos = self._new_fruit()
        self.fruit_type = _pick_cosmetic_fruit_type(
            getattr(self.settings, 'fruit_types_enabled', True), self.cosmetic_rng)
        self.fruits_eaten = 0
        self.unique_fruits_collected = set()
        self.game_over = False
        self.winner = None
        self.paused = False
        self.last_tick = time.time() * 1000
        self.mp_history = [self._mp_snap()]
        self._match_saved = False
        self._replay_save_game_id = None

    def _gen_obstacles(self):
        starts = set(sum((snake for snake in self.snakes), []))
        available = [(x, y) for x in range(self.board_width) for y in range(self.board_height)
                     if (x, y) not in starts]
        count = min(getattr(self.settings, 'obstacle_count', 5),
                    len(available) // 6, 20)
        self.obstacles = self.rng.sample(available, count) if count else []

    def _new_fruit(self):
        occupied = set(self.obstacles)
        for snake in self.snakes:
            occupied.update(snake)
        for p in self.portals:
            occupied.add((p[0], p[1])); occupied.add((p[2], p[3]))
        available = [(x, y) for x in range(self.board_width)
                     for y in range(self.board_height) if (x, y) not in occupied]
        return self.rng.choice(available) if available else None

    def _teleport(self, cell):
        for p in self.portals:
            a = (p[0], p[1]); b = (p[2], p[3])
            if cell == a:
                return b
            if cell == b:
                return a
        return cell

    def _runtime_actions(self, event):
        router = getattr(self.runtime, 'input', None)
        mapper = getattr(router, '_action_mapper', None) if router else None
        for method_name in ('actions_for_event', 'resolve', 'map_event'):
            fn = getattr(mapper, method_name, None)
            if callable(fn):
                try:
                    result = fn(event)
                    if isinstance(result, str):
                        return (result,)
                    return tuple(result or ())
                except Exception:
                    return ()
        return ()

    def handle_event(self, event):
        if event.type == pygame.KEYDOWN:
            actions = self._runtime_actions(event)
            action_map = {
                'MOVE_UP': 'up', 'MOVE_DOWN': 'down',
                'MOVE_LEFT': 'left', 'MOVE_RIGHT': 'right',
            }
            for i in range(self.player_count):
                for action, direction in action_map.items():
                    if f'P{i + 1}_{action}' in actions or f'PLAYER{i + 1}_{action}' in actions:
                        self._request_direction(i, direction)
            if not actions:
                for i, cfg in enumerate(self.player_configs):
                    if _mp_key_matches(event.key, cfg['bindings']['up']):
                        self._request_direction(i, 'up')
                    elif _mp_key_matches(event.key, cfg['bindings']['down']):
                        self._request_direction(i, 'down')
                    elif _mp_key_matches(event.key, cfg['bindings']['left']):
                        self._request_direction(i, 'left')
                    elif _mp_key_matches(event.key, cfg['bindings']['right']):
                        self._request_direction(i, 'right')
            if event.key in (pygame.K_ESCAPE,):
                return 'back'
            if event.key == pygame.K_p:
                self.paused = not self.paused
            if self.game_over and event.key == pygame.K_r:
                self.reset()
        return None

    def _request_direction(self, i, direction):
        vectors = {'up': (0, -1), 'down': (0, 1), 'left': (-1, 0), 'right': (1, 0)}
        new_dir = vectors[direction]
        cur = self.directions[i]
        if new_dir != (-cur[0], -cur[1]):
            self.next_directions[i] = new_dir

    def _new_head(self, i):
        if not self.alive[i]:
            return None
        hx, hy = self.snakes[i][0]
        dx, dy = self.next_directions[i]
        nx, ny = hx + dx, hy + dy
        if getattr(self.settings, 'wall_collision', True):
            if not (0 <= nx < self.board_width and 0 <= ny < self.board_height):
                return None
            return (nx, ny)
        return (nx % self.board_width, ny % self.board_height)

    def tick(self):
        if self.game_over or self.paused:
            return
        self.directions = list(self.next_directions)
        heads = [self._new_head(i) for i in range(self.player_count)]
        dead = [h is None for h in heads]

        obstacle_set = set(self.obstacles)
        body_occupied = set()
        for snake in self.snakes:
            body_occupied.update(snake[:-1])

        # Same-cell and crossing head collisions are fatal in competitive play.
        for i in range(self.player_count):
            hi = heads[i]
            if hi is None:
                continue
            if hi in obstacle_set or hi in body_occupied:
                dead[i] = True
            for j in range(i + 1, self.player_count):
                hj = heads[j]
                if hj is not None and (hi == hj or (hi == self.snakes[j][0] and hj == self.snakes[i][0])):
                    dead[i] = dead[j] = True

        ate = [False] * self.player_count
        for i, head in enumerate(heads):
            if dead[i]:
                continue
            head = self._teleport(head)
            heads[i] = head
            self.snakes[i].insert(0, head)
            if head == self.fruit_pos and not any(ate):
                ate[i] = True
                self.scores[i] += max(1, int(10 * 1000 / max(1, self.settings.update_rate_ms)))
            else:
                self.snakes[i].pop()

        if any(ate):
            _track_game_fruit(self, self.fruit_type)
            _trigger_mobile_haptic(30)
            self.fruit_pos = self._new_fruit()
            self.fruit_type = _pick_cosmetic_fruit_type(
                getattr(self.settings, 'fruit_types_enabled', True), self.cosmetic_rng)

        for i, d in enumerate(dead):
            if d:
                self.alive[i] = False

        if self.mode == 'coop':
            if not all(self.alive):
                self.game_over = True
                self.winner = 'coop_lose'
            elif self.fruit_pos is None:
                self.game_over = True
                self.winner = 'coop_win'
        else:
            alive = [i for i, flag in enumerate(self.alive) if flag]
            if len(alive) <= 1:
                self.game_over = True
                self.winner = alive[0] + 1 if alive else 'draw'
        if self.game_over:
            _trigger_mobile_haptic(90)
        self.mp_history.append(self._mp_snap())
        if self.game_over:
            self.save_match(source=getattr(self, 'save_source', 'local'))

    def _mp_snap(self):
        return {
            'snakes': [[list(c) for c in s] for s in self.snakes],
            'directions': [list(d) for d in self.directions],
            'next_directions': [list(d) for d in self.next_directions],
            'scores': list(self.scores),
            'alive': list(self.alive),
            'fruit': list(self.fruit_pos) if self.fruit_pos else None,
            'obstacles': [list(o) for o in self.obstacles],
            'game_over': self.game_over,
            'winner': self.winner,
            'board_width': self.board_width,
            'board_height': self.board_height,
            'mode': self.mode,
            'player_configs': _copy_json_safe(self.player_configs),
            'fruit_type': self.fruit_type,
        }

    def _mp_load_snap(self, snap):
        if not isinstance(snap, dict):
            return False
        snakes = snap.get('snakes')
        if not isinstance(snakes, list) or not (1 <= len(snakes) <= 4):
            return False
        player_count = len(snakes)
        bw, bh = snap.get('board_width'), snap.get('board_height')
        if type(bw) is not int or type(bh) is not int or not (5 <= bw <= 100 and 5 <= bh <= 100):
            return False
        area = bw * bh
        for snake in snakes:
            if not isinstance(snake, list) or len(snake) > area:
                return False
            if any(not _validate_net_cell(cell, bw, bh) for cell in snake):
                return False
        directions = snap.get('directions')
        next_directions = snap.get('next_directions', directions)
        if (not isinstance(directions, list) or len(directions) != player_count
                or not all(_validate_net_direction(d) for d in directions)
                or not isinstance(next_directions, list) or len(next_directions) != player_count
                or not all(_validate_net_direction(d) for d in next_directions)):
            return False
        scores = snap.get('scores')
        alive = snap.get('alive')
        if (not isinstance(scores, list) or len(scores) != player_count
                or any(not isinstance(score, (int, float)) or isinstance(score, bool)
                       or not (0 <= score <= 1_000_000_000) for score in scores)
                or not isinstance(alive, list) or len(alive) != player_count
                or not all(isinstance(flag, bool) for flag in alive)):
            return False
        fruit = snap.get('fruit')
        if fruit is not None and not _validate_net_cell(fruit, bw, bh):
            return False
        obstacles = snap.get('obstacles', [])
        if (not isinstance(obstacles, list) or len(obstacles) > area
                or any(not _validate_net_cell(cell, bw, bh) for cell in obstacles)):
            return False
        portals = snap.get('portals', [])
        if not _validate_net_map({'board_width': bw, 'board_height': bh,
                                  'obstacles': obstacles, 'portals': portals}):
            return False
        mode = snap.get('mode', self.mode)
        winner = snap.get('winner')
        if mode not in ('coop', '1v1') or (
                winner is not None and winner not in ('draw', 'coop_win', 'coop_lose')
                and (type(winner) is not int or not (1 <= winner <= player_count))):
            return False
        fruit_type = snap.get('fruit_type', 'regular')
        if not isinstance(fruit_type, str) or fruit_type not in FRUIT_COLORS:
            return False
        configs = snap.get('player_configs')
        if isinstance(configs, list):
            self.player_configs = _normalize_mp_player_configs(configs, player_count)
        self.player_count = player_count
        self.snakes = [[tuple(cell) for cell in snake] for snake in snakes]
        self.directions = [tuple(d) for d in directions]
        self.next_directions = [tuple(d) for d in next_directions]
        self.scores = list(scores)
        self.alive = list(alive)
        self.board_width = bw
        self.board_height = bh
        self.mode = mode
        self.fruit_pos = tuple(fruit) if fruit else None
        self.fruit_type = fruit_type
        self.obstacles = [tuple(cell) for cell in obstacles]
        self.portals = [tuple(portal) for portal in portals]
        self.game_over = bool(snap.get('game_over', False))
        self.winner = winner
        self.paused = False
        self._init_layout()
        return True

    def start_replay(self, history):
        if not isinstance(history, list) or not history or not isinstance(history[0], dict):
            return False
        self.replay_mode = True
        self.mp_history = history
        self.replay_index = 0
        self.replay_speed = 1.0
        self._replay_exit = False
        if not self._mp_load_snap(history[0]):
            self.replay_mode = False
            return False
        return True

    def run_replay(self):
        clock = pygame.time.Clock()
        paused = False
        last_step = time.monotonic() * 1000
        while not self._replay_exit:
            for event in pygame.event.get():
                if _legacy_nav_event(locals().get('self'), event, locals()):
                    continue
                if event.type == pygame.QUIT:
                    self._replay_exit = True
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_ESCAPE:
                        self._replay_exit = True
                    elif event.key == pygame.K_SPACE:
                        paused = not paused
                    elif event.key in (pygame.K_RIGHT, pygame.K_LEFT, pygame.K_HOME):
                        if event.key == pygame.K_HOME:
                            self.replay_index = 0
                        elif event.key == pygame.K_RIGHT:
                            self.replay_index = min(len(self.mp_history) - 1, self.replay_index + 1)
                        else:
                            self.replay_index = max(0, self.replay_index - 1)
                        self._mp_load_snap(self.mp_history[self.replay_index])
                    elif event.key in (pygame.K_PLUS, pygame.K_EQUALS):
                        self.replay_speed = min(8.0, self.replay_speed * 2)
                    elif event.key == pygame.K_MINUS:
                        self.replay_speed = max(0.125, self.replay_speed / 2)
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    self._init_layout()
            now = time.monotonic() * 1000
            step_ms = max(20, self.settings.update_rate_ms / max(0.125, self.replay_speed))
            if not paused and now - last_step >= step_ms:
                if self.replay_index < len(self.mp_history) - 1:
                    self.replay_index += 1
                    self._mp_load_snap(self.mp_history[self.replay_index])
                last_step = now
            self.draw()
            tag = get_font(self.settings.language, 'bold', 16).render(
                f"● REPLAY  {self.replay_index + 1}/{len(self.mp_history)}  "
                f"x{self.replay_speed:g}  [Space pause  ←/→ step  +/- speed  ESC exit]",
                True, (255, 200, 80))
            self.screen.blit(tag, (10, self.screen.get_height() - 24))
            _legacy_nav_draw(locals().get('self'))
            pygame.display.flip()
            clock.tick(60)

    def draw(self):
        background_color, _board_color, _grid_color = _map_theme_colors(self.settings)
        self.screen.fill(background_color)
        self._draw_board()
        self._draw_hud()
        for i in range(self.player_count):
            body, head = self.PLAYER_COLORS[i]
            self._draw_snake(self.snakes[i], body, head, self.alive[i])
        if self.game_over:
            f = get_font(self.settings.language, 'bold', 28)
            label = "Draw" if self.winner == 'draw' else (
                "Co-op lost" if self.winner == 'coop_lose' else
                "Co-op won" if self.winner == 'coop_win' else
                f"{self.player_configs[self.winner - 1]['name']} wins!"
            )
            s = render_fit(f, label, COLORS['white'], self.screen.get_width() - 40)
            self.screen.blit(s, s.get_rect(center=(self.screen.get_width() // 2,
                                                    self.screen.get_height() - 62)))
            _draw_replay_save_widget(self.screen, self.settings.language,
                                        getattr(self, '_replay_save_game_id', None),
                                        self.screen.get_width() // 2, 8)

    def _draw_mobile_pause(self):
        sw, sh = self.screen.get_size()
        overlay = pygame.Surface((sw, sh), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 150))
        self.screen.blit(overlay, (0, 0))
        title = get_font(self.settings.language, 'bold', 44).render(
            get_text(self.settings.language, 'paused').upper(), True, COLORS['white'])
        hint = get_font(self.settings.language, 'regular', 20).render(
            get_text(self.settings.language, 'press_p_to_resume'), True, (190, 205, 230))
        self.screen.blit(title, title.get_rect(center=(sw // 2, sh // 2 - 22)))
        self.screen.blit(hint, hint.get_rect(center=(sw // 2, sh // 2 + 28)))

    def _draw_hud(self):
        f = get_font(self.settings.language, 'bold', 17)
        title = f"{self.mode.upper()} • {self.player_count} PLAYERS"
        self.screen.blit(f.render(title, True, COLORS['white']), (10, 8))
        x = 10
        for i in range(self.player_count):
            c = self.PLAYER_COLORS[i][0]
            label = f"{self.player_configs[i]['name']}: {self.scores[i]}"
            s = f.render(label, True, c if self.alive[i] else (100, 100, 100))
            self.screen.blit(s, (x, 34))
            x += min(190, self.screen.get_width() // max(1, self.player_count))

    def _draw_board(self):
        bx, by = self.board_offset_x, self.board_offset_y
        _background_color, board_color, grid_color = _map_theme_colors(self.settings)
        bw_px, bh_px = self.board_width * self.cell_size, self.board_height * self.cell_size
        pygame.draw.rect(self.screen, board_color,
                         pygame.Rect(bx, by, self.board_width * self.cell_size,
                                     self.board_height * self.cell_size))
        for x in range(self.board_width + 1):
            pygame.draw.line(self.screen, grid_color,
                             (bx + x * self.cell_size, by),
                             (bx + x * self.cell_size, by + bh_px), 1)
        for y in range(self.board_height + 1):
            pygame.draw.line(self.screen, grid_color,
                             (bx, by + y * self.cell_size),
                             (bx + bw_px, by + y * self.cell_size), 1)
        for o in self.obstacles:
            x, y = o
            pygame.draw.rect(self.screen, COLORS['obstacle'],
                             pygame.Rect(bx + x * self.cell_size, by + y * self.cell_size,
                                         self.cell_size, self.cell_size))
        if self.fruit_pos:
            fr = pygame.Rect(bx + self.fruit_pos[0] * self.cell_size,
                             by + self.fruit_pos[1] * self.cell_size,
                             self.cell_size, self.cell_size)
            draw_fruit(self.screen, fr, self.fruit_type)
        for p in self.portals:
            for x, y in ((p[0], p[1]), (p[2], p[3])):
                pygame.draw.rect(self.screen, COLORS['portal1'],
                                 pygame.Rect(bx + x*self.cell_size, by + y*self.cell_size,
                                             self.cell_size, self.cell_size), width=max(1, self.cell_size//5))

    def _draw_snake(self, snake, body, head, alive):
        bx, by = self.board_offset_x, self.board_offset_y
        alpha_body = body if alive else tuple(max(40, c // 3) for c in body)
        for j, (x, y) in enumerate(snake):
            rect = pygame.Rect(bx + x*self.cell_size + 1, by + y*self.cell_size + 1,
                               max(2, self.cell_size - 2), max(2, self.cell_size - 2))
            pygame.draw.rect(self.screen, head if j == 0 and alive else alpha_body, rect, border_radius=3)

    def save_match(self, source='local'):
        """Persist a completed 1-4 player local match using the existing save format."""
        if self._match_saved or not self.mp_history:
            return
        self._match_saved = True
        _award_game_xp(self, source)
        game_id = f"mp-{int(time.time())}-{self.rng.randint(1000, 9999)}"
        names = [cfg['name'] for cfg in self.player_configs]
        entry = {
                'name': " vs ".join(names) if self.mode == '1v1' else " + ".join(names),
                'score': max(self.scores) if self.scores else 0,
                'date': datetime.now().strftime('%Y-%m-%d %H:%M'),
                'timestamp': datetime.now().isoformat(),
                'board_size': self.board_width,
                'update_rate_ms': self.settings.update_rate_ms,
                'victory': False,
                'wall_collision': self.settings.wall_collision,
                'powerups_enabled': False,
                'fruit_types_enabled': getattr(self.settings, 'fruit_types_enabled', True),
                'obstacles_enabled': getattr(self.settings, 'enable_obstacles', False),
                'portals_enabled': bool(self.portals),
                'portal_pairs': len(self.portals),
                'game_id': game_id,
                'seed': self.seed,
                'has_replay': False,
                'settings': {
                    k: v for k, v in vars(self.settings).items()
                    if isinstance(v, (int, float, str, bool, list, dict)) and v is not None
                },
                'is_multiplayer': True,
                'mp_mode': self.mode,
                'mp_source': source,
                'player_count': self.player_count,
                'player_names': names,
                'player_configs': _copy_json_safe(self.player_configs),
                'player_scores': list(self.scores),
                'winner': self.winner,
                'custom_map': self.custom_map,
                'actual_board_width': self.board_width,
                'actual_board_height': self.board_height,
        }
        if getattr(self, '_mp_history_truncated', False):
            entry['replay_truncated'] = True
        self._replay_save_game_id = _queue_completed_score(
            entry, self.mp_history, max_records=50)

    def run(self):
        clock = pygame.time.Clock()
        while True:
            for event in pygame.event.get():
                if _handle_replay_save_retry_event(self, event):
                    continue
                if _is_app_background_event(event):
                    self.paused = True
                    if getattr(self, 'runtime', None) is not None:
                        self.runtime.set_game_paused(True, {'game': 'local_multiplayer'})
                    continue
                if event.type == pygame.QUIT:
                    pygame.quit(); sys.exit()
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    self._init_layout()
                else:
                    action = self.handle_event(event)
                    if (event.type == pygame.KEYDOWN and event.key == pygame.K_p
                            and getattr(self, 'runtime', None) is not None):
                        self.runtime.set_game_paused(self.paused, {'game': 'local_multiplayer'})
                    if action == 'back':
                        return None
            if not self.game_over and not self.paused:
                now = time.time() * 1000
                step = max(20, int(self.settings.update_rate_ms))
                while now - self.last_tick >= step:
                    self.last_tick += step
                    self.tick()
                    if self.game_over:
                        break
            self.draw()
            if self.paused and not self.game_over:
                self._draw_mobile_pause()
            pygame.display.flip()
            clock.tick(60)
        return None



class MultiplayerAccessScreen:
    """Choose a multiplayer transport before opening its dedicated setup."""

    def __init__(self, settings, screen):
        self.settings, self.screen = settings, screen

    def run(self):
        selected = {'value': None}
        screen_ref = {'screen': None}

        def select(value):
            selected['value'] = value
            if screen_ref['screen'] is not None:
                screen_ref['screen']._go_back()

        entries = []
        for key, translation_key, color in (
                ('network', 'network_play', (30, 90, 175)),
                ('lan', 'lan_play', (25, 125, 100)),
                ('local', 'local_play', (115, 75, 155))):
            entries.append((key, lambda key=translation_key: get_text(
                self.settings.language, key), color,
                            lambda value=key: select(value)))
        screen = _SimpleMenuScreen(
            self.settings, self.screen,
            lambda: get_text(self.settings.language, 'multiplayer_local_title'),
            entries,
            body_fn=lambda: get_text(self.settings.language, 'multiplayer_transport_help'))
        screen_ref['screen'] = screen
        screen.run()
        return selected['value']


