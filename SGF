        current_time = self._sim_time_ms
        font = get_font(self.settings.language, 'regular', 16)
        y_offset = 120  # Start below pause button
        
        for powerup in self.active_powerups:
            # Get power-up name and color
            if powerup['type'] == 'speed_boost':
                name = get_text(self.settings.language, 'speed_boost')
                color = COLORS['powerup_speed_boost']
            elif powerup['type'] == 'slow_motion':
                name = get_text(self.settings.language, 'slow_motion')
                color = COLORS['powerup_slow_motion']
            elif powerup['type'] == 'size_reduction':
                name = get_text(self.settings.language, 'size_reduction')
                color = COLORS['powerup_size_reduction']
            elif powerup['type'] == 'invincibility':
                name = get_text(self.settings.language, 'invincibility')
                color = COLORS['powerup_invincibility']
            elif powerup['type'] == 'double_points':
                name = get_text(self.settings.language, 'double_points')
                color = COLORS['powerup_double_points']
            elif powerup['type'] == 'ghost_mode':
                name = get_text(self.settings.language, 'ghost_mode') or "Ghost Mode"
