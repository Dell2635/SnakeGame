# Font object cache (final pygame.font.Font instances, keyed by language+style+size)
font_cache = {}
_FONT_CACHE_MAX = 256


def _lru_cache_get(cache, key):
    """Return (value, found) and refresh a dict-backed LRU entry."""
    if key not in cache:
        return None, False
    value = cache.pop(key)
    cache[key] = value
    return value, True


def _lru_cache_put(cache, key, value, max_items):
    """Insert into an insertion-ordered dict, evicting the least-recent item."""
    cache.pop(key, None)
    while len(cache) >= max(1, int(max_items)):
        cache.pop(next(iter(cache)))
    cache[key] = value

