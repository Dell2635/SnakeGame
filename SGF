def get_text(language_code, key):
    """Get text in the specified language"""
    # Get the language dictionary
    lang_dict = TRANSLATIONS.get(language_code, TRANSLATIONS['en'])
    
    # Return the text for the key, or fallback to English
    text = lang_dict.get(key, TRANSLATIONS['en'].get(key, f"[Missing: {key}]"))
    if isinstance(text, str) and '\u2713' in text:
        # Catalog strings use U+2713; draw whichever mark the fonts support.
        text = text.replace('\u2713', safe_mark(language_code, 'check'))
    return text


