    """Create the optional process RSS reader once; keep it for later samples."""
    global _DEV_PSUTIL_PROCESS, _DEV_PSUTIL_PROCESS_CHECKED
    if not _DEV_PSUTIL_PROCESS_CHECKED:
        _DEV_PSUTIL_PROCESS_CHECKED = True
        try:
            if process_factory is None:
                import psutil as _psutil
                process_factory = _psutil.Process
            _DEV_PSUTIL_PROCESS = process_factory()
        except Exception:
            _DEV_PSUTIL_PROCESS = None
    return _DEV_PSUTIL_PROCESS


def _dev_get_memory_bytes():
    """Best-effort current process RSS. Returns None rather than inventing."""
    try:
        if sys.platform.startswith('linux'):
            with open('/proc/self/status', 'r', encoding='utf-8', errors='replace') as f:
                for line in f:
                    if line.startswith('VmRSS:'):
                        parts = line.split()
                        return int(parts[1]) * 1024 if len(parts) >= 2 else None
        if sys.platform == 'win32':
            process = _dev_cached_psutil_process()
            if process is None:
                return None
            try:
                return int(process.memory_info().rss)
            except Exception:
                return None
        try:
            import resource as _resource
            rss = int(_resource.getrusage(_resource.RUSAGE_SELF).ru_maxrss)
            # Linux reports KiB, macOS reports bytes.
            return rss if sys.platform == 'darwin' else rss * 1024
        except Exception:
            return None
    except Exception:
        return None


def _dev_process_cpu_percent(prev_cpu, prev_wall, now_cpu=None, now_wall=None):
    if prev_cpu is None or prev_wall is None:
        return None, now_cpu or time.process_time(), now_wall or time.perf_counter()
    now_cpu = time.process_time() if now_cpu is None else now_cpu
    now_wall = time.perf_counter() if now_wall is None else now_wall
    wall = now_wall - prev_wall
    if wall <= 0:
        return None, now_cpu, now_wall
    # Process CPU percentage normalized to one CPU core.  This is portable and
    # clearly reflects process CPU time; it is not a hardware-wide utilisation.
    return max(0.0, min(10000.0, (now_cpu - prev_cpu) / wall * 100.0)), now_cpu, now_wall


def _dev_graph_points(rows, metric, *, now, duration, width, height, low, high):
    """Map sparse samples onto a fixed elapsed-time axis, not the sample count."""
    width, height = max(1, int(width)), max(1, int(height))
    duration = max(1e-6, float(duration))
    low, high = float(low), float(high)
    span = max(1e-6, high - low)
    start = float(now) - duration
    buckets = {}
    for row in rows:
        value = row.get(metric)
        if value is None:
            continue
        try:
            elapsed = float(row.get('t', 0.0))
            value = float(value)
        except (TypeError, ValueError):
            continue
        if not math.isfinite(elapsed) or not math.isfinite(value):
            continue
        x = int((elapsed - start) / duration * max(1, width - 1))
        if 0 <= x < width:
            y = height - 1 - int((value - low) / span * max(1, height - 1))
            buckets[x] = max(0, min(height - 1, y))
    return [(x, buckets[x]) for x in sorted(buckets)]


class DevTelemetry:
    """Lightweight always-on sampling plus opt-in deep performance diagnostics."""
    MAX_SECONDS = 60.0
    SAMPLE_LIMIT = 720  # ten samples per second with modest rollover headroom
    METRICS = (
        'fps', 'frame_ms', 'cpu_percent', 'memory_mb', 'allocation_mb_s',
        'update_ms', 'render_ms', 'input_ms', 'other_ms', 'gc_ms',
        'frame_spikes', 'max_frame_ms', 'loaded_assets', 'active_entities',
        'particles', 'ai_ms', 'replay_ms', 'ui_ms',
    )

    def __init__(self):
        self.enabled = False
        self._owns_tracemalloc = False
        self.started_at = time.perf_counter()
        self.last_sample_at = 0.0
        self.samples = _deque_mod(maxlen=self.SAMPLE_LIMIT)
        self.loading = _deque_mod(maxlen=128)
        self.spikes = _deque_mod(maxlen=128)
        self.recent_frames = _deque_mod(maxlen=600)
        self.incidents = _deque_mod(maxlen=32)
        self.save_samples = _deque_mod(maxlen=128)
        self._last_incident_at = 0.0
        self.gc_samples = _deque_mod(maxlen=self.SAMPLE_LIMIT)
        self._prev_cpu = None
        self._prev_wall = None
        self._prev_alloc = None
        self.max_frame_ms = 0.0
        self.total_frames = 0
        self._tick = 0
        self._gc_start = None
        self._gc_elapsed_ms = 0.0

    def activate(self):
        if self.enabled:
            return
        self.enabled = True
        self.last_sample_at = time.perf_counter()
        self._prev_cpu = time.process_time()
        self._prev_wall = self.last_sample_at
        self._prev_alloc = None
        try:
            if self._gc_callback not in _gc_mod.callbacks:
                _gc_mod.callbacks.append(self._gc_callback)
        except Exception:
            pass
        self._owns_tracemalloc = False
        try:
            if not _tracemalloc_mod.is_tracing():
                _tracemalloc_mod.start(8)
                self._owns_tracemalloc = _tracemalloc_mod.is_tracing()
            self._prev_alloc = _tracemalloc_mod.get_traced_memory()[0]
        except Exception:
            self._prev_alloc = None

    def deactivate(self):
        self.enabled = False
        try:
            while self._gc_callback in _gc_mod.callbacks:
                _gc_mod.callbacks.remove(self._gc_callback)
        except Exception:
            pass
        if self._owns_tracemalloc:
            try:
                if _tracemalloc_mod.is_tracing():
                    _tracemalloc_mod.stop()
            except Exception:
                pass
        self._owns_tracemalloc = False
        self._prev_alloc = None
        self._gc_start = None
        self._gc_elapsed_ms = 0.0

    def _gc_callback(self, phase, info):
        if not self.enabled:
            return
        if phase == 'start':
            if self._gc_start is None:
                self._gc_start = time.perf_counter()
        elif phase == 'stop' and self._gc_start is not None:
            elapsed_ms = max(0.0, (time.perf_counter() - self._gc_start) * 1000.0)
            self._gc_elapsed_ms = min(10000.0, self._gc_elapsed_ms + elapsed_ms)
            self.gc_samples.append({
                't': time.perf_counter() - self.started_at,
                'gc_ms': elapsed_ms,
                'generation': (info or {}).get('generation'),
            })
            self._gc_start = None

    def record_loading(self, name, duration_ms):
        if not self.enabled:
            return
        self.loading.append({
            'time': time.time(), 'name': str(name),
            'duration_ms': max(0.0, float(duration_ms)),
        })

    def record_save_phase(self, phase, duration_ms):
        """Keep bounded save timings in memory for explicit diagnostics export."""
        duration_ms = max(0.0, float(duration_ms))
        slow = duration_ms >= _REPLAY_SAVE_SLOW_THRESHOLD_MS
        row = {
            't': max(0.0, time.perf_counter() - self.started_at),
            'time': time.time(), 'phase': str(phase),
            'duration_ms': duration_ms, 'slow': slow,
        }
        self.save_samples.append(row)
        if slow:
            self.incidents.append({
                't': row['t'], 'duration_ms': duration_ms,
                'subsystem': 'save', 'phase': str(phase),
                'recent_frames': list(self.recent_frames),
            })

    def _sample_system(self):
        now = time.perf_counter()
        cpu, self._prev_cpu, self._prev_wall = _dev_process_cpu_percent(
            self._prev_cpu, self._prev_wall, time.process_time(), now)
        mem = _dev_get_memory_bytes()
        alloc_rate = None
        try:
            if _tracemalloc_mod.is_tracing():
                current = _tracemalloc_mod.get_traced_memory()[0]
                if self._prev_alloc is not None:
                    elapsed = max(0.001, now - self.last_sample_at)
                    alloc_rate = max(-9999.0, (current - self._prev_alloc) / elapsed / 1024.0 / 1024.0)
                self._prev_alloc = current
        except Exception:
            alloc_rate = None
        return cpu, mem, alloc_rate

    def record_frame(self, frame_ms, *, update_ms=0.0, render_ms=0.0,
                     input_ms=0.0, gc_ms=0.0, ai_ms=0.0, replay_ms=0.0,
                     ui_ms=0.0, loaded_assets=None, active_entities=None,
                     particles=None):
        frame_ms = max(0.0, float(frame_ms))
        update_ms = max(0.0, float(update_ms))
        render_ms = max(0.0, float(render_ms))
        input_ms = max(0.0, float(input_ms))
        if gc_ms <= 0.0 and self._gc_elapsed_ms > 0.0:
            gc_ms = self._gc_elapsed_ms
            self._gc_elapsed_ms = 0.0
        gc_ms = max(0.0, float(gc_ms))
        ai_ms = max(0.0, float(ai_ms))
        replay_ms = max(0.0, float(replay_ms))
        ui_ms = max(0.0, float(ui_ms))
        other_ms = max(0.0, frame_ms - update_ms - render_ms - input_ms - gc_ms - ui_ms)
        fps = (1000.0 / frame_ms) if frame_ms > 0.0 else 0.0
        now = time.perf_counter()
        self._tick += 1
        self.total_frames += 1
        self.max_frame_ms = max(self.max_frame_ms, frame_ms)
        if frame_ms >= 20.0:
            self.spikes.append({
                't': now - self.started_at, 'frame_ms': frame_ms,
                'tick': self.total_frames,
                'update_ms': update_ms, 'render_ms': render_ms,
                'input_ms': input_ms,
            })
        frame_record = {
            't': now - self.started_at, 'frame_ms': frame_ms,
            'update_ms': update_ms, 'render_ms': render_ms,
            'input_ms': input_ms, 'ai_ms': ai_ms, 'replay_ms': replay_ms,
        }
        self.recent_frames.append(frame_record)
        # Keep the last ten seconds in memory and snapshot only severe stalls;
        # no incident causes automatic disk writes or unbounded growth.
        if frame_ms >= 50.0 and now - self._last_incident_at >= 2.0:
            self.incidents.append({
                't': frame_record['t'], 'duration_ms': frame_ms,
                'subsystem': ('AI' if ai_ms >= frame_ms * .5 else
                              'render' if render_ms >= frame_ms * .5 else
                              'update' if update_ms >= frame_ms * .5 else 'frame'),
                'recent_frames': list(self.recent_frames),
            })
            self._last_incident_at = now
        # Keep one point per 100 ms, independent of DEV panel visibility.
        if self.samples and now - self.last_sample_at < 0.10:
            return
        cpu, mem_bytes, alloc_rate = self._sample_system()
        self.last_sample_at = now
        sample = {
            't': now - self.started_at,
            'fps': fps,
            'frame_ms': frame_ms,
            'cpu_percent': cpu,
            'memory_bytes': mem_bytes,
            'memory_mb': (mem_bytes / 1024.0 / 1024.0) if mem_bytes is not None else None,
            'allocation_mb_s': alloc_rate,
            'update_ms': update_ms,
            'render_ms': render_ms,
            'input_ms': input_ms,
            'other_ms': other_ms,
            'gc_ms': gc_ms,
            'ai_ms': ai_ms,
            'replay_ms': replay_ms,
            'ui_ms': ui_ms,
            'loaded_assets': (int(loaded_assets) if loaded_assets is not None else None),
            'active_entities': (int(active_entities) if active_entities is not None else None),
            'particles': (int(particles) if particles is not None else None),
        }
        self.samples.append(sample)

    def metric_values(self, metric):
        # Anchor the rolling window to wall time, not the last sample. This
        # keeps the graph's 60-second axis fixed while the application is idle.
        now = time.perf_counter() - self.started_at
        cutoff = now - self.MAX_SECONDS
        rows = []
        for sample in reversed(self.samples):
            if sample.get('t', 0.0) < cutoff:
                break
            if sample.get(metric) is not None:
                rows.append(sample)
        rows.reverse()
        return rows

    def metric_summary(self, metric):
        rows = self.metric_values(metric)
        vals = [float(r[metric]) for r in rows]
        if not vals:
            return {'current': None, 'average': None, 'minimum': None, 'maximum': None,
                    'low_1': None, 'low_0_1': None, 'count': 0}
        sorted_vals = sorted(vals)
        n = len(sorted_vals)
        low_1 = sum(sorted_vals[:max(1, n // 100)]) / max(1, n // 100)
        low_01 = sum(sorted_vals[:max(1, n // 1000)]) / max(1, n // 1000)
        if metric == 'fps':
            # For FPS, low values are the first sorted values.
            pass
        elif metric == 'frame_ms':
            # For milliseconds, "lows" are traditionally long-frame tails.
            slow = sorted(vals, reverse=True)
            low_1 = sum(slow[:max(1, n // 100)]) / max(1, n // 100)
            low_01 = sum(slow[:max(1, n // 1000)]) / max(1, n // 1000)
        return {
            'current': vals[-1], 'average': sum(vals) / len(vals),
            'minimum': min(vals), 'maximum': max(vals),
            'low_1': low_1, 'low_0_1': low_01, 'count': n,
        }

    def snapshot(self):
        rows = list(self.samples)
        latest = rows[-1] if rows else {}
        return {
            'fps': self.metric_summary('fps'),
            'frame_ms': self.metric_summary('frame_ms'),
            'cpu_percent': self.metric_summary('cpu_percent'),
            'memory_mb': self.metric_summary('memory_mb'),
            'allocation_mb_s': self.metric_summary('allocation_mb_s'),
            'update_ms': self.metric_summary('update_ms'),
            'render_ms': self.metric_summary('render_ms'),
            'input_ms': self.metric_summary('input_ms'),
            'other_ms': self.metric_summary('other_ms'),
            'gc_ms': self.metric_summary('gc_ms'),
            'ai_ms': self.metric_summary('ai_ms'),
            'replay_ms': self.metric_summary('replay_ms'),
            'ui_ms': self.metric_summary('ui_ms'),
            'frame_spikes': len(self.spikes),
            'incident_count': len(self.incidents),
            'recent_incidents': list(self.incidents)[-6:],
            'max_frame_ms': self.max_frame_ms,
            'loaded_assets': latest.get('loaded_assets', 0),
            'active_entities': latest.get('active_entities', 0),
            'particles': latest.get('particles', 0),
            'sample_count': len(rows),
        }

    def export_csv(self, path, metric='frame_ms'):
        rows = self.metric_values(metric)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'w', newline='', encoding='utf-8') as f:
            w = _csv_mod.writer(f)
            w.writerow(['seconds_from_dev_start', metric])
            for row in rows:
                w.writerow([f"{row.get('t', 0.0):.6f}", row.get(metric)])

    def clear(self):
        self.samples.clear(); self.spikes.clear(); self.loading.clear()
        self.recent_frames.clear(); self.incidents.clear(); self._last_incident_at = 0.0
        self.gc_samples.clear(); self.max_frame_ms = 0.0; self.total_frames = 0
        self.last_sample_at = time.perf_counter()
        self.started_at = self.last_sample_at


_DEV_WORKSPACE_DEFAULT_LAYOUT = {'x': 0.08, 'y': 0.08, 'w': 0.84, 'h': 0.84}


def _normalize_dev_workspace_layout(value):
    if not isinstance(value, dict):
        return dict(_DEV_WORKSPACE_DEFAULT_LAYOUT)
    result = {}
    for key in ('x', 'y', 'w', 'h'):
        try:
            number = float(value.get(key, _DEV_WORKSPACE_DEFAULT_LAYOUT[key]))
        except (TypeError, ValueError, OverflowError):
            number = _DEV_WORKSPACE_DEFAULT_LAYOUT[key]
        if not math.isfinite(number):
            number = _DEV_WORKSPACE_DEFAULT_LAYOUT[key]
        result[key] = number
    result['w'] = max(0.45, min(1.0, result['w']))
    result['h'] = max(0.45, min(1.0, result['h']))
    result['x'] = max(0.0, min(1.0 - result['w'], result['x']))
    result['y'] = max(0.0, min(1.0 - result['h'], result['y']))
    return result


def _dev_workspace_rect(layout, screen_size):
    layout = _normalize_dev_workspace_layout(layout)
    sw, sh = max(1, int(screen_size[0])), max(1, int(screen_size[1]))
    width = max(min(sw, 480), min(sw, int(round(sw * layout['w']))))
    height = max(min(sh, 320), min(sh, int(round(sh * layout['h']))))
    x = max(0, min(sw - width, int(round(sw * layout['x']))))
    y = max(0, min(sh - height, int(round(sh * layout['y']))))
    return pygame.Rect(x, y, width, height)


def _dev_workspace_layout_for_rect(rect, screen_size):
    sw, sh = max(1, int(screen_size[0])), max(1, int(screen_size[1]))
    rect = pygame.Rect(rect)
    width = max(1, min(sw, rect.w))
    height = max(1, min(sh, rect.h))
    x = max(0, min(sw - width, rect.x))
    y = max(0, min(sh - height, rect.y))
    return _normalize_dev_workspace_layout({
        'x': x / sw, 'y': y / sh, 'w': width / sw, 'h': height / sh,
    })


class DevStateManager:
    """Persistent developer unlock + cheat presets; gameplay state is not saved."""
    def __init__(self):
        self.unlocked = bool(DEBUG_MODE)
        self.presets = {}
        self.last_easter_egg = None
        self.workspace_layout = dict(_DEV_WORKSPACE_DEFAULT_LAYOUT)
        self.load()

    def load(self):
        try:
            gd = _load_data()
            data = gd.get('developer', {}) if isinstance(gd, dict) else {}
            if isinstance(data, dict):
                self.unlocked = bool(data.get('dev_mode_unlocked', self.unlocked)) or DEBUG_MODE
                self.presets = data.get('presets', {}) if isinstance(data.get('presets', {}), dict) else {}
                self.last_easter_egg = data.get('last_easter_egg')
                self.workspace_layout = _normalize_dev_workspace_layout(
                    data.get('workspace_layout'))
        except Exception:
            pass

    def save(self):
        try:
            gd = _load_data()
            gd['developer'] = {
                'dev_mode_unlocked': bool(self.unlocked),
                'presets': copy.deepcopy(self.presets),
                'last_easter_egg': self.last_easter_egg,
                'workspace_layout': _normalize_dev_workspace_layout(
                    self.workspace_layout),
            }
            _save_data(gd)
        except Exception as exc:
            try: sgf_log.warning(f'Dev state save failed: {exc}')
            except Exception: pass

    def unlock(self):
        if self.unlocked:
            return False
        self.unlocked = True
        self.save()
        return True

    def save_preset(self, name, cheats, toggles, time_scale):
        self.presets[str(name)] = {
            'cheats': {k: bool(v) for k, v in cheats.items() if k in DEV_CHEATS},
            'toggles': {k: bool(v) for k, v in toggles.items() if k in DEV_TOGGLES},
            'time_scale': float(time_scale),
        }
        self.save()


class DevTools:
    """Session-local developer suite coordinating telemetry, cheats, and UI."""
    def __init__(self):
        self.state = DevStateManager()
        self.telemetry = DevTelemetry()
        self.active = False
        self.current_game = None
        self.current_panel = None
        self.cheats = {k: False for k in DEV_CHEATS}
        self.toggles = {k: False for k in DEV_TOGGLES}
        self.time_scale = 1.0
        self.forced_item = None
        self.forced_powerup = None
        self.force_event_name = 'GAME_OVER'
        self.rainbow_phase = 0.0
        self.modified_reason = set()
        self.runtime_toasts = _deque_mod(maxlen=8)
        self._fruit_rain_clock = 0.0
        self._next_preview = None
        self._confirm_action = None
        self.ai_debug_history = _deque_mod(maxlen=256)
        self.ai_benchmark_results = None
        self.trail_points = _deque_mod(maxlen=96)
        self._diagnostic_stats_cache = {}
        self.replay_dev_modified = False
        self.replay_verified = None
        self.determinism_status = 'NOT VERIFIED'
        self._one_shot_cheats = {'spawn_item','force_next_item','teleport','set_length','set_score','set_seed','force_event'}
        # Quick-hide for the in-game debug overlay (hitboxes/grid/FPS/etc.) so
        # it doesn't have to obstruct gameplay — toggled by F9 or by clicking
        # the small [DEV -] / [DEV +] tab drawn in the corner, handled
        # centrally in _legacy_nav_event. The small red "modified" indicator
        # (draw_dev_indicator) is intentionally NOT affected by this: it's an
        # integrity signal (also shown on replays) and should stay visible.
        self.overlay_hidden = False
        self._overlay_toggle_rect = None

    def toggle_overlay_hidden(self):
        self.overlay_hidden = not self.overlay_hidden

    def _cached_diagnostic_stats(self, key, ttl_seconds, build):
        now = time.monotonic()
        cached = self._diagnostic_stats_cache.get(key)
        if cached is not None and now - cached[0] < ttl_seconds:
            return cached[1]
        value = build()
        self._diagnostic_stats_cache[key] = (now, value)
        return value

    @property
    def unlocked(self):
        return self.state.unlocked

    @property
    def modified(self):
        return bool(self.modified_reason or any(self.cheats.values()) or any(self.toggles.values()))

    def set_active(self, value=True):
        self.active = bool(value)
        if self.active:
            self.telemetry.activate()
        elif not self.modified:
            self.telemetry.deactivate()

    def register_game(self, game):
        self.current_game = game
        try:
            if hasattr(game, 'speed_multiplier') and not hasattr(game, '_dev_base_speed_multiplier'):
                game._dev_base_speed_multiplier = float(getattr(game, 'speed_multiplier', 1.0))
            if hasattr(game, 'points_multiplier') and not hasattr(game, '_dev_base_points_multiplier'):
                game._dev_base_points_multiplier = float(getattr(game, 'points_multiplier', 1.0))
            setattr(game, 'dev_tools', self)
        except Exception:
            pass

    def clear_game(self, game=None):
        if game is None or self.current_game is game:
            self.current_game = None

    def toast(self, message, seconds=2.0):
        self.runtime_toasts.append({'message': str(message), 'until': time.time() + seconds})

    def mark_modified(self, reason):
        self.modified_reason.add(str(reason))
        self.set_active(True)

    def toggle(self, name):
        if name not in self.cheats and name not in self.toggles:
            return False
        # Action-style cheats are one-shot tools rather than persistent toggles.
        if name in self._one_shot_cheats:
            action_map = {
                'spawn_item': self.spawn_item,
                'force_next_item': lambda: self.force_next_item(getattr(self.current_game, 'current_fruit_type', 'regular')),
                'teleport': self.teleport,
                'set_length': lambda: self.set_length(20),
                'set_score': lambda: self.set_score(1000),
                'set_seed': lambda: self.set_seed('DEV-SEED'),
                'force_event': self.force_event,
            }
            ok = bool(action_map[name]())
            if ok:
                self.mark_modified(name)
            return ok
        container = self.cheats if name in self.cheats else self.toggles
        container[name] = not container[name]
        if container[name]:
            self.mark_modified(name)
        else:
            self.modified_reason.discard(name)
        self._apply_persistent_flags()
        return container[name]

    def set_cheat(self, name, value=True):
        if name not in self.cheats:
            return
        self.cheats[name] = bool(value)
        if value:
            self.mark_modified(name)
        else:
            self.modified_reason.discard(name)
        self._apply_persistent_flags()

    def reset_all(self):
        self.cheats = {k: False for k in DEV_CHEATS}
        self.toggles = {k: False for k in DEV_TOGGLES}
        self.time_scale = 1.0
        self.forced_item = None
        self.forced_powerup = None
        self.modified_reason.clear()
        self._apply_persistent_flags()
        if not self.active:
            self.telemetry.deactivate()

    def _apply_persistent_flags(self):
        g = self.current_game
        if g is None:
            return
        try:
            g.invincible = bool(self.cheats['no_death'] or self.cheats['invincible_powerups'])
            g._dev_no_wall_collision = bool(self.cheats['no_wall_collision'])
            g._dev_no_death = bool(self.cheats['no_death'])
            g._dev_time_scale = float(self.time_scale)
            g.ghost_mode = bool(self.cheats['ghost_snake'])
            if self.cheats['speed_boost']:
                g.speed_multiplier = 0.5
            elif self.cheats['slow_motion']:
                g.speed_multiplier = 2.0
            elif self.cheats['speed_ramp']:
                g.speed_multiplier = max(0.2, 1.0 - min(0.8, len(getattr(g, 'snake', [])) * 0.01))
            elif hasattr(g, 'speed_multiplier'):
                g.speed_multiplier = getattr(g, '_dev_base_speed_multiplier', getattr(g, 'speed_multiplier', 1.0))
            if self.cheats['double_score']:
                g.points_multiplier = 2.0
            elif hasattr(g, 'points_multiplier'):
                g.points_multiplier = getattr(g, '_dev_base_points_multiplier', getattr(g, 'points_multiplier', 1.0))
            if self.cheats['infinite_score']:
                if hasattr(g, 'score'): g.score = max(int(getattr(g, 'score', 0)), 999999999)
                if hasattr(g, 'p1_score'): g.p1_score = max(int(getattr(g, 'p1_score', 0)), 999999999)
            if self.cheats['giant_snake']:
                g._dev_segment_scale = 1.45
            elif self.cheats['tiny_snake']:
                g._dev_segment_scale = 0.65
            else:
                g._dev_segment_scale = 1.0
        except Exception:
            pass

    def apply_frame_cheats(self, game):
        """Apply cheap, reversible cheat effects around a simulation frame."""
        if not (self.active or self.modified) or game is None:
            return
        try:
            if hasattr(game, 'score') and self.cheats.get('infinite_score'):
                game.score = max(int(getattr(game, 'score', 0)), 999999999)
            if hasattr(game, 'p1_score') and self.cheats.get('infinite_score'):
                game.p1_score = max(int(getattr(game, 'p1_score', 0)), 999999999)

            if hasattr(game, 'snake') and game.snake:
                current_len = len(game.snake)
                if self.cheats.get('infinite_length'):
                    self._infinite_length_floor = max(getattr(self, '_infinite_length_floor', current_len), current_len)
                    floor = self._infinite_length_floor
                    while len(game.snake) < floor:
                        tail = tuple(game.snake[-1])
                        game.snake.append(tail)
                        if hasattr(game, '_snake_set'):
                            _counter_add(game._snake_set, tail)

                if self.cheats.get('auto_collect') and getattr(game, 'fruit_position', None) is not None:
                    dx, dy = getattr(game, 'direction', (0, 1))
                    hx, hy = game.snake[0]
                    if getattr(game, 'settings', None) is not None and getattr(game.settings, 'wall_collision', True) and not getattr(game, '_dev_no_wall_collision', False):
                        target = (max(0, min(getattr(game, 'board_width', 1) - 1, hx + dx)), max(0, min(getattr(game, 'board_height', 1) - 1, hy + dy)))
                    else:
                        target = ((hx + dx) % max(1, getattr(game, 'board_width', 1)), (hy + dy) % max(1, getattr(game, 'board_height', 1)))
                    game.fruit_position = target
                elif self.cheats.get('magnet') and getattr(game, 'fruit_position', None) is not None:
                    hx, hy = game.snake[0]
                    fx, fy = game.fruit_position
                    if fx != hx:
                        fx += 1 if hx > fx else -1
                    elif fy != hy:
                        fy += 1 if hy > fy else -1
                    game.fruit_position = (max(0, min(getattr(game, 'board_width', 1) - 1, fx)), max(0, min(getattr(game, 'board_height', 1) - 1, fy)))

            if self.cheats.get('everything_apple') and hasattr(game, 'current_fruit_type'):
                game.current_fruit_type = 'regular'
                if hasattr(game, 'current_fruit_value'):
                    game.current_fruit_value = 1
            elif self.cheats.get('lucky_mode') and hasattr(game, 'current_fruit_type'):
                game.current_fruit_type = 'golden'
                if hasattr(game, 'current_fruit_value'):
                    game.current_fruit_value = 2
            elif self.cheats.get('mega_food') and hasattr(game, 'current_fruit_value'):
                game.current_fruit_value = max(10, int(getattr(game, 'current_fruit_value', 1)))

            if self.cheats.get('no_item_cooldown'):
                if hasattr(game, 'powerup_spawn_timer'):
                    game.powerup_spawn_timer = -getattr(game, 'powerup_spawn_interval', 0)
                if hasattr(game, 'powerup_timer'):
                    game.powerup_timer = -getattr(game, 'powerup_spawn_interval', 0)

            if self.cheats.get('all_powerups') and hasattr(game, 'powerup_position') and getattr(game, 'powerup_position', None) is None:
                self.spawn_powerup()
            if self.cheats.get('infinite_powerups') and hasattr(game, 'powerup_position') and getattr(game, 'powerup_position', None) is None:
                self.spawn_powerup()

            if self.cheats.get('fruit_rain') and hasattr(game, 'generate_fruit'):
                now = time.perf_counter()
                if now - self._fruit_rain_clock >= 0.30:
                    self._fruit_rain_clock = now
                    game.fruit_position = game.generate_fruit()

            if self.cheats.get('moon_gravity') and hasattr(game, 'next_direction') and hasattr(game, 'direction'):
                if game.direction != (0, -1):
                    game.next_direction = (0, 1)

            if self.cheats.get('chaos_mode') and hasattr(game, 'next_direction'):
                rng = getattr(game, 'rng', random)
                directions = [(0, -1), (1, 0), (0, 1), (-1, 0)]
                try:
                    game.next_direction = rng.choice(directions)
                except Exception:
                    game.next_direction = random.choice(directions)
        except Exception:
            pass

    def scale_dt(self, frame_dt):
        if not self.active:
            return frame_dt
        ts = 0.0 if self.cheats['freeze_game'] else max(0.0, float(self.time_scale))
        if self.cheats['speed_boost']:
            ts *= 2.0
        if self.cheats['slow_motion']:
            ts *= 0.5
        return max(0.0, min(1000.0, frame_dt * ts))

    def scaled_update_interval(self, base_ms):
        """Map the global DEV time-scale controls to a simulation interval."""
        if not self.active and not self.modified:
            return float(base_ms)
        ts = max(0.0, float(self.time_scale))
        if self.cheats.get('speed_boost'):
            ts *= 2.0
        if self.cheats.get('slow_motion'):
            ts *= 0.5
        if self.cheats.get('freeze_game') or ts <= 0.0:
            return float('inf')
        return max(1.0, float(base_ms) / ts)

    def reverse_direction_key(self, key):
        # Mirror World swaps horizontal directions; Reverse Controls swaps both
        # axes.  When both are active the transforms compose deterministically.
        if not (self.cheats['reverse_controls'] or self.cheats.get('mirror_world')):
            return key
        mirrored = {
            pygame.K_a: pygame.K_d, pygame.K_d: pygame.K_a,
            pygame.K_LEFT: pygame.K_RIGHT, pygame.K_RIGHT: pygame.K_LEFT,
        }
        reversed_all = {
            pygame.K_w: pygame.K_s, pygame.K_s: pygame.K_w,
            pygame.K_UP: pygame.K_DOWN, pygame.K_DOWN: pygame.K_UP,
            pygame.K_a: pygame.K_d, pygame.K_d: pygame.K_a,
            pygame.K_LEFT: pygame.K_RIGHT, pygame.K_RIGHT: pygame.K_LEFT,
        }
        if self.cheats.get('mirror_world'):
            key = mirrored.get(key, key)
        if self.cheats.get('reverse_controls'):
            key = reversed_all.get(key, key)
        return key

