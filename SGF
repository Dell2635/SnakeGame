        elif action=='open_folder': _user_data_manager.open_data_folder()
        elif action.startswith('clear_'):
            cat=action[6:]
            if self.confirm==action: _user_data_manager.delete_category(cat); self.confirm=None; self.tools.toast(f'Cleared {cat}')
            else: self.confirm=action; self.tools.toast(f'Click again to clear {cat}')
