def _game_settings_context(context):
    context = str(context or '').strip().lower()
    return context if context in _GAME_CONTEXTS else 'singleplayer'


def _copy_json_safe(value):
    try:
        return json.loads(json.dumps(value, ensure_ascii=False))
    except Exception:
        return copy.deepcopy(value)


def _load_game_settings(context, defaults=None):
    """Per-context Game Settings merged over `defaults`. Thin wrapper over
    IA-3's file-based get_last_game_settings()/save_last_game_settings()
    (config/game_settings/<context>.json) so there is exactly one storage
    location instead of a second copy embedded in game_data.json."""
    context = _game_settings_context(context)
    out = _copy_json_safe(defaults or {})
    out.update(_copy_json_safe(get_last_game_settings(context, {})))
    return out


def _save_game_settings(context, settings_dict, *, mark_last_used=True):
    context = _game_settings_context(context)
    payload = _copy_json_safe(settings_dict or {})
    save_last_game_settings(context, payload)
    if mark_last_used:
        def _mutate(data):
            data['last_game_settings_context'] = context
            return data
        _save_data_async(_mutate)
    return payload


def _last_game_settings_context():
    try:
        return _game_settings_context(_load_data().get('last_game_settings_context', 'singleplayer'))
    except Exception:
        return 'singleplayer'


def _seed_from_setting(seed_mode='random', seed_value=None):
    if str(seed_mode).lower() != 'custom':
        return generate_seed()
    value = str(seed_value or '').strip()
    return value if value else generate_seed()


