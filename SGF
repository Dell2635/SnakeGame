_MOBILE_HAPTIC_BACKEND = None
_MOBILE_HAPTIC_CHECKED = False


def _trigger_mobile_haptic(duration_ms=35):
    """Best-effort Pydroid/Android vibration; unsupported desktops are no-ops."""
    global _MOBILE_HAPTIC_BACKEND, _MOBILE_HAPTIC_CHECKED
    try:
        duration_ms = max(1, min(120, int(duration_ms)))
    except (TypeError, ValueError, OverflowError):
        duration_ms = 35
    if not _MOBILE_HAPTIC_CHECKED:
        _MOBILE_HAPTIC_CHECKED = True
        try:
            from jnius import autoclass
            activity = autoclass('org.kivy.android.PythonActivity').mActivity
            context = autoclass('android.content.Context')
            vibrator = activity.getSystemService(context.VIBRATOR_SERVICE)
            if vibrator is not None and vibrator.hasVibrator():
                try:
                    effect_type = autoclass('android.os.VibrationEffect')
                    build = autoclass('android.os.Build$VERSION')
                    if int(build.SDK_INT) >= 26:
                        def _vibrate(ms):
                            effect = effect_type.createOneShot(ms, effect_type.DEFAULT_AMPLITUDE)
                            vibrator.vibrate(effect)
                        _MOBILE_HAPTIC_BACKEND = _vibrate
                    else:
                        _MOBILE_HAPTIC_BACKEND = lambda ms: vibrator.vibrate(ms)
                except Exception:
                    _MOBILE_HAPTIC_BACKEND = lambda ms: vibrator.vibrate(ms)
        except Exception:
            # Pydroid's optional permissions/Pyjnius integration may be
            # absent. Gameplay must continue without haptics in that case.
            _MOBILE_HAPTIC_BACKEND = None
    if _MOBILE_HAPTIC_BACKEND is not None:
        try:
            _MOBILE_HAPTIC_BACKEND(duration_ms)
        except Exception:
            _MOBILE_HAPTIC_BACKEND = None


def _is_app_background_event(event):
    """Recognize Pygame 2 focus/background events and legacy SDL focus loss."""
    event_type = getattr(event, 'type', None)
    for name in ('WINDOWFOCUSLOST', 'WINDOWHIDDEN', 'WINDOWMINIMIZED'):
        if event_type == getattr(pygame, name, object()):
            return True
    if event_type == getattr(pygame, 'ACTIVEEVENT', object()):
        if bool(getattr(event, 'gain', 1)):
            return False
        state = getattr(event, 'state', 0)
        focus_bits = (getattr(pygame, 'APPINPUTFOCUS', 2) |
                      getattr(pygame, 'APPACTIVE', 4))
        try:
            return bool(int(state) & focus_bits)
        except (TypeError, ValueError, OverflowError):
            return False
    return False

