            self.portal_pulse_dir = 1
        
        # Compute responsive layout dimensions once for all pages
        _sw = self.screen.get_width()
        _sh = self.screen.get_height()
        _ref = min(_sw, _sh)
        _title_y = int(_sh * 0.07)
        _heading_y = int(_sh * 0.175)
