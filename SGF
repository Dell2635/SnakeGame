def _create_example_mod_template(directory, existing_ids=(), *,
                                make_directory=os.mkdir,
                                write_json=_atomic_write_json,
                                remove_directory=os.rmdir):
    """Create a complete declarative theme mod without overwriting user files."""
    directory = os.path.abspath(os.fspath(directory))
    os.makedirs(directory, exist_ok=True)
    existing_ids = {str(mod_id) for mod_id in existing_ids}
    for number in range(1, 10000):
        suffix = '' if number == 1 else f'_{number}'
        mod_id = f'example_mod{suffix}'
        if mod_id in existing_ids:
            continue
        mod_dir = os.path.join(directory, mod_id)
        try:
            make_directory(mod_dir)
        except FileExistsError:
            continue
        manifest = {
            'id': mod_id,
            'name': f'Example Mod{suffix.replace("_", " ")}',
            'version': '1.0.0',
            'game_version': GAME_VERSION,
            'mod_api_version': MOD_API_VERSION,
            'dependencies': [],
            'assets': {},
            'configuration': {},
            'type': 'theme',
            'permissions': ['themes'],
            'theme': {
                'id': f'{mod_id}_theme',
                'name': f'Example Theme{suffix.replace("_", " ")}',
                'version': '1.0.0',
                'game_version': '*',
                'theme_api_version': THEME_API_VERSION,
                'extends': 'default',
                'colors': {'button': [70, 110, 190]},
            },
        }
        try:
            write_json(os.path.join(mod_dir, 'mod.json'), manifest)
            return mod_dir, manifest
        except Exception:
            try:
                remove_directory(mod_dir)
            except OSError:
                pass
            raise
    raise FileExistsError('Could not allocate an unused example mod identifier')


class ModsScreen(_SimpleMenuScreen):
    """MAIN MENU\\Mods — view/enable/disable installed mods, reload the mods
    folder, and open it in the OS file browser. Built directly on IA4's
    ModManager/ModRegistry (MOD_MANAGER) and IA3's data-folder contract
    (get_data_manager().get_mod_dir()) — no parallel mod-listing system.

    There's no in-game file picker anywhere in SGF, so 'Import Mod' opens
    the mods folder (like 'Open Mods Folder') rather than pretending to
    copy a file in from an OS dialog that doesn't exist yet; the two
    buttons are kept separate so this limitation is visible rather than
    silently merged away.
    """

    def __init__(self, settings, screen, on_mods_changed=None, manager=None,
                 on_open_guide=None):
        self.on_mods_changed = on_mods_changed
        self.on_open_guide = on_open_guide
        self.manager = manager or MOD_MANAGER
        self.pending_enabled = set(self.manager.enabled)
        self.apply_error = False
        self.committed = False
        self.example_mod_status = None
        self._checkboxes = {}
        entries = [
            ('modding_guide', lambda: get_text(settings.language, 'modding_guide'),
             COLORS['orange'], self._open_guide),
            ('create_example_mod', lambda: get_text(settings.language, 'mods_create_example'),
             COLORS['blue'], self._create_example_mod),
            ('reload_mods', lambda: _t_or(settings.language, 'reload_mods', 'Reload Mods'),
             COLORS['blue'], self._reload),
            ('import_mod', lambda: _t_or(settings.language, 'import_mod', 'Import Mod'),
             COLORS['green'], self._open_folder),
            ('open_mods_folder', lambda: _t_or(settings.language, 'open_mods_folder', 'Open Mods Folder'),
             COLORS['purple'], self._open_folder),
            ('apply_mods', lambda: get_text(settings.language, 'mods_apply'),
             COLORS['green'], self._apply_pending),
        ]
        super().__init__(settings, screen,
                         title_fn=lambda: _t_or(settings.language, 'mods', 'Mods'),
                         entries=entries, body_fn=self._status_text)

    def _open_guide(self):
        if self.on_open_guide is not None:
            self.on_open_guide()

    def _create_example_mod(self):
        try:
            refresh_extension_content()
            mod_dir, _manifest = _create_example_mod_template(
                get_data_manager().get_mod_dir(), self.manager.discovered)
            self.example_mod_status = ('created', os.path.basename(mod_dir))
            self.apply_error = False
        except Exception as exc:
            sgf_log.warning('Could not create example mod: %s', exc)
            self.example_mod_status = ('failed', None)
            return
        try:
            refresh_extension_content()
            self.pending_enabled.intersection_update(self.manager.discovered)
        except Exception as exc:
            sgf_log.warning('Example mod was created but could not be reloaded: %s', exc)
        self._init_ui()

    def _status_text(self):
        if self.example_mod_status:
            status, name = self.example_mod_status
            if status == 'created':
                return get_text(self.settings.language, 'mods_example_created').format(
                    name=name)
            return get_text(self.settings.language, 'mods_example_create_failed')
        if self.apply_error:
            return get_text(self.settings.language, 'mods_apply_failed')
        if not self.manager.discovered:
            return _t_or(self.settings.language, 'no_mods_installed',
                         'No mods installed yet. Use "Open Mods Folder" to add one.')
        selected_count = len(self.pending_enabled & set(self.manager.discovered))
        return get_text(self.settings.language, 'mods_preview_status').format(
            count=selected_count)

    def _mod_state_key(self, mod_id):
        for error in reversed(self.manager.errors):
            details = error.get('error_dict') or {}
            owner_id = error.get('mod_id') or details.get('owner_id')
            if str(owner_id or '') != str(mod_id):
                continue
            code = str(details.get('code') or '')
            if code == 'missing_dependency':
                return 'mod_state_missing_dependency'
            if 'conflict' in code or 'duplicate' in code:
                return 'mod_state_conflict'
            if code.startswith('incompatible_'):
                return 'mod_state_incompatible'
            return 'mod_state_broken'
        return ('mod_state_enabled' if mod_id in self.manager.active
                else 'mod_state_disabled')

    def _open_folder(self):
        _open_folder_in_os(get_data_manager().get_mod_dir())

    def _reload(self):
        self.example_mod_status = None
        refresh_extension_content()
        self.pending_enabled.intersection_update(self.manager.discovered)
        self._init_ui()  # rebuild: newly discovered mods need new checkboxes

    def _toggle_mod(self, mod_id, checked):
        self.example_mod_status = None
        if checked:
            self.pending_enabled.add(mod_id)
        else:
            self.pending_enabled.discard(mod_id)
        self.apply_error = False

    def _apply_pending(self):
        original_enabled = set(self.manager.enabled)
        original_active = set(self.manager.active)
        original_setting = list(getattr(self.settings, 'enabled_mods', []))
        original_theme_setting = getattr(self.settings, 'theme_id', 'default')
        original_theme_active = THEME_MANAGER.active_theme_id
        target = self.pending_enabled & set(self.manager.discovered)

        def restore_previous_state():
            self.manager.unload_all()
            self.manager.enabled = set(original_enabled)
            self.manager.activate_all(original_active)
            self.manager.enabled = set(original_enabled)
            self.settings.enabled_mods = original_setting
            self.settings.theme_id = original_theme_setting
            if THEME_MANAGER.has(original_theme_active):
                THEME_MANAGER.apply(original_theme_active)
            else:
                THEME_MANAGER.apply('default')

        try:
            self.manager.unload_all()
            self.manager.enabled = set(target)
            self.manager.activate_all(target)
            if not target.issubset(self.manager.active):
                raise RuntimeError('One or more selected mods could not be activated')
            self.settings.theme_id = THEME_MANAGER.apply(original_theme_setting)
            self.settings.enabled_mods = sorted(target)
            if self.settings.save() is False:
                raise IOError('Mod settings could not be saved')
        except Exception as exc:
            try:
                restore_previous_state()
            except Exception as rollback_exc:
                sgf_log.error('Mod rollback failed: %s', rollback_exc)
            sgf_log.warning('Applying selected mods failed: %s', exc)
            self.apply_error = True
            return

        self.pending_enabled = set(target)
        self.committed = True
        self._running = False
        if self.on_mods_changed:
            self.on_mods_changed()

    def _go_back(self):
        if not self.committed:
            self.pending_enabled = set(self.manager.enabled)
            self.apply_error = False
        super()._go_back()

    def _populate_widgets(self):
        super()._populate_widgets()
        w = self._widgets
        mod_order = []
        for mod_id in sorted(self.manager.discovered):
            manifest = self.manager.discovered[mod_id]
            key = f"mod_{mod_id}"
            label = lambda m=manifest, mid=mod_id: (
                f"{m.name}  v{m.version} · "
                f"{get_text(self.settings.language, self._mod_state_key(mid))}")
            cb = UICheckbox(label, checked=(mod_id in self.pending_enabled), key=key,
                            on_change=lambda checked, mid=mod_id: self._toggle_mod(mid, checked))
            w[key] = cb
            mod_order.append(key)
        if self.manager.errors:
            w['mod_errors'] = UILabel(
                lambda count=len(self.manager.errors): get_text(
                    self.settings.language, 'mod_errors_summary').format(count=count),
                align='center', wrap=True,
                                      size=16, color=COLORS['red'])
            mod_order.append('mod_errors')
        # insert the mod list right after the title/body, before the action buttons/back
        insert_at = 2 if 'body' in self._order else 1
        self._order = self._order[:insert_at] + mod_order + self._order[insert_at:]
        self._mod_keys = mod_order

    def _build(self):
        ui, view, W = self.ui, self.view, self._widgets
        sw, sh = self.screen.get_size()
        lang = self.settings.language
        ui.language = lang
        view.set_rect(pygame.Rect(0, 0, sw, sh))
        ref = min(sw, sh)
        font_size = max(15, min(24, int(ref * 0.04)))
        btn_h = max(36, min(60, int(sh * 0.075)))
        min_btn_h = max(26, int(btn_h * 0.66))
        row_h = max(28, min(44, int(sh * 0.05)))
        gap = max(6, min(20, int(btn_h * 0.3)))
        title_size = max(28, min(52, int(ref * 0.07)))
        title_h = get_font(lang, 'bold', title_size).get_height() + 20
        W['title'].size = title_size
        widest = 0
        for k in self._order:
            b = W[k]
            if isinstance(b, UIButton):
                b.font_size = font_size
                widest = max(widest, ui_text_size(lang, 'bold', font_size, b.val(b.text))[0])
        bw = min(int(sw * 0.92), max(max(220, min(420, int(sw * 0.4))), widest + 44))
        pad_v = max(8, int(sh * 0.03))

        def build(width):
            flow = UIVerticalFlow(pygame.Rect(0, 0, width, sh), padding=(0, pad_v), spacing=gap,
                                  min_spacing=2, valign='top')
            for k in self._order:
                if k == 'title':
                    flow.add(k, title_h, min_h=int(title_h * 0.55))
                elif k == 'body' or k == 'mod_errors':
                    h = W[k].measure(bw) + 16
                    flow.add(k, h, min_h=int(h * 0.5), w=bw, gap=gap * 2, min_gap=4)
                elif k in self._mod_keys:
                    flow.add(k, row_h, min_h=int(row_h * 0.7), w=bw)
                elif k == 'reload_mods':
                    flow.add(k, btn_h, min_h=min_btn_h, w=bw, gap=gap * 2, min_gap=4)
                elif k == 'back':
                    flow.add(k, btn_h, min_h=min_btn_h, w=bw, gap=gap * 2, min_gap=4)
                else:
                    flow.add(k, btn_h, min_h=min_btn_h, w=bw)
            res = flow.solve()
            for k in self._order:
                view.add(W[k], res.rects[k])
            last_child_bottom = max(
                (rect.bottom for rect in res.rects.values()), default=0)
            return max(view.viewport.h, res.content_height,
                       last_child_bottom + pad_v)

        fk = ui.focused.key if ui.focused is not None else None
        view.relayout(build)
        if fk is not None:
            ui.focus_key(fk)



