    def init_particles(self):
        """Initialize background particles for menu animation"""
        self.particles = []
        for _ in range(self.particle_count):
            x = random.randint(0, self.screen.get_width())
            y = random.randint(0, self.screen.get_height())
            size = random.randint(1, 3)
            speed = random.uniform(0.2, 1.0)
            color = (
                random.randint(50, 150),  # Darker blue tones
                random.randint(50, 150),
                random.randint(150, 255)
            )
            self.particles.append({
                "x": x,
                "y": y,
                "size": size,
                "speed": speed,
                "color": color,
                "angle": random.uniform(0, 2 * math.pi)
            })
            
    def update_particles(self):
        """Update particle positions for animation"""
        for particle in self.particles:
            # Move particles in their direction
            particle["x"] += math.cos(particle["angle"]) * particle["speed"]
            particle["y"] += math.sin(particle["angle"]) * particle["speed"]
            
            # If particle goes off screen, wrap around
            if particle["x"] < 0:
                particle["x"] = self.screen.get_width()
            elif particle["x"] > self.screen.get_width():
                particle["x"] = 0
                
            if particle["y"] < 0:
                particle["y"] = self.screen.get_height()
            elif particle["y"] > self.screen.get_height():
                particle["y"] = 0
                
            # Occasionally change direction slightly
            if random.random() < 0.01:
                particle["angle"] += random.uniform(-0.1, 0.1)
                
    def draw_particles(self):
        """Draw background particles"""
        for particle in self.particles:
            # Pulse size based on time
            pulse = math.sin(pygame.time.get_ticks() / 1000 * particle["speed"]) * 0.5 + 0.5
            size = particle["size"] * (1 + pulse * 0.5)
            
            # Draw the particle
            pygame.draw.circle(
                self.screen, 
                particle["color"], 
                (int(particle["x"]), int(particle["y"])), 
                max(1, int(size))
            )
            
    def create_button(self, rect, text, color, hover=False):
        """Create an animated button with hover effect"""
        base_color = color
        
        # Apply a pulsing glow effect when hovered
        if hover:
            # Create a subtle pulsing effect by adding a value to each RGB component
            pulse = int(self.highlight_value * 50)  # Scale to make effect visible
            hover_color = tuple(min(255, c + pulse) for c in base_color)
            pygame.draw.rect(self.screen, hover_color, rect, border_radius=10)
            
            # Add a glowing border
            border_color = (255, 255, 255, int(self.highlight_value * 150))
            border_surface = pygame.Surface((rect.width + 8, rect.height + 8), pygame.SRCALPHA)
            pygame.draw.rect(border_surface, border_color, 
                           (0, 0, rect.width + 8, rect.height + 8), 
                           border_radius=12)
            self.screen.blit(border_surface, (rect.x - 4, rect.y - 4))
        else:
            pygame.draw.rect(self.screen, base_color, rect, border_radius=10)
        
        # Draw the text
        _btn_ref = min(self.screen.get_width(), self.screen.get_height())
        button_font = get_font(self.settings.language, 'bold', max(16, min(28, int(_btn_ref * 0.045))))
        text_surface = button_font.render(text, True, COLORS['white'])
        text_rect = text_surface.get_rect(center=rect.center)
        self.screen.blit(text_surface, text_rect)
        
        return rect
        
    def draw_menu(self):
        """Draw the main menu with animations and effects"""
        # Fill background
        self.screen.fill(COLORS['dark_blue'])
        
        # Update highlight animation for button hover effects
        self.highlight_value += 0.03 * self.highlight_direction
        if self.highlight_value >= 1.0:
            self.highlight_value = 1.0
            self.highlight_direction = -1
        elif self.highlight_value <= 0.0:
            self.highlight_value = 0.0
            self.highlight_direction = 1
            
        # Draw animated background particles
        self.update_particles()
        self.draw_particles()
        
        # Get screen dimensions for responsive layout
        screen_width = self.screen.get_width()
        screen_height = self.screen.get_height()
        
        # Calculate center positions for responsive layout
        center_x = screen_width // 2
        _ref = min(screen_width, screen_height)
        button_width = max(160, min(280, int(screen_width * 0.22)))
        button_height = max(36, min(60, int(screen_height * 0.075)))
        button_spacing = max(48, min(80, int(screen_height * 0.085)))
        
        # Draw title with floating animation
        title_font = get_font(self.settings.language, 'bold', max(32, min(64, int(_ref * 0.085))))
        title_text = title_font.render(get_text(self.settings.language, 'game_title'), True, COLORS['white'])
        title_y = screen_height * 0.15  # 15% from top
        
        # Add floating animation to title
        title_y_offset = int(math.sin(pygame.time.get_ticks() / 800) * 5)
        
        # Draw a glowing effect behind the title
        glow_surface = pygame.Surface((title_text.get_width() + 20, title_text.get_height() + 20), pygame.SRCALPHA)
        glow_alpha = int(100 + 50 * math.sin(pygame.time.get_ticks() / 1000))
        glow_color = (100, 150, 255, glow_alpha)
        pygame.draw.ellipse(glow_surface, glow_color, glow_surface.get_rect())
        self.screen.blit(glow_surface, (center_x - (title_text.get_width() + 20) // 2, title_y + title_y_offset - 10))
        
        # Draw the title text
        self.screen.blit(title_text, (center_x - title_text.get_width() // 2, title_y + title_y_offset))
        
        # Get mouse position for hover effects
        mouse_pos = pygame.mouse.get_pos()
        
        # Draw buttons with hover effects
        # Play (single-player) and Multiplayer — share the same row, side by side
        play_y   = int(title_y + screen_height * 0.12)
        half_btn = button_width - 4          # slightly narrower than normal
        play_rect  = pygame.Rect(center_x - half_btn - 6, play_y, half_btn, button_height)
        multi_rect = pygame.Rect(center_x + 6,             play_y, half_btn, button_height)
        self.button_hover["play"]        = play_rect.collidepoint(mouse_pos)
        self.button_hover["multiplayer"] = multi_rect.collidepoint(mouse_pos)
        self.create_button(
            play_rect,
            get_text(self.settings.language, 'play'),
            COLORS['green'],
            self.button_hover["play"]
        )
        self.create_button(
            multi_rect,
            "Multiplayer",
            (0, 130, 180),
            self.button_hover["multiplayer"]
        )
        
        # High Scores button
        highscores_rect = pygame.Rect(center_x - button_width // 2, play_y + button_spacing, button_width, button_height)
        self.button_hover["highscores"] = highscores_rect.collidepoint(mouse_pos)
        self.create_button(
            highscores_rect, 
            get_text(self.settings.language, 'high_scores'), 
            COLORS['blue'], 
            self.button_hover["highscores"]
        )
        
        # Settings button
        settings_rect = pygame.Rect(center_x - button_width // 2, play_y + button_spacing * 2, button_width, button_height)
        self.button_hover["settings"] = settings_rect.collidepoint(mouse_pos)
        self.create_button(
            settings_rect, 
            get_text(self.settings.language, 'settings'), 
            COLORS['purple'], 
            self.button_hover["settings"]
        )
        
        # Draw text input with animation
        input_rect = self.draw_text_input()
        
        # Achievements button - positioned below text input
        achievements_rect = pygame.Rect(center_x - button_width // 2, input_rect.bottom + int(button_height * 0.67), button_width, button_height)
        self.button_hover["achievements"] = achievements_rect.collidepoint(mouse_pos)
        self.create_button(
            achievements_rect, 
            get_text(self.settings.language, 'achievements'), 
            COLORS['gold'], 
            self.button_hover["achievements"]
        )
        
        # Credits button - positioned below achievements button
        credits_rect = pygame.Rect(center_x - button_width // 2, achievements_rect.bottom + int(button_height * 0.33), button_width, button_height)
        self.button_hover["credits"] = credits_rect.collidepoint(mouse_pos)
        self.create_button(
            credits_rect, 
            "Credits", 
            COLORS['orange'], 
            self.button_hover["credits"]
        )
        
        # Exit button - positioned below credits button
        exit_rect = pygame.Rect(center_x - button_width // 2, credits_rect.bottom + int(button_height * 0.33), button_width, button_height)
        self.button_hover["exit"] = exit_rect.collidepoint(mouse_pos)
        self.create_button(
            exit_rect, 
            get_text(self.settings.language, 'exit'), 
            COLORS['red'], 
            self.button_hover["exit"]
        )
        
        # Apply transition effect if in transition
        if self.transition_alpha > 0:
            self.transition_surface.set_alpha(self.transition_alpha)
            self.screen.blit(self.transition_surface, (0, 0))
            
            # Update transition alpha
            if self.transition_in:
                self.transition_alpha = max(0, self.transition_alpha - self.transition_speed)
            else:
                self.transition_alpha = min(255, self.transition_alpha + self.transition_speed)
        
        # Update display
        pygame.display.flip()
        
        return play_rect, highscores_rect, settings_rect, achievements_rect, credits_rect, exit_rect, input_rect, multi_rect
        
