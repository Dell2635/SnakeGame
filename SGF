            ui_text_surface('en', 'regular', 12,
                            f'selftest text {_text_cache_index}', (255, 255, 255))
        assert len(_ui_text_cache) == _UI_TEXT_CACHE_MAX
        assert not any(key[3] == 'selftest text 0' for key in _ui_text_cache)
    finally:
        _font_cmap_cache = _font_cmap_cache_original
        _FONTTOOLS_AVAILABLE = _fonttools_original
        get_font = _get_font_original
        _ui_text_cache = _ui_text_cache_original
    results.append('bounded_lru_font_caches')

    _retry_history_probe_ids = [f'retry-history-prune-{index}' for index in range(3)]
    with _replay_save_jobs_lock:
        for _retry_history_index, _retry_history_id in enumerate(_retry_history_probe_ids):
            _replay_save_jobs[_retry_history_id] = {
                'phase': 'failed', 'history': ({'snapshot': _retry_history_index},),
                'entry': {'game_id': _retry_history_id}, 'done': threading.Event(),
            }
