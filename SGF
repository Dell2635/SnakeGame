def _run_schema_migrations(data):
    """Idempotently upgrade the unified game-data dict to the current
    SAVE_FORMAT_VERSION. Each step only touches the section(s) it owns, so a
    problem in one section never destroys unrelated valid data."""
    if not isinstance(data, dict):
        return data
    version = data.get(_SCHEMA_VERSION_KEY, 1)

    if version < 2:
        # v1 -> v2: introduce explicit format-version fields; no existing
        # section is moved, renamed, or rewritten.
        data.setdefault('save_format_version', SAVE_FORMAT_VERSION)
        data.setdefault('replay_format_version', REPLAY_FORMAT_VERSION)
        data.setdefault('game_version', GAME_VERSION)
        version = 2

    data[_SCHEMA_VERSION_KEY] = version
    return data


