def _safe_content_id(value, fallback='item'):
    """Return a portable filename stem without allowing path traversal."""
    value = str(value or '')
    safe = ''.join(ch for ch in value if ch.isalnum() or ch in ('-', '_', '.'))
    safe = safe.strip(' .')
    return safe[:100] or fallback


