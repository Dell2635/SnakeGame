    def _open_relay_stream(self, ip, port, invite_code, cancel_event=None, budget=30.0):
        """Open the pinned TLS stream through a Cloudflare relay (see the shared helper)."""
        def note_stage(stage):
            self._last_connect_stage = stage
        stream, _token = _open_secure_peer_stream(
            ip, port, invite_code, cancel_event, budget, note_stage)
        return stream

    def _do_connect(self, ip, invite_code, requested_seed=None, port=None, cancel_event=None):
        """Connect only when TLS identity pinning and one-time auth succeed."""
        if not ip or not invite_code:
            return None
        self._pending_map = None
        self._pending_seed = None
        self._pending_session = None
        self._last_connect_stage = ''
        s = None
        try:
            target_port = int(port or self.PORT)
            if _is_cloudflare_quick_hostname(ip):
                if not 1 <= target_port <= 65535:
                    raise ValueError('Cloudflare invitation contains an invalid public port')
                s = self._open_relay_stream(ip, target_port, invite_code, cancel_event)
                join_token = s.join_token
            else:
                s = _socket_mod.create_connection((ip, target_port), timeout=6.0)
                s.setsockopt(_socket_mod.IPPROTO_TCP, _socket_mod.TCP_NODELAY, 1)
                s, join_token = _wrap_and_pin_network_client(s, invite_code)
            s.settimeout(6)
            if _is_cloudflare_quick_hostname(ip):
                self._last_connect_stage = 'auth'
            _net_send(s, {'t': 'secure_auth', 'token': join_token.hex()})
            msg = _net_recv(s)
            if msg and msg.get('t') == 'hello':
                if set(msg) != {'t', 'v', 'mode', 'seed', 'map', 'map_hash', 'resume',
                                'max_players'}:
                    raise _NetProtocolError('invalid host handshake fields')
                room_size = msg.get('max_players')
                if type(room_size) is not int or not 2 <= room_size <= 4:
                    raise _NetProtocolError('host announced an invalid room size')
                resume_hex = msg.get('resume')
                if (not isinstance(resume_hex, str) or len(resume_hex) != 64
                        or any(ch not in '0123456789abcdef' for ch in resume_hex)):
                    raise _NetProtocolError('host supplied an invalid resume credential')
                incoming_map = msg.get('map')
                if not _validate_net_map(incoming_map):
                    raise _NetProtocolError('host supplied an invalid map')
                expected_hash = msg.get('map_hash')
                actual_hash = _map_fingerprint(incoming_map)
                if expected_hash != actual_hash:
                    raise _NetProtocolError('map fingerprint mismatch')
                host_mode = msg.get('mode')
                if host_mode not in ('1v1', 'coop') or host_mode != getattr(self, '_expected_mode', host_mode):
                    raise _NetProtocolError('host mode mismatch')
                host_seed = msg.get('seed')
                if not isinstance(host_seed, str) or not host_seed.strip() or len(host_seed) > 128:
                    raise _NetProtocolError('host did not provide a deterministic seed')
                self._pending_map = incoming_map
                self._pending_seed = host_seed
                self._pending_session = {
                    'host': ip, 'port': target_port, 'invite': invite_code,
                    'resume': resume_hex, 'mode': host_mode, 'max_players': room_size}
                if requested_seed and str(requested_seed).strip() and str(requested_seed).strip() != host_seed:
                    print('[network] joiner seed differs; host seed is authoritative')
                _net_send(s, {'t': 'hello_ack', 'map_hash': actual_hash, 'seed': host_seed})
                s.settimeout(15.0)
                self._last_connect_stage = ''
                return s
            s.close()
        except _NetProtocolError as _e:
            detail = re.sub(r'\b(?:\d{1,3}\.){3}\d{1,3}\b', '[address]', str(_e))
            detail = re.sub(r'\b[a-z0-9-]+\.trycloudflare\.com\b', '[relay]', detail, flags=re.IGNORECASE)
            sgf_log.warning('Secure multiplayer handshake rejected: %s', detail[:180])
            try: s.close()
            except Exception: pass
        except OSError as exc:
            # Connection dropped/reset mid-handshake — a normal thing to
            # happen while waiting for a peer to join over a LAN.
            detail = re.sub(r'\b(?:\d{1,3}\.){3}\d{1,3}\b', '[address]', str(exc))
            detail = re.sub(r'\b[a-z0-9-]+\.trycloudflare\.com\b', '[relay]', detail, flags=re.IGNORECASE)
            sgf_log.warning('Secure multiplayer connection failed (%s): %s',
                            type(exc).__name__, detail[:180])
        except Exception as _e:
            print(f"[network] unexpected error during connect handshake: {_e}")
            try: s.close()
            except Exception: pass
        return None

