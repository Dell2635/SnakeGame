class Achievement:
    def __init__(self, achievement_id, name, description, icon_type='trophy', achievement_type='bronze'):
        """
        Initialize an achievement
        
        Args:
            achievement_id (str): Unique identifier for the achievement
            name (str): Display name of the achievement
            description (str): Detailed description of how to earn the achievement
            icon_type (str): Type of icon to display ('trophy', 'snake', 'fruit', 'settings')
            achievement_type (str): Rarity/tier of the achievement ('bronze', 'silver', 'gold', 'platinum')
        """
        self.id = achievement_id
        self.name = name
        self.description = description
        self.icon_type = icon_type
        self.type = achievement_type
        self.unlocked = False
        self.unlock_time = None
        self.notification_shown = False
    
    def unlock(self):
        """Unlock this achievement and record the time"""
        if not self.unlocked:
            self.unlocked = True
            self.unlock_time = time.time()
            return True
        return False
    
    def draw_icon(self, surface, rect):
        """Draw the achievement icon"""
        # Draw the background
        pygame.draw.rect(surface, COLORS['achievement_bg'], rect, border_radius=max(1, rect.width // 5))
        pygame.draw.rect(surface, COLORS.get(self.type, COLORS['gold']), rect, width=2, border_radius=max(1, rect.width // 5))
        
        # Draw the icon based on type - use integer coordinates to prevent type errors
        padding = rect.width // 5
        icon_rect = pygame.Rect(rect.x + padding, rect.y + padding, 
                                rect.width - (padding * 2), rect.height - (padding * 2))
        
        # Safe color handling to prevent crashes
        icon_color = COLORS.get(self.type, COLORS.get('gold', (255, 215, 0)))
        if self.icon_type == 'trophy':
            create_trophy_icon(surface, icon_rect, icon_color)
        elif self.icon_type == 'snake':
            create_snake_icon(surface, icon_rect, icon_color)
        elif self.icon_type == 'fruit':
            create_fruit_icon(surface, icon_rect, icon_color)
        elif self.icon_type == 'settings':
            create_settings_icon(surface, icon_rect, icon_color)
        
        # If not unlocked, add a lock overlay
        if not self.unlocked:
            lock_color = (60, 60, 80, 180)  # Semi-transparent dark color
            pygame.draw.rect(surface, lock_color, rect, border_radius=max(1, rect.width // 5))
            
            # Draw a lock symbol - use standard RGB (no alpha) to prevent TypeError
            lock_width = int(rect.width * 0.4)
            lock_height = int(rect.height * 0.6)
            lock_body = pygame.Rect(
                rect.centerx - lock_width // 2,
                rect.centery - lock_height // 4,
                lock_width, 
                lock_height // 2
            )
            pygame.draw.rect(surface, (200, 200, 200), lock_body, border_radius=lock_width // 5)
            
            # Lock arch
            lock_arch_radius = lock_width // 2
            arch_rect = pygame.Rect(
                rect.centerx - lock_arch_radius,
                rect.centery - lock_height // 2,
                lock_arch_radius * 2,
                lock_arch_radius
            )
            pygame.draw.arc(surface, (200, 200, 200), arch_rect, 3.14, 6.28, 3)

class AchievementManager:
    def __init__(self):
        """Initialize the achievement manager"""
        self.achievements = {}
        self.pending_notifications = []
        self.notification_duration = 3  # seconds
        self.notification_fade_time = 1  # seconds
        self._defer_saves = False
        self._deferred_save = False
        
        # Initialize achievements from the definitions
        for achievement_id, data in ACHIEVEMENTS.items():
            self.achievements[achievement_id] = Achievement(
                achievement_id=data['id'],
                name=data['name'],
                description=data['description'],
                icon_type=data['icon'],
                achievement_type=data['type']
            )

    # ── persistence (writes into the centralized game-data JSON) ─────────
    def save_state(self):
        """Save unlocked achievements into the unified data file."""
        try:
            achievements_snapshot = {
                aid: {
                    'unlocked':    a.unlocked,
                    'unlock_time': a.unlock_time,
                }
                for aid, a in self.achievements.items()
            }

            def _mutate(data):
                data['achievements'] = achievements_snapshot
                return data

            _save_data_async(_mutate)
        except Exception as e:
            print(f"Error saving achievements: {e}")

    def load_state(self):
        """Restore unlocked achievements from the unified data file."""
        try:
            data = _load_data()
            saved = data.get('achievements', {}) or {}
            for aid, info in saved.items():
                if aid in self.achievements and isinstance(info, dict):
                    self.achievements[aid].unlocked    = bool(info.get('unlocked', False))
                    self.achievements[aid].unlock_time = info.get('unlock_time')
        except Exception as e:
            print(f"Error loading achievements: {e}")
    
    def unlock_achievement(self, achievement_id):
        """Unlock an achievement by ID and queue a notification"""
        if achievement_id in self.achievements:
            achievement = self.achievements[achievement_id]
            if achievement.unlock():
                self.pending_notifications.append({
                    'achievement': achievement,
                    'time': time.time(),
                    'alpha': 255
                })
                if self._defer_saves:
                    self._deferred_save = True
                else:
                    self.save_state()
                return True
        return False
    
    def check_achievement_progress(self, game_data):
        was_deferred = self._defer_saves
        self._defer_saves = True
        try:
            self._check_achievement_progress_impl(game_data)
        finally:
            self._defer_saves = was_deferred
            if not was_deferred and self._deferred_save:
                self._deferred_save = False
                self.save_state()

    def _check_achievement_progress_impl(self, game_data):
        """
        Check for achievement progress based on game data
        
        Args:
            game_data (dict): Dictionary containing game state data for checking achievements
        """
        # Score-based achievements
        score = game_data.get('score', 0)
        if score >= 10:
            self.unlock_achievement('score_10')
        if score >= 25:
            self.unlock_achievement('score_25')
        if score >= 50:
            self.unlock_achievement('score_50')
        if score >= 75:
            self.unlock_achievement('score_75')
        if score >= 100:
            self.unlock_achievement('score_100')
        
        # First game achievement
        if game_data.get('games_played', 0) > 0:
            self.unlock_achievement('first_game')
        
        # Check for powerup achievements
        powerups_used = game_data.get('powerups_used', [])
        if 'ghost_mode' in powerups_used:
            self.unlock_achievement('ghost_snake')
        if 'invincibility' in powerups_used:
            self.unlock_achievement('invincible_snake')
        
        # Check for portal achievements
        portal_uses = game_data.get('portals_used', 0)
        if portal_uses >= 10:
            self.unlock_achievement('portal_traveler')
        
        # Check for obstacle achievements
        if game_data.get('completed_with_obstacles', False):
            self.unlock_achievement('obstacle_navigator')
        
        # Check for combo achievements
        max_combo = game_data.get('max_combo', 0)
        if max_combo >= 5:
            self.unlock_achievement('combo_master')
        
        # Check for fruit collector achievements
        unique_fruits = game_data.get('unique_fruits_collected', [])
        if len(unique_fruits) >= 5:
            self.unlock_achievement('fruit_collector')
        if len(unique_fruits) >= 25:  # All fruit types
            self.unlock_achievement('fruit_master')
        
        # Check for speed demon achievement
        if game_data.get('max_speed_game', False):
            self.unlock_achievement('speed_demon')
        
        # Check for settings achievements
        settings_changed = game_data.get('settings_changed', [])
        if len(settings_changed) >= 5:
            self.unlock_achievement('settings_explorer')
        
        # Check for colorful snake achievement
        if 'snake_color' in settings_changed:
            self.unlock_achievement('colorful_snake')

        # New extended achievements
        score = game_data.get('score', 0)
        if score >= 200:
            self.unlock_achievement('score_200')

        snake_length = game_data.get('snake_length', 0)
        if snake_length >= 20:
            self.unlock_achievement('long_snake')

        games_played = game_data.get('games_played', 0)
        if games_played >= 10:
            self.unlock_achievement('marathon_runner')

        portal_uses = game_data.get('portal_uses', 0)
        if portal_uses >= 25:
            self.unlock_achievement('portal_expert')

        powerups_used = game_data.get('powerups_used', [])
        if len(set(powerups_used)) >= 3:
            self.unlock_achievement('power_addict')

        board_size = game_data.get('board_size', 10)
        victory = game_data.get('victory', False)
        if victory and board_size > 20:
            self.unlock_achievement('big_board')

        update_rate = game_data.get('update_rate_ms', 200)
        if victory and update_rate <= 100:
            self.unlock_achievement('speed_runner')

        max_combo = game_data.get('max_combo', 0)
        if max_combo >= 10:
            self.unlock_achievement('combo_god')

        used_powerups = game_data.get('powerups_used', [])
        if victory and len(used_powerups) == 0:
            self.unlock_achievement('no_powerup_win')

        if score == 100:
            self.unlock_achievement('double_digit')

        for family_id, family in _MILESTONE_ACHIEVEMENT_FAMILIES.items():
            value = game_data.get(family['field'], 0)
            if isinstance(value, bool):
                continue
            try:
                value = max(0, int(value))
            except (TypeError, ValueError, OverflowError):
                continue
            for threshold in family['thresholds']:
                if value >= threshold:
                    self.unlock_achievement(f'milestone_{family_id}_{threshold}')
    
    def draw_notification(self, surface, screen_width, screen_height, language='en'):
        """Draw any pending achievement notifications"""
        current_time = time.time()
        notifications_to_remove = []
        
        for i, notification in enumerate(self.pending_notifications):
            achievement = notification['achievement']
            elapsed = current_time - notification['time']
            
            # Calculate fade in/out alpha
            alpha = 255
            if elapsed < 0.5:  # Fade in
                alpha = int(255 * elapsed / 0.5)
            elif elapsed > self.notification_duration - self.notification_fade_time:  # Fade out
                alpha = int(255 * (self.notification_duration - elapsed) / self.notification_fade_time)
            
            if elapsed > self.notification_duration:
                notifications_to_remove.append(notification)
                continue
                
            notification['alpha'] = alpha
            
            # Create a notification surface with transparency
            notification_width = 400
            notification_height = 80
            notification_surface = pygame.Surface((notification_width, notification_height), pygame.SRCALPHA)
            
            # Draw background with transparency - use safe color access
            try:
                achievement_bg_color = COLORS.get('achievement_bg', (45, 45, 65))
                bg_r, bg_g, bg_b = achievement_bg_color[:3]
                bg_color = (int(bg_r), int(bg_g), int(bg_b), alpha)
            except (TypeError, ValueError, IndexError):
                bg_color = (45, 45, 65, alpha)
            
            # Get achievement type color with safe access
            try:
                achievement_type_color = COLORS.get(achievement.type, COLORS.get('gold', (255, 215, 0)))
                border_r, border_g, border_b = achievement_type_color[:3]
                border_color = (int(border_r), int(border_g), int(border_b), alpha)
            except (TypeError, ValueError, IndexError, AttributeError):
                border_color = (255, 215, 0, alpha)
            
            # Ensure valid border radius
            border_radius = min(10, min(notification_width, notification_height) // 4)
            pygame.draw.rect(notification_surface, bg_color, 
                             (0, 0, notification_width, notification_height), 
                             border_radius=border_radius)
            pygame.draw.rect(notification_surface, border_color[:3], 
                             (0, 0, notification_width, notification_height), 
                             width=2, border_radius=border_radius)
            
            # Draw achievement icon
            icon_rect = pygame.Rect(10, 10, 60, 60)
            # Use RGB values for icon colors (remove alpha)
            icon_color = border_color[:3] if len(border_color) >= 3 else (255, 215, 0)
            if achievement.icon_type == 'trophy':
                create_trophy_icon(notification_surface, icon_rect, icon_color)
            elif achievement.icon_type == 'snake':
                create_snake_icon(notification_surface, icon_rect, icon_color)
            elif achievement.icon_type == 'fruit':
                create_fruit_icon(notification_surface, icon_rect, icon_color)
            elif achievement.icon_type == 'settings':
                create_settings_icon(notification_surface, icon_rect, icon_color)
            
            # Draw achievement text
            title_font = get_font(language, 'bold', 18)
            desc_font = get_font(language, 'regular', 14)
            
            # Safely extract text color
            text_color = COLORS.get('achievement_text', (255, 255, 255))
            if isinstance(text_color, tuple) and len(text_color) >= 3:
                text_r, text_g, text_b = [int(c) for c in text_color[:3]]
                text_color_with_alpha = (text_r, text_g, text_b, alpha)
            else:
                text_color_with_alpha = (255, 255, 255, alpha)  # White with alpha
            
            achievement_title = f"{get_text(language, 'achievement_unlocked')}: {achievement.name}"
            # Use regular RGB color for text rendering (pygame doesn't support alpha in text color)
            title_text = title_font.render(achievement_title, True, text_color[:3])
            desc_text = desc_font.render(achievement.description, True, text_color[:3])
            
            notification_surface.blit(title_text, (80, 15))
            notification_surface.blit(desc_text, (80, 45))
            
            # Position the notification at the top of the screen
            notification_x = (screen_width - notification_width) // 2
            notification_y = 20 + i * (notification_height + 10)
            
            surface.blit(notification_surface, (notification_x, notification_y))
        
        # Remove expired notifications
        for notification in notifications_to_remove:
            self.pending_notifications.remove(notification)
    
    def draw_achievements_screen(self, surface, screen_width, screen_height, language, scroll_offset=0):
        """Draw the achievements screen inside a scrollable content viewport.

        ``last_achievements_content_height`` exposes the measured full height so
        the caller can use the shared ScrollBar without hardcoded thresholds.
        """
        surface.fill(COLORS['background'])

        title_font = get_font(language, 'bold', 30)
        title_text = title_font.render(get_text(language, 'achievements'), True, COLORS['white'])
        surface.blit(title_text, (screen_width // 2 - title_text.get_width() // 2, 50))

        achievements_per_row = 4
        icon_size = 100
        padding = 20
        start_x = (screen_width - (achievements_per_row * icon_size + (achievements_per_row - 1) * padding)) // 2
        content_top = 120
        viewport = pygame.Rect(0, content_top, screen_width, max(1, screen_height - content_top - 100))
        scroll_offset = max(0, int(scroll_offset))

        achievements_by_type = {
            'platinum': [],
            'gold': [],
            'silver': [],
            'bronze': []
        }
        for achievement in self.achievements.values():
            achievements_by_type[achievement.type].append(achievement)

        old_clip = surface.get_clip()
        surface.set_clip(old_clip.clip(viewport))
        x, y = start_x, 150 - scroll_offset
        for achievement_type in ['platinum', 'gold', 'silver', 'bronze']:
            if not achievements_by_type[achievement_type]:
                continue
            type_font = get_font(language, 'bold', 24)
            type_text = type_font.render(achievement_type.capitalize(), True, COLORS[achievement_type])
            surface.blit(type_text, (start_x, y))
            y += 40
            x = start_x
            name_font = get_font(language, 'regular', 14)
            for i, achievement in enumerate(achievements_by_type[achievement_type]):
                if i > 0 and i % achievements_per_row == 0:
                    x = start_x
                    y += icon_size + padding
                achievement_rect = pygame.Rect(x, y, icon_size, icon_size)
                achievement.draw_icon(surface, achievement_rect)
                name_text = (name_font.render(achievement.name, True, COLORS['white'])
                             if achievement.unlocked else name_font.render("???", True, COLORS['gray']))
                text_x = x + (icon_size - name_text.get_width()) // 2
                surface.blit(name_text, (text_x, y + icon_size + 5))
                x += icon_size + padding
            y += icon_size + padding + 30
        surface.set_clip(old_clip)

        self.last_achievements_content_height = max(
            viewport.height, (y + scroll_offset) - content_top + 10
        )

        back_button_rect = pygame.Rect(screen_width // 2 - 100, screen_height - 80, 200, 50)
        pygame.draw.rect(surface, COLORS['button'], back_button_rect, border_radius=10)
        back_font = get_font(language, 'bold', 20)
        back_text = back_font.render(get_text(language, 'back'), True, COLORS['white'])
        back_text_x = back_button_rect.centerx - back_text.get_width() // 2
        back_text_y = back_button_rect.centery - back_text.get_height() // 2
        surface.blit(back_text, (back_text_x, back_text_y))
        return back_button_rect

    def save(self):
        """Save achievements to the unified game data file"""
        achievement_data = {}
        for achievement_id, achievement in self.achievements.items():
            achievement_data[achievement_id] = {
                'unlocked': achievement.unlocked,
                'unlock_time': achievement.unlock_time
            }
        try:
            _gd = _load_data()
            _gd['achievements'] = achievement_data
            _save_data(_gd)
        except (IOError) as e:
            print(f"Error saving achievements: {e}")
    
    def load(self):
        """Load achievements from the unified game data file"""
        try:
            _gd = _load_data()
            achievement_data = _gd.get('achievements', {})
            for achievement_id, data in achievement_data.items():
                if achievement_id in self.achievements:
                    self.achievements[achievement_id].unlocked = data.get('unlocked', False)
                    self.achievements[achievement_id].unlock_time = data.get('unlock_time', None)
        except (json.JSONDecodeError, FileNotFoundError, IOError) as e:
            print(f"Error loading achievements: {e}")

##############
# USER DATA / STARTUP / DIAGNOSTICS SYSTEM (IA-3)
##############
# Centralizes every persistent-data location SGF uses behind one manager,
# migrates the legacy snake_game_data.json into it, adds schema versioning,
# structured logging, crash reporting, diagnostic export, Safe Mode, and the
# CLI startup options declared above. No new persistent-data code elsewhere
# in the file should hardcode a path — go through UserDataManager instead.

APP_NAME = "SGF Data"
_LEGACY_APP_NAME = "SGF"          # pre-restructure root folder name (IA-3 v1)
SAVE_FORMAT_VERSION = 3          # unified metadata schema; large content lives in category files
REPLAY_FORMAT_VERSION = 1
_SCHEMA_VERSION_KEY = 'schema_version'
_DATA_LAYOUT_VERSION = 2          # bumped when the SGF Data/ folder structure changes
_LAYOUT_VERSION_FILENAME = '.layout_version'


def _open_folder_in_os(path):
    """Best-effort: open `path` in the OS file browser. Shared by every
    'Open ... Folder' button (data root, mods, themes, maps, ...) so this
    platform-branching logic exists in exactly one place."""
    try:
        if sys.platform == 'win32':
            os.startfile(path)  # noqa: available on win32 only
        elif sys.platform == 'darwin':
            subprocess.Popen(['open', path])
        else:
            subprocess.Popen(['xdg-open', path])
        return True
    except Exception:
        return False


class UserDataManager:
    """Centralized owner of every persistent-data location SGF uses.

    The root directory is an OS-appropriate per-user data folder named
    "SGF Data" — never the current working directory, never the folder
    containing SGF.py, and never a launcher's `_snake_game_runtime`
    extraction folder — so it survives launcher extraction/replacement and
    updates. Category subdirectories are created lazily on first request,
    not at construction time.

    Layout (relative to the root)::

        config/
            game_data.json          (unified settings/highscores/achievements/…)
            game_settings/          (last-used Game Settings, one file per context)
            profiles/                (exported/imported settings profiles)
            settings/, controls/     (reserved for future granular systems)
        saves/
        replays/
        maps/
            created/
            imported/
        themes/
            installed/
        mods/
            installed/
        tools/                    (verified, app-managed helper binaries)
        logs/
        crashes/
        diagnostics/
        backups/
        cache/
    """

    _CATEGORY_DIRNAMES = {
        'config':           'config',
        'config_settings':  os.path.join('config', 'settings'),
        'config_controls':  os.path.join('config', 'controls'),
        'game_settings':    os.path.join('config', 'game_settings'),
        'profiles':         os.path.join('config', 'profiles'),
        'saves':            'saves',
        'replays':          'replays',
        'maps':             'maps',
        'maps_created':     os.path.join('maps', 'created'),
        'maps_imported':    os.path.join('maps', 'imported'),
        'themes':           'themes',
        'themes_installed': os.path.join('themes', 'installed'),
        'mods':             'mods',
        'mods_installed':   os.path.join('mods', 'installed'),
        'logs':             'logs',
        'crashes':          'crashes',
        'diagnostics':      'diagnostics',
        'backups':          'backups',
        'cache':            'cache',
        'tools':            'tools',
    }

    # Categories a person would recognize/manage individually (used to build
    # the selective-deletion contract in list_data_categories()). Purely
    # internal bookkeeping dirs (config, config_settings, config_controls)
    # are left out of this list — deleting "config" wholesale would also
    # wipe game_settings/profiles, which have their own explicit entries.
    _USER_FACING_CATEGORIES = (
        'saves', 'replays', 'maps_created', 'maps_imported',
        'themes_installed', 'mods_installed', 'logs', 'cache',
        'profiles', 'game_settings', 'crashes', 'diagnostics',
    )

    def __init__(self):
        self._root = None
        self._dir_cache = {}
        self._layout_migrated = False
        self._category_stats_cache = {}
        self._total_stats_cache = None

    # ---- root resolution -------------------------------------------------
    def _compute_root(self, app_name=None):
        """Pick the OS-appropriate per-user root. Deliberately does not use
        os.getcwd() or __file__ anywhere in this calculation."""
        app_name = app_name or APP_NAME
        env_override = os.environ.get('SGF_DATA_DIR')
        if env_override:
            return os.path.abspath(env_override)

        try:
            home = os.path.expanduser('~')
        except Exception:
            home = None

        if sys.platform == 'win32':
            base = os.environ.get('LOCALAPPDATA') or os.environ.get('APPDATA') or home or os.getcwd()
            return os.path.join(base, app_name)
        elif sys.platform == 'darwin':
            base = home or os.getcwd()
            return os.path.join(base, 'Library', 'Application Support', app_name)
        else:
            base = os.environ.get('XDG_DATA_HOME') or (os.path.join(home, '.local', 'share') if home else os.getcwd())
            return os.path.join(base, app_name)

    def _rename_legacy_root_if_needed(self, new_root):
        """One-time upgrade: the root folder used to be named "SGF" (before
        the "SGF Data" naming + nested layout in place from this point).
        If the old-named root exists and the new one doesn't yet, rename it
        in place so nothing is lost — settings, saves, replays, everything."""
        if os.environ.get('SGF_DATA_DIR'):
            return  # an explicit override always wins; never touch it
        if os.path.exists(new_root):
            return
        legacy_root = self._compute_root(app_name=_LEGACY_APP_NAME)
        if legacy_root == new_root or not os.path.isdir(legacy_root):
            return
        try:
            os.makedirs(os.path.dirname(new_root) or '.', exist_ok=True)
            os.rename(legacy_root, new_root)
        except Exception:
            try:
                import shutil as _shutil
                _shutil.copytree(legacy_root, new_root)
                _shutil.rmtree(legacy_root, ignore_errors=True)
            except Exception:
                pass  # leave the legacy folder as-is; nothing is lost

    def get_root_dir(self):
        """Resolve (and remember) the writable root directory, with graceful
        fallbacks if the OS-standard location can't be created/written."""
        if self._root is not None:
            return self._root

        for candidate in (
            self._compute_root(),
            os.path.join(os.path.expanduser('~'), '.sgf_data') if os.path.expanduser('~') else None,
            os.path.join(tempfile.gettempdir(), 'SGF Data'),
        ):
            if not candidate:
                continue
            try:
                self._rename_legacy_root_if_needed(candidate)
                os.makedirs(candidate, exist_ok=True)
                probe = os.path.join(candidate, '.write_test')
                with open(probe, 'w') as _f:
                    _f.write('ok')
                os.remove(probe)
                self._root = candidate
                self._migrate_layout_if_needed()
                return self._root
            except Exception:
                continue

        # Should be unreachable (tempdir is always writable), but never leave
        # get_root_dir() able to raise — callers rely on it always returning
        # *some* path.
        self._root = os.path.join(os.getcwd(), 'SGF Data')
        try:
            os.makedirs(self._root, exist_ok=True)
        except Exception:
            pass
        return self._root

    def _migrate_layout_if_needed(self):
        """Move data from the old flat layout (top-level profiles/, mods/,
        themes/) into the new nested one (config/profiles/,
        mods/installed/, themes/installed/) introduced alongside the "SGF
        Data" rename. Additive only — never deletes anything; a file that
        already exists at the destination is left alone rather than
        overwritten."""
        if self._layout_migrated:
            return
        self._layout_migrated = True

        marker = os.path.join(self._root, _LAYOUT_VERSION_FILENAME)
        try:
            if os.path.exists(marker):
                with open(marker, 'r') as _f:
                    current = int((_f.read() or '0').strip() or '0')
                if current >= _DATA_LAYOUT_VERSION:
                    return
        except Exception:
            pass

        def _move_flat_contents(old_relpath, new_category):
            old_dir = os.path.join(self._root, old_relpath)
            if not os.path.isdir(old_dir):
                return
            new_dir = self._get_dir(new_category)
            if os.path.abspath(old_dir) == os.path.abspath(new_dir):
                return
            for entry in os.listdir(old_dir):
                if entry == os.path.basename(new_dir):
                    continue  # the new nested dir itself, if it lives inside the old one
                src = os.path.join(old_dir, entry)
                dst = os.path.join(new_dir, entry)
                if os.path.exists(dst):
                    continue  # never overwrite; leave the old copy where it was
                try:
                    os.rename(src, dst)
                except Exception:
                    pass

        try:
            _move_flat_contents('profiles', 'profiles')
            _move_flat_contents('mods', 'mods_installed')
            _move_flat_contents('themes', 'themes_installed')
        except Exception:
            pass

        try:
            with open(marker, 'w') as _f:
                _f.write(str(_DATA_LAYOUT_VERSION))
        except Exception:
            pass

    def _get_dir(self, category):
        if category in self._dir_cache:
            return self._dir_cache[category]
        dirname = self._CATEGORY_DIRNAMES[category]
        path = os.path.join(self.get_root_dir(), dirname)
        try:
            os.makedirs(path, exist_ok=True)
        except Exception:
            pass
        self._dir_cache[category] = path
        return path

    def get_data_dir(self):        return self.get_root_dir()
    def get_config_dir(self):      return self._get_dir('config')
    def get_settings_dir(self):    return self._get_dir('config_settings')
    def get_controls_dir(self):    return self._get_dir('config_controls')
    def get_game_settings_dir(self): return self._get_dir('game_settings')
    def get_save_dir(self):        return self._get_dir('saves')
    def get_replay_dir(self):      return self._get_dir('replays')
    def get_maps_dir(self):        return self._get_dir('maps')
    def get_maps_created_dir(self):  return self._get_dir('maps_created')
    def get_maps_imported_dir(self): return self._get_dir('maps_imported')
    def get_mod_dir(self):         return self._get_dir('mods_installed')
    def get_mods_root_dir(self):   return self._get_dir('mods')
    def get_theme_dir(self):       return self._get_dir('themes_installed')
    def get_themes_root_dir(self): return self._get_dir('themes')
    def get_log_dir(self):         return self._get_dir('logs')
    def get_cache_dir(self):       return self._get_dir('cache')
    def get_tools_dir(self):       return self._get_dir('tools')
    def get_backup_dir(self):      return self._get_dir('backups')
    def get_crash_dir(self):       return self._get_dir('crashes')
    def get_diagnostics_dir(self): return self._get_dir('diagnostics')
    def get_profile_dir(self):     return self._get_dir('profiles')

    # ---- category introspection / selective deletion (contract for IA-1) --
    def list_data_categories(self):
        return [
            {'name': name, 'path': self._get_dir(name), **self.get_category_stats(name)}
            for name in self._USER_FACING_CATEGORIES
        ]

    def get_category_stats(self, category, refresh=False):
        if category not in self._CATEGORY_DIRNAMES:
            raise ValueError(f'Unknown data category: {category}')
        now = time.monotonic()
        cached = self._category_stats_cache.get(category)
        if not refresh and cached and now - cached[0] < 1.0:
            return dict(cached[1])
        path = self._get_dir(category)
        total = file_count = 0
        latest_mtime = None
        try:
            for dirpath, _dirnames, filenames in os.walk(path):
                for filename in filenames:
                    try:
                        full_path = os.path.join(dirpath, filename)
                        if os.path.islink(full_path):
                            continue
                        stat = os.stat(full_path, follow_symlinks=False)
                        if not os.path.isfile(full_path):
                            continue
                        total += stat.st_size
                        file_count += 1
                        latest_mtime = stat.st_mtime if latest_mtime is None else max(latest_mtime, stat.st_mtime)
                    except OSError:
                        continue
        except OSError:
            pass
        result = {'size_bytes': total, 'file_count': file_count, 'last_modified': latest_mtime}
        self._category_stats_cache[category] = (now, result)
        return dict(result)

    def get_total_stats(self, refresh=False):
        """Return the footprint of the entire SGF Data root, including
        backups, helper tools, configuration files and unclassified content.
        The bounded cache keeps a storage overview from walking the tree on
        every UI frame. Symbolic links are excluded and never traversed."""
        now = time.monotonic()
        cached = self._total_stats_cache
        if not refresh and cached and now - cached[0] < 3.0:
            return dict(cached[1])
        total = file_count = 0
        root = self.get_root_dir()
        try:
            for dirpath, dirnames, filenames in os.walk(
                    root, topdown=True, followlinks=False):
                dirnames[:] = [dirname for dirname in dirnames
                               if not os.path.islink(os.path.join(dirpath, dirname))]
                for filename in filenames:
                    full_path = os.path.join(dirpath, filename)
                    try:
                        if os.path.islink(full_path):
                            continue
                        stat_result = os.stat(full_path, follow_symlinks=False)
                        if not _stat_mod.S_ISREG(stat_result.st_mode):
                            continue
                        total += stat_result.st_size
                        file_count += 1
                    except OSError:
                        continue
        except OSError:
            pass
        result = {'size_bytes': total, 'file_count': file_count}
        self._total_stats_cache = (now, result)
        return dict(result)

    def get_category_size(self, category):
        return self.get_category_stats(category)['size_bytes']

    def delete_category(self, category, keep_dir=True):
        """Delete every file inside ONE category directory. Never touches any
        other category — deleting replays can never delete saves, etc."""
        if category not in self._CATEGORY_DIRNAMES:
            return False, f"Unknown data category: {category}"
        path = self._get_dir(category)
        try:
            import shutil as _shutil
            self._category_stats_cache.pop(category, None)
            failures = []
            for entry in os.listdir(path):
                full = os.path.join(path, entry)
                try:
                    if os.path.islink(full) or not os.path.isdir(full):
                        os.remove(full)
                    else:
                        _shutil.rmtree(full)
                except OSError:
                    failures.append(entry)
            if keep_dir:
                os.makedirs(path, exist_ok=True)
            if failures:
                return False, f"Could not remove {len(failures)} item(s)"
            return True, None
        except Exception as e:
            return False, str(e)

    def delete_single_file(self, category, filename):
        """Delete one specific file inside one category (e.g. a single
        replay) without touching the rest of that category."""
        if category not in self._CATEGORY_DIRNAMES:
            return False, f"Unknown data category: {category}"
        path = os.path.abspath(self._get_dir(category))
        target = os.path.abspath(os.path.join(path, filename))
        if not target.startswith(path + os.sep):
            return False, "Invalid filename"
        try:
            if os.path.exists(target):
                os.remove(target)
            return True, None
        except Exception as e:
            return False, str(e)

    def open_data_folder(self):
        """Best-effort: open the root SGF Data folder in the OS file browser."""
        return _open_folder_in_os(self.get_root_dir())

    def export_data(self, dest_zip_path=None):
        """Zip settings/saves/replays/maps/mods/themes/profiles (NOT logs/
        cache/crashes/diagnostics) into one portable file for backup or
        transfer."""
        import zipfile
        if dest_zip_path is None:
            ts = datetime.now().strftime('%Y%m%d_%H%M%S_%f')
            dest_zip_path = os.path.join(self.get_backup_dir(), f'sgf_export_{ts}.zip')
        include = ['config', 'saves', 'replays', 'maps', 'mods', 'themes']
        dest_zip_path = os.path.abspath(dest_zip_path)
        temp_zip_path = f"{dest_zip_path}.tmp-{_secrets_mod.token_hex(6)}"
        try:
            os.makedirs(os.path.dirname(dest_zip_path) or '.', exist_ok=True)
            with zipfile.ZipFile(temp_zip_path, 'w', zipfile.ZIP_DEFLATED) as zf:
                for cat in include:
                    path = self._get_dir(cat)
                    for dirpath, dirnames, filenames in os.walk(
                            path, topdown=True, followlinks=False):
                        dirnames[:] = [dirname for dirname in dirnames
                                       if not os.path.islink(os.path.join(dirpath, dirname))]
                        for fn in filenames:
                            full = os.path.join(dirpath, fn)
                            if os.path.islink(full):
                                continue
                            rel = os.path.relpath(full, self.get_root_dir())
                            zf.write(full, rel)
            with zipfile.ZipFile(temp_zip_path, 'r') as zf:
                if zf.testzip() is not None:
                    raise zipfile.BadZipFile('Backup integrity check failed')
            os.replace(temp_zip_path, dest_zip_path)
            return dest_zip_path
        except Exception as e:
            print(f"Error exporting data: {e}")
            try:
                if os.path.exists(temp_zip_path):
                    os.remove(temp_zip_path)
            except OSError:
                pass
            return None

    def factory_reset(self, categories=None, backup_first=True):
        """Broad, explicit deletion across multiple categories. Never
        deletes application code, and backs up first by default."""
        if categories is None:
            categories = ['config', 'saves', 'replays', 'maps', 'mods', 'themes', 'cache']
        backup_path = self.export_data() if backup_first else None
        if backup_first and not backup_path:
            return {
                'backup_path': None,
                'results': {},
                'error': 'backup_failed',
            }
        results = {cat: self.delete_category(cat) for cat in categories}
        return {'backup_path': backup_path, 'results': results, 'error': None}


