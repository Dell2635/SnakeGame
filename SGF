    def _draw_metric(self, y, label, metric, unit='', allow_graph=True, summary=None):
        # Callers that render a metrics page should share one snapshot; building
        # it repeatedly sorts the rolling 60-second sample history each time.
        snap = summary if summary is not None else self.tools.telemetry.snapshot().get(metric, {})
        cur = snap.get('current')
        avg = snap.get('average')
        if cur is None:
            value = 'N/A'
        elif unit == 'ms':
            value = f'{cur:.2f} ms'
        elif unit == 'fps':
            value = f'{cur:.1f}'
        elif unit == 'mb':
            value = f'{cur:.1f} MB'
        elif unit == '%':
            value = f'{cur:.2f}%'
        elif unit == 'mbps':
            value = f'{cur:.2f} MB/s'
        else:
            value = f'{cur:.2f}' if isinstance(cur, float) else str(cur)
        rect = pygame.Rect(30, y, self.screen.get_width() - 60, 30)
        pygame.draw.rect(self.screen, (20, 26, 40), rect, border_radius=5)
        pygame.draw.rect(self.screen, (55, 65, 85), rect, 1, border_radius=5)
        self.screen.blit(self._font(14, True).render(label, True, COLORS['white']), (42, y + 6))
        vs = self._font(14).render(value, True, COLORS['light_gray'])
        self.screen.blit(vs, (rect.right - vs.get_width() - 50, y + 6))
        if allow_graph:
            gr = pygame.Rect(rect.right - 36, y + 5, 26, 20)
            self._button(gr, 'G')
        if avg is not None and cur is not None:
            avg_txt = self._font(10).render(f'avg {avg:.2f}', True, (130, 140, 165))
            self.screen.blit(avg_txt, (rect.x + 120, y + 8))
        return rect

    def _performance_snapshot(self):
        now = time.monotonic()
        cached = self._performance_snapshot_cache
        if cached is None or now - cached[0] >= 0.5:
            cached = (now, self.tools.telemetry.snapshot())
            self._performance_snapshot_cache = cached
        return cached[1]

    def _draw_performance(self, top):
        y = top + self.scroll
        snap = self._performance_snapshot()
        metrics = [
            ('FPS', 'fps', 'fps'), ('Frame time', 'frame_ms', 'ms'),
            ('1% low FPS', 'fps', 'fps'), ('0.1% low FPS', 'fps', 'fps'),
            ('CPU', 'cpu_percent', '%'), ('Memory', 'memory_mb', 'mb'),
            ('Allocation rate', 'allocation_mb_s', 'mbps'),
            ('Update time', 'update_ms', 'ms'), ('Render time', 'render_ms', 'ms'),
            ('Input time', 'input_ms', 'ms'), ('Other time', 'other_ms', 'ms'),
            ('GC time', 'gc_ms', 'ms'), ('AI time', 'ai_ms', 'ms'),
            ('Replay time', 'replay_ms', 'ms'), ('UI time', 'ui_ms', 'ms'),
        ]
        for label, metric, unit in metrics:
            if label == '1% low FPS':
                summary = snap.get('fps', {}); val = summary.get('low_1')
