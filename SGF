    def _ph_open_profiles(self):
        """List, create, and switch local player profiles."""
        while True:
            reopen = {'value': False}
            profiles = list_local_profiles()
            screen_ref = {'screen': None}
            entries = []
            for profile in profiles:
                profile_id = profile['id']
                profile_label = profile['name'] + (
                    ' ' + safe_mark(self.current_language, 'check')
                    if profile['active'] else '')
                def label(profile_label=profile_label):
                    return profile_label
                def activate(profile_id=profile_id):
                    ok, _error = switch_local_profile(profile_id)
                    if ok:
                        self._refresh_after_profile_switch()
                        reopen['value'] = True
                        screen_ref['screen']._running = False
                entries.append((f'profile_{profile_id}', label, COLORS['blue'], activate))

            taken = {p['name'].casefold() for p in profiles}
            guest_index = 1
            while f'guest {guest_index}'.casefold() in taken:
                guest_index += 1
            guest_name = f'Guest {guest_index}'

            def create_guest():
                new_id, _error = create_local_profile(guest_name)
                if new_id:
                    self._refresh_after_profile_switch()
                    reopen['value'] = True
                    screen_ref['screen']._running = False

            entries.append(('create_guest',
                            lambda: _t_or(self.settings.language, 'create_guest_profile', 'Create {name}').format(name=guest_name),
                            COLORS['green'], create_guest))
            profiles_screen = _SimpleMenuScreen(
                self.settings, self.screen,
                title_fn=lambda: _t_or(self.settings.language, 'manage_profiles', 'Manage Profiles'),
                entries=entries,
                body_fn=lambda: _t_or(self.settings.language, 'profile_switch_help',
                                      'Each profile keeps separate settings, scores and progress.'))
            screen_ref['screen'] = profiles_screen
            self._run_sub(profiles_screen.run, name='local_profiles', owner=profiles_screen)
            if not reopen['value']:
                break

