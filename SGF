                        self.settings.sfx_enabled   = getattr(self.temp_settings, 'sfx_enabled',   True)
                        self.settings.bgm_enabled   = getattr(self.temp_settings, 'bgm_enabled',   False)
                        # Apply volume to SoundManager immediately
                        try:
                            _vol = self.settings.master_volume / 100.0
                            for _snd in sounds()._sounds.values():
                                _snd.set_volume(_vol)
                        except Exception:
                            pass
                        _apply_bgm_state(self.settings)
                        
                        # Save all settings
                        self.settings.save()
                        running = False
                        
                    # Check for clicking on back button
                    elif controls['back_button'].collidepoint(mouse_pos):
                        running = False
                        
                elif event.type == pygame.MOUSEWHEEL:
                    # Wheel = scrolling only, never a click, and only affects
                    # the dropdown when it's open.
                    if language_dropdown_open and controls['language_options']:
                        max_scroll = max(0, len(sorted(LANGUAGES.keys())) - 6)
                        self.language_scroll_offset = max(0, min(max_scroll, self.language_scroll_offset - event.y))

                elif event.type == pygame.MOUSEBUTTONUP:
                    if dragging_language_scrollbar:
                        dragging_language_scrollbar = False
                    self._active_slider = None
                    
                    # Check if clicking outside the input fields when they're active
                    if self.refresh_input_active and controls.get('update_rate_input') and controls['update_rate_input'].width > 0 and not controls['update_rate_input'].collidepoint(event.pos):
                        # Apply the entered value if valid
                        if self.refresh_input_text:
                            try:
                                # Parse input as integer
                                new_rate = int(self.refresh_input_text.strip())
                                # Enforce range limits (1ms to 10000ms)
                                new_rate = max(1, min(10000, new_rate))
                                self.temp_settings.update_rate_ms = new_rate
                            except ValueError:
                                # Reset to current value if input is invalid
                                self.refresh_input_text = str(self.temp_settings.update_rate_ms)
                        
                        # Deactivate the input field
                        self.refresh_input_active = False
                        
                    # Check if clicking outside the board size input field when active
                    if self.board_size_input_active and controls.get('board_size_input') and controls['board_size_input'].width > 0 and not controls['board_size_input'].collidepoint(event.pos):
                        # Apply the entered value if valid
                        if self.board_size_input_text:
                            try:
                                # Parse input as integer
                                new_size = int(self.board_size_input_text.strip())
                                # Enforce range limits (3 to 100)
                                new_size = max(self.settings.min_board_size, min(self.settings.max_board_size, new_size))
                                self.temp_settings.board_size = new_size
                            except ValueError:
                                # Reset to current value if input is invalid
                                self.board_size_input_text = str(self.temp_settings.board_size)
                        
                        # Deactivate the input field
                        self.board_size_input_active = False
                        
                elif event.type == pygame.MOUSEMOTION:
                    if self._active_slider:
                        min_v, max_v = self._active_slider_range
                        val = self._slider_value_at(controls, self._active_slider, event.pos[0], min_v, max_v)
                        if val is not None:
                            setattr(self.temp_settings, self._active_slider, val)

                    # Handle scrollbar dragging for language dropdown
                    if dragging_language_scrollbar and language_dropdown_open:
                        # Calculate how far we've dragged
                        delta_y = event.pos[1] - scrollbar_drag_start_y
                        
                        # Convert pixel movement to scroll units
                        # Assuming 6 visible items and the scrollbar represents the full content
                        language_options = sorted(LANGUAGES.keys())
                        total_options = len(language_options)
                        visible_options = 6
                        
                        if total_options > visible_options:
                            # Calculate the scrollbar container height
                            dropdown_rect = pygame.Rect(
                                controls['language_dropdown'].x, 
                                controls['language_dropdown'].y + controls['language_dropdown'].height, 
                                controls['language_dropdown'].width, 
                                40 * visible_options  # Option height * visible count
                            )
                            scrollbar_container_height = dropdown_rect.height - 4
                            
                            # Calculate scroll unit value in pixels
                            scroll_range = total_options - visible_options
                            pixel_per_scroll = scrollbar_container_height / scroll_range
                            
                            # Calculate new scroll offset
                            new_offset = scrollbar_drag_start_offset + delta_y / pixel_per_scroll
                            self.language_scroll_offset = max(0, min(scroll_range, round(new_offset)))
                    
                    # Board size now uses text input instead of dropdown
                        
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    # Handle text input for refresh rate field when active
                    if self.refresh_input_active:
                        if event.key == pygame.K_RETURN or event.key == pygame.K_KP_ENTER:
                            # Apply the value and deactivate the field on Enter
                            try:
                                new_rate = int(self.refresh_input_text.strip())
                                new_rate = max(1, min(10000, new_rate))
                                self.temp_settings.update_rate_ms = new_rate
                                self.refresh_input_active = False
                            except ValueError:
                                # Reset to current value if invalid
                                self.refresh_input_text = str(self.temp_settings.update_rate_ms)
                        elif event.key == pygame.K_ESCAPE:
                            # Cancel editing on Escape
                            self.refresh_input_text = str(self.temp_settings.update_rate_ms)
                            self.refresh_input_active = False
                        elif event.key == pygame.K_BACKSPACE:
                            # Handle backspace for editing
                            self.refresh_input_text = self.refresh_input_text[:-1]
                        elif event.unicode.isdigit():
                            # Only accept digits for numeric input
                            # Limit to reasonable length to prevent overflow
                            if len(self.refresh_input_text) < 5:  # Max 5 digits (up to 10000)
                                self.refresh_input_text += event.unicode
                    
                    # Handle text input for board size field when active
                    elif self.board_size_input_active:
                        if event.key == pygame.K_RETURN or event.key == pygame.K_KP_ENTER:
                            # Apply the value and deactivate the field on Enter
                            try:
                                new_size = int(self.board_size_input_text.strip())
                                new_size = max(self.settings.min_board_size, min(self.settings.max_board_size, new_size))
                                self.temp_settings.board_size = new_size
                                self.board_size_input_active = False
                            except ValueError:
                                # Reset to current value if invalid
                                self.board_size_input_text = str(self.temp_settings.board_size)
                        elif event.key == pygame.K_ESCAPE:
                            # Cancel editing on Escape
                            self.board_size_input_text = str(self.temp_settings.board_size)
                            self.board_size_input_active = False
                        elif event.key == pygame.K_BACKSPACE:
                            # Handle backspace for editing
                            self.board_size_input_text = self.board_size_input_text[:-1]
                        elif event.unicode.isdigit():
                            # Only accept digits for numeric input
                            # Limit to reasonable length to prevent overflow
                            if len(self.board_size_input_text) < 3:  # Max 3 digits (up to 100)
                                self.board_size_input_text += event.unicode
                    # Close dropdowns with Escape key when input field not active
                    elif event.key == pygame.K_ESCAPE:
                        if language_dropdown_open:
                            language_dropdown_open = False
                            # Reset screen capture when closing dropdowns
                            self.current_screen = None
                        else:
                            running = False
                            
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
            
            # Cap the frame rate
            pygame.time.Clock().tick(60)


