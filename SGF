class CommandPaletteScreen:
    """Searchable, keyboard-first launcher for existing main-menu actions."""
    def __init__(self, settings, screen, commands):
        self.settings = settings
        self.screen = screen
        self.commands = list(commands)
        self.query = ''
        self.selected = 0
        self._shade = None

    def _matches(self):
        query = self.query.casefold().strip()
        if not query:
            return self.commands
        return [item for item in self.commands
                if query in item[1]().casefold() or
                any(query in alias.casefold() for alias in item[2])]

    def _draw(self, background, matches):
        self.screen.blit(background, (0, 0))
        if self._shade is None or self._shade.get_size() != self.screen.get_size():
            self._shade = pygame.Surface(self.screen.get_size(), pygame.SRCALPHA)
            self._shade.fill((0, 0, 0, 178))
        self.screen.blit(self._shade, (0, 0))
        sw, sh = self.screen.get_size()
        panel_w = max(1, min(720, sw - 32))
        row_h = max(32, min(48, int(sh * .075)))
        visible = max(1, min(7, (sh - 190) // row_h))
        count = min(visible, len(matches))
        panel_h = min(sh - 24, 132 + count * row_h)
        panel = pygame.Rect((sw-panel_w)//2, max(12,(sh-panel_h)//3), panel_w,panel_h)
        pygame.draw.rect(self.screen,(25,32,50),panel,border_radius=12)
        pygame.draw.rect(self.screen,(100,125,175),panel,2,border_radius=12)
        title = get_font(self.settings.language,'bold',22).render(
            get_text(self.settings.language,'command_palette'),True,COLORS['white'])
        self.screen.blit(title,title.get_rect(midtop=(panel.centerx,panel.y+14)))
        search_rect=pygame.Rect(panel.x+18,panel.y+52,panel.w-36,38)
        pygame.draw.rect(self.screen,(12,17,29),search_rect,border_radius=6)
        pygame.draw.rect(self.screen,(85,105,145),search_rect,1,border_radius=6)
        text=self.query or get_text(self.settings.language,'command_palette_hint')
        search=render_fit(get_font(self.settings.language,'regular',16),text,
                          COLORS['white'] if self.query else COLORS['gray'],search_rect.w-18)
        self.screen.blit(search,search.get_rect(midleft=(search_rect.x+9,search_rect.centery)))
        first=max(0,min(self.selected-visible+1,max(0,len(matches)-visible)))
        rows=[]
        for index,item in enumerate(matches[first:first+visible],first):
            rect=pygame.Rect(panel.x+14,panel.y+101+(index-first)*row_h,
                             panel.w-28,row_h-3)
            if index==self.selected:
                pygame.draw.rect(self.screen,(66,82,120),rect,border_radius=5)
            label=render_fit(get_font(self.settings.language,'regular',17),item[1](),
                             COLORS['white'],rect.w-18)
            self.screen.blit(label,label.get_rect(midleft=(rect.x+9,rect.centery)))
            rows.append((rect,item[0]))
        pygame.display.flip()
        return rows

    def run(self):
        clock=pygame.time.Clock()
        background=self.screen.copy()
        while True:
            matches=self._matches()
            self.selected=max(0,min(self.selected,len(matches)-1))
            rows=self._draw(background,matches)
            resized=False
            for event in pygame.event.get():
                if event.type==pygame.QUIT:
                    return None
                if event.type==pygame.VIDEORESIZE:
                    self.screen=pygame.display.set_mode((event.w,event.h),pygame.RESIZABLE)
                    background=pygame.transform.smoothscale(background,self.screen.get_size())
                    resized=True
                    break
                if event.type==pygame.MOUSEWHEEL and matches:
                    self.selected=max(0,min(len(matches)-1,self.selected-event.y))
                elif event.type==pygame.MOUSEBUTTONDOWN and event.button==1:
                    for rect,action in rows:
                        if rect.collidepoint(event.pos): return action
                elif event.type==pygame.KEYDOWN:
                    if event.key==pygame.K_ESCAPE: return None
                    if event.key in (pygame.K_RETURN,pygame.K_KP_ENTER):
                        return matches[self.selected][0] if matches else None
                    if event.key==pygame.K_UP and matches:
                        self.selected=(self.selected-1)%len(matches)
                    elif event.key==pygame.K_DOWN and matches:
                        self.selected=(self.selected+1)%len(matches)
                    elif event.key==pygame.K_HOME and matches: self.selected=0
                    elif event.key==pygame.K_END and matches: self.selected=len(matches)-1
                    elif event.key==pygame.K_BACKSPACE: self.query=self.query[:-1]; self.selected=0
                    elif event.unicode and event.unicode.isprintable() and not (event.mod & pygame.KMOD_CTRL):
                        self.query+=event.unicode; self.selected=0
            if resized:
                continue
            clock.tick(60)


