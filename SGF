                _guest = NetworkMatchN(_nm_settings, _nm_screen, False, '1v1', 'room-seed', None,
                                       _start['names'], _start['you'], link=_gl, session=_sess)
                _nm_cleanup.append(_guest.close)
                _guests.append(_guest)
            assert _nm_pump(_host, _guests, 8, lambda: all(len(g.engine.mp_history) > 3 for g in _guests))
            # guests draw exactly what the authoritative host simulates
            _host.engine.paused = True
            _nm_pump(_host, _guests, 1.0)
            _host_snap = _host.engine._mp_snap()
            for _g in _guests:
                _snap = _g.engine._mp_snap()
                assert _snap['snakes'] == _host_snap['snakes'] and _snap['scores'] == _host_snap['scores']
            _host.engine.paused = False
            # a guest's key reaches its own snake only
            _current = tuple(_host.engine.directions[1])
            _wanted = (0, 1) if _current[0] != 0 else (1, 0)
            _guests[0]._handle_key({(0, 1): pygame.K_DOWN, (1, 0): pygame.K_RIGHT}[_wanted])
            _other = tuple(_host.engine.directions[2])
            assert _nm_pump(_host, _guests, 4, lambda: tuple(_host.engine.directions[1]) == _wanted
                            or tuple(getattr(_host.engine, 'next_directions', [None] * 3)[1] or ()) == _wanted)
            # one guest drops: the whole match waits, then carries on after the resume
            _held = _host._session['listeners']
            _host._session['listeners'] = []
            _guests[1].link.conn.close()
            assert _nm_pump(_host, _guests, 5, lambda: _host.slot_state[2] == 'wait')
            _paused_at = len(_host.engine.mp_history)
