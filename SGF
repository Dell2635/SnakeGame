def _gather_crash_context():
    context = {
        'game_version': GAME_VERSION,
        'python_version': sys.version,
        'platform': sys.platform,
        'os_details': None,
        'pygame_version': None,
        'resolution': None,
        # Theme/Mod APIs are owned by IA-4; these placeholders keep the
        # crash-report shape stable and forward-compatible once wired in.
        'active_theme': 'default',
        'active_mods': [],
        'safe_mode': SAFE_MODE,
    }
    try:
        import platform as _platform_mod
        context['os_details'] = _platform_mod.platform()
    except Exception:
        pass
    try:
        context['pygame_version'] = pygame.version.ver
    except Exception:
        pass
    try:
        surf = pygame.display.get_surface()
        if surf:
            context['resolution'] = list(surf.get_size())
    except Exception:
        pass
    return context


def _write_crash_report(exc_type, exc_value, exc_tb):
    """Generate a crash report on an unhandled exception. Must never itself
    raise/crash — any failure here is swallowed and, at worst, printed."""
    try:
        import traceback as _tb_mod
        ts = datetime.now().strftime('%Y%m%d_%H%M%S')
        crash_path = os.path.join(_user_data_manager.get_crash_dir(), f'crash_{ts}.json')

        report = _gather_crash_context()
        report['timestamp'] = datetime.now().isoformat()
        report['traceback'] = ''.join(_tb_mod.format_exception(exc_type, exc_value, exc_tb))
        with _log_ring_lock:
            report['recent_log_events'] = list(_LOG_RING_BUFFER[-50:])

        with open(crash_path, 'w') as _f:
            json.dump(report, _f, indent=2)
        try:
            sgf_log.critical(f"Unhandled exception; crash report written to {crash_path}")
        except Exception:
            pass
        return crash_path
    except Exception as _report_err:
        try:
            print(f"(also failed to write crash report: {_report_err})")
        except Exception:
            pass
        return None


def _install_crash_handler():
    _default_hook = sys.excepthook

    def _hook(exc_type, exc_value, exc_tb):
        if issubclass(exc_type, KeyboardInterrupt):
            _default_hook(exc_type, exc_value, exc_tb)
            return
        _write_crash_report(exc_type, exc_value, exc_tb)
        _default_hook(exc_type, exc_value, exc_tb)

    sys.excepthook = _hook


_install_crash_handler()


