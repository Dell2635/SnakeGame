        _wide_btn("All",    col_x,       cur_y, 56, "difficulty:all",    self.filter_options["difficulty"] == "all")
        _wide_btn("Easy",   col_x + 60,  cur_y, 56, "difficulty:easy",   self.filter_options["difficulty"] == "easy")
        _wide_btn("Medium", col_x + 120, cur_y, 68, "difficulty:medium", self.filter_options["difficulty"] == "medium")
