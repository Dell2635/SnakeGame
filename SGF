class EncyclopediaScreen:
    """
    Browsable encyclopedia of everything discoverable in the game — fruits,
    power-ups, obstacles, portals, AI difficulties, and mechanics. Locked
    entries show as "???" until the player encounters them in a real match.
    """

    CATEGORIES = ['fruits', 'powerups', 'obstacles', 'portals', 'ai', 'mechanics']
    CATEGORY_LABELS = {
        'fruits': 'Fruits', 'powerups': 'Power-ups', 'obstacles': 'Obstacles',
        'portals': 'Portals', 'ai': 'AI', 'mechanics': 'Mechanics',
    }
    RARITY_COLORS = {
        'Common': (180, 190, 200), 'Uncommon': (100, 200, 120),
        'Rare': (90, 140, 230), 'Epic': (170, 90, 220),
    }

    def __init__(self, settings, screen):
        self.settings = settings
        self.screen = screen
        self.current_category = 'fruits'
        self.selected_entry = None
        self.scrollbar = None

    def _progress(self):
        return _load_encyclopedia_progress()

    def run(self):
        clock = pygame.time.Clock()
        progress = self._progress()

        while True:
            sw, sh = self.screen.get_width(), self.screen.get_height()
            self.screen.fill(COLORS['dark_blue'])

            title_font = get_font(self.settings.language, 'bold', max(22, int(sh * 0.045)))
            title = title_font.render("Encyclopedia", True, COLORS['white'])
            self.screen.blit(title, (sw // 2 - title.get_width() // 2, int(sh * 0.02)))

            # Category tabs
            tab_y = int(sh * 0.1)
            tab_h = max(32, int(sh * 0.05))
            gap = 6
            margin = max(10, int(sw * 0.03))
            tab_w = max(60, (sw - margin * 2 - gap * (len(self.CATEGORIES) - 1)) // len(self.CATEGORIES))
            tab_font = get_font(self.settings.language, 'bold', 14)
            tab_rects = {}
            tx = margin
            for cat in self.CATEGORIES:
                r = pygame.Rect(tx, tab_y, tab_w, tab_h)
                active = cat == self.current_category
                pygame.draw.rect(self.screen, (55, 110, 190) if active else (35, 45, 70), r, border_radius=6)
                pygame.draw.rect(self.screen, (90, 130, 200), r, width=1, border_radius=6)
                label = self.CATEGORY_LABELS[cat]
                unlocked_n = sum(1 for e in ENCYCLOPEDIA_CATALOG[cat] if progress.get(e['id'], {}).get('unlocked'))
                s = tab_font.render(f"{label} ({unlocked_n}/{len(ENCYCLOPEDIA_CATALOG[cat])})", True, COLORS['white'])
                self.screen.blit(s, s.get_rect(center=r.center))
                tab_rects[cat] = r
                tx += tab_w + gap

            # Entry list
            list_y = tab_y + tab_h + 14
            list_rect = pygame.Rect(margin, list_y, sw - margin * 2, int(sh * 0.55))
            pygame.draw.rect(self.screen, (18, 24, 45), list_rect, border_radius=8)

            entries = ENCYCLOPEDIA_CATALOG[self.current_category]
            row_h = 46
            content_h = len(entries) * row_h
            if self.scrollbar is None:
                self.scrollbar = ScrollBar(list_rect.right - 16, list_rect.y, 16, list_rect.height,
                                          max(content_h, list_rect.height))
            self.scrollbar.content_height = max(content_h, list_rect.height)
            self.scrollbar.max_scroll = max(0, self.scrollbar.content_height - list_rect.height)
            self.scrollbar.update()

            self.screen.set_clip(list_rect)
            offset = self.scrollbar.get_content_offset()
            name_font = get_font(self.settings.language, 'bold', 17)
            sub_font = get_font(self.settings.language, 'regular', 13)
            row_rects = []
            for i, entry in enumerate(entries):
                ry = list_rect.y + i * row_h - offset
                row_rect = pygame.Rect(list_rect.x + 6, ry, list_rect.width - 28, row_h - 6)
                row_rects.append((entry, row_rect))
                if row_rect.bottom < list_rect.top or row_rect.top > list_rect.bottom:
                    continue
                unlocked = progress.get(entry['id'], {}).get('unlocked', False)
                selected = self.selected_entry and self.selected_entry['id'] == entry['id']
                bg = (55, 90, 150) if selected else ((32, 40, 68) if unlocked else (24, 28, 42))
                pygame.draw.rect(self.screen, bg, row_rect, border_radius=6)

                if unlocked:
                    name_s = name_font.render(entry['name'], True, COLORS['white'])
                    rarity_color = self.RARITY_COLORS.get(entry['rarity'], (180, 180, 180))
                    rarity_s = sub_font.render(entry['rarity'], True, rarity_color)
                else:
                    name_s = name_font.render("???", True, (110, 118, 135))
                    rarity_s = sub_font.render("Not yet discovered", True, (90, 96, 110))
                self.screen.blit(name_s, (row_rect.x + 10, row_rect.y + 4))
                self.screen.blit(rarity_s, (row_rect.x + 10, row_rect.y + 4 + name_s.get_height()))
            self.screen.set_clip(None)
            self.scrollbar.draw(self.screen)

            # Detail panel
            detail_rect = pygame.Rect(margin, list_rect.bottom + 14, sw - margin * 2,
                                      sh - list_rect.bottom - 14 - int(sh * 0.08))
            pygame.draw.rect(self.screen, (18, 24, 45), detail_rect, border_radius=8)
            pygame.draw.rect(self.screen, (60, 90, 140), detail_rect, width=1, border_radius=8)

            if self.selected_entry:
                e = self.selected_entry
                unlocked = progress.get(e['id'], {}).get('unlocked', False)
                pad = 16
                if unlocked:
                    dn = get_font(self.settings.language, 'bold', 20).render(e['name'], True, COLORS['white'])
                    self.screen.blit(dn, (detail_rect.x + pad, detail_rect.y + pad))
                    rarity_color = self.RARITY_COLORS.get(e['rarity'], (180, 180, 180))
                    dr = get_font(self.settings.language, 'regular', 14).render(e['rarity'], True, rarity_color)
                    self.screen.blit(dr, (detail_rect.x + pad, detail_rect.y + pad + dn.get_height() + 2))

                    desc_font = get_font(self.settings.language, 'regular', 15)
                    dy = detail_rect.y + pad + dn.get_height() + dr.get_height() + 14
                    for line in _wrap_text(e['description'], desc_font, detail_rect.width - pad * 2):
                        ls = desc_font.render(line, True, (200, 210, 225))
                        self.screen.blit(ls, (detail_rect.x + pad, dy))
                        dy += desc_font.get_height() + 2
                    dy += 6
                    func_font = get_font(self.settings.language, 'regular', 15)
                    for line in _wrap_text("Function: " + e['function'], func_font, detail_rect.width - pad * 2):
                        ls = func_font.render(line, True, (150, 190, 230))
                        self.screen.blit(ls, (detail_rect.x + pad, dy))
                        dy += func_font.get_height() + 2

                    stats = progress.get(e['id'], {})
                    stat_font = get_font(self.settings.language, 'regular', 13)
                    stat_text = f"Encountered: {stats.get('encountered', 0)}    Collected/Used: {stats.get('used', 0)}"
                    ss = stat_font.render(stat_text, True, (140, 160, 190))
                    self.screen.blit(ss, (detail_rect.x + pad, detail_rect.bottom - ss.get_height() - 10))
                else:
                    lock_font = get_font(self.settings.language, 'regular', 16)
                    ls = lock_font.render("Play to discover this entry.", True, (120, 128, 145))
                    self.screen.blit(ls, (detail_rect.centerx - ls.get_width() // 2,
                                         detail_rect.centery - ls.get_height() // 2))
            else:
                hint_font = get_font(self.settings.language, 'regular', 15)
                hs = hint_font.render("Select an entry above to see details.", True, (120, 128, 145))
                self.screen.blit(hs, (detail_rect.centerx - hs.get_width() // 2,
                                     detail_rect.centery - hs.get_height() // 2))

            # Back button
            back_rect = pygame.Rect(sw // 2 - 70, sh - int(sh * 0.07), 140, max(36, int(sh * 0.055)))
            pygame.draw.rect(self.screen, COLORS['button'], back_rect, border_radius=8)
            bf = get_font(self.settings.language, 'bold', 16)
            bs = bf.render(get_text(self.settings.language, 'back'), True, COLORS['white'])
            self.screen.blit(bs, bs.get_rect(center=back_rect.center))

            pygame.display.flip()

            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit(); sys.exit()
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif event.key == pygame.K_ESCAPE:
                        return
                elif event.type == pygame.MOUSEWHEEL:
                    self.scrollbar.handle_event(event)
                elif event.type in (pygame.MOUSEBUTTONUP, pygame.MOUSEMOTION):
                    self.scrollbar.handle_event(event)
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    mp = event.pos
                    if back_rect.collidepoint(mp):
                        return
                    clicked_tab = False
                    for cat, r in tab_rects.items():
                        if r.collidepoint(mp):
                            self.current_category = cat
                            self.selected_entry = None
                            self.scrollbar = None
                            clicked_tab = True
                            break
                    if not clicked_tab and list_rect.collidepoint(mp):
                        for entry, row_rect in row_rects:
                            if row_rect.collidepoint(mp):
                                self.selected_entry = entry
                                break
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    self.scrollbar = None

            clock.tick(60)


