                    pygame.draw.rect(self.screen, COLORS['white'], rect, 2, border_radius=8)
                ts = render_fit(bf, label, COLORS['white'], rect.width)
                self.screen.blit(ts, ts.get_rect(center=rect.center))

            y += bh + 16
            seed_box = pygame.Rect(sw // 2 - max(260, int(sw * 0.42)) // 2,
                                   y, max(260, int(sw * 0.42)), max(40, int(sh * 0.065)))
            border = (0, 190, 255) if self.seed_active and self.seed_mode == 'custom' else (60, 70, 120)
            pygame.draw.rect(self.screen, (20, 25, 50), seed_box, border_radius=6)
            pygame.draw.rect(self.screen, border, seed_box, 2, border_radius=6)
            shown = self.seed_text if self.seed_text and self.seed_mode == 'custom' else 'Random seed'
            col = COLORS['white'] if self.seed_mode == 'custom' and self.seed_text else (100, 110, 140)
            st = sf.render(shown[-40:], True, col)
            self.screen.blit(st, (seed_box.x + 8, seed_box.centery - st.get_height() // 2))

            hint = sf.render(
                "Random = generate a new seed   |   Custom = enter your own seed",
                True, (100, 110, 140))
            self.screen.blit(hint, hint.get_rect(center=(sw // 2, seed_box.bottom + 18)))

            # Three-way navigation: Previous returns one step inside the
            # current setup flow; Back exits the setup to the higher-level Play menu.
            btn_h = max(38, int(sh * 0.07))
            gap = max(12, int(sw * 0.025))
            btn_w = max(100, min(170, int((sw - 2 * gap - int(sw * 0.08)) / 3)))
            total_w = btn_w * 3 + gap * 2
            nav_x = (sw - total_w) // 2
            row_y = seed_box.bottom + 58
            previous_rect = pygame.Rect(nav_x, row_y, btn_w, btn_h)
            start_rect = pygame.Rect(nav_x + btn_w + gap, row_y, btn_w, btn_h)
            back_rect = pygame.Rect(nav_x + 2 * (btn_w + gap), row_y, btn_w, btn_h)

            pygame.draw.rect(self.screen, COLORS['button'], previous_rect, border_radius=10)
            pygame.draw.rect(self.screen, (30, 160, 60), start_rect, border_radius=10)
            pygame.draw.rect(self.screen, (160, 50, 50), back_rect, border_radius=10)
            prev_s = bf.render(get_text(self.settings.language, 'previous'), True, COLORS['white'])
            start_s = bf.render("Start", True, COLORS['white'])
            back_s = bf.render(get_text(self.settings.language, 'back'), True, COLORS['white'])
            self.screen.blit(prev_s, prev_s.get_rect(center=previous_rect.center))
            self.screen.blit(start_s, start_s.get_rect(center=start_rect.center))
            self.screen.blit(back_s, back_s.get_rect(center=back_rect.center))

            _legacy_nav_draw(locals().get('self'))
            pygame.display.flip()

            for event in pygame.event.get():
                if _legacy_nav_event(locals().get('self'), event, locals()):
                    continue
                if event.type == pygame.QUIT:
                    pygame.quit(); sys.exit()
                elif event.type == pygame.KEYDOWN:
                    if self.seed_active and self.seed_mode == 'custom':
                        if event.key in (pygame.K_RETURN, pygame.K_KP_ENTER):
                            self.seed_active = False
                        elif event.key == pygame.K_ESCAPE:
                            self.seed_active = False
                        elif event.key == pygame.K_BACKSPACE:
                            self.seed_text = self.seed_text[:-1]
                        elif event.unicode and event.unicode != ' ' and len(self.seed_text) < 64:
                            self.seed_text += event.unicode
                    else:
                        if event.key == pygame.K_F11:
                            self.screen = _toggle_fullscreen(self.screen)
                        elif event.key == pygame.K_ESCAPE:
                            return NAV_BACK_LEVEL
                        elif event.key in (pygame.K_RETURN, pygame.K_KP_ENTER):
                            seed = self._result_seed()
                            _save_game_settings('singleplayer', {
                                'seed_mode': self.seed_mode,
                                'seed_value': self.seed_text if self.seed_mode == 'custom' else '',
                            })
                            return (seed,)
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    mp = event.pos
                    if random_rect.collidepoint(mp):
                        self.seed_mode = 'random'
                        self.seed_active = False
                    elif custom_rect.collidepoint(mp):
                        self.seed_mode = 'custom'
                    elif seed_box.collidepoint(mp) and self.seed_mode == 'custom':
                        self.seed_active = True
                    elif previous_rect.collidepoint(mp):
                        return NAV_PREVIOUS
                    elif start_rect.collidepoint(mp):
                        seed = self._result_seed()
                        _save_game_settings('singleplayer', {
                            'seed_mode': self.seed_mode,
                            'seed_value': self.seed_text if self.seed_mode == 'custom' else '',
                        })
                        return (seed,)
                    elif back_rect.collidepoint(mp):
                        return NAV_BACK_LEVEL
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
            clock.tick(60)

