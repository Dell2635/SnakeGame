def _score_replay_id(score, fallback='replay'):
    game_id = _safe_content_id(score.get('game_id'), fallback)
    stamp = score.get('timestamp') or score.get('date')
    if stamp:
        try:
            parsed = datetime.fromisoformat(str(stamp).replace('Z', '+00:00'))
            stamp = parsed.strftime('%Y-%m-%dT%H-%M-%S.%f')
        except (TypeError, ValueError):
            stamp = ''.join(ch if ch.isalnum() or ch in ('-', '_', '.') else '-' for ch in str(stamp))
            stamp = stamp.strip('-.')
    else:
        stamp = datetime.now().strftime('%Y-%m-%dT%H-%M-%S.%f')
    return _safe_content_id(f'{stamp}_{game_id}', fallback)


