            elif powerup['type'] == 'size_reduction':
                name = get_text(self.settings.language, 'size_reduction')
                color = COLORS['powerup_size_reduction']
            elif powerup['type'] == 'invincibility':
                name = get_text(self.settings.language, 'invincibility')
                color = COLORS['powerup_invincibility']
            elif powerup['type'] == 'double_points':
                name = get_text(self.settings.language, 'double_points')
