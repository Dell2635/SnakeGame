    def _do_connect(self, ip, requested_seed=None):
        """Attempt TCP connect + handshake and validate the host map/seed."""
        if not ip:
            return None
        self._pending_map = None
        self._pending_seed = None
        try:
            s = _socket_mod.socket(_socket_mod.AF_INET, _socket_mod.SOCK_STREAM)
            s.settimeout(6)
            s.connect((ip, self.PORT))
            s.setsockopt(_socket_mod.IPPROTO_TCP, _socket_mod.TCP_NODELAY, 1)
            s.setblocking(True)
            msg = _net_recv(s)
            if msg and msg.get('t') == 'hello':
                incoming_map = msg.get('map')
                if not _validate_net_map(incoming_map):
                    raise _NetProtocolError('host supplied an invalid map')
                expected_hash = msg.get('map_hash')
                actual_hash = _map_fingerprint(incoming_map)
                if expected_hash != actual_hash:
                    raise _NetProtocolError('map fingerprint mismatch')
                host_mode = msg.get('mode')
                if host_mode is not None and host_mode != getattr(self, '_expected_mode', host_mode):
                    raise _NetProtocolError('host mode mismatch')
                host_seed = str(msg.get('seed') or '').strip()
                if not host_seed:
                    raise _NetProtocolError('host did not provide a deterministic seed')
                self._pending_map = incoming_map
                self._pending_seed = host_seed
                if requested_seed and str(requested_seed).strip() and str(requested_seed).strip() != host_seed:
                    print('[network] joiner seed differs; host seed is authoritative')
                _net_send(s, {'t': 'hello_ack', 'map_hash': actual_hash, 'seed': host_seed})
                s.settimeout(None)
                return s
            s.close()
        except _NetProtocolError as _e:
            print(f"[network] protocol error during connect handshake: {_e}")
            try: s.close()
            except Exception: pass
        except OSError:
            # Connection dropped/reset mid-handshake — a normal thing to
            # happen while waiting for a peer to join over a LAN.
            pass
        except Exception as _e:
            print(f"[network] unexpected error during connect handshake: {_e}")
        return None

    def _show_error(self, text):
        clock = pygame.time.Clock()
        mf = get_font(self.settings.language, 'bold',    22)
        sf = get_font(self.settings.language, 'regular', 17)
        sw, sh = self.screen.get_width(), self.screen.get_height()
        self._draw_bg()
        es = mf.render(text, True, (255, 100, 100))
        self.screen.blit(es, (sw // 2 - es.get_width() // 2, sh // 2 - 30))
        ks = sf.render(get_text(self.settings.language, 'press_any_key'), True, (180, 180, 210))
        self.screen.blit(ks, (sw // 2 - ks.get_width() // 2, sh // 2 + 25))
        _legacy_nav_draw(locals().get('self'))
        pygame.display.flip()
        waiting = True
        while waiting:
            for e in pygame.event.get():
                if e.type in (pygame.KEYDOWN, pygame.MOUSEBUTTONDOWN):
                    waiting = False
            clock.tick(30)


class NetworkGame:
    """
    LAN multiplayer game session.

    is_host=True  → runs the full simulation (authoritative); sends state to client.
    is_host=False → renders state received from host; sends key presses to host.

    Both players use WASD or Arrow keys on their own device.
    """

    def __init__(self, settings, screen, is_host, conn, mode='1v1', custom_map=None, seed=None):
        self.settings  = settings
        self.screen    = screen
        self.is_host   = is_host
        self.conn      = conn
        self.mode      = mode
        self.seed      = seed if seed else generate_seed()
        self.custom_map = custom_map  # same map dict on both peers — sent by host during handshake
        self.connected = True
        self.disconnect_reason = None
        self._stop_event = threading.Event()
        self._recv_q   = _queue_mod.Queue(maxsize=256)

        # Start background receiver thread
        self._recv_t = threading.Thread(target=self._recv_loop, daemon=True)
        self._recv_t.start()

        if is_host:
            # Host owns the authoritative MultiplayerGame
            self.mp = MultiplayerGame(settings, screen, mode, seed=self.seed, custom_map=custom_map)
        else:
            # Client holds the last rendered state dict
            self.render_state = None
            self._local_dir   = (0, -1)   # for 180° guard
            # Client: shadow MultiplayerGame purely for replay recording —
            # built with the SAME custom_map the host sent during handshake,
            # so the client's saved replay has the same board/obstacles too.
            self._client_recorder = MultiplayerGame(settings, screen, mode, seed=self.seed, custom_map=custom_map)
            self._client_recorder.mp_history = []

        # Both peers keep a saved flag so we only persist once per match
        self._mp_saved = False

    # ── background receiver ──────────────────────────────────────────────

    def _queue_net_event(self, msg):
        try:
            self._recv_q.put_nowait(msg)
        except _queue_mod.Full:
            # State frames are disposable; preserve control/disconnect messages.
            if isinstance(msg, dict) and msg.get('t') == 'state':
                return
            try:
                self._recv_q.get_nowait()
            except _queue_mod.Empty:
                pass
            try:
                self._recv_q.put_nowait(msg)
            except _queue_mod.Full:
                pass

    def _recv_loop(self):
        while not self._stop_event.is_set():
            try:
                msg = _net_recv(self.conn)
                if msg is None:
                    self.connected = False
                    self.disconnect_reason = 'peer_disconnect'
                    self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason})
                    return
                self._queue_net_event(msg)
            except _NetProtocolError as exc:
                self.connected = False
                self.disconnect_reason = 'protocol_error'
                self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason, 'detail': str(exc)})
                print(f"[network] protocol error from peer: {exc}")
                return
            except (ConnectionError, BrokenPipeError, OSError) as exc:
                self.connected = False
                self.disconnect_reason = 'socket_error'
                self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason, 'detail': str(exc)})
                return
            except Exception as exc:
                # Do not disguise programming errors as a normal disconnect.
                self.connected = False
                self.disconnect_reason = 'receiver_error'
                self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason, 'detail': repr(exc)})
                print(f"[network] unexpected receiver failure: {exc}")
                return

    def _send_safe(self, msg):
        if not self.connected or self._stop_event.is_set():
            return False
        try:
            _net_send(self.conn, msg)
            return True
        except (ConnectionError, BrokenPipeError, OSError) as exc:
            self.connected = False
            self.disconnect_reason = 'send_socket_error'
            self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason, 'detail': str(exc)})
            return False
        except Exception as exc:
            self.connected = False
            self.disconnect_reason = 'send_error'
            self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason, 'detail': repr(exc)})
            print(f"[network] unexpected send failure: {exc}")
            return False

    def close(self):
        self._stop_event.set()
        self.connected = False
        try:
            self.conn.shutdown(_socket_mod.SHUT_RDWR)
        except (OSError, AttributeError):
            pass
        try:
            self.conn.close()
        except OSError:
            pass
        thread = getattr(self, '_recv_t', None)
        if thread and thread.is_alive() and thread is not threading.current_thread():
            thread.join(timeout=0.35)

    # ── host helpers ────────────────────────────────────────────────────

    def _state_dict(self):
        mp = self.mp
        return {
            't':  'state',
            'p1': [list(s) for s in mp.p1_snake],
            'p2': [list(s) for s in mp.p2_snake],
            'f':  list(mp.fruit_pos) if mp.fruit_pos else None,
            'ft': getattr(mp, 'fruit_type', 'regular'),
            's1': mp.p1_score,
            's2': mp.p2_score,
            'a1': mp.p1_alive,
            'a2': mp.p2_alive,
            'go': mp.game_over,
            'w':  mp.winner,
            'obs': [list(o) for o in mp.obstacles],
            'bw': mp.board_width,
            'bh': mp.board_height,
            'cs': mp.cell_size,
            'ox': mp.board_offset_x,
            'oy': mp.board_offset_y,
            'seed': getattr(mp, 'seed', None),
            # Authoritative per-frame replay snapshot (exact same structure
            # SnakeGame/MultiplayerGame use for their own replay history).
            # Sending this verbatim — rather than having the client
            # reconstruct its own snapshot from a subset of the fields above
            # — guarantees both peers end up with the byte-for-byte same
            # replay record for this match (same fruit_type, same
            # directions, same everything), instead of two independently
            # drifting "shadow" recordings.
            'snap': mp._mp_snap(),
        }

    def _apply_client_input(self, d_list):
        """Apply a direction from the client to P2 (avoids 180° reversal)."""
        nd = tuple(d_list)
        cur = self.mp.p2_dir
        if not (nd[0] == -cur[0] and nd[1] == -cur[1]):
            self.mp.p2_next = nd

    def _host_key(self, key):
        """Host controls P1 (WASD or Arrows)."""
        mp = self.mp
        mapping = {
            pygame.K_w: (0,-1), pygame.K_UP:    (0,-1),
            pygame.K_s: (0, 1), pygame.K_DOWN:  (0, 1),
            pygame.K_a: (-1,0), pygame.K_LEFT:  (-1,0),
            pygame.K_d: ( 1,0), pygame.K_RIGHT: ( 1,0),
        }
        if key not in mapping:
            return
        nd = mapping[key]
        cur = mp.p1_dir
        if not (nd[0] == -cur[0] and nd[1] == -cur[1]):
            mp.p1_next = nd

    # ── client helpers ───────────────────────────────────────────────────

    def _client_key(self, key):
        """Client controls P2; sends direction to host."""
        mapping = {
            pygame.K_w: (0,-1), pygame.K_UP:    (0,-1),
            pygame.K_s: (0, 1), pygame.K_DOWN:  (0, 1),
            pygame.K_a: (-1,0), pygame.K_LEFT:  (-1,0),
            pygame.K_d: ( 1,0), pygame.K_RIGHT: ( 1,0),
        }
        if key not in mapping:
            return
        nd = mapping[key]
        cur = self._local_dir
        if nd[0] == -cur[0] and nd[1] == -cur[1]:
            return
        self._local_dir = nd
        if self.connected:
            try:
                _net_send(self.conn, {'t': 'input', 'd': list(nd)})
            except OSError:
                self.connected = False
            except Exception as _e:
                print(f"[network] unexpected error sending input: {_e}")
                self.connected = False

    # ── rendering (client-side) ─────────────────────────────────────────

    def _draw_client(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        self.screen.fill(COLORS['background'])
        st = self.render_state

        if st is None:
            f = get_font(self.settings.language, 'bold', 24)
            s = f.render(get_text(self.settings.language, 'waiting_for_host'), True, COLORS['white'])
            self.screen.blit(s, (sw//2 - s.get_width()//2, sh//2 - s.get_height()//2))
            return

        bw = st.get('bw', 15); bh = st.get('bh', 15)
        cs = st.get('cs', 24); ox = st.get('ox', 0); oy = st.get('oy', 62)

        # Board
        pygame.draw.rect(self.screen, COLORS['board_background'],
                         pygame.Rect(ox, oy, bw*cs, bh*cs))
        for x in range(bw+1):
            pygame.draw.line(self.screen, COLORS['grid_line'],
                             (ox+x*cs, oy), (ox+x*cs, oy+bh*cs), 1)
        for y in range(bh+1):
            pygame.draw.line(self.screen, COLORS['grid_line'],
                             (ox, oy+y*cs), (ox+bw*cs, oy+y*cs), 1)

        # Obstacles
        for obs in st.get('obs', []):
            r = pygame.Rect(ox+obs[0]*cs, oy+obs[1]*cs, cs, cs)
            pygame.draw.rect(self.screen, COLORS.get('obstacle', (100,100,100)), r)

        # Fruit
        fp = st.get('f')
        if fp:
            fr = pygame.Rect(ox+fp[0]*cs, oy+fp[1]*cs, cs, cs)
            if cs >= 10 and self.settings.fruit_types_enabled:
                draw_fruit(self.screen, fr, st.get('ft', 'regular'))
            else:
                pygame.draw.rect(self.screen, COLORS['fruit'], fr)

        # Snakes
        def _ds(seg_list, bc, hc, alive):
            bc2 = bc if alive else (100,100,100)
            hc2 = hc if alive else (70,70,70)
            for i, seg in enumerate(seg_list or []):
                r = pygame.Rect(ox+seg[0]*cs+1, oy+seg[1]*cs+1, cs-2, cs-2)
                pygame.draw.rect(self.screen, hc2 if i==0 else bc2, r,
                                 border_radius=max(1, cs//5))

        _ds(st.get('p2',[]), MultiplayerGame.P2_BODY, MultiplayerGame.P2_HEAD, st.get('a2',True))
        _ds(st.get('p1',[]), MultiplayerGame.P1_BODY, MultiplayerGame.P1_HEAD, st.get('a1',True))

        # HUD
        hf = get_font(self.settings.language, 'bold',    20)
        sf = get_font(self.settings.language, 'regular', 14)
        lang = self.settings.language
        if self.mode == '1v1':
            p1c = (100,255,100) if st.get('a1',True) else (130,130,130)
            p2c = ( 80,215,255) if st.get('a2',True) else (130,130,130)
            self.screen.blit(hf.render(f"{get_text(lang, 'host_p1_score')}: {st.get('s1',0)}", True, p1c), (10, 8))
            s2 = hf.render(f"{get_text(lang, 'you_p2_score')}: {st.get('s2',0)}", True, p2c)
            self.screen.blit(s2, (sw - s2.get_width() - 10, 8))
        else:
            sc = st.get('s1',0) + st.get('s2',0)
            ss = hf.render(f"{get_text(lang, 'coop_score')}: {sc}", True, COLORS['white'])
            self.screen.blit(ss, (sw//2 - ss.get_width()//2, 8))
        tag = "1v1" if self.mode == '1v1' else get_text(lang, 'coop_label')
        ht = sf.render(get_text(lang, 'lan_controls_hint').format(mode=tag), True, (80,110,160))
        self.screen.blit(ht, (sw//2 - ht.get_width()//2, 44))

        # Game-over overlay
        if st.get('go'):
            ov = pygame.Surface((sw, sh), pygame.SRCALPHA)
            ov.fill((0,0,0,180)); self.screen.blit(ov, (0,0))
            bf = get_font(self.settings.language, 'bold',    50)
            mf2= get_font(self.settings.language, 'bold',    28)
            sf2= get_font(self.settings.language, 'regular', 20)
            w = st.get('w')
            if self.mode == '1v1':
                if   w==1:       txt,col = get_text(lang, 'host_wins'),    (100,255,100)
                elif w==2:       txt,col = get_text(lang, 'you_win_exclaim'), ( 80,215,255)
                elif w=='draw':  txt,col = get_text(lang, 'draw_exclaim'), (255,215,  0)
                else:            txt,col = get_text(lang, 'game_over'),    (200,200,200)
                sc_txt = f"{get_text(lang, 'host_p1_score')}: {st.get('s1',0)}     {get_text(lang, 'you_p2_score')}: {st.get('s2',0)}"
            else:
                if w=='coop_win': txt,col = get_text(lang, 'you_win_exclaim'), (100,255,100)
                else:             txt,col = get_text(lang, 'game_over'),  (255,80,80)
                sc_txt = f"{get_text(lang, 'team_score')}: {st.get('s1',0)+st.get('s2',0)}"
            for surf, y in [
                (bf.render(txt, True, col), sh//2-110),
                (mf2.render(sc_txt, True, COLORS['white']), sh//2-30),
                (sf2.render(get_text(lang, 'esc_back_menu'), True, (190,190,210)), sh//2+50),
            ]:
                self.screen.blit(surf, (sw//2 - surf.get_width()//2, y))

    def _draw_host_net_badge(self):
        lang = self.settings.language
        sf = get_font(self.settings.language, 'regular', 13)
        tag = "1v1" if self.mode == '1v1' else get_text(lang, 'coop_label')
        col = (80,255,80) if self.connected else (255,80,80)
        status = f"● {get_text(lang, 'connected_label')}" if self.connected else f"✕ {get_text(lang, 'disconnected_label')}"
        s = sf.render(f"[LAN {tag}] {status}", True, col)
        self.screen.blit(s, (self.screen.get_width() - s.get_width() - 8, 44))

    def _draw_conn_lost(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        self.screen.fill(COLORS['background'])
        ov = pygame.Surface((sw, sh), pygame.SRCALPHA)
        ov.fill((0,0,0,200)); self.screen.blit(ov, (0,0))
        bf = get_font(self.settings.language, 'bold',    38)
        sf = get_font(self.settings.language, 'regular', 20)
        lang = self.settings.language
        for surf, y in [
            (bf.render(get_text(lang, 'connection_lost_title'), True, (255,100,100)), sh//2-80),
            (sf.render(get_text(lang, 'connection_lost_msg'), True, (200,200,200)), sh//2-10),
            (sf.render(get_text(lang, 'connection_lost_esc'), True, (180,180,210)), sh//2+45),
        ]:
            self.screen.blit(surf, (sw//2 - surf.get_width()//2, y))

    # ── main loop ────────────────────────────────────────────────────────

    def run(self):
        running = True
        clock   = pygame.time.Clock()

        while running:
            # Drain receive queue
            while not self._recv_q.empty():
                try:
                    msg = self._recv_q.get_nowait()
                except _queue_mod.Empty:
                    break
                if not isinstance(msg, dict):
                    self.connected = False
                    self.disconnect_reason = 'protocol_error'
                    break
                if msg.get('t') == 'disconnect':
                    self.connected = False
                    self.disconnect_reason = msg.get('reason', 'peer_disconnect')
                    break
                t = msg.get('t')
                if self.is_host:
                    if t == 'input':
                        d = msg.get('d')
                        if _validate_net_direction(d):
                            self._apply_client_input(d)
                        else:
                            self.connected = False
                            self.disconnect_reason = 'protocol_error'
                            self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason, 'detail': 'invalid direction payload'})
                            break
                    elif t == 'restart_req' and self.mp.game_over:
                        self.mp.reset()
                        self._mp_saved = False
                        if self.connected:
                            try:
                                self._send_safe({'t': 'restart'})
                            except OSError:
                                self.connected = False
                            except Exception as _e:
                                print(f"[network] unexpected error sending restart: {_e}")
                                self.connected = False
                else:
                    if t == 'state':
                        if not _validate_net_state_message(msg):
                            self.connected = False
                            self.disconnect_reason = 'protocol_error'
                            print('[network] rejected invalid state payload from host')
                            break
                        self.render_state = msg
                        # Record this frame using the host's exact authoritative
                        # snapshot — not a client-side reconstruction — so both
                        # peers end up with the identical replay record for
                        # this match (same fruit types, directions, everything).
                        rec = self._client_recorder
                        rec.board_width  = msg.get('bw', rec.board_width)
                        rec.board_height = msg.get('bh', rec.board_height)
                        rec.seed = msg.get('seed', rec.seed)
                        snap = msg.get('snap')
                        if snap and (not rec.mp_history or rec.mp_history[-1] != snap):
                            rec.mp_history.append(snap)
                        # Keep a few fields mirrored on rec itself too, in case
                        # save_match() or anything else reads current state
                        # directly rather than through mp_history.
                        rec.p1_score  = msg.get('s1', 0)
                        rec.p2_score  = msg.get('s2', 0)
                        rec.game_over = msg.get('go', False)
                        rec.winner    = msg.get('w')
                    elif t == 'restart':
                        self.render_state = None
                        self._client_recorder.mp_history = []
                        self._mp_saved = False

            # Connection-lost screen
            if not self.connected:
                self._draw_conn_lost()
                _legacy_nav_draw(locals().get('self'))
                pygame.display.flip()
                for event in pygame.event.get():
                    if _legacy_nav_event(locals().get('self'), event, locals()):
                        continue
                    if getattr(self, 'runtime', None) is not None:
                        handled, _actions = self.runtime.input.route(event)
                        if handled:
                            continue
                    if event.type == pygame.QUIT:
                        running = False
                    elif event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                        running = False
                clock.tick(30)
                continue

            # Event handling
            for event in pygame.event.get():
                if _legacy_nav_event(locals().get('self'), event, locals()):
                    continue
                if getattr(self, 'runtime', None) is not None:
                    handled, _actions = self.runtime.input.route(event)
                    if handled:
                        continue
                if event.type == pygame.QUIT:
                    running = False
                elif event.type == pygame.KEYDOWN:
                    k = event.key
                    if k == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif k == pygame.K_ESCAPE:
                        running = False
                    elif k == pygame.K_r:
                        if self.is_host and self.mp.game_over:
                            self.mp.reset()
                            try:
                                self._send_safe({'t': 'restart'})
                            except OSError:
                                self.connected = False
                            except Exception as _e:
                                print(f"[network] unexpected error sending restart: {_e}")
                                self.connected = False
                        elif not self.is_host:
                            try:
                                self._send_safe({'t': 'restart_req'})
                            except OSError:
                                self.connected = False
                            except Exception as _e:
                                print(f"[network] unexpected error sending restart_req: {_e}")
                                self.connected = False
                    elif k == pygame.K_p and self.is_host and not self.mp.game_over:
                        self.mp.paused = not self.mp.paused
                        if getattr(self, 'runtime', None) is not None:
                            self.runtime.set_game_paused(self.mp.paused, {'game': 'network'})
                    elif self.is_host and not self.mp.game_over and not self.mp.paused:
                        self._host_key(k)
                    elif not self.is_host:
                        go = self.render_state.get('go') if self.render_state else False
                        if not go:
                            self._client_key(k)
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode(
                        (event.w, event.h), pygame.RESIZABLE)
                    if self.is_host:
                        self.mp._init_layout()

            # Host: tick + send state
            if self.is_host:
                now = time.time() * 1000
                if not self.mp.paused and not self.mp.game_over:
                    if now - self.mp.last_tick >= self.settings.update_rate_ms:
                        self.mp.tick()
                        self.mp.last_tick = now
                # Send state every frame so the client stays fresh
                if self.connected:
                    self._send_safe(self._state_dict())

                self.mp.draw()
                self._draw_host_net_badge()
            else:
                self._draw_client()

            # Persist the match locally on whichever peer sees game-over
            if not self._mp_saved:
                if self.is_host and self.mp.game_over:
                    self.mp.save_match(p1_name='Host', p2_name='Client', source='lan_host')
                    self._mp_saved = True
                elif (not self.is_host) and self.render_state and self.render_state.get('go'):
                    self._client_recorder.save_match(
                        p1_name='Host', p2_name='You', source='lan_client')
                    self._mp_saved = True

            _legacy_nav_draw(locals().get('self'))
            pygame.display.flip()
            clock.tick(60)

        # Cleanup: stop receiver and close the socket cleanly so daemon threads
        # cannot outlive the game screen or keep a launcher process alive.
        self.close()
        _runtime_emit(self, 'NETWORK_DISCONNECTED', {'reason': self.disconnect_reason or 'local_exit'})


