class MultiplayerGame:
    """Standalone two-player Snake game.  mode is '1v1' or 'coop'."""

    P1_BODY = (50,  205,  50)
    P1_HEAD = (20,  165,  20)
    P2_BODY = ( 0,  200, 230)
    P2_HEAD = ( 0,  130, 160)

    def __init__(self, settings, screen, mode='1v1', p2_is_ai=False, ai_difficulty='medium', seed=None, custom_map=None):
        self.settings     = settings
        self.screen       = screen
        self.mode         = mode
        self.p2_is_ai     = p2_is_ai
        self.ai_difficulty = ai_difficulty
        self.custom_map   = custom_map  # optional Map Editor layout: obstacles only (no portals yet in this mode)
        # Seed / RNG system
        self.seed = seed if seed else generate_seed()
        self.rng  = SeedRNG(self.seed)
        self._p2_ai = SnakeAI(ai_difficulty, rng=SeedRNG(self.seed + '_p2ai')) if p2_is_ai else None
        # Initialise replay flags BEFORE reset() so _mp_snap() is safe
        self.replay_mode      = False
        self.replay_index     = 0
        self.replay_speed     = 1.0
        self._replay_last_t   = 0.0
        self._replay_exit     = False
        self.mp_history       = []
        self._init_layout()
        self.reset()

    # ── layout ──────────────────────────────────────────────────────────

    def _board_size(self):
        if isinstance(self.settings.board_size, str):
            m = {"small": 10, "medium": 15, "large": 20, "extra_large": 25}
            return m.get(self.settings.board_size, 15)
        return max(10, int(self.settings.board_size))

    def _init_layout(self):
        if self.custom_map:
            self.board_width  = self.custom_map.get('board_width', 20)
            self.board_height = self.custom_map.get('board_height', 20)
        else:
            size = self._board_size()
            self.board_width  = size
            self.board_height = size
        sw, sh = self.screen.get_width(), self.screen.get_height()
        hud_h = 62
        self.cell_size      = min(sw, sh - hud_h) // max(self.board_width, self.board_height, 1)
        self.board_offset_x = (sw - self.board_width  * self.cell_size) // 2
        self.board_offset_y = hud_h + (sh - hud_h - self.board_height * self.cell_size) // 2

    # ── reset ────────────────────────────────────────────────────────────

    def reset(self):
        # Re-seed so restarting reproduces the exact same sequence for
        # this seed instead of continuing the RNG stream from before.
        self.rng = SeedRNG(self.seed)

        # Recreate the AI engine too — see VSAIGame.reset() for why reusing
        # the old SnakeAI object would break seed reproducibility.
        self._p2_ai = SnakeAI(self.ai_difficulty, rng=SeedRNG(self.seed + '_p2ai')) if self.p2_is_ai else None
        self._init_layout()
        bw, bh = self.board_width, self.board_height

        self.p1_snake = [(bw // 4,       bh // 2)]
        self.p1_dir   = ( 1,  0)
        self.p1_next  = ( 1,  0)
        self.p1_score = 0
        self.p1_alive = True

        self.p2_snake = [(3 * bw // 4,   bh // 2)]
        self.p2_dir   = (-1,  0)
        self.p2_next  = (-1,  0)
        self.p2_score = 0
        self.p2_alive = True

        self.obstacles = []
        if self.custom_map:
            self.obstacles = [tuple(o) for o in self.custom_map.get('obstacles', [])]
        elif self.settings.enable_obstacles:
            self._gen_obstacles()

        self.fruit_pos  = self._new_fruit()
        self.fruit_type = _pick_cosmetic_fruit_type(getattr(self.settings, 'fruit_types_enabled', True), self.rng)
        self.game_over  = False
        self.winner     = None          # 1, 2, 'draw', 'coop_win', 'coop_lose'
        self.paused     = False
        self.last_tick  = time.time() * 1000
        # Reset replay recording for a fresh match
        if not getattr(self, 'replay_mode', False):
            self.mp_history = [self._mp_snap()]

    def _gen_obstacles(self):
        safe = set()
        for dx in range(-3, 4):
            for dy in range(-3, 4):
                p1x, p1y = self.p1_snake[0]
                p2x, p2y = self.p2_snake[0]
                safe.add((p1x + dx, p1y + dy))
                safe.add((p2x + dx, p2y + dy))
        available = [(x, y) for x in range(self.board_width)
                     for y in range(self.board_height) if (x, y) not in safe]
        count = min(getattr(self.settings, 'obstacle_count', 5),
                    len(available) // 4, 20)
        if count > 0 and available:
            self.obstacles = self.rng.sample(available, count)

    def _new_fruit(self):
        occupied = set(self.p1_snake + self.p2_snake + self.obstacles)
        avail = [(x, y) for x in range(self.board_width)
                 for y in range(self.board_height) if (x, y) not in occupied]
        return self.rng.choice(avail) if avail else None

    # ── input ────────────────────────────────────────────────────────────

    def handle_key(self, key):
        if   key == pygame.K_w     and self.p1_dir != ( 0,  1): self.p1_next = ( 0, -1)
        elif key == pygame.K_s     and self.p1_dir != ( 0, -1): self.p1_next = ( 0,  1)
        elif key == pygame.K_a     and self.p1_dir != ( 1,  0): self.p1_next = (-1,  0)
        elif key == pygame.K_d     and self.p1_dir != (-1,  0): self.p1_next = ( 1,  0)
        elif key == pygame.K_UP    and self.p2_dir != ( 0,  1): self.p2_next = ( 0, -1)
        elif key == pygame.K_DOWN  and self.p2_dir != ( 0, -1): self.p2_next = ( 0,  1)
        elif key == pygame.K_LEFT  and self.p2_dir != ( 1,  0): self.p2_next = (-1,  0)
        elif key == pygame.K_RIGHT and self.p2_dir != (-1,  0): self.p2_next = ( 1,  0)

    # ── update ───────────────────────────────────────────────────────────

    def _new_head(self, snake, direction):
        hx, hy = snake[0]
        dx, dy = direction
        if self.settings.wall_collision:
            nx, ny = hx + dx, hy + dy
            if not (0 <= nx < self.board_width and 0 <= ny < self.board_height):
                return None
            return (nx, ny)
        return ((hx + dx) % self.board_width, (hy + dy) % self.board_height)

    def tick(self):
        if self.game_over or self.paused:
            return

        # AI controls P2 if enabled
        if self.p2_is_ai and self._p2_ai and self.p2_alive:
            occ = list(self.obstacles) + list(self.p2_snake[:-1]) + list(self.p1_snake[:-1])
            d   = self._p2_ai.choose_direction(
                snake          = self.p2_snake,
                occupied       = occ,
                fruit          = self.fruit_pos,
                board_w        = self.board_width,
                board_h        = self.board_height,
                portals        = None,
                powerup_pos    = None,
                wall_collision = self.settings.wall_collision,
                opponent_snake = self.p1_snake,
            )
            self.p2_next = d

        self.p1_dir = self.p1_next
        self.p2_dir = self.p2_next

        h1 = self._new_head(self.p1_snake, self.p1_dir) if self.p1_alive else None
        h2 = self._new_head(self.p2_snake, self.p2_dir) if self.p2_alive else None

        p1_die = h1 is None
        p2_die = h2 is None

        # Head-on collision (both arrive at same cell simultaneously)
        if h1 and h2 and h1 == h2:
            p1_die = p2_die = True

        # Self-collision
        if h1 and not p1_die and h1 in self.p1_snake[:-1]:
            p1_die = True
        if h2 and not p2_die and h2 in self.p2_snake[:-1]:
            p2_die = True

        # Obstacle collision
        obs_set = set(map(tuple, self.obstacles))
        if h1 and not p1_die and h1 in obs_set:
            p1_die = True
        if h2 and not p2_die and h2 in obs_set:
            p2_die = True

        # 1v1 only: hitting the opponent's body is fatal
        if self.mode == '1v1':
            p2_body = set(self.p2_snake[:-1])
            p1_body = set(self.p1_snake[:-1])
            if h1 and not p1_die and h1 in p2_body:
                p1_die = True
            if h2 and not p2_die and h2 in p1_body:
                p2_die = True

        # Move snakes and collect fruit
        pts = max(1, int(10 * 1000 / max(1, self.settings.update_rate_ms)))
        p1_ate = p2_ate = False

        if not p1_die and h1:
            self.p1_snake.insert(0, h1)
            if h1 == self.fruit_pos:
                self.p1_score += pts
                p1_ate = True
            else:
                self.p1_snake.pop()

        if not p2_die and h2:
            self.p2_snake.insert(0, h2)
            if h2 == self.fruit_pos and not p1_ate:
                self.p2_score += pts
                p2_ate = True
            elif not p2_ate:
                self.p2_snake.pop()

        if p1_ate or p2_ate:
            self.fruit_pos = self._new_fruit()
            self.fruit_type = _pick_cosmetic_fruit_type(getattr(self.settings, 'fruit_types_enabled', True), self.rng)

        if p1_die: self.p1_alive = False
        if p2_die: self.p2_alive = False

        # End conditions
        if self.mode == '1v1':
            if not self.p1_alive or not self.p2_alive:
                self.game_over = True
                if not self.p1_alive and not self.p2_alive:
                    if   self.p1_score > self.p2_score: self.winner = 1
                    elif self.p2_score > self.p1_score: self.winner = 2
                    else:                               self.winner = 'draw'
                elif not self.p1_alive: self.winner = 2
                else:                   self.winner = 1
        else:  # coop
            if not self.p1_alive or not self.p2_alive:
                self.game_over = True
                self.winner = 'coop_lose'

        # Record per-tick snapshot (skip while replaying)
        if not self.replay_mode:
            self.mp_history.append(self._mp_snap())

    # ── replay / persistence ─────────────────────────────────────────────

    def _mp_snap(self):
        return [
            [list(s) for s in self.p1_snake],
            [list(s) for s in self.p2_snake],
            list(self.p1_dir),
            list(self.p2_dir),
            self.p1_score,
            self.p2_score,
            bool(self.p1_alive),
            bool(self.p2_alive),
            list(self.fruit_pos) if self.fruit_pos else None,
            [list(o) for o in self.obstacles],
            bool(self.game_over),
            self.winner,
            self.board_width,
            self.board_height,
            self.mode,
            getattr(self, 'fruit_type', 'regular'),  # 15
        ]

    def _mp_load_snap(self, snap):
        self.p1_snake   = [tuple(s) for s in snap[0]]
        self.p2_snake   = [tuple(s) for s in snap[1]]
        self.p1_dir     = tuple(snap[2]); self.p1_next = self.p1_dir
        self.p2_dir     = tuple(snap[3]); self.p2_next = self.p2_dir
        self.p1_score   = snap[4]
        self.p2_score   = snap[5]
        self.p1_alive   = bool(snap[6])
        self.p2_alive   = bool(snap[7])
        self.fruit_pos  = tuple(snap[8]) if snap[8] else None
        self.obstacles  = [tuple(o) for o in (snap[9] or [])]
        self.game_over  = bool(snap[10])
        self.winner     = snap[11]
        if len(snap) > 12: self.board_width  = snap[12]
        if len(snap) > 13: self.board_height = snap[13]
        if len(snap) > 14: self.mode         = snap[14]
        self.fruit_type = snap[15] if len(snap) > 15 else 'regular'
        self._init_layout()
        self.board_width  = snap[12] if len(snap) > 12 else self.board_width
        self.board_height = snap[13] if len(snap) > 13 else self.board_height

    def save_match(self, p1_name='Player 1', p2_name='Player 2', source='local'):
        """Save this finished match into the unified highscores list."""
        try:
            data = _load_data()
            highscores = data.get('highscores', [])
            if not isinstance(highscores, list):
                highscores = []

            game_id = f"mp-{int(time.time())}-{random.randint(1000,9999)}"
            settings_dict = {
                k: v for k, v in vars(self.settings).items()
                if isinstance(v, (int, float, str, bool, list, dict)) and v is not None
            }

            entry = {
                'name':            f"{p1_name} vs {p2_name}" if self.mode == '1v1'
                                   else f"{p1_name} + {p2_name}",
                'score':           max(self.p1_score, self.p2_score)
                                   if self.mode == '1v1'
                                   else (self.p1_score + self.p2_score),
                'date':            datetime.now().strftime('%Y-%m-%d %H:%M'),
                'board_size':      self.board_width,
                'update_rate_ms':  self.settings.update_rate_ms,
                'victory':         False,
                'wall_collision':  self.settings.wall_collision,
                'powerups_enabled':    False,
                'fruit_types_enabled': self.settings.fruit_types_enabled,
                'obstacles_enabled':   self.settings.enable_obstacles,
                'portals_enabled':     False,
                'portal_pairs':        0,
                'game_id':         game_id,
                'seed':            getattr(self, 'seed', None),
                'has_replay':      len(self.mp_history) > 1,
                'settings':        settings_dict,
                'is_multiplayer':  True,
                'mp_mode':         self.mode,
                'mp_source':       source,
                'p1_name':         p1_name,
                'p2_name':         p2_name,
                'p1_score':        self.p1_score,
                'p2_score':        self.p2_score,
                'winner':          self.winner,
                'custom_map':      self.custom_map,
                'actual_board_width':  self.board_width,
                'actual_board_height': self.board_height,
                'mp_history':      self.mp_history,
            }
            highscores.append(entry)
            highscores.sort(key=lambda x: x.get('score', 0), reverse=True)
            highscores = highscores[:50]
            data['highscores'] = highscores
            _save_data(data)
        except Exception as e:
            print(f"Error saving multiplayer match: {e}")

    def start_replay(self, mp_history):
        if not mp_history:
            return False
        self.replay_mode    = True
        self.mp_history     = mp_history
        self.replay_index   = 0
        self.replay_speed   = 1.0
        self._replay_exit   = False
        self._mp_load_snap(self.mp_history[0])
        return True

    def run_replay(self):
        """Playback loop for a recorded multiplayer match."""
        clock = pygame.time.Clock()
        paused = False
        last_step = time.time() * 1000

        while not self._replay_exit:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    self._replay_exit = True
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_ESCAPE:
                        self._replay_exit = True
                    elif event.key == pygame.K_SPACE:
                        paused = not paused
                    elif event.key == pygame.K_RIGHT:
                        self.replay_index = min(len(self.mp_history)-1, self.replay_index + 1)
                        self._mp_load_snap(self.mp_history[self.replay_index])
                    elif event.key == pygame.K_LEFT:
                        self.replay_index = max(0, self.replay_index - 1)
                        self._mp_load_snap(self.mp_history[self.replay_index])
                    elif event.key == pygame.K_HOME:
                        self.replay_index = 0
                        self._mp_load_snap(self.mp_history[0])
                    elif event.key in (pygame.K_PLUS, pygame.K_EQUALS):
                        self.replay_speed = min(8.0, self.replay_speed * 2)
                    elif event.key == pygame.K_MINUS:
                        self.replay_speed = max(0.125, self.replay_speed / 2)
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    self._init_layout()

            now = time.time() * 1000
            step_ms = max(20, self.settings.update_rate_ms / max(0.125, self.replay_speed))
            if not paused and now - last_step >= step_ms:
                if self.replay_index < len(self.mp_history) - 1:
                    self.replay_index += 1
                    self._mp_load_snap(self.mp_history[self.replay_index])
                last_step = now

            self.draw()
            f = get_font(self.settings.language, 'bold', 16)
            tag = f.render(
                f"● REPLAY  {self.replay_index+1}/{len(self.mp_history)}  "
                f"x{self.replay_speed:g}  [Space pause  ←/→ step  +/- speed  ESC exit]",
                True, (255, 200, 80))
            self.screen.blit(tag, (10, self.screen.get_height() - 24))
            pygame.display.flip()
            clock.tick(60)

    def draw(self):
        self.screen.fill(COLORS['background'])
        self._draw_hud()
        self._draw_board()
        # Draw P2 first so P1 appears on top when they overlap
        self._draw_snake(self.p2_snake, self.P2_BODY, self.P2_HEAD, self.p2_alive)
        self._draw_snake(self.p1_snake, self.P1_BODY, self.P1_HEAD, self.p1_alive)
        if self.game_over:
            self._draw_game_over()
        elif self.paused:
            self._draw_paused()

    def _draw_board(self):
        bx, by = self.board_offset_x, self.board_offset_y
        bw_px  = self.board_width  * self.cell_size
        bh_px  = self.board_height * self.cell_size

        pygame.draw.rect(self.screen, COLORS['board_background'],
                         pygame.Rect(bx, by, bw_px, bh_px))

        for x in range(self.board_width + 1):
            pygame.draw.line(self.screen, COLORS['grid_line'],
                             (bx + x * self.cell_size, by),
                             (bx + x * self.cell_size, by + bh_px), 1)
        for y in range(self.board_height + 1):
            pygame.draw.line(self.screen, COLORS['grid_line'],
                             (bx, by + y * self.cell_size),
                             (bx + bw_px, by + y * self.cell_size), 1)

        cs = self.cell_size
        for obs in self.obstacles:
            r = pygame.Rect(bx + obs[0]*cs, by + obs[1]*cs, cs, cs)
            pygame.draw.rect(self.screen, COLORS.get('obstacle', (100,100,100)), r)
            if cs > 10:
                lw = max(1, cs // 10)
                lc = COLORS.get('obstacle_highlight', (130,130,130))
                pygame.draw.line(self.screen, lc, r.topleft,   r.bottomright, lw)
                pygame.draw.line(self.screen, lc, r.bottomleft, r.topright,   lw)

        if self.fruit_pos:
            fr = pygame.Rect(bx + self.fruit_pos[0]*cs,
                             by + self.fruit_pos[1]*cs, cs, cs)
            if cs >= 10 and self.settings.fruit_types_enabled:
                draw_fruit(self.screen, fr, getattr(self, 'fruit_type', 'regular'))
            else:
                pygame.draw.rect(self.screen, COLORS['fruit'], fr)

    def _draw_snake(self, snake, body_col, head_col, alive):
        if not snake:
            return
        bc = body_col if alive else (100, 100, 100)
        hc = head_col if alive else ( 70,  70,  70)
        cs = self.cell_size
        bx, by = self.board_offset_x, self.board_offset_y
        for i, (sx, sy) in enumerate(snake):
            r = pygame.Rect(bx + sx*cs + 1, by + sy*cs + 1, cs - 2, cs - 2)
            col = hc if i == 0 else bc
            pygame.draw.rect(self.screen, col, r, border_radius=max(1, cs // 5))
            if i == 0 and cs > 10:
                es = max(2, cs // 7)
                ey = r.y + r.height // 3
                for ex in (r.x + r.width // 3, r.x + 2 * r.width // 3):
                    pygame.draw.circle(self.screen, (255, 255, 255), (ex, ey), es)
                    pygame.draw.circle(self.screen, (0, 0, 0),       (ex, ey), max(1, es // 2))

    def _draw_hud(self):
        sw = self.screen.get_width()
        hf = get_font(self.settings.language, 'bold',    20)
        sf = get_font(self.settings.language, 'regular', 14)

        lang = self.settings.language
        p1_lbl = get_text(lang, 'p1_wasd')
        p2_lbl = get_text(lang, 'p2_arrows')
        if self.mode == '1v1':
            p1c = (100, 255, 100) if self.p1_alive else (130, 130, 130)
            p2c = ( 80, 215, 255) if self.p2_alive else (130, 130, 130)
            p1s = hf.render(f"{p1_lbl}: {self.p1_score}",     True, p1c)
            p2s = hf.render(f"{p2_lbl}: {self.p2_score}",   True, p2c)
            self.screen.blit(p1s, (10, 8))
            self.screen.blit(p2s, (sw - p2s.get_width() - 10, 8))
            if not self.game_over:
                if   self.p1_score > self.p2_score: lt, lc = get_text(lang, 'p1_leading'), (100, 255, 100)
                elif self.p2_score > self.p1_score: lt, lc = get_text(lang, 'p2_leading'), ( 80, 215, 255)
                else:                               lt, lc = get_text(lang, 'tied'),       (200, 200, 200)
                ls = sf.render(lt, True, lc)
                self.screen.blit(ls, (sw // 2 - ls.get_width() // 2, 16))
        else:
            sc = self.p1_score + self.p2_score
            ss = hf.render(f"{get_text(lang, 'coop_score')}: {sc}", True, COLORS['white'])
            self.screen.blit(ss, (sw // 2 - ss.get_width() // 2, 8))
            alive_txt = get_text(lang, 'alive_status')
            dead_txt = get_text(lang, 'dead_status')
            p1t = f"{p1_lbl}  {alive_txt if self.p1_alive else dead_txt}"
            p2t = f"{p2_lbl}  {alive_txt if self.p2_alive else dead_txt}"
            p1s = sf.render(p1t, True, (100, 255, 100) if self.p1_alive else (255, 80, 80))
            p2s = sf.render(p2t, True, ( 80, 215, 255) if self.p2_alive else (255, 80, 80))
            self.screen.blit(p1s, (10, 12))
            self.screen.blit(p2s, (sw - p2s.get_width() - 10, 12))

        mode_tag = "1v1" if self.mode == '1v1' else get_text(lang, 'coop_label')
        hint = sf.render(
            get_text(lang, 'mp_controls_hint').format(mode=mode_tag),
            True, (80, 110, 160))
        self.screen.blit(hint, (sw // 2 - hint.get_width() // 2, 44))

    def _draw_game_over(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        ov = pygame.Surface((sw, sh), pygame.SRCALPHA)
        ov.fill((0, 0, 0, 185))
        self.screen.blit(ov, (0, 0))

        bf = get_font(self.settings.language, 'bold',    52)
        mf = get_font(self.settings.language, 'bold',    30)
        sf = get_font(self.settings.language, 'regular', 22)

        lang = self.settings.language
        if self.mode == '1v1':
            if   self.winner == 1:      txt, col = get_text(lang, 'player1_wins'),  (100, 255, 100)
            elif self.winner == 2:      txt, col = get_text(lang, 'player2_wins'),  ( 80, 215, 255)
            else:                       txt, col = get_text(lang, 'draw_exclaim'),  (255, 215,   0)
            sc_txt = get_text(lang, 'score_pair').format(p1=self.p1_score, p2=self.p2_score)
        else:
            if self.winner == 'coop_win':
                txt, col = get_text(lang, 'you_win_exclaim'), (100, 255, 100)
            else:
                who = "P1" if not self.p1_alive else "P2"
                txt, col = get_text(lang, 'player_died').format(player=who), (255, 80, 80)
            sc_txt = f"{get_text(lang, 'team_score')}: {self.p1_score + self.p2_score}"

        ts  = bf.render(txt,    True, col)
        scs = mf.render(sc_txt, True, COLORS['white'])
        its = sf.render(get_text(lang, 'restart_hint_mp'), True, (190, 190, 210))

        self.screen.blit(ts,  (sw // 2 - ts.get_width()  // 2, sh // 2 - 110))
        self.screen.blit(scs, (sw // 2 - scs.get_width() // 2, sh // 2 -  30))
        self.screen.blit(its, (sw // 2 - its.get_width() // 2, sh // 2 +  50))

    def _draw_paused(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        ov = pygame.Surface((sw, sh), pygame.SRCALPHA)
        ov.fill((0, 0, 0, 110))
        self.screen.blit(ov, (0, 0))
        f  = get_font(self.settings.language, 'bold',    50)
        f2 = get_font(self.settings.language, 'regular', 22)
        s  = f.render(get_text(self.settings.language, 'paused').upper(), True, COLORS['white'])
        s2 = f2.render(get_text(self.settings.language, 'press_p_to_resume'), True, (180, 180, 210))
        self.screen.blit(s,  (sw // 2 - s.get_width()  // 2, sh // 2 - s.get_height()  // 2))
        self.screen.blit(s2, (sw // 2 - s2.get_width() // 2, sh // 2 + 40))

    # ── main loop ────────────────────────────────────────────────────────

    def run(self):
        running = True
        clock   = pygame.time.Clock()
        saved   = False

        while running:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif event.key == pygame.K_ESCAPE:
                        running = False
                    elif event.key == pygame.K_r and self.game_over:
                        self.reset()
                        saved = False
                    elif event.key == pygame.K_p and not self.game_over:
                        self.paused = not self.paused
                    elif not self.game_over and not self.paused:
                        self.handle_key(event.key)
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode(
                        (event.w, event.h), pygame.RESIZABLE)
                    self._init_layout()

            now = time.time() * 1000
            if not self.paused and not self.game_over:
                if now - self.last_tick >= self.settings.update_rate_ms:
                    self.tick()
                    self.last_tick = now

            if self.game_over and not saved and not self.replay_mode:
                self.save_match(source='local')
                saved = True

            self.draw()
            pygame.display.flip()
            clock.tick(60)


class MultiplayerModeScreen:
