        self.screen.blit(instr2_surface, instr2_surface.get_rect(center=(sw // 2, by + btn_h + 72)))
        
    def save_score(self):
        """Save the player's score to high scores if it's high enough"""
        _flush_encyclopedia_updates(getattr(self, '_enc_updates', {}))
        self._enc_updates = {}  # avoid double-flushing if save_score() is somehow called twice

        if self.score <= 0:
            return
            
        try:
            _gd = _load_data()
            highscores = _gd.get('highscores', [])
            if not isinstance(highscores, list):
                highscores = []
        except Exception:
            highscores = []
        
        # Generate unique ID for this game
        game_id = f"{int(time.time())}-{self.rng.randint(1000, 9999)}"
            
        # Create a dictionary with serializable settings
        settings_dict = {}
        for key, value in vars(self.settings).items():
            # Only include serializable settings (skip complex objects, functions, etc.)
            if isinstance(value, (int, float, str, bool, list, dict)) and value is not None:
                settings_dict[key] = value
        
        # Full per-tick snapshot list for replay playback
        has_replay = len(self.game_history) > 0

        # Add current score to highscores with detailed settings
        highscores.append({
            'name': self.player_name if self.player_name else get_text(self.settings.language, 'unnamed_player'),
            'score': self.score,
            'date': datetime.now().strftime('%Y-%m-%d %H:%M'),
            'board_size': self.settings.board_size,
            'update_rate_ms': self.settings.update_rate_ms,
            'victory': self.victory,
            'wall_collision': self.settings.wall_collision,
            'powerups_enabled': self.settings.powerups_enabled,
            'fruit_types_enabled': self.settings.fruit_types_enabled,
            'obstacles_enabled': self.settings.enable_obstacles,
            'portals_enabled': self.settings.enable_portals,
            'portal_pairs': self.settings.portal_pairs if self.settings.enable_portals else 0,
            'seed': self.seed,
            'game_id': game_id,
            'has_replay': has_replay,
            'settings': settings_dict,
            'custom_map': self.custom_map,  # None if procedural — lets replay use the exact same board
            'actual_board_width': self.board_width,
            'actual_board_height': self.board_height,
            'game_history': self.game_history,
        })
        
        # Sort highscores by score (descending)
        highscores.sort(key=lambda x: x['score'], reverse=True)
        
        # Keep only top 10 scores
        highscores = highscores[:10]
        
        # Save to unified data file
        try:
            _gd2 = _load_data()
            _gd2['highscores'] = highscores
            _save_data(_gd2)
        except Exception as _e:
            print(f"Error saving score: {_e}")
            
