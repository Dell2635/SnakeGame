class SoundManager:
    """Generates and plays simple synthesized sound effects using pygame.mixer."""
    def __init__(self):
        self._sounds = {}
        self._enabled = True
        self._bgm_sound = None
        self._bgm_channel = None
        try:
            if not pygame.mixer.get_init():
                pygame.mixer.init(frequency=22050, size=-16, channels=1, buffer=512)
            self._build()
        except Exception:
            self._enabled = False

    @staticmethod
    def _wave(freq, dur_ms, vol=0.45, rate=22050):
        import struct
        n = int(rate * dur_ms / 1000)
        data = [int(32767 * vol * math.sin(2 * math.pi * freq * i / rate)) for i in range(n)]
        # short fade-out to remove click
        fade = min(n, int(rate * 0.02))
        for i in range(fade):
            data[n - 1 - i] = int(data[n - 1 - i] * (i / fade))
        return struct.pack('<' + 'h' * n, *data)

    def _build(self):
        specs = {
            'eat':      (880, 80,  0.40),
            'eat_gold': (1047,120, 0.50),
            'click':    (660, 50,  0.25),
            'powerup':  (528, 200, 0.45),
            'portal':   (330, 180, 0.40),
            'gameover': (220, 500, 0.50),
            'victory':  (784, 400, 0.55),
            'levelup':  (698, 250, 0.50),
            'combo':    (1175,100, 0.45),
        }
        for name, (f, d, v) in specs.items():
            try:
                self._sounds[name] = pygame.mixer.Sound(buffer=self._wave(f, d, v))
            except Exception:
                pass

    def play(self, name):
        if self._enabled:
            try:
                s = self._sounds.get(name)
                if s:
                    s.play()
            except Exception:
                pass

    @staticmethod
    def _build_bgm_buffer(rate=22050):
        """Procedurally synthesize a short, seamlessly-looping background
        music buffer — a soft pentatonic melody over a steady low drone.
        Generated in memory; no external audio files needed."""
        notes = [261.63, 293.66, 329.63, 392.00, 440.00]  # C D E G A (major pentatonic)
        pattern = [0, 2, 4, 3, 2, 1, 0, 3, 4, 2, 3, 1, 0, 4, 2, 0]  # 16 steps, loops cleanly
        step_ms = 280
        drone_freq = 65.41  # C2 — constant soft drone under the melody

        n_step = int(rate * step_ms / 1000)
        total_n = n_step * len(pattern)
        data = [0.0] * total_n

        attack = max(1, int(n_step * 0.06))
        release = max(1, int(n_step * 0.35))

        for step_i, note_idx in enumerate(pattern):
            freq = notes[note_idx]
            base = step_i * n_step
            for i in range(n_step):
                t = i / rate
                env = 1.0
                if i < attack:
                    env = i / attack
                elif i > n_step - release:
                    env = max(0.0, (n_step - i) / release)
                data[base + i] += 0.22 * env * math.sin(2 * math.pi * freq * t)

        # Constant soft drone underneath (own continuous phase, no per-note clicks)
        for i in range(total_n):
            t = i / rate
            data[i] += 0.09 * math.sin(2 * math.pi * drone_freq * t)

        # Defensive normalize, then pack as 16-bit PCM
        peak = max(0.001, max(abs(x) for x in data))
        scale = min(1.0, 0.9 / peak)
        ints = [int(max(-32767, min(32767, x * scale * 32767))) for x in data]
        return struct.pack('<' + 'h' * total_n, *ints)

    def _ensure_bgm(self):
        if self._bgm_sound is None and self._enabled:
            try:
                self._bgm_sound = pygame.mixer.Sound(buffer=self._build_bgm_buffer())
            except Exception:
                self._bgm_sound = None
        return self._bgm_sound

    def play_bgm(self, volume=0.5):
        """Start looping background music if it isn't already playing.
        Safe to call repeatedly — a no-op if it's already running."""
        if not self._enabled:
            return
        snd = self._ensure_bgm()
        if not snd:
            return
        try:
            volume = max(0.0, min(1.0, volume))
            if self._bgm_channel is None or not self._bgm_channel.get_busy():
                snd.set_volume(volume)
                self._bgm_channel = snd.play(loops=-1)
            else:
                self._bgm_channel.set_volume(volume)
        except Exception:
            pass

    def stop_bgm(self):
        try:
            if self._bgm_channel:
                self._bgm_channel.stop()
        except Exception:
            pass
        finally:
            self._bgm_channel = None

    def set_bgm_volume(self, volume):
        volume = max(0.0, min(1.0, volume))
        try:
            if self._bgm_channel:
                self._bgm_channel.set_volume(volume)
            if self._bgm_sound:
                self._bgm_sound.set_volume(volume)
        except Exception:
            pass

# Module-level sound manager (lazily initialised)
_SOUND_MGR = None

def sounds():
    global _SOUND_MGR
    if _SOUND_MGR is None:
        _SOUND_MGR = SoundManager()
    return _SOUND_MGR

def _apply_bgm_state(settings):
    """Start or stop background music to match current settings. Safe to
    call anytime — on startup, or right after Settings are saved — so a
    toggle takes effect immediately without needing a restart."""
    try:
        mgr = sounds()
        if getattr(settings, 'bgm_enabled', False):
            volume = (getattr(settings, 'master_volume', 80) / 100.0) * 0.5  # sits under SFX
            mgr.play_bgm(volume=volume)
        else:
            mgr.stop_bgm()
    except Exception:
        pass

def draw_apple(surface, rect, color=(255, 50, 50)):
    """Draw a realistic apple texture"""
    # Draw the main apple body
    pygame.draw.circle(surface, color, rect.center, rect.width // 2 - 2)
    
    # Add some shading to create a 3D effect
    darker_color = (max(0, color[0] - 60), max(0, color[1] - 60), max(0, color[2] - 60))
    shadow_rect = pygame.Rect(rect.centerx - rect.width // 4, rect.centery, rect.width // 2, rect.height // 2)
    pygame.draw.ellipse(surface, darker_color, shadow_rect)
    
    # Add a small indentation at the top (where the stem goes)
    indent_rect = pygame.Rect(rect.centerx - 3, rect.top + 2, 6, 4)
    pygame.draw.ellipse(surface, darker_color, indent_rect)
    
    # Draw a stem
    stem_rect = pygame.Rect(rect.centerx - 2, rect.top + 1, 4, 7)
    pygame.draw.rect(surface, (101, 67, 33), stem_rect, border_radius=1)  # Brown stem
    
    # Draw a leaf
    leaf_points = [
        (rect.centerx + 2, rect.top + 6),
        (rect.centerx + 8, rect.top + 3),
        (rect.centerx + 4, rect.top)
    ]
    pygame.draw.polygon(surface, (50, 205, 50), leaf_points)  # Green leaf
    
    # Add highlight for shininess
    highlight_pos = (rect.centerx - rect.width // 6, rect.centery - rect.height // 4)
    highlight_radius = max(2, rect.width // 10)
    pygame.draw.circle(surface, (255, 255, 255, 150), highlight_pos, highlight_radius)

def draw_orange(surface, rect, color=(255, 140, 0)):
    """Draw a realistic orange texture"""
    # Draw the main orange body
    pygame.draw.circle(surface, color, rect.center, rect.width // 2 - 1)
    
    # Add texture - orange dimples
    dimple_color = (max(0, color[0] - 30), max(0, color[1] - 20), max(0, color[2] - 10))
    dimple_size = max(1, rect.width // 15)
    
    # Create a pattern of dimples all over the orange
    for angle in range(0, 360, 45):
        for radius_pct in [0.35, 0.7]:
            radius = rect.width // 2 * radius_pct
            x = rect.centerx + int(radius * math.cos(math.radians(angle)))
            y = rect.centery + int(radius * math.sin(math.radians(angle)))
            pygame.draw.circle(surface, dimple_color, (x, y), dimple_size)
    
    # Draw small stem/leaf at top
    stem_rect = pygame.Rect(rect.centerx - 2, rect.top + 2, 4, 3)
    pygame.draw.rect(surface, (101, 67, 33), stem_rect, border_radius=1)  # Brown stem
    
    # Small green leaf
    leaf_rect = pygame.Rect(rect.centerx - 3, rect.top + 1, 6, 4)
    pygame.draw.ellipse(surface, (30, 160, 30), leaf_rect)  # Green leaf
    
    # Add highlight
    highlight_pos = (rect.centerx - rect.width // 5, rect.centery - rect.height // 5)
    highlight_radius = max(1, rect.width // 12)
    pygame.draw.circle(surface, (255, 255, 255, 150), highlight_pos, highlight_radius)

def draw_banana(surface, rect, color=(255, 220, 60)):
    """Draw a banana as a curved crescent — distinct from the round fruits,
    not a circle/ellipse blob."""
    cx, cy = rect.centerx, rect.centery
    w, h = rect.width, rect.height

    # Crescent built from an outer arc and a slightly-tighter inner arc,
    # swept through ~140 degrees so it reads as a curved banana at a glance.
    outer_r = w * 0.60
    inner_r = w * 0.32
    start_angle = math.radians(205)
    end_angle = math.radians(335)
    steps = 14

    outer_pts = []
    inner_pts = []
    for i in range(steps + 1):
        t = start_angle + (end_angle - start_angle) * i / steps
        outer_pts.append((cx + outer_r * math.cos(t), cy + outer_r * math.sin(t) * 0.9 - h * 0.05))
        inner_pts.append((cx + inner_r * math.cos(t), cy + inner_r * math.sin(t) * 0.9 - h * 0.05))

    polygon = outer_pts + inner_pts[::-1]
    pygame.draw.polygon(surface, color, polygon)
    pygame.draw.polygon(surface, tuple(max(0, c - 50) for c in color), polygon, width=max(1, w // 25))

    # Ridge line along the curve for a bit of dimensionality
    mid_pts = [((o[0] + i[0]) / 2, (o[1] + i[1]) / 2) for o, i in zip(outer_pts, inner_pts)]
    if len(mid_pts) > 1:
        pygame.draw.lines(surface, tuple(min(255, c + 25) for c in color), False, mid_pts, max(1, w // 30))

    # Brown tips at both ends — the clearest "this is a banana" signal
    tip_r = max(2, int(w * 0.09))
    pygame.draw.circle(surface, (101, 67, 33), (int(outer_pts[0][0]), int(outer_pts[0][1])), tip_r)
    pygame.draw.circle(surface, (101, 67, 33), (int(outer_pts[-1][0]), int(outer_pts[-1][1])), tip_r)

def draw_strawberry(surface, rect, color=(255, 0, 50)):
    """Draw a realistic strawberry texture"""
    # Draw the main heart-shaped strawberry body
    # We'll use a combination of circles and a triangle
    
    center_x, center_y = rect.center
    radius = min(rect.width, rect.height) // 3
    
    # Draw two circles for the top of the heart
    circle1_center = (center_x - radius // 2, center_y - radius // 2)
    circle2_center = (center_x + radius // 2, center_y - radius // 2)
    
    pygame.draw.circle(surface, color, circle1_center, radius)
    pygame.draw.circle(surface, color, circle2_center, radius)
    
    # Draw a triangle for the bottom of the heart
    triangle_points = [
        (center_x - radius, center_y),
        (center_x + radius, center_y),
        (center_x, center_y + radius * 1.5)
    ]
    pygame.draw.polygon(surface, color, triangle_points)
    
    # Add seeds (small yellow dots)
    seed_color = (255, 255, 200)
    seed_size = max(1, rect.width // 20)
    
    _local_rng = random.Random(hash((rect.x, rect.y, rect.width)))
    for _ in range(12):
        angle = _local_rng.uniform(0, 2 * math.pi)
        distance = _local_rng.uniform(0.3, 0.9) * radius
        x = center_x + int(distance * math.cos(angle))
        y = center_y + int(distance * math.sin(angle))
        pygame.draw.ellipse(surface, seed_color, (x - seed_size // 2, y - seed_size // 2, seed_size, seed_size // 2))
    
    # Add green leaf crown at the top
    leaf_color = (30, 180, 30)
    
    leaf_points = [
        (center_x, center_y - radius * 1.2),  # Center point
        (center_x - radius, center_y - radius * 0.8),  # Left point
        (center_x - radius // 2, center_y - radius),  # Left inner
        (center_x, center_y - radius * 1.4),  # Top middle
        (center_x + radius // 2, center_y - radius),  # Right inner
        (center_x + radius, center_y - radius * 0.8),  # Right point
    ]
    
    pygame.draw.polygon(surface, leaf_color, leaf_points)
    
    # Add stem
    stem_rect = pygame.Rect(center_x - 2, center_y - radius * 1.3, 4, 5)
    pygame.draw.rect(surface, (101, 67, 33), stem_rect)  # Brown stem

def draw_blueberry(surface, rect, color=(0, 0, 205)):
    """Draw a realistic blueberry texture"""
    # Draw the main blueberry body
    pygame.draw.circle(surface, color, rect.center, rect.width // 2 - 1)
    
    # Add a small indentation at the bottom
    bottom_indent = pygame.Rect(
        rect.centerx - rect.width // 6,
        rect.bottom - rect.height // 6,
        rect.width // 3,
        rect.height // 6
    )
    
    darker_blue = (max(0, color[0] - 30), max(0, color[1] - 30), max(0, color[2] - 30))
    pygame.draw.ellipse(surface, darker_blue, bottom_indent)
    
    # Add a white/gray bloom effect (the dusty coating blueberries have)
    bloom_color = (200, 200, 255, 40)  # Semi-transparent light blue/white
    
    _local_rng = random.Random(hash((rect.x, rect.y, rect.width)))
    for _ in range(6):
        angle = _local_rng.uniform(0, 2 * math.pi)
        distance = _local_rng.uniform(0.3, 0.9) * (rect.width // 3)
        x = rect.centerx + int(distance * math.cos(angle))
        y = rect.centery + int(distance * math.sin(angle))
        bloom_size = max(1, rect.width // 12)
        pygame.draw.circle(surface, (200, 200, 255), (x, y), bloom_size)
    
    # Add a small crown at the top
    crown_color = (60, 40, 30)  # Dark brown/gray
    crown_rect = pygame.Rect(
        rect.centerx - rect.width // 6,
        rect.top + rect.height // 10,
        rect.width // 3,
        rect.height // 8
    )
    
    pygame.draw.ellipse(surface, crown_color, crown_rect)
    
    # Add a tiny hole in the center of the crown
    hole_size = max(1, rect.width // 15)
    pygame.draw.circle(surface, (20, 20, 40), 
                      (rect.centerx, rect.top + rect.height // 8), 
                      hole_size)

def draw_watermelon(surface, rect, color=(220, 20, 60)):
    """Draw a realistic watermelon slice texture"""
    # Draw a triangular slice shape
    slice_points = [
        (rect.centerx, rect.top + rect.height // 6),  # Top point
        (rect.left + rect.width // 6, rect.bottom - rect.height // 6),  # Bottom left
        (rect.right - rect.width // 6, rect.bottom - rect.height // 6)   # Bottom right
    ]
    
    # Draw the red flesh
    pygame.draw.polygon(surface, color, slice_points)
    
    # Draw the green rind at the bottom
    rind_points = [
        (rect.left + rect.width // 6, rect.bottom - rect.height // 6),  # Bottom left of flesh
        (rect.right - rect.width // 6, rect.bottom - rect.height // 6),  # Bottom right of flesh
        (rect.right - rect.width // 8, rect.bottom - rect.height // 12),  # Bottom right of rind
        (rect.left + rect.width // 8, rect.bottom - rect.height // 12)   # Bottom left of rind
    ]
    
    pygame.draw.polygon(surface, (30, 180, 30), rind_points)  # Green rind
    
    # Add a darker green edge/border
    dark_green = (20, 120, 20)
    pygame.draw.line(surface, dark_green, 
                    (rect.left + rect.width // 6, rect.bottom - rect.height // 6),
                    (rect.right - rect.width // 6, rect.bottom - rect.height // 6), 
                    max(1, rect.width // 30))
    
    # Add black seeds
    seed_color = (10, 10, 10)
    seed_size = max(1, rect.width // 15)
    
    # Create a pattern of seeds
    for i in range(3):
        for j in range(2):
            x = rect.centerx - rect.width // 6 + (rect.width // 3) * j
            y = rect.top + rect.height // 3 + (rect.height // 6) * i
            
            # Draw oval seeds
            seed_rect = pygame.Rect(x - seed_size // 2, y - seed_size // 4,
                                   seed_size, seed_size // 2)
            pygame.draw.ellipse(surface, seed_color, seed_rect)

def draw_golden_apple(surface, rect):
    """Draw a golden apple texture"""
    # Use the same base as apple but with golden color
    draw_apple(surface, rect, FRUIT_COLORS['golden'])
    
    # Add sparkle effect
    sparkle_size = max(2, rect.width // 12)
    sparkle_points = [
        (rect.centerx, rect.centery - sparkle_size*2),
        (rect.centerx + sparkle_size, rect.centery),
        (rect.centerx, rect.centery + sparkle_size*2),
        (rect.centerx - sparkle_size, rect.centery)
    ]
    pygame.draw.polygon(surface, (255, 255, 255), sparkle_points)
    
    # Add a second, smaller sparkle
    small_sparkle_size = sparkle_size // 2
    small_sparkle_points = [
        (rect.centerx + rect.width // 4, rect.centery - rect.height // 4 - small_sparkle_size),
        (rect.centerx + rect.width // 4 + small_sparkle_size // 2, rect.centery - rect.height // 4),
        (rect.centerx + rect.width // 4, rect.centery - rect.height // 4 + small_sparkle_size),
        (rect.centerx + rect.width // 4 - small_sparkle_size // 2, rect.centery - rect.height // 4)
    ]
    pygame.draw.polygon(surface, (255, 255, 255), small_sparkle_points)

def draw_kiwi(surface, rect, color=(126, 88, 56)):
    """Draw a realistic kiwi half texture"""
    # Draw brown exterior (skin)
    pygame.draw.circle(surface, color, rect.center, rect.width // 2 - 1)
    
    # Add texture to the brown skin
    skin_detail = (101, 67, 33)  # Darker brown for texture
    for i in range(0, 360, 20):
        angle = math.radians(i)
        start = rect.width // 2 - 4
        end = rect.width // 2 - 1
        x1 = rect.centerx + int(start * math.cos(angle))
        y1 = rect.centery + int(start * math.sin(angle))
        x2 = rect.centerx + int(end * math.cos(angle))
        y2 = rect.centery + int(end * math.sin(angle))
        pygame.draw.line(surface, skin_detail, (x1, y1), (x2, y2), 1)
    
    # Draw green flesh
    flesh_color = (173, 255, 47)  # Green flesh
    flesh_radius = int(rect.width * 0.4)
    pygame.draw.circle(surface, flesh_color, rect.center, flesh_radius)
    
    # Draw white center
    core_color = (255, 255, 255)
    core_radius = int(rect.width * 0.15)
    pygame.draw.circle(surface, core_color, rect.center, core_radius)
    
    # Add small black seeds in the green flesh
    seed_color = (0, 0, 0)
    seed_size = max(2, rect.width // 20)
    
    # Draw seeds in a fixed pattern - no randomness to prevent flickering
    seed_angles = [0, 30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330]
    seed_radiuses = [0.25, 0.32]
    
    for angle in seed_angles:
        for radius_pct in seed_radiuses:
            radius = rect.width // 2 * radius_pct
            angle_rad = math.radians(angle)
            x = rect.centerx + int(radius * math.cos(angle_rad))
            y = rect.centery + int(radius * math.sin(angle_rad))
            
            pygame.draw.ellipse(surface, seed_color, 
                               (x - seed_size // 2, y - seed_size // 4, 
                                seed_size, seed_size // 2))

def draw_cherry(surface, rect, color=(220, 20, 60)):
    """Draw realistic cherry texture"""
    # Calculate positions for two cherries
    cherry1_center = (rect.centerx - rect.width // 5, rect.centery + rect.height // 6)
    cherry2_center = (rect.centerx + rect.width // 5, rect.centery + rect.height // 6)
    
    cherry_radius = max(3, rect.width // 4)
    
    # Draw two cherry spheres
    pygame.draw.circle(surface, color, cherry1_center, cherry_radius)
    pygame.draw.circle(surface, color, cherry2_center, cherry_radius)
    
    # Add highlights
    highlight1_pos = (cherry1_center[0] - cherry_radius // 3, cherry1_center[1] - cherry_radius // 3)
    highlight2_pos = (cherry2_center[0] - cherry_radius // 3, cherry2_center[1] - cherry_radius // 3)
    
    highlight_radius = max(1, cherry_radius // 3)
    pygame.draw.circle(surface, (255, 255, 255, 150), highlight1_pos, highlight_radius)
    pygame.draw.circle(surface, (255, 255, 255, 150), highlight2_pos, highlight_radius)
    
    # Draw stems connecting to the top
    stem_color = (101, 67, 33)  # Brown
    
    # Draw curved stems
    # First stem
    start_pos1 = (cherry1_center[0], cherry1_center[1] - cherry_radius + 1)
    control_pos1 = (rect.centerx, rect.top + rect.height // 4)
    end_pos = (rect.centerx, rect.top + rect.height // 8)
    
    # Second stem
    start_pos2 = (cherry2_center[0], cherry2_center[1] - cherry_radius + 1)
    control_pos2 = (rect.centerx, rect.top + rect.height // 4)
    
    # Draw the stems as lines (a proper Bezier curve would be better but is more complex)
    pygame.draw.line(surface, stem_color, start_pos1, control_pos1, max(1, rect.width // 25))
    pygame.draw.line(surface, stem_color, control_pos1, end_pos, max(1, rect.width // 25))
    pygame.draw.line(surface, stem_color, start_pos2, control_pos2, max(1, rect.width // 25))

def draw_tracking_fruit(surface, rect):
    """Draw tracking fruit with radar effect"""
    # Base color changes over time for a rainbow effect
    pulse_speed = 0.005
    t = time.time()
    r = int(127.5 + 127.5 * math.sin(pulse_speed * t * 1000))
    g = int(127.5 + 127.5 * math.sin(pulse_speed * t * 1000 + 2 * math.pi / 3))
    b = int(127.5 + 127.5 * math.sin(pulse_speed * t * 1000 + 4 * math.pi / 3))
    
    # Draw pulsing circle
    pygame.draw.circle(surface, (r, g, b), rect.center, rect.width // 2 - 2)
    
    # Draw tracking icon (compass-like arrows)
    if rect.width > 12:
        arrow_length = (rect.width // 2 - 2) * 0.6
        arrow_width = max(1, rect.width // 10)
        
        # Draw four directional arrows (like a compass)
        for angle in [0, math.pi/2, math.pi, 3*math.pi/2]:
            end_x = rect.centerx + int(arrow_length * math.cos(angle))
            end_y = rect.centery + int(arrow_length * math.sin(angle))
            pygame.draw.line(surface, (255, 255, 255), 
                           rect.center, (end_x, end_y), arrow_width)

def draw_fruit(surface, rect, fruit_type):
    """Draw fruit with realistic texture based on type"""
    try:
        if fruit_type == 'regular':
            draw_apple(surface, rect, FRUIT_COLORS['regular'])
        elif fruit_type == 'golden':
            draw_golden_apple(surface, rect)
        elif fruit_type == 'auto_tracking':
            draw_tracking_fruit(surface, rect)
        elif fruit_type == 'orange':
            draw_orange(surface, rect, FRUIT_COLORS.get('orange', (255, 140, 0)))
        elif fruit_type in ['blue', 'navy']:
            draw_blueberry(surface, rect, FRUIT_COLORS.get(fruit_type, (30, 144, 255)))
        elif fruit_type in ['yellow', 'cream']:
            draw_banana(surface, rect, FRUIT_COLORS.get(fruit_type, (255, 255, 0)))
        elif fruit_type in ['pink', 'crimson']:
            draw_strawberry(surface, rect, FRUIT_COLORS.get(fruit_type, (255, 105, 180)))
        elif fruit_type in ['maroon', 'red']:
            draw_cherry(surface, rect, FRUIT_COLORS.get(fruit_type, (220, 20, 60)))
        elif fruit_type in ['green', 'lime']:
            draw_kiwi(surface, rect, FRUIT_COLORS.get(fruit_type, (50, 255, 50)))
        elif fruit_type in ['cyan', 'turquoise']:
            draw_watermelon(surface, rect)  # watermelon always uses its natural red/green colours
        else:
            # For other types, use the improved apple texture with the appropriate color
