class EventBus:
    """Small, fault-isolated event bus for internal extension hooks.

    Subscribers are ordinary callables. Exceptions raised by one listener are
    retained in ``errors`` and never propagate into gameplay/UI code.
    """

    def __init__(self):
        self._listeners = {name: [] for name in EVENT_NAMES}
        self.errors = []

    def subscribe(self, event_name, callback):
        if event_name not in self._listeners:
            raise ValueError(f"Unknown event: {event_name}")
        if not callable(callback):
            raise TypeError("callback must be callable")
        if callback not in self._listeners[event_name]:
            self._listeners[event_name].append(callback)
        return callback

    def unsubscribe(self, event_name, callback):
        listeners = self._listeners.get(event_name, [])
        if callback in listeners:
            listeners.remove(callback)
            return True
        return False

    def emit(self, event_name, **payload):
        listeners = tuple(self._listeners.get(event_name, ()))
        results = []
        for callback in listeners:
            try:
                results.append(callback(payload))
            except Exception as exc:
                self.errors.append({
                    "event": event_name,
                    "listener": getattr(callback, "__name__", repr(callback)),
                    "error": str(exc),
                })
        # Keep this bounded so a broken optional listener cannot grow memory
        # indefinitely during a long-running session.
        if len(self.errors) > 100:
            del self.errors[:-100]
        return results


EVENT_BUS = EventBus()


class ContentValidationError(ValueError):
    """Structured validation error for themes, mods, and custom content."""

    def __init__(self, message, *, code="invalid_content", component=None,
                 owner_id=None, version=None, path=None):
        super().__init__(message)
        self.code = code
        self.component = component
        self.owner_id = owner_id
        self.version = version
        self.path = path

    def to_dict(self):
        return {
            "code": self.code,
            "message": str(self),
            "component": self.component,
            "owner_id": self.owner_id,
            "version": self.version,
            "path": self.path,
        }


def _parse_semver(value):
    """Parse the numeric portion of a semantic-ish version string."""
    text = str(value or "").strip()
    if text.startswith(("v", "V")):
        text = text[1:]
    if "+" in text:
        text = text.split("+", 1)[0]
    if "-" in text:
        text = text.split("-", 1)[0]
    parts = text.split(".")
    if not parts or any(not p.isdigit() for p in parts):
        return None
    if len(parts) > 3:
        return None
    nums = [int(p) for p in parts]
    while len(nums) < 3:
        nums.append(0)
    return tuple(nums[:3])


def _version_compatible(actual, requirement):
    """Evaluate a small deterministic compatibility grammar.

    Supported forms include:
      * / any
      * exact: 1.2.3
      * prefix/wildcard: 1.2 or 1.2.x or 1.*
      * comparisons: >=1.0, >1.0, <=2.0, <2.0, =1.2
      * comma-separated comparison clauses
      * caret ranges: ^1.2.0
    """
    if requirement is None:
        return False
    spec = str(requirement).strip()
    if not spec or spec.lower() in {"*", "any", "all"}:
        return True

    actual_v = _parse_semver(actual)
    if actual_v is None:
        return False

    def _one_clause(clause):
        clause = clause.strip()
        if not clause:
            return True
        if clause.startswith("^"):
            base = _parse_semver(clause[1:])
            if base is None:
                return False
            if base[0] > 0:
                upper = (base[0] + 1, 0, 0)
            elif base[1] > 0:
                upper = (0, base[1] + 1, 0)
            else:
                upper = (0, 0, base[2] + 1)
            return actual_v >= base and actual_v < upper

        op = None
        for candidate in (">=", "<=", ">", "<", "="):
            if clause.startswith(candidate):
                op = candidate
                target_text = clause[len(candidate):].strip()
                break
        if op is not None:
            target = _parse_semver(target_text)
            if target is None:
                return False
            return {
                ">=": actual_v >= target,
                "<=": actual_v <= target,
                ">": actual_v > target,
                "<": actual_v < target,
                "=": actual_v == target,
            }[op]

        cleaned = clause.lower().replace(" ", "")
        if cleaned.endswith((".x", ".*")):
            cleaned = cleaned[:-2]
        parts = cleaned.split(".")
        if len(parts) == 1 and parts[0].isdigit():
            return actual_v[0] == int(parts[0])
        if len(parts) == 2 and all(p.isdigit() for p in parts):
            return actual_v[:2] == (int(parts[0]), int(parts[1]))
        target = _parse_semver(cleaned)
        return target is not None and actual_v == target

    return all(_one_clause(clause) for clause in spec.split(","))


def _deep_merge_dict(base, override):
    """Return a recursive merge without mutating either source dict."""
    result = copy.deepcopy(base)
    for key, value in (override or {}).items():
        if isinstance(result.get(key), dict) and isinstance(value, dict):
            result[key] = _deep_merge_dict(result[key], value)
        else:
            result[key] = copy.deepcopy(value)
    return result


def _validate_theme_color(value, path):
    if isinstance(value, str):
        try:
            parsed = create_color(value)
            if not isinstance(parsed, tuple) or len(parsed) != 3:
                raise ValueError
            return parsed
        except Exception as exc:
            raise ContentValidationError(
                f"Invalid theme color at {path}: {value!r}",
                code="invalid_color", component="theme", path=path
            ) from exc
    if isinstance(value, (list, tuple)) and len(value) in (3, 4):
        if any(not isinstance(c, int) or c < 0 or c > 255 for c in value):
            raise ContentValidationError(
                f"Invalid theme color at {path}: {value!r}",
                code="invalid_color", component="theme", path=path
            )
        return tuple(value)
    raise ContentValidationError(
        f"Invalid theme color at {path}: {value!r}",
        code="invalid_color", component="theme", path=path
    )


def _validate_relative_asset_path(value, path):
    if not isinstance(value, str) or not value.strip():
        raise ContentValidationError(
            f"Asset path at {path} must be a non-empty string",
            code="invalid_asset_path", component="assets", path=path
        )
    normalized = os.path.normpath(value)
    if os.path.isabs(value) or normalized in ("..", os.pardir) or normalized.startswith(".." + os.sep):
        raise ContentValidationError(
            f"Asset path escapes its source root at {path}: {value!r}",
            code="asset_path_traversal", component="assets", path=path
        )
    return normalized


class ContentRegistry:
    """Stable-ID registry with ownership tracking and conflict detection."""

    def __init__(self, name):
        self.name = str(name)
        self._items = {}
        self._owners = {}
        self.conflicts = []

    def register(self, item, *, owner_id="builtin", replace=False):
        if not isinstance(item, dict):
            raise ContentValidationError(
                f"{self.name}: item must be an object",
                code="invalid_content_item", component=self.name, owner_id=owner_id
            )
        content_id = item.get("id")
        if not isinstance(content_id, str) or not content_id.strip():
            raise ContentValidationError(
                f"{self.name}: content id is required",
                code="missing_id", component=self.name, owner_id=owner_id
            )
        content_id = content_id.strip()
        if content_id in self._items and not replace:
            conflict = {
                "registry": self.name,
                "id": content_id,
                "existing_owner": self._owners.get(content_id, "unknown"),
                "new_owner": owner_id,
            }
            self.conflicts.append(conflict)
            raise ContentValidationError(
                f"{self.name}: duplicate content id {content_id!r}",
                code="duplicate_id", component=self.name, owner_id=owner_id
            )
        self._items[content_id] = copy.deepcopy(item)
        self._owners[content_id] = str(owner_id)
        return self._items[content_id]

    def unregister_owner(self, owner_id):
        removed = []
        for content_id, current_owner in list(self._owners.items()):
            if current_owner == owner_id:
                removed.append(content_id)
                self._owners.pop(content_id, None)
                self._items.pop(content_id, None)
        return removed

    def get(self, content_id, default=None):
        return self._items.get(content_id, default)

    def contains(self, content_id):
        return content_id in self._items

    def ids(self):
        return tuple(sorted(self._items))

    def items(self):
        return tuple((cid, copy.deepcopy(item)) for cid, item in sorted(self._items.items()))

    def owner_of(self, content_id):
        return self._owners.get(content_id)

    def clear_conflicts(self):
        self.conflicts.clear()


