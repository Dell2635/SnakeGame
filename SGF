GAME_SETTINGS_CONTEXTS = ('singleplayer', 'vs_ai', 'multiplayer_local', 'multiplayer_lan')


def _game_settings_path(context):
    if context not in GAME_SETTINGS_CONTEXTS:
        raise ValueError(f"Unknown Game Settings context: {context!r} (expected one of {GAME_SETTINGS_CONTEXTS})")
    return os.path.join(_user_data_manager.get_game_settings_dir(), f'{context}.json')


def get_last_game_settings(context, default=None):
    """Return the last-used Game Settings dict for one context (e.g.
    'singleplayer', 'vs_ai', 'multiplayer_local', 'multiplayer_lan'), or
    `default` (a copy, if a dict) if none have been saved yet."""
    path = _game_settings_path(context)
    if os.path.exists(path):
        try:
            with open(path, 'r') as _f:
                data = json.load(_f)
            if isinstance(data, dict):
                return data.get('game_settings', {})
        except Exception as e:
            print(f"Error loading Game Settings for {context}: {e}")
    return dict(default) if isinstance(default, dict) else (default if default is not None else {})


def save_last_game_settings(context, game_settings):
    """Persist the Game Settings a match was just started with as the
    context's new 'last used' configuration. `game_settings` must be a
    JSON-serializable dict; nothing else is touched."""
    if not isinstance(game_settings, dict):
        return False, "game_settings must be a dict"
    path = _game_settings_path(context)
    payload = {
        'context': context,
        'game_settings_format_version': 1,
        'saved_at': datetime.now().isoformat(),
        'game_settings': game_settings,
    }
    try:
        _atomic_write_json(path, payload)
        return True, None
    except Exception as e:
        return False, str(e)

