            pygame.draw.rect(self.screen, _sb_border, seed_box_rect, 2, border_radius=5)
            _sd = seed_text if seed_text else 'auto'
            _sc = COLORS['white'] if seed_text else (100, 110, 140)
            _ss = sf.render(_sd[-36:], True, _sc)
            self.screen.blit(_ss, (seed_bx + 6,
                seed_by + (seed_bh - _ss.get_height()) // 2))

            # ── Mode descriptions ───────────────────────────────────────
            desc_y = int(sh * 0.62)
            cd = sf.render(
                "Co-op: Work together, share one score and survive as a team",
                True, (160, 240, 160))
            vd = sf.render(
                "1v1:   Compete head-to-head — last snake standing wins!",
                True, (255, 175, 175))
            self.screen.blit(cd, (sw // 2 - cd.get_width() // 2, desc_y))
            self.screen.blit(vd, (sw // 2 - vd.get_width() // 2, desc_y + 28))

            # ── Mode-select buttons ─────────────────────────────────────
            btn_w, btn_h = 190, 50
            gap = 18
            total_bw = btn_w * 2 + gap
            coop_rect = pygame.Rect(sw // 2 - total_bw // 2,               int(sh * 0.73), btn_w, btn_h)
            v1_rect   = pygame.Rect(sw // 2 - total_bw // 2 + btn_w + gap, int(sh * 0.73), btn_w, btn_h)
            net_rect  = pygame.Rect(sw // 2 - total_bw // 2,               int(sh * 0.81), total_bw, btn_h)
            back_rect = pygame.Rect(sw // 2 - btn_w // 2,                  int(sh * 0.90), btn_w, btn_h)

            mp = pygame.mouse.get_pos()

            def _btn(rect, label, base_col):
                hovered = rect.collidepoint(mp)
                col = tuple(min(255, c + 28) for c in base_col) if hovered else base_col
                pygame.draw.rect(self.screen, col, rect, border_radius=10)
                pygame.draw.rect(self.screen, (180, 210, 255), rect, width=1, border_radius=10)
                ls = mf.render(label, True, COLORS['white'])
                self.screen.blit(ls, (rect.centerx - ls.get_width() // 2,
                                       rect.centery - ls.get_height() // 2))

            _btn(coop_rect, "Co-op Mode",   (25, 110, 65))
            _btn(v1_rect,   "1v1 Mode",     (130, 35, 35))
            _btn(net_rect,  "Network Play", (20, 80, 160))
            _btn(back_rect, "Back",         (55, 65, 110))

            hint = sf.render(
                "P: Pause during match   R: Restart after game over   ESC: Exit to menu",
                True, (75, 105, 155))
            self.screen.blit(hint, (sw // 2 - hint.get_width() // 2, int(sh * 0.95)))

            pygame.display.flip()
            clock.tick(60)

            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit()
                    sys.exit()
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    if seed_box_rect.collidepoint(event.pos):
                        seed_active = True
                    else:
                        seed_active = False
                    if coop_rect.collidepoint(event.pos):
                        return ('coop', seed_text.strip() or generate_seed())
                    elif v1_rect.collidepoint(event.pos):
                        return ('1v1', seed_text.strip() or generate_seed())
                    elif net_rect.collidepoint(event.pos):
                        return ('network', seed_text.strip() or generate_seed())
                    elif back_rect.collidepoint(event.pos):
                        return None
                elif event.type == pygame.KEYDOWN:
                    if seed_active:
                        if event.key in (pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_ESCAPE):
                            seed_active = False
                        elif event.key == pygame.K_BACKSPACE:
                            seed_text = seed_text[:-1]
                        elif event.unicode and event.unicode != ' ' and len(seed_text) < 64:
                            seed_text += event.unicode
                    else:
                        if event.key == pygame.K_F11:
                            self.screen = _toggle_fullscreen(self.screen)
                        elif event.key == pygame.K_ESCAPE:
                            return None
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode(
                        (event.w, event.h), pygame.RESIZABLE)


