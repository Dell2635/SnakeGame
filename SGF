class GameplayPerformanceStats:
    """Low-overhead rolling gameplay/render performance telemetry.

    The object deliberately exposes data instead of drawing a debug UI so the
    integration/debug AI can surface it without coupling gameplay to UI code.
    """
    def __init__(self, history_size=120):
        self.history_size = max(30, int(history_size))
        self.samples = []
        self.last = {}

    def record_frame(self, frame_ms, update_ms=0.0, render_ms=0.0,
                     ai_ms=0.0, replay_ms=0.0, object_counts=None):
        sample = {
            'frame_ms': max(0.0, float(frame_ms)),
            'update_ms': max(0.0, float(update_ms)),
            'render_ms': max(0.0, float(render_ms)),
            'ai_ms': max(0.0, float(ai_ms)),
            'replay_ms': max(0.0, float(replay_ms)),
            'objects': dict(object_counts or {}),
        }
        self.samples.append(sample)
        if len(self.samples) > self.history_size:
            del self.samples[0]
        self.last = sample

    def snapshot(self):
        if not self.samples:
            return {
                'fps': 0.0, 'frame_ms': 0.0, 'update_ms': 0.0,
                'render_ms': 0.0, 'ai_ms': 0.0, 'replay_ms': 0.0,
                'objects': {}, 'sample_count': 0,
            }
        n = len(self.samples)
        avg = lambda key: sum(item[key] for item in self.samples) / n
        frame_ms = avg('frame_ms')
        return {
            'fps': (1000.0 / frame_ms) if frame_ms > 0 else 0.0,
            'frame_ms': frame_ms,
            'update_ms': avg('update_ms'),
            'render_ms': avg('render_ms'),
            'ai_ms': avg('ai_ms'),
            'replay_ms': avg('replay_ms'),
            'objects': dict(self.last.get('objects', {})),
            'sample_count': n,
        }

    def reset(self):
        self.samples.clear()
        self.last = {}

def run_determinism_smoke_test(game_factory, input_sequence=(), label='gameplay'):
    """Run seed/progression/replay checks against a caller-supplied game factory.

    ``game_factory`` must accept a seed string and return a fresh gameplay
    instance exposing ``next_direction``, ``move_snake``, ``deterministic_state_signature``
    and ``start_replay``. This stays UI-independent and is suitable for an
    external regression test runner.
    """
    first = game_factory('AI2_DETERMINISM_A')
    second = game_factory('AI2_DETERMINISM_A')
    initial_signature = copy.deepcopy(first.deterministic_state_signature())
    assert initial_signature == second.deterministic_state_signature(), \
        f'{label}: same seed produced different initial state'

    for direction in input_sequence:
        first.next_direction = tuple(direction)
        second.next_direction = tuple(direction)
        first.move_snake()
        second.move_snake()
        assert first.deterministic_state_signature() == second.deterministic_state_signature(), \
            f'{label}: same seed/input diverged during progression'

    other = game_factory('AI2_DETERMINISM_B')
    assert first.deterministic_state_signature() != other.deterministic_state_signature(), \
        f'{label}: different seeds produced identical state'

    history = copy.deepcopy(getattr(first, 'game_history', []))
    replay = game_factory(first.seed)
    if history:
        assert replay.start_replay(history), f'{label}: replay failed to start'
        assert replay.deterministic_state_signature()['snake'] == initial_signature['snake'], \
            f'{label}: first replay snapshot differs from initial state'

    return True


def run_ai_determinism_smoke_test():
    """Pure SnakeAI determinism smoke test; raises AssertionError on drift."""
    kwargs = dict(
        snake=[(5, 5), (4, 5), (3, 5)],
        occupied={(4, 5), (3, 5)},
        fruit=(15, 15),
        board_w=20, board_h=20, portals=[],
        powerup_pos=None, wall_collision=True, opponent_snake=[]
    )
    a = SnakeAI('hard', rng=SeedRNG('AI2_AI_TEST'))
    b = SnakeAI('hard', rng=SeedRNG('AI2_AI_TEST'))
    seq_a = [a.choose_direction(**kwargs) for _ in range(32)]
    seq_b = [b.choose_direction(**kwargs) for _ in range(32)]
    assert seq_a == seq_b, 'SnakeAI RNG stream is not deterministic'
    return True


