        with open(os.path.join(base, 'frame_times.csv'), 'w', newline='', encoding='utf-8') as f:
            w = _csv_mod.writer(f); w.writerow(['t','frame_ms','update_ms','render_ms','input_ms','gc_ms','ai_ms','replay_ms','ui_ms'])
            for s in self.telemetry.samples:
                w.writerow([s.get('t'),s.get('frame_ms'),s.get('update_ms'),s.get('render_ms'),s.get('input_ms'),s.get('gc_ms'),s.get('ai_ms'),s.get('replay_ms'),s.get('ui_ms')])
        with open(os.path.join(base, 'performance_incidents.json'), 'w', encoding='utf-8') as f:
            json.dump(list(self.telemetry.incidents), f, indent=2)
        with open(os.path.join(base, 'memory.csv'), 'w', newline='', encoding='utf-8') as f:
            w = _csv_mod.writer(f); w.writerow(['t','memory_mb','allocation_mb_s'])
            for s in self.telemetry.samples:
                w.writerow([s.get('t'), s.get('memory_mb'), s.get('allocation_mb_s')])
        with open(os.path.join(base, 'loading_times.csv'), 'w', newline='', encoding='utf-8') as f:
            w = _csv_mod.writer(f); w.writerow(['name','duration_ms','time']);
            for row in self.telemetry.loading: w.writerow([row['name'], row['duration_ms'], row['time']])
        with open(os.path.join(base, 'save_watchdog.csv'), 'w', newline='', encoding='utf-8') as f:
            w = _csv_mod.DictWriter(f, fieldnames=('t', 'time', 'phase', 'duration_ms', 'slow'))
            w.writeheader(); w.writerows(self.telemetry.save_samples)
        with open(os.path.join(base, 'logs.txt'), 'w', encoding='utf-8') as f:
            with _log_ring_lock:
                f.write('\n'.join(_LOG_RING_BUFFER))
        for metric in ('fps', 'frame_ms', 'memory_mb', 'cpu_percent'):
            try:
                self.export_graph(metric, os.path.join(base, 'graphs', f'{metric}.png'))
            except Exception:
                pass
        zip_path = os.path.join(_user_data_manager.get_log_dir(), f'SGF_Diagnostics_{ts}.zip')
        try:
            with _zipfile_mod.ZipFile(zip_path, 'w', _zipfile_mod.ZIP_DEFLATED) as zf:
                for root, _dirs, files in os.walk(base):
                    for fn in files:
                        full = os.path.join(root, fn)
                        zf.write(full, os.path.relpath(full, base))
        finally:
            import shutil as _shutil
            _shutil.rmtree(base, ignore_errors=True)
        self.toast(f'Diagnostics exported: {os.path.basename(zip_path)}', 3.5)
        return zip_path

    def open_panel(self, screen, game=None):
        if not self.unlocked:
            return False
        self.register_game(game) if game is not None else None
        previous_paused = getattr(game, 'paused', None) if game is not None else None
        if game is not None and hasattr(game, 'paused'):
            try: game.paused = True
            except Exception: pass
        self.set_active(True)
        runtime = getattr(game, 'runtime', None) if game is not None else None
        self.current_panel = DevPanelScreen(self, screen, game=game)
        if runtime is not None and hasattr(runtime, 'set_modal'):
            try: runtime.set_modal(self.current_panel)
            except Exception: pass
        try:
            self.current_panel.run()
        finally:
            if runtime is not None and hasattr(runtime, 'clear_modal'):
                try: runtime.clear_modal()
                except Exception: pass
            self.current_panel = None
            if game is not None and previous_paused is not None:
                try: game.paused = previous_paused
                except Exception: pass
            # Keep telemetry/debug sampling active only while the game is still
            # modified or a persistent debug toggle remains enabled. Deep
            # profiling itself is opt-in to the open DEV panel; leaving
            # tracemalloc and the GC callback running during ordinary gameplay
            # can gradually degrade frame pacing on slower systems.
            self.set_active(self.modified)
            self.telemetry.deactivate()
        return True

    def handle_hotkey(self, key, screen, game=None):
        if key == pygame.K_F8 and self.unlocked:
            self.open_panel(screen, game)
            return True
        return False


