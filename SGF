_LEGACY_DATA_FILENAME = 'snake_game_data.json'
_MIGRATION_MARKER_FILENAME = '.migration_complete'


def _candidate_legacy_data_paths():
    """Where a pre-centralized-data-directory install might have left
    snake_game_data.json: the current working directory, the folder
    containing this script, and (in case a launcher extracted us into
    `_snake_game_runtime`) the folder above that."""
    candidates = []
    try:
        candidates.append(os.path.join(os.getcwd(), _LEGACY_DATA_FILENAME))
    except Exception:
        pass
    try:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        candidates.append(os.path.join(script_dir, _LEGACY_DATA_FILENAME))
        candidates.append(os.path.join(os.path.dirname(script_dir), _LEGACY_DATA_FILENAME))
    except Exception:
        pass
    seen, unique = set(), []
    for c in candidates:
        c = os.path.abspath(c)
        if c not in seen and os.path.exists(c):
            seen.add(c)
            unique.append(c)
    return unique


def _new_data_file_path():
    return os.path.join(_user_data_manager.get_config_dir(), 'game_data.json')


def _migrate_legacy_data_if_needed(log_fn=None):
    """One-time migration of a legacy snake_game_data.json into the new
    centralized data directory. Never skipped silently and never discards
    data: detect -> validate -> back up -> migrate -> validate -> mark done."""
    def _log(msg):
        if log_fn:
            try:
                log_fn(msg)
            except Exception:
                pass

    new_path = _new_data_file_path()
    marker_path = os.path.join(_user_data_manager.get_config_dir(), _MIGRATION_MARKER_FILENAME)

    if os.path.exists(marker_path):
        return  # already handled (migrated, or a fresh install with nothing to migrate)

    if os.path.exists(new_path):
        # New-location data already exists — never overwrite it with an
        # older legacy file. Just stop checking on future startups.
        try:
            with open(marker_path, 'w') as _f:
                _f.write(datetime.now().isoformat())
        except Exception:
            pass
        return

    legacy_paths = _candidate_legacy_data_paths()
    if not legacy_paths:
        try:
            with open(marker_path, 'w') as _f:
                _f.write(datetime.now().isoformat())
        except Exception:
            pass
        return

    legacy_path = legacy_paths[0]
    _log(f"Found legacy data file at {legacy_path}; migrating to {new_path}.")

    # 1-2. detect + validate
    try:
        with open(legacy_path, 'r') as _f:
            legacy_data = json.load(_f)
        if not isinstance(legacy_data, dict):
            raise ValueError("legacy data root is not a JSON object")
    except Exception as e:
        _log(f"Legacy data file is corrupt, refusing to migrate it: {e}")
        return  # left untouched; a fixed file can be retried on a later run

    # 3. back it up before touching anything
    try:
        ts = datetime.now().strftime('%Y%m%d_%H%M%S')
        backup_path = os.path.join(_user_data_manager.get_backup_dir(), f'legacy_snake_game_data_{ts}.json')
        with open(backup_path, 'w') as _f:
            json.dump(legacy_data, _f, indent=2)
    except Exception as e:
        _log(f"Could not back up legacy data before migrating, aborting migration: {e}")
        return

    # 4. migrate (stamp schema metadata, write to the new location)
    migrated = _run_schema_migrations(dict(legacy_data))
    try:
        _atomic_write_json(new_path, migrated)
    except Exception as e:
        _log(f"Failed writing migrated data to {new_path}: {e}")
        return

    # 5. validate the new file actually round-trips the important sections
    try:
        with open(new_path, 'r') as _f:
            check = json.load(_f)
        assert isinstance(check, dict)
        for key in ('settings', 'highscores', 'achievements', 'encyclopedia_progress'):
            assert check.get(key) == migrated.get(key)
    except Exception as e:
        _log(f"Migrated data failed validation, aborting and removing the incomplete copy: {e}")
        try:
            os.remove(new_path)
        except OSError:
            pass
        return

    # 6. only now mark migration complete
    try:
        with open(marker_path, 'w') as _f:
            _f.write(datetime.now().isoformat())
    except Exception:
        pass
    _log(f"Migration complete. Data now lives at {new_path}. Legacy file left untouched at {legacy_path}.")


