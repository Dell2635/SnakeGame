        # Preserve the exact board used by this match even if its source map is
        # later renamed or deleted from the map editor.
        'custom_map': score.get('custom_map'),
    }
    for field in ('daily_challenge_id', 'daily_challenge_version',
                  'daily_challenge_modifier'):
        if field in score:
            payload[field] = score[field]
    for field in ('custom_challenge_id', 'custom_challenge_version'):
        if field in score:
            payload[field] = score[field]
    return payload


def _store_score_replay(score, history):
    """Persist a match history separately and leave a small reference in its score."""
    if not isinstance(history, list) or not history:
        score['has_replay'] = False
        score.pop('custom_map', None)
        return False
    replay_id = _score_replay_id(score, 'replay-' + hashlib.sha256(
        json.dumps(score, sort_keys=True, default=str).encode('utf-8')).hexdigest()[:20])
    try:
        _save_replay_file(replay_id, _score_replay_payload(score, history))
    except Exception as exc:
        _logging_mod.getLogger('sgf').warning('Could not save replay %s: %s', replay_id, exc)
        score['has_replay'] = False
        score.pop('custom_map', None)
        return False
    score['replay_id'] = replay_id
    score['has_replay'] = True
    score.pop('game_history', None)
    score.pop('mp_history', None)
    score.pop('custom_map', None)
    return True


def _merge_completed_score_data(data, score_entry, max_records):
    """Merge one finished score into fresh data without losing concurrent saves."""
    if not isinstance(data, dict):
        data = {}
    highscores = data.get('highscores', [])
    if not isinstance(highscores, list):
        highscores = []
    game_id = score_entry.get('game_id')
    highscores = [item for item in highscores
                  if not isinstance(item, dict) or item.get('game_id') != game_id]
    highscores.append(copy.deepcopy(score_entry))

    def _score_order(item):
        try:
            value = float(item.get('score', 0)) if isinstance(item, dict) else float('-inf')
            return value if math.isfinite(value) else float('-inf')
        except (TypeError, ValueError, OverflowError):
            return float('-inf')

    highscores.sort(key=_score_order, reverse=True)
    data['highscores'] = highscores[:max_records]
    if score_entry.get('mp_source') == 'lan_host':
        board_entries = _lan_entries_for_match(score_entry)
        if board_entries:
            board_ids = {item['game_id'] for item in board_entries}
            board = data.get('lan_leaderboard', [])
            if not isinstance(board, list):
                board = []
            board = [item for item in board if _clean_lan_score_entry(item)
                     and item.get('game_id') not in board_ids]
            board.extend(board_entries)
            data['lan_leaderboard'] = sorted(
                board, key=lambda item: (item['score'], item['date']), reverse=True)[:100]
    _sync_active_profile_snapshot(data)
    return data


_REPLAY_SAVE_SLOW_THRESHOLD_MS = 500.0
_MAX_REPLAY_RETRY_HISTORIES = 2
_REPLAY_SAVE_TIMED_PHASES = frozenset((
    'staging', 'serializing', 'compressing', 'writing', 'verifying',
    'indexing',
))


def _prune_replay_retry_histories_locked():
    failed = [(key, state) for key, state in _replay_save_jobs.items()
              if state.get('phase') == 'failed' and state.get('history')]
    for _old_key, old_state in failed[:-_MAX_REPLAY_RETRY_HISTORIES]:
        # Retain recent retry snapshots only. Durable recovery journals remain
        # available on disk, so old failures do not pin whole match histories.
        old_state['history'] = ()
        old_state['entry'] = {}


def _set_replay_save_phase(game_id, phase, **details):
    now_mono = time.perf_counter()
    record = None
    total_record = None
    with _replay_save_jobs_lock:
        state = _replay_save_jobs.get(str(game_id))
        if state is None:
            return
        previous = state.get('phase')
        previous_start = state.get('phase_started_monotonic', now_mono)
        if previous != phase:
            duration_ms = max(0.0, (now_mono - previous_start) * 1000.0)
            if previous in _REPLAY_SAVE_TIMED_PHASES:
                timings = state.setdefault('phase_durations_ms', {})
                timings[previous] = timings.get(previous, 0.0) + duration_ms
                if duration_ms >= _REPLAY_SAVE_SLOW_THRESHOLD_MS:
                    slow_phases = state.setdefault('slow_phases', [])
                    if previous not in slow_phases:
                        slow_phases.append(previous)
                record = (previous, duration_ms)
            state['phase_started_monotonic'] = now_mono
        state['phase'] = phase
        state['updated_at'] = time.time()
        state.update(details)
        if phase == 'failed':
            _prune_replay_retry_histories_locked()
        if phase in ('complete', 'failed'):
            total_ms = max(0.0, (now_mono - state.get(
                'started_monotonic', now_mono)) * 1000.0)
            state['total_duration_ms'] = total_ms
            state.setdefault('phase_durations_ms', {})['total'] = total_ms
            total_record = ('total', total_ms)
            if total_ms >= _REPLAY_SAVE_SLOW_THRESHOLD_MS:
                state.setdefault('slow_phases', []).append('total')
    for timing in (record, total_record):
        if timing is None:
            continue
        telemetry = getattr(globals().get('DEV_TOOLS'), 'telemetry', None)
        recorder = getattr(telemetry, 'record_save_phase', None)
        if callable(recorder):
            recorder(timing[0], timing[1])


def _get_replay_save_status(game_id):
    if not game_id:
        return None
    with _replay_save_jobs_lock:
        state = _replay_save_jobs.get(str(game_id))
        if state is None:
            return None
        public_state = {key: value for key, value in state.items()
                        if key not in ('done', 'entry', 'history',
                                       'started_monotonic',
                                       'phase_started_monotonic')}
        public_state['done'] = state['done'].is_set()
        public_state['has_history'] = bool(state.get('history'))
        current_phase = state.get('phase')
        current_elapsed_ms = max(0.0, (
            time.perf_counter() - state.get('phase_started_monotonic', time.perf_counter())
        ) * 1000.0)
        public_state['current_phase_elapsed_ms'] = current_elapsed_ms
        public_state['slow'] = bool(state.get('slow_phases')) or (
            current_phase in _REPLAY_SAVE_TIMED_PHASES and
            current_elapsed_ms >= _REPLAY_SAVE_SLOW_THRESHOLD_MS)
        return public_state


_REPLAY_RECOVERY_SCHEMA = 1
_REPLAY_RECOVERY_MAX_BYTES = 64 * 1024 * 1024


