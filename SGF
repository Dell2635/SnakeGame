        reset_rect = pygame.Rect(margin_x, reset_y - offset, content_width, action_btn_h)
        self.create_button(reset_rect, _t_or(lang, 'reset_settings_persisted', 'Reset Settings'), COLORS['button'])
        controls['reset_settings_persisted_button'] = reset_rect

        factory_rect = pygame.Rect(margin_x, factory_y - offset, content_width, action_btn_h)
        self.create_button(factory_rect, _t_or(lang, 'factory_reset', 'Factory Reset'), (140, 20, 20))
