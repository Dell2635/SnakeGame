            self.scrollbar.max_scroll = max(0, self.scrollbar.content_height - list_rect.height)
            self.scrollbar.update()

            self.screen.set_clip(list_rect)
            offset = self.scrollbar.get_content_offset()
            name_font = get_font(self.settings.language, 'bold', 17)
            sub_font = get_font(self.settings.language, 'regular', 13)
            row_rects = []
            for i, entry in enumerate(entries):
                ry = list_rect.y + i * row_h - offset
                row_rect = pygame.Rect(list_rect.x + 6, ry, list_rect.width - 28, row_h - 6)
                row_rects.append((entry, row_rect))
                if row_rect.bottom < list_rect.top or row_rect.top > list_rect.bottom:
                    continue
                unlocked = progress.get(entry['id'], {}).get('unlocked', False)
                selected = self.selected_entry and self.selected_entry['id'] == entry['id']
                bg = (55, 90, 150) if selected else ((32, 40, 68) if unlocked else (24, 28, 42))
                pygame.draw.rect(self.screen, bg, row_rect, border_radius=6)

                if unlocked:
                    name_s = name_font.render(entry['name'], True, COLORS['white'])
                    rarity_color = self.RARITY_COLORS.get(entry['rarity'], (180, 180, 180))
                    rarity_s = sub_font.render(entry['rarity'], True, rarity_color)
                else:
                    name_s = name_font.render("???", True, (110, 118, 135))
                    rarity_s = sub_font.render("Not yet discovered", True, (90, 96, 110))
                self.screen.blit(name_s, (row_rect.x + 10, row_rect.y + 4))
                self.screen.blit(rarity_s, (row_rect.x + 10, row_rect.y + 4 + name_s.get_height()))
            self.screen.set_clip(None)
            self.scrollbar.draw(self.screen)

            # Detail panel
            detail_rect = pygame.Rect(margin, list_rect.bottom + 14, sw - margin * 2,
                                      sh - list_rect.bottom - 14 - int(sh * 0.08))
            pygame.draw.rect(self.screen, (18, 24, 45), detail_rect, border_radius=8)
            pygame.draw.rect(self.screen, (60, 90, 140), detail_rect, width=1, border_radius=8)

            if self.selected_entry:
                e = self.selected_entry
                unlocked = progress.get(e['id'], {}).get('unlocked', False)
                pad = 16
                if unlocked:
                    self._draw_entry_detail(detail_rect, e, progress)
                else:
                    lock_font = get_font(self.settings.language, 'regular', 16)
                    ls = lock_font.render(_t_or(self.settings.language, 'play_to_discover', 'Play to discover this entry.'), True, (120, 128, 145))
                    self.screen.blit(ls, (detail_rect.centerx - ls.get_width() // 2,
                                         detail_rect.centery - ls.get_height() // 2))
            else:
                hint_font = get_font(self.settings.language, 'regular', 15)
                hs = hint_font.render(_t_or(self.settings.language, 'select_entry_hint', 'Select an entry above to see details.'), True, (120, 128, 145))
                self.screen.blit(hs, (detail_rect.centerx - hs.get_width() // 2,
                                     detail_rect.centery - hs.get_height() // 2))

            # Back button
            back_rect = pygame.Rect(sw // 2 - 70, sh - int(sh * 0.07), 140, max(36, int(sh * 0.055)))
            pygame.draw.rect(self.screen, COLORS['button'], back_rect, border_radius=8)
            bf = get_font(self.settings.language, 'bold', 16)
            bs = bf.render(get_text(self.settings.language, 'back'), True, COLORS['white'])
            self.screen.blit(bs, bs.get_rect(center=back_rect.center))

            _legacy_nav_draw(locals().get('self'))
            pygame.display.flip()

            for event in pygame.event.get():
                if _legacy_nav_event(locals().get('self'), event, locals()):
                    continue
                if event.type == pygame.QUIT:
                    pygame.quit(); sys.exit()
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif event.key == pygame.K_ESCAPE:
                        return
                elif event.type == pygame.MOUSEWHEEL:
                    self.scrollbar.handle_event(event)
                elif event.type in (pygame.MOUSEBUTTONUP, pygame.MOUSEMOTION):
                    self.scrollbar.handle_event(event)
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    mp = event.pos
                    if back_rect.collidepoint(mp):
                        return
                    clicked_tab = False
                    for cat, r in tab_rects.items():
                        if r.collidepoint(mp):
                            self.current_category = cat
                            self.selected_entry = None
                            self.scrollbar = None
                            clicked_tab = True
                            break
                    if not clicked_tab and list_rect.collidepoint(mp):
                        for entry, row_rect in row_rects:
                            if row_rect.collidepoint(mp):
                                self.selected_entry = entry
                                break
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    self.scrollbar = None

            clock.tick(60)


class MapPickerScreen:
    """
    Shared board-layout choice used by Singleplayer, VS AI, and Multiplayer.
    The available sources are Default/Procedural, Custom Maps and Imported Maps.
    Returns None for procedural, or a map dict
    ({'board_width','board_height','obstacles','portals'}) for a concrete map.
    """

    def __init__(self, settings, screen):
        self.settings = settings
        self.screen = screen
        self.scrollbar = None
        self._mode = 'choice'  # 'choice' | 'custom_list' | 'imported_list'

    def _all_maps(self, source='custom'):
        if source == 'imported':
            return _load_imported_maps()
        return _load_custom_maps()

    def run(self):
        clock = pygame.time.Clock()
        while True:
            sw, sh = self.screen.get_width(), self.screen.get_height()
            self.screen.fill(COLORS['dark_blue'])

            t = pygame.time.get_ticks() / 1000.0
            for i in range(20):
                px = int(sw * ((i * 137) % 100) / 100)
                py = int(sh * ((i * 97 + t * 12) % 100) / 100)
                pygame.draw.circle(self.screen, (30, 50, 110), (px, py), 2)

            _ref = min(sw, sh)
            tf = get_font(self.settings.language, 'bold', max(22, int(_ref * 0.05)))
            bf = get_font(self.settings.language, 'bold', max(15, int(_ref * 0.03)))

            if self._mode == 'choice':
                title = tf.render(get_text(self.settings.language, 'board_layout_title'), True, COLORS['white'])
                self.screen.blit(title, (sw // 2 - title.get_width() // 2, int(sh * 0.12)))

                btn_w = max(240, int(sw * 0.36))
                btn_h = max(56, int(sh * 0.1))
                gap = int(sh * 0.03)
                cy = int(sh * 0.32)

                proc_rect = pygame.Rect(sw // 2 - btn_w // 2, cy, btn_w, btn_h)
                custom_rect = pygame.Rect(sw // 2 - btn_w // 2, cy + btn_h + gap, btn_w, btn_h)
                imported_rect = pygame.Rect(sw // 2 - btn_w // 2, cy + (btn_h + gap) * 2, btn_w, btn_h)
                back_rect = pygame.Rect(sw // 2 - btn_w // 2, cy + (btn_h + gap) * 3 + gap,
                                        btn_w, max(44, int(sh * 0.075)))

                pygame.draw.rect(self.screen, COLORS['green'], proc_rect, border_radius=10)
                pygame.draw.rect(self.screen, (60, 130, 160), custom_rect, border_radius=10)
                pygame.draw.rect(self.screen, (95, 90, 155), imported_rect, border_radius=10)
                pygame.draw.rect(self.screen, COLORS['button'], back_rect, border_radius=10)

                for rect, label in (
                    (proc_rect, get_text(self.settings.language, 'random_procedural')),
                    (custom_rect, get_text(self.settings.language, 'custom_map_label')),
                    (imported_rect, "Imported Maps"),
                    (back_rect, get_text(self.settings.language, 'back'))
                ):
                    s = render_fit(bf, label, COLORS['white'], rect.width)
                    self.screen.blit(s, s.get_rect(center=rect.center))

                _legacy_nav_draw(locals().get('self'))
                pygame.display.flip()

                for event in pygame.event.get():
                    if _legacy_nav_event(locals().get('self'), event, locals()):
                        continue
                    if event.type == pygame.QUIT:
                        pygame.quit(); sys.exit()
                    elif event.type == pygame.KEYDOWN:
                        if event.key == pygame.K_ESCAPE:
                            return None
                    elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                        mp = event.pos
                        if proc_rect.collidepoint(mp):
                            return None
                        if custom_rect.collidepoint(mp):
                            self._mode = 'custom_list'
                            self.scrollbar = None
                        if imported_rect.collidepoint(mp):
                            self._mode = 'imported_list'
                            self.scrollbar = None
                        if back_rect.collidepoint(mp):
                            return None
                    elif event.type == pygame.VIDEORESIZE:
                        self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                clock.tick(60)

            else:  # custom/imported map list
                source = 'imported' if self._mode == 'imported_list' else 'custom'
                maps = self._all_maps(source)
                names = sorted(maps.keys())

                _list_title = "Imported Maps" if source == 'imported' else get_text(self.settings.language, 'choose_custom_map_title')
                title = tf.render(_list_title, True, COLORS['white'])
                self.screen.blit(title, (sw // 2 - title.get_width() // 2, int(sh * 0.06)))

                box = pygame.Rect(int(sw * 0.15), int(sh * 0.18), int(sw * 0.7), int(sh * 0.62))
                pygame.draw.rect(self.screen, (20, 26, 48), box, border_radius=10)
                pygame.draw.rect(self.screen, (90, 130, 200), box, width=2, border_radius=10)

                row_h = 44
                content_rect = pygame.Rect(box.x + 10, box.y + 10, box.width - 20, box.height - 20)
                if self.scrollbar is None:
                    self.scrollbar = ScrollBar(content_rect.right - 14, content_rect.y, 14,
                                               content_rect.height, max(len(names) * row_h, content_rect.height))
                self.scrollbar.content_height = max(len(names) * row_h, content_rect.height)
                self.scrollbar.max_scroll = max(0, self.scrollbar.content_height - content_rect.height)
                self.scrollbar.update()

                self.screen.set_clip(content_rect)
                offset = self.scrollbar.get_content_offset()
                row_font = get_font(self.settings.language, 'regular', 16)
                row_rects = []
                for i, name in enumerate(names):
                    ry = content_rect.y + i * row_h - offset
                    row_rect = pygame.Rect(content_rect.x, ry, content_rect.width - 20, row_h - 6)
                    if row_rect.bottom < content_rect.top or row_rect.top > content_rect.bottom:
                        row_rects.append((name, row_rect))
                        continue
                    pygame.draw.rect(self.screen, (32, 40, 68), row_rect, border_radius=6)
                    info = maps[name]
                    label = f"{name}  ({info.get('board_width','?')}x{info.get('board_height','?')})"
                    ls = row_font.render(label, True, COLORS['white'])
                    self.screen.blit(ls, (row_rect.x + 10, row_rect.centery - ls.get_height() // 2))
                    row_rects.append((name, row_rect))
                self.screen.set_clip(None)
                self.scrollbar.draw(self.screen)

                if not names:
                    empty_font = get_font(self.settings.language, 'regular', 16)
                    es = empty_font.render(get_text(self.settings.language, 'no_saved_maps'),
                                          True, (140, 155, 185))
                    self.screen.blit(es, (content_rect.centerx - es.get_width() // 2, content_rect.y + 20))

                back_rect = pygame.Rect(sw // 2 - 70, box.bottom + 16, 140, 40)
                pygame.draw.rect(self.screen, COLORS['button'], back_rect, border_radius=8)
                bs = bf.render(get_text(self.settings.language, 'back'), True, COLORS['white'])
                self.screen.blit(bs, bs.get_rect(center=back_rect.center))

                _legacy_nav_draw(locals().get('self'))
                pygame.display.flip()

                for event in pygame.event.get():
                    if _legacy_nav_event(locals().get('self'), event, locals()):
                        continue
                    if event.type == pygame.QUIT:
                        pygame.quit(); sys.exit()
                    elif event.type == pygame.KEYDOWN:
                        if event.key == pygame.K_ESCAPE:
                            self._mode = 'choice'
                            self.scrollbar = None
                    elif event.type == pygame.MOUSEWHEEL:
                        self.scrollbar.handle_event(event)
                    elif event.type in (pygame.MOUSEBUTTONUP, pygame.MOUSEMOTION):
                        self.scrollbar.handle_event(event)
                    elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                        mp = event.pos
                        if back_rect.collidepoint(mp):
                            self._mode = 'choice'
                        else:
                            for name, row_rect in row_rects:
                                if row_rect.collidepoint(mp):
                                    return maps[name]
                    elif event.type == pygame.VIDEORESIZE:
                        self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                        self.scrollbar = None
                clock.tick(60)


class VSAIConfigScreen:
    """Configure each AI independently, including count, difficulty, name and skin."""

    DIFFICULTIES = ['easy', 'medium', 'hard', 'impossible']
    DIFF_LABELS = ['Easy', 'Medium', 'Hard', 'Impossible']
    SKINS = ['red', 'orange', 'purple', 'cyan', 'green', 'blue', 'yellow']

    def __init__(self, settings, screen, custom_map=None):
        self.settings = settings
        self.screen = screen
        self.custom_map = custom_map
        if custom_map:
            bw = custom_map.get('board_width', settings.board_size)
            bh = custom_map.get('board_height', settings.board_size)
        else:
            bw = bh = settings.board_size
        self.max_ai = _max_ai_for_board(bw, bh)

        saved = _load_game_settings('vs_ai', {
            'ai_count': min(1, self.max_ai),
            'ai_configs': [_default_ai_config(0)] if self.max_ai else [],
            'seed_mode': 'random',
            'seed_value': '',
            'map': None,
        })
        self.ai_count = max(0, min(self.max_ai, int(saved.get('ai_count', 0) or 0)))
        self.ai_configs = _normalize_ai_configs(
            saved.get('ai_configs', []), self.ai_count)
        while len(self.ai_configs) < self.ai_count:
            self.ai_configs.append(_default_ai_config(len(self.ai_configs)))
        self.seed_mode = saved.get('seed_mode', 'random')
        if self.seed_mode not in ('random', 'custom'):
            self.seed_mode = 'random'
        self.seed_text = str(saved.get('seed_value', '') or '')[:64]
        self.seed_active = False
        self.name_active_index = None
        self.selected_ai = 0

    def _ensure_count(self):
        while len(self.ai_configs) < self.ai_count:
            self.ai_configs.append(_default_ai_config(len(self.ai_configs)))
        self.ai_configs = self.ai_configs[:self.ai_count]
        if self.selected_ai >= max(1, self.ai_count):
            self.selected_ai = max(0, self.ai_count - 1)

    def _cycle_difficulty(self, idx):
        current = self.ai_configs[idx]['difficulty']
        pos = self.DIFFICULTIES.index(current) if current in self.DIFFICULTIES else 0
        self.ai_configs[idx]['difficulty'] = self.DIFFICULTIES[(pos + 1) % len(self.DIFFICULTIES)]

    def _cycle_skin(self, idx):
        current = self.ai_configs[idx]['skin']
        pos = self.SKINS.index(current) if current in self.SKINS else 0
        self.ai_configs[idx]['skin'] = self.SKINS[(pos + 1) % len(self.SKINS)]

    def _save(self, seed):
        _save_game_settings('vs_ai', {
            'ai_count': self.ai_count,
            'ai_configs': self.ai_configs,
            'seed_mode': self.seed_mode,
            'seed_value': self.seed_text if self.seed_mode == 'custom' else '',
            'map': self.custom_map,
        })
        return (self.ai_count, self.ai_configs, seed, self.seed_mode, self.seed_text)

    def run(self):
        clock = pygame.time.Clock()
        while True:
            self._ensure_count()
            sw, sh = self.screen.get_size()
            self.screen.fill(COLORS['dark_blue'])
            _ref = min(sw, sh)
            tf = get_font(self.settings.language, 'bold', max(24, int(_ref * 0.052)))
            hf = get_font(self.settings.language, 'bold', max(17, int(_ref * 0.032)))
            bf = get_font(self.settings.language, 'bold', max(14, int(_ref * 0.024)))
            sf = get_font(self.settings.language, 'regular', max(12, int(_ref * 0.020)))

            title = tf.render("VS AI — Game Settings", True, COLORS['white'])
            self.screen.blit(title, title.get_rect(center=(sw // 2, 35)))

            # Count control: +/- rather than a hardcoded row of numbers.
            count_y = 78
            minus = pygame.Rect(sw // 2 - 105, count_y, 50, 42)
            plus = pygame.Rect(sw // 2 + 55, count_y, 50, 42)
            count_box = pygame.Rect(sw // 2 - 50, count_y, 100, 42)
            for r, lab, col in (
                (minus, '-', (95, 65, 80)),
                (plus, '+', (45, 105, 75)),
            ):
                pygame.draw.rect(self.screen, col, r, border_radius=8)
                ss = bf.render(lab, True, COLORS['white'])
                self.screen.blit(ss, ss.get_rect(center=r.center))
            pygame.draw.rect(self.screen, (24, 35, 65), count_box, border_radius=8)
            cs = hf.render(f"{self.ai_count}/{self.max_ai}", True, COLORS['white'])
            self.screen.blit(cs, cs.get_rect(center=count_box.center))
            sub = sf.render("AIs available for this map", True, (145, 165, 200))
            self.screen.blit(sub, sub.get_rect(center=(sw // 2, count_y + 58)))

            row_y = count_y + 84
            header_y = row_y
            headers = [("AI", 0), ("Difficulty", int(sw * .25)), ("Skin", int(sw * .58)), ("Name", int(sw * .75))]
            for label, relx in headers:
                self.screen.blit(sf.render(label, True, (135, 155, 190)), (20 + relx, header_y))
            row_y += 24
            row_h = 42
            rows = []
            for i, cfg in enumerate(self.ai_configs):
                y = row_y + i * row_h
                if y + row_h > int(sh * 0.66):
                    break
                if i == self.selected_ai:
                    pygame.draw.rect(self.screen, (35, 48, 86), (12, y - 3, sw - 24, row_h), border_radius=6)
                name = sf.render(f"{i+1}", True, COLORS['white'])
                self.screen.blit(name, (28, y + 10))

                diff_rect = pygame.Rect(int(sw*.23), y, int(sw*.29), 34)
                skin_rect = pygame.Rect(int(sw*.55), y, int(sw*.20), 34)
                name_rect = pygame.Rect(int(sw*.75), y, max(110, int(sw*.22)), 34)
                for rect in (diff_rect, skin_rect, name_rect):
                    pygame.draw.rect(self.screen, (45, 60, 95), rect, border_radius=6)
                    pygame.draw.rect(self.screen, (90, 110, 160), rect, 1, border_radius=6)

                d = bf.render(cfg['difficulty'].capitalize(), True, COLORS['white'])
                self.screen.blit(render_fit(bf, cfg['difficulty'].capitalize(), COLORS['white'], diff_rect.width - 8),
                                 (diff_rect.x + 4, diff_rect.centery - d.get_height() // 2))
                skin = AI_SKINS.get(cfg['skin'], AI_SKINS['red'])['body']
                pygame.draw.circle(self.screen, skin, (skin_rect.x + 17, skin_rect.centery), 9)
                ss = sf.render(cfg['skin'].capitalize(), True, COLORS['white'])
                self.screen.blit(ss, (skin_rect.x + 32, skin_rect.centery - ss.get_height() // 2))
                ns = render_fit(sf, cfg['name'], COLORS['white'], name_rect.width - 8)
                self.screen.blit(ns, (name_rect.x + 4, name_rect.centery - ns.get_height() // 2))
                rows.append((i, diff_rect, skin_rect, name_rect))

            y = int(sh * 0.69)
            seed_lbl = hf.render("Seed", True, COLORS['light_gray'])
            self.screen.blit(seed_lbl, seed_lbl.get_rect(center=(sw // 2, y)))
            y += seed_lbl.get_height() + 6
            bw = max(130, int(sw*.20))
            bh = 38
            gap = 10
            total = 2*bw+gap
            random_rect = pygame.Rect(sw//2-total//2, y, bw, bh)
            custom_rect = pygame.Rect(random_rect.right+gap, y, bw, bh)
            for rect,label,active in (
                (random_rect,'Random',self.seed_mode=='random'),
                (custom_rect,'Custom',self.seed_mode=='custom')):
                pygame.draw.rect(self.screen, (0,145,195) if active else COLORS['button'], rect, border_radius=7)
                if active:
                    pygame.draw.rect(self.screen, COLORS['white'], rect, 2, border_radius=7)
                self.screen.blit(render_fit(bf,label,COLORS['white'],rect.width),
                                 render_fit(bf,label,COLORS['white'],rect.width).get_rect(center=rect.center))
            y += bh + 7
            seed_rect = pygame.Rect(sw//2 - max(220,int(sw*.40))//2, y,
                                    max(220,int(sw*.40)), 36)
            pygame.draw.rect(self.screen,(20,25,50),seed_rect,border_radius=6)
            pygame.draw.rect(self.screen,(0,190,255) if self.seed_active else (60,70,120),
