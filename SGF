        cx  = margin
        gap = 6

        rects['restart']    = _btn("|<",  cx, 38); cx += 38 + gap
        rects['rewind']     = _btn("<<",  cx, 38); cx += 38 + gap

        if self._replay_ended:
            pp_lbl, pp_bg = "Replay", (30, 80, 50)
        elif self.paused:
            pp_lbl, pp_bg = "  >  ", (90, 55, 20)
        else:
            pp_lbl, pp_bg = " || ", (25, 70, 40)
        rects['play_pause'] = _btn(pp_lbl, cx, 58, bg=pp_bg); cx += 58 + gap

        rects['ff']         = _btn(">>",  cx, 38); cx += 38 + gap + 10

        # Speed selector
        for spd in [0.5, 1.0, 2.0, 4.0]:
            active = abs(self.replay_speed - spd) < 0.01
            bg = (55, 95, 165) if active else (22, 40, 78)
            fg = (255, 255, 255) if active else (140, 175, 220)
            rects[f'speed_{spd}'] = _btn(f"{spd:g}x", cx, 42, bg=bg, fg=fg)
            cx += 42 + gap

        cx += 8
        rects['exit'] = _btn("Exit", cx, 46, bg=(85, 25, 25), fg=(255, 200, 200))

        # ── status text row ─────────────────────────────────────────────────
        info_y   = panel_y + 78
        info_fnt = get_font(self.settings.language, 'regular', 12)

        cur_score = self.game_history[self.replay_index][3] \
            if self.game_history and len(self.game_history[self.replay_index]) > 3 else 0
        status = f"  Frame {self.replay_index + 1} / {len(self.game_history)}   Score: {cur_score}"
        if self._replay_ended:
            status += "   [REPLAY ENDED – press SPACE or click Replay to restart]"
        elif self.paused:
            status += "   [PAUSED]"
        left_s = info_fnt.render(status, True, (150, 185, 230))
        self.screen.blit(left_s, (margin, info_y))

        hint = "SPACE: pause/resume   ← →: seek 10%   R: restart   ESC: exit"
        hint_s = info_fnt.render(hint, True, (80, 110, 155))
        self.screen.blit(hint_s, (sw - hint_s.get_width() - margin, info_y))

        # Store rects for click handling
        self._replay_ctrl_rects = rects
            
    def run(self):
        """Run the game loop"""
        running = True
        clock = pygame.time.Clock()
        replay_timer = 0
        
        while running:
            # Handle events
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif self.replay_mode:
                        # Handle replay controls
                        self.replay_control(event)
                    else:
                        # Normal game controls
                        running = self.handle_input(event)
                    
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    mp = event.pos
                    if self.replay_mode:
                        # Route all clicks through the replay control handler
                        self.replay_handle_click(mp)
                    else:
                        # Check if pause button was clicked
                        pause_button = self.draw_pause_button()
                        if pause_button and pause_button.collidepoint(mp):
                            self.paused = not self.paused
                        # D-pad touch controls
                        elif hasattr(self, '_dpad_rects'):
                            dr = self._dpad_rects
                            if dr['U'].collidepoint(mp) and self.direction != (0, 1):
                                self.next_direction = (0, -1)
                            elif dr['D'].collidepoint(mp) and self.direction != (0, -1):
                                self.next_direction = (0, 1)
                            elif dr['L'].collidepoint(mp) and self.direction != (1, 0):
                                self.next_direction = (-1, 0)
                            elif dr['R'].collidepoint(mp) and self.direction != (-1, 0):
                                self.next_direction = (1, 0)
                            elif dr['C'].collidepoint(mp):
                                self.paused = not self.paused
                        
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    # Recalculate cell size and board position
                    self.cell_size = min(self.screen.get_width(), self.screen.get_height()) // max(self.board_width, self.board_height)
                    self.board_offset_x = (self.screen.get_width() - (self.board_width * self.cell_size)) // 2
                    self.board_offset_y = (self.screen.get_height() - (self.board_height * self.cell_size)) // 2
            
            # Update game state
            current_time = time.time() * 1000  # Convert to milliseconds
            
            # Exit replay cleanly (returns to the caller — e.g. HighScoresScreen)
            if self._replay_exit_requested:
                running = False
                self.replay_mode = False
                self._replay_exit_requested = False
                continue

            if self.replay_mode:
                # Handle replay animation — advance one tick per effective frame interval.
                # Use the speed_multiplier restored from the snapshot so that speed-boost
                # and slow-motion powerups change the playback cadence just as they did
                # during the original game.
                if not self.paused and not self._replay_ended:
                    replay_timer += clock.get_time() * self.replay_speed
                    snap_speed = getattr(self, 'speed_multiplier', 1.0)
                    snap_lspd  = getattr(self, 'length_speed_multiplier', 1.0)
                    effective_frame_ms = self.settings.update_rate_ms * snap_speed * snap_lspd
                    if replay_timer >= effective_frame_ms:
                        more_frames = self.replay_next_frame()
                        if not more_frames:
                            # Reached last frame — pause here, let user exit/restart
                            self._replay_ended = True
                            self.paused = True
                        replay_timer = 0
            else:
                # Normal game logic
                # Apply speed multipliers from power-ups and length to the update rate
                if hasattr(self, 'length_speed_multiplier'):
                    effective_update_rate = self.settings.update_rate_ms * self.speed_multiplier * self.length_speed_multiplier
                else:
                    effective_update_rate = self.settings.update_rate_ms * self.speed_multiplier
                
                # Move obstacles at their own interval
                if hasattr(self, 'moving_obstacles') and not self.paused and not self.game_over and not self.victory:
                    self.update_moving_obstacles()
                
                # Move the snake at its speed interval
                if (not self.paused and not self.game_over and not self.victory and 
                    current_time - self.last_update_time > effective_update_rate):
                    self.move_snake()
                    self.last_update_time = current_time
                
            # Draw game
            self.draw_board()
            
            if not self.replay_mode:
                self.draw_pause_button()
                # Draw on-screen D-pad and store rects for click handling
                self._dpad_rects = self.draw_dpad()
                
                # Draw active power-ups
                self.draw_active_powerups()
                
                # Draw combo counter if active
                if hasattr(self, 'combo_count') and self.combo_count > 1 and self.settings.combo_fruits_enabled:
                    font = get_font(self.settings.language, 'bold', 24)
                    combo_text = f"Combo: x{self.combo_count}"
                    combo_surface = font.render(combo_text, True, (255, 215, 0))  # Gold color
                    self.screen.blit(combo_surface, (20, 85))
                    
                # Draw current level if level progression is enabled
                if hasattr(self, 'current_level') and self.settings.levels_enabled:
                    font = get_font(self.settings.language, 'regular', 18)
                    level_text = f"Level: {self.current_level}"
                    level_surface = font.render(level_text, True, (200, 200, 200))
                    self.screen.blit(level_surface, (20, 55))
                
                if self.game_over or self.victory:
                    self.draw_game_over()
                
                # Draw achievement notifications
                if self.achievement_manager:
                    self.achievement_manager.draw_notification(self.screen, self.screen.get_width(), self.screen.get_height(), self.settings.language)
            else:
                # Draw active power-up HUD (shows names + timers) then replay controls
                self.draw_active_powerups()
                self.draw_replay_controls()
                
            # Update display
            pygame.display.flip()
            
            # Cap the frame rate
            clock.tick(60)
            
        # Return to main menu when the game loop ends
        return

