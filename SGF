        self.network_lobby = NetworkLobbyScreen(self.settings, self.screen)
        
        # Animation variables
        self.transition_alpha = 255  # Start with a fade-in
        self.transition_in = True
        self.transition_speed = 10
        self.transition_surface = pygame.Surface((self.screen.get_width(), self.screen.get_height()))
        self.transition_surface.fill((0, 0, 0))
        
        # Button animation variables
        self.button_hover = {
            "play": False,
