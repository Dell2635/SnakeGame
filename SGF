class ScrollBar:
    """A scrollable interface component with smooth scrolling"""
    def __init__(self, x, y, width, height, content_height):
        self.rect = pygame.Rect(x, y, width, height)
        self.content_height = content_height
        self.scroll_offset = 0
        self.max_scroll = max(0, content_height - height)
        
        # Scrollbar appearance
        self.bar_width = 12
        self.bar_rect = pygame.Rect(x + width - self.bar_width, y, self.bar_width, height)
        self.track_color = COLORS.get('scrollbar_track', (40, 40, 50))
        self.thumb_color = COLORS.get('scrollbar_thumb', (80, 80, 100))
        self.thumb_hover_color = COLORS.get('scrollbar_thumb_hover', (100, 100, 120))
        
        # Scrollbar state
        self.dragging = False
        self.hover = False
        self.last_mouse_y = 0
        
        # Smooth scrolling
        self.target_scroll = 0
        self.scroll_speed = 0.15
        
    def get_thumb_rect(self):
        """Calculate the thumb rectangle based on current scroll position"""
        if self.max_scroll <= 0:
            return pygame.Rect(0, 0, 0, 0)  # No scrolling needed
            
        thumb_height = max(20, int(self.rect.height * self.rect.height / self.content_height))
        thumb_y = self.bar_rect.y + (self.scroll_offset / self.max_scroll) * (self.rect.height - thumb_height)
        
        return pygame.Rect(self.bar_rect.x, thumb_y, self.bar_width, thumb_height)
    
    def handle_event(self, event):
        """Handle mouse events for scrolling"""
        if event.type == pygame.MOUSEBUTTONDOWN:
            if event.button == 1:  # Left click
                mouse_pos = pygame.mouse.get_pos()
                thumb_rect = self.get_thumb_rect()
                
                if thumb_rect.collidepoint(mouse_pos):
                    self.dragging = True
                    self.last_mouse_y = mouse_pos[1]
                elif self.bar_rect.collidepoint(mouse_pos):
                    # Click on track - jump to position
                    relative_y = mouse_pos[1] - self.bar_rect.y
                    scroll_ratio = relative_y / self.rect.height
                    self.target_scroll = scroll_ratio * self.max_scroll
                    self.target_scroll = max(0, min(self.max_scroll, self.target_scroll))
                    
        elif event.type == pygame.MOUSEBUTTONUP:
            if event.button == 1:
                self.dragging = False
                
        elif event.type == pygame.MOUSEMOTION:
            mouse_pos = pygame.mouse.get_pos()
            thumb_rect = self.get_thumb_rect()
            self.hover = thumb_rect.collidepoint(mouse_pos) or self.bar_rect.collidepoint(mouse_pos)
            
            if self.dragging:
                delta_y = mouse_pos[1] - self.last_mouse_y
                scroll_delta = delta_y * (self.max_scroll / (self.rect.height - self.get_thumb_rect().height))
                self.target_scroll += scroll_delta
                self.target_scroll = max(0, min(self.max_scroll, self.target_scroll))
                self.last_mouse_y = mouse_pos[1]
                
        elif event.type == pygame.MOUSEWHEEL:
            mouse_pos = pygame.mouse.get_pos()
            if self.rect.collidepoint(mouse_pos):
                scroll_amount = event.y * 30  # Scroll sensitivity
                self.target_scroll -= scroll_amount
                self.target_scroll = max(0, min(self.max_scroll, self.target_scroll))
    
    def update(self):
        """Update smooth scrolling animation"""
        if abs(self.target_scroll - self.scroll_offset) > 0.5:
            self.scroll_offset += (self.target_scroll - self.scroll_offset) * self.scroll_speed
        else:
            self.scroll_offset = self.target_scroll
    
    def draw(self, screen):
        """Draw the scrollbar"""
        if self.max_scroll <= 0:
            return  # No scrolling needed
            
        # Draw track
        pygame.draw.rect(screen, self.track_color, self.bar_rect, border_radius=6)
        
        # Draw thumb
        thumb_rect = self.get_thumb_rect()
        thumb_color = self.thumb_hover_color if self.hover or self.dragging else self.thumb_color
        pygame.draw.rect(screen, thumb_color, thumb_rect, border_radius=6)
    
    def get_content_offset(self):
        """Get the current content offset for rendering"""
        return int(self.scroll_offset)

