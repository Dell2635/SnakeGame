            return False
        try:
            with open(files[0], 'r', encoding='utf-8') as f:
                payload = json.load(f)
            history = payload.get('events') if isinstance(payload, dict) else payload
            if not isinstance(history, list) or not history:
                raise ValueError('invalid replay events')
            if self.current_game is not None and hasattr(self.current_game, 'start_replay'):
                self.current_game.start_replay(history)
                self.replay_dev_modified = bool(isinstance(payload, dict) and payload.get('dev_modified'))
                self.replay_verified = None
                self.determinism_status = 'NOT VERIFIED'
                self.toast(f'Replay loaded: {os.path.basename(files[0])}')
