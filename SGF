##############

_DATA_FILE = 'snake_game_data.json'

import hashlib

# ── Seed / RNG system ─────────────────────────────────────────────────────────
# Seeds use the full printable-ASCII alphabet (94 characters, excluding space).
# That gives 94^N unique seeds for an N-character seed string, maximising the
# namespace while staying human-typeable.

_SEED_CHARS = (
    '0123456789'
    'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
    'abcdefghijklmnopqrstuvwxyz'
    '!"#$%&\'()*+,-./:;<=>?@[\\]^_`{|}~'
)   # 94 printable ASCII chars (0x21–0x7E, all except space)


def generate_seed(length: int = 10) -> str:
    """Return a random seed string of the given length."""
    _sys_rng = random.SystemRandom()
    return ''.join(_sys_rng.choice(_SEED_CHARS) for _ in range(length))


def seed_to_int(seed: str) -> int:
    """Convert an arbitrary seed string to a stable integer via SHA-256."""
    return int(hashlib.sha256(seed.encode('utf-8')).hexdigest(), 16)


class SeedRNG:
    """
    A seeded random-number generator isolated from the global ``random`` module.
    Every game that has a seed creates one of these and uses it for *all*
    procedural decisions (obstacle / portal / fruit / powerup placement,
    AI tie-breaking, moving-obstacle direction, etc.).
    """
    def __init__(self, seed: str):
        self.seed_str = seed
        self._rng = random.Random(seed_to_int(seed))

    # ── convenience wrappers matching the random module API ─────────────
    def random(self):               return self._rng.random()
    def choice(self, seq):          return self._rng.choice(seq)
    def choices(self, pop, weights=None, k=1):
        return self._rng.choices(pop, weights=weights, k=k)
    def randint(self, a, b):        return self._rng.randint(a, b)
    def uniform(self, a, b):        return self._rng.uniform(a, b)
    def randrange(self, *args):     return self._rng.randrange(*args)
    def sample(self, pop, k):       return self._rng.sample(pop, k)
    def shuffle(self, lst):
        self._rng.shuffle(lst); return lst


def _load_data():
    """Load the unified game data JSON, migrating old legacy files if needed."""
    data = {}
    if os.path.exists(_DATA_FILE):
        try:
            with open(_DATA_FILE, 'r') as _f:
                data = json.load(_f)
        except Exception:
            data = {}
    else:
        # Migrate legacy separate files on first run
        if os.path.exists('snake_settings.json'):
            try:
                with open('snake_settings.json', 'r') as _f:
                    data['settings'] = json.load(_f)
            except Exception:
                pass
        if os.path.exists('snake_highscores.json'):
            try:
                with open('snake_highscores.json', 'r') as _f:
                    data['highscores'] = json.load(_f)
            except Exception:
                pass
        if os.path.exists('snake_achievements.json'):
            try:
                with open('snake_achievements.json', 'r') as _f:
                    data['achievements'] = json.load(_f)
            except Exception:
                pass
        if os.path.exists('snake_player_name.json'):
            try:
                with open('snake_player_name.json', 'r') as _f:
                    _pn = json.load(_f)
                    data['player_name'] = _pn.get('player_name', '')
            except Exception:
                pass
    return data

_data_save_lock = threading.Lock()

def _save_data(data):
    """Write the unified game data JSON (synchronous — use this for saves
    that must complete before continuing, e.g. right before the app exits).
    Shares a lock with _save_data_async so a synchronous save can never be
    clobbered by a slower background save landing right after it."""
    with _data_save_lock:
        try:
            with open(_DATA_FILE, 'w') as _f:
                json.dump(data, _f, indent=2)
        except Exception as _e:
            print(f"Error saving data: {_e}")

def _save_data_async(mutate_fn):
    """Apply mutate_fn(data) -> data to the unified game data on a
    background thread.

    Use this for saves that happen mid-gameplay (like an achievement
    unlocking) where the caller can't afford to block the main loop: the
    unified file can grow fairly large once replay histories/high scores
    accumulate, and writing it out synchronously on every such save was
    causing a noticeable freeze/stutter at the exact moment something
    unlocked.

    mutate_fn receives the *freshest* on-disk data (re-read at the moment
    the background thread actually runs, under the lock) rather than a
    snapshot captured back when the save was queued — otherwise a slow
    background write could finish after a newer synchronous write and
    silently clobber it with stale data (e.g. wiping out a high score that
    was saved a moment after an achievement unlock queued this write).
    """
    def _write():
        with _data_save_lock:
            try:
                data = _load_data()
                data = mutate_fn(data)
                with open(_DATA_FILE, 'w') as _f:
                    json.dump(data, _f, indent=2)
            except Exception as _e:
                print(f"Error saving data (async): {_e}")
    threading.Thread(target=_write, daemon=True).start()

