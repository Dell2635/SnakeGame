            on_change=lambda _value: setattr(self, '_name_error', False),
            on_submit=lambda _value: self._commit_name(),
            advance_on_submit=False)
        self._order.insert(self._order.index('save_name'), 'name_label')
        self._order.insert(self._order.index('save_name'), 'name_input')

    def _build(self):
        ui, view, widgets = self.ui, self.view, self._widgets
        sw, sh = self.screen.get_size()
        lang = self.settings.language
        ui.language = lang
        view.set_rect(pygame.Rect(0, 0, sw, sh))
        ref = min(sw, sh)
        btn_h = max(36, min(60, int(sh * 0.075)))
        min_btn_h = max(26, int(btn_h * 0.66))
        gap = max(6, min(20, int(btn_h * 0.3)))
        title_size = max(28, min(52, int(ref * 0.07)))
        title_h = get_font(lang, 'bold', title_size).get_height() + 20
        widgets['title'].size = title_size
        label_h = get_font(lang, 'regular', 22).get_height()
        input_h = max(32, min(50, int(sh * 0.06)))
        body_h = widgets['body'].measure(min(sw - 32, max(180, int(sw * 0.84)))) + 12
        width = min(int(sw * 0.92), max(160, min(360, int(sw * 0.84))))
        widgets['name_input'].size = max(16, min(24, int(ref * 0.04)))
        pad_v = max(8, int(sh * 0.03))

        def build(content_width):
            flow = UIVerticalFlow(
                pygame.Rect(0, 0, content_width, sh),
                padding=(0, pad_v), spacing=gap, min_spacing=2, valign='center')
            flow.add('title', title_h, min_h=int(title_h * 0.55))
            flow.add('body', body_h, min_h=max(24, int(body_h * 0.55)),
                     w=width, gap=gap, min_gap=2)
            flow.add('name_label', label_h, min_h=int(label_h * 0.8),
                     w=width, gap=gap, min_gap=2)
            flow.add('name_input', input_h, min_h=int(input_h * 0.75),
                     w=width, gap=4, min_gap=2)
            flow.add('save_name', btn_h, min_h=min_btn_h, w=width,
                     gap=gap * 2, min_gap=4)
            flow.add('back', btn_h, min_h=min_btn_h, w=width)
            result = flow.solve()
            for key in self._order:
                view.add(widgets[key], result.rects[key])
            return result.content_height if result.mode == 'scroll' else view.viewport.h

        focused = ui.focused.key if ui.focused is not None else None
        view.relayout(build)
        if focused is not None:
            ui.focus_key(focused)

    def _commit_name(self):
        field = self._widgets['name_input']
        try:
            self.renamed_challenge = _rename_custom_challenge(
                self.challenge['challenge_id'], field.text)
        except (OSError, ValueError, TypeError):
            self._name_error = True
            self._sig = None
            field.flash()
            return
        self._running = False


