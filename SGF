def _replay_tool_label(language, key, **values):
    table = _REPLAY_TOOL_LABELS.get(language) or _REPLAY_TOOL_LABELS['en']
    text = table.get(key) or _REPLAY_TOOL_LABELS['en'].get(key, key)
    try:
