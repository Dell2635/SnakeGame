class NetworkLobbyScreen:
    """UI for LAN host/join setup. Returns (is_host, conn, mode) or None."""

    PORT = 12345

    def __init__(self, settings, screen):
        self.settings = settings
        self.screen   = screen
        self._pending_map = None

    # ── public entry-point ───────────────────────────────────────────────

    def run(self):
        """Show mode → host/join flow. Returns (is_host, conn, mode) or None."""
        net_mode = self._pick_mode()
        if net_mode is None:
            return None
        while True:
            choice = self._pick_host_join()
            if choice is None:
                return None
            elif choice == 'host':
                result = self._host_flow(net_mode)
                if result:
                    return result
            elif choice == 'join':
                result = self._join_flow(net_mode)
                if result:
                    return result

    # ── internal screens ────────────────────────────────────────────────

    def _draw_bg(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        self.screen.fill(COLORS['dark_blue'])
        t = pygame.time.get_ticks() / 1000.0
        for i in range(20):
            px = int(sw * ((i * 137) % 100) / 100)
            py = int(sh * ((i * 97 + t * 12) % 100) / 100)
            pygame.draw.circle(self.screen, (35, 55, 115), (px, py), 2)

    def _mk_btn(self, rect, label, base_col, mp, font):
        col = tuple(min(255, c + 30) for c in base_col) if rect.collidepoint(mp) else base_col
        pygame.draw.rect(self.screen, col, rect, border_radius=10)
        pygame.draw.rect(self.screen, (180, 210, 255), rect, width=1, border_radius=10)
        s = font.render(label, True, COLORS['white'])
        # Some languages render noticeably wider than English at the same point
        # size (e.g. Arabic, German compound words). Rather than overflow the
        # button box, shrink the rendered label proportionally to fit, so this
        # works for every language without hand-tuning button widths per string.
        max_w = rect.width - 16
        if s.get_width() > max_w and s.get_width() > 0:
            scale = max_w / s.get_width()
            new_size = (max_w, max(1, int(s.get_height() * scale)))
            s = pygame.transform.smoothscale(s, new_size)
        self.screen.blit(s, (rect.centerx - s.get_width() // 2,
                              rect.centery - s.get_height() // 2))

    def _pick_mode(self):
        """Choose Co-op or 1v1. Returns '1v1', 'coop', or None."""
        clock = pygame.time.Clock()
        mf = get_font(self.settings.language, 'bold',    26)
        sf = get_font(self.settings.language, 'regular', 16)
        while True:
            sw, sh = self.screen.get_width(), self.screen.get_height()
            self._draw_bg()
            lang = self.settings.language
            ts = mf.render(get_text(lang, 'net_choose_mode_title'), True, COLORS['white'])
            self.screen.blit(ts, (sw // 2 - ts.get_width() // 2, int(sh * 0.12)))

            d1 = sf.render(get_text(lang, 'net_coop_desc'), True, (160, 240, 160))
            d2 = sf.render(get_text(lang, 'net_1v1_desc'),       True, (255, 180, 180))
            self.screen.blit(d1, (sw // 2 - d1.get_width() // 2, int(sh * 0.32)))
            self.screen.blit(d2, (sw // 2 - d2.get_width() // 2, int(sh * 0.40)))

            bw, bh = 200, 50
            coop_r = pygame.Rect(sw // 2 - bw - 12, int(sh * 0.54), bw, bh)
            v1_r   = pygame.Rect(sw // 2 + 12,       int(sh * 0.54), bw, bh)
            back_r = pygame.Rect(sw // 2 - bw // 2,  int(sh * 0.70), bw, bh)
            mp = pygame.mouse.get_pos()
            self._mk_btn(coop_r, get_text(lang, 'coop_label'),  (25, 110, 65),  mp, mf)
            self._mk_btn(v1_r,   "1v1",    (130, 35, 35),  mp, mf)
            self._mk_btn(back_r, get_text(lang, 'back'),   (55,  65, 110), mp, mf)
            pygame.display.flip(); clock.tick(60)

            for event in pygame.event.get():
                if event.type == pygame.QUIT:               pygame.quit(); sys.exit()
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_ESCAPE:        return None
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    if   coop_r.collidepoint(event.pos):    return 'coop'
                    elif v1_r.collidepoint(event.pos):      return '1v1'
                    elif back_r.collidepoint(event.pos):    return None
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)

