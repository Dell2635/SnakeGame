    def show_dropdown_options(self, rect, options, selected_index, is_open, scroll_offset=0):
        """Show dropdown options when open with scrollbar, overlapping other UI elements"""
        if not is_open:
            return [], None, 0
            
        option_rects = []
        option_height = 40
        max_visible_options = 6  # Maximum number of options to show at once
        
        # Get screen dimensions
        screen_width = self.screen.get_width()
        screen_height = self.screen.get_height()
        
        # Total height of dropdown content (all options)
        total_content_height = option_height * len(options)
        
        # Visible height of dropdown (limited)
        visible_height = min(total_content_height, option_height * max_visible_options)
        
        # Position dropdown - for language selection, always position ABOVE to avoid overlap
        if "language" in str(options) or len(options) > 10:  # This is likely the language dropdown
            # Always position above for language dropdown to avoid overlap with other controls
            dropdown_rect = pygame.Rect(
                rect.x, 
                max(10, rect.y - visible_height - 5), 
                rect.width + 20,  # Make it slightly wider for better visibility
                visible_height
            )
        elif rect.y + rect.height + visible_height > screen_height - 10:
            # Position dropdown above the control if it would go off bottom screen
            dropdown_rect = pygame.Rect(
                rect.x, 
                max(10, rect.y - visible_height), 
                rect.width, 
                visible_height
            )
        else:
            # Position dropdown below the control (default)
            dropdown_rect = pygame.Rect(
                rect.x, 
                rect.y + rect.height, 
                rect.width, 
                visible_height
            )
        
        # IMPORTANT: We need to redraw everything to make sure the dropdown appears on top
        # So we'll first capture the screen as it is now
        current_screen = self.screen.copy()
        
        # Create a separate surface for the dropdown with some extra padding to create a slight shadow effect
        padding = 5  # Shadow padding
        shadow_surface = pygame.Surface((dropdown_rect.width + padding*2, dropdown_rect.height + padding*2), pygame.SRCALPHA)
        shadow_surface.fill((0, 0, 0, 150))  # Semi-transparent black for shadow (increased opacity)
        
        # Create the main dropdown surface
        dropdown_surface = pygame.Surface((dropdown_rect.width, dropdown_rect.height), pygame.SRCALPHA)
        
        # Fill with semi-transparent background - using full opacity for maximum visibility
        dropdown_surface.fill((40, 40, 40, 255))  # Dark background with full alpha
        
        # Calculate scrollbar properties
        show_scrollbar = len(options) > max_visible_options
        scrollbar_width = 10
        scrollbar_rect = None
        
        if show_scrollbar:
            # Container for scrollbar (relative to dropdown surface)
            scrollbar_container = pygame.Rect(
                dropdown_rect.width - scrollbar_width - 2, 
                2,
                scrollbar_width,
                dropdown_rect.height - 4
            )
            pygame.draw.rect(dropdown_surface, COLORS['dark_gray'], scrollbar_container, border_radius=3)
            
            # The scrollbar handle
            content_ratio = visible_height / total_content_height
            handle_height = max(20, content_ratio * scrollbar_container.height)
            max_scroll_offset = len(options) - max_visible_options
            
            # Constrain scroll_offset
            if scroll_offset < 0:
                scroll_offset = 0
            if scroll_offset > max_scroll_offset:
                scroll_offset = max_scroll_offset
                
            scroll_ratio = 0 if max_scroll_offset == 0 else scroll_offset / max_scroll_offset
            handle_y_pos = scrollbar_container.y + scroll_ratio * (scrollbar_container.height - handle_height)
            
            handle_rect = pygame.Rect(
                scrollbar_container.x,
                handle_y_pos,
                scrollbar_width,
                handle_height
            )
            pygame.draw.rect(dropdown_surface, COLORS['light_gray'], handle_rect, border_radius=3)
            
            # Store scrollbar rect in screen coordinates for hit testing
            scrollbar_rect = pygame.Rect(
                dropdown_rect.x + scrollbar_container.x,
                dropdown_rect.y + handle_y_pos,
                scrollbar_width,
                handle_height
            )
        
        # Draw options on the dropdown surface (only visible ones)
        font = get_font(self.settings.language, 'regular', 20)
        content_width = dropdown_rect.width - (scrollbar_width + 5 if show_scrollbar else 0)
        
        start_idx = scroll_offset
        end_idx = min(len(options), scroll_offset + max_visible_options)
        
        for i in range(start_idx, end_idx):
            # Position relative to dropdown surface
            local_option_rect = pygame.Rect(
                0, 
                (i - scroll_offset) * option_height, 
                content_width, 
                option_height
            )
            
            # Highlight selected option
            if i == selected_index:
                pygame.draw.rect(dropdown_surface, COLORS['dropdown_selected'], local_option_rect, border_radius=5)
                
            text_surface = font.render(options[i], True, COLORS['white'])
            text_rect = text_surface.get_rect(center=local_option_rect.center)
            dropdown_surface.blit(text_surface, text_rect)
            
            # Store option rect in screen coordinates for hit testing
            screen_option_rect = pygame.Rect(
                dropdown_rect.x, 
                dropdown_rect.y + ((i - scroll_offset) * option_height), 
                content_width, 
                option_height
            )
            option_rects.append((screen_option_rect, i))
        
        # Draw border around dropdown
        pygame.draw.rect(dropdown_surface, COLORS['white'], 
                         (0, 0, dropdown_rect.width, dropdown_rect.height), 1, border_radius=5)
        
        # First blit the shadow for a subtle depth effect
        if hasattr(self, 'current_screen') and self.current_screen:
            # If we've captured the background, restore it first
            self.screen.blit(self.current_screen, (0, 0))
        else:
            # Capture current screen state to be able to restore it
            self.current_screen = self.screen.copy()
            
        # Draw shadow first (slightly offset)
        shadow_pos = (dropdown_rect.x - 3, dropdown_rect.y + 3)
        self.screen.blit(shadow_surface, shadow_pos)
            
        # Now draw the dropdown surface on top
        self.screen.blit(dropdown_surface, (dropdown_rect.x, dropdown_rect.y))
            
        return option_rects, scrollbar_rect, scroll_offset
        
    def draw_settings_tabs(self, start_x, available_width, tab_y):
        """Draw the settings page tabs, sized to fit available_width so they
        never overlap the Back button or run off the edge of the window."""
        screen_height = self.screen.get_height()
        
        num_tabs = len(self.page_names)
        gap = 5
        tab_height = int(screen_height * 0.05)
        tab_width = max(50, (available_width - gap * (num_tabs - 1)) // num_tabs)
        
        tab_rects = []
        tab_names = {
            "general": get_text(self.settings.language, "settings_tab_general"),
            "colors": get_text(self.settings.language, "settings_tab_colors"),
            "powerups": get_text(self.settings.language, "settings_tab_powerups"),
            "fruits": get_text(self.settings.language, "settings_tab_fruits"),
            "gameplay": get_text(self.settings.language, "settings_tab_gameplay"),
            "sound": get_text(self.settings.language, "settings_tab_sound"),
        }
        
        # Draw each tab
        for i, page in enumerate(self.page_names):
            tab_x = start_x + (i * (tab_width + gap))
            tab_rect = pygame.Rect(tab_x, tab_y, tab_width, tab_height)
            
            # Highlight active tab
            if i == self.current_page:
                pygame.draw.rect(self.screen, COLORS['light_blue'], tab_rect, border_radius=8)
                pygame.draw.rect(self.screen, COLORS['white'], tab_rect, border_radius=8, width=2)
            else:
                pygame.draw.rect(self.screen, COLORS['dark_gray'], tab_rect, border_radius=8)
                pygame.draw.rect(self.screen, COLORS['gray'], tab_rect, border_radius=8, width=1)
                
            # Tab text — shrink font if the label doesn't fit this tab's width
            label = tab_names[page]
            font_size = 16
            font = get_font(self.settings.language, 'bold' if i == self.current_page else 'regular', font_size)
            while font.size(label)[0] > tab_width - 8 and font_size > 10:
                font_size -= 1
                font = get_font(self.settings.language, 'bold' if i == self.current_page else 'regular', font_size)
            text_surface = font.render(label, True, COLORS['white'])
            text_rect = text_surface.get_rect(center=tab_rect.center)
            self.screen.blit(text_surface, text_rect)
            
            tab_rects.append(tab_rect)
            
        return tab_rects
    
    def draw_settings(self, language_dropdown_open=False):
        """Draw the settings screen"""
        # Fill background
        self.screen.fill(COLORS['dark_blue'])
        
        # Get screen dimensions for responsive layout
        screen_width = self.screen.get_width()
        screen_height = self.screen.get_height()
        
        # Calculate spacing and positioning based on screen size
        margin_x = int(screen_width * 0.05)  # 5% margin on left/right
        content_width = int(screen_width * 0.5)  # Control width 50% of screen
        
        # Scale controls to screen size
        if screen_width < 800:
            content_width = int(screen_width * 0.7)  # Wider controls on small screens
        
        # ---- Header: title on its own row, then Back + tabs below it ----
        title_y = int(screen_height * 0.02)
        title_font = get_font(self.settings.language, 'bold', int(screen_height * 0.045))
        title_text = get_text(self.settings.language, 'settings')
        title_surface = title_font.render(title_text, True, COLORS['white'])
        self.screen.blit(title_surface, (screen_width // 2 - title_surface.get_width() // 2, title_y))

        header_row_y = int(screen_height * 0.10)
        back_width = int(screen_width * 0.1)
        back_height = int(screen_height * 0.05)
        back_rect = pygame.Rect(margin_x, header_row_y, back_width, back_height)

        tabs_start_x = back_rect.right + int(screen_width * 0.02)
        tabs_available_width = max(50, screen_width - tabs_start_x - margin_x)
        tab_rects = self.draw_settings_tabs(tabs_start_x, tabs_available_width, header_row_y)
        # Page-independent vertical positions — start comfortably below the
        # header row (back button + tabs) so nothing overlaps it.
        item_start_y = int(screen_height * 0.20)
        item_spacing = int(screen_height * 0.09)   # Spacing between control groups
        
        # Define common variables for all settings pages to prevent undefined variables
        self.powerups_spacing = int(item_spacing * 0.6)  # Slightly closer together for lists
        self.powerups_title_y = item_start_y
        self.powerups_start_y = item_start_y + self.powerups_spacing
        
        # Button rows at the bottom
        button_row1_y = int(screen_height * 0.70)
        button_row2_y = int(screen_height * 0.80)
        
        # Button sizes based on screen
        button_width = int(content_width * 0.45)
        button_height = int(screen_height * 0.06)
        
        # Create controls
        controls = {}
        controls['_tab_rects'] = tab_rects
        controls['back_button'] = self.create_button(
            back_rect,
            get_text(self.settings.language, 'back'),
            COLORS['button']
        )
        
        # Determine which page to show based on current_page
        if self.current_page == 0:  # General settings page
            self.draw_general_settings(screen_width, screen_height, margin_x, content_width, item_start_y, item_spacing, controls, language_dropdown_open)
        elif self.current_page == 1:  # Colors page
            self.draw_colors_settings(screen_width, screen_height, margin_x, content_width, item_start_y, item_spacing, controls)
        elif self.current_page == 2:  # Powerups page
            self.draw_powerups_settings(screen_width, screen_height, margin_x, content_width, item_start_y, item_spacing, controls)
        elif self.current_page == 3:  # Fruits page
            self.draw_fruits_settings(screen_width, screen_height, margin_x, content_width, item_start_y, item_spacing, controls)
        elif self.current_page == 4:  # Gameplay page
            self.draw_gameplay_settings(screen_width, screen_height, margin_x, content_width, item_start_y, item_spacing, controls)
        elif self.current_page == 5:  # Sound page
            self.draw_sound_settings(screen_width, screen_height, margin_x, content_width, item_start_y, item_spacing, controls)
            
        # ---- Global action buttons (appear on all tabs) ----
        # Reset to defaults button
        reset_rect = pygame.Rect(margin_x, button_row1_y, button_width, button_height)
        controls['reset_button'] = self.create_button(
            reset_rect,
            get_text(self.settings.language, 'reset_defaults'),
            COLORS['button']
        )

        # Clear data button
        clear_rect = pygame.Rect(margin_x + button_width + int(screen_width * 0.05), button_row1_y, button_width, button_height)
        controls['clear_button'] = self.create_button(
            clear_rect,
            get_text(self.settings.language, 'clear_data'),
            COLORS['red']
        )

        # Show tutorial button
        tutorial_rect = pygame.Rect(margin_x, button_row2_y, button_width, button_height)
        controls['tutorial_button'] = self.create_button(
            tutorial_rect,
            get_text(self.settings.language, 'show_tutorial'),
            COLORS['blue']
        )

        # Save button
        save_rect = pygame.Rect(margin_x + button_width + int(screen_width * 0.05), button_row2_y, button_width, button_height)
        controls['save_button'] = self.create_button(
            save_rect,
            get_text(self.settings.language, 'save_settings'),
            COLORS['green']
        )
        
        # Update display
        pygame.display.flip()
        
        return controls
        
    def run(self):
        """Run the settings screen"""
        # Create a copy of the settings for editing
        self.temp_settings = Settings()
        
        # Basic settings
        self.temp_settings.update_rate_ms = self.settings.update_rate_ms
        self.temp_settings.board_size = self.settings.board_size
        self.temp_settings.snake_color = self.settings.snake_color
        self.temp_settings.language = self.settings.language
        self.temp_settings.first_time = self.settings.first_time
        self.temp_settings.wall_collision = self.settings.wall_collision
        
        # Power-up settings
        self.temp_settings.powerups_enabled = self.settings.powerups_enabled
        self.temp_settings.speed_boost_enabled = self.settings.speed_boost_enabled
        self.temp_settings.slow_motion_enabled = self.settings.slow_motion_enabled
        self.temp_settings.size_reduction_enabled = self.settings.size_reduction_enabled
        self.temp_settings.invincibility_enabled = self.settings.invincibility_enabled
        self.temp_settings.double_points_enabled = self.settings.double_points_enabled
        
        # Obstacle settings
        self.temp_settings.enable_obstacles = self.settings.enable_obstacles
        self.temp_settings.obstacle_count = self.settings.obstacle_count
        self.temp_settings.static_obstacles_enabled = self.settings.static_obstacles_enabled
        self.temp_settings.moving_obstacles_enabled = self.settings.moving_obstacles_enabled
        
        # Portal settings
        self.temp_settings.enable_portals = self.settings.enable_portals
        self.temp_settings.portal_pairs = self.settings.portal_pairs
        
        # Gameplay features
        self.temp_settings.fruit_types_enabled = self.settings.fruit_types_enabled
        self.temp_settings.combo_fruits_enabled = self.settings.combo_fruits_enabled
        self.temp_settings.levels_enabled = self.settings.levels_enabled
        self.temp_settings.increasing_speed_enabled = self.settings.increasing_speed_enabled
        
        # Frequency settings
        self.temp_settings.powerup_frequency = self.settings.powerup_frequency

        # Sound settings
        self.temp_settings.master_volume = getattr(self.settings, 'master_volume', 80)
        self.temp_settings.sfx_enabled   = getattr(self.settings, 'sfx_enabled',   True)
        self.temp_settings.bgm_enabled   = getattr(self.settings, 'bgm_enabled',   False)
        
        # Initialize input text fields with current values
        self.refresh_input_text = str(self.temp_settings.update_rate_ms)
        self.board_size_input_text = str(self.temp_settings.board_size)
        
        # For proper dropdown rendering
        self.current_screen = None
        
        running = True
        language_dropdown_open = False
        dragging_language_scrollbar = False
        scrollbar_drag_start_y = 0
        scrollbar_drag_start_offset = 0
        
        while running:
            # Draw settings screen based on current page
            controls = self.draw_settings(language_dropdown_open)
            # Ensure all control keys exist to prevent KeyError on missing-page controls
            _off = pygame.Rect(-1, -1, 0, 0)
            for _k in ['update_rate_input', 'board_size_input', 'language_dropdown',
                       'language_scrollbar', 'wall_collision', 'powerups_enabled',
                       'speed_boost', 'slow_motion', 'size_reduction', 'invincibility',
                       'double_points', 'fruit_types', 'combo_fruits', 'levels',
                       'increasing_speed', 'reset_button', 'clear_button',
                       'tutorial_button', 'save_button', 'back_button']:
                controls.setdefault(_k, _off)
            for _k in ['language_options', 'color_options']:
                controls.setdefault(_k, [])
            
            # Get tab rects for interaction (computed during the draw above)
            tab_rects = controls.get('_tab_rects', [])
            
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                    
                elif event.type == pygame.MOUSEBUTTONDOWN:
                    mouse_pos = event.pos
                    
                    # Tab clicks: LMB only
                    if event.button == 1:
                        for i, tab_rect in enumerate(tab_rects):
                            if tab_rect.collidepoint(mouse_pos):
                                self.current_page = i
                                language_dropdown_open = False
                    
                    # Mouse-wheel scrolling on dropdowns is handled by the
                    # dedicated pygame.MOUSEWHEEL branch below — the wheel
                    # must never be treated as a click.
                    # All control clicks: LMB only
                    if event.button == 1:
