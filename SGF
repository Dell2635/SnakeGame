            json.dump(self.debug_game_state(), f, indent=2, default=str)
        with open(os.path.join(base, 'replay_info.json'), 'w', encoding='utf-8') as f:
            g = self.current_game
            json.dump({
                'recording': bool(g and not getattr(g, 'replay_mode', False)),
