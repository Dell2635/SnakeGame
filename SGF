        # (b) DNS-over-HTTPS resolver: parsing, validation and the wait loop
        class _DohResponse:
            def __init__(self, document): self.body = json.dumps(document).encode('utf-8')
            def __enter__(self): return self
            def __exit__(self, *_a): return False
            def read(self, _n=-1): return self.body
        def _doh_opener(request, timeout=0):
            assert 'name=lobby-doh.trycloudflare.com' in request.full_url
            if 'type=AAAA' in request.full_url:
                return _DohResponse({'Status': 0, 'Answer': [
                    {'type': 28, 'data': '2606:4700::6810:84e5'},
                    {'type': 28, 'data': 'fd00::1'}]})
            return _DohResponse({'Status': 0, 'Answer': [
                {'type': 5, 'data': 'alias.example.'},
                {'type': 1, 'data': '104.16.132.229'},
                {'type': 1, 'data': '10.0.0.7'},
                {'type': 1, 'data': '127.0.0.1'},
