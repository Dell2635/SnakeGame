        _wide_btn("Won",      col_x + 60,             cur_y, 56, "show_victories:victory_only",  self.filter_options["show_victories"] == "victory_only")
        _wide_btn("Lost",     col_x + 120,            cur_y, 56, "show_victories:no_victory",    self.filter_options["show_victories"] == "no_victory")
