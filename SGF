    def _continue_game_settings(self):
        """Start immediately from the last persisted Game Settings context."""
        context = _last_game_settings_context()
        saved = _load_game_settings(context, {})
        try:
            if context == 'singleplayer':
                seed = _seed_from_setting(saved.get('seed_mode', 'random'), saved.get('seed_value', ''))
                chosen_map = saved.get('map')
                game = SnakeGame(self.settings, self.screen, seed=seed, custom_map=chosen_map)
                game.player_name = self.player_name
                game.achievement_manager = self.achievement_manager
                game.runtime = self.runtime
                _save_game_settings('singleplayer', {
                    **saved,
                    'seed_mode': saved.get('seed_mode', 'random'),
                    'seed_value': saved.get('seed_value', '') if saved.get('seed_mode') == 'custom' else '',
                    'map': chosen_map,
                })
                self.runtime.run_game("singleplayer_game", game.run,
                                      metadata={'seed': seed, 'mode': 'singleplayer'},
                                      surface_owner=game)
                return True

            if context == 'vs_ai':
                chosen_map = saved.get('map')
                configs = _normalize_ai_configs(saved.get('ai_configs', []), saved.get('ai_count', 0))
                seed = _seed_from_setting(saved.get('seed_mode', 'random'), saved.get('seed_value', ''))
                game = VSAIGame(self.settings, self.screen,
                                ai_count=len(configs),
                                ai_difficulty=(configs[0]['difficulty'] if configs else 'medium'),
                                ai_configs=configs,
                                seed=seed, custom_map=chosen_map)
                game.player_name = self.player_name
                game.achievement_manager = self.achievement_manager
                game.runtime = self.runtime
                self.runtime.run_game(
                    "vs_ai_game", game.run,
                    metadata={'seed': seed, 'mode': 'vs_ai', 'ai_count': len(configs)},
                    surface_owner=game)
                return True

            if context == 'multiplayer_local':
                seed = _seed_from_setting(saved.get('seed_mode', 'random'), saved.get('seed_value', ''))
                count = max(1, min(4, int(saved.get('player_count', 2) or 2)))
                cfgs = _normalize_mp_player_configs(saved.get('player_configs', []), count)
                game = LocalMultiplayerNGame(
                    self.settings, self.screen,
                    mode=saved.get('mode', '1v1'),
                    player_count=count,
                    player_configs=cfgs,
                    seed=seed, custom_map=saved.get('map'))
                game.runtime = self.runtime
                self.runtime.run_game(
                    "multiplayer_game", game.run,
                    metadata={'seed': seed, 'mode': saved.get('mode', '1v1'), 'player_count': count},
                    surface_owner=game)
                return True

            if context == 'multiplayer_lan':
                seed = _seed_from_setting(saved.get('seed_mode', 'random'), saved.get('seed_value', ''))
                self.network_lobby.screen = self.screen
                self.network_lobby.runtime = self.runtime
                result = self.runtime.run_legacy(
                    "network_lobby", lambda: self.network_lobby.run(seed=seed),
                    surface_owner=self.network_lobby)
                if result:
                    is_host, conn, net_mode, net_custom_map, net_seed = result
                    _save_game_settings('multiplayer_lan', {
                        **_load_game_settings('multiplayer_lan', {}),
                        'mode': net_mode,
                        'seed_mode': 'custom' if net_seed else 'random',
                        'seed_value': str(net_seed or '') if net_seed else '',
                        'map': net_custom_map,
                        'map_hash': _map_fingerprint(net_custom_map),
                    })
                    ng = NetworkGame(
                        self.settings, self.screen, is_host, conn, net_mode,
                        custom_map=net_custom_map, seed=net_seed)
                    ng.runtime = self.runtime
                    self.runtime.run_game(
                        "network_game", ng.run,
                        metadata={'mode': net_mode, 'is_host': is_host, 'seed': net_seed},
                        surface_owner=ng)
                return True
        except Exception as exc:
            print(f"[IA7-12] could not continue last Game Settings ({context}): {exc}")
        return False

    def _handle_play_menu(self):
        """Play -> Game Settings -> game mode. Game Settings are persisted per context."""
        while True:
            play_screen = PlayMenuScreen(self.settings, self.screen)
            choice = self.runtime.run_legacy("play_menu", play_screen.run, surface_owner=play_screen)

            if choice == 'continue':
                if self._continue_game_settings():
                    return
                continue

            if choice == 'singleplayer':
                while True:
                    mode_screen = SingleplayerModeScreen(self.settings, self.screen)
                    mode = self.runtime.run_legacy("singleplayer_mode", mode_screen.run, surface_owner=mode_screen)
                    if mode == 'no_ai':
                        cfg_screen = SinglePlayerConfigScreen(self.settings, self.screen)
                        cfg = self.runtime.run_legacy("singleplayer_config", cfg_screen.run, surface_owner=cfg_screen)
                        if cfg == NAV_BACK_LEVEL:
                            break  # Back: return to Play menu
                        if cfg == NAV_PREVIOUS:
                            continue  # Previous: return to Singleplayer mode
                        if cfg:
                            (chosen_seed,) = cfg
                            map_screen = MapPickerScreen(self.settings, self.screen)
                            chosen_map = self.runtime.run_legacy("map_picker", map_screen.run, surface_owner=map_screen)
                            saved_cfg = _load_game_settings('singleplayer', {})
                            _save_game_settings('singleplayer', {
                                **saved_cfg,
                                'seed_mode': saved_cfg.get('seed_mode', 'custom' if chosen_seed else 'random'),
                                'seed_value': saved_cfg.get('seed_value', '') if saved_cfg.get('seed_mode') == 'custom' else '',
                                'map': chosen_map,
                            })
                            sp_game = SnakeGame(self.settings, self.screen, seed=chosen_seed, custom_map=chosen_map)
                            sp_game.player_name = self.player_name
                            sp_game.achievement_manager = self.achievement_manager
                            sp_game.runtime = self.runtime
                            self.runtime.run_game(
                                "singleplayer_game", sp_game.run,
                                metadata={'seed': chosen_seed, 'mode': 'singleplayer'},
                                surface_owner=sp_game)
                            return
                        continue
                    elif mode == 'with_ai':
                        # Map is selected before AI settings so the maximum AI count
                        # is derived from the actual board dimensions.
                        map_screen = MapPickerScreen(self.settings, self.screen)
                        chosen_map = self.runtime.run_legacy("map_picker", map_screen.run, surface_owner=map_screen)
                        cfg_screen = VSAIConfigScreen(self.settings, self.screen, custom_map=chosen_map)
                        cfg = self.runtime.run_legacy("vs_ai_config", cfg_screen.run, surface_owner=cfg_screen)
                        if cfg == NAV_BACK_LEVEL:
                            break  # Back: return to Play menu
                        if cfg == NAV_PREVIOUS:
                            continue  # Previous: return to Singleplayer mode
                        if cfg:
                            ai_count, ai_configs, seed = cfg[:3]
                            cfg_seed_mode = cfg[3] if len(cfg) > 3 else 'custom'
                            cfg_seed_text = cfg[4] if len(cfg) > 4 else str(seed)
                            _save_game_settings('vs_ai', {
                                **_load_game_settings('vs_ai', {}),
                                'ai_count': ai_count,
                                'ai_configs': ai_configs,
                                'seed_mode': cfg_seed_mode,
                                'seed_value': cfg_seed_text if cfg_seed_mode == 'custom' else '',
                                'map': chosen_map,
                            })
                            vs_game = VSAIGame(
                                self.settings, self.screen,
                                ai_count=ai_count,
                                ai_difficulty=(ai_configs[0]['difficulty'] if ai_configs else 'medium'),
                                ai_configs=ai_configs,
                                seed=seed,
                                custom_map=chosen_map)
                            vs_game.player_name = self.player_name
                            vs_game.achievement_manager = self.achievement_manager
                            vs_game.runtime = self.runtime
                            self.runtime.run_game(
                                "vs_ai_game", vs_game.run,
                                metadata={'seed': seed, 'mode': 'vs_ai', 'ai_count': ai_count},
                                surface_owner=vs_game)
                            return
                        continue
                    else:
                        break

            elif choice == 'multiplayer':
                self.multiplayer_screen.runtime = self.runtime
                mp_result = self.runtime.run_legacy(
                    "multiplayer_mode", self.multiplayer_screen.run,
                    surface_owner=self.multiplayer_screen)
                if mp_result is None:
                    continue

                if mp_result[0] == 'network':
                    _mp_seed = mp_result[1] if len(mp_result) > 1 else generate_seed()
                    self.network_lobby.screen = self.screen
                    self.network_lobby.runtime = self.runtime
                    result = self.runtime.run_legacy(
                        "network_lobby",
                        lambda: self.network_lobby.run(seed=_mp_seed),
                        surface_owner=self.network_lobby)
                    if result:
                        is_host, conn, net_mode, net_custom_map, net_seed = result
                        _save_game_settings('multiplayer_lan', {
                            **_load_game_settings('multiplayer_lan', {}),
                            'mode': net_mode,
                            'seed_mode': 'custom' if net_seed else 'random',
                            'seed_value': str(net_seed or '') if net_seed else '',
                            'map': net_custom_map,
                            'map_hash': _map_fingerprint(net_custom_map),
                        })
                        ng = NetworkGame(
                            self.settings, self.screen, is_host, conn, net_mode,
                            custom_map=net_custom_map, seed=net_seed)
                        ng.runtime = self.runtime
                        self.runtime.run_game(
                            "network_game", ng.run,
                            metadata={'mode': net_mode, 'is_host': is_host, 'seed': net_seed},
                            surface_owner=ng)
                    return

                mp_mode = mp_result[0]
                mp_seed = mp_result[1] if len(mp_result) > 1 else generate_seed()
                player_count = mp_result[2] if len(mp_result) > 2 else 2
                player_configs = mp_result[3] if len(mp_result) > 3 and mp_result[3] is not None else _normalize_mp_player_configs([], player_count)
                mp_seed_mode = mp_result[4] if len(mp_result) > 4 else ('custom' if str(mp_seed).strip() else 'random')
                map_screen = MapPickerScreen(self.settings, self.screen)
                chosen_map = self.runtime.run_legacy("map_picker", map_screen.run, surface_owner=map_screen)
                _save_game_settings('multiplayer_local', {
                    **_load_game_settings('multiplayer_local', {}),
                    'mode': mp_mode,
                    'player_count': player_count,
                    'seed_mode': mp_seed_mode,
                    'seed_value': str(mp_seed).strip() if mp_seed_mode == 'custom' else '',
                    'player_configs': player_configs,
                    'map': chosen_map,
                })
                mp_game = LocalMultiplayerNGame(
                    self.settings, self.screen, mp_mode,
                    player_count=player_count,
                    player_configs=player_configs,
                    seed=mp_seed, custom_map=chosen_map)
                mp_game.runtime = self.runtime
                self.runtime.run_game(
                    "multiplayer_game", mp_game.run,
                    metadata={'seed': mp_seed, 'mode': mp_mode, 'player_count': player_count},
                    surface_owner=mp_game)
                return

            else:
                return

    def run(self):
        """Main game loop.

        Reconciled version: drives the IA1 widget/focus/action UI (draw_menu
        dispatches through self.ui, which returns a semantic action string
        for anything it didn't consume itself) while keeping IA5's runtime
        lifecycle intact (dt from the menu clock, and shutdown_application()
        on exit). Per-button navigation (highscores/settings/achievements/
        map_editor/encyclopedia/credits) is wired through
        self.runtime.run_legacy(...) inside _menu_entries()/_handle_menu_action
        rather than here, so IA5's screen-manager back-navigation and modal
        tracking keep working through the new UI layer.
        """
        self._running = True

        while self._running:
            self._dt = self._menu_clock.tick(60) / 1000.0
            self.draw_menu()
            # Initialize the achievement manager in case it doesn't exist yet
            if not hasattr(self, 'achievement_manager'):
                self.achievement_manager = AchievementManager()
                self.achievement_manager.load_state()

            # Check for language change
            if self.current_language != self.settings.language:
                self.current_language = self.settings.language

            for event in pygame.event.get():
                if _legacy_nav_event(locals().get('self'), event, locals()):
                    continue
                if event.type == pygame.QUIT:
                    self._running = False

                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)

                else:
                    action = self.ui.handle_event(event)
                    if action:
                        self._handle_menu_action(action)

        if getattr(self, 'runtime', None) is not None:
            self.runtime.shutdown_application()
        pygame.quit()
        sys.exit()

def _run_ia5_integration_selftest():
    """Lightweight regression harness for the IA5-owned infrastructure.

    It deliberately avoids entering blocking UI loops. The checks exercise the
    manager lifecycle, back navigation, modal/overlay ownership, protocol
    framing, malformed-message classification, and object construction for the
    key IA5 compatibility surfaces.
    """
    results = []

    class _ProbeScreen(ManagedScreen):
        def __init__(self, name, events):
            self.name = name
            self.events = events
        def enter(self, payload=None): self.events.append(self.name + ':enter')
        def exit(self): self.events.append(self.name + ':exit')
        def handle_event(self, event): return False

    bus = RuntimeEventBus()
    events = []
    bus.subscribe('SCREEN_ENTERED', lambda payload: events.append('bus:entered'))
    mgr = ScreenManager(pygame.display.get_surface(), bus)
    a = _ProbeScreen('a', events)
    b = _ProbeScreen('b', events)
    mgr.push(a)
    mgr.push(b)
    assert mgr.stack_depth == 1 and mgr.current_screen is b
    assert mgr.back() and mgr.current_screen is a
    mgr.set_modal(object())
    assert mgr.modal_owner is not None
    mgr.clear_modal()
    assert mgr.modal_owner is None
    assert 'bus:entered' in events
    results.append('screen_manager')

    # TCP frame round-trip and explicit protocol failure classification.
    s1, s2 = _socket_mod.socketpair()
    try:
        _net_send(s1, {'t': 'ping', 'value': 7})
        msg = _net_recv(s2)
        assert msg.get('v') == NET_PROTOCOL_VERSION and msg.get('value') == 7
        s1.sendall(struct.pack('!I', 5) + b'{bad}')
        try:
            _net_recv(s2)
            raise AssertionError('malformed JSON was accepted')
        except _NetProtocolError:
            pass
        results.append('network_protocol')
    finally:
        try: s1.close()
        except OSError: pass
        try: s2.close()
        except OSError: pass

    assert _validate_net_direction([1, 0])
    assert not _validate_net_direction([2, 0])
    assert _validate_net_map({'board_width': 10, 'board_height': 10, 'obstacles': []})
    assert not _validate_net_map({'board_width': 2, 'board_height': 10, 'obstacles': []})
    good_state = {
        't': 'state', 'p1': [[1, 1]], 'p2': [[8, 8]], 'obs': [],
        'f': [5, 5], 's1': 1, 's2': 2, 'a1': True, 'a2': True,
        'go': False, 'w': None, 'bw': 10, 'bh': 10,
        'snap': [
            [[1, 1]], [[8, 8]], [1, 0], [-1, 0], 1, 2, True, True,
            [5, 5], [], False, None, 10, 10, '1v1', 'regular'
        ]
    }
    assert _validate_net_state_message(good_state)
    assert not _validate_net_state_message(dict(good_state, snap=['not-a-snapshot']))

    settings = Settings()
    snake = SnakeGame(settings, pygame.display.get_surface() or pygame.display.set_mode((800, 600)))
    mp = MultiplayerGame(settings, snake.screen, mode='1v1')
    vs = VSAIGame(settings, snake.screen, ai_count=1, ai_difficulty='easy', seed=generate_seed())
    tutorial = TutorialScreen(settings, snake.screen)
    assert hasattr(vs, '_p2_ai') or hasattr(vs, 'ai_snakes')
    assert tutorial is not None and mp is not None and snake is not None
    results.append('game_ai_tutorial_construction')

    return results


