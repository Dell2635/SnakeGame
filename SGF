        session = dict(self._pending_session or {})
        lang = self.settings.language
        link = _PeerLink(conn, False, None)      # no resume window while still in the lobby
        link._send_safe({'t': 'profile', 'name': self._host_display_name()})
        max_players = int(session.get('max_players', 4))
        names, you = [], None
        clock = pygame.time.Clock()
        mf = get_font(lang, 'bold', 22)
        sf = get_font(lang, 'regular', 15)
        try:
            while True:
                for _ in range(16):
                    try:
                        msg = link._recv_q.get_nowait()
                    except _queue_mod.Empty:
                        break
                    outcome = link._handle_link_message(msg)
                    if outcome == 'stop':
                        break
                    if outcome is None and msg.get('t') == 'lobby':
                        names, you = list(msg['names']), msg['you']
                    elif outcome is None and msg.get('t') == 'nstart':
                        link._session = session       # from now on a drop gets the resume window
                        link._next_ping = time.monotonic() + 0.5
                        handed = link
                        link = None
                        return (False, {'kind': 'n', 'link': handed, 'you': msg['you'],
                                        'count': msg['count'], 'names': list(msg['names'])},
                                mode, host_map, host_seed)
                link._service_link()
                if not link.connected:
                    return None
                sw, sh = self.screen.get_size()
                self._draw_bg()
                title = render_fit(mf, _net_ui_text(lang, 'room_guest_title'), COLORS['white'],
                                   sw - 32, padding=0)
                self.screen.blit(title, (sw // 2 - title.get_width() // 2, int(sh * 0.30)))
                self._draw_subtitle(lang, 'title_network' if _is_cloudflare_quick_hostname(
                    session.get('host', '')) else 'title_lan', sw, int(sh * 0.20))
                self._draw_roster_strip(lang, sf, names, max_players, int(sh * 0.45), you=you)
                cancel_r = pygame.Rect(sw // 2 - 100, int(sh * 0.75), 200, 40)
                self._mk_btn(cancel_r, get_text(lang, 'cancel'), (90, 30, 30),
                             pygame.mouse.get_pos(), mf)
                pygame.display.flip()
                clock.tick(60)
                for event in pygame.event.get():
                    if event.type == pygame.QUIT:
                        pygame.quit(); sys.exit()
                    elif event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                        return None
                    elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1 \
                            and cancel_r.collidepoint(event.pos):
                        return None
                    elif event.type == pygame.VIDEORESIZE:
                        self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
        finally:
            if link is not None:
                # leaving the room on purpose: say goodbye so the host frees the slot
                if link.connected:
                    link._send_safe({'t': 'bye'})
                    deadline = time.monotonic() + 0.3
                    while time.monotonic() < deadline and link._send_q.unfinished_tasks > 0:
                        time.sleep(0.01)
                link._stop_event.set()
                link.connected = False
                link._stop_io()

    def _host_display_name(self):
        return _clean_player_name(getattr(self, 'player_name', None), 'Host')

    def _broadcast_room(self, roster, max_players):
        """Tell every waiting guest who is in the room (host first, then join order)."""
        names = [self._host_display_name()] + [entry['name'] for entry in roster]
        for index, entry in enumerate(roster, start=1):
            entry['link']._send_safe({'t': 'lobby', 'names': names, 'you': index,
                                      'max': max_players})

    def _service_room(self, roster, max_players):
        """Keep waiting guests alive; drop the ones that left or went silent."""
        changed = False
        for entry in list(roster):
            link = entry['link']
            for _ in range(8):
                try:
                    msg = link._recv_q.get_nowait()
                except _queue_mod.Empty:
                    break
                outcome = link._handle_link_message(msg)
                if outcome == 'stop':
                    break
                if outcome is None and msg.get('t') == 'profile':
                    new_name = _clean_player_name(msg.get('name'), entry['name'])
                    changed = changed or new_name != entry['name']
                    entry['name'] = new_name
            link._service_link()
            if not link.connected:
                roster.remove(entry)
                link._stop_event.set()
                link._stop_io()
                changed = True
        if changed:
            self._broadcast_room(roster, max_players)

    def _draw_roster_strip(self, lang, sf, names, max_players, y, you=None):
        """Player cards, host first: joined players and open slots."""
        sw = self.screen.get_width()
        card_w = min(150, (sw - 40) // 4 - 8)
        total = max_players * (card_w + 8) - 8
        x = sw // 2 - total // 2
        names = list(names)
        for index in range(max_players):
            rect = pygame.Rect(x + index * (card_w + 8), y, card_w, 44)
            filled = index < len(names)
            colour = LocalMultiplayerNGame.PLAYER_COLORS[index][0]
            pygame.draw.rect(self.screen, (28, 40, 78) if filled else (22, 28, 52), rect, border_radius=8)
            pygame.draw.rect(self.screen, colour if filled else (70, 80, 115), rect,
                             width=2 if filled else 1, border_radius=8)
            label = names[index] if filled else _net_ui_text(lang, 'slot_waiting')
            status = ''
            if filled:
                status = _net_ui_text(lang, 'slot_host' if index == 0 else 'slot_connected')
                if you is not None and index == you:
                    status = _net_ui_text(lang, 'room_you')
            name_surface = render_fit(sf, label, (235, 240, 255) if filled else (110, 125, 160),
                                      rect.width - 14, padding=0)
            self.screen.blit(name_surface, (rect.x + 8, rect.y + 6))
            if status:
                small = get_font(lang, 'regular', 12)
                status_surface = render_fit(small, status, colour, rect.width - 14, padding=0)
                self.screen.blit(status_surface, (rect.x + 8, rect.y + 25))

    def _pick_player_count(self):
        """Room size for the host: 2 keeps the classic duel, 3-4 opens a room."""
        language = self.settings.language
        chosen = {'value': None}
        menu = None
        def pick(value):
            chosen['value'] = value
            menu._go_back()
        entries = [(f'players_{n}', (lambda n=n: _net_ui_text(language, 'players_option', n=n)),
                    COLORS['light_blue'] if n == 2 else COLORS['purple'], (lambda n=n: pick(n)))
                   for n in (2, 3, 4)]
        menu = _SimpleMenuScreen(self.settings, self.screen,
                                 title_fn=lambda: _net_ui_text(language, 'pick_players_title'),
                                 entries=entries)
        menu.runtime = getattr(self, 'runtime', None)
        menu.run()
        return chosen['value']

    def _host_flow(self, mode, seed=None, max_players=2):
        """Host one authenticated, encrypted multiplayer session."""
        clock = pygame.time.Clock()
        mf = get_font(self.settings.language, 'bold',    22)
        sf = get_font(self.settings.language, 'regular', 15)

        try:
            tls_context, tls_fingerprint = _create_network_tls_server_context()
        except Exception as exc:
            self._show_error(str(exc))
            return None
        join_token = _secrets_mod.token_bytes(32)
        resume_token = _new_resume_token()
        invite_code = _make_network_invite(tls_fingerprint, join_token)

        # Host picks the board layout up front — it's sent to the client in
        # the handshake below, so both sides always end up with the exact
        # same map (never two independently-generated layouts).
        chosen_map = MapPickerScreen(self.settings, self.screen).run()

        local_ip_result = _queue_mod.Queue(maxsize=1)
        def _detect_host_local_ips():
            try:
                result = _get_local_ips()
            except Exception:
                result = []
            try:
                local_ip_result.put_nowait(result)
            except _queue_mod.Full:
                pass
        threading.Thread(target=_detect_host_local_ips,
                         name='SGF-local-ip-detection', daemon=True).start()
        local_ips = []
        local_ip_done = False
        connection_info = invite_code
        srv_sockets = []
        try:
            srv_sockets = _create_network_listener_sockets(self.PORT)
        except Exception as e:
            self._show_error(get_text(self.settings.language, 'cannot_start_server').format(error=e))
            return None

        # The game manages its temporary relay component inside SGF Data.
        # This path needs no router port forwarding or administrator access.
        tunnel_session = (CloudflareQuickTunnelSession(self.PORT, invite_code).start()
                          if getattr(self, 'transport', 'network') == 'network' else None)

        dots = 0
        dot_timer = 0
        invite_copied = False
        def _update_connection_info(candidate):
            nonlocal connection_info, invite_copied
            if candidate != connection_info:
                connection_info = candidate
                invite_copied = False
        # Rooms of 3-4 players keep accepting guests until the host starts the
        # match; each guest gets its own resume credential and one PeerLink.
        room_mode = max_players > 2
        handed_off = False
        roster = []                     # [{'link': _PeerLink, 'name': str, 'resume': bytes}]
        pending_resume_token = resume_token
        start_r = None
        handshake_results = _queue_mod.Queue(maxsize=1)
        handshake_cancel = threading.Event()
        handshake_result_lock = threading.Lock()
        handshake_pending = False
        handshake_attempts_by_ip = {}
        public_ip_result = _queue_mod.Queue(maxsize=1)
        if tunnel_session is not None:
            public_ip_thread = threading.Thread(
                target=lambda: public_ip_result.put(_lookup_public_ip()),
                name='SGF-public-ip', daemon=True)
            public_ip_thread.start()
        public_ip = None
        public_ip_done = False
        lan_selected = 0
        retry_r = None
        lan_row_rects = []
        authoritative_seed = seed if seed else generate_seed()
        try:
            lang = self.settings.language
            while True:
                if not local_ip_done:
                    try:
                        local_ips = _order_lan_addresses(local_ip_result.get_nowait())
                        local_ip_done = True
                        if local_ips:
                            _update_connection_info(_format_network_connection_info(
                                local_ips[0], self.PORT, invite_code))
                    except _queue_mod.Empty:
                        pass
                if tunnel_session is not None and not public_ip_done:
                    try:
                        public_ip = public_ip_result.get_nowait()
                        public_ip_done = True
                        if public_ip and tunnel_session.snapshot()[0] != 'ready':
                            _update_connection_info(_format_network_connection_info(
                                public_ip, self.PORT, invite_code))
                    except _queue_mod.Empty:
                        pass
                if tunnel_session is None and local_ips:
                    # LAN play: the shared link follows the address the host picked.
                    lan_selected = max(0, min(lan_selected, len(local_ips) - 1))
                    _update_connection_info(_format_network_connection_info(
                        local_ips[lan_selected], self.PORT, invite_code))
                funnel_state, funnel_host, funnel_port, _funnel_detail = (
                    tunnel_session.snapshot() if tunnel_session is not None
                    else ('lan', '', None, ''))
                if funnel_state == 'ready' and funnel_host and funnel_port:
                    _update_connection_info(_format_network_connection_info(
                        funnel_host, funnel_port, invite_code))
                elif public_ip and tunnel_session is not None:
                    _update_connection_info(_format_network_connection_info(
                        public_ip, self.PORT, invite_code))
                try:
                    result_ok, result_value = handshake_results.get_nowait()
                    handshake_pending = False
                    if result_ok and room_mode:
                        guest_link = _PeerLink(result_value, True)
                        roster.append({'link': guest_link, 'resume': pending_resume_token,
                                       'name': f'Player {len(roster) + 2}'})
                        self._broadcast_room(roster, max_players)
                        sgf_log.info('Guest joined the room (%d/%d)', len(roster) + 1, max_players)
                    elif result_ok:
                        if funnel_state == 'ready':
                            self._pending_tunnel_session = tunnel_session
                            tunnel_session = None
                        # Keep listening during the match so a dropped guest can
                        # resume; NetworkGame closes these when the session ends.
                        self._pending_session = {
                            'listeners': srv_sockets, 'tls_context': tls_context,
                            'resume_token': resume_token, 'attempts': {}}
                        srv_sockets = []
                        return (True, result_value, mode, chosen_map, authoritative_seed)
                    if not result_ok:
                        # Keep a useful failure reason in the local log. The UI
                        # remains generic, while the bounded detail helps diagnose
                        # TLS/protocol mismatches without recording invite tokens
                        # or peer addresses.
                        rejection_reason = ' '.join(str(result_value or '').split())[:180]
                        sgf_log.warning(
                            'Rejected peer during secure multiplayer handshake: %s',
                            rejection_reason or 'no detail supplied')
                except _queue_mod.Empty:
                    pass
                sw, sh = self.screen.get_width(), self.screen.get_height()
                self._draw_bg()

                ts = mf.render(get_text(lang, 'hosting_waiting'), True, COLORS['white'])
                self.screen.blit(ts, (sw // 2 - ts.get_width() // 2, int(sh * 0.08)))

                self._draw_subtitle(lang, 'title_network' if tunnel_session is not None
                                    else 'title_lan', sw, int(sh * 0.125))
                relay_pending = (tunnel_session is not None and funnel_state not in (
                    'ready', 'unavailable', 'stopped', 'not_installed'))
                connection_info_ready = _network_connection_info_ready(
                    local_ip_done=local_ip_done, local_ips=local_ips,
                    public_ip=public_ip,
                    relay_host=funnel_host if funnel_state == 'ready' else None,
                    relay_port=funnel_port if funnel_state == 'ready' else None,
                    relay_pending=relay_pending)
                mouse_position = pygame.mouse.get_pos()
                if tunnel_session is not None:
                    panel = self._draw_relay_host_panel(
                        lang, mf, sf, funnel_state, _funnel_detail, funnel_host,
                        public_ip, public_ip_done, connection_info_ready, invite_copied,
                        mouse_position)
                    retry_r = panel['retry']
                    lan_row_rects = []
                else:
                    panel = self._draw_lan_host_panel(
                        lang, mf, sf, local_ips, lan_selected, local_ip_done,
                        invite_code, connection_info_ready, invite_copied, mouse_position)
                    retry_r = None
                    lan_row_rects = panel['rows']
                copy_r = panel['copy']

                dot_timer += 1
                if dot_timer > 18: dots = (dots + 1) % 4; dot_timer = 0
                waiting_y = max(int(sh * 0.81), copy_r.bottom + 12)
                mp = pygame.mouse.get_pos()
                if room_mode:
                    self._draw_roster_strip(
                        lang, sf, [self._host_display_name()] + [entry['name'] for entry in roster],
                        max_players, waiting_y - 8)
                    button_y = max(int(sh * 0.905), waiting_y + 50)
                    start_r = pygame.Rect(sw // 2 - 210, button_y, 200, 40)
                    cancel_r = pygame.Rect(sw // 2 + 10, button_y, 200, 40)
                    self._mk_btn(start_r, _net_ui_text(lang, 'start_match'),
                                 (30, 110, 70) if roster else (55, 58, 68), mp, mf)
                    self._mk_btn(cancel_r, get_text(lang, 'cancel'), (90, 30, 30), mp, mf)
                else:
                    ws = sf.render(get_text(lang, 'waiting_connection') + "." * dots, True, (150, 175, 220))
                    self.screen.blit(ws, (sw // 2 - ws.get_width() // 2, waiting_y))
                    cancel_r = pygame.Rect(sw // 2 - 100, max(int(sh * 0.90), waiting_y + 30), 200, 40)
                    self._mk_btn(cancel_r, get_text(lang, 'cancel'), (90, 30, 30), mp, mf)
                pygame.display.flip(); clock.tick(60)

                if room_mode:
                    self._service_room(roster, max_players)
                if not handshake_pending and (not room_mode or len(roster) < max_players - 1):
                    raw_conn = peer_addr = None
                    for srv in srv_sockets:
                        try:
                            raw_conn, peer_addr = srv.accept()
                            break
                        except (BlockingIOError, _socket_mod.timeout):
                            continue
                        except OSError:
                            continue
                    if raw_conn is not None:
                        peer_ip = peer_addr[0] if peer_addr else ''
                        if not _allow_network_handshake_attempt(
                                peer_ip, handshake_attempts_by_ip):
                            raw_conn.close()
                            continue
                        try:
                            raw_conn.setsockopt(_socket_mod.IPPROTO_TCP, _socket_mod.TCP_NODELAY, 1)
                            if room_mode:
                                pending_resume_token = _new_resume_token()
                            worker = threading.Thread(
                                target=_finish_secure_host_handshake,
                                args=(raw_conn, tls_context, join_token, mode,
                                      chosen_map, authoritative_seed, handshake_results,
                                      handshake_cancel, handshake_result_lock),
                                kwargs={'resume_token': pending_resume_token,
                                        'max_players': max_players},
                                name='SGF-secure-handshake', daemon=True,
                            )
                            worker.start()
                            handshake_pending = True
                        except Exception:
                            try: raw_conn.close()
                            except OSError: pass

                for event in pygame.event.get():
                    if _legacy_nav_event(locals().get('self'), event, locals()):
                        continue
                    if event.type == pygame.QUIT:           pygame.quit(); sys.exit()
                    elif event.type == pygame.KEYDOWN:
                        if event.key == pygame.K_ESCAPE:    return None
                    elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                        if cancel_r.collidepoint(event.pos): return None
                        elif room_mode and roster and start_r is not None and start_r.collidepoint(event.pos):
                            if funnel_state == 'ready':
                                self._pending_tunnel_session = tunnel_session
                                tunnel_session = None
                            self._pending_session = {
                                'listeners': srv_sockets, 'tls_context': tls_context,
                                'resume_tokens': {index + 1: entry['resume']
                                                  for index, entry in enumerate(roster)},
                                'attempts': {}}
                            srv_sockets = []
                            handed_off = True
                            names = [self._host_display_name()] + [entry['name'] for entry in roster]
                            return (True, {'kind': 'n', 'roster': roster, 'names': names},
                                    mode, chosen_map, authoritative_seed)
                        elif retry_r is not None and retry_r.collidepoint(event.pos):
                            # Start a fresh relay; the old one is stopped first.
                            tunnel_session.stop()
                            tunnel_session = CloudflareQuickTunnelSession(
                                self.PORT, invite_code).start()
                            invite_copied = False
                        elif any(row.collidepoint(event.pos) for row in lan_row_rects):
                            lan_selected = next(i for i, row in enumerate(lan_row_rects)
                                                if row.collidepoint(event.pos))
                        elif copy_r.collidepoint(event.pos):
                            if connection_info_ready:
                                invite_copied = _copy_to_clipboard(connection_info)
                            if invite_copied:
                                sgf_log.info('Secure multiplayer connection URI copied to clipboard')
                    elif event.type == pygame.VIDEORESIZE:
                        self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
        finally:
            # If the host backs out while TLS/authentication is still running,
            # stop publication and close a connection that completed just as
            # the screen was exiting. The worker closes any in-flight socket
            # when its bounded handshake timeout expires.
            _pending_ok = False
            _pending_result = None
            with handshake_result_lock:
                handshake_cancel.set()
                try:
                    _pending_ok, _pending_result = handshake_results.get_nowait()
                except _queue_mod.Empty:
                    pass
            if _pending_ok:
                try: _pending_result.close()
                except Exception: pass
            if room_mode and not handed_off:
                for entry in roster:
                    entry['link']._stop_event.set()
                    entry['link'].connected = False
                    entry['link']._stop_io()
            if tunnel_session is not None:
                tunnel_session.stop()
            for srv in srv_sockets:
                try: srv.close()
                except OSError: pass

    def _join_flow(self, mode, seed=None):
        """IP-entry + connect UI. Host remains authoritative for seed/map."""
        clock = pygame.time.Clock()
        mf  = get_font(self.settings.language, 'bold',    22)
        sf  = get_font(self.settings.language, 'regular', 15)
        ip_str  = ''
        invite_str = ''
        link_str = ''
        join_port = self.PORT
        is_relay = getattr(self, 'transport', 'network') == 'network'
        self._expected_mode = mode
        status  = ''
        status_col = (200, 200, 200)
        active_field = 'ip'
        connect_results = _queue_mod.Queue(maxsize=1)
        connect_pending = False
        connect_cancel = None

        def _begin_connect():
            nonlocal connect_pending, connect_cancel, status, status_col
            nonlocal ip_str, invite_str, join_port
            if connect_pending:
                return
            if is_relay:
                try:
                    parsed_link = _parse_network_connection_info(link_str)
                except ValueError:
                    parsed_link = None
                if not parsed_link:
                    status = _net_ui_text(lang, 'link_invalid')
                    status_col = (255, 185, 80)
                    return
                ip_str, join_port, invite_str = parsed_link
            ip = ip_str.strip()
            if not ip:
                status = get_text(lang, 'please_enter_ip')
                status_col = (255, 185, 80)
                return
            if not invite_str:
                status = get_text(lang, 'invite_required')
                status_col = (255, 185, 80)
                return
            cancel_event = threading.Event()
            connect_cancel = cancel_event
            connect_pending = True
            ip, target_port = _split_join_endpoint(ip, join_port, self.PORT)
            status = get_text(lang, 'connecting_to').format(ip=ip, port=target_port)
            status_col = (200, 225, 255)

            def _connect_worker():
                connection = self._do_connect(ip, invite_str, seed, target_port,
                                              cancel_event=cancel_event)
                if cancel_event.is_set():
                    if connection:
                        try: connection.close()
                        except OSError: pass
                    return
                result = (connection, self._pending_map, self._pending_seed)
                try:
                    connect_results.put_nowait(result)
                except _queue_mod.Full:
                    if connection:
                        try: connection.close()
                        except OSError: pass

            threading.Thread(target=_connect_worker, name='SGF-secure-connect', daemon=True).start()

        lang = self.settings.language
        # The join screen is always typing into a field. Naming this local
        # ``*_input_active`` tells the shared keyboard navigator to leave letters
        # (WASD), Space and Enter to the fields instead of treating them as menu
        # navigation, so typed addresses and Enter-to-connect work.
        text_input_active = True
        while True:
            try:
                connection, host_map, host_seed = connect_results.get_nowait()
                connect_pending = False
                if connection and (self._pending_session or {}).get('max_players', 2) > 2:
                    room_result = self._guest_waiting_room(connection, mode, host_map, host_seed)
                    if room_result:
                        return room_result
                    status = _net_ui_text(lang, 'host_left_room')
                    status_col = (255, 185, 80)
                    raise _queue_mod.Empty
                if connection:
                    return (False, connection, mode, host_map, host_seed)
                _shown_host, _shown_port = _split_join_endpoint(ip_str, join_port, self.PORT)
                status = get_text(lang, 'could_not_connect').format(ip=_shown_host, port=_shown_port)
                # Short language-neutral stage code (dns, edge, relay 530, pin,
                # auth, host) so a failed relay join can be diagnosed.
                failure_stage = str(getattr(self, '_last_connect_stage', '') or '')
                if failure_stage and _is_cloudflare_quick_hostname(_shown_host):
                    status = f'{status} [{failure_stage}]'
                status_col = (255, 100, 100)
            except _queue_mod.Empty:
                pass
            sw, sh = self.screen.get_width(), self.screen.get_height()
            self._draw_bg()

            ts = mf.render(get_text(lang, 'join_game_title'), True, COLORS['white'])
            self.screen.blit(ts, (sw // 2 - ts.get_width() // 2, int(sh * 0.09)))

            self._draw_subtitle(lang, 'title_network' if is_relay else 'title_lan',
                                sw, int(sh * 0.15))
            if is_relay:
                field_w = min(520, sw - 32)
                label_surface = sf.render(_net_ui_text(lang, 'link_label'), True, (200, 220, 255))
                self.screen.blit(label_surface, (sw // 2 - field_w // 2, int(sh * 0.24)))
                link_rect = pygame.Rect(sw // 2 - field_w // 2, int(sh * 0.30), field_w, 48)
                pygame.draw.rect(self.screen, (22, 33, 68), link_rect, border_radius=6)
