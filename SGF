    if not _validate_net_map(map_data):
        return None
    normalized = {
        'board_width': int(map_data.get('board_width', 0)),
        'board_height': int(map_data.get('board_height', 0)),
        'obstacles': sorted([list(map(int, p)) for p in map_data.get('obstacles', [])]),
        'portals': sorted([
            list(map(int, p)) for p in map_data.get('portals', [])
            if isinstance(p, (list, tuple)) and len(p) == 5
        ]),
    }
    raw = json.dumps(normalized, ensure_ascii=False, separators=(',', ':'), sort_keys=True)
    return hashlib.sha256(raw.encode('utf-8')).hexdigest()



