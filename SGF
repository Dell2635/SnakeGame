# Color utility functions
def hex_to_rgb(hex_color):
    """
    Convert hexadecimal color string to RGB tuple
    
    Args:
        hex_color (str): Hexadecimal color string (e.g., "#FF0000" or "FF0000")
        
    Returns:
        tuple: RGB color tuple with values 0-255
    """
    # Remove leading # if present
    if hex_color.startswith('#'):
        hex_color = hex_color[1:]
    
    # Convert hex to RGB
    return tuple(int(hex_color[i:i+2], 16) for i in (0, 2, 4))

def rgb_to_hex(rgb_color):
    """
    Convert RGB tuple to hexadecimal color string
    
    Args:
        rgb_color (tuple): RGB color tuple with values 0-255
        
    Returns:
        str: Hexadecimal color string with leading #
    """
    return f"#{rgb_color[0]:02x}{rgb_color[1]:02x}{rgb_color[2]:02x}"

def validate_rgb_color(color):
    """
    Validate and ensure RGB color values are within 0-255 range
    
    Args:
        color (tuple): RGB color tuple
        
    Returns:
        tuple: Validated RGB color tuple with values clamped to 0-255
    """
    return tuple(max(0, min(255, c)) for c in color)

def create_color(color_value):
    """
    Create a color from various formats (hex string, RGB tuple, etc.)
    
    Args:
        color_value: Hexadecimal string, RGB tuple, or color name
        
    Returns:
        tuple: RGB color tuple
    """
    if isinstance(color_value, str):
        if color_value.startswith('#'):
            return hex_to_rgb(color_value)
        elif color_value in COLORS:
            return COLORS[color_value]
        else:
            try:
                return hex_to_rgb(color_value)
            except ValueError:
                return COLORS['white']  # Default to white on error
    elif isinstance(color_value, tuple) and len(color_value) == 3:
        return validate_rgb_color(color_value)
    else:
        return COLORS['white']  # Default to white

