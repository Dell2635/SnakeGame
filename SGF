                    if count_minus.collidepoint(event.pos):
                        player_count = max(1, player_count - 1)
                    elif count_plus.collidepoint(event.pos):
                        player_count = min(4, player_count + 1)
                    elif coop_rect.collidepoint(event.pos):
                        seed = seed_text.strip() or generate_seed()
                        cfgs = _normalize_mp_player_configs(saved_local.get('player_configs', []), player_count)
                        _save_game_settings('multiplayer_local', {
                            'mode': 'coop',
                            'player_count': player_count,
                            'seed_mode': 'custom' if seed_text.strip() else 'random',
                            'seed_value': seed_text.strip(),
                            'player_configs': cfgs,
                        })
                        return ('coop', seed, player_count, cfgs, 'custom' if seed_text.strip() else 'random')
                    elif v1_rect.collidepoint(event.pos):
                        seed = seed_text.strip() or generate_seed()
                        cfgs = _normalize_mp_player_configs(saved_local.get('player_configs', []), player_count)
                        _save_game_settings('multiplayer_local', {
                            'mode': '1v1',
                            'player_count': player_count,
                            'seed_mode': 'custom' if seed_text.strip() else 'random',
                            'seed_value': seed_text.strip(),
                            'player_configs': cfgs,
                        })
                        return ('1v1', seed, player_count, cfgs, 'custom' if seed_text.strip() else 'random')
                    elif net_rect.collidepoint(event.pos):
                        seed = seed_text.strip() or generate_seed()
                        _save_game_settings('multiplayer_lan', {
                            'mode': '1v1',
                            'seed_mode': 'custom' if seed_text.strip() else 'random',
                            'seed_value': seed_text.strip(),
                        })
                        return ('network', seed, 2, None, 'custom' if seed_text.strip() else 'random')
                    elif back_rect.collidepoint(event.pos):
                        return None
                elif event.type == pygame.KEYDOWN:
                    if seed_active:
                        if event.key in (pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_ESCAPE):
                            seed_active = False
                        elif event.key == pygame.K_BACKSPACE:
                            seed_text = seed_text[:-1]
                        elif event.unicode and event.unicode != ' ' and len(seed_text) < 64:
                            seed_text += event.unicode
                    else:
                        if event.key == pygame.K_F11:
                            self.screen = _toggle_fullscreen(self.screen)
                        elif event.key == pygame.K_ESCAPE:
                            return None
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode(
                        (event.w, event.h), pygame.RESIZABLE)


