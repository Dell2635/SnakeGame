                        phase = time.time() * (3.0 if DEV_TOOLS.cheats.get('disco_snake') else 1.2) + i * 0.28
                        colour = (int((math.sin(phase) + 1) * 127), int((math.sin(phase + 2.1) + 1) * 127), int((math.sin(phase + 4.2) + 1) * 127))
                    else:
