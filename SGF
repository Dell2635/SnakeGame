    def draw_screen(self):
        """Draw the high scores screen"""
        # Fill background
        self.screen.fill(COLORS['dark_blue'])
        
        # Draw title
        title_font = get_font(self.settings.language, 'bold', 36)
        title_text = get_text(self.settings.language, 'high_scores')
        title_surface = title_font.render(title_text, True, COLORS['white'])
        self.screen.blit(title_surface, (self.screen.get_width() // 2 - title_surface.get_width() // 2, 50))
        
        # Load and filter high scores
        highscores = self.load_highscores()
        filtered_scores = self.filter_highscores(highscores)
        
        # Draw search box and filter button
        search_rect = self.draw_search_box()
        filter_rect = self.draw_filter_button()
        filter_menu_rects = self.draw_filter_menu(filter_rect)
        
        if not filtered_scores:
            # Draw "No high scores yet" message
            no_scores_font = get_font(self.settings.language, 'regular', 24)
            no_scores_text = get_text(self.settings.language, 'no_highscores')
            no_scores_surface = no_scores_font.render(no_scores_text, True, COLORS['white'])
            self.screen.blit(no_scores_surface, (
                self.screen.get_width() // 2 - no_scores_surface.get_width() // 2, 
                self.screen.get_height() // 2 - no_scores_surface.get_height() // 2
            ))
        else:
            # Initialize detail buttons list for interaction
            # Each entry: (rect, score_data, btn_type)  where btn_type = 'view' | 'delete'
            self.detail_buttons = []

            # Draw table headers
            header_font = get_font(self.settings.language, 'bold', 22)
            headers = [
                get_text(self.settings.language, 'rank'),
                get_text(self.settings.language, 'player_name'),
                get_text(self.settings.language, 'score'),
                get_text(self.settings.language, 'date'),
                get_text(self.settings.language, 'board_size'),
                get_text(self.settings.language, 'speed'),
                "",   # view button column
                "",   # delete button column
            ]

            col_widths = [55, 160, 80, 170, 100, 80, 70, 36]
            total_width = sum(col_widths)
            start_x = (self.screen.get_width() - total_width) // 2

            x = start_x
            for i, header in enumerate(headers):
                if header:
                    hs = header_font.render(header, True, COLORS['white'])
                    self.screen.blit(hs, (x + col_widths[i] // 2 - hs.get_width() // 2, 120))
                x += col_widths[i]

            pygame.draw.line(self.screen, COLORS['white'],
                (start_x, 150), (start_x + total_width, 150), 2)

            score_font = get_font(self.settings.language, 'regular', 18)
            btn_font  = get_font(self.settings.language, 'bold', 14)

            if self.scrollbar:
                self.scrollbar.content_height = len(filtered_scores) * 40 + 100
                self.scrollbar.max_scroll = max(0, self.scrollbar.content_height - self.scrollbar.rect.height)
                self.scrollbar.update()

            start_y = 170
            scroll_offset = self.scrollbar.get_content_offset() if self.scrollbar else 0
            visible_start = max(0, scroll_offset // 40)
            visible_end = min(len(filtered_scores), visible_start + 15)
            y = start_y - (scroll_offset % 40)

            for i, score in enumerate(filtered_scores[visible_start:visible_end], visible_start):
                MEDAL_COLORS = {0: (255, 215, 0), 1: (192, 192, 192), 2: (205, 127, 50)}
                row_bg = MEDAL_COLORS.get(i, None)
                row_rect = pygame.Rect(start_x, y - 4, total_width, 36)
                if row_bg:
                    s = pygame.Surface((total_width, 36), pygame.SRCALPHA)
                    s.fill((*row_bg, 50))
                    self.screen.blit(s, (start_x, y - 4))
                    pygame.draw.rect(self.screen, row_bg, row_rect, width=2, border_radius=4)
                elif i % 2 == 0:
                    s2 = pygame.Surface((total_width, 36), pygame.SRCALPHA)
                    s2.fill((255, 255, 255, 15))
                    self.screen.blit(s2, (start_x, y - 4))

                medal_labels = {0: '#1', 1: '#2', 2: '#3'}
                rank_label = medal_labels.get(i, f'#{i + 1}')

                name_text = score.get('name', '')
                if score.get('victory', False):
                    name_text += ' \u2713'

                speed_display = f"{score.get('update_rate_ms', 200)}ms"
                row_data = [
                    rank_label,
                    name_text,
                    str(score.get('score', 0)),
                    score.get('date', ''),
                    f"{score.get('board_size', '?')}x{score.get('board_size', '?')}",
                    speed_display,
                ]

                txt_color = MEDAL_COLORS.get(i, COLORS['white'])
                x = start_x
                for j, data in enumerate(row_data):
                    ds = score_font.render(data, True, txt_color)
                    if j <= 1:
                        self.screen.blit(ds, (x + 6, y + 1))
                    else:
                        self.screen.blit(ds, (x + col_widths[j] // 2 - ds.get_width() // 2, y + 1))
                    x += col_widths[j]

                # View / Replay button
                has_replay = score.get('has_replay', False)
                view_text  = "Replay" if has_replay else "View"
                view_color = COLORS['light_blue'] if has_replay else COLORS['button']
                vw = col_widths[6] - 4
                vh = 28
                vx = x + 2
                vy = y + (36 - vh) // 2 - 4
                view_rect = pygame.Rect(vx, vy, vw, vh)
                pygame.draw.rect(self.screen, view_color, view_rect, border_radius=4)
                vt = btn_font.render(view_text, True, COLORS['white'])
                self.screen.blit(vt, vt.get_rect(center=view_rect.center))
                self.detail_buttons.append((view_rect, score, 'view'))
                x += col_widths[6]

                # Delete (×) button
                dx = x + 2
                dy = y + (36 - vh) // 2 - 4
                del_rect = pygame.Rect(dx, dy, col_widths[7] - 4, vh)
                pygame.draw.rect(self.screen, (180, 50, 50), del_rect, border_radius=4)
                xt = btn_font.render('\u00d7', True, COLORS['white'])
                self.screen.blit(xt, xt.get_rect(center=del_rect.center))
                self.detail_buttons.append((del_rect, score, 'delete'))

                y += 40

            # Draw delete-confirmation overlay if pending
            if self.confirm_delete is not None:
                ov = pygame.Surface(self.screen.get_size(), pygame.SRCALPHA)
                ov.fill((0, 0, 0, 160))
                self.screen.blit(ov, (0, 0))
                cx, cy = self.screen.get_width() // 2, self.screen.get_height() // 2
                dlg = pygame.Rect(cx - 200, cy - 70, 400, 140)
                pygame.draw.rect(self.screen, (40, 40, 60), dlg, border_radius=10)
                pygame.draw.rect(self.screen, COLORS['red'], dlg, border_radius=10, width=2)
                cf = get_font(self.settings.language, 'bold', 20)
                msg = cf.render("Delete this score entry?", True, COLORS['white'])
                self.screen.blit(msg, msg.get_rect(center=(cx, cy - 30)))
                yes_r = pygame.Rect(cx - 110, cy + 10, 90, 34)
                no_r  = pygame.Rect(cx + 20,  cy + 10, 90, 34)
                pygame.draw.rect(self.screen, (180, 50, 50), yes_r, border_radius=6)
                pygame.draw.rect(self.screen, COLORS['button'], no_r, border_radius=6)
                yt = cf.render("Delete", True, COLORS['white'])
                nt = cf.render("Cancel", True, COLORS['white'])
                self.screen.blit(yt, yt.get_rect(center=yes_r.center))
                self.screen.blit(nt, nt.get_rect(center=no_r.center))
                # Store confirm dialog rects for run() to use
                self._confirm_yes_rect = yes_r
                self._confirm_no_rect  = no_r
                
        # Draw back button
        back_rect = pygame.Rect(50, 50, 100, 40)
        pygame.draw.rect(self.screen, COLORS['button'], back_rect, border_radius=10)
        
        back_font = get_font(self.settings.language, 'bold', 20)
        back_text = get_text(self.settings.language, 'back')
        back_surface = back_font.render(back_text, True, COLORS['white'])
        back_rect_center = back_rect.center
        self.screen.blit(back_surface, (
            back_rect_center[0] - back_surface.get_width() // 2, 
            back_rect_center[1] - back_surface.get_height() // 2
        ))
        
        # Draw scrollbar
        if self.scrollbar:
            self.scrollbar.draw(self.screen)
        
        # Update display
        pygame.display.flip()
        
        return back_rect, search_rect, filter_rect, filter_menu_rects
        
    def delete_score(self, score_data):
        """Permanently delete one high-score entry (including replay data) from the save file."""
        try:
            _gd = _load_data()
            highscores = _gd.get('highscores', [])
            game_id = score_data.get('game_id')
            if game_id:
                highscores = [s for s in highscores if s.get('game_id') != game_id]
            else:
                # Fallback: match by name + score + date
                highscores = [s for s in highscores if not (
                    s.get('name') == score_data.get('name') and
                    s.get('score') == score_data.get('score') and
                    s.get('date') == score_data.get('date')
                )]
            _gd['highscores'] = highscores
            _save_data(_gd)
        except Exception as e:
            print(f"Error deleting score: {e}")

    def view_replay(self, score_data):
        """Load and play back the full replay for a saved high score."""
        game_history = score_data.get('game_history', [])

        # Fall back to score-details screen for old/missing replays
        if not game_history or not isinstance(game_history[0], list):
            self.show_details(score_data)
            return

        # Recreate the original game settings so board size, speed, etc. match
        temp_settings = copy.deepcopy(self.settings)
        if 'settings' in score_data:
            for key, value in score_data['settings'].items():
                if hasattr(temp_settings, key):
                    setattr(temp_settings, key, value)
        # Also apply top-level convenience fields
        if 'update_rate_ms' in score_data:
            temp_settings.update_rate_ms = score_data['update_rate_ms']

        game = SnakeGame(temp_settings, self.screen)
        game.player_name = score_data.get('name', '')
        game.start_replay(game_history)
        game.run()
        
    def show_details(self, score_data):
        """Show detailed settings for a high score"""
        # Display a window with detailed information about the high score
        running = True
        
        while running:
            # Fill background
            self.screen.fill(COLORS['dark_blue'])
            
            # Draw title
            font = get_font(self.settings.language, 'bold', 32)
            title_text = f"{get_text(self.settings.language, 'score_details')}: {score_data['name']}"
            title_surface = font.render(title_text, True, COLORS['white'])
            self.screen.blit(title_surface, (self.screen.get_width() // 2 - title_surface.get_width() // 2, 50))
            
            # Draw score details
            details_font = get_font(self.settings.language, 'regular', 22)
            detail_y = 120
            detail_spacing = 30
            left_margin = self.screen.get_width() // 4
            
            # Basic info
            details = [
                (f"{get_text(self.settings.language, 'score')}: {score_data['score']}", COLORS['white']),
                (f"{get_text(self.settings.language, 'date')}: {score_data['date']}", COLORS['white']),
                (f"{get_text(self.settings.language, 'board_size')}: {score_data['board_size']}x{score_data['board_size']}", COLORS['white']),
                (f"{get_text(self.settings.language, 'speed')}: {score_data.get('update_rate_ms', 200)}ms", COLORS['white']),
                ("", COLORS['white']),  # Spacing
            ]
            
            # Game settings
            if 'settings' in score_data:
                settings_data = score_data['settings']
                # Add header for settings
                details.append((f"{get_text(self.settings.language, 'settings')}:", COLORS['light_blue']))
                
                # Display the settings in a readable format
                for key, value in settings_data.items():
                    # Skip complex objects and None values
                    if isinstance(value, (int, float, str, bool)) and value is not None:
                        # Format the key for better readability
                        formatted_key = key.replace('_', ' ').title()
                        details.append((f"{formatted_key}: {value}", COLORS['white']))
            
            # Draw each detail
            for detail, color in details:
                if detail:  # Skip empty strings (used for spacing)
                    detail_surface = details_font.render(detail, True, color)
                    self.screen.blit(detail_surface, (left_margin, detail_y))
                detail_y += detail_spacing
            
            # Draw back button
            back_rect = pygame.Rect(50, 50, 100, 40)
            pygame.draw.rect(self.screen, COLORS['button'], back_rect, border_radius=10)
            
            back_font = get_font(self.settings.language, 'bold', 20)
            back_text = get_text(self.settings.language, 'back')
            back_surface = back_font.render(back_text, True, COLORS['white'])
            self.screen.blit(back_surface, (back_rect.centerx - back_surface.get_width() // 2, 
                                           back_rect.centery - back_surface.get_height() // 2))
            
            # Update display
            pygame.display.flip()
            
            # Handle events
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                    
                elif event.type == pygame.MOUSEBUTTONDOWN:
                    if back_rect.collidepoint(event.pos):
                        running = False
                        
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif event.key == pygame.K_ESCAPE:
                        running = False
            
            # Cap frame rate
            pygame.time.Clock().tick(60)
    
    def run(self):
        """Run the high scores screen with scroll support"""
        running = True
        if self.scrollbar is None:
            self.init_scrollbar()

        while running:
            back_rect, search_rect, filter_rect, filter_menu_rects = self.draw_screen()

            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False

                if self.scrollbar:
                    self.scrollbar.handle_event(event)

                if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    mouse_pos = event.pos

                    # ── Delete confirmation dialog (highest priority) ─────────
                    if self.confirm_delete is not None:
                        yes_r = getattr(self, '_confirm_yes_rect', None)
                        no_r  = getattr(self, '_confirm_no_rect',  None)
                        if yes_r and yes_r.collidepoint(mouse_pos):
                            self.delete_score(self.confirm_delete)
                            self.confirm_delete = None
                        elif no_r and no_r.collidepoint(mouse_pos):
                            self.confirm_delete = None
                        continue  # eat click while dialog is open

                    # ── Primary navigation targets ───────────────────────────
                    primary_handled = False

                    if back_rect.collidepoint(mouse_pos):
                        running = False
                        primary_handled = True
                    elif search_rect.collidepoint(mouse_pos):
                        self.search_active = True
                        self.filter_menu_open = False
                        primary_handled = True
                    elif filter_rect.collidepoint(mouse_pos):
                        self.filter_menu_open = not self.filter_menu_open
                        self.search_active = False
                        primary_handled = True

                    if primary_handled:
                        continue

                    # ── Filter menu items ────────────────────────────────────
                    if self.filter_menu_open:
                        menu_clicked = False
                        for rect, action in filter_menu_rects:
                            if rect.collidepoint(mouse_pos):
                                menu_clicked = True
                                if action == "close_filter":
                                    self.filter_menu_open = False
                                elif action == "reset_filters":
                                    self.filter_options = {
                                        "sort_by": "score",
                                        "order": "desc",
                                        "show_victories": "all",
                                        "difficulty": "all",
                                        "has_replay": "all",
                                        "obstacles": "all",
                                        "powerups": "all",
                                    }
                                elif ':' in action:
                                    key, val = action.split(':', 1)
                                    self.filter_options[key] = val
                                break
                        if not menu_clicked:
                            self.filter_menu_open = False
                        continue

                    # ── Row buttons (View / Delete) ──────────────────────────
                    row_handled = False
                    for btn_rect, score_data, btn_type in self.detail_buttons:
                        if btn_rect.collidepoint(mouse_pos):
                            row_handled = True
                            if btn_type == 'delete':
                                self.confirm_delete = score_data
                            elif score_data.get('has_replay', False):
                                self.view_replay(score_data)
                            else:
                                self.show_details(score_data)
                            break

                    # ── Clicking elsewhere deactivates search ────────────────
                    if not row_handled:
                        self.search_active = False

                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif event.key == pygame.K_ESCAPE:
                        if self.confirm_delete is not None:
                            self.confirm_delete = None
                        elif self.filter_menu_open:
                            self.filter_menu_open = False
                        elif self.search_active:
                            self.search_active = False
                        else:
                            running = False
                    elif self.search_active:
                        if event.key == pygame.K_RETURN:
                            self.search_active = False
                        elif event.key == pygame.K_BACKSPACE:
                            self.search_text = self.search_text[:-1]
                        elif event.unicode.isprintable():
                            self.search_text += event.unicode

                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    self.init_scrollbar()

            # Update scrollbar
            if self.scrollbar:
                self.scrollbar.update()
            
            # Cap the frame rate
            pygame.time.Clock().tick(60)

