def create_trophy_icon(surface, rect, color=(255, 215, 0)):  # Gold color by default
    """
    Draw a trophy icon
    
    Args:
        surface (pygame.Surface): Surface to draw on
        rect (pygame.Rect): Rectangle defining the icon boundaries
        color (tuple): RGB color tuple
    """
    # Draw trophy cup
    cup_top = rect.y
    cup_bottom = rect.y + rect.height * 0.6
    cup_width = rect.width * 0.6
    
    # Draw trophy body
    cup_rect = pygame.Rect(
        rect.x + (rect.width - cup_width) // 2,
        cup_top,
        cup_width,
        cup_bottom - cup_top
    )
    pygame.draw.rect(surface, color, cup_rect, border_radius=int(cup_width * 0.2))
    
    # Draw handles
    handle_width = rect.width * 0.2
    left_handle = pygame.Rect(
        rect.x,
        rect.y + rect.height * 0.2,
        handle_width,
        rect.height * 0.2
    )
    pygame.draw.ellipse(surface, color, left_handle)
    
    right_handle = pygame.Rect(
        rect.x + rect.width - handle_width,
        rect.y + rect.height * 0.2,
        handle_width,
        rect.height * 0.2
    )
    pygame.draw.ellipse(surface, color, right_handle)
    
    # Draw base
    base_top = cup_bottom
    base_width = cup_width * 0.6
    base_rect = pygame.Rect(
        rect.x + (rect.width - base_width) // 2,
        base_top,
        base_width,
        rect.height * 0.1
    )
    pygame.draw.rect(surface, color, base_rect)
    
    # Draw stand
    stand_width = base_width * 0.2
    stand_rect = pygame.Rect(
        rect.x + (rect.width - stand_width) // 2,
        base_top + rect.height * 0.1,
        stand_width,
        rect.height * 0.3
    )
    pygame.draw.rect(surface, color, stand_rect)
    
    # Draw base plate
    base_plate_width = base_width * 1.2
    base_plate_rect = pygame.Rect(
        rect.x + (rect.width - base_plate_width) // 2,
        rect.y + rect.height - rect.height * 0.1,
        base_plate_width,
        rect.height * 0.1
    )
    pygame.draw.rect(surface, color, base_plate_rect, border_radius=int(base_plate_width * 0.1))

def create_snake_icon(surface, rect, color=(50, 205, 50)):
    """
    Draw a simple snake icon
    
    Args:
        surface (pygame.Surface): Surface to draw on
        rect (pygame.Rect): Rectangle defining the icon boundaries
        color (tuple): RGB color tuple
    """
    # Snake body segments
    segment_size = min(rect.width, rect.height) // 5
    positions = [
        (rect.x + rect.width - segment_size, rect.y + rect.height // 2),
        (rect.x + rect.width - segment_size * 2, rect.y + rect.height // 2),
        (rect.x + rect.width - segment_size * 3, rect.y + rect.height // 2),
        (rect.x + rect.width - segment_size * 3, rect.y + rect.height // 2 - segment_size),
        (rect.x + rect.width - segment_size * 4, rect.y + rect.height // 2 - segment_size),
        (rect.x + rect.width - segment_size * 4, rect.y + rect.height // 2),
        (rect.x + rect.width - segment_size * 4, rect.y + rect.height // 2 + segment_size),
    ]
    
    # Draw body segments
    for pos in positions[1:]:
        border_radius = max(0, min(segment_size // 4, 10))  # Ensure valid border radius
        pygame.draw.rect(surface, color, 
            (pos[0], pos[1], segment_size, segment_size), border_radius=border_radius)
    
    # Draw head (first segment, slightly larger)
    head_color = (max(0, color[0] - 30), max(0, color[1] - 30), max(0, color[2] - 30))  # Darker than body, prevent negative
    head_pos = positions[0]
    border_radius = max(0, min(segment_size // 4, 10))  # Ensure valid border radius
    pygame.draw.rect(surface, head_color, 
        (head_pos[0], head_pos[1], segment_size, segment_size), border_radius=border_radius)
    
    # Draw eyes
    eye_size = segment_size // 5
    pygame.draw.circle(surface, (255, 255, 255), 
        (head_pos[0] + segment_size * 3 // 4, head_pos[1] + segment_size // 3), eye_size)
    pygame.draw.circle(surface, (255, 255, 255), 
        (head_pos[0] + segment_size * 3 // 4, head_pos[1] + segment_size * 2 // 3), eye_size)

