class HighScoresScreen:
    def __init__(self, settings, screen):
        self.settings = settings
        self.screen = screen
        
        # Initialize scroll bar for high scores list
        self.scrollbar = None
        self.detail_buttons = []  # populated each frame in draw_screen
        self.init_scrollbar()
        
    def init_scrollbar(self):
        """Initialize the scroll bar for high scores"""
        scores = self.load_highscores()
        content_height = len(scores) * 70 + 100  # Each score entry + padding
        screen_height = self.screen.get_height() - 200  # Account for header/footer
        
        self.scrollbar = ScrollBar(
            self.screen.get_width() - 30,  # Right side
            150,  # Below header
            20,   # Width
            screen_height,
            content_height
        )
        self.search_text = ""
        self.search_active = False
        self.filter_options = {
            "sort_by": "score",        # score, date, board_size, speed
            "order": "desc",           # asc, desc
            "show_victories": "all",   # all, victory_only, no_victory
            "difficulty": "all",       # all, easy (>=200ms), medium (100-199ms), hard (<100ms)
            "has_replay": "all",       # all, with_replay, no_replay
            "obstacles": "all",        # all, with_obstacles, no_obstacles
            "powerups": "all",         # all, with_powerups, no_powerups
        }
        self.filter_menu_open = False
        self.confirm_delete = None  # score_data pending delete confirmation
        
    def load_highscores(self):
        """Load high scores from unified data file"""
        try:
            _gd = _load_data()
            hs = _gd.get('highscores', [])
            return hs if isinstance(hs, list) else []
        except Exception as e:
            print(f"Error loading high scores: {e}")
            return []
    
    def filter_highscores(self, highscores):
        """Filter and sort highscores based on current filter settings and search text"""
        # Apply search filter (name, score, date, board size, game mode keywords)
        if self.search_text:
            search_lower = self.search_text.lower()
            filtered_scores = [
                score for score in highscores
                if search_lower in score.get('name', '').lower()
                or search_lower in str(score.get('score', ''))
                or search_lower in score.get('date', '').lower()
                or search_lower in f"{score.get('board_size', '')}x{score.get('board_size', '')}".lower()
                or search_lower in score.get('game_mode', 'single_player').lower().replace('_', ' ')
            ]
        else:
            filtered_scores = highscores.copy()

        # Victory filter
        sv = self.filter_options.get("show_victories", "all")
        if sv == "victory_only":
            filtered_scores = [s for s in filtered_scores if s.get('victory', False)]
        elif sv == "no_victory":
            filtered_scores = [s for s in filtered_scores if not s.get('victory', False)]

        # Difficulty filter (based on update_rate_ms — lower = faster = harder)
        diff = self.filter_options.get("difficulty", "all")
        if diff == "easy":
            filtered_scores = [s for s in filtered_scores if s.get('update_rate_ms', 200) >= 200]
        elif diff == "medium":
            filtered_scores = [s for s in filtered_scores if 100 <= s.get('update_rate_ms', 200) < 200]
        elif diff == "hard":
            filtered_scores = [s for s in filtered_scores if s.get('update_rate_ms', 200) < 100]

        # Replay filter
        rep = self.filter_options.get("has_replay", "all")
        if rep == "with_replay":
            filtered_scores = [s for s in filtered_scores if s.get('has_replay', False)]
        elif rep == "no_replay":
            filtered_scores = [s for s in filtered_scores if not s.get('has_replay', False)]

        # Obstacles filter
        obs = self.filter_options.get("obstacles", "all")
        if obs == "with_obstacles":
            filtered_scores = [s for s in filtered_scores if s.get('obstacles_enabled', False)]
        elif obs == "no_obstacles":
            filtered_scores = [s for s in filtered_scores if not s.get('obstacles_enabled', False)]

        # Powerups filter
        pwrups = self.filter_options.get("powerups", "all")
        if pwrups == "with_powerups":
            filtered_scores = [s for s in filtered_scores if s.get('powerups_enabled', True)]
        elif pwrups == "no_powerups":
            filtered_scores = [s for s in filtered_scores if not s.get('powerups_enabled', True)]

        # Sorting
        sort_key = self.filter_options.get("sort_by", "score")
        desc = (self.filter_options.get("order", "desc") == "desc")
        if sort_key == "score":
            filtered_scores.sort(key=lambda x: x.get('score', 0), reverse=desc)
        elif sort_key == "date":
            filtered_scores.sort(key=lambda x: x.get('date', ''), reverse=desc)
        elif sort_key == "board_size":
            filtered_scores.sort(key=lambda x: x.get('board_size', 0), reverse=desc)
        elif sort_key == "speed":
            # Lower update_rate_ms = faster; sort ascending for "fastest first" when desc=True
            filtered_scores.sort(key=lambda x: x.get('update_rate_ms', 200), reverse=not desc)

        return filtered_scores
    
    def draw_search_box(self):
        """Draw search input box and return its rect"""
        font = get_font(self.settings.language, 'regular', 20)
        
        # Position the search box at the top right
        search_width = 250
        search_height = 30
        search_x = self.screen.get_width() - search_width - 50
        search_y = 60
        
        search_rect = pygame.Rect(search_x, search_y, search_width, search_height)
        color = COLORS['light_gray'] if self.search_active else COLORS['gray']
        pygame.draw.rect(self.screen, color, search_rect, border_radius=5)
        
        # Draw search icon
        icon_size = 20
        icon_rect = pygame.Rect(search_x + 5, search_y + (search_height - icon_size) // 2, icon_size, icon_size)
        pygame.draw.rect(self.screen, COLORS['dark_gray'], icon_rect, border_radius=10, width=2)
