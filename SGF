                profile_rect = pygame.Rect(grid_x, row_y, content_width - 18, max(26, int(btn_h * 0.8)))
                row_y += profile_rect.height + 4
                status_rect = pygame.Rect(grid_x, row_y, content_width - 18, max(20, int(btn_h * 0.6)))
