def _load_encyclopedia_progress():
    try:
        gd = _load_data()
        return gd.get('encyclopedia_progress', {})
    except Exception:
        return {}


def _flush_encyclopedia_updates(updates):
    """Merge a dict of {entry_id: {'encountered': n, 'used': n}} increments
    into the persisted encyclopedia progress, unlocking each touched entry.
    Call this once at natural checkpoints (end of a match) rather than on
    every single in-game event, to avoid excessive disk I/O."""
    if not updates:
        return

    def _mutate(gd):
        progress = gd.get('encyclopedia_progress', {})
        for entry_id, deltas in updates.items():
            entry = progress.get(entry_id, {'encountered': 0, 'used': 0, 'unlocked': False})
            entry['encountered'] = entry.get('encountered', 0) + deltas.get('encountered', 0)
            entry['used'] = entry.get('used', 0) + deltas.get('used', 0)
            entry['unlocked'] = True
            progress[entry_id] = entry
        gd['encyclopedia_progress'] = progress
        return gd

    try:
        _save_data_async(_mutate)
    except Exception as e:
        print(f"Error saving encyclopedia progress: {e}")



def _pick_cosmetic_fruit_type(fruit_types_enabled, rng=None):
    if not fruit_types_enabled:
        return 'regular'
    weights = [0.4] + [0.6 / (len(_COSMETIC_FRUIT_TYPES) - 1)] * (len(_COSMETIC_FRUIT_TYPES) - 1)
    picker = rng if rng is not None else random
    return picker.choices(_COSMETIC_FRUIT_TYPES, weights=weights)[0]

