def create_pause_icon(surface, rect, color=(255, 255, 255)):
    """
    Draw a pause icon (two vertical bars)
    
    Args:
        surface (pygame.Surface): Surface to draw on
        rect (pygame.Rect): Rectangle defining the icon boundaries
        color (tuple): RGB color tuple
    """
    bar_width = rect.width // 3
    pygame.draw.rect(surface, color, 
        (rect.x + rect.width // 4 - bar_width // 2, rect.y, bar_width, rect.height))
    pygame.draw.rect(surface, color, 
        (rect.x + 3 * rect.width // 4 - bar_width // 2, rect.y, bar_width, rect.height))

def create_play_icon(surface, rect, color=(255, 255, 255)):
    """
    Draw a play icon (triangle pointing right)
    
    Args:
        surface (pygame.Surface): Surface to draw on
        rect (pygame.Rect): Rectangle defining the icon boundaries
        color (tuple): RGB color tuple
    """
    points = [
        (rect.x, rect.y),
        (rect.x, rect.y + rect.height),
        (rect.x + rect.width, rect.y + rect.height // 2)
    ]
    pygame.draw.polygon(surface, color, points)

def create_settings_icon(surface, rect, color=(255, 255, 255)):
    """
    Draw a settings icon (gear)
    
    Args:
        surface (pygame.Surface): Surface to draw on
        rect (pygame.Rect): Rectangle defining the icon boundaries
        color (tuple): RGB color tuple
    """
    # Draw outer circle
    center_x = rect.x + rect.width // 2
    center_y = rect.y + rect.height // 2
    outer_radius = min(rect.width, rect.height) // 2
    inner_radius = outer_radius // 2
    
    # Draw outer circle
    pygame.draw.circle(surface, color, (center_x, center_y), outer_radius, 2)
    
    # Draw inner circle
    pygame.draw.circle(surface, color, (center_x, center_y), inner_radius)
    
    # Draw "teeth" of the gear
    for i in range(8):
        angle = i * 45  # 8 teeth around the circle, evenly spaced
        x1 = center_x + int(outer_radius * 0.8 * pygame.math.Vector2(1, 0).rotate(angle).x)
        y1 = center_y + int(outer_radius * 0.8 * pygame.math.Vector2(1, 0).rotate(angle).y)
        x2 = center_x + int(outer_radius * 1.2 * pygame.math.Vector2(1, 0).rotate(angle).x)
        y2 = center_y + int(outer_radius * 1.2 * pygame.math.Vector2(1, 0).rotate(angle).y)
        pygame.draw.line(surface, color, (x1, y1), (x2, y2), 3)

def create_home_icon(surface, rect, color=(255, 255, 255)):
    """
    Draw a home icon (house shape)
    
    Args:
        surface (pygame.Surface): Surface to draw on
        rect (pygame.Rect): Rectangle defining the icon boundaries
        color (tuple): RGB color tuple
    """
    # Draw roof (triangle)
    roof_points = [
        (rect.x, rect.y + rect.height // 2),
        (rect.x + rect.width // 2, rect.y),
        (rect.x + rect.width, rect.y + rect.height // 2)
    ]
    pygame.draw.polygon(surface, color, roof_points)
    
    # Draw house body (rectangle)
    house_rect = pygame.Rect(
        rect.x + rect.width // 4,
        rect.y + rect.height // 2,
        rect.width // 2,
        rect.height // 2
    )
    pygame.draw.rect(surface, color, house_rect)

def create_trophy_icon(surface, rect, color=(255, 215, 0)):  # Gold color by default
    """
    Draw a trophy icon
    
    Args:
        surface (pygame.Surface): Surface to draw on
        rect (pygame.Rect): Rectangle defining the icon boundaries
        color (tuple): RGB color tuple
    """
    # Draw trophy cup
    cup_top = rect.y
    cup_bottom = rect.y + rect.height * 0.6
    cup_width = rect.width * 0.6
    
    # Draw trophy body
    cup_rect = pygame.Rect(
        rect.x + (rect.width - cup_width) // 2,
        cup_top,
        cup_width,
        cup_bottom - cup_top
    )
    pygame.draw.rect(surface, color, cup_rect, border_radius=int(cup_width * 0.2))
    
    # Draw handles
    handle_width = rect.width * 0.2
    left_handle = pygame.Rect(
        rect.x,
        rect.y + rect.height * 0.2,
        handle_width,
        rect.height * 0.2
    )
    pygame.draw.ellipse(surface, color, left_handle)
    
    right_handle = pygame.Rect(
        rect.x + rect.width - handle_width,
        rect.y + rect.height * 0.2,
        handle_width,
        rect.height * 0.2
    )
    pygame.draw.ellipse(surface, color, right_handle)
    
    # Draw base
    base_top = cup_bottom
    base_width = cup_width * 0.6
    base_rect = pygame.Rect(
        rect.x + (rect.width - base_width) // 2,
        base_top,
        base_width,
        rect.height * 0.1
    )
    pygame.draw.rect(surface, color, base_rect)
    
    # Draw stand
    stand_width = base_width * 0.2
    stand_rect = pygame.Rect(
        rect.x + (rect.width - stand_width) // 2,
        base_top + rect.height * 0.1,
        stand_width,
        rect.height * 0.3
    )
    pygame.draw.rect(surface, color, stand_rect)
    
    # Draw base plate
    base_plate_width = base_width * 1.2
    base_plate_rect = pygame.Rect(
        rect.x + (rect.width - base_plate_width) // 2,
        rect.y + rect.height - rect.height * 0.1,
        base_plate_width,
        rect.height * 0.1
    )
    pygame.draw.rect(surface, color, base_plate_rect, border_radius=int(base_plate_width * 0.1))

def create_snake_icon(surface, rect, color=(50, 205, 50)):
    """
    Draw a simple snake icon
    
    Args:
        surface (pygame.Surface): Surface to draw on
        rect (pygame.Rect): Rectangle defining the icon boundaries
        color (tuple): RGB color tuple
    """
    # Snake body segments
    segment_size = min(rect.width, rect.height) // 5
    positions = [
        (rect.x + rect.width - segment_size, rect.y + rect.height // 2),
        (rect.x + rect.width - segment_size * 2, rect.y + rect.height // 2),
        (rect.x + rect.width - segment_size * 3, rect.y + rect.height // 2),
        (rect.x + rect.width - segment_size * 3, rect.y + rect.height // 2 - segment_size),
        (rect.x + rect.width - segment_size * 4, rect.y + rect.height // 2 - segment_size),
        (rect.x + rect.width - segment_size * 4, rect.y + rect.height // 2),
        (rect.x + rect.width - segment_size * 4, rect.y + rect.height // 2 + segment_size),
    ]
    
    # Draw body segments
    for pos in positions[1:]:
        border_radius = max(0, min(segment_size // 4, 10))  # Ensure valid border radius
        pygame.draw.rect(surface, color, 
            (pos[0], pos[1], segment_size, segment_size), border_radius=border_radius)
    
    # Draw head (first segment, slightly larger)
    head_color = (max(0, color[0] - 30), max(0, color[1] - 30), max(0, color[2] - 30))  # Darker than body, prevent negative
    head_pos = positions[0]
    border_radius = max(0, min(segment_size // 4, 10))  # Ensure valid border radius
    pygame.draw.rect(surface, head_color, 
        (head_pos[0], head_pos[1], segment_size, segment_size), border_radius=border_radius)
    
    # Draw eyes
    eye_size = segment_size // 5
    pygame.draw.circle(surface, (255, 255, 255), 
        (head_pos[0] + segment_size * 3 // 4, head_pos[1] + segment_size // 3), eye_size)
    pygame.draw.circle(surface, (255, 255, 255), 
        (head_pos[0] + segment_size * 3 // 4, head_pos[1] + segment_size * 2 // 3), eye_size)

def create_fruit_icon(surface, rect, color=(255, 50, 50)):
    """
    Draw a simple fruit icon (apple)
    
    Args:
        surface (pygame.Surface): Surface to draw on
        rect (pygame.Rect): Rectangle defining the icon boundaries
        color (tuple): RGB color tuple
    """
    # Draw apple body (circle)
    center_x = rect.x + rect.width // 2
    center_y = rect.y + rect.height // 2 + rect.height // 10
    radius = min(rect.width, rect.height) // 2 - rect.height // 10
    
    pygame.draw.circle(surface, color, (center_x, center_y), radius)
    
    # Draw stem
    stem_color = (100, 70, 0)  # Brown
    stem_width = radius // 3
    stem_height = radius // 2
    pygame.draw.rect(surface, stem_color, 
        (center_x - stem_width // 2, rect.y + rect.height // 10, stem_width, stem_height))
    
    # Draw leaf
    leaf_color = (30, 180, 30)  # Green
    leaf_points = [
        (center_x, rect.y + rect.height // 10 + stem_height // 2),
        (center_x + radius // 2, rect.y + rect.height // 10),
        (center_x + radius, rect.y + rect.height // 10 + stem_height // 2)
    ]
    pygame.draw.polygon(surface, leaf_color, leaf_points)

