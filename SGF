}


def _t_or(language, key, default):
    """get_text() that falls back to `default` (the current literal) when a key
    has not been added to the translation tables yet. Lets a screen become
    translatable later without another code change and never emits '[Missing: ..]'."""
    en = TRANSLATIONS.get('en', {})
    if key in en:
        return get_text(language, key)
    return default


def _ui_insets(p):
    """int | (h, v) | (l, t, r, b)  ->  (l, t, r, b)"""
    if p is None:
        return (0, 0, 0, 0)
    if isinstance(p, (int, float)):
        p = int(p)
        return (p, p, p, p)
    if len(p) == 2:
        return (int(p[0]), int(p[1]), int(p[0]), int(p[1]))
    return tuple(int(v) for v in p)


def _ui_clamp(v, lo, hi):
    return lo if v < lo else hi if v > hi else v


# ── UI text cache ─────────────────────────────────────────────────────────
# Rendering text (and shrinking it with render_fit) every frame is the main
# recurring UI cost. Rendered surfaces are cached by (language, style, size,
# text, colour, max width). The cache is bounded and evicts its least-recently
# used surface when it grows too large or when the language/font set changes.
_ui_text_cache = {}
_UI_TEXT_CACHE_MAX = 900


def ui_text_clear_cache():
    _ui_text_cache.clear()


def ui_text_surface(language, style, size, text, color, max_w=None):
    """Cached text surface. If `max_w` is given the text is shrunk with the
    existing render_fit() helper (no second fitting implementation)."""
    key = (language, style, size, text, tuple(color[:3]), max_w)
    surf, cached = _lru_cache_get(_ui_text_cache, key)
    if not cached:
        font = get_font(language, style, size)
        if max_w is None:
            surf = font.render(text, True, color)
        else:
            surf = render_fit(font, text, color, max_w, padding=0)
        _lru_cache_put(_ui_text_cache, key, surf, _UI_TEXT_CACHE_MAX)
    return surf


def ui_text_size(language, style, size, text):
    return get_font(language, style, size).size(text)


def ui_wrap_text(language, style, size, text, max_w):
    """Word-wrap using the existing _wrap_text(); additionally hard-breaks any
    line that is still too wide (CJK / Thai text has no spaces to break on)."""
    font = get_font(language, style, size)
    out = []
    for para in str(text).split('\n'):
        lines = _wrap_text(para, font, max(10, max_w)) or ['']
        for line in lines:
            if font.size(line)[0] <= max_w:
                out.append(line)
                continue
            cur = ''
            for ch in line:
                if cur and font.size(cur + ch)[0] > max_w:
                    out.append(cur)
                    cur = ch
                else:
                    cur += ch
            out.append(cur)
    return out or ['']


# ── Semantic input actions ────────────────────────────────────────────────
UI_ACTION_NAMES = (
    'CONFIRM', 'BACK', 'PLAY', 'OPEN_SETTINGS', 'EXIT_GAME', 'PAUSE', 'RESTART',
    'TOGGLE_FULLSCREEN', 'MOVE_UP', 'MOVE_DOWN', 'MOVE_LEFT', 'MOVE_RIGHT',
    # UI-navigation actions (not gameplay actions, but rebindable the same way)
    'FOCUS_NEXT', 'FOCUS_PREV', 'PAGE_UP', 'PAGE_DOWN', 'HOME', 'END', 'DELETE', 'PREVIOUS',
)


class UIInputAdapter:
    """Translates raw pygame KEYDOWN events into semantic action names.

    Integration point for the Action Mapping system: call
    `UI_INPUT.bind_backend(obj)` where `obj` provides EITHER
        actions_for(event) -> iterable[str]      (preferred)
    OR  matches(action_name, event) -> bool
    When a backend is bound it is authoritative for every name in
    UI_ACTION_NAMES it knows; the built-in table is only a fallback so the UI
    keeps working stand-alone. Screens never test pygame.K_* directly.
    """
    _SHIFT, _CTRL, _ALT = pygame.KMOD_SHIFT, pygame.KMOD_CTRL, pygame.KMOD_ALT

    def __init__(self):
        self._backend = None
        self.reset_defaults()

    def reset_defaults(self):
        K = pygame
        self.bindings = {
            'CONFIRM': [(K.K_RETURN, 0), (K.K_KP_ENTER, 0), (K.K_SPACE, 0)],
            'BACK': [(K.K_ESCAPE, 0)],
            'PLAY': [],
            'OPEN_SETTINGS': [],
            'EXIT_GAME': [(K.K_q, self._CTRL)],
            'PAUSE': [(K.K_p, 0)],
            'RESTART': [(K.K_r, 0)],
            'TOGGLE_FULLSCREEN': [(K.K_F11, 0)],
            'MOVE_UP': [(K.K_UP, 0)],
            'MOVE_DOWN': [(K.K_DOWN, 0)],
            'MOVE_LEFT': [(K.K_LEFT, 0)],
            'MOVE_RIGHT': [(K.K_RIGHT, 0)],
            'FOCUS_NEXT': [(K.K_TAB, 0)],
            'FOCUS_PREV': [(K.K_TAB, self._SHIFT)],
            'PAGE_UP': [(K.K_PAGEUP, 0)],
            'PAGE_DOWN': [(K.K_PAGEDOWN, 0)],
            'HOME': [(K.K_HOME, 0)],
            'END': [(K.K_END, 0)],
            'DELETE': [(K.K_DELETE, 0)],
            # Conventional back-one-step shortcut; visible Previous buttons are
            # still preferred wherever a nested flow exposes them.
            'PREVIOUS': [(K.K_LEFT, self._ALT)],
        }

    def bind_backend(self, backend):
        self._backend = backend

    def set_binding(self, action, keys):
        """keys: iterable of (pygame key, modifier-mask)."""
        self.bindings[action] = list(keys)

    def _mods(self, event):
        m = getattr(event, 'mod', 0)
        out = 0
        if m & self._SHIFT:
            out |= self._SHIFT
        if m & self._CTRL:
            out |= self._CTRL
        if m & self._ALT:
            out |= self._ALT
        return out

    def actions_for(self, event):
        if event.type != pygame.KEYDOWN:
            return []
        be = self._backend
        if be is not None:
            try:
                if hasattr(be, 'actions_for'):
                    got = [a for a in be.actions_for(event) if a in UI_ACTION_NAMES]
                    if got:
                        return got
                elif hasattr(be, 'matches'):
                    got = [a for a in UI_ACTION_NAMES if be.matches(a, event)]
                    if got:
                        return got
            except Exception as exc:      # a broken backend must never break the UI
                print(f"UI input backend error: {exc}")
        mods = self._mods(event)
        key = event.key
        return [a for a, keys in self.bindings.items()
                if any(k == key and m == mods for k, m in keys)]

    def matches(self, action, event):
        return action in self.actions_for(event)


UI_INPUT = UIInputAdapter()


# ── Layout: vertical flow ─────────────────────────────────────────────────
class UIFlowItem:
    __slots__ = ('key', 'h', 'min_h', 'max_h', 'w', 'min_w', 'max_w', 'gap',
                 'min_gap', 'flex', 'align')

    def __init__(self, key, h=0, min_h=None, max_h=None, w=None, min_w=None,
                 max_w=None, gap=None, min_gap=None, flex=0, align=None):
        self.key, self.h = key, int(h)
        self.min_h = int(h if min_h is None else min(min_h, h))
        self.max_h = max_h
        self.w, self.min_w, self.max_w = w, min_w, max_w
        self.gap, self.min_gap = gap, min_gap
        self.flex, self.align = flex, align


class UIFlowResult:
    """Outcome of a flow solve. `rects` are in absolute coordinates for scroll
    offset 0 (a ScrollView shifts them). mode: fit | compress | scroll | overflow."""

    def __init__(self, rects, content_height, mode, t, overflow, inner):
        self.rects, self.content_height = rects, content_height
        self.mode, self.t, self.overflow, self.inner = mode, t, overflow, inner

    def __getitem__(self, key):
        return self.rects[key]

    def get(self, key, default=None):
        return self.rects.get(key, default)

    @property
    def scrollable(self):
        return self.mode == 'scroll'


def _validate_ui_layout(rects, viewport, *, focus_order=(), required_focus=(),
                        text_metrics=None, content_height=None, scrollable=False,
                        scroll_offset=0, allowed_overlaps=()):
    """Return structural UI layout issues for headless and DEV regressions.

    `rects` maps control names to viewport-relative pygame.Rect values.
    Text metrics map names to `(rendered_width, available_width)` pairs.
    Intentional overlays can be excluded with `(name_a, name_b)` pairs.
    """
    viewport = pygame.Rect(viewport)
    rects = {str(key): pygame.Rect(value) for key, value in (rects or {}).items()}
    issues = []
    for key, rect in rects.items():
        if rect.width <= 0 or rect.height <= 0:
            issues.append({'code': 'invalid_rect', 'element': key})
        if (rect.left < viewport.left or rect.top < viewport.top
                or rect.right > viewport.right or rect.bottom > viewport.bottom):
            issues.append({'code': 'off_screen', 'element': key})

    allowed = {frozenset(pair) for pair in allowed_overlaps}
    names = list(rects)
    for i, first in enumerate(names):
        for second in names[i + 1:]:
            if (frozenset((first, second)) not in allowed
                    and rects[first].colliderect(rects[second])):
                issues.append({'code': 'overlap', 'elements': (first, second)})

    focused = {str(item) for item in focus_order}
    for key in required_focus:
        key = str(key)
        if key not in rects:
            issues.append({'code': 'missing_control', 'element': key})
        elif key not in focused:
            issues.append({'code': 'missing_focus', 'element': key})

    for key, metrics in (text_metrics or {}).items():
        try:
            rendered, available = metrics
            if float(rendered) > float(available):
                issues.append({'code': 'text_clipped', 'element': str(key)})
        except (TypeError, ValueError, OverflowError):
            issues.append({'code': 'invalid_text_metrics', 'element': str(key)})

    if content_height is not None:
        try:
            content_height = float(content_height)
            scroll_offset = float(scroll_offset)
            if content_height < 0:
                issues.append({'code': 'invalid_content_height'})
            else:
                if content_height > viewport.height and not scrollable:
                    issues.append({'code': 'scroll_unavailable'})
                if not 0 <= scroll_offset <= max(0.0, content_height - viewport.height):
                    issues.append({'code': 'invalid_scroll_offset'})
        except (TypeError, ValueError, OverflowError):
            issues.append({'code': 'invalid_scroll_metrics'})
    return issues


def _ui_distribute(values, target):
    """Round a list of floats to ints whose sum is exactly `target`
    (largest-remainder), so compressed layouts have no 1 px drift."""
    base = [int(v) for v in values]
    rem = target - sum(base)
    order = sorted(range(len(values)), key=lambda i: values[i] - base[i], reverse=True)
    n = len(order)
    i = 0
    while rem > 0 and n:
        base[order[i % n]] += 1
        rem -= 1
        i += 1
    while rem < 0 and n:
        j = order[-1 - (i % n)]
        if base[j] > 0:
            base[j] -= 1
            rem += 1
        i += 1
        if i > 4 * n + 4:
            break
    return base


class UIVerticalFlow:
    """Running-cursor vertical layout with the three-stage policy

        fit      everything at its preferred size (flex items absorb extra room,
                 leftover room is placed according to `valign`)
        compress every height and gap shrinks linearly toward its minimum
        scroll   even minimum sizes do not fit -> content is laid out at minimum
                 size and `mode == 'scroll'`; the caller wraps it in a ScrollView

    Pure geometry: no drawing, no pygame surfaces, easy to unit-test.
    """

    def __init__(self, rect, padding=0, spacing=8, min_spacing=2, align='center',
                 valign='top', allow_compress=True, allow_scroll=True):
        self.rect = pygame.Rect(rect)
        self.padding = _ui_insets(padding)
        self.spacing = int(spacing)
        self.min_spacing = int(min(min_spacing, spacing))
        self.align, self.valign = align, valign
        self.allow_compress, self.allow_scroll = allow_compress, allow_scroll
        self.items = []

    def add(self, key, h=0, **kw):
        it = UIFlowItem(key, h, **kw)
        self.items.append(it)
        return it

    def spacer(self, key, min_h=0, flex=1):
        return self.add(key, h=min_h, min_h=min_h, flex=flex)

    def solve(self):
        pl, pt, pr, pb = self.padding
        r = self.rect
        inner = pygame.Rect(r.x + pl, r.y + pt, max(0, r.w - pl - pr), max(0, r.h - pt - pb))
        items = self.items
        n = len(items)
        gp = [0] * n      # preferred gap before item i
        gm = [0] * n      # minimum gap before item i
        for i, it in enumerate(items):
            if i:
                gp[i] = it.gap if it.gap is not None else self.spacing
                gm[i] = it.min_gap if it.min_gap is not None else min(self.min_spacing, gp[i])
                gm[i] = min(gm[i], gp[i])
        hp = [it.h for it in items]
        hm = [it.min_h for it in items]
        avail = inner.h
        pref_total = sum(hp) + sum(gp)
        min_total = sum(hm) + sum(gm)

        mode, t, overflow = 'fit', 0.0, 0
        if pref_total <= avail:
            heights, gaps = list(hp), list(gp)
            extra = avail - pref_total
            flex = [(i, it.flex) for i, it in enumerate(items) if it.flex > 0]
            while extra > 0 and flex:              # distribute, honouring max_h caps
                tw = sum(w for _, w in flex)
                given, capped = 0, []
                for i, w in flex:
                    share = int(extra * w / tw)
                    cap = items[i].max_h
                    if cap is not None and heights[i] + share > cap:
                        share = max(0, cap - heights[i])
                        capped.append((i, w))
                    heights[i] += share
                    given += share
                extra -= given
                flex = [f for f in flex if f not in capped]
                if given == 0:
                    if flex:                       # remainder pixels -> first flex item
                        heights[flex[0][0]] += extra
                        extra = 0
                    break
            used = sum(heights) + sum(gaps)
            free = avail - used
        elif self.allow_compress and min_total <= avail:
            mode = 'compress'
            t = (pref_total - avail) / float(pref_total - min_total) if pref_total > min_total else 1.0
            vals = [hp[i] - t * (hp[i] - hm[i]) for i in range(n)] + \
                   [gp[i] - t * (gp[i] - gm[i]) for i in range(n)]
            ints = _ui_distribute(vals, avail)
            heights, gaps = ints[:n], ints[n:]
            free = 0
        else:
            mode = 'scroll' if self.allow_scroll else 'overflow'
            t = 1.0
            heights, gaps = list(hm), list(gm)
            overflow = max(0, min_total - avail)
            free = 0

        y = inner.y
        if free > 0:
            y += free if self.valign == 'bottom' else free // 2 if self.valign == 'center' else 0
        rects = {}
        for i, it in enumerate(items):
            y += gaps[i]
            w = inner.w if it.w is None else it.w
            if it.max_w is not None:
                w = min(w, it.max_w)
            if it.min_w is not None:
                w = max(w, it.min_w)
            w = min(w, inner.w)
            al = it.align or self.align
            x = inner.x if al == 'left' else inner.right - w if al == 'right' else inner.x + (inner.w - w) // 2
            rects[it.key] = pygame.Rect(x, y, w, heights[i])
            y += heights[i]
        content_h = (y - inner.y) + pt + pb
        return UIFlowResult(rects, content_h, mode, t, overflow, inner)


# ── Layout: horizontal flow (wrap / compress / drop optional) ────────────
class UIHFlowItem:
    __slots__ = ('key', 'w', 'min_w', 'max_w', 'h', 'flex', 'priority', 'anchor_center')

    def __init__(self, key, w, min_w=None, max_w=None, h=0, flex=0, priority=0,
                 anchor_center=False):
        self.key, self.w = key, int(w)
        self.min_w = int(w if min_w is None else min(min_w, w))
        self.max_w = max_w
        self.h, self.flex, self.priority = int(h), flex, priority
        self.anchor_center = anchor_center


class UIHFlowResult:
    def __init__(self, rects, rows, height, hidden, mode):
        self.rects, self.rows, self.height = rects, rows, height
        self.hidden, self.mode = hidden, mode

    def __getitem__(self, key):
        return self.rects[key]

    def get(self, key, default=None):
        return self.rects.get(key, default)


class UIHorizontalFlow:
    """Left-to-right layout inside a fixed width. Policy per row:

        fit       preferred widths; flex items grow into free space
        compress  widths shrink linearly toward min_w
        wrap      (wrap=True)  items that cannot share a row move to the next row
        drop      (drop_optional=True) items with priority>0 are hidden, highest
                  priority number first, until the remainder fits
    """

    def __init__(self, rect, spacing=8, row_spacing=6, wrap=False, drop_optional=False,
                 align='left', valign='center'):
        self.rect = pygame.Rect(rect)
        self.spacing, self.row_spacing = int(spacing), int(row_spacing)
        self.wrap, self.drop_optional = wrap, drop_optional
        self.align, self.valign = align, valign
        self.items = []

    def add(self, key, w, **kw):
        it = UIHFlowItem(key, w, **kw)
        self.items.append(it)
        return it

    def _solve_row(self, items, width):
        """Returns list of widths (or None if min widths do not fit) and free space."""
        n = len(items)
        if n == 0:
            return [], 0
        sp = self.spacing * (n - 1)
        pref = sum(i.w for i in items) + sp
        minw = sum(i.min_w for i in items) + sp
        if pref <= width:
            widths = [i.w for i in items]
            extra = width - pref
            flex = [(k, it.flex) for k, it in enumerate(items) if it.flex > 0]
            while extra > 0 and flex:
                tw = sum(w for _, w in flex)
                given, capped = 0, []
                for k, w in flex:
                    share = int(extra * w / tw)
                    cap = items[k].max_w
                    if cap is not None and widths[k] + share > cap:
                        share = max(0, cap - widths[k])
                        capped.append((k, w))
                    widths[k] += share
                    given += share
                extra -= given
                flex = [f for f in flex if f not in capped]
                if given == 0:
                    if flex:
                        widths[flex[0][0]] += extra
                        extra = 0
                    break
            return widths, extra
        if minw <= width:
            t = (pref - width) / float(pref - minw) if pref > minw else 1.0
            vals = [i.w - t * (i.w - i.min_w) for i in items]
            return _ui_distribute(vals, width - sp), 0
        return None, 0

    def solve(self):
        r = self.rect
        items = list(self.items)
        hidden = []
        # 1) optionally drop low-priority items until one row fits
        if self.drop_optional and not self.wrap:
            while items and self._solve_row(items, r.w)[0] is None:
                cands = [(it.priority, idx) for idx, it in enumerate(items) if it.priority > 0]
                if not cands:
                    break
                _, idx = max(cands)
                hidden.append(items.pop(idx).key)
        # 2) pack rows
        rows = []
        if self.wrap:
            cur = []
            for it in items:
                trial = cur + [it]
                if cur and self._solve_row(trial, r.w)[0] is None:
                    rows.append(cur)
                    cur = [it]
                else:
                    cur = trial
            if cur:
                rows.append(cur)
        else:
            rows = [items]
        rects, keys_rows, y, mode = {}, [], r.y, 'fit'
        for ri, row in enumerate(rows):
            widths, free = self._solve_row(row, r.w)
            if widths is None:                       # cannot fit even at min: squeeze evenly
                mode = 'overflow'
                sp = self.spacing * (len(row) - 1)
                each = max(1, (r.w - sp) // max(1, len(row)))
                widths, free = [each] * len(row), 0
            elif sum(i.w for i in row) + self.spacing * (len(row) - 1) > r.w:
                mode = 'compress' if mode == 'fit' else mode
            row_h = max([it.h for it in row] + [0])
            if ri:
                y += self.row_spacing
            x = r.x
            if free > 0:
                x += free if self.align == 'right' else free // 2 if self.align == 'center' else 0
            placed = []
            for it, w in zip(row, widths):
                h = it.h or row_h
                yy = y + (row_h - h) // 2 if self.valign == 'center' else y
                rc = pygame.Rect(x, yy, w, h)
                rects[it.key] = rc
                placed.append((it, rc))
                x += w + self.spacing
            # soft-centre anchored items (e.g. a title) without touching neighbours
            for idx, (it, rc) in enumerate(placed):
                if it.anchor_center and len(rows) == 1:
                    lo = placed[idx - 1][1].right + self.spacing if idx else r.x
                    hi = placed[idx + 1][1].x - self.spacing if idx + 1 < len(placed) else r.right
                    w = min(it.w, hi - lo)
                    if w > 0:
                        nx = _ui_clamp(r.centerx - w // 2, lo, hi - w)
                        rects[it.key] = pygame.Rect(nx, rc.y, w, rc.h)
            keys_rows.append([it.key for it in row])
            y += row_h
        if len(rows) > 1 and mode != 'overflow':
            mode = 'wrap'
        return UIHFlowResult(rects, keys_rows, y - r.y, hidden, mode)

