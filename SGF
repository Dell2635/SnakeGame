                    ('127.0.0.1', relay_edge_state['target'].port), timeout=3.0)
                origin_peer.sendall(first_line + b'\r\n' + injected + remainder)
                answer = bytearray()
                while not answer.endswith(b'\r\n\r\n'):
                    part = origin_peer.recv(1)
                    if not part:
                        break
                    answer.extend(part)
                if answer.startswith(b'HTTP/1.1 101'):
                    answer = bytearray(bytes(answer)[:-2] + (
                        b'Set-Cookie: __cf_bm=a\r\nSet-Cookie: _cfuvid=b\r\nServer: cloudflare\r\n'
                        b'Alt-Svc: h3=":443"\r\nCf-Ray: 123-LIS\r\n\r\n'))
                peer.sendall(bytes(answer))
                if not answer.startswith(b'HTTP/1.1 101'):
                    peer.close(); origin_peer.close()
                    return
                def _pump(source, sink):
                    try:
                        while True:
                            data = source.recv(65536)
                            if not data:
                                break
                            sink.sendall(data)
                    except OSError:
                        pass
                    finally:
                        for end in (source, sink):
                            try: end.shutdown(_socket_mod.SHUT_RDWR)
                            except OSError: pass
                threading.Thread(target=_pump, args=(peer, origin_peer), daemon=True).start()
                threading.Thread(target=_pump, args=(origin_peer, peer), daemon=True).start()
            except Exception:
                pass
