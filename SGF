class UIButton(UIWidget):
    """Push button. `text` may be a str or a callable (re-evaluated so language
    changes apply). Label is shrunk with render_fit() when the button is narrow,
    and the font shrinks with the button height so compressed layouts stay legible."""

    def __init__(self, text, rect=None, color=None, on_activate=None, key=None,
                 font_size=20, style='bold', radius=10, glow=True, text_color=None,
                 enabled=True, tab_index=None):
        super().__init__(rect, key=key, enabled=enabled, on_activate=on_activate, tab_index=tab_index)
        self.text = text
        self.color = color if color is not None else COLORS['button']
        self.font_size, self.style, self.radius, self.glow = font_size, style, radius, glow
        self.text_color = text_color if text_color is not None else COLORS['white']

    def _fit_size(self):
        return max(10, min(self.font_size, int(self.rect.h * 0.56)))

    def preferred_width(self, pad=28):
        return ui_text_size(self.lang(), self.style, self.font_size, self.val(self.text))[0] + pad

    def draw(self, surface):
        if not self.visible or self.rect.w <= 0 or self.rect.h <= 0:
            return
        r, st = self.rect, self.state
        high_contrast = bool(globals().get('_ACCESSIBILITY_HIGH_CONTRAST', False))
        if high_contrast:
            if st == 'disabled':
                bg, fg = (0, 0, 0), (160, 160, 160)
                border = (160, 160, 160)
            else:
                bg = ((64, 64, 64) if st == 'pressed' else
                      (32, 32, 32) if st in ('hover', 'focused') else (0, 0, 0))
                fg, border = (255, 255, 255), (255, 255, 0)
        elif st == 'disabled':
            bg, fg = UI_STYLE['disabled_bg'], UI_STYLE['disabled_fg']
        else:
            fg = self.text_color
            if st == 'pressed':
                bg = _ui_shade(self.color, -35)
            elif st in ('hover', 'focused'):
                pulse = int((self.ui.pulse if self.ui is not None else 0.5) * 50)
                bg = _ui_shade(self.color, pulse)
            else:
                bg = self.color
        pygame.draw.rect(surface, bg, r, border_radius=self.radius)
        if high_contrast:
            pygame.draw.rect(surface, border, r, width=2, border_radius=self.radius)
        if (self.glow and not high_contrast
                and not globals().get('_ACCESSIBILITY_REDUCED_MOTION', False)
                and st in ('hover', 'focused')):
            gk = (r.w, r.h, self.radius)
            g, cached = _lru_cache_get(_ui_glow_cache, gk)
            if not cached:
                g = pygame.Surface((r.w + 8, r.h + 8), pygame.SRCALPHA)
                pygame.draw.rect(g, (255, 255, 255, 255), g.get_rect(), border_radius=self.radius + 2)
                _lru_cache_put(_ui_glow_cache, gk, g, 64)
            g.set_alpha(int((self.ui.pulse if self.ui is not None else 0.5) * 150))
            surface.blit(g, (r.x - 4, r.y - 4))
        s = ui_text_surface(self.lang(), self.style, self._fit_size(), self.val(self.text), fg,
                            max(1, r.w - 10))
        surface.blit(s, s.get_rect(center=r.center))
        if self.show_focus:
            ui_draw_focus_ring(surface, r, self.radius)


