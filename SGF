class ModsScreen(_SimpleMenuScreen):
    """MAIN MENU\\Mods — view/enable/disable installed mods, reload the mods
    folder, and open it in the OS file browser. Built directly on IA4's
    ModManager/ModRegistry (MOD_MANAGER) and IA3's data-folder contract
    (get_data_manager().get_mod_dir()) — no parallel mod-listing system.

    There's no in-game file picker anywhere in SGF, so 'Import Mod' opens
    the mods folder (like 'Open Mods Folder') rather than pretending to
    copy a file in from an OS dialog that doesn't exist yet; the two
    buttons are kept separate so this limitation is visible rather than
    silently merged away.
    """

    def __init__(self, settings, screen, on_mods_changed=None):
        self.on_mods_changed = on_mods_changed
        self._checkboxes = {}
        body = None
        if not MOD_MANAGER.discovered:
            body = lambda: _t_or(settings.language, 'no_mods_installed',
                                 'No mods installed yet. Use "Open Mods Folder" to add one.')
        entries = [
            ('reload_mods', lambda: _t_or(settings.language, 'reload_mods', 'Reload Mods'),
             COLORS['blue'], self._reload),
            ('import_mod', lambda: _t_or(settings.language, 'import_mod', 'Import Mod'),
             COLORS['green'], self._open_folder),
            ('open_mods_folder', lambda: _t_or(settings.language, 'open_mods_folder', 'Open Mods Folder'),
             COLORS['purple'], self._open_folder),
        ]
        super().__init__(settings, screen,
                         title_fn=lambda: _t_or(settings.language, 'mods', 'Mods'),
                         entries=entries, body_fn=body)

    def _open_folder(self):
        _open_folder_in_os(get_data_manager().get_mod_dir())

    def _reload(self):
        refresh_extension_content()
        self._init_ui()  # rebuild: newly discovered mods need new checkboxes

    def _toggle_mod(self, mod_id, checked):
        if checked:
            MOD_MANAGER.enable(mod_id)
        else:
            MOD_MANAGER.disable(mod_id)
        self.settings.enabled_mods = list(MOD_MANAGER.enabled)
        self.settings.save()
        MOD_MANAGER.activate_all()
        if self.on_mods_changed:
            self.on_mods_changed()

    def _populate_widgets(self):
        super()._populate_widgets()
        w = self._widgets
        mod_order = []
        for mod_id in sorted(MOD_MANAGER.discovered):
            manifest = MOD_MANAGER.discovered[mod_id]
            label = f"{manifest.name}  v{manifest.version}"
            key = f"mod_{mod_id}"
            cb = UICheckbox(label, checked=(mod_id in MOD_MANAGER.enabled), key=key,
                            on_change=lambda checked, mid=mod_id: self._toggle_mod(mid, checked))
            w[key] = cb
            mod_order.append(key)
        if MOD_MANAGER.errors:
            err_text = "; ".join(f"{e.get('mod_id') or '?'}: {e['error']}" for e in MOD_MANAGER.errors[-3:])
            w['mod_errors'] = UILabel(lambda t=err_text: t, align='center', wrap=True,
                                      size=16, color=COLORS['red'])
            mod_order.append('mod_errors')
        # insert the mod list right after the title/body, before the action buttons/back
        insert_at = 2 if 'body' in self._order else 1
        self._order = self._order[:insert_at] + mod_order + self._order[insert_at:]
        self._mod_keys = mod_order

    def _build(self):
        ui, view, W = self.ui, self.view, self._widgets
        sw, sh = self.screen.get_size()
        lang = self.settings.language
        ui.language = lang
        view.set_rect(pygame.Rect(0, 0, sw, sh))
        ref = min(sw, sh)
        font_size = max(15, min(24, int(ref * 0.04)))
        btn_h = max(36, min(60, int(sh * 0.075)))
        min_btn_h = max(26, int(btn_h * 0.66))
        row_h = max(28, min(44, int(sh * 0.05)))
        gap = max(6, min(20, int(btn_h * 0.3)))
        title_size = max(28, min(52, int(ref * 0.07)))
        title_h = get_font(lang, 'bold', title_size).get_height() + 20
        W['title'].size = title_size
        widest = 0
        for k in self._order:
            b = W[k]
            if isinstance(b, UIButton):
                b.font_size = font_size
                widest = max(widest, ui_text_size(lang, 'bold', font_size, b.val(b.text))[0])
        bw = min(int(sw * 0.92), max(max(220, min(420, int(sw * 0.4))), widest + 44))
        pad_v = max(8, int(sh * 0.03))

        def build(width):
            flow = UIVerticalFlow(pygame.Rect(0, 0, width, sh), padding=(0, pad_v), spacing=gap,
                                  min_spacing=2, valign='top')
            for k in self._order:
                if k == 'title':
                    flow.add(k, title_h, min_h=int(title_h * 0.55))
                elif k == 'body' or k == 'mod_errors':
                    h = W[k].measure(bw) + 16
                    flow.add(k, h, min_h=int(h * 0.5), w=bw, gap=gap * 2, min_gap=4)
                elif k in self._mod_keys:
                    flow.add(k, row_h, min_h=int(row_h * 0.7), w=bw)
                elif k == 'reload_mods':
                    flow.add(k, btn_h, min_h=min_btn_h, w=bw, gap=gap * 2, min_gap=4)
                elif k == 'back':
                    flow.add(k, btn_h, min_h=min_btn_h, w=bw, gap=gap * 2, min_gap=4)
                else:
                    flow.add(k, btn_h, min_h=min_btn_h, w=bw)
            res = flow.solve()
            for k in self._order:
                view.add(W[k], res.rects[k])
            return res.content_height if res.mode == 'scroll' else view.viewport.h

        fk = ui.focused.key if ui.focused is not None else None
        view.relayout(build)
        if fk is not None:
            ui.focus_key(fk)


class MainMenu:
    def __init__(self):
        # Load or create settings
        self.settings = Settings()
        self.settings.load()

        # IA4 extension initialization. Theme/mod failures are isolated from
        # base-game startup; invalid themes fall back to default automatically.
        try:
            refresh_extension_content()
            selected_theme = THEME_MANAGER.select(self.settings.theme_id)
            if selected_theme != self.settings.theme_id:
                self.settings.theme_id = selected_theme
            MOD_MANAGER.enabled = set(str(mid) for mid in self.settings.enabled_mods)
            MOD_MANAGER.activate_all(self.settings.enabled_mods)
        except Exception as _ia4_exc:
            print(f"[IA4] Extension startup warning: {_ia4_exc}")
            THEME_MANAGER.select("default")
            self.settings.theme_id = "default"

        # Set up the display
        self.set_display_mode()
        self.runtime = ScreenManager(self.screen)
        self.runtime.start_application()
        self.runtime.input.register_global_handler(self._handle_runtime_global_input, priority=100)

        # Check if first time running
        if self.settings.first_time:
            # First show language selection, then tutorial
            self.show_language_selection()
            # Now show the tutorial in selected language
            self.show_tutorial()
            self.settings.first_time = False
            self.settings.save()
        
        self.player_name = self.load_player_name()
        self.name_input_active = False
        self.current_language = self.settings.language
        
        # Start/stop background music to match saved settings
        _apply_bgm_state(self.settings)
        
        # Create achievement manager
        self.achievement_manager = AchievementManager()
        self.achievement_manager.load_state()  # restore previously-unlocked achievements from disk
        
        # Create game objects
        self.game = SnakeGame(self.settings, self.screen)
        self.game.runtime = self.runtime
        # Pass achievement manager to the game
        self.game.achievement_manager = self.achievement_manager
        self.highscores_screen = HighScoresScreen(self.settings, self.screen)
        self.settings_screen = SettingsScreen(self.settings, self.screen)
        self.tutorial_screen = TutorialScreen(self.settings, self.screen)
        EVENT_BUS.emit(
            "GAME_STARTED",
            game_version=GAME_VERSION,
            theme_id=THEME_MANAGER.active_theme_id,
            mod_ids=MOD_MANAGER.active_mod_ids(),
        )
        self.multiplayer_screen = MultiplayerModeScreen(self.settings, self.screen)
        self.network_lobby = NetworkLobbyScreen(self.settings, self.screen)
        self.player_hub_screen = PlayerHubScreen(self.settings, self.screen, {
            'profile':      self._ph_open_profile,
