def _write_replay_recovery_journal(game_id, score_entry, history, max_records):
    """Persist a bounded, verified retry snapshot before final replay work."""
    journal = {
        'recovery_schema': _REPLAY_RECOVERY_SCHEMA,
        'game_id': str(game_id)[:96],
        'score_entry': copy.deepcopy(score_entry),
        'history': list(history) if isinstance(history, (list, tuple)) else [],
        'max_records': max(1, min(10000, int(max_records))),
        'created_at': datetime.now().isoformat(),
    }
    raw = json.dumps(journal, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
    if len(raw) > _REPLAY_RECOVERY_MAX_BYTES:
        raise ValueError('Replay recovery snapshot exceeds the size limit')
    path = _replay_recovery_path(game_id)
    _atomic_write_bytes(path, gzip.compress(raw, compresslevel=6, mtime=0))
    verified = _load_replay_recovery_journal(path)
    if (verified is None or verified.get('game_id') != journal['game_id']
            or len(verified.get('history', ())) != len(journal['history'])):
        raise ValueError('Replay recovery snapshot failed validation')
    return path


def _load_replay_recovery_journal(path):
    """Read a recovery snapshot with compressed and expanded size limits."""
    try:
        if os.path.getsize(path) > _REPLAY_RECOVERY_MAX_BYTES:
            return None
        with gzip.open(path, 'rb') as recovery_file:
            raw = recovery_file.read(_REPLAY_RECOVERY_MAX_BYTES + 1)
        if len(raw) > _REPLAY_RECOVERY_MAX_BYTES:
            return None
        journal = json.loads(raw.decode('utf-8'))
        if (not isinstance(journal, dict)
                or journal.get('recovery_schema') != _REPLAY_RECOVERY_SCHEMA
                or not isinstance(journal.get('game_id'), str)
                or not isinstance(journal.get('score_entry'), dict)
                or not isinstance(journal.get('history'), list)
                or len(journal['history']) > _REPLAY_SHARE_MAX_FRAMES
                or not isinstance(journal.get('max_records'), int)
                or isinstance(journal.get('max_records'), bool)
                or not 1 <= journal['max_records'] <= 10000):
            return None
        if journal['score_entry'].get('game_id') != journal['game_id']:
            return None
        return journal
    except (OSError, EOFError, gzip.BadGzipFile, UnicodeError, ValueError,
            TypeError, OverflowError):
        return None


def _list_replay_recovery_jobs():
    """Return validated pending replay saves without deleting invalid files."""
    directory = _replay_recovery_dir()
    try:
        names = sorted(name for name in os.listdir(directory)
                       if name.startswith('replay_job_') and name.endswith('.json.gz'))
    except OSError:
        return []
    jobs = []
    for name in names:
        path = os.path.join(directory, name)
        journal = _load_replay_recovery_journal(path)
        jobs.append({'path': path, 'journal': journal,
                     'invalid': journal is None})
    return jobs


def _discard_replay_recovery(path):
    """Discard only the exact recovery journal the player selected."""
    expected_root = os.path.abspath(_replay_recovery_dir())
    target = os.path.abspath(path)
    if os.path.dirname(target) != expected_root or not os.path.basename(target).startswith('replay_job_'):
        return False
    try:
        os.remove(target)
        return True
    except OSError:
        return False



def _retry_completed_score(game_id):
    """Retry a failed replay job from its immutable game-over snapshot."""
    key = str(game_id or '')
    with _replay_save_jobs_lock:
        state = _replay_save_jobs.get(key)
        if (state is None or not state['done'].is_set() or state.get('phase') != 'failed'
                or not state.get('history')):
            return False
        entry = copy.deepcopy(state.get('entry', {}))
        history = state['history']
        max_records = state.get('max_records', 10)
        state['done'].clear()
        state['phase'] = 'preparing'
        state['error'] = None
        state['retry_count'] = int(state.get('retry_count', 0)) + 1
        state['retry_rect'] = None
        state['phase_durations_ms'] = {}
        state['slow_phases'] = []
        state['started_monotonic'] = time.perf_counter()
        state['phase_started_monotonic'] = state['started_monotonic']
        state['updated_at'] = time.time()
    try:
        worker = threading.Thread(
            target=_write_completed_score_worker,
            args=(key, entry, history, max_records),
            name='SGF-replay-retry', daemon=True,
        )
        worker.start()
        return True
    except Exception as exc:
        _set_replay_save_phase(key, 'failed', error=type(exc).__name__)
        with _replay_save_jobs_lock:
            state = _replay_save_jobs.get(key)
            if state is not None:
                state['done'].set()
        return False


def _handle_replay_save_retry_event(owner, event):
    if (owner is None or event.type != pygame.MOUSEBUTTONDOWN or event.button != 1
            or not getattr(owner, 'game_over', False)):
        return False
    game_id = getattr(owner, '_replay_save_game_id', None)
    status = _get_replay_save_status(game_id)
    retry_rect = status.get('retry_rect') if status else None
    if retry_rect and retry_rect.collidepoint(event.pos):
        _retry_completed_score(game_id)
        return True
    return False

def _draw_replay_save_widget(surface, language, game_id, center, top):
    """Render real replay-save state without exposing worker internals or blocking."""
    status = _get_replay_save_status(game_id)
    if status is None:
        return
    if status['phase'] == 'complete' and time.time() - status['updated_at'] > 3.0:
        return

    sw, _sh = surface.get_size()
    box_w = min(360, max(220, sw - 32))
    failed = status['phase'] == 'failed'
    box_h = 92 if failed and status.get('has_history') else 78
    rect = pygame.Rect(int(center - box_w // 2), int(top), box_w, box_h)
    complete = status['phase'] == 'complete'
    bg = (65, 30, 35) if failed else ((25, 60, 42) if complete else (24, 35, 62))
    border = (210, 90, 90) if failed else ((90, 210, 130) if complete else (90, 135, 215))
    pygame.draw.rect(surface, bg, rect, border_radius=8)
    pygame.draw.rect(surface, border, rect, width=1, border_radius=8)

    slow = bool(status.get('slow'))
    key = ('replay_save_failed' if failed else
           'replay_save_slow' if slow else
           'score_replay_saved' if complete else 'replay_saving')
    color = ((255, 180, 180) if failed else
             (255, 205, 110) if slow else
             (150, 245, 175) if complete else (220, 230, 255))
    font = get_font(language, 'regular', 16)
    text = render_fit(font, get_text(language, key), color, rect.width - 18, padding=0)
    if failed and status.get('has_history'):
        surface.blit(text, text.get_rect(center=(rect.centerx, rect.y + 15)))
        last_phase = next(reversed(status.get('phase_durations_ms', {})), None)
        if last_phase:
            phase_key = {
                'staging': 'replay_phase_preparing',
                'serializing': 'replay_phase_serializing',
                'compressing': 'replay_phase_compressing',
                'writing': 'replay_phase_writing',
                'verifying': 'replay_phase_verifying',
                'indexing': 'replay_phase_indexing',
            }.get(last_phase)
            if phase_key:
                phase_text = render_fit(get_font(language, 'regular', 12),
                                        get_text(language, phase_key),
                                        (220, 225, 240), rect.width - 18, padding=0)
                surface.blit(phase_text, phase_text.get_rect(center=(rect.centerx, rect.y + 37)))
        retry_rect = pygame.Rect(rect.centerx - 48, rect.y + 65, 96, 21)
        pygame.draw.rect(surface, (105, 48, 55), retry_rect, border_radius=5)
        pygame.draw.rect(surface, border, retry_rect, width=1, border_radius=5)
        retry_text = render_fit(get_font(language, 'bold', 13),
                                get_text(language, 'replay_save_retry'),
                                (255, 230, 230), retry_rect.width - 8, padding=0)
        surface.blit(retry_text, retry_text.get_rect(center=retry_rect.center))
        _set_replay_save_phase(game_id, 'failed', retry_rect=retry_rect)
    else:
        surface.blit(text, text.get_rect(center=(rect.centerx, rect.y + 17)))
        phase = status.get('phase')
        phase_key = {
            'preparing': 'replay_phase_preparing',
            'staging': 'replay_phase_preparing',
            'serializing': 'replay_phase_serializing',
            'compressing': 'replay_phase_compressing',
            'writing': 'replay_phase_writing',
            'verifying': 'replay_phase_verifying',
            'indexing': 'replay_phase_indexing',
            'complete': 'replay_phase_complete',
        }.get(phase)
        if phase_key:
            phase_text = render_fit(get_font(language, 'regular', 12),
                                    get_text(language, phase_key),
                                    (195, 205, 225), rect.width - 18, padding=0)
            surface.blit(phase_text, phase_text.get_rect(center=(rect.centerx, rect.y + 38)))
        original_bytes = status.get('original_bytes')
        compressed_bytes = status.get('compressed_bytes')
        if original_bytes is not None:
            def _format_replay_size(value):
                value = max(0, int(value))
                if value >= 1024 * 1024:
                    return f'{value / (1024 * 1024):.1f} MB'
                if value >= 1024:
                    return f'{value / 1024:.1f} KB'
                return f'{value} B'
            size_label = _format_replay_size(original_bytes)
            if compressed_bytes is not None:
                size_label += ' → ' + _format_replay_size(compressed_bytes)
            size_text = render_fit(get_font(language, 'regular', 11), size_label,
                                   (165, 180, 205), rect.width - 18, padding=0)
            surface.blit(size_text, size_text.get_rect(center=(rect.centerx, rect.y + 54)))

    if not failed and not complete:
        # This is deliberately indeterminate: serialization/compression do not
        # expose byte-level progress, so the animation communicates activity
        # without inventing a percentage.
        track = pygame.Rect(rect.x + 10, rect.bottom - 4, rect.width - 20, 3)
        pygame.draw.rect(surface, (55, 70, 100), track, border_radius=2)
        segment_w = max(24, track.width // 5)
        travel = max(1, track.width - segment_w)
        segment_x = track.x + int((time.monotonic() * 0.8 % 1.0) * travel)
        pygame.draw.rect(surface, (135, 175, 255),
                         pygame.Rect(segment_x, track.y, segment_w, track.height),
                         border_radius=2)


class ReplayRecoveryScreen:
    """Offer explicit recovery actions for a durable interrupted save."""
    def __init__(self, settings, screen, recovery_item):
        self.settings = settings
        self.screen = screen
        self.recovery_item = recovery_item
        self.error = None
        self.active_game_id = None

    def _draw(self):
        screen = self.screen
        sw, sh = screen.get_size()
        language = self.settings.language
        high_contrast = bool(getattr(self.settings, 'high_contrast', False))
        background = (0, 0, 0) if high_contrast else (12, 18, 31)
        panel_color = (0, 0, 0) if high_contrast else (25, 34, 52)
        accent = (255, 255, 0) if high_contrast else (112, 153, 220)
        screen.fill(background)
        panel = pygame.Rect(12, 12, max(1, sw - 24), max(1, sh - 24))
        pygame.draw.rect(screen, panel_color, panel, border_radius=12)
        pygame.draw.rect(screen, accent, panel, width=2, border_radius=12)
        title = get_font(language, 'bold', max(20, min(32, int(sh * .055))))
        title_surface = render_fit(title, get_text(language, 'recovered_session_title'),
                                   COLORS['white'], panel.w - 36, padding=0)
        screen.blit(title_surface, title_surface.get_rect(midtop=(panel.centerx, panel.y + 24)))

        journal = self.recovery_item.get('journal')
        message_key = 'recovery_interrupted' if journal else 'recovery_invalid'
        body_font = get_font(language, 'regular', max(15, min(20, int(sh * .034))))
        body_lines = _wrap_text(get_text(language, message_key), body_font, panel.w - 44)
        body_y = panel.y + 86
        for line in body_lines[:5]:
            body = body_font.render(line, True, COLORS['white'])
            screen.blit(body, body.get_rect(centerx=panel.centerx, top=body_y))
            body_y += body.get_height() + 7

        if self.active_game_id:
            status = _get_replay_save_status(self.active_game_id)
            if status and status['phase'] == 'complete':
                _discard_replay_recovery(self.recovery_item['path'])
                return 'recovered'
            if status and status['phase'] == 'failed':
                self.active_game_id = None
                self.error = get_text(language, 'replay_save_failed')

        if self.error:
            error_surface = render_fit(body_font, self.error, (255, 150, 150),
                                       panel.w - 36, padding=0)
            screen.blit(error_surface, error_surface.get_rect(center=(panel.centerx, sh - 116)))
        elif self.active_game_id:
            progress_surface = render_fit(body_font, get_text(language, 'replay_saving'),
                                          COLORS['light_blue'], panel.w - 36, padding=0)
            screen.blit(progress_surface, progress_surface.get_rect(center=(panel.centerx, sh - 116)))

        gap = 12
        button_w = max(1, min(220, (panel.w - 48 - gap) // 2))
        button_h = max(40, min(54, int(sh * .09)))
        row_y = panel.bottom - button_h * 2 - 38
        left_x = panel.centerx - button_w - gap // 2
        right_x = panel.centerx + gap // 2
        entries = [
            ('recover', get_text(language, 'recovery_recover'), bool(journal)),
            ('discard', get_text(language, 'recovery_discard'), True),
            ('open', get_text(language, 'recovery_open_data'), True),
            ('later', get_text(language, 'recovery_later'), True),
        ]
        rects = {}
        for index, (action, label, enabled) in enumerate(entries):
            col, row = index % 2, index // 2
            rect = pygame.Rect(left_x if col == 0 else right_x,
                               row_y + row * (button_h + 10), button_w, button_h)
            rects[action] = rect
            color = ((0, 0, 0) if high_contrast else
                     ((78, 86, 104) if not enabled else
                      (60, 76, 105) if action == 'recover' else (46, 58, 78)))
            edge = accent if enabled else (150, 150, 150)
            pygame.draw.rect(screen, color, rect, border_radius=7)
            pygame.draw.rect(screen, edge, rect, width=2 if high_contrast else 1,
                             border_radius=7)
            label_surface = render_fit(get_font(language, 'bold', 16), label,
                                       COLORS['white'] if enabled else COLORS['gray'],
                                       rect.w - 10, padding=0)
            screen.blit(label_surface, label_surface.get_rect(center=rect.center))
        pygame.display.flip()
        return rects

    def _recover(self):
        journal = self.recovery_item.get('journal')
        if not journal:
            return False
        self.error = None
        self.active_game_id = _queue_completed_score(
            journal['score_entry'], journal['history'], journal['max_records'])
        if self.active_game_id is None:
            self.error = get_text(self.settings.language, 'replay_save_failed')
            return False
        return True

    def run(self):
        clock = pygame.time.Clock()
        while True:
            rects = self._draw()
            if isinstance(rects, str):
                return rects
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    return 'later'
                if event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    continue
                action = None
                if event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_ESCAPE:
                        return 'later'
                    if self.active_game_id:
                        continue
                    action = {
                        pygame.K_r: 'recover', pygame.K_d: 'discard',
                        pygame.K_o: 'open', pygame.K_l: 'later',
                    }.get(event.key)
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    for candidate, rect in rects.items():
                        if rect.collidepoint(event.pos):
                            action = candidate
                            break
                if action == 'recover' and not self.active_game_id:
                    self._recover()
                elif action == 'discard' and not self.active_game_id:
                    if _discard_replay_recovery(self.recovery_item['path']):
                        return 'discarded'
                    self.error = get_text(self.settings.language, 'replay_save_failed')
                elif action == 'open':
                    _user_data_manager.open_data_folder()
                    return 'open'
                elif action == 'later':
                    return 'later'
            clock.tick(30)


def _write_completed_score_worker(game_id, score_entry, history, max_records):
    replay_path = None
    recovery_path = None
    replay_saved = False
    replay_error = None
    try:
        _set_replay_save_phase(game_id, 'staging')
        recovery_path = _write_replay_recovery_journal(
            game_id, score_entry, history, max_records)
        _set_replay_save_phase(game_id, 'staging', recovery_available=True)
    except Exception as exc:
        _logging_mod.getLogger('sgf').warning(
            'Could not create replay recovery snapshot %s: %s', game_id, exc)
        _set_replay_save_phase(game_id, 'staging', recovery_available=False)
    try:
        if history:
            _set_replay_save_phase(game_id, 'serializing')
            payload = _score_replay_payload(score_entry, history)
            raw = json.dumps(payload, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
            _set_replay_save_phase(game_id, 'compressing', original_bytes=len(raw))
            compressed = gzip.compress(raw, compresslevel=6, mtime=0)
            replay_path = _compressed_replay_path(score_entry['replay_id'])
            _set_replay_save_phase(game_id, 'writing', compressed_bytes=len(compressed))
            _atomic_write_bytes(replay_path, compressed)
            _set_replay_save_phase(game_id, 'verifying')
            with gzip.open(replay_path, 'rt', encoding='utf-8') as replay_file:
                verified = json.load(replay_file)
            if (not isinstance(verified, dict) or not isinstance(verified.get('events'), list)
                    or verified.get('game_id') != score_entry.get('game_id')
                    or len(verified['events']) != len(history)):
                raise ValueError('Compressed replay failed validation')
            replay_saved = True
    except Exception as exc:
        replay_error = type(exc).__name__
        if replay_path:
            try: os.remove(replay_path)
            except OSError: pass

    persisted_entry = copy.deepcopy(score_entry)
    persisted_entry['has_replay'] = replay_saved
    if not replay_saved:
        persisted_entry.pop('replay_id', None)
    persisted_entry.pop('custom_map', None)
    try:
        _set_replay_save_phase(game_id, 'indexing')
        with _data_save_lock:
            fresh_data = _load_data()
            fresh_data = _merge_completed_score_data(
                fresh_data, persisted_entry, max_records)
            _atomic_write_json(_DATA_FILE, fresh_data)
            _prune_score_replays(fresh_data['highscores'])
        if replay_error:
            _set_replay_save_phase(game_id, 'failed', error=replay_error)
        else:
            _set_replay_save_phase(game_id, 'complete')
    except Exception as exc:
        if replay_saved and replay_path:
            try: os.remove(replay_path)
            except OSError: pass
        _set_replay_save_phase(game_id, 'failed', error=type(exc).__name__)
    finally:
        with _replay_save_jobs_lock:
            state = _replay_save_jobs.get(str(game_id))
            completed_successfully = bool(state and state.get('phase') == 'complete')
        if completed_successfully and recovery_path:
            _discard_replay_recovery(recovery_path)
        with _replay_save_jobs_lock:
            state = _replay_save_jobs.get(str(game_id))
            if state is not None:
                if completed_successfully:
                    # The durable replay file is now the sole source of truth;
                    # do not keep another full in-memory copy in the status map.
                    state['history'] = ()
                    state['entry'] = {}
                state['done'].set()
                state['updated_at'] = time.time()


def _queue_completed_score(score_entry, history, max_records=10):
    """Return immediately and persist replay compression/indexing off the UI thread."""
    if not isinstance(score_entry, dict):
        return None
    game_id = str(score_entry.get('game_id') or _secrets_mod.token_hex(12))[:96]
    try:
        history_snapshot = tuple(history) if isinstance(history, (list, tuple)) else ()
    except Exception:
        history_snapshot = ()
    prepared = copy.deepcopy(score_entry)
    prepared['game_id'] = game_id
    prepared['has_replay'] = bool(history_snapshot)
    if history_snapshot:
        prepared['replay_id'] = _score_replay_id(prepared, 'replay-' + _secrets_mod.token_hex(10))
    else:
        prepared.pop('replay_id', None)

    started_monotonic = time.perf_counter()
    with _replay_save_jobs_lock:
        completed = [key for key, item in _replay_save_jobs.items() if item['done'].is_set()]
        for key in completed[:-64]:
            _replay_save_jobs.pop(key, None)
        pending = sum(not item['done'].is_set() for item in _replay_save_jobs.values())
        state = {
            'game_id': game_id,
            'replay_id': prepared.get('replay_id'),
            'phase': 'preparing' if history_snapshot else 'indexing',
            'error': None,
            'original_bytes': None,
            'compressed_bytes': None,
            'started_at': time.time(),
            'started_monotonic': started_monotonic,
            'phase_started_monotonic': started_monotonic,
            'phase_durations_ms': {},
            'slow_phases': [],
            'updated_at': time.time(),
            'done': threading.Event(),
            'entry': copy.deepcopy(prepared),
            'history': history_snapshot,
            'max_records': max(1, int(max_records)),
            'retry_rect': None,
            'retry_count': 0,
        }
        _replay_save_jobs[game_id] = state

    if pending >= 4:
        fallback_entry = copy.deepcopy(prepared)
        fallback_entry['has_replay'] = False
        fallback_entry.pop('replay_id', None)
        fallback_entry.pop('custom_map', None)
        _set_replay_save_phase(game_id, 'failed', error='queue_full')
        _save_data_async(lambda data: _merge_completed_score_data(data, fallback_entry, max_records))
        with _replay_save_jobs_lock:
            _replay_save_jobs[game_id]['done'].set()
        return game_id

    try:
        worker = threading.Thread(
            target=_write_completed_score_worker,
            args=(game_id, prepared, history_snapshot, max(1, int(max_records))),
            name='SGF-replay-persist', daemon=True,
        )
        worker.start()
    except Exception as exc:
        prepared['has_replay'] = False
        prepared.pop('replay_id', None)
        prepared.pop('custom_map', None)
        _set_replay_save_phase(game_id, 'failed', error=type(exc).__name__)
        _save_data_async(lambda data: _merge_completed_score_data(data, prepared, max_records))
        with _replay_save_jobs_lock:
            _replay_save_jobs[game_id]['done'].set()
    return game_id


def _history_for_score(score):
    """Load a replay from its file, while accepting legacy inline records."""
    payload = _load_replay_file(score.get('replay_id'))
    if payload is not None:
        resolved = dict(score)
        resolved['custom_map'] = payload.get('custom_map')
        for field in ('daily_challenge_id', 'daily_challenge_version',
                      'daily_challenge_modifier'):
            if field not in resolved and field in payload:
                resolved[field] = payload[field]
        for field in ('custom_challenge_id', 'custom_challenge_version'):
            if field not in resolved and field in payload:
                resolved[field] = payload[field]
        if score.get('is_multiplayer') and score.get('mp_mode'):
            resolved['mp_history'] = payload['events']
        else:
            resolved['game_history'] = payload['events']
        return resolved
    return dict(score)


