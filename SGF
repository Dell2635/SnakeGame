_CONTROL_DIRECTIONS = ('up', 'down', 'left', 'right')
_CONTROL_PRIMARY_DEFAULTS = {'up': 'w', 'down': 's', 'left': 'a', 'right': 'd'}
_CONTROL_ARROW_FALLBACKS = {
    pygame.K_UP: 'up', pygame.K_DOWN: 'down',
    pygame.K_LEFT: 'left', pygame.K_RIGHT: 'right',
}


def _normalize_control_bindings(raw):
    """Return one valid, unique primary key per direction; arrows stay as
    permanent fallback controls and cannot be rebound to another direction."""
    values = raw if isinstance(raw, dict) else {}
    result = {}
    used = set()
    for action in _CONTROL_DIRECTIONS:
        candidate = values.get(action, _CONTROL_PRIMARY_DEFAULTS[action])
        if not isinstance(candidate, str):
            candidate = _CONTROL_PRIMARY_DEFAULTS[action]
        candidate = candidate.strip().lower()
        if (len(candidate) != 1 or candidate not in 'abcdefghijklmnopqrstuvwxyz0123456789'
                or candidate in used):
            candidate = _CONTROL_PRIMARY_DEFAULTS[action]
        if candidate in used:
            # Malformed persisted values cannot create ambiguous movement.
            candidate = next(key for key in _CONTROL_PRIMARY_DEFAULTS.values()
                             if key not in used)
        result[action] = candidate
        used.add(candidate)
    return result


def _movement_action_for_key(settings, key):
    if key in _CONTROL_ARROW_FALLBACKS:
        return _CONTROL_ARROW_FALLBACKS[key]
    try:
        key_name = pygame.key.name(int(key)).lower()
    except (TypeError, ValueError, OverflowError):
        return None
    bindings = _normalize_control_bindings(getattr(settings, 'control_bindings', None))
    return next((action for action, name in bindings.items() if name == key_name), None)

