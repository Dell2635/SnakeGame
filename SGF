class VSAIGame:
    """
    Single-player vs one or more AI-controlled snakes.
    Reuses the same board layout conventions as MultiplayerGame.
    Supports 1–3 AI opponents.
    """

    # Colour palette for AI snakes (up to 3)
    AI_COLOURS = [
        {'body': (230,  80,  80), 'head': (180,  30,  30)},   # red
        {'body': (230, 160,  30), 'head': (170, 110,   0)},   # orange
        {'body': (160,  80, 230), 'head': (100,  30, 170)},   # purple
    ]
    P1_BODY = ( 50, 205,  50)
    P1_HEAD = ( 20, 165,  20)

    def __init__(self, settings, screen, ai_count=1, ai_difficulty='medium', seed=None, custom_map=None):
        self.settings      = settings
        self.screen        = screen
        self.ai_count      = max(1, min(4, ai_count))
        self.ai_difficulty = ai_difficulty
        self.custom_map    = custom_map  # optional Map Editor layout (obstacles + portals)
        # Seed system — generate one if not provided
        self.seed = seed if seed else generate_seed()
        self.rng  = SeedRNG(self.seed)
        self.ai_engines    = [SnakeAI(ai_difficulty, rng=SeedRNG(self.seed + f'_ai{i}'))
                              for i in range(self.ai_count)]
        self._enc_updates = {}
        self._enc_touch(f'ai_{ai_difficulty}', encountered=self.ai_count)
        self._init_layout()
        self.reset()

    # ── layout ──────────────────────────────────────────────────────────

    def _board_size(self):
        if isinstance(self.settings.board_size, str):
            m = {"small": 10, "medium": 15, "large": 20, "extra_large": 25}
            return m.get(self.settings.board_size, 15)
        return max(10, int(self.settings.board_size))

    def _init_layout(self):
        if self.custom_map:
            self.board_width  = self.custom_map.get('board_width', 20)
            self.board_height = self.custom_map.get('board_height', 20)
        else:
            size = self._board_size()
            self.board_width  = size
            self.board_height = size
        sw, sh = self.screen.get_width(), self.screen.get_height()
        hud_h = 70
        cs = min(sw, sh - hud_h) // max(self.board_width, self.board_height, 1)
        self.cell_size      = max(4, cs)
        self.board_offset_x = (sw - self.board_width  * self.cell_size) // 2
        self.board_offset_y = hud_h + (sh - hud_h - self.board_height * self.cell_size) // 2

    # ── reset ────────────────────────────────────────────────────────────

    def _enc_touch(self, entry_id, encountered=0, used=0):
        """Accumulate an encyclopedia encounter/use count for this match;
        flushed to disk at game-over via _flush_encyclopedia_updates()."""
        if not entry_id:
            return
        d = self._enc_updates.setdefault(entry_id, {'encountered': 0, 'used': 0})
        d['encountered'] += encountered
        d['used'] += used

    def reset(self):
        # Re-seed so restarting reproduces the exact same sequence for
        # this seed instead of continuing the RNG stream from before.
        self.rng = SeedRNG(self.seed)

        # Recreate the AI engines from scratch too — SnakeAI keeps its own
        # RNG stream *and* internal state (loop-detection history, move
        # counters); reusing the old objects here would carry that state
        # over from the previous match, so replaying "the same seed" via
        # Play Again wouldn't actually reproduce the same AI movements.
        self.ai_engines = [SnakeAI(self.ai_difficulty, rng=SeedRNG(self.seed + f'_ai{i}'))
                          for i in range(self.ai_count)]
        self._init_layout()
        bw, bh = self.board_width, self.board_height

        # Player 1 starts on the left
        self.p1_snake = [(bw // 6, bh // 2)]
        self.p1_dir   = (1, 0)
        self.p1_next  = (1, 0)
        self.p1_score = 0
        self.p1_alive = True

        # AI snakes start spread across the right side
        self.ai_snakes = []
        self.ai_dirs   = []
        self.ai_nexts  = []
        self.ai_scores = []
        self.ai_alive  = []
        positions = [
            (5 * bw // 6, bh // 2),
            (2 * bw // 3, bh // 4),
            (2 * bw // 3, 3 * bh // 4),
            (bw // 2, bh // 6),
        ]
        for i in range(self.ai_count):
            sx, sy = positions[i % len(positions)]
            self.ai_snakes.append([(sx, sy)])
            self.ai_dirs.append((-1, 0))
            self.ai_nexts.append((-1, 0))
            self.ai_scores.append(0)
            self.ai_alive.append(True)

        # Obstacles
        self.obstacles = []
        if self.custom_map:
            self.obstacles = [tuple(o) for o in self.custom_map.get('obstacles', [])]
        elif self.settings.enable_obstacles:
            self._gen_obstacles()

        # Portals
        self.portals = []
        if self.custom_map:
            for p in self.custom_map.get('portals', []):
                x1, y1, x2, y2, pal_idx = p
                self.portals.append(((x1, y1), (x2, y2), pal_idx))
        elif getattr(self.settings, 'enable_portals', False):
            self._gen_portals()

        if self.obstacles:
            self._enc_touch('obstacle_static', encountered=1)
        if self.portals:
            self._enc_touch('portal_pair', encountered=len(self.portals))
        self._enc_touch('mechanic_seeds', encountered=1)

        # Power-up state
        self.powerup_pos  = None
        self.powerup_type = None
        self.powerup_timer = 0
        self.powerup_spawn_interval = 15000
        self._spawn_powerup_check(0)

        self.fruit_pos  = self._new_fruit()
        self.fruit_type = _pick_cosmetic_fruit_type(getattr(self.settings, 'fruit_types_enabled', True), self.rng)
        self.game_over  = False
        self.winner     = None   # 'player', 'ai', 'draw'
        self.paused     = False
        self.last_tick  = time.time() * 1000
        self.start_time = time.time()
        self.game_history   = []    # per-tick snapshots for replay
        self._score_saved   = False # guard: save only once per game
        self._replay_mode   = False
        self._replay_idx    = 0

    def _gen_obstacles(self):
        all_snakes = list(self.p1_snake)
        for s in self.ai_snakes:
            all_snakes.extend(s)
        safe = set()
        for sx, sy in all_snakes:
            for dx in range(-3, 4):
                for dy in range(-3, 4):
                    safe.add((sx + dx, sy + dy))
        available = [(x, y) for x in range(self.board_width)
                     for y in range(self.board_height) if (x, y) not in safe]
        count = min(getattr(self.settings, 'obstacle_count', 5),
                    len(available) // 5, 25)
        if count > 0 and available:
            self.obstacles = self.rng.sample(available, count)

    def _gen_portals(self):
        occupied = (set(self.p1_snake) |
                    {c for s in self.ai_snakes for c in s} |
                    set(self.obstacles))
        candidates = [(x, y) for x in range(self.board_width)
                      for y in range(self.board_height)
                      if (x, y) not in occupied]
        if len(candidates) >= 4:
            pts = self.rng.sample(candidates, 4)
            self.portals = [(pts[0], pts[1], 0), (pts[2], pts[3], 1)]

    def _new_fruit(self):
        ai_cells = {c for s in self.ai_snakes for c in s}
        occupied = (set(self.p1_snake) | ai_cells |
                    set(self.obstacles) |
                    ({self.powerup_pos} if self.powerup_pos else set()))
        avail = [(x, y) for x in range(self.board_width)
                 for y in range(self.board_height)
                 if (x, y) not in occupied]
        return self.rng.choice(avail) if avail else None

    def _spawn_powerup_check(self, now_ms):
        if not getattr(self.settings, 'powerups_enabled', True):
            return
        if self.powerup_pos is None and now_ms - self.powerup_timer >= self.powerup_spawn_interval:
            all_cells = (set(self.p1_snake) |
                         {c for s in self.ai_snakes for c in s} |
                         set(self.obstacles) |
                         ({self.fruit_pos} if hasattr(self, 'fruit_pos') and self.fruit_pos else set()))
            avail = [(x, y) for x in range(self.board_width)
                     for y in range(self.board_height)
                     if (x, y) not in all_cells]
            if avail:
                self.powerup_pos   = self.rng.choice(avail)
                self.powerup_type  = self.rng.choice(['speed', 'double_points',
                                                      'invincible', 'shield'])
                self.powerup_timer = now_ms

    # ── input ────────────────────────────────────────────────────────────

    def handle_key(self, key):
        if   key == pygame.K_w     and self.p1_dir != ( 0,  1): self.p1_next = ( 0, -1)
        elif key == pygame.K_s     and self.p1_dir != ( 0, -1): self.p1_next = ( 0,  1)
        elif key == pygame.K_a     and self.p1_dir != ( 1,  0): self.p1_next = (-1,  0)
        elif key == pygame.K_d     and self.p1_dir != (-1,  0): self.p1_next = ( 1,  0)
        elif key == pygame.K_UP    and self.p1_dir != ( 0,  1): self.p1_next = ( 0, -1)
        elif key == pygame.K_DOWN  and self.p1_dir != ( 0, -1): self.p1_next = ( 0,  1)
        elif key == pygame.K_LEFT  and self.p1_dir != ( 1,  0): self.p1_next = (-1,  0)
        elif key == pygame.K_RIGHT and self.p1_dir != (-1,  0): self.p1_next = ( 1,  0)

    # ── update ───────────────────────────────────────────────────────────

    def _new_head(self, snake, direction):
        hx, hy = snake[0]
        dx, dy = direction
        if self.settings.wall_collision:
            nx, ny = hx + dx, hy + dy
            if not (0 <= nx < self.board_width and 0 <= ny < self.board_height):
                return None
            return (nx, ny)
        return ((hx + dx) % self.board_width, (hy + dy) % self.board_height)

    def _build_ai_occupied(self, ai_idx):
        """Blocked cells for AI snake ai_idx: obstacles + all other snakes."""
        occupied = list(self.obstacles)
        # Own body (excluding tail which will move away)
        occupied.extend(self.ai_snakes[ai_idx][:-1])
        # Player body
        occupied.extend(self.p1_snake[:-1])
        # Other AI bodies
        for j, s in enumerate(self.ai_snakes):
            if j != ai_idx:
                occupied.extend(s[:-1])
        return occupied

    def tick(self):
        if self.game_over or self.paused:
            return

        now_ms = time.time() * 1000
        self._spawn_powerup_check(now_ms)

        # ── AI decisions ─────────────────────────────────────────────────
        for i, engine in enumerate(self.ai_engines):
            if not self.ai_alive[i]:
                continue
            occ = self._build_ai_occupied(i)
            direction = engine.choose_direction(
                snake         = self.ai_snakes[i],
                occupied      = occ,
                fruit         = self.fruit_pos,
                board_w       = self.board_width,
                board_h       = self.board_height,
                portals       = self.portals,
                powerup_pos   = self.powerup_pos,
                wall_collision= self.settings.wall_collision,
                opponent_snake= self.p1_snake,
            )
            self.ai_nexts[i] = direction

        # ── Move all snakes ───────────────────────────────────────────────
        self.p1_dir = self.p1_next
        for i in range(self.ai_count):
            self.ai_dirs[i] = self.ai_nexts[i]

        h1 = self._new_head(self.p1_snake, self.p1_dir) if self.p1_alive else None

        ai_heads = []
        for i in range(self.ai_count):
            if self.ai_alive[i]:
                ai_heads.append(self._new_head(self.ai_snakes[i], self.ai_dirs[i]))
            else:
                ai_heads.append(None)

        obs_set = set(map(tuple, self.obstacles))
        pts     = max(1, int(10 * 1000 / max(1, self.settings.update_rate_ms)))

        # Portal teleport helper
        def _portal_teleport(pos):
            if not self.portals:
                return pos
            for a, b, _ in self.portals:
                if pos == tuple(a): return tuple(b)
                if pos == tuple(b): return tuple(a)
            return pos

        # ── Collision detection for player ────────────────────────────────
        p1_die = h1 is None
        if h1:
            h1 = _portal_teleport(h1)
            if h1 in obs_set:                         p1_die = True
            if h1 in set(self.p1_snake[:-1]):         p1_die = True
            for s in self.ai_snakes:
                if h1 in set(s):                      p1_die = True

        # ── Collision detection for AI ─────────────────────────────────────
        ai_die = [False] * self.ai_count
        for i in range(self.ai_count):
            if ai_heads[i] is None:
                ai_die[i] = True
                continue
            ai_heads[i] = _portal_teleport(ai_heads[i])
            h = ai_heads[i]
            if h in obs_set:                                    ai_die[i] = True
            if h in set(self.ai_snakes[i][:-1]):                ai_die[i] = True
            if self.p1_alive and h in set(self.p1_snake):      ai_die[i] = True
            for j, s in enumerate(self.ai_snakes):
                if j != i and h in set(s):                      ai_die[i] = True
            # Head-on with player
            if h1 and h == h1:
                p1_die = True
                ai_die[i] = True

        # ── Move + eat ────────────────────────────────────────────────────
        p1_ate = False
        if not p1_die and h1:
            self.p1_snake.insert(0, h1)
            if h1 == self.fruit_pos:
                self.p1_score += pts; p1_ate = True
            else:
                self.p1_snake.pop()
            if h1 == self.powerup_pos:
                self.powerup_pos  = None
                self.powerup_timer = time.time() * 1000
                self.p1_score += pts * 2

        for i in range(self.ai_count):
            if ai_die[i] or ai_heads[i] is None:
                continue
            h = ai_heads[i]
            self.ai_snakes[i].insert(0, h)
            if h == self.fruit_pos and not p1_ate:
                self.ai_scores[i] += pts
                p1_ate = True    # fruit consumed
            else:
                self.ai_snakes[i].pop()
            if h == self.powerup_pos:
                self.powerup_pos  = None
                self.powerup_timer = time.time() * 1000

        if p1_ate:
            self.fruit_pos = self._new_fruit()
            self.fruit_type = _pick_cosmetic_fruit_type(getattr(self.settings, 'fruit_types_enabled', True), self.rng)

        # ── Record snapshot (alive flags still at pre-death state) ───────────
        if not self.game_over and len(self.game_history) < 4000:
            self.game_history.append(self._snap())

        # ── Apply deaths ──────────────────────────────────────────────────
        if p1_die:  self.p1_alive = False
        for i in range(self.ai_count):
            if ai_die[i]: self.ai_alive[i] = False

        # ── End-of-game check ─────────────────────────────────────────────
        ai_all_dead = not any(self.ai_alive)
        if not self.p1_alive or ai_all_dead:
            self.game_over = True
            if not self.p1_alive and ai_all_dead:
                if self.p1_score >= max(self.ai_scores):
                    self.winner = 'player'
                elif self.p1_score < max(self.ai_scores):
                    self.winner = 'ai'
                else:
                    self.winner = 'draw'
            elif not self.p1_alive:
                self.winner = 'ai'
            else:
                self.winner = 'player'
            if not self._score_saved:
                self._score_saved = True
                self.save_score()

    # ── replay & save ─────────────────────────────────────────────────────

    def _snap(self):
        """Compact JSON-serialisable snapshot of current VS-AI game state."""
        return {
            'p1':  [list(c) for c in self.p1_snake],
            'p1s': self.p1_score,
            'p1a': self.p1_alive,
            'ais': [[list(c) for c in s] for s in self.ai_snakes],
            'ass': list(self.ai_scores),
            'aia': list(self.ai_alive),
            'fr':  list(self.fruit_pos) if self.fruit_pos else None,
            'ft':  getattr(self, 'fruit_type', 'regular'),
            'pp':  list(self.powerup_pos) if self.powerup_pos else None,
        }

    def _load_snap(self, snap):
        """Restore game state from a snapshot dict."""
        self.p1_snake  = [tuple(c) for c in snap['p1']]
        self.p1_score  = snap['p1s']
        self.p1_alive  = snap['p1a']
        self.ai_snakes = [[tuple(c) for c in s] for s in snap['ais']]
        self.ai_scores = list(snap['ass'])
        self.ai_alive  = list(snap['aia'])
        self.fruit_pos = tuple(snap['fr']) if snap['fr'] else None
        self.fruit_type = snap.get('ft', 'regular')
        self.powerup_pos = tuple(snap['pp']) if snap['pp'] else None

    def save_score(self):
        """Save player score to the shared high-scores file."""
        _flush_encyclopedia_updates(getattr(self, '_enc_updates', {}))
        self._enc_updates = {}

        if self.p1_score <= 0:
            return
        try:
            _gd = _load_data()
            highscores = _gd.get('highscores', [])
            if not isinstance(highscores, list):
                highscores = []
        except Exception:
            highscores = []

        game_id = f"{int(time.time())}-{self.rng.randint(1000,9999)}"
        player_name = getattr(self, 'player_name', '') or 'Player'
        has_replay  = len(self.game_history) > 0

        settings_dict = {k: v for k, v in vars(self.settings).items()
                         if isinstance(v, (int, float, str, bool, list, dict))}

        highscores.append({
            'name':            player_name,
            'score':           self.p1_score,
            'date':            datetime.now().strftime('%Y-%m-%d %H:%M'),
            'board_size':      self.board_width,
            'update_rate_ms':  self.settings.update_rate_ms,
            'victory':         self.winner == 'player',
            'wall_collision':  self.settings.wall_collision,
            'powerups_enabled':self.settings.powerups_enabled,
            'fruit_types_enabled': getattr(self.settings, 'fruit_types_enabled', True),
            'obstacles_enabled': self.settings.enable_obstacles,
            'portals_enabled': getattr(self.settings, 'enable_portals', False),
            'portal_pairs':    getattr(self.settings, 'portal_pairs', 0),
            'game_mode':       'vs_ai',
            'ai_difficulty':   self.ai_difficulty,
            'ai_count':        self.ai_count,
            'seed':            self.seed,
            'game_id':         game_id,
            'has_replay':      has_replay,
            'settings':        settings_dict,
            'custom_map':      self.custom_map,
            'actual_board_width':  self.board_width,
            'actual_board_height': self.board_height,
            'game_history':    self.game_history,
        })

        highscores.sort(key=lambda x: x['score'], reverse=True)
        highscores = highscores[:10]
        try:
            _gd2 = _load_data()
            _gd2['highscores'] = highscores
            _save_data(_gd2)
        except Exception as _e:
            print(f"VSAIGame: error saving score: {_e}")

    def start_replay(self, game_history):
        """Enter replay mode from a saved history list."""
        if not game_history:
            return False
        self.game_history  = game_history
        self._replay_mode  = True
        self._replay_idx   = 0
        self.game_over     = False
        self.paused        = False
        self._load_snap(game_history[0])
        return True

    def run_replay(self):
        """Replay viewer: plays back a saved VS-AI game."""
        clock      = pygame.time.Clock()
        paused     = False
        spd        = 1.0
        frame_ms   = self.settings.update_rate_ms
        last_adv   = time.time() * 1000

        while True:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    return
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_ESCAPE:
                        return
                    elif event.key == pygame.K_SPACE:
                        paused = not paused
                    elif event.key == pygame.K_RIGHT:
                        if self._replay_idx < len(self.game_history) - 1:
                            self._replay_idx += 1
                            self._load_snap(self.game_history[self._replay_idx])
                    elif event.key == pygame.K_LEFT:
                        if self._replay_idx > 0:
                            self._replay_idx -= 1
                            self._load_snap(self.game_history[self._replay_idx])
                    elif event.key in (pygame.K_EQUALS, pygame.K_PLUS, pygame.K_KP_PLUS):
                        spd = min(8.0, spd * 2)
                    elif event.key in (pygame.K_MINUS, pygame.K_KP_MINUS):
                        spd = max(0.25, spd / 2)
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    self._init_layout()

            now = time.time() * 1000
            if not paused and now - last_adv >= frame_ms / spd:
                if self._replay_idx < len(self.game_history) - 1:
                    self._replay_idx += 1
                    self._load_snap(self.game_history[self._replay_idx])
                last_adv = now

            # Draw game board
            sw, sh = self.screen.get_width(), self.screen.get_height()
            self.screen.fill(COLORS['dark_blue'])
            self._draw_hud()
            self._draw_board()
            for i in range(self.ai_count - 1, -1, -1):
                col = self.AI_COLOURS[i % len(self.AI_COLOURS)]
                self._draw_snake(self.ai_snakes[i], col['body'], col['head'], self.ai_alive[i])
            self._draw_snake(self.p1_snake, self.P1_BODY, self.P1_HEAD, self.p1_alive)
            if self.fruit_pos:
                bx, by, cs = self.board_offset_x, self.board_offset_y, self.cell_size
                fr = pygame.Rect(bx + self.fruit_pos[0] * cs, by + self.fruit_pos[1] * cs, cs, cs)
                if cs >= 10 and getattr(self.settings, 'fruit_types_enabled', True):
                    draw_fruit(self.screen, fr, getattr(self, 'fruit_type', 'regular'))
                else:
                    pygame.draw.rect(self.screen, COLORS['fruit'], fr)

            # Replay HUD overlay
            progress = self._replay_idx / max(1, len(self.game_history) - 1)
            bar_w = int(sw * 0.6)
            bar_x = (sw - bar_w) // 2
            bar_y = sh - 36
            pygame.draw.rect(self.screen, (50, 55, 80), (bar_x, bar_y, bar_w, 12), border_radius=6)
            pygame.draw.rect(self.screen, COLORS['light_blue'], (bar_x, bar_y, int(bar_w * progress), 12), border_radius=6)
            hf = get_font(self.settings.language, 'regular', 16)
            hints = f"SPACE pause  ←→ step  +/- speed ({spd:.2g}×)  ESC exit"
            hs = hf.render(hints, True, (180, 200, 230))
            self.screen.blit(hs, (sw // 2 - hs.get_width() // 2, sh - 20))
            lbl = hf.render("◀ REPLAY ▶", True, (255, 220, 80))
            self.screen.blit(lbl, (sw // 2 - lbl.get_width() // 2, bar_y - 22))

            pygame.display.flip()
            clock.tick(60)

    # ── draw ─────────────────────────────────────────────────────────────

    def draw(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        self.screen.fill(COLORS['dark_blue'])
        self._draw_hud()
        self._draw_board()
        # Draw AI snakes first (player appears on top)
        for i in range(self.ai_count - 1, -1, -1):
            col = self.AI_COLOURS[i % len(self.AI_COLOURS)]
            self._draw_snake(self.ai_snakes[i], col['body'], col['head'],
                             self.ai_alive[i])
        self._draw_snake(self.p1_snake, self.P1_BODY, self.P1_HEAD,
                         self.p1_alive)
        # Draw fruit
        if self.fruit_pos:
            bx, by, cs = self.board_offset_x, self.board_offset_y, self.cell_size
            fr = pygame.Rect(bx + self.fruit_pos[0] * cs,
                             by + self.fruit_pos[1] * cs, cs, cs)
            if cs >= 10 and getattr(self.settings, 'fruit_types_enabled', True):
                draw_fruit(self.screen, fr, getattr(self, 'fruit_type', 'regular'))
            else:
                pygame.draw.rect(self.screen, COLORS['fruit'], fr)
        # Draw powerup
        if self.powerup_pos:
            bx, by, cs = self.board_offset_x, self.board_offset_y, self.cell_size
            px = bx + self.powerup_pos[0] * cs + cs // 2
            py = by + self.powerup_pos[1] * cs + cs // 2
            r  = max(4, cs // 3)
            pulse = (math.sin(pygame.time.get_ticks() / 300) + 1) / 2
            pc    = (int(100 + 155 * pulse), int(50 + 100 * pulse), 255)
            pygame.draw.circle(self.screen, pc, (px, py), r)
            pygame.draw.circle(self.screen, (255, 255, 255), (px, py), max(2, r // 3))
        if self.game_over:
            self._draw_game_over()
        elif self.paused:
            self._draw_paused()
        pygame.display.flip()

    def _draw_board(self):
        bx, by = self.board_offset_x, self.board_offset_y
        bw_px  = self.board_width  * self.cell_size
        bh_px  = self.board_height * self.cell_size
        cs     = self.cell_size

        pygame.draw.rect(self.screen, COLORS['board_background'],
                         pygame.Rect(bx, by, bw_px, bh_px))
        for x in range(self.board_width + 1):
            pygame.draw.line(self.screen, COLORS['grid_line'],
                             (bx + x * cs, by), (bx + x * cs, by + bh_px), 1)
        for y in range(self.board_height + 1):
            pygame.draw.line(self.screen, COLORS['grid_line'],
                             (bx, by + y * cs), (bx + bw_px, by + y * cs), 1)
        for obs in self.obstacles:
            r = pygame.Rect(bx + obs[0] * cs, by + obs[1] * cs, cs, cs)
            pygame.draw.rect(self.screen, COLORS.get('obstacle', (100, 100, 100)), r)
        for a, b, _ in self.portals:
            for pos, col in [(a, (80, 180, 255)), (b, (255, 130, 60))]:
                cx = bx + pos[0] * cs + cs // 2
                cy = by + pos[1] * cs + cs // 2
                pygame.draw.circle(self.screen, col, (cx, cy), max(4, cs // 2 - 2))

    def _draw_snake(self, snake, body_col, head_col, alive):
        if not snake:
            return
        bc = body_col if alive else (100, 100, 100)
        hc = head_col if alive else ( 70,  70,  70)
        cs = self.cell_size
        bx, by = self.board_offset_x, self.board_offset_y
        for i, (sx, sy) in enumerate(snake):
            r   = pygame.Rect(bx + sx * cs + 1, by + sy * cs + 1, cs - 2, cs - 2)
            col = hc if i == 0 else bc
            pygame.draw.rect(self.screen, col, r,
                             border_radius=max(1, cs // 5))
            if i == 0 and cs > 10:
                es = max(2, cs // 7)
                ey = r.y + r.height // 3
                for ex in (r.x + r.width // 3, r.x + 2 * r.width // 3):
                    pygame.draw.circle(self.screen, (255, 255, 255), (ex, ey), es)
                    pygame.draw.circle(self.screen, (0, 0, 0), (ex, ey), max(1, es // 2))

    def _draw_hud(self):
        sw      = self.screen.get_width()
        hf      = get_font(self.settings.language, 'bold',    20)
        sf      = get_font(self.settings.language, 'regular', 13)
        diff_lbl = self.ai_difficulty.capitalize()

        you_lbl = get_text(self.settings.language, 'you_label').upper()
        ai_lbl  = get_text(self.settings.language, 'ai_label')
        p1c  = (100, 255, 100) if self.p1_alive else (130, 130, 130)
        p1s  = hf.render(f"{you_lbl}: {self.p1_score}", True, p1c)
        self.screen.blit(p1s, (10, 8))

        for i in range(self.ai_count):
            col  = self.AI_COLOURS[i % len(self.AI_COLOURS)]
            ac   = col['body'] if self.ai_alive[i] else (130, 130, 130)
            ais  = hf.render(f"{ai_lbl} {i+1}: {self.ai_scores[i]}", True, ac)
            self.screen.blit(ais, (sw - ais.get_width() - 10 - i * 130, 8))

        hint = sf.render(
            get_text(self.settings.language, 'vsai_controls_hint').format(diff=diff_lbl),
            True, (80, 110, 160))
        self.screen.blit(hint, (sw // 2 - hint.get_width() // 2, 40))

    def _draw_game_over(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        ov = pygame.Surface((sw, sh), pygame.SRCALPHA)
        ov.fill((0, 0, 0, 180))
        self.screen.blit(ov, (0, 0))

        bf = get_font(self.settings.language, 'bold',    52)
        mf = get_font(self.settings.language, 'bold',    28)
        sf = get_font(self.settings.language, 'regular', 22)

        if   self.winner == 'player': txt, col = get_text(self.settings.language, 'you_win_exclaim'), (100, 255, 100)
        elif self.winner == 'ai':     txt, col = get_text(self.settings.language, 'ai_wins'),          (255,  80,  80)
        else:                         txt, col = get_text(self.settings.language, 'vsai_draw'),        (255, 215,   0)

        ai_lbl = get_text(self.settings.language, 'ai_label')
        ai_score_str = "  ".join(f"{ai_lbl} {i+1}: {self.ai_scores[i]}"
                                  for i in range(self.ai_count))
        sc_txt = f"{get_text(self.settings.language, 'you_label')}: {self.p1_score}     {ai_score_str}"

        ts  = bf.render(txt,    True, col)
        scs = mf.render(sc_txt, True, COLORS['white'])

        saved_tag = sf.render(get_text(self.settings.language, 'score_replay_saved'), True, (100, 220, 100)) \
            if self._score_saved and self.p1_score > 0 else None
        seed_hint = sf.render(f"{get_text(self.settings.language, 'seed_label')}: {self.seed}", True, (120, 150, 200))

        self.screen.blit(ts,  (sw // 2 - ts.get_width()  // 2, sh // 2 - 130))
        self.screen.blit(scs, (sw // 2 - scs.get_width() // 2, sh // 2 -  70))
        if saved_tag:
            self.screen.blit(saved_tag, (sw // 2 - saved_tag.get_width() // 2, sh // 2 - 35))
        self.screen.blit(seed_hint, (sw // 2 - seed_hint.get_width() // 2, sh // 2 - 8))

        # --- Touch/mouse buttons — Play Again, Menu, Copy Seed, (View Replay) ---
        has_replay = bool(self.game_history)
        n_buttons = 4 if has_replay else 3
        gap = int(sw * 0.02)
        margin = int(sw * 0.04)
        available = sw - margin * 2 - gap * (n_buttons - 1)
        btn_w = max(90, min(220, available // n_buttons))
        btn_h = max(40, int(sh * 0.07))
        total_w = n_buttons * btn_w + (n_buttons - 1) * gap
        start_x = sw // 2 - total_w // 2
        by = sh // 2 + 25

        buttons = {}
        labels = [
            ('play_again', get_text(self.settings.language, 'play_again'), COLORS['green']),
            ('menu', get_text(self.settings.language, 'menu'), COLORS['button']),
            ('copy_seed', get_text(self.settings.language, 'copy_seed'), (100, 130, 200)),
        ]
        if has_replay:
            labels.append(('view_replay', get_text(self.settings.language, 'view_replay'), (170, 45, 170)))

        btn_font = get_font(self.settings.language, 'bold', max(14, int(sh * 0.025)))
        for i, (key, label, color) in enumerate(labels):
            rect = pygame.Rect(start_x + i * (btn_w + gap), by, btn_w, btn_h)
            pygame.draw.rect(self.screen, color, rect, border_radius=8)
            pygame.draw.rect(self.screen, COLORS['white'], rect, width=1, border_radius=8)
            text_surf = btn_font.render(label, True, COLORS['white'])
            max_w = rect.width - 14
            if text_surf.get_width() > max_w and text_surf.get_width() > 0:
                scale = max_w / text_surf.get_width()
                new_size = (max_w, max(1, int(text_surf.get_height() * scale)))
                text_surf = pygame.transform.smoothscale(text_surf, new_size)
            self.screen.blit(text_surf, text_surf.get_rect(center=rect.center))
            buttons[key] = rect
        self._go_buttons = buttons

        if getattr(self, '_seed_copied_until', 0) > time.time():
            note = sf.render(get_text(self.settings.language, 'seed_copied'), True, (140, 220, 140))
            self.screen.blit(note, note.get_rect(center=(sw // 2, by + btn_h + 22)))

        hint_font = get_font(self.settings.language, 'regular', 15)
        its = hint_font.render(get_text(self.settings.language, 'restart_hint_vsai'),
                                True, (150, 150, 170))
        self.screen.blit(its, (sw // 2 - its.get_width() // 2, by + btn_h + 44))

    def _draw_paused(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        ov = pygame.Surface((sw, sh), pygame.SRCALPHA)
        ov.fill((0, 0, 0, 110))
        self.screen.blit(ov, (0, 0))
        f  = get_font(self.settings.language, 'bold',    50)
        f2 = get_font(self.settings.language, 'regular', 22)
        s  = f.render(get_text(self.settings.language, 'paused').upper(), True, COLORS['white'])
        s2 = f2.render(get_text(self.settings.language, 'press_p_to_resume'), True, (180, 180, 210))
        self.screen.blit(s,  (sw // 2 - s.get_width()  // 2, sh // 2 - s.get_height() // 2))
        self.screen.blit(s2, (sw // 2 - s2.get_width() // 2, sh // 2 + 40))

    # ── main loop ────────────────────────────────────────────────────────

    def run(self):
        running = True
        clock   = pygame.time.Clock()

        while running:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif event.key == pygame.K_ESCAPE:
                        running = False
                    elif event.key == pygame.K_r and self.game_over:
                        self.reset()
                    elif event.key == pygame.K_w and self.game_over and self.game_history:
                        self.run_replay()
                    elif event.key == pygame.K_p and not self.game_over:
                        self.paused = not self.paused
                    elif not self.game_over and not self.paused:
                        self.handle_key(event.key)
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    mp = event.pos
                    if self.game_over and hasattr(self, '_go_buttons'):
                        gb = self._go_buttons
                        if gb.get('play_again') and gb['play_again'].collidepoint(mp):
                            self.reset()
                        elif gb.get('menu') and gb['menu'].collidepoint(mp):
                            running = False
                        elif gb.get('copy_seed') and gb['copy_seed'].collidepoint(mp):
                            if _copy_to_clipboard(str(self.seed)):
                                self._seed_copied_until = time.time() + 2.0
                        elif gb.get('view_replay') and gb['view_replay'].collidepoint(mp):
                            self.run_replay()
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode(
                        (event.w, event.h), pygame.RESIZABLE)
                    self._init_layout()

            now = time.time() * 1000
            if not self.paused and not self.game_over:
                if now - self.last_tick >= self.settings.update_rate_ms:
                    self.tick()
                    self.last_tick = now

            self.draw()
            clock.tick(60)


