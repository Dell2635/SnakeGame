class UISlider(UIWidget):
    def __init__(self, rect=None, minimum=0, maximum=100, value=0, step=1,
                 on_change=None, key=None, fmt=None, enabled=True):
        super().__init__(rect, key=key, enabled=enabled)
        self.min, self.max, self.step = minimum, maximum, step
        self.value = value
        self.on_change, self.fmt = on_change, fmt
        self.dragging = False

    def _track(self):
        r = self.rect
        return pygame.Rect(r.x + 10, r.centery - 3, max(1, r.w - 20), 6)

    def set_value(self, v, notify=True):
        v = _ui_clamp(v, self.min, self.max)
        if self.step:
            v = self.min + round((v - self.min) / self.step) * self.step
            v = _ui_clamp(v, self.min, self.max)
        if v != self.value:
            self.value = v
            if notify and self.on_change:
                self.on_change(v)

    def _value_at(self, x):
        t = self._track()
        frac = _ui_clamp((x - t.x) / float(t.w), 0.0, 1.0)
        return self.min + frac * (self.max - self.min)

    def handle_action(self, action, event=None):
        big = (self.max - self.min) / 10.0
        if action == 'MOVE_LEFT':
            self.set_value(self.value - self.step)
        elif action == 'MOVE_RIGHT':
            self.set_value(self.value + self.step)
        elif action == 'PAGE_DOWN':
            self.set_value(self.value - big)
        elif action == 'PAGE_UP':
            self.set_value(self.value + big)
        elif action == 'HOME':
            self.set_value(self.min)
        elif action == 'END':
            self.set_value(self.max)
        else:
            return False
        return True

    def mouse_down(self, pos):
        self.dragging = True
        self.set_value(self._value_at(pos[0]))

    def mouse_drag(self, pos):
        if self.dragging:
            self.set_value(self._value_at(pos[0]))

    def mouse_up(self, pos, inside):
        self.dragging = False

    def draw(self, surface):
        if not self.visible:
            return
        t, dis = self._track(), self.state == 'disabled'
        pygame.draw.rect(surface, UI_STYLE['disabled_bg'] if dis else COLORS['dark_gray'], t, border_radius=3)
        span = float(self.max - self.min) or 1.0
        frac = (self.value - self.min) / span
        fill = pygame.Rect(t.x, t.y, int(t.w * frac), t.h)
        pygame.draw.rect(surface, UI_STYLE['disabled_fg'] if dis else COLORS['light_blue'], fill, border_radius=3)
        knob = pygame.Rect(0, 0, 16, 22)
        knob.center = (t.x + int(t.w * frac), t.centery)
        pygame.draw.rect(surface, COLORS['white'], knob, border_radius=5)
        if self.fmt:
            s = ui_text_surface(self.lang(), 'regular', 14, self.fmt(self.value), COLORS['white'])
            surface.blit(s, (self.rect.right - s.get_width(), self.rect.y - 1))
        if self.show_focus:
            ui_draw_focus_ring(surface, self.rect.inflate(-4, 0), 6)


class UIDropdown(UIWidget):
    """Single-choice dropdown. The open list is drawn as an overlay above other
    widgets and captures the mouse until closed; keyboard: Enter/Space opens,
    Up/Down/Home/End/PgUp/PgDn move, Enter picks, Esc closes."""

    def __init__(self, options, rect=None, index=0, on_change=None, key=None,
                 size=16, max_rows=6, enabled=True):
        super().__init__(rect, key=key, enabled=enabled)
        self.options = options          # list of (value, label-or-callable)
        self.index, self.on_change, self.size = index, on_change, size
        self.max_rows, self.open, self.hi, self.top = max_rows, False, index, 0

    @property
    def value(self):
        return self.options[self.index][0] if self.options else None

    def _row_h(self):
        return max(24, self.size + 10)

    def _list_rect(self):
        n = min(len(self.options), self.max_rows)
        h = n * self._row_h()
        r = self.rect
        bounds = self.ui.bounds if self.ui else pygame.Rect(0, 0, 10 ** 5, 10 ** 5)
        y = r.bottom + 2
        if y + h > bounds.bottom and r.y - 2 - h >= bounds.y:
            y = r.y - 2 - h
        return pygame.Rect(r.x, y, r.w, h)

    def _open(self):
        if not self.options:
            return
        self.open, self.hi = True, self.index
        self._scroll_to_hi()
        if self.ui:
            self.ui.capture = self

    def _close(self):
        self.open = False
        if self.ui and self.ui.capture is self:
            self.ui.capture = None

    def _scroll_to_hi(self):
        if self.hi < self.top:
            self.top = self.hi
        elif self.hi >= self.top + self.max_rows:
            self.top = self.hi - self.max_rows + 1
        self.top = _ui_clamp(self.top, 0, max(0, len(self.options) - self.max_rows))

    def _pick(self, i):
        changed = i != self.index
        self.index = _ui_clamp(i, 0, len(self.options) - 1)
        self._close()
        if changed and self.on_change:
            self.on_change(self.value)

    def activate(self):
        if self.open:
            self._close()
        else:
            self._open()

    def on_blur(self):
        self._close()

    def handle_action(self, action, event=None):
        if not self.open:
            return super().handle_action(action, event)
        n = len(self.options)
        if action == 'MOVE_UP':
            self.hi = max(0, self.hi - 1)
        elif action == 'MOVE_DOWN':
            self.hi = min(n - 1, self.hi + 1)
        elif action == 'PAGE_UP':
            self.hi = max(0, self.hi - self.max_rows)
        elif action == 'PAGE_DOWN':
            self.hi = min(n - 1, self.hi + self.max_rows)
        elif action == 'HOME':
            self.hi = 0
        elif action == 'END':
            self.hi = n - 1
        elif action == 'CONFIRM':
            self._pick(self.hi)
            return True
        elif action == 'BACK':
            self._close()
            return True
        else:
            return True       # swallow everything else while open
        self._scroll_to_hi()
        return True

    def capture_mouse(self, event, pos):
        """Called by the manager while open. Returns True if the event was consumed."""
        lr = self._list_rect()
        if event.type == pygame.MOUSEMOTION:
            if lr.collidepoint(pos):
                self.hi = self.top + (pos[1] - lr.y) // self._row_h()
                self.hi = _ui_clamp(self.hi, 0, len(self.options) - 1)
            return True
        if event.type == pygame.MOUSEWHEEL:
            self.top = _ui_clamp(self.top - event.y, 0, max(0, len(self.options) - self.max_rows))
            return True
        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            if lr.collidepoint(pos):
                self._pick(self.top + (pos[1] - lr.y) // self._row_h())
            elif not self.rect.collidepoint(pos):
                self._close()
            else:
                self._close()
            return True
        return event.type in (pygame.MOUSEBUTTONUP,)

    def mouse_up(self, pos, inside):
        pass                     # opening is handled on mouse_down (capture takes over)

    def mouse_down(self, pos):
        self.activate()

    def draw(self, surface):
        if not self.visible:
            return
        r, st = self.rect, self.state
        dis = st == 'disabled'
        bg = UI_STYLE['disabled_bg'] if dis else COLORS['button']
        if st in ('hover', 'focused') and not dis:
            bg = _ui_shade(bg, 18)
        pygame.draw.rect(surface, bg, r, border_radius=6)
        label = self.val(self.options[self.index][1]) if self.options else ''
        s = ui_text_surface(self.lang(), 'regular', self.size, label,
                            UI_STYLE['disabled_fg'] if dis else COLORS['white'], max(1, r.w - 34))
        surface.blit(s, (r.x + 10, r.centery - s.get_height() // 2))
        cx, cy = r.right - 16, r.centery
        pts = [(cx - 5, cy + 3), (cx + 5, cy + 3), (cx, cy - 3)] if self.open else \
              [(cx - 5, cy - 3), (cx + 5, cy - 3), (cx, cy + 3)]
        pygame.draw.polygon(surface, COLORS['white'], pts)
        if self.show_focus:
            ui_draw_focus_ring(surface, r, 6)

    def draw_overlay(self, surface):
        if not (self.open and self.visible):
            return
        lr, rh = self._list_rect(), self._row_h()
        pygame.draw.rect(surface, UI_STYLE['popup_bg'], lr, border_radius=6)
        for k in range(min(len(self.options), self.max_rows)):
            i = self.top + k
            if i >= len(self.options):
                break
            row = pygame.Rect(lr.x, lr.y + k * rh, lr.w, rh)
            if i == self.hi:
                pygame.draw.rect(surface, COLORS['light_blue'], row.inflate(-4, -2), border_radius=4)
            s = ui_text_surface(self.lang(), 'regular', self.size, self.val(self.options[i][1]),
                                COLORS['white'], max(1, lr.w - 20))
            surface.blit(s, (row.x + 10, row.centery - s.get_height() // 2))
        pygame.draw.rect(surface, COLORS['light_blue'], lr, width=1, border_radius=6)


class UITextInput(UIWidget):
    """Single-line text field with caret editing. Focused == editing: while
    focused it receives printable characters and Backspace first (so typing is
    never mistaken for a shortcut); arrows/Home/End/Delete move the caret via
    semantic actions; Enter submits (and advances focus); Esc leaves the field."""
    captures_text = True

    def __init__(self, rect=None, text='', placeholder='', max_len=None, on_change=None,
                 on_submit=None, key=None, size=20, align='left', icon=None,
                 advance_on_submit=True, enabled=True):
        super().__init__(rect, key=key, enabled=enabled)
        self.text, self.placeholder, self.max_len = text, placeholder, max_len
        self.on_change, self.on_submit = on_change, on_submit
        self.size, self.align, self.icon = size, align, icon
        self.advance_on_submit = advance_on_submit
        self.caret = len(text)
        self.flash_until = 0

    def flash(self, ms=900):
        self.flash_until = pygame.time.get_ticks() + ms

    def set_text(self, text, notify=False):
        self.text = text
        self.caret = min(self.caret, len(text))
        if notify and self.on_change:
            self.on_change(self.text)

    def _changed(self):
        if self.on_change:
            self.on_change(self.text)

    def on_focus(self):
        self.caret = len(self.text)

    def handle_text(self, event):
        if event.type != pygame.KEYDOWN:
            return False
        if event.key == pygame.K_BACKSPACE:
            if self.caret > 0:
                self.text = self.text[:self.caret - 1] + self.text[self.caret:]
                self.caret -= 1
                self._changed()
            return True
        ch = getattr(event, 'unicode', '')
        if ch and ch.isprintable() and not (event.mod & (pygame.KMOD_CTRL | pygame.KMOD_ALT)):
            if self.max_len is None or len(self.text) < self.max_len:
                self.text = self.text[:self.caret] + ch + self.text[self.caret:]
                self.caret += len(ch)
                self._changed()
            return True
        return False

    def handle_action(self, action, event=None):
        if action == 'MOVE_LEFT':
            self.caret = max(0, self.caret - 1)
        elif action == 'MOVE_RIGHT':
            self.caret = min(len(self.text), self.caret + 1)
        elif action == 'HOME':
            self.caret = 0
        elif action == 'END':
            self.caret = len(self.text)
        elif action == 'DELETE':
            if self.caret < len(self.text):
                self.text = self.text[:self.caret] + self.text[self.caret + 1:]
                self._changed()
        elif action == 'CONFIRM':
            if self.on_submit:
                self.on_submit(self.text)
            if self.advance_on_submit and self.ui:
                self.ui.focus_step(1)
        elif action == 'BACK':
            if self.ui:
                self.ui.blur()
        else:
            return False
        return True

    def mouse_down(self, pos):
        # place caret at the click position
        inner = self.rect.inflate(-16, 0)
        pad = self._icon_pad()
        x = pos[0] - (inner.x + pad) + getattr(self, '_sx', 0)
        best, acc = len(self.text), 0
        for i in range(len(self.text) + 1):
            w = ui_text_size(self.lang(), 'regular', self.size, self.text[:i])[0]
            if w >= x:
                best = i if i == 0 or (w - x) < (x - acc) else i - 1
                break
            acc = w
        self.caret = best

    def mouse_up(self, pos, inside):
        pass

    def _icon_pad(self):
        return 28 if self.icon == 'search' else 0

    def draw(self, surface):
        if not self.visible:
            return
        r, lang = self.rect, self.lang()
        active = self.focused
        flashing = pygame.time.get_ticks() < self.flash_until
        bg = COLORS['light_gray'] if (active or flashing) else COLORS['gray']
        if UI_STYLE['input_bg'] is not None:
            bg = UI_STYLE['input_bg']
        pygame.draw.rect(surface, bg, r, border_radius=5)
        if flashing:
            pygame.draw.rect(surface, COLORS.get('red', (220, 60, 60)), r, width=2, border_radius=5)
        inner = r.inflate(-16, 0)
        pad = self._icon_pad()
        if self.icon == 'search':
            ic = 18
            icon_rect = pygame.Rect(r.x + 7, r.centery - ic // 2 - 1, ic - 4, ic - 4)
            pygame.draw.circle(surface, COLORS['dark_gray'], icon_rect.center, icon_rect.w // 2, 2)
            pygame.draw.line(surface, COLORS['dark_gray'], (icon_rect.right - 2, icon_rect.bottom - 2),
                             (icon_rect.right + 4, icon_rect.bottom + 4), 2)
        area = pygame.Rect(inner.x + pad, r.y, max(1, inner.w - pad), r.h)
        old = surface.get_clip()
        surface.set_clip(old.clip(area))
        size = max(10, min(self.size, r.h - 6))
        if not self.text and not active:
            s = ui_text_surface(lang, 'regular', size, self.val(self.placeholder), COLORS['dark_gray'], area.w)
            x = area.x if self.align == 'left' else area.centerx - s.get_width() // 2
            surface.blit(s, (x, r.centery - s.get_height() // 2))
        else:
            font = get_font(lang, 'regular', size)
            s = ui_text_surface(lang, 'regular', size, self.text, COLORS['black']) if self.text else None
            tw = s.get_width() if s else 0
            caret_x = font.size(self.text[:self.caret])[0]
            if tw <= area.w:
                self._sx = 0
                x0 = area.x if self.align == 'left' else area.centerx - tw // 2
            else:
                sx = getattr(self, '_sx', 0)
                if caret_x - sx > area.w - 4:
                    sx = caret_x - area.w + 4
                elif caret_x - sx < 0:
                    sx = caret_x
                self._sx = sx = _ui_clamp(sx, 0, tw - area.w + 4)
                x0 = area.x - sx
            if s:
                surface.blit(s, (x0, r.centery - s.get_height() // 2))
            if active and (pygame.time.get_ticks() // 500) % 2 == 0:
                cx = x0 + caret_x
                pygame.draw.line(surface, COLORS['black'], (cx, r.centery - size // 2),
                                 (cx, r.centery + size // 2), 2)
        surface.set_clip(old)
        if self.show_focus:
            ui_draw_focus_ring(surface, r, 5)


class UITabBar(UIWidget):
    """Tab strip: one focus stop, Left/Right (or Home/End) change tab. Tabs are laid
    out with UIHorizontalFlow(wrap=True) so long labels wrap onto extra rows instead
    of being squeezed into unreadable widths; call height_for(width) to size it."""

    def __init__(self, tabs, rect=None, selected=0, on_change=None, key=None, size=14,
                 min_tab_w=70, gap=6, row_h=None):
        super().__init__(rect, key=key)
        self.tabs = tabs                # list of (key, label-or-callable)
        self.selected, self.on_change, self.size = selected, on_change, size
        self.min_tab_w, self.gap = min_tab_w, gap
        self.row_h = row_h
        self._rects = []

    def _row_height(self):
        return self.row_h or max(30, get_font(self.lang(), 'bold', self.size).get_height() + 14)

    def _flow(self, width):
        f = UIHorizontalFlow(pygame.Rect(0, 0, width, 0), spacing=self.gap, row_spacing=self.gap, wrap=True)
        rh = self._row_height()
        for k, label in self.tabs:
            w = ui_text_size(self.lang(), 'bold', self.size, self.val(label))[0] + 24
            f.add(k, w, min_w=min(self.min_tab_w, w), h=rh, flex=1)
        return f.solve()

    def height_for(self, width):
        return self._flow(width).height

    def selected_key(self):
        return self.tabs[self.selected][0] if self.tabs else None

    def select(self, i, notify=True):
        i = _ui_clamp(i, 0, len(self.tabs) - 1)
        if i != self.selected:
            self.selected = i
            if notify and self.on_change:
                self.on_change(self.tabs[i][0])

    def handle_action(self, action, event=None):
        if action == 'MOVE_LEFT' and self.selected > 0:
            self.select(self.selected - 1)
        elif action == 'MOVE_RIGHT' and self.selected < len(self.tabs) - 1:
            self.select(self.selected + 1)
        elif action == 'HOME':
            self.select(0)
        elif action == 'END':
            self.select(len(self.tabs) - 1)
        else:
            return False
        return True

    def _tab_rects(self):
        res = self._flow(self.rect.w)
        return [(k, res.rects[k].move(self.rect.x, self.rect.y)) for k, _ in self.tabs if k in res.rects]

    def mouse_down(self, pos):
        for i, (k, rc) in enumerate(self._tab_rects()):
            if rc.collidepoint(pos):
                self.select(i)
                return

    def mouse_up(self, pos, inside):
        pass

    def draw(self, surface):
        if not self.visible:
            return
        lang = self.lang()
        for i, (k, rc) in enumerate(self._tab_rects()):
            active = i == self.selected
            pygame.draw.rect(surface, (55, 110, 190) if active else (35, 45, 70), rc, border_radius=6)
            pygame.draw.rect(surface, (90, 130, 200), rc, width=1, border_radius=6)
            s = ui_text_surface(lang, 'bold', self.size, self.val(self.tabs[i][1]), COLORS['white'], rc.w - 6)
            surface.blit(s, s.get_rect(center=rc.center))
            if active and self.show_focus:
                ui_draw_focus_ring(surface, rc, 6)

class UIScrollView(UIWidget):
    """Clipped viewport over taller content. Owns a ScrollBar (the existing one)
    and children positioned in *content space* (`content_rect`); sync() maps them
    to screen coordinates. Use relayout(build) to (re)build content: the layout
    runs at full width first and is redone with the scrollbar gutter reserved
    only if the content turns out to be taller than the viewport."""
    focusable = False
    interactive = False

    def __init__(self, rect=None, key=None, bg=None, border=None, radius=None, padding=0):
        super().__init__(rect, key=key)
        self.bg, self.border = bg, border
        self.radius = UI_STYLE['radius'] if radius is None else radius
        self.padding = _ui_insets(padding)
        self.children = []
        self.scrollbar = ScrollBar(0, 0, 10, 10, 0)
        self.viewport = pygame.Rect(0, 0, 0, 0)
        self.set_rect(self.rect)

    @property
    def gutter(self):
        return self.scrollbar.bar_width + 4

    @property
    def needs_scroll(self):
        return self.scrollbar.needs_scroll

    def set_rect(self, rect):
        self.rect = pygame.Rect(rect)
        pl, pt, pr, pb = self.padding
        r = self.rect
        self.viewport = pygame.Rect(r.x + pl, r.y + pt, max(0, r.w - pl - pr), max(0, r.h - pt - pb))
        v = self.viewport
        self.scrollbar.set_geometry(v.x, v.y, v.w, v.h)
        self.scrollbar.wheel_rect = self.rect
        self.sync()

    def clear_children(self):
        self.children = []

    def add(self, widget, content_rect):
        widget.content_rect = pygame.Rect(content_rect)
        widget.scroll_parent = self
        widget.ui = self.ui
        self.children.append(widget)
        return widget

    def set_content_height(self, h):
        self.scrollbar.set_content_height(h)
        self.sync()

    def relayout(self, build):
        """build(width) must add children (content-space rects) and return content height."""
        for attempt in (0, 1):
            self.clear_children()
            w = self.viewport.w - (self.gutter if attempt else 0)
            ch = build(max(1, w))
            self.scrollbar.set_content_height(ch)
            if ch <= self.viewport.h:
                break
        if self.ui is not None:
            self.ui._adopt(self)
        self.sync()

    def sync(self):
        off = self.scrollbar.get_content_offset()
        v = self.viewport
        for c in self.children:
            if c.content_rect is not None:
                c.rect = c.content_rect.move(v.x, v.y - off)

    def update(self, dt=None):
        self.scrollbar.update(dt)
        self.sync()

    def ensure_child_visible(self, widget):
        cr = widget.content_rect
        if cr is not None:
            self.scrollbar.ensure_visible(cr.top, cr.bottom)

    def draw_background(self, surface):
        if self.bg is not None:
            pygame.draw.rect(surface, self.bg, self.rect, border_radius=self.radius)
        if self.border is not None:
            pygame.draw.rect(surface, self.border, self.rect, width=1, border_radius=self.radius)

    def draw(self, surface):
        if not self.visible:
            return
        self.sync()
        self.draw_background(surface)
        old = surface.get_clip()
        surface.set_clip(old.clip(self.viewport))
        for c in self.children:
            if c.visible and c.rect.colliderect(self.viewport):
                c.draw(surface)
        surface.set_clip(old)
        self.scrollbar.draw(surface)


class UIListView(UIScrollView):
    """Virtualised list: only visible rows are drawn, so 10 or 10,000 rows cost the
    same. One focus stop for the whole list; Up/Down/PgUp/PgDn/Home/End move the
    selection, Enter activates, Delete requests deletion. At the first/last row the
    key is not consumed so focus can leave the list."""
    focusable = True
    interactive = True

    def __init__(self, rect=None, row_h=40, draw_row=None, key=None, bg=None, border=None,
                 radius=None, padding=0, on_select=None, on_activate_row=None,
                 on_delete=None, on_row_click=None):
        self.row_h, self.draw_row = row_h, draw_row
        self.on_select, self.on_activate_row = on_select, on_activate_row
        self.on_delete, self.on_row_click = on_delete, on_row_click
        self.count, self.selected = 0, -1
        self._down_row = -1
        super().__init__(rect, key=key, bg=bg, border=border, radius=radius, padding=padding)

    def hit(self, pos):
        return (self.visible and self.viewport.collidepoint(pos) and
                not (self.needs_scroll and self.scrollbar.bar_rect.collidepoint(pos)))

    @property
    def row_width(self):
        return self.viewport.w - (self.gutter if self.needs_scroll else 0)

    def set_count(self, n, keep_scroll=True):
        self.count = max(0, n)
        self.scrollbar.set_content_height(self.count * self.row_h)
        if self.selected >= self.count:
            self.selected = self.count - 1
        if not keep_scroll:
            self.scrollbar.home(immediate=True)

    def set_rect(self, rect):
        super().set_rect(rect)
        self.scrollbar.set_content_height(self.count * self.row_h)

    def row_rect(self, i):
        off = self.scrollbar.get_content_offset()
        return pygame.Rect(self.viewport.x, self.viewport.y + i * self.row_h - off,
                           self.row_width, self.row_h)

    def row_at(self, pos):
        if not self.viewport.collidepoint(pos):
            return -1
        off = self.scrollbar.get_content_offset()
        i = (pos[1] - self.viewport.y + off) // self.row_h
        return i if 0 <= i < self.count else -1

    def select(self, i, notify=True, scroll=True):
        if self.count == 0:
            self.selected = -1
            return
        i = _ui_clamp(i, 0, self.count - 1)
        changed = i != self.selected
        self.selected = i
        if scroll:
            self.scrollbar.ensure_visible(i * self.row_h, (i + 1) * self.row_h, margin=0)
        if changed and notify and self.on_select:
            self.on_select(i)

    def on_focus(self):
        if self.selected < 0 and self.count:
            self.select(0)

    def handle_action(self, action, event=None):
        n = self.count
        page = max(1, self.viewport.h // self.row_h - 1)
        if action == 'MOVE_UP':
            if n and self.selected > 0:
                self.select(self.selected - 1)
                return True
            return False
        if action == 'MOVE_DOWN':
            if n and self.selected < n - 1:
                self.select(self.selected + 1)
                return True
            return False
        if action == 'PAGE_UP':
            self.select(max(0, self.selected - page)) if n else None
            return True
        if action == 'PAGE_DOWN':
            self.select(min(n - 1, max(0, self.selected) + page)) if n else None
            return True
        if action == 'HOME':
            self.select(0) if n else None
            return True
        if action == 'END':
            self.select(n - 1) if n else None
            return True
        if action == 'CONFIRM':
            if 0 <= self.selected < n and self.on_activate_row:
                self.on_activate_row(self.selected)
            return True
        if action == 'DELETE':
            if 0 <= self.selected < n and self.on_delete:
                self.on_delete(self.selected)
                return True
            return False
        return False

    def mouse_down(self, pos):
        self._down_row = self.row_at(pos)
        if self._down_row >= 0:
            self.select(self._down_row, scroll=False)

    def mouse_up(self, pos, inside):
        row = self.row_at(pos)
        if inside and row >= 0 and row == self._down_row and self.on_row_click:
            rr = self.row_rect(row)
            self.on_row_click(row, (pos[0] - rr.x, pos[1] - rr.y))
        self._down_row = -1

    def draw(self, surface):
        if not self.visible:
            return
        self.draw_background(surface)
        old = surface.get_clip()
        surface.set_clip(old.clip(self.viewport))
        off = self.scrollbar.get_content_offset()
        first = max(0, off // self.row_h)
        last = min(self.count, (off + self.viewport.h) // self.row_h + 2)
        if self.draw_row:
            for i in range(first, last):
                self.draw_row(surface, self.row_rect(i), i, i == self.selected,
                              self.focused and i == self.selected and self.show_focus)
        if self.show_focus and 0 <= self.selected < self.count:
            rr = self.row_rect(self.selected).clip(self.viewport)
            ui_draw_focus_ring(surface, rr.inflate(-6, -6), 6)
        surface.set_clip(old)
        self.scrollbar.draw(surface)


# ── Layers: dialogs and popups that trap focus ────────────────────────────
_ui_dim_cache = {}


class UILayer:
    """A modal layer drawn above the base UI. While it is on top of the
    UIManager's layer stack, only ITS widgets can receive focus or mouse input,
    which is what keeps hidden/background widgets from stealing focus."""

    def __init__(self, ui, dim=True, dismiss_on_outside=False, on_dismiss=None):
        self.ui, self.dim = ui, dim
        self.dismiss_on_outside, self.on_dismiss = dismiss_on_outside, on_dismiss
        self.rect = pygame.Rect(0, 0, 0, 0)
        self._prev_focus_key = None

    def roots(self):
        return []

    def layout(self, bounds):
        pass

    def draw(self, surface):
        pass

    def default_widget(self):
        return None

    def on_back(self):
        self.dismiss()

    def dismiss(self):
        self.ui.pop_layer(self)
        if self.on_dismiss:
            self.on_dismiss()

    def draw_dim(self, surface):
        if not self.dim:
            return
        size = surface.get_size()
        d, cached = _lru_cache_get(_ui_dim_cache, size)
        if not cached:
            d = pygame.Surface(size, pygame.SRCALPHA)
            d.fill(UI_STYLE['dim_overlay'])
            _lru_cache_put(_ui_dim_cache, size, d, 4)
        surface.blit(d, (0, 0))


class UIPopupLayer(UILayer):
    """Titled box with a scrollable body and a row of footer buttons. Sizes itself
    from its content and the window (body scrolls when the window is short), can be
    anchored to another widget, and wraps footer buttons onto extra rows if narrow.
    Used for confirmation dialogs (ui_dialog) and the High Scores filter popup."""

    def __init__(self, ui, title=None, build_body=None, footer=(), on_result=None,
                 anchor=None, width=420, cancel_key=None, default_key=None, dim=True,
                 dismiss_on_outside=False, on_dismiss=None, border=None):
        super().__init__(ui, dim=dim, dismiss_on_outside=dismiss_on_outside, on_dismiss=on_dismiss)
        self.title, self.build_body = title, build_body
        self.on_result, self.anchor, self.width_pref = on_result, anchor, width
        self.cancel_key, self.default_key = cancel_key, default_key
        self.border = border if border is not None else COLORS['light_blue']
        self.body = UIScrollView()
        self.body.ui = ui
        self.buttons = []
        for key, text, color in footer:
            b = UIButton(text, color=color, key=key, font_size=16, radius=6,
                         on_activate=(lambda k=key: self.finish(k)))
            b.ui = ui
            self.buttons.append(b)
        self._title_rect = pygame.Rect(0, 0, 0, 0)

    def roots(self):
        return [self.body] + self.buttons

    def default_widget(self):
        for b in self.buttons:
            if b.key == self.default_key:
                return b
        return self.buttons[0] if self.buttons else None

    def finish(self, key):
        self.ui.pop_layer(self)
        if self.on_result:
            self.on_result(key)
        if self.on_dismiss and key == self.cancel_key:
            self.on_dismiss()

    def on_back(self):
        if self.cancel_key is not None:
            self.finish(self.cancel_key)
        else:
            self.dismiss()

    def layout(self, bounds):
        lang = self.ui.language
        margin, pad, gap = 12, 14, 10
        W = max(160, min(self.width_pref, bounds.w - 2 * margin))
        inner_w = W - 2 * pad
        title_h = (get_font(lang, 'bold', 20).get_height() + 4) if self.title else 0
        # footer buttons: wrap onto extra rows when they do not fit
        fl = UIHorizontalFlow(pygame.Rect(0, 0, inner_w, 0), spacing=8, row_spacing=6, wrap=True)
        for b in self.buttons:
            b.ui = self.ui
            fl.add(b.key, max(80, b.preferred_width()), min_w=60, h=34, flex=1)
        fres = fl.solve()
        footer_h = fres.height
        max_body = max(40, bounds.h - 2 * margin - 2 * pad - title_h - footer_h - 2 * gap)
        body = self.body
        body.ui = self.ui
        build = self.build_body or (lambda w: 0)
        body.set_rect(pygame.Rect(0, 0, inner_w, 10 ** 4))
        body.relayout(build)
        content_h = body.scrollbar.content_height
        body_h = min(content_h, max_body)
        H = pad + title_h + (gap if title_h else 0) + body_h + gap + footer_h + pad
        if self.anchor is not None:
            x = _ui_clamp(self.anchor.centerx - W // 2, bounds.x + margin, bounds.right - margin - W)
            y = self.anchor.bottom + 8
            if y + H > bounds.bottom - margin:
                above = self.anchor.top - 8 - H
                y = above if above >= bounds.y + margin else max(bounds.y + margin, bounds.bottom - margin - H)
        else:
            x, y = bounds.centerx - W // 2, bounds.centery - H // 2
        self.rect = pygame.Rect(x, y, W, H)
        cy = y + pad
        self._title_rect = pygame.Rect(x + pad, cy, inner_w, title_h)
        cy += title_h + (gap if title_h else 0)
        body.set_rect(pygame.Rect(x + pad, cy, inner_w, body_h))
        body.relayout(build)
        cy += body_h + gap
        for b in self.buttons:
            rc = fres.rects[b.key]
            b.rect = rc.move(x + pad, cy)
        self.ui._adopt(body)

    def draw(self, surface):
        self.draw_dim(surface)
        pygame.draw.rect(surface, UI_STYLE['popup_bg'], self.rect, border_radius=10)
        pygame.draw.rect(surface, self.border, self.rect, width=2, border_radius=10)
        if self.title:
            s = ui_text_surface(self.ui.language, 'bold', 20, self.title, COLORS['white'],
                                self._title_rect.w)
            surface.blit(s, (self._title_rect.x, self._title_rect.y))
            ly = self._title_rect.bottom + 2
            pygame.draw.line(surface, self.border, (self.rect.x + 10, ly), (self.rect.right - 10, ly), 1)
        self.body.draw(surface)
        for b in self.buttons:
            b.draw(surface)


def ui_dialog(ui, title, message, buttons, on_result, cancel_key=None, default_key=None):
    """Confirmation/message dialog. `buttons`: [(key, text_or_callable, colour)]."""
    def build(width):
        lab = UILabel(message, size=17, wrap=True, align='center', color=COLORS['white'])
        lab.ui = ui
        h = lab.measure(width)
        ui_lab = lab
        body_add(ui_lab, pygame.Rect(0, 0, width, h))
        return h

    dlg = UIPopupLayer(ui, title=title, build_body=None, footer=buttons, on_result=on_result,
                       width=440, cancel_key=cancel_key, default_key=default_key,
                       border=COLORS.get('red', (220, 60, 60)))

    def body_add(widget, rect):
        dlg.body.add(widget, rect)

    dlg.build_body = build
    ui.push_layer(dlg)
    return dlg


# ── Manager: focus, event routing, drawing ────────────────────────────────
class UIManager:
    """Per-screen UI root. A screen creates one, adds widgets in *logical focus
    order*, and forwards pygame events:

        action = ui.handle_event(event)      # None if consumed by the UI
        ui.update(dt);  ui.draw(surface)

    handle_event returns an *unconsumed semantic action name* (e.g. 'BACK',
    'TOGGLE_FULLSCREEN', 'EXIT_GAME') so the screen decides what those mean.
    Focus, Tab/Shift+Tab, arrow (spatial) navigation, scrolling keys, modal
    focus trapping and mouse routing are all implemented here once."""

    def __init__(self, get_bounds, language='en'):
        self.get_bounds = get_bounds
        self.language = language
        self.pulse = 0.5
        self.mouse_pos = None          # tests / managers may pin the pointer
        self.widgets = []
        self.layers = []
        self.capture = None            # widget that temporarily owns the mouse (open dropdown)
        self.focused = None
        self.focus_visible = True
        self.mouse_owner = None

    # -- basics ----------------------------------------------------------------
    @property
    def bounds(self):
        return pygame.Rect(self.get_bounds())

    def _mouse(self):
        return self.mouse_pos if self.mouse_pos is not None else pygame.mouse.get_pos()

    def _adopt(self, w):
        w.ui = self
        for c in getattr(w, 'children', ()):
            self._adopt(c)

    def add(self, widget):
        self._adopt(widget)
        self.widgets.append(widget)
        return widget

    def clear(self, keep_focus=True):
        """Remove every base widget (call before rebuilding a layout). The focused
        widget's key is remembered so restore_focus() can put focus back."""
        self._focus_key = self.focused.key if (keep_focus and self.focused) else None
        if self.focused:
            self.focused.focused = False
        self.focused = None
        self.widgets = []
        self.capture = None
        self.mouse_owner = None

    def restore_focus(self, default_key=None):
        k = getattr(self, '_focus_key', None)
        if not (k is not None and self.focus_key(k)):
            if default_key is not None:
                self.focus_key(default_key)

    def find(self, key):
        for w in self._all_widgets():
            if w.key == key:
                return w
        return None

    # -- traversal ---------------------------------------------------------------
    def _roots(self):
        return self.layers[-1].roots() if self.layers else self.widgets

    @staticmethod
    def _flatten(roots):
        out = []
        for w in roots:
            out.append(w)
            ch = getattr(w, 'children', None)
            if ch:
                out.extend(UIManager._flatten(ch))
        return out

    def _all_widgets(self):
        out = self._flatten(self.widgets)
        for L in self.layers:
            out.extend(self._flatten(L.roots()))
        return out

    def active_widgets(self):
        return self._flatten(self._roots())

    def scroll_views(self):
        return [w for w in self.active_widgets() if isinstance(w, UIScrollView) and w.visible]

    # -- layers ------------------------------------------------------------------
    def push_layer(self, layer):
        layer._prev_focus_key = self.focused.key if self.focused else None
        self.layers.append(layer)
        layer.layout(self.bounds)
        self._adopt_layer(layer)
        self.blur()
        d = layer.default_widget()
        if d is not None:
            self.set_focus(d)
        return layer

    def _adopt_layer(self, layer):
        for r in layer.roots():
            self._adopt(r)

    def pop_layer(self, layer):
        if layer in self.layers:
            self.layers.remove(layer)
        self.blur()
        if not self.layers and layer._prev_focus_key is not None:
            self.focus_key(layer._prev_focus_key)

    def on_resize(self):
        for L in self.layers:
            L.layout(self.bounds)
            self._adopt_layer(L)

    # -- focus -------------------------------------------------------------------
    def _candidates(self):
        b = self.bounds
        out = []
        for w in self.active_widgets():
            if not w.is_focusable():
                continue
            # A widget inside a scroll view is reachable (focus scrolls it into view);
            # a plain widget lying outside the window is not focusable.
            if w.scroll_parent is None and not w.rect.colliderect(b):
                continue
            if w.scroll_parent is not None and not w.scroll_parent.visible:
                continue
            out.append(w)
        if any(w.tab_index is not None for w in out):
            out.sort(key=lambda w: (w.tab_index is None, w.tab_index if w.tab_index is not None else 0))
        return out

    def set_focus(self, widget, visible=True):
        if widget is self.focused:
            if visible:
                self.focus_visible = True
            return
        old = self.focused
        if old is not None:
            old.focused = False
            old.pressed = False
            old.on_blur()
        self.focused = widget
        if visible:
            self.focus_visible = True
        if widget is not None:
            widget.focused = True
            widget.on_focus()
            sp = widget.scroll_parent
            if sp is not None:
                sp.ensure_child_visible(widget)
                sp.sync()

    def blur(self):
        self.set_focus(None, visible=False)

    def focus_key(self, key):
        for w in self._candidates():
            if w.key == key:
                self.set_focus(w)
                return True
        return False

    def focus_step(self, delta):
        cands = self._candidates()
        if not cands:
            return False
        if self.focused in cands:
            i = (cands.index(self.focused) + delta) % len(cands)
        else:
            i = 0 if delta > 0 else len(cands) - 1
        self.set_focus(cands[i])
        return True

    def validate_focus(self):
        """Drop focus from a widget that became disabled/hidden/removed/off-screen."""
        f = self.focused
        if f is not None and f not in self._candidates():
            self.blur()

    def _spatial(self, direction, wrap=True):
        f = self.focused
        cands = [w for w in self._candidates() if w is not f]
        if not cands:
            return None
        if f is None or f not in self.active_widgets():
            return cands[0] if direction in ('MOVE_DOWN', 'MOVE_RIGHT') else cands[-1]
        fr = f.rect
        best, best_s = None, None
        far, far_s = None, None
        for w in cands:
            r = w.rect
            if direction in ('MOVE_UP', 'MOVE_DOWN'):
                sign = 1 if direction == 'MOVE_DOWN' else -1
                d = (r.centery - fr.centery) * sign
                gap = (r.top - fr.bottom) if sign > 0 else (fr.top - r.bottom)
                perp = max(0, max(r.left - fr.right, fr.left - r.right))
                off = abs(r.centerx - fr.centerx)
            else:
                sign = 1 if direction == 'MOVE_RIGHT' else -1
                d = (r.centerx - fr.centerx) * sign
                gap = (r.left - fr.right) if sign > 0 else (fr.left - r.right)
                perp = max(0, max(r.top - fr.bottom, fr.top - r.bottom))
                off = abs(r.centery - fr.centery)
            if d > 0:
                s = max(0, gap) + perp * 3 + off * 0.01 + d * 0.001
                if best_s is None or s < best_s:
                    best, best_s = w, s
            else:
                s = perp * 3 + off * 0.01 + d          # d <= 0: farther away => smaller score
                if far_s is None or s < far_s:
                    far, far_s = w, s
        if best is not None:
            return best
        return far if wrap else None

    def _spatial_nowrap(self, direction):
        return self._spatial(direction, wrap=False)

    def active_scroll_view(self):
        f = self.focused
        if f is not None:
            if isinstance(f, UIScrollView):
                return f
            if f.scroll_parent is not None:
                return f.scroll_parent
        views = [v for v in self.scroll_views() if v.needs_scroll]
        if not views:
            return None
        mp = self._mouse()
        for v in views:
            if v.rect.collidepoint(mp):
                return v
        return views[0]

    # -- events --------------------------------------------------------------------
    def handle_event(self, event):
        t = event.type
        if t in (pygame.MOUSEMOTION, pygame.MOUSEBUTTONDOWN, pygame.MOUSEBUTTONUP, pygame.MOUSEWHEEL):
            return self._handle_mouse(event)
        if t == pygame.KEYDOWN:
            return self._handle_key(event)
        return None

    def _topmost(self, pos):
        for w in reversed(self.active_widgets()):
            if w.hit(pos):
                return w
        return None

    def _handle_mouse(self, event):
        t = event.type
        pos = getattr(event, 'pos', None) or self._mouse()
        if t == pygame.MOUSEBUTTONUP and event.button == 1:
            for v in self.scroll_views():
                v.scrollbar.handle_event(event, pos)
            o = self.mouse_owner
            if o is not None:
                o.pressed = False
                self.mouse_owner = None
                o.mouse_up(pos, o.hit(pos))
            return None
        if self.capture is not None:
            if self.capture.capture_mouse(event, pos):
                return None
        if t == pygame.MOUSEMOTION:
            for v in self.scroll_views():
                v.scrollbar.handle_event(event, pos)
            if self.mouse_owner is not None:
                self.mouse_owner.mouse_drag(pos)
            top = self._topmost(pos)
            for w in self.active_widgets():
                w.hover = (w is top) and w.enabled
            return None
        if t == pygame.MOUSEWHEEL:
            for v in reversed(self.scroll_views()):
                if v.needs_scroll and v.rect.collidepoint(pos):
                    v.scrollbar.handle_event(event, pos)
                    return None
            return None
        if t == pygame.MOUSEBUTTONDOWN and event.button == 1:
            self.focus_visible = False
            for v in self.scroll_views():
                if v.needs_scroll and v.scrollbar.bar_rect.collidepoint(pos):
                    v.scrollbar.handle_event(event, pos)
                    return None
            if self.layers:
                top_layer = self.layers[-1]
                if not top_layer.rect.collidepoint(pos):
                    if top_layer.dismiss_on_outside:
                        top_layer.on_back()
                    return None          # modal: swallow clicks outside
            w = self._topmost(pos)
            if w is not None and w.enabled:
                if w.focusable:
                    self.set_focus(w, visible=False)
                else:
                    self.blur()
                w.pressed = True
                self.mouse_owner = w
                w.mouse_down(pos)
            elif self.focused is not None and self.focused.captures_text:
                self.blur()               # clicking elsewhere leaves a text field
            return None
        return None

    def _handle_key(self, event):
        self.focus_visible = True
        f = self.focused
        if f is not None and f.captures_text and f.handle_text(event):
            return None
        first_unhandled = None
        for action in UI_INPUT.actions_for(event):
            if self._dispatch(action, event):
                return None
            if first_unhandled is None:
                first_unhandled = action
        return first_unhandled

    def _dispatch(self, action, event):
        f = self.focused
        if action == 'FOCUS_NEXT':
            return self.focus_step(1) or True
        if action == 'FOCUS_PREV':
            return self.focus_step(-1) or True
        if f is not None and f.handle_action(action, event):
            return True
        if action == 'BACK' and self.layers:
            self.layers[-1].on_back()
            return True
        if action in ('MOVE_UP', 'MOVE_DOWN', 'MOVE_LEFT', 'MOVE_RIGHT'):
            w = self._spatial_nowrap(action)
            if w is not None:
                self.set_focus(w)
                return True
            if action in ('MOVE_UP', 'MOVE_DOWN'):
                sv = self.active_scroll_view()
                if sv is not None and sv.scrollbar.handle_key(action):
                    return True
            w = self._spatial(action, wrap=True)
            if w is not None and w is not f:
                self.set_focus(w)
                return True
            return f is not None      # arrows never leak to the screen while something has focus
        if action in ('PAGE_UP', 'PAGE_DOWN', 'HOME', 'END'):
            sv = self.active_scroll_view()
            if sv is not None and sv.scrollbar.handle_key(action):
                return True
            return False
        return False

    # -- per-frame ---------------------------------------------------------------
    def update(self, dt=None):
        if globals().get('_ACCESSIBILITY_REDUCED_MOTION', False):
            self.pulse = 0.5
        else:
            ph = (pygame.time.get_ticks() / 1100.0) % 2.0
            self.pulse = ph if ph <= 1.0 else 2.0 - ph
        for v in self.scroll_views():
            v.update(dt)
        if self.mouse_owner is None and self.capture is None:
            pos = self._mouse()
            top = self._topmost(pos)
            for w in self.active_widgets():
                w.hover = (w is top) and w.enabled
        self.validate_focus()

    def draw(self, surface):
        for w in self.widgets:
            if w.visible:
                w.draw(surface)
        for w in self._flatten(self.widgets):
            w.draw_overlay(surface)
        for L in self.layers:
            L.draw(surface)
            for w in self._flatten(L.roots()):
                w.draw_overlay(surface)


# ── Legacy navigation bridge (requirements 2–6) ───────────────────────────
_NAV_LEGACY_CLASSES = {
    'SettingsScreen', 'SinglePlayerConfigScreen', 'HighScoresScreen',
    'TutorialScreen', 'MultiplayerModeScreen', 'NetworkLobbyScreen',
    'PlayMenuScreen', 'SingleplayerModeScreen', 'EncyclopediaScreen',
    'MapPickerScreen', 'VSAIConfigScreen', 'MapEditorScreen',
    'StartupCheckDialog',
}
_NAV_MAINMENU_METHODS = {
    'show_language_selection', 'show_tutorial', 'show_credits', 'show_achievements',
}
_NAV_EXCLUDE_NAMES = {
    'rect', 'content_rect', 'detail_rect', 'list_rect', 'viewport', 'viewport_rect',
    'panel_rect', 'box', 'cell_rect', 'board_rect', 'clip_rect', 'surface_rect',
    'title_rect', 'scrollbar_rect', '_scrollbar_rect',
}
_NAV_NAME_HINTS = (
    'button', 'btn', 'back', 'prev', 'previous', 'next', 'start', 'play', 'continue',
    'save', 'cancel', 'close', 'confirm', 'apply', 'reset', 'clear', 'delete',
    'connect', 'host', 'join', 'filter', 'settings', 'tutorial', 'achiev', 'highscore',
    'score', 'encycl', 'map', 'single', 'multi', 'ai', 'language', 'option', 'tab',
    'input', 'seed', 'search', 'retry', 'yes', 'no', 'exit', 'mode', 'profile', 'stats',
    'studio', 'mod', 'continue', 'random', 'custom', 'procedural',
)
_NAV_CONTAINER_HINTS = ('rects', 'controls', 'buttons', 'rows', 'options', 'tabs', 'menu')


def _nav_owner_enabled(owner):
    if owner is None:
        return False
    cls = owner.__class__.__name__
    if cls in _NAV_LEGACY_CLASSES:
        return True
    if cls == 'MainMenu':
        try:
            import inspect as _inspect
            _frame = _inspect.currentframe()
            _caller = _frame.f_back if _frame else None
            _screen_frame = _caller.f_back if _caller else None
            method_name = _screen_frame.f_code.co_name if _screen_frame else ''
            return method_name in _NAV_MAINMENU_METHODS
        except Exception:
            return False
    return False


def _nav_rects_from_value(name, value, depth=0):
    """Collect likely interactive pygame.Rects from a legacy run() locals dict."""
    out = []
    if depth > 3:
        return out
    lname = str(name).lower()
    if isinstance(value, pygame.Rect):
        if lname in _NAV_EXCLUDE_NAMES:
            return out
        direct_hint = any(h in lname for h in _NAV_NAME_HINTS) or lname.endswith('_rect')
        if direct_hint:
            out.append((name, value.copy()))
        return out
    if isinstance(value, dict):
        for k, v in value.items():
            out.extend(_nav_rects_from_value(f'{name}.{k}', v, depth + 1))
        return out
    if isinstance(value, (list, tuple)):
        container_hint = any(h in lname for h in _NAV_CONTAINER_HINTS)
        if container_hint or lname.endswith('_rects'):
            for i, v in enumerate(value):
                out.extend(_nav_rects_from_value(f'{name}[{i}]', v, depth + 1))
        return out
    return out


class LegacyAutoNavigator:
    """Shared focus/navigation adapter for legacy blocking screens.

    It deliberately reuses each screen's existing mouse handlers by posting a
    synthetic LMB event on Enter/Space. This keeps business logic in one place
    instead of creating parallel keyboard-only actions for every screen.
    """

    def __init__(self, owner):
        self.owner = owner
        self.focus_index = 0
        self.focus_sig = None
        self.controls = []
        self.scrollbars = []
        self.viewport_rects = []
        self.focus_visible = True

    def _collect_scrollbars(self, scope):
        found = []
        seen = set()
        def visit(v, depth=0):
            if depth > 3 or id(v) in seen:
                return
            seen.add(id(v))
            if isinstance(v, ScrollBar):
                found.append(v)
                return
            if isinstance(v, dict):
                for x in v.values(): visit(x, depth + 1)
            elif isinstance(v, (list, tuple)):
                for x in v: visit(x, depth + 1)
        for v in scope.values():
            visit(v)
        return found

    def refresh(self, scope):
        raw = []
        for name, value in scope.items():
            raw.extend(_nav_rects_from_value(name, value))

        # First-class support for repeated rows whose loop only leaves the last
        # `row_rect` in locals (notably language selection).
        if 'sorted_languages' in scope and isinstance(scope.get('content_rect'), pygame.Rect):
            row_h = int(scope.get('row_height', 52))
            row_gap = int(scope.get('row_spacing', 8))
            row_x = int(scope.get('row_x', scope['content_rect'].x))
            row_w = int(scope.get('row_width', scope['content_rect'].width))
            sb = scope.get('scrollbar')
            off = int(sb.get_content_offset()) if isinstance(sb, ScrollBar) else 0
            for i in range(len(scope['sorted_languages'])):
                rr = pygame.Rect(row_x, scope['content_rect'].y + i * (row_h + row_gap) - off, row_w, row_h)
                raw.append((f'language_row[{i}]', rr))

        controls = []
        seen = set()
        screen_rect = self.owner.screen.get_rect() if hasattr(self.owner, 'screen') else pygame.display.get_surface().get_rect()
        for name, rect in raw:
            if rect.w < 45 or rect.h < 22:
                continue
            if rect.w >= screen_rect.w * 0.92 and rect.h >= screen_rect.h * 0.80:
                continue
            key = (rect.x, rect.y, rect.w, rect.h)
            if key in seen:
                continue
            seen.add(key)
            # Prefer visible/currently useful controls; repeated list rows are
            # permitted offscreen so keyboard focus can trigger scrolling.
            allow_offscreen = ('[' in str(name))
            if not allow_offscreen and not rect.colliderect(screen_rect):
                continue
            controls.append({'name': str(name), 'rect': rect, 'allow_offscreen': allow_offscreen})

        controls.sort(key=lambda c: (c['rect'].top, c['rect'].left, c['name']))
        old_sig = self.focus_signature()
        self.controls = controls[:100]
        self.scrollbars = self._collect_scrollbars(scope)
        self.viewport_rects = []
        for n in ('content_rect', 'list_rect', 'detail_rect', 'viewport', 'box'):
            v = scope.get(n)
            if isinstance(v, pygame.Rect):
                self.viewport_rects.append(v)
        if old_sig:
            for i, c in enumerate(self.controls):
                if (c['name'], tuple(c['rect'])) == old_sig:
                    self.focus_index = i
                    break
            else:
                self.focus_index = min(self.focus_index, max(0, len(self.controls) - 1))
        else:
            self.focus_index = min(self.focus_index, max(0, len(self.controls) - 1))
        self._ensure_focus_visible()

    def focus_signature(self):
        if not self.controls:
            return None
        i = max(0, min(self.focus_index, len(self.controls) - 1))
        c = self.controls[i]
        return c['name'], tuple(c['rect'])

    def _candidate_indices(self):
        # Keep offscreen rows reachable; their selection scrolls the matching bar.
        return list(range(len(self.controls)))

    def _set_focus(self, idx):
        if not self.controls:
            return False
        self.focus_index = idx % len(self.controls)
        self.focus_visible = True
        self._ensure_focus_visible()
        return True

    def _ensure_focus_visible(self):
        if not self.controls or not self.scrollbars:
            return
        c = self.controls[self.focus_index]
        r = c['rect']
        vp = next((v for v in self.viewport_rects if v.inflate(4, 4).colliderect(r) or v.contains(r)), None)
        if vp is None and self.viewport_rects:
            vp = self.viewport_rects[0]
        if vp is not None:
            for sb in self.scrollbars:
                if sb.needs_scroll:
                    # Scroll just enough using screen-space deltas; legacy rows already
                    # contain the current offset in their rect coordinates.
                    if r.top < vp.top:
                        sb.scroll_by(r.top - vp.top)
                    elif r.bottom > vp.bottom:
                        sb.scroll_by(r.bottom - vp.bottom)
                    return

    def _spatial(self, direction):
        if not self.controls:
            return None
        fr = self.controls[self.focus_index]['rect']
        best = None
        best_score = None
        for i, c in enumerate(self.controls):
            if i == self.focus_index:
                continue
            r = c['rect']
            if direction in ('MOVE_UP', 'MOVE_DOWN'):
                sign = -1 if direction == 'MOVE_UP' else 1
                d = (r.centery - fr.centery) * sign
                if d <= 0:
                    continue
                perp = abs(r.centerx - fr.centerx)
                gap = max(0, (fr.top - r.bottom) if sign < 0 else (r.top - fr.bottom))
            else:
                sign = -1 if direction == 'MOVE_LEFT' else 1
                d = (r.centerx - fr.centerx) * sign
                if d <= 0:
                    continue
                perp = abs(r.centery - fr.centery)
                gap = max(0, (fr.left - r.right) if sign < 0 else (r.left - fr.right))
            score = gap + perp * 3 + d * 0.01
            if best_score is None or score < best_score:
                best, best_score = i, score
        return best

    def _scroll(self, action):
        for sb in self.scrollbars:
            if sb.handle_key(action):
                return True
        return False

    def _post_activate(self):
        if not self.controls:
            return False
        r = self.controls[self.focus_index]['rect']
        if r.w <= 0 or r.h <= 0:
            return False
        pygame.event.post(pygame.event.Event(pygame.MOUSEBUTTONDOWN, {'button': 1, 'pos': r.center}))
        return True

    def _find_previous(self):
        for i, c in enumerate(self.controls):
            n = c['name'].lower()
            if 'previous' in n or '.prev' in n or n.endswith('prev_rect') or n.endswith('prev_button'):
                return i
        return None

    def handle(self, event, scope):
        if not _nav_owner_enabled(self.owner):
            return False
        self.refresh(scope)

        if event.type in (pygame.MOUSEMOTION, pygame.MOUSEBUTTONUP):
            pos = getattr(event, 'pos', None) or pygame.mouse.get_pos()
            for sb in self.scrollbars:
                sb.handle_event(event, pos)
            if event.type == pygame.MOUSEMOTION:
                for i, c in enumerate(self.controls):
                    if c['rect'].collidepoint(pos):
                        self.focus_index = i
                        self.focus_visible = False
            return False

        if event.type == pygame.MOUSEBUTTONDOWN:
            pos = getattr(event, 'pos', None) or pygame.mouse.get_pos()
            # Route scrollbar track/thumb before regular controls.
            for sb in self.scrollbars:
                if sb.needs_scroll and sb.bar_rect.collidepoint(pos):
                    sb.handle_event(event, pos)
                    return True
            for i, c in enumerate(self.controls):
                if c['rect'].collidepoint(pos):
                    self.focus_index = i
                    self.focus_visible = False
                    return False
            return False

        if event.type == pygame.MOUSEWHEEL:
            pos = pygame.mouse.get_pos()
            for sb in self.scrollbars:
                region = sb.wheel_rect
                if region is None:
                    if self.viewport_rects:
                        region = next((v for v in self.viewport_rects if v.collidepoint(pos)), None)
                    if region is None:
                        surf = pygame.display.get_surface()
                        region = pygame.Rect(0, sb.rect.y, surf.get_width(), sb.rect.height) if surf else sb.rect
                if sb.needs_scroll and region.collidepoint(pos):
                    sb.handle_event(event, pos)
                    return True
            return False

        if event.type != pygame.KEYDOWN:
            return False

        # Legacy text inputs often use an *_active boolean. Let those fields own
        # printable/editing/confirm keys; Tab/Escape remain global navigation.
        active_text = any(bool(v) for n, v in scope.items()
                          if str(n).endswith('_active') and bool(v)
                          and ('input' in str(n).lower() or 'text' in str(n).lower() or 'seed' in str(n).lower()))
        actions = UI_INPUT.actions_for(event)
        if not actions:
            return False
        if active_text and any(a not in ('FOCUS_NEXT', 'FOCUS_PREV', 'BACK') for a in actions):
            return False

        for action in actions:
            if action == 'FOCUS_NEXT':
                self._set_focus(self.focus_index + 1)
                return True
            if action == 'FOCUS_PREV':
                self._set_focus(self.focus_index - 1)
                return True
            if action == 'PREVIOUS':
                idx = self._find_previous()
                if idx is not None:
                    self._set_focus(idx)
                    self._post_activate()
                    return True
                return False
            if action in ('PAGE_UP', 'PAGE_DOWN', 'HOME', 'END'):
                if self._scroll(action):
                    return True
                if self.controls:
                    self._set_focus(0 if action in ('PAGE_UP', 'HOME') else len(self.controls) - 1)
                    return True
            if action in ('MOVE_UP', 'MOVE_DOWN', 'MOVE_LEFT', 'MOVE_RIGHT'):
                target = self._spatial(action)
                if target is not None:
                    self._set_focus(target)
                    return True
                if action in ('MOVE_UP', 'MOVE_DOWN') and self._scroll(action):
                    return True
                return bool(self.controls)
            if action == 'CONFIRM':
                return self._post_activate()
            if action == 'BACK':
                return False
            if action == 'TOGGLE_FULLSCREEN':
                return False
        return False

    def draw(self):
        if not _nav_owner_enabled(self.owner) or not self.controls or not self.focus_visible:
            return
        c = self.controls[max(0, min(self.focus_index, len(self.controls) - 1))]
        r = c['rect']
        surf = self.owner.screen if hasattr(self.owner, 'screen') else pygame.display.get_surface()
        if surf is None:
            return
        clip = r.clip(surf.get_rect())
        if clip.w > 0 and clip.h > 0:
            ui_draw_focus_ring(surf, clip, 7)


def _legacy_nav_event(owner, event, scope):
    if _handle_replay_save_retry_event(owner, event):
        return True
    if owner is None or not _nav_owner_enabled(owner):
        return False
    if 'DEV_TOOLS' in globals() and DEV_TOOLS.unlocked:
        # Single hook point so every legacy screen that already calls
        # _legacy_nav_event (High Scores, Settings, Encyclopedia, Map
        # Editor, Tutorial, lobby/config/gameplay screens, ...) gets these
        # for free, instead of wiring them into each screen by hand — per
        # spec: unlocked DEV Mode should be reachable from almost anywhere
        # in the game, not just gameplay, and the overlay must have a quick
        # way to get out of the way without obstructing gameplay.
        if event.type == pygame.KEYDOWN and event.key == pygame.K_F8:
            DEV_TOOLS.open_panel(getattr(owner, 'screen', None), game=None)
            return True
        if event.type == pygame.KEYDOWN and event.key == pygame.K_F9:
            DEV_TOOLS.toggle_overlay_hidden()
            return True
        if (event.type == pygame.MOUSEBUTTONDOWN and event.button == 1
                and DEV_TOOLS._overlay_toggle_rect is not None
                and DEV_TOOLS._overlay_toggle_rect.collidepoint(event.pos)):
            DEV_TOOLS.toggle_overlay_hidden()
            return True
    nav = getattr(owner, '_sgf_legacy_nav', None)
    if nav is None:
        nav = LegacyAutoNavigator(owner)
        owner._sgf_legacy_nav = nav
    return nav.handle(event, scope)


def _legacy_nav_draw(owner):
    if owner is None or not _nav_owner_enabled(owner):
        return
    nav = getattr(owner, '_sgf_legacy_nav', None)
    if nav is not None:
        nav.draw()


