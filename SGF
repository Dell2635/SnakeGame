class SinglePlayerConfigScreen:
    """
    Configuration screen shown before a single-player match.
    Lets the player choose a seed (or leave blank for auto-generated).
    Returns (seed,) on confirm or None on cancel/back.
    """

    def __init__(self, settings, screen):
        self.settings    = settings
        self.screen      = screen
        self.seed_text   = ''
        self.seed_active = False

    def run(self):
        clock = pygame.time.Clock()
        while True:
            sw, sh = self.screen.get_width(), self.screen.get_height()
            self.screen.fill(COLORS['dark_blue'])

            # Animated background dots
            t = pygame.time.get_ticks() / 1000.0
            for i in range(20):
                px = int(sw * ((i * 137) % 100) / 100)
                py = int(sh * ((i * 97 + t * 12) % 100) / 100)
                pygame.draw.circle(self.screen, (30, 50, 110), (px, py), 2)

            _ref = min(sw, sh)
            tf   = get_font(self.settings.language, 'bold',    max(28, int(_ref * 0.06)))
            hf   = get_font(self.settings.language, 'bold',    max(18, int(_ref * 0.038)))
            bf   = get_font(self.settings.language, 'bold',    max(16, int(_ref * 0.032)))
            sf   = get_font(self.settings.language, 'regular', max(13, int(_ref * 0.025)))

            # Title
            title = tf.render("Single Player — Setup", True, COLORS['white'])
            self.screen.blit(title, (sw // 2 - title.get_width() // 2, int(sh * 0.08)))

            cy = int(sh * 0.28)

            # Board size & speed info (read-only summary)
            info_lines = [
                f"Board: {self.settings.board_size}×{self.settings.board_size}",
                f"Speed: {self.settings.update_rate_ms} ms  |  "
                f"Obstacles: {'On' if self.settings.enable_obstacles else 'Off'}  |  "
                f"Portals: {'On' if self.settings.enable_portals else 'Off'}",
            ]
            for line in info_lines:
                s = sf.render(line, True, (170, 185, 220))
                self.screen.blit(s, (sw // 2 - s.get_width() // 2, cy))
                cy += s.get_height() + 6
            cy += int(sh * 0.04)

            # Seed input
            seed_lbl = hf.render("Seed:", True, COLORS['light_gray'])
            self.screen.blit(seed_lbl, (sw // 2 - seed_lbl.get_width() // 2, cy))
            cy += seed_lbl.get_height() + int(sh * 0.012)

            seed_box_w = max(260, int(sw * 0.42))
            seed_box_h = max(36, int(sh * 0.065))
            seed_box_x = sw // 2 - seed_box_w // 2
            seed_rect  = pygame.Rect(seed_box_x, cy, seed_box_w, seed_box_h)
            seed_border = (0, 190, 255) if self.seed_active else (60, 70, 120)
            pygame.draw.rect(self.screen, (20, 25, 50), seed_rect, border_radius=6)
            pygame.draw.rect(self.screen, seed_border, seed_rect, 2, border_radius=6)
            seed_display = self.seed_text if self.seed_text else 'auto'
            seed_col     = COLORS['white'] if self.seed_text else (100, 110, 140)
            st = sf.render(seed_display[-40:], True, seed_col)
            self.screen.blit(st, (seed_box_x + 8, cy + (seed_box_h - st.get_height()) // 2))

            hint_s = sf.render(
                "Enter any text/numbers/symbols — or leave blank for a random seed",
                True, (100, 110, 140)
            )
            self.screen.blit(hint_s, (sw // 2 - hint_s.get_width() // 2, cy + seed_box_h + 4))
            cy += seed_box_h + hint_s.get_height() + int(sh * 0.05)

            # Charset hint
            charset_s = sf.render(
                "Supported: A–Z  a–z  0–9  and all special characters (!@#$%^&*…)",
                True, (80, 95, 130)
            )
            self.screen.blit(charset_s, (sw // 2 - charset_s.get_width() // 2, cy))
            cy += charset_s.get_height() + int(sh * 0.05)

            # Buttons
            btn_w = max(130, int(sw * 0.18))
            btn_h = max(38, int(sh * 0.07))
            gap   = int(sw * 0.04)

            start_rect = pygame.Rect(sw // 2 - btn_w // 2 + (btn_w // 2 + gap // 2),
                                     cy, btn_w, btn_h)
            back_rect  = pygame.Rect(sw // 2 - btn_w // 2 - (btn_w // 2 + gap // 2),
                                     cy, btn_w, btn_h)

            pygame.draw.rect(self.screen, (30, 160, 60), start_rect, border_radius=10)
            pygame.draw.rect(self.screen, (160, 50, 50), back_rect,  border_radius=10)
            self.screen.blit(
                bf.render("Start Game", True, COLORS['white']),
                bf.render("Start Game", True, COLORS['white']).get_rect(center=start_rect.center)
            )
            self.screen.blit(
                bf.render("Back", True, COLORS['white']),
                bf.render("Back", True, COLORS['white']).get_rect(center=back_rect.center)
            )

            # If a seed is set, show the hash preview
            if self.seed_text.strip():
                preview_seed = self.seed_text.strip()
                h = seed_to_int(preview_seed)
                preview_s = sf.render(
                    f"SHA-256 hash prefix: {hex(h)[:18]}…",
                    True, (70, 110, 160)
                )
                self.screen.blit(preview_s,
                    (sw // 2 - preview_s.get_width() // 2, start_rect.bottom + 10))

            pygame.display.flip()

            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit(); import sys; sys.exit()

                elif event.type == pygame.KEYDOWN:
                    if self.seed_active:
                        if event.key in (pygame.K_RETURN, pygame.K_KP_ENTER):
                            self.seed_active = False
                        elif event.key == pygame.K_ESCAPE:
                            self.seed_active = False
                        elif event.key == pygame.K_BACKSPACE:
                            self.seed_text = self.seed_text[:-1]
                        elif event.unicode and event.unicode != ' ' and len(self.seed_text) < 64:
                            self.seed_text += event.unicode
                    else:
                        if event.key == pygame.K_F11:
                            self.screen = _toggle_fullscreen(self.screen)
                        elif event.key == pygame.K_ESCAPE:
                            return None
                        elif event.key in (pygame.K_RETURN, pygame.K_KP_ENTER):
                            seed = self.seed_text.strip() or generate_seed()
                            return (seed,)

                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    mp = event.pos
                    if seed_rect.collidepoint(mp):
                        self.seed_active = True
                    else:
                        self.seed_active = False
                    if start_rect.collidepoint(mp):
                        seed = self.seed_text.strip() or generate_seed()
                        return (seed,)
                    if back_rect.collidepoint(mp):
                        return None

                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode(
                        (event.w, event.h), pygame.RESIZABLE)

            clock.tick(60)

