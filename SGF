IA5_RUNTIME_VERSION = "1.0"


class RuntimeEventBus:
    """Small in-process event bus for high-level application lifecycle events.

    This is intentionally narrow: it is not a replacement for the project's
    gameplay/input systems. It provides stable hooks for diagnostics, themes,
    mods, logging, and final integration without coupling those systems.
    """

    def __init__(self):
        self._listeners = {}
        self._lock = threading.RLock()

    def subscribe(self, event_name, callback):
        if not event_name or not callable(callback):
            raise ValueError("event_name and callback are required")
        with self._lock:
            self._listeners.setdefault(str(event_name), []).append(callback)
        return callback

    def unsubscribe(self, event_name, callback):
        with self._lock:
            listeners = self._listeners.get(str(event_name), [])
            try:
                listeners.remove(callback)
            except ValueError:
                return False
            if not listeners:
                self._listeners.pop(str(event_name), None)
            return True

    def emit(self, event_name, payload=None):
        with self._lock:
            listeners = tuple(self._listeners.get(str(event_name), ()))
        for callback in listeners:
            try:
                callback(payload)
            except Exception as exc:
                # A diagnostics/theme/mod listener must never take down the game.
                print(f"[runtime] lifecycle listener failed for {event_name}: {exc}")

    def clear(self):
        with self._lock:
            self._listeners.clear()


class RuntimeInputRouter:
    """Application-level input hook with an explicit Action-Mapping seam.

    IA5 does not create a second keybinding system. A future/other subsystem
    can provide an object exposing actions_for_event(event), resolve(event),
    or map_event(event), and this router will use it when present.
    """

    def __init__(self):
        self._handlers = []
        self._action_mapper = None

    def set_action_mapper(self, mapper):
        self._action_mapper = mapper

    def register_global_handler(self, callback, priority=0):
        if not callable(callback):
            raise ValueError("callback must be callable")
        self._handlers.append((int(priority), callback))
        self._handlers.sort(key=lambda item: item[0], reverse=True)
        return callback

    def unregister_global_handler(self, callback):
        before = len(self._handlers)
        self._handlers = [(p, cb) for p, cb in self._handlers if cb is not callback]
        return len(self._handlers) != before

    def _map_actions(self, event):
        mapper = self._action_mapper
        if mapper is None:
            return ()
        for method_name in ("actions_for_event", "resolve", "map_event"):
            method = getattr(mapper, method_name, None)
            if callable(method):
                try:
                    result = method(event)
                    if result is None:
                        return ()
                    if isinstance(result, str):
                        return (result,)
                    return tuple(result)
                except Exception as exc:
                    print(f"[runtime] action mapper failed: {exc}")
                    return ()
        return ()

    def route(self, event):
        actions = self._map_actions(event)
        handled = False
        for _priority, callback in self._handlers:
            try:
                if callback(event, actions):
                    handled = True
                    break
            except Exception as exc:
                print(f"[runtime] global input handler failed: {exc}")
        return handled, actions


class ManagedScreen:
    """Canonical screen lifecycle contract used by ScreenManager."""

    def enter(self, payload=None):
        return None

    def update(self, dt):
        return None

    def handle_event(self, event):
        return False

    def draw(self, surface):
        return None

    def exit(self):
        return None


class LegacyScreenAdapter(ManagedScreen):
    """Adapter for existing run()-based screens during incremental migration."""

    def __init__(self, name, runner, owner=None):
        self.name = name
        self.runner = runner
        self.owner = owner
        self.result = None
        self.screen = getattr(owner, 'screen', None)

    def enter(self, payload=None):
        return None

    def run(self):
        self.result = self.runner()
        return self.result


class ScreenManager:
    """Application-level screen/state infrastructure.

    Existing SGF screens can remain legacy run()-based. New or migrated screens
    can implement ManagedScreen directly. The manager owns the current screen,
    transition stack, back navigation, global overlays, modal ownership, and
    input routing while keeping the single-file architecture intact.
    """

    def __init__(self, surface=None, event_bus=None):
        self.surface = surface
        self.event_bus = event_bus or RuntimeEventBus()
        self.input = RuntimeInputRouter()
        self.current_screen = None
        self._stack = []
        self._overlays = []
        self._modal_owner = None
        self._focus_owner = None
        self._game_paused = False
        self._running = False
        self._application_started = False
        self._application_shutdown = False

    @property
    def modal_owner(self):
        return self._modal_owner

    @property
    def overlays(self):
        return tuple(self._overlays)

    @property
    def stack_depth(self):
        return len(self._stack)

    @property
    def focus_owner(self):
        return self._focus_owner

    @property
    def game_paused(self):
        return self._game_paused

    def set_focus_owner(self, owner):
        self._focus_owner = owner
        self.event_bus.emit('FOCUS_CHANGED', {'owner': owner})

    def clear_focus_owner(self, owner=None):
        if owner is None or owner is self._focus_owner:
            self._focus_owner = None
            self.event_bus.emit('FOCUS_CHANGED', {'owner': None})

    def set_game_paused(self, paused, metadata=None):
        paused = bool(paused)
        if paused == self._game_paused:
            return
        self._game_paused = paused
        event_name = 'GAME_PAUSED' if paused else 'GAME_RESUMED'
        payload = dict(metadata or {})
        payload['paused'] = paused
        self.event_bus.emit(event_name, payload)

    def sync_surface(self, surface):
        if surface is not None:
            self.surface = surface

    def _enter(self, screen, payload=None):
        self.current_screen = screen
        self.sync_surface(getattr(screen, 'screen', self.surface))
        if hasattr(screen, 'enter'):
            screen.enter(payload)
        self.event_bus.emit('SCREEN_ENTERED', {'name': getattr(screen, 'name', screen.__class__.__name__), 'screen': screen})

    def _exit(self, screen):
        if screen is None:
            return
        try:
            if hasattr(screen, 'exit'):
                screen.exit()
        finally:
            self.event_bus.emit('SCREEN_EXITED', {'name': getattr(screen, 'name', screen.__class__.__name__), 'screen': screen})

    def transition(self, screen, name=None, payload=None):
        if name:
            try:
                screen.name = name
            except Exception:
                pass
        if self.current_screen is not None:
            self._exit(self.current_screen)
        self._stack.clear()
        self._enter(screen, payload)
        return screen

    def push(self, screen, name=None, payload=None):
        if name:
            try:
                screen.name = name
            except Exception:
                pass
        if self.current_screen is not None:
            self._stack.append(self.current_screen)
        self._enter(screen, payload)
        return screen

    def back(self):
        if not self._stack:
            return False
        current = self.current_screen
        self._exit(current)
        self.current_screen = None
        previous = self._stack.pop()
        self._enter(previous)
        return True

    def set_modal(self, owner):
        self._modal_owner = owner
        self.event_bus.emit('MODAL_CHANGED', {'owner': owner})

    def clear_modal(self, owner=None):
        if owner is None or owner == self._modal_owner:
            self._modal_owner = None
            self.event_bus.emit('MODAL_CHANGED', {'owner': None})

    def add_overlay(self, overlay):
        if overlay not in self._overlays:
            self._overlays.append(overlay)
            if hasattr(overlay, 'enter'):
                overlay.enter(None)
            self.event_bus.emit('OVERLAY_ADDED', {'overlay': overlay})
        return overlay

    def remove_overlay(self, overlay):
        if overlay in self._overlays:
            self._overlays.remove(overlay)
            if hasattr(overlay, 'exit'):
                overlay.exit()
            self.event_bus.emit('OVERLAY_REMOVED', {'overlay': overlay})
            return True
        return False

    def handle_event(self, event):
        """Route global input first, then modal, overlays, and current screen."""
        handled, actions = self.input.route(event)
        if handled:
            return True, actions

        if self._modal_owner is not None:
            modal_handler = getattr(self._modal_owner, 'handle_event', None)
            if callable(modal_handler) and modal_handler(event):
                return True, actions
            return False, actions

        for overlay in reversed(self._overlays):
            handler = getattr(overlay, 'handle_event', None)
            if callable(handler) and handler(event):
                return True, actions

        if self.current_screen is not None:
            handler = getattr(self.current_screen, 'handle_event', None)
            if callable(handler) and handler(event):
                return True, actions
        return False, actions

    def update(self, dt):
        if self.current_screen is not None:
            updater = getattr(self.current_screen, 'update', None)
            if callable(updater):
                updater(dt)
        for overlay in tuple(self._overlays):
            updater = getattr(overlay, 'update', None)
            if callable(updater):
                updater(dt)

    def draw(self, surface=None):
        if surface is not None:
            self.surface = surface
        target = self.surface
        if self.current_screen is not None:
            drawer = getattr(self.current_screen, 'draw', None)
            if callable(drawer):
                drawer(target)
        for overlay in tuple(self._overlays):
            drawer = getattr(overlay, 'draw', None)
            if callable(drawer):
                drawer(target)

    def start_application(self):
        if not self._application_started:
            self._application_started = True
            self._application_shutdown = False
            self.event_bus.emit('APPLICATION_STARTED', {})

    def shutdown_application(self):
        if self._application_shutdown:
            return
        self._application_shutdown = True
        self._running = False
        while self._overlays:
            self.remove_overlay(self._overlays[-1])
        if self.current_screen is not None:
            self._exit(self.current_screen)
            self.current_screen = None
        self._stack.clear()
        self.event_bus.emit('APPLICATION_SHUTDOWN', {})

    def run_legacy(self, name, runner, *, surface_owner=None):
        """Run one existing blocking screen through the shared lifecycle stack."""
        adapter = LegacyScreenAdapter(name, runner, owner=surface_owner)
        previous = self.current_screen
        if previous is not None:
            self._stack.append(previous)
        self._enter(adapter)
        _legacy_started_at = time.perf_counter()
        try:
            result = adapter.run()
            return result
        finally:
            _dev_draw_hook = globals().get('_dev_draw_loading_hook')
            if callable(_dev_draw_hook):
                try:
                    _dev_draw_hook(name, (time.perf_counter() - _legacy_started_at) * 1000.0)
                except Exception:
                    pass
            self._exit(adapter)
            if self._stack:
                self.current_screen = self._stack.pop()
                child_surface = getattr(surface_owner, 'screen', None)
                previous_owner = getattr(self.current_screen, 'owner', None)
                if child_surface is not None:
                    if previous_owner is not None and hasattr(previous_owner, 'screen'):
                        previous_owner.screen = child_surface
                    if hasattr(self.current_screen, 'screen'):
                        self.current_screen.screen = child_surface
                    self.sync_surface(child_surface)
                self.event_bus.emit('SCREEN_RESUMED', {'screen': self.current_screen, 'name': getattr(self.current_screen, 'name', self.current_screen.__class__.__name__)})
            else:
                self.current_screen = None

    def run_game(self, name, runner, *, metadata=None, surface_owner=None):
        """Lifecycle wrapper for an existing blocking game loop."""
        payload = dict(metadata or {})
        payload.update({'name': name})
        music = globals().get('_SOUND_MGR')
        if music is not None:
            mode = str(payload.get('mode', '')).lower()
            context = 'multiplayer' if ('multi' in mode or 'network' in name) else 'gameplay'
            music.set_music_context(context)
        self.event_bus.emit('GAME_STARTED', payload)
        try:
            self._show_game_countdown(surface_owner)
            return self.run_legacy(name, runner, surface_owner=surface_owner)
        finally:
            self.set_game_paused(False, {'game': name, 'reason': 'ended'})
            self.event_bus.emit('GAME_ENDED', payload)
            if music is not None:
                music.set_music_context('menu')

    def _show_game_countdown(self, owner, duration=3.0):
        """Show a short, frame-limited countdown before a game loop begins."""
        screen = getattr(owner, 'screen', None) or self.surface
        if screen is None:
            return
        lang = getattr(getattr(owner, 'settings', None), 'language', 'en')
        is_network = isinstance(owner, NetworkGame)
        clock = pygame.time.Clock()
        started = time.monotonic()
        overlay = pygame.Surface(screen.get_size(), pygame.SRCALPHA)
        overlay.fill((8, 12, 24, 132))
        while True:
            elapsed = time.monotonic() - started
            if elapsed >= duration + 0.55:
                break
            for event in pygame.event.get([pygame.QUIT]):
                pygame.event.post(event)
            _pump_audio()
            sw, sh = screen.get_size()
            if overlay.get_size() != (sw, sh):
                overlay = pygame.Surface((sw, sh), pygame.SRCALPHA)
                overlay.fill((8, 12, 24, 132))
            # Paint the initial board without advancing simulation, then lay
            # a translucent veil over it so players can see what is starting.
            try:
                if is_network:
                    board = owner.mp if owner.is_host else owner._client_recorder
                    board.draw()
                elif callable(getattr(owner, 'draw', None)):
                    owner.draw()
                else:
                    screen.fill((8, 12, 24))
            except Exception:
                screen.fill((8, 12, 24))
            screen.blit(overlay, (0, 0))
            remaining = int(math.ceil(duration - elapsed))
            if remaining > 0:
                label = str(remaining)
                color = (115, 230, 150)
            else:
                label = get_text(lang, 'countdown_go')
                color = (255, 215, 95)
            title = get_font(lang, 'regular', 22).render(
                get_text(lang, 'countdown_ready'), True, (190, 205, 230))
            number = get_font(lang, 'bold', min(108, max(48, sh // 5))).render(label, True, color)
            screen.blit(title, (sw // 2 - title.get_width() // 2, sh // 2 - number.get_height() // 2 - 55))
            screen.blit(number, (sw // 2 - number.get_width() // 2, sh // 2 - number.get_height() // 2))
            if is_network:
                status = get_font(lang, 'regular', 16).render(
                    get_text(lang, 'countdown_network_status'), True, (215, 225, 245))
                screen.blit(status, (sw // 2 - status.get_width() // 2,
                                     min(sh - status.get_height() - 22,
                                         sh // 2 + number.get_height() // 2 + 24)))
            pygame.display.flip()
            clock.tick(60)

    def emit(self, event_name, payload=None):
        self.event_bus.emit(event_name, payload or {})


def _runtime_emit(owner, event_name, payload=None):
    """Emit a lifecycle event only when an owner has been attached to a runtime."""
    runtime = getattr(owner, 'runtime', None)
    if runtime is not None:
        runtime.emit(event_name, payload or {})


