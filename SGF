    _diagnostic_bus_probe = EventBus()
    def _selftest_failing_listener(_payload):
        raise RuntimeError('bounded event failure')
    _diagnostic_bus_probe.subscribe('GAME_STARTED', _selftest_failing_listener)
    for _diagnostic_index in range(125):
        _diagnostic_bus_probe.emit('GAME_STARTED', index=_diagnostic_index)
    assert len(_diagnostic_bus_probe.errors) == _DIAGNOSTIC_HISTORY_LIMIT
    assert _diagnostic_bus_probe.errors[-1]['error'] == 'bounded event failure'

    _diagnostic_registry_probe = ContentRegistry('BoundedSelfTest')
    _diagnostic_registry_probe.register({'id': 'stable'})
    for _diagnostic_index in range(125):
        try:
            _diagnostic_registry_probe.register({'id': 'stable'})
        except ContentValidationError:
            pass
    assert len(_diagnostic_registry_probe.conflicts) == _DIAGNOSTIC_HISTORY_LIMIT

    _diagnostic_assets_probe = AssetManager()
    _diagnostic_assets_probe.register_asset(
        'missing', os.path.join(os.getcwd(), '__sgf_missing_asset_selftest__.bin'),
        owner_id='selftest')
    for _diagnostic_index in range(125):
        assert _diagnostic_assets_probe.load('missing', 'file') is None
    assert len(_diagnostic_assets_probe.errors) == _DIAGNOSTIC_HISTORY_LIMIT
    _diagnostic_assets_probe.register_asset('conflict', 'first.png', owner_id='one')
    for _diagnostic_index in range(125):
        _diagnostic_assets_probe.register_asset(
            'conflict', 'second.png', owner_id=f'owner-{_diagnostic_index}')
    assert len(_diagnostic_assets_probe.conflicts) == _DIAGNOSTIC_HISTORY_LIMIT
    results.append('bounded_in_memory_diagnostics')

    _font_cache_probe = {}
    for _font_cache_index in range(3):
        _lru_cache_put(_font_cache_probe, _font_cache_index,
                       f'font-{_font_cache_index}', 3)
    assert _lru_cache_get(_font_cache_probe, 0) == ('font-0', True)
    _lru_cache_put(_font_cache_probe, 3, 'font-3', 3)
    assert list(_font_cache_probe) == [2, 0, 3]
    _font_cmap_cache_original = _font_cmap_cache
    _fonttools_original = _FONTTOOLS_AVAILABLE
    _get_font_original = get_font
    _ui_text_cache_original = _ui_text_cache
    try:
