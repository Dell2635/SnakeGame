class SnakeGame:
    def __init__(self, settings, screen, seed=None, custom_map=None):
        self.settings = settings
        self.screen = screen
        # Seed / RNG system
        self.seed = seed if seed else generate_seed()
        self.rng  = SeedRNG(self.seed)
        # Optional custom map from the Map Editor: {'board_width', 'board_height',
        # 'obstacles': [[x,y],...], 'portals': [[x1,y1,x2,y2,pal_idx],...]}
        # When set, reset_game() uses this layout verbatim instead of
        # procedurally generating obstacles/portals.
        self.custom_map = custom_map
        # Encyclopedia: accumulate encounter/use counts in memory during
        # the match, flushed to disk once at game-over.
        self._enc_updates = {}
        self.player_name = ""
        # Will be set by MainMenu after initialization
        self.achievement_manager = None
        self.game_history = []  # For replay functionality
        self.replay_mode = False  # Flag to indicate replay mode
        self.replay_index = 0  # Current index in replay
        self.replay_speed = 1.0  # Speed multiplier for replay
        self.on_replay_end = None  # Callback function when replay ends
        self._replay_ended = False  # True when the last replay frame is reached
        self._replay_exit_requested = False  # Set True to break out of run()
        self.reset_game()
        
    def _enc_touch(self, entry_id, encountered=0, used=0):
        """Accumulate an encyclopedia encounter/use count for this match;
        flushed to disk at game-over via _flush_encyclopedia_updates()."""
        if not entry_id:
            return
        d = self._enc_updates.setdefault(entry_id, {'encountered': 0, 'used': 0})
        d['encountered'] += encountered
        d['used'] += used

    def reset_game(self):
        """Reset the game state"""
        # Re-seed the RNG so restarting reproduces the *exact* same sequence
        # of fruit positions/types, obstacle/portal placement, etc. for this
        # seed — without this, "Play Again" would continue the RNG stream
        # from wherever the previous run left off instead of starting the
        # seed fresh, so the same seed wouldn't actually replay the same way.
        self.rng = SeedRNG(self.seed)

        # Reset replay-related properties
        if not self.replay_mode:
            self.game_history = []  # Clear history for a new game
        
        self.replay_index = 0
        self.replay_speed = 1.0
        self.portal_used = False
        self.portal_cooldown = 0
        
        # Reset achievement tracking counters
        self.fruits_eaten = 0
        self.portals_used = 0
        self.max_combo = 0
        
        # Level progression - start with a smaller board if enabled
        if self.custom_map:
            self.board_width = self.custom_map.get('board_width', 20)
            self.board_height = self.custom_map.get('board_height', 20)
            self.current_level = 1
        elif self.settings.levels_enabled:
            self.current_level = 1
            self.starting_board_size = 3  # Start with a 3x3 grid
            self.board_width = self.starting_board_size
            self.board_height = self.starting_board_size
        else:
            # Normal mode - use settings board size
            # Convert board_size to int if it's a string (handle both options)
            if isinstance(self.settings.board_size, str):
                size_map = {"small": 10, "medium": 15, "large": 20, "extra_large": 25}
                board_size = size_map.get(self.settings.board_size, 15)  # Default to 15 if unknown
            else:
                board_size = self.settings.board_size
                
            self.board_width = board_size
            self.board_height = board_size
            
        # Calculate cell size based on board dimensions
        self.cell_size = min(self.screen.get_width(), self.screen.get_height()) // max(self.board_width, self.board_height)
        
        # Calculate board position to center it
        self.board_offset_x = (self.screen.get_width() - (self.board_width * self.cell_size)) // 2
        self.board_offset_y = (self.screen.get_height() - (self.board_height * self.cell_size)) // 2
        
        # Portal state initialization
        self.portals = []  # List of portal pairs: [(x1, y1), (x2, y2), pair_id]
        self.portal_cooldown = 0  # To prevent immediate re-teleportation
        self.portal_used = False  # Flag to track if the snake just used a portal
        
        # Power-up state initialization - initialize these before generate_fruit() is called
        self.active_powerups = []  # List of active power-ups: {type, duration, start_time}
        self.powerup_position = None  # Current power-up position on the board
        self.powerup_type = None  # Current power-up type
        self.powerup_spawn_timer = 0  # Timer for spawning new power-ups
        self.powerup_spawn_interval = 15000  # Spawn a powerup every 15 seconds if enabled
        self.powerup_duration = 10000  # Default 10 second duration for power-ups
        
        # Power-up effect multipliers (default = 1.0 = no effect)
        self.speed_multiplier = 1.0
        self.points_multiplier = 1.0
        self.invincible = False
        self.ghost_mode = False
        self.shield_active = False
        
        # Fruit combo tracking
        self.last_fruit_type = 'regular'
        self.current_fruit_type = 'regular'
        self.current_fruit_value = 1
        self.combo_count = 0
        self.max_combo = 0
        
        # Speed increase with length
        self.length_speed_multiplier = 1.0
        
        # Moving obstacles
        self.moving_obstacles = []
        self.next_obstacle_move_time = time.time() * 1000
        self.obstacle_move_interval = 1000  # 1 second interval for obstacle movement
        
        # Snake initial state - center snake in the board
        self.direction = (1, 0)  # Start moving right
        self.snake = [(self.board_width // 4, self.board_height // 2)]
        self.next_direction = self.direction
        
        # Static obstacles initialization
        self.obstacles = []
        if self.custom_map:
            self.obstacles = [tuple(o) for o in self.custom_map.get('obstacles', [])]
        elif self.settings.enable_obstacles:
            self.generate_obstacles()
            
        # Portal initialization
        self.portals = []
        if self.custom_map:
            for p in self.custom_map.get('portals', []):
                x1, y1, x2, y2, pal_idx = p
                self.portals.append(((x1, y1), (x2, y2), pal_idx))
        elif self.settings.enable_portals:
            self.generate_portals()

        # Custom maps are hand-made and might happen to place an obstacle or
        # portal right where the snake would spawn — relocate to the nearest
        # free cell rather than spawning on top of it.
        if self.custom_map:
            occupied = set(self.obstacles) | {p[0] for p in self.portals} | {p[1] for p in self.portals}
            if self.snake[0] in occupied:
                found = None
                for radius in range(1, max(self.board_width, self.board_height)):
                    for dx in range(-radius, radius + 1):
                        for dy in range(-radius, radius + 1):
                            cand = (self.snake[0][0] + dx, self.snake[0][1] + dy)
                            if (0 <= cand[0] < self.board_width and 0 <= cand[1] < self.board_height
                                    and cand not in occupied):
                                found = cand
                                break
                        if found:
                            break
                    if found:
                        break
                if found:
                    self.snake = [found]
                    self.next_direction = self.direction
        
        # Game state
        self.score = 0
        self.game_over = False

        # Encyclopedia: record which mechanics/objects are active this match
        if self.obstacles:
            self._enc_touch('obstacle_static', encountered=1)
        if self.portals:
            self._enc_touch('portal_pair', encountered=len(self.portals))
        self._enc_touch('mechanic_seeds', encountered=1)
        if getattr(self.settings, 'wall_collision', True):
            self._enc_touch('mechanic_wall_collision', encountered=1)
        if getattr(self.settings, 'levels_enabled', False):
            self._enc_touch('mechanic_level_progression', encountered=1)
        if getattr(self.settings, 'combo_fruits_enabled', False):
            self._enc_touch('mechanic_combo', encountered=1)
        self.victory = False
        self.paused = False
        self.last_update_time = time.time() * 1000  # Convert to milliseconds
        
        # Achievement tracking counters
        self.fruits_eaten = 0
        self.portals_used = 0
        
        # Generate fruit last, after all other attributes are initialized
        self.fruit_position = self.generate_fruit()
        
    def generate_obstacles(self):
        """Generate obstacles based on settings"""
        self.obstacles = []
        
        # Only generate obstacles if they're enabled
        if not self.settings.enable_obstacles:
            return
            
        # Calculate number of obstacles
        if self.settings.obstacle_count >= (self.board_width * self.board_height - 3):
            # Limit obstacle count to a reasonable number to ensure playability
            obstacle_count = (self.board_width * self.board_height) // 4
        else:
            obstacle_count = self.settings.obstacle_count
            
        # Make sure we don't put obstacles near the snake's starting position
        # Check if snake is initialized, in case this method is called at incorrect time
        if not hasattr(self, 'snake') or len(self.snake) == 0:
            # Create a default safe zone in the center if snake is not initialized
            center_x, center_y = self.board_width // 4, self.board_height // 2
            safe_zone = [(center_x + dx, center_y + dy) 
                       for dx in range(-2, 3) for dy in range(-2, 3)]
        else:
            snake_head = self.snake[0]
            safe_zone = [(snake_head[0] + dx, snake_head[1] + dy) 
                       for dx in range(-2, 3) for dy in range(-2, 3)]
        
        # Generate obstacle positions
        for _ in range(obstacle_count):
            available_positions = []
            for x in range(self.board_width):
                for y in range(self.board_height):
                    pos = (x, y)
                    # Make sure position is not on snake, another obstacle, or in the safe zone
                    if pos not in self.snake and pos not in self.obstacles and pos not in safe_zone:
                        available_positions.append(pos)
            
            if available_positions:
                self.obstacles.append(self.rng.choice(available_positions))
            else:
                # Stop if there are no more available positions
                break
    
    def generate_fruit(self):
        """Generate a new fruit position and type"""
        available_positions = []
        for x in range(self.board_width):
            for y in range(self.board_height):
                pos = (x, y)
                # Make sure position is not occupied by snake, obstacles or powerup
                if (pos not in self.snake and 
                    pos not in self.obstacles and 
                    pos != self.powerup_position):
                    available_positions.append(pos)
                    
        if available_positions:
            position = self.rng.choice(available_positions)
            
            # Only generate different fruit types if enabled in settings
            if self.settings.fruit_types_enabled:
                # List of possible fruit types
                fruit_types = [
                    'regular',    # Regular apple - 1 point
                    'golden',     # Golden apple - double points
                    'blue',       # Blueberry - speed boost
                    'green',      # Green apple - extra length
                    'orange',     # Orange - slow motion
                    'purple',     # Plum - invincibility
                    'yellow',     # Lemon - score bonus
                    'pink',       # Strawberry - shrink snake
                    'cyan',       # Blueberry - reverse controls
                    'lime',       # Lime - clear obstacles
                    'brown',      # Coconut - teleport
                    'teal',       # Avocado - phase through walls
                    'navy',       # Blackberry - night mode
                    'coral',      # Grapefruit - reduce obstacles
                    'maroon',     # Cherry - point multiplier
                    'olive',      # Olive - extra life
                    'mint',       # Mint - freeze obstacles
                    'lavender',   # Grape - snake invisibility
                    'turquoise',  # Kiwi - creates fruit trail
                    'beige',      # Pear - temporary immunity
                    'cream',      # Banana - speed burst
                    'salmon',     # Peach - board expansion
                    'indigo',     # Blackcurrant - portal creation
                    'crimson',    # Pomegranate - attract fruits
                    'gold',       # Star fruit - combo multiplier
                    'auto_tracking' # Super rare tracking fruit - helps find fruits
                ]
                
                # Weighted selection - make regular fruits more common
                weights = [0.3]  # 30% chance for regular fruit
                special_weight = 0.7 / (len(fruit_types) - 1)  # Distribute remaining 70% among special fruits
                weights.extend([special_weight] * (len(fruit_types) - 1))
                
                # Select fruit type
                self.current_fruit_type = self.rng.choices(fruit_types, weights=weights)[0]
                
                # If combo fruits enabled, increase chance of getting the same type as before
                if self.settings.combo_fruits_enabled and hasattr(self, 'last_fruit_type'):
                    # 30% chance to get the same fruit type as the last one for combos
                    if self.rng.random() < 0.3:
                        self.current_fruit_type = self.last_fruit_type
                
                # Store point value based on fruit type
                if self.current_fruit_type == 'golden':
                    self.current_fruit_value = 2
                elif self.current_fruit_type in ['yellow', 'maroon']:
                    self.current_fruit_value = 3
                elif self.current_fruit_type == 'gold':
                    # Star fruit value increases with combo
                    if hasattr(self, 'combo_count') and self.combo_count > 0:
                        self.current_fruit_value = 1 + self.combo_count
                    else:
                        self.current_fruit_value = 1
                else:
                    self.current_fruit_value = 1

                self._enc_touch(_FRUIT_TYPE_TO_ENC_ID.get(self.current_fruit_type), encountered=1)
            else:
                # Default to regular fruit if different types are disabled
                self.current_fruit_type = 'regular'
                self.current_fruit_value = 1
                
            return position
        else:
            # No positions available means the snake has filled the board
            self.victory = True
            sounds().play('victory')
            return None
    
    def generate_portals(self):
        """Generate portal pairs based on settings"""
        self.portals = []
        
        # Only generate portals if enabled
        if not self.settings.enable_portals or self.settings.portal_pairs <= 0:
            return
            
        # Get safe zone around snake
        if not hasattr(self, 'snake') or len(self.snake) == 0:
            # Create a default safe zone in the center
            center_x, center_y = self.board_width // 4, self.board_height // 2
            safe_zone = [(center_x + dx, center_y + dy) 
                       for dx in range(-2, 3) for dy in range(-2, 3)]
        else:
            # Safe zone around snake head
            snake_head = self.snake[0]
            safe_zone = [(snake_head[0] + dx, snake_head[1] + dy) 
                       for dx in range(-2, 3) for dy in range(-2, 3)]
        
        # Generate portal pairs
        for pair_id in range(self.settings.portal_pairs):
            # Generate first portal
            portal1 = None
            portal2 = None
            
            # Get available positions for first portal
            available_positions1 = []
            for x in range(self.board_width):
                for y in range(self.board_height):
                    pos = (x, y)
                    # Make sure position isn't on snake, obstacles, or in safe zone
                    if (pos not in self.snake and 
                        pos not in self.obstacles and 
                        pos not in safe_zone and
                        not any(pos == p[0] or pos == p[1] for p in self.portals)):
                        available_positions1.append(pos)
            
            # If we have valid positions, place first portal
            if available_positions1:
                portal1 = self.rng.choice(available_positions1)
                
                # Get available positions for second portal that are at least 3 cells away
                available_positions2 = []
                for x in range(self.board_width):
                    for y in range(self.board_height):
                        pos = (x, y)
                        # Calculate Manhattan distance between portals
                        if portal1:
                            distance = abs(pos[0] - portal1[0]) + abs(pos[1] - portal1[1])
                        else:
                            distance = 0
                            
                        # Make sure position isn't on snake, obstacles, or too close to first portal
                        if (pos not in self.snake and 
                            pos not in self.obstacles and 
                            pos != portal1 and
                            distance >= 3 and  # Minimum distance between portals
                            not any(pos == p[0] or pos == p[1] for p in self.portals)):
                            available_positions2.append(pos)
                
                # If we have valid positions for second portal, place it
                if available_positions2:
                    portal2 = self.rng.choice(available_positions2)
                    
                    # Add the portal pair to the list
                    self.portals.append((portal1, portal2, pair_id))
            
            # If we couldn't place a complete pair, stop generating more
            if not portal1 or not portal2:
                break
                
    def generate_powerup(self):
        """Generate a new power-up if conditions are met"""
        # Only generate power-ups if the master toggle is enabled
        if not self.settings.powerups_enabled:
            self.powerup_position = None
            self.powerup_type = None
            return
            
        # Get list of available power-up types based on settings
        available_powerups = []
        if self.settings.speed_boost_enabled:
            available_powerups.append('speed_boost')
        if self.settings.slow_motion_enabled:
            available_powerups.append('slow_motion')
        if self.settings.size_reduction_enabled:
            available_powerups.append('size_reduction')
        if self.settings.invincibility_enabled:
            available_powerups.append('invincibility')
        if self.settings.double_points_enabled:
            available_powerups.append('double_points')
        if hasattr(self.settings, 'ghost_mode_enabled') and self.settings.ghost_mode_enabled:
            available_powerups.append('ghost_mode')
        if hasattr(self.settings, 'shield_enabled') and self.settings.shield_enabled:
            available_powerups.append('shield')
            
        # If no power-ups are enabled, don't spawn any
        if not available_powerups:
            self.powerup_position = None
            self.powerup_type = None
            return
            
        # Select a random power-up type
        self.powerup_type = self.rng.choice(available_powerups)
        self._enc_touch(_POWERUP_TYPE_TO_ENC_ID.get(self.powerup_type), encountered=1)
        
        # Generate power-up position (not on snake, obstacles, or fruit)
        available_positions = []
        for x in range(self.board_width):
            for y in range(self.board_height):
                pos = (x, y)
                if (pos not in self.snake and 
                    pos not in self.obstacles and 
                    pos != self.fruit_position):
                    available_positions.append(pos)
                    
        if available_positions:
            self.powerup_position = self.rng.choice(available_positions)
        else:
            # No available positions, don't spawn power-up
            self.powerup_position = None
            self.powerup_type = None
            
    def move_snake(self):
        """Move the snake according to the current direction"""
        if self.game_over or self.victory or self.paused:
            return
        
        # Record a compact state snapshot before each move (up to 2000 frames)
        if not self.replay_mode and len(self.game_history) < 2000:
            self.game_history.append(self._snap())
            
        # Update the next direction based on user input
        self.direction = self.next_direction
        
        # Calculate new head position
        head_x, head_y = self.snake[0]
        dir_x, dir_y = self.direction
        
        # New head position calculation with wall collision
        if self.settings.wall_collision and not self.invincible:
            # With wall collision - no wrapping
            new_head_x = head_x + dir_x
            new_head_y = head_y + dir_y
            
            # Check for wall collision
            if new_head_x < 0 or new_head_x >= self.board_width or new_head_y < 0 or new_head_y >= self.board_height:
                self.game_over = True
                self.save_score()
                return
                
            new_head = (new_head_x, new_head_y)
        else:
            # No wall collision or invincible - wrap around board
            new_head = ((head_x + dir_x) % self.board_width, (head_y + dir_y) % self.board_height)
        
        # Check for collision with self (only if not invincible and not in ghost mode)
        if new_head in self.snake and not self.invincible and not self.ghost_mode:
            # If shield is active, consume the shield instead of game over
            if self.shield_active:
                self.shield_active = False
                # Find a safe direction to redirect the snake
                safe_directions = []
                for test_dir in [(0, -1), (1, 0), (0, 1), (-1, 0)]:  # up, right, down, left
                    test_pos = ((head_x + test_dir[0]) % self.board_width, 
                               (head_y + test_dir[1]) % self.board_height)
                    if test_pos not in self.snake and test_pos not in self.obstacles:
                        safe_directions.append(test_dir)
                
                if safe_directions:
                    # Redirect snake to a safe direction
                    self.direction = self.rng.choice(safe_directions)
                    self.next_direction = self.direction
                    dir_x, dir_y = self.direction
                    new_head = ((head_x + dir_x) % self.board_width, 
                               (head_y + dir_y) % self.board_height)
                else:
                    # No safe direction available
                    self.game_over = True
                    self.save_score()
                    return
            else:
                self.game_over = True
                self.save_score()
                return
            
        # Check for collision with obstacles (only if not invincible)
        if new_head in self.obstacles and not self.invincible:
            # If shield is active, consume the shield instead of game over
            if self.shield_active:
                self.shield_active = False
                # Find a safe direction to redirect the snake
                safe_directions = []
                for test_dir in [(0, -1), (1, 0), (0, 1), (-1, 0)]:  # up, right, down, left
                    test_pos = ((head_x + test_dir[0]) % self.board_width, 
                               (head_y + test_dir[1]) % self.board_height)
                    if test_pos not in self.snake and test_pos not in self.obstacles:
                        safe_directions.append(test_dir)
                
                if safe_directions:
                    # Redirect snake to a safe direction
                    self.direction = self.rng.choice(safe_directions)
                    self.next_direction = self.direction
                    dir_x, dir_y = self.direction
                    new_head = ((head_x + dir_x) % self.board_width, 
                               (head_y + dir_y) % self.board_height)
                else:
                    # No safe direction available
                    self.game_over = True
                    self.save_score()
                    return
            else:
                self.game_over = True
                self.save_score()
                return
            
        # Check for portal teleportation if:
        # 1. Portal cooldown is over (prevents multiple teleports in a row)
        # 2. We're not coming from a teleport (prevents loop teleports)
        # 3. Portals are enabled
        if self.settings.enable_portals and self.portal_cooldown <= 0 and not self.portal_used:
            for portal1, portal2, pair_id in self.portals:
                if new_head == portal1:
                    # Teleport from portal1 to portal2
                    new_head = portal2
                    self.portal_cooldown = 3  # Wait 3 moves before allowing another teleport
                    self.portal_used = True
                    self.portals_used += 1  # Count for achievements
                    break
                elif new_head == portal2:
                    # Teleport from portal2 to portal1
                    new_head = portal1
                    self.portal_cooldown = 3  # Wait 3 moves before allowing another teleport
                    self.portal_used = True
                    self.portals_used += 1  # Count for achievements
                    break
        else:
            # Reset portal used flag if we moved normally
            self.portal_used = False
            
        # Decrement portal cooldown if active
        if self.portal_cooldown > 0:
            self.portal_cooldown -= 1
        
        # Move the snake
        self.snake.insert(0, new_head)
        
        # Check for fruit collision
        if new_head == self.fruit_position:
            # Increment fruit counter for achievements
            self.fruits_eaten += 1
            self._enc_touch(_FRUIT_TYPE_TO_ENC_ID.get(self.current_fruit_type), used=1)
            
            # Process fruit effect based on type
            fruit_effect_applied = self.process_fruit_effect()
            
            # Update combo counter
            if self.settings.combo_fruits_enabled:
                if hasattr(self, 'last_fruit_type') and self.current_fruit_type == self.last_fruit_type:
                    self.combo_count += 1
                    # Show combo message
                    if self.combo_count > 1:
                        # Add combo bonus points
                        combo_bonus = self.combo_count * 5  # 5 points per combo level
                        self.score += combo_bonus
                else:
                    self.combo_count = 1
                
                # Track max combo for stats
                self.max_combo = max(self.max_combo, self.combo_count)
                
                # Store fruit type for combo tracking
                self.last_fruit_type = self.current_fruit_type
            
            # Calculate base points including any fruit value and special effects
            speed_factor = 1000 / self.settings.update_rate_ms
            base_points = int(10 * speed_factor * self.points_multiplier)
            
            # Multiply by fruit value
            points = base_points * self.current_fruit_value
            
            # Add to score
            self.score += points
            # Sound feedback
            _snd = 'eat_gold' if getattr(self, 'current_fruit_type', '') == 'golden' else 'eat'
            sounds().play(_snd)
            
            # Check if level progression should occur
            if self.settings.levels_enabled:
                # Calculate board fill percentage
                board_area = self.board_width * self.board_height
                snake_size = len(self.snake)
                fill_percentage = (snake_size / board_area) * 100
                
                # If the board is 75% full and we're not at max size, expand the board
                if fill_percentage >= 75 and self.board_width < self.settings.board_size:
                    self.level_up()
                    sounds().play('levelup')
                    
            # Generate new fruit
            self.fruit_position = self.generate_fruit()
            
            # Add length for "normal" growth (some fruits might already change length)
            if not fruit_effect_applied:
                # This is the default growth behavior when eating a fruit
                pass  # Snake already grew by inserting the head above
        else:
            # Remove tail if no fruit was eaten
            self.snake.pop()
            
        # Process speed increases if enabled
        if self.settings.increasing_speed_enabled:
            # Increase game speed based on snake length
            # The longer the snake, the faster it gets
            snake_length = len(self.snake)
            if snake_length > 5:  # Start increasing after minimal length
                # Calculate a multiplier that increases with snake length
                # This makes the game progressively faster
                self.length_speed_multiplier = max(1.0, min(2.0, 1.0 + (snake_length - 5) * 0.02))
            else:
                self.length_speed_multiplier = 1.0
        
        # Check for power-up collision
        if self.powerup_position and new_head == self.powerup_position:
            self._enc_touch(_POWERUP_TYPE_TO_ENC_ID.get(self.powerup_type), used=1)
            self.activate_powerup(self.powerup_type)
            self.powerup_position = None
            self.powerup_type = None
            
        # Check if it's time to generate a new power-up
        current_time = time.time() * 1000
        if (self.settings.powerups_enabled and 
            self.powerup_position is None and 
            current_time - self.powerup_spawn_timer >= self.powerup_spawn_interval):
            # Randomize powerup spawn interval between 10-20 seconds
            self.powerup_spawn_interval = self.rng.randint(10000, 20000)
            self.powerup_spawn_timer = current_time
            self.generate_powerup()
        
        # Update active power-ups
        current_time = time.time() * 1000
        expired_powerups = []
        for i, powerup in enumerate(self.active_powerups):
            if current_time - powerup['start_time'] >= powerup['duration']:
                expired_powerups.append(i)
                
        # Remove expired power-ups (in reverse order to avoid index issues)
        for i in sorted(expired_powerups, reverse=True):
            expired = self.active_powerups.pop(i)
            self.deactivate_powerup(expired['type'])
            
        # Check for victory condition
        if len(self.snake) == self.board_width * self.board_height:
            self.victory = True
            self.save_score()
            
        # Update achievement progress if achievement manager exists
        if hasattr(self, 'achievement_manager') and self.achievement_manager:
            game_data = {
                'score': self.score,
                'snake_length': len(self.snake),
                'fruits_eaten': self.fruits_eaten if hasattr(self, 'fruits_eaten') else 0,
                'portals_used': self.portals_used if hasattr(self, 'portals_used') else 0,
                'max_combo': self.max_combo if hasattr(self, 'max_combo') else 0,
                'level': self.current_level if hasattr(self, 'current_level') else 1,
                'victory': self.victory,
                'game_over': self.game_over
            }
            self.achievement_manager.check_achievement_progress(game_data)
            
    def draw_dpad(self):
        """Draw an on-screen D-pad for touch/mobile play. Returns dict of direction->Rect."""
        sw, sh = self.screen.get_width(), self.screen.get_height()
        btn = int(min(sw, sh) * 0.10)   # Button size: 10% of smaller dimension
        gap = 4
        bx  = sw - (btn * 3 + gap * 2) - 12   # Bottom-right corner
        by  = sh - (btn * 3 + gap * 2) - 12

        rects = {
            'U': pygame.Rect(bx + btn + gap, by,              btn, btn),
            'L': pygame.Rect(bx,             by + btn + gap,  btn, btn),
            'C': pygame.Rect(bx + btn + gap, by + btn + gap,  btn, btn),  # centre (pause)
            'R': pygame.Rect(bx + btn*2+gap*2, by + btn + gap, btn, btn),
            'D': pygame.Rect(bx + btn + gap, by + btn*2+gap*2, btn, btn),
        }

        # Draw buttons
        for key, rect in rects.items():
            bg  = (60, 70, 90) if key != 'C' else (80, 50, 70)
            pygame.draw.rect(self.screen, bg, rect, border_radius=6)
            pygame.draw.rect(self.screen, (120, 140, 170), rect, width=2, border_radius=6)
            # Draw directional arrow as triangle polygon
            if key in ('U', 'D', 'L', 'R'):
                cx, cy = rect.centerx, rect.centery
                s = int(btn * 0.28)
                if key == 'U':
                    pts = [(cx, cy - s), (cx - s, cy + s//2), (cx + s, cy + s//2)]
                elif key == 'D':
                    pts = [(cx, cy + s), (cx - s, cy - s//2), (cx + s, cy - s//2)]
                elif key == 'L':
                    pts = [(cx - s, cy), (cx + s//2, cy - s), (cx + s//2, cy + s)]
                else:  # R
                    pts = [(cx + s, cy), (cx - s//2, cy - s), (cx - s//2, cy + s)]
                pygame.draw.polygon(self.screen, (220, 230, 255), pts)
            else:
                # Centre = pause symbol (two bars)
                pw, ph = btn//6, btn//2
                pygame.draw.rect(self.screen, (200, 200, 220),
                    (rect.centerx - pw*2, rect.centery - ph//2, pw, ph))
                pygame.draw.rect(self.screen, (200, 200, 220),
                    (rect.centerx + pw,   rect.centery - ph//2, pw, ph))

        return rects

    def handle_input(self, event):
        """Handle player input"""
        if event.type == pygame.KEYDOWN:
            # Movement controls: WASD and Arrow keys
            if event.key in (pygame.K_w, pygame.K_UP) and self.direction != (0, 1):
                self.next_direction = (0, -1)
            elif event.key in (pygame.K_s, pygame.K_DOWN) and self.direction != (0, -1):
                self.next_direction = (0, 1)
            elif event.key in (pygame.K_a, pygame.K_LEFT) and self.direction != (1, 0):
                self.next_direction = (-1, 0)
            elif event.key in (pygame.K_d, pygame.K_RIGHT) and self.direction != (-1, 0):
                self.next_direction = (1, 0)
            # Pause game
            elif event.key == pygame.K_SPACE:
                self.paused = not self.paused
            # Restart game with R key
            elif event.key == pygame.K_r and (self.game_over or self.victory):
                self.reset_game()
            # Return to main menu with Escape key
            elif event.key == pygame.K_ESCAPE:
                return False
        return True
                
    def activate_powerup(self, powerup_type):
        """Activate a power-up effect"""
        current_time = time.time() * 1000
        
        # Add to active power-ups list
        self.active_powerups.append({
            'type': powerup_type,
            'duration': self.powerup_duration,
            'start_time': current_time
        })
        
        # Apply power-up effect
        if powerup_type == 'speed_boost':
            self.speed_multiplier = 0.5  # Half the update time (twice as fast)
        elif powerup_type == 'slow_motion':
            self.speed_multiplier = 2.0  # Double the update time (half speed)
        elif powerup_type == 'size_reduction':
            # Remove one segment from the snake's tail if possible
            if len(self.snake) > 1:
                self.snake.pop()
        elif powerup_type == 'invincibility':
            self.invincible = True
        elif powerup_type == 'double_points':
            self.points_multiplier = 2.0
        elif powerup_type == 'ghost_mode':
            # Allow passing through the snake's body (but not walls or obstacles)
            self.ghost_mode = True
        elif powerup_type == 'shield':
            # Activate shield to protect against one collision
            self.shield_active = True
    
    def deactivate_powerup(self, powerup_type):
        """Deactivate a power-up effect"""
        if powerup_type == 'speed_boost' or powerup_type == 'slow_motion':
            self.speed_multiplier = 1.0  # Reset to normal speed
        elif powerup_type == 'invincibility':
            self.invincible = False
        elif powerup_type == 'double_points':
            self.points_multiplier = 1.0
        elif powerup_type == 'ghost_mode':
            self.ghost_mode = False
        elif powerup_type == 'shield':
            self.shield_active = False
            
    def level_up(self):
        """Increase board size for level progression"""
        # Save current game state
        old_snake = self.snake.copy()
        old_fruit = self.fruit_position
        old_powerup = self.powerup_position
        old_obstacles = self.obstacles.copy()
        
        # Increase level
        self.current_level += 1
        
        # Increase board size by 2 in both dimensions, up to settings.board_size
        new_width = min(self.settings.board_size, self.board_width + 2)
        new_height = min(self.settings.board_size, self.board_height + 2)
        
        # Update board dimensions
        self.board_width = new_width
        self.board_height = new_height
        
        # Recalculate cell size and board position
        self.cell_size = min(self.screen.get_width(), self.screen.get_height()) // max(self.board_width, self.board_height)
        self.board_offset_x = (self.screen.get_width() - (self.board_width * self.cell_size)) // 2
        self.board_offset_y = (self.screen.get_height() - (self.board_height * self.cell_size)) // 2
        
        # Adjust snake position to be in the center of the new board
        x_offset = (new_width - self.board_width) // 2
        y_offset = (new_height - self.board_height) // 2
        
        # Translate snake to new position
        self.snake = [(x + x_offset, y + y_offset) for x, y in old_snake]
        
        # Translate fruit if it exists
        if old_fruit:
            self.fruit_position = (old_fruit[0] + x_offset, old_fruit[1] + y_offset)
        
        # Translate powerup if it exists
        if old_powerup:
            self.powerup_position = (old_powerup[0] + x_offset, old_powerup[1] + y_offset)
            
        # Regenerate obstacles appropriate for the new board size
        self.obstacles = []
        if self.settings.enable_obstacles:
            # Calculate a proportional increase in obstacles based on new board size
            scale_factor = (new_width * new_height) / (self.board_width * self.board_height)
            new_obstacle_count = min(
                int(len(old_obstacles) * scale_factor),
                (new_width * new_height) // 4  # Cap at 25% of the board
            )
            
            for _ in range(new_obstacle_count):
                available_positions = []
                for x in range(self.board_width):
                    for y in range(self.board_height):
                        pos = (x, y)
                        # Make sure position is not on snake, another obstacle, fruit or powerup
                        if (pos not in self.snake and 
                            pos not in self.obstacles and 
                            pos != self.fruit_position and
                            pos != self.powerup_position):
                            available_positions.append(pos)
                
                if available_positions:
                    self.obstacles.append(self.rng.choice(available_positions))
                else:
                    break
                    
        # Add moving obstacles
        if hasattr(self, 'moving_obstacles') and len(self.moving_obstacles) < 3:
            self.add_moving_obstacle()
            
    def add_moving_obstacle(self):
        """Add a new moving obstacle to the game"""
        # Only add moving obstacles if there's room
        if len(self.moving_obstacles) >= 5:
            return
            
        # Find a valid position not occupied by anything else
        available_positions = []
        for x in range(self.board_width):
            for y in range(self.board_height):
                pos = (x, y)
                # Make sure position is not on snake, obstacle, fruit or powerup
                if (pos not in self.snake and 
                    pos not in self.obstacles and 
                    pos not in [mo['position'] for mo in self.moving_obstacles] and
                    pos != self.fruit_position and
                    pos != self.powerup_position):
                    available_positions.append(pos)
                    
        if available_positions:
            # Choose a random position and movement direction
            position = self.rng.choice(available_positions)
            directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # Down, Right, Up, Left
            direction = self.rng.choice(directions)
            
            # Add the moving obstacle
            self.moving_obstacles.append({
                'position': position,
                'direction': direction,
                'color': self.rng.choice([
                    COLORS['obstacle'],
                    (100, 50, 50),  # Reddish
                    (50, 50, 100)   # Blueish
                ])
            })
            
    def update_moving_obstacles(self):
        """Update positions of moving obstacles"""
        if not hasattr(self, 'moving_obstacles'):
            self.moving_obstacles = []
            return
            
        current_time = time.time() * 1000
        
        # Only update at certain intervals
        if current_time < self.next_obstacle_move_time:
            return
            
        self.next_obstacle_move_time = current_time + self.obstacle_move_interval
        
        # Update each moving obstacle
        for i, obstacle in enumerate(self.moving_obstacles):
            x, y = obstacle['position']
            dx, dy = obstacle['direction']
            
            # Calculate new position with wrapping
            new_x = (x + dx) % self.board_width
            new_y = (y + dy) % self.board_height
            
            # Check if new position is valid
            new_pos = (new_x, new_y)
            
            # If new position collides with something, change direction
            if (new_pos in self.snake or 
                new_pos in self.obstacles or 
                new_pos == self.fruit_position or 
                new_pos == self.powerup_position or
                new_pos in [mo['position'] for j, mo in enumerate(self.moving_obstacles) if j != i]):
                
                # Change to a random direction
                directions = [(0, 1), (1, 0), (0, -1), (-1, 0)]
                directions.remove(obstacle['direction'])  # Don't keep the same direction
                obstacle['direction'] = self.rng.choice(directions)
            else:
                # Move the obstacle
                obstacle['position'] = new_pos
                
    def process_fruit_effect(self):
        """Apply special effects based on fruit type"""
        # Skip if regular fruit or different fruit types disabled
        if not self.settings.fruit_types_enabled or self.current_fruit_type == 'regular':
            return False
            
        # Apply effect based on fruit type
        if self.current_fruit_type == 'golden':
            # Golden apple - double points temporarily (similar to powerup)
            self.activate_powerup('double_points')
            
        elif self.current_fruit_type == 'blue':
            # Blueberry - speed boost
            self.activate_powerup('speed_boost')
            
        elif self.current_fruit_type == 'green':
            # Green apple - extra length (add two segments)
            # Snake already grew by 1 from eating, this adds 1 more
            last_segment = self.snake[-1]
            self.snake.append(last_segment)  # Duplicate the last segment
            
        elif self.current_fruit_type == 'orange':
            # Orange - slow motion
            self.activate_powerup('slow_motion')
            
        elif self.current_fruit_type == 'purple':
            # Plum - temporary invincibility
            self.activate_powerup('invincibility')
            
        elif self.current_fruit_type == 'yellow':
            # Lemon - immediate score bonus
            self.score += 20
            
        elif self.current_fruit_type == 'pink':
            # Strawberry - shrink snake
            if len(self.snake) > 3:  # Don't shrink below minimum length
                self.snake.pop()  # Remove an extra segment
                self.snake.pop()  # Remove another segment (snake already grew by 1)
            
        elif self.current_fruit_type == 'cyan':
            # Cyan berry - reverse controls temporarily
            # This is handled in the input processing
            current_time = time.time() * 1000
            self.active_powerups.append({
                'type': 'reverse_controls',
                'duration': 5000,  # 5 seconds
                'start_time': current_time
            })
            
        elif self.current_fruit_type == 'lime':
            # Lime - clear some obstacles
            if self.obstacles:
                # Remove up to half of the obstacles
                remove_count = min(len(self.obstacles) // 2, 5)
                for _ in range(remove_count):
                    if self.obstacles:
                        self.obstacles.pop(random.randrange(len(self.obstacles)))
            
        elif self.current_fruit_type == 'brown':
            # Coconut - teleport snake to random position
            available_positions = []
            for x in range(self.board_width):
                for y in range(self.board_height):
                    pos = (x, y)
                    if (pos not in self.snake[1:] and  # Don't teleport onto snake body (head OK)
                        pos not in self.obstacles and
                        pos != self.powerup_position and
                        pos != self.fruit_position):
                        available_positions.append(pos)
                        
            if available_positions:
                self.snake[0] = self.rng.choice(available_positions)
                
        elif self.current_fruit_type == 'teal':
            # Avocado - temporary wall phase
            # Similar to invincibility but only for walls
            current_time = time.time() * 1000
            self.active_powerups.append({
                'type': 'wall_phase',
                'duration': 8000,  # 8 seconds
                'start_time': current_time
            })
            
        elif self.current_fruit_type == 'coral':
            # Coral - reduce obstacles
            if self.obstacles:
                # Remove a few obstacles
                remove_count = min(3, len(self.obstacles))
                for _ in range(remove_count):
                    if self.obstacles:
                        self.obstacles.pop(random.randrange(len(self.obstacles)))
                        
        elif self.current_fruit_type == 'olive':
            # Olive - extra life (immunity to next collision)
            current_time = time.time() * 1000
            self.active_powerups.append({
                'type': 'extra_life',
                'duration': 15000,  # 15 seconds
                'start_time': current_time
            })
            
        elif self.current_fruit_type == 'salmon':
            # Salmon - expand the board
            if self.board_width < self.settings.board_size:
                self.level_up()
                
        # Special effect was applied
        return True
    
