class _CloudflareWebSocketBridge:
    """Loopback-only WebSocket-to-TCP bridge for one SGF invite path."""
    _MAX_HTTP_HEADERS = 16384
    _MAX_WS_MESSAGE = 1_000_000
    _MAX_CONCURRENT = 6
    _MAX_HEADER_LINES = 128
    # Headers whose meaning would change if a proxy repeated them.
    _SINGLE_VALUE_HEADERS = frozenset({
        'host', 'upgrade', 'sec-websocket-key', 'sec-websocket-version', 'content-length'})

    def __init__(self, local_game_port, invite):
        fingerprint, _token = _parse_network_invite(invite)
        self.local_game_port = int(local_game_port)
        self.path = '/sgf/' + fingerprint.hex()
        self.state = 'starting'
        self.port = None
        self._listener = None
        self._active = set()
        self._active_lock = threading.Lock()
        self._stop = threading.Event()
        # Each peer is handled on its own thread so one stalled or probing
        # connection can never block the guest who is actually joining.
        self._slots = threading.BoundedSemaphore(self._MAX_CONCURRENT)
        self._thread = threading.Thread(target=self._serve, name='SGF-cloudflare-ws-bridge', daemon=True)

    def start(self):
        listener = _socket_mod.socket(_socket_mod.AF_INET, _socket_mod.SOCK_STREAM)
        listener.setsockopt(_socket_mod.SOL_SOCKET, _socket_mod.SO_REUSEADDR, 1)
        listener.bind(('127.0.0.1', 0))
        listener.listen(8)
        listener.settimeout(0.5)
        self._listener = listener
        self.port = listener.getsockname()[1]
        self._thread.start()
        self.state = 'ready'
        return self

    @staticmethod
    def _read_request(sock):
        raw = bytearray()
        while not raw.endswith(b'\r\n\r\n'):
            if len(raw) >= _CloudflareWebSocketBridge._MAX_HTTP_HEADERS:
                raise ValueError('oversized WebSocket upgrade request')
            chunk = sock.recv(2048)
            if not chunk:
                raise ConnectionError('WebSocket client closed before upgrade')
            raw.extend(chunk)
        lines = bytes(raw).decode('iso-8859-1').split('\r\n')
        method, path, version = (lines[0].split(' ', 2) + ['', '', ''])[:3]
        if method != 'GET' or version != 'HTTP/1.1':
            raise ValueError('invalid WebSocket upgrade request line')
        if len(lines) > _CloudflareWebSocketBridge._MAX_HEADER_LINES:
            raise ValueError('too many WebSocket upgrade headers')
        headers = {}
        for line in lines[1:]:
            if not line:
                continue
            name, sep, value = line.partition(':')
            key = name.strip().lower()
            if not sep or not key:
                raise ValueError('invalid WebSocket header')
            if key in headers:
                # Cloudflare and cloudflared may legitimately repeat
                # informational headers (X-Forwarded-For and similar); merge
                # them as HTTP allows, but never repeat the ones that matter.
                if key in _CloudflareWebSocketBridge._SINGLE_VALUE_HEADERS:
                    raise ValueError('duplicate WebSocket header')
                headers[key] = headers[key] + ', ' + value.strip()
            else:
                headers[key] = value.strip()
        return path, headers

    @staticmethod
    def _read_exact(sock, size):
        data = bytearray()
        while len(data) < size:
            chunk = sock.recv(size - len(data))
            if not chunk:
                raise ConnectionError('WebSocket stream closed')
            data.extend(chunk)
        return bytes(data)

    @classmethod
    def _read_binary_message(cls, sock, write_lock=None):
        total = 0
        parts = []
        started = False
        while True:
            first, second = cls._read_exact(sock, 2)
            fin = bool(first & 0x80)
            if first & 0x70:
                raise ValueError('unsupported WebSocket extension')
            opcode = first & 0x0f
            masked = bool(second & 0x80)
            length = second & 0x7f
            if not masked:
                raise ValueError('client WebSocket frames must be masked')
            if length == 126:
                length = struct.unpack('!H', cls._read_exact(sock, 2))[0]
            elif length == 127:
                length = struct.unpack('!Q', cls._read_exact(sock, 8))[0]
                if length >> 63:
                    raise ValueError('invalid WebSocket frame length')
            if opcode >= 8 and (not fin or length > 125):
                raise ValueError('invalid WebSocket control frame')
            if total + length > cls._MAX_WS_MESSAGE:
                raise ValueError('WebSocket message exceeds the SGF transport limit')
            mask_key = cls._read_exact(sock, 4)
            payload = cls._read_exact(sock, length)
            payload = bytes(value ^ mask_key[index & 3] for index, value in enumerate(payload))
            if opcode == 8:
                return None
            if opcode == 9:
                cls._send_frame(sock, payload, 10, write_lock=write_lock)
                continue
            if opcode == 10:
                continue
            if opcode == 2:
                if started:
                    raise ValueError('nested WebSocket data message')
                started = True
            elif opcode == 0:
                if not started:
                    raise ValueError('unexpected WebSocket continuation frame')
            else:
                raise ValueError('only binary WebSocket messages are accepted')
            parts.append(payload)
            total += length
            if fin:
                return b''.join(parts)

    @staticmethod
    def _send_frame(sock, payload, opcode=2, *, write_lock=None):
        payload = bytes(payload)
        first = 0x80 | (int(opcode) & 0x0f)
        length = len(payload)
        if length < 126:
            header = bytes((first, length))
        elif length <= 65535:
            header = bytes((first, 126)) + struct.pack('!H', length)
        else:
            header = bytes((first, 127)) + struct.pack('!Q', length)
        if write_lock is None:
            sock.sendall(header + payload)
        else:
            with write_lock:
                sock.sendall(header + payload)

    def _handle_client(self, client):
        target = None
        client.settimeout(8.0)
        with self._active_lock:
            self._active.add(client)
        try:
            path, headers = self._read_request(client)
            connection_tokens = {part.strip().lower() for part in headers.get('connection', '').split(',')}
            if (path != self.path or headers.get('upgrade', '').lower() != 'websocket'
                    or 'upgrade' not in connection_tokens
                    or headers.get('sec-websocket-version') != '13'):
                try:
                    client.sendall(b'HTTP/1.1 404 Not Found\r\nConnection: close\r\nContent-Length: 0\r\n\r\n')
                except OSError:
                    pass
                return
            key = headers.get('sec-websocket-key', '')
            try:
                if len(_base64_mod.b64decode(key, validate=True)) != 16:
                    raise ValueError('bad key length')
            except Exception:
                return
            accept = _base64_mod.b64encode(
                _hashlib.sha1((key + '258EAFA5-E914-47DA-95CA-C5AB0DC85B11').encode('ascii')).digest()
            ).decode('ascii')
            target = _socket_mod.create_connection(('127.0.0.1', self.local_game_port), timeout=5.0)
            target.settimeout(None)
            client.sendall((
                'HTTP/1.1 101 Switching Protocols\r\n'
                'Upgrade: websocket\r\n'
                'Connection: Upgrade\r\n'
                f'Sec-WebSocket-Accept: {accept}\r\n\r\n'
            ).encode('ascii'))
            client.settimeout(None)
            with self._active_lock:
                self._active.update((client, target))
            done = threading.Event()
            client_write_lock = threading.Lock()

            def ws_to_tcp():
                try:
                    while not self._stop.is_set() and not done.is_set():
                        payload = self._read_binary_message(
                            client, write_lock=client_write_lock)
                        if payload is None:
                            break
                        if payload:
                            target.sendall(payload)
                except (OSError, ValueError, ConnectionError):
                    pass
                finally:
                    done.set()

            def tcp_to_ws():
                try:
                    while not self._stop.is_set() and not done.is_set():
                        payload = target.recv(65536)
                        if not payload:
                            break
                        self._send_frame(client, payload,
                                         write_lock=client_write_lock)
                except OSError:
                    pass
                finally:
                    done.set()

            inbound = threading.Thread(target=ws_to_tcp, name='SGF-ws-to-game', daemon=True)
            outbound = threading.Thread(target=tcp_to_ws, name='SGF-game-to-ws', daemon=True)
            inbound.start(); outbound.start()
            while not done.wait(0.2) and not self._stop.is_set():
                pass
            for sock in (client, target):
                try:
                    sock.shutdown(_socket_mod.SHUT_RDWR)
                except OSError:
                    pass
            inbound.join(timeout=0.3); outbound.join(timeout=0.3)
        except (OSError, ValueError, UnicodeError, ConnectionError):
            pass
        finally:
            with self._active_lock:
                self._active.discard(client)
                if target is not None:
                    self._active.discard(target)
            for sock in (client, target):
                if sock is not None:
                    try:
                        sock.close()
                    except OSError:
                        pass

    def _serve(self):
        while not self._stop.is_set():
            try:
                client, _address = self._listener.accept()
            except _socket_mod.timeout:
                continue
            except OSError:
                break
            if self._stop.is_set():
                client.close()
                break
            if not self._slots.acquire(blocking=False):
                try:
                    client.sendall(b'HTTP/1.1 503 Service Unavailable\r\nConnection: close\r\n'
                                   b'Content-Length: 0\r\n\r\n')
                except OSError:
                    pass
                client.close()
                continue
            threading.Thread(target=self._handle_client_slot, args=(client,),
                             name='SGF-cloudflare-ws-peer', daemon=True).start()
        self.state = 'stopped'

    def _handle_client_slot(self, client):
        try:
            self._handle_client(client)
        finally:
            self._slots.release()

    def stop(self):
        self._stop.set()
        listener = self._listener
        if listener is not None:
            try:
                listener.close()
            except OSError:
                pass
        with self._active_lock:
            active = tuple(self._active)
        for sock in active:
            try:
                sock.shutdown(_socket_mod.SHUT_RDWR)
            except OSError:
                pass
            try:
                sock.close()
            except OSError:
                pass
        if self._thread.is_alive() and self._thread is not threading.current_thread():
            self._thread.join(timeout=1.0)
        self.state = 'stopped'


def _cloudflared_asset_name():
    """Return the official portable Windows binary for this Python process."""
    if sys.platform != 'win32':
        raise RuntimeError('Automatic Cloudflare relay is currently supported on Windows only')
    return 'cloudflared-windows-amd64.exe' if sys.maxsize > 2 ** 32 else 'cloudflared-windows-386.exe'


def _cloudflared_cache_paths(version=None):
    root = os.path.join(_user_data_manager.get_tools_dir(), 'cloudflared')
    os.makedirs(root, exist_ok=True)
    if version is not None and not re.fullmatch(r'\d{4}\.\d{1,2}\.\d{1,3}', str(version)):
        raise ValueError('invalid cloudflared cache version')
    filename = f'cloudflared-{version}.exe' if version is not None else 'cloudflared.exe'
    return (os.path.join(root, filename), os.path.join(root, 'release.json'))


def _cloudflared_sha256(path):
    digest = _hashlib.sha256()
    with open(path, 'rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(chunk)
    return digest.hexdigest()


def _cloudflared_release_metadata(timeout=8.0):
    """Read the latest stable asset checksum from Cloudflare's official release."""
    import urllib.request as _urlrequest
    api_url = 'https://api.github.com/repos/cloudflare/cloudflared/releases/latest'
    request = _urlrequest.Request(api_url, headers={
        'Accept': 'application/vnd.github+json',
        'User-Agent': 'SGF multiplayer relay',
        'X-GitHub-Api-Version': '2022-11-28',
    })
    with _urlrequest.urlopen(request, timeout=max(1.0, float(timeout))) as response:
        payload = response.read(2_000_001)
    if len(payload) > 2_000_000:
        raise RuntimeError('Cloudflare release metadata is too large')
    release = json.loads(payload.decode('utf-8'))
    if not isinstance(release, dict) or release.get('draft') or release.get('prerelease'):
        raise RuntimeError('Cloudflare did not publish a stable release')
    version = str(release.get('tag_name') or '')
    if not re.fullmatch(r'\d{4}\.\d{1,2}\.\d{1,3}', version):
        raise RuntimeError('Cloudflare release version is invalid')
    asset = _cloudflared_asset_name()
    body = str(release.get('body') or '')
    match = re.search(rf'(?m)^\s*{re.escape(asset)}:\s*([0-9a-fA-F]{{64}})\s*$', body)
    if not match:
        raise RuntimeError('Official Cloudflare release has no checksum for this Windows binary')
    return version, match.group(1).lower(), asset


# Last release whose checksums were cross-checked against Cloudflare's official
# release notes. Used only when the GitHub API is unreachable or rate limited
# (60 requests/hour per IP without a token) and nothing is cached yet.
_CLOUDFLARED_PINNED_RELEASES = {
    'cloudflared-windows-amd64.exe': (
        '2026.10.0', '86aee4017b26625cee8484c113558f48effa4cd47f7aa05fcf425604e5d2b23c'),
    'cloudflared-windows-386.exe': (
        '2026.10.0', '0630a8779e9823a1a3b091698b8e71874e0f7b205559219f52fdd301466b5546'),
}
_CLOUDFLARED_UPDATE_CHECK_SECONDS = 3 * 24 * 3600


def _ensure_cloudflared_binary(progress=None, timeout=20.0):
    """Download and verify a per-user Cloudflare binary; never installs a service."""
    import urllib.request as _urlrequest
    _default_binary_path, manifest_path = _cloudflared_cache_paths()
    progress = progress or (lambda _state, _detail='': None)
    cached = None
    try:
        with open(manifest_path, 'r', encoding='utf-8') as stream:
            cached = json.load(stream)
        if (not isinstance(cached, dict)
                or cached.get('asset') != _cloudflared_asset_name()
                or not re.fullmatch(r'\d{4}\.\d{1,2}\.\d{1,3}', str(cached.get('version', '')))
                or not re.fullmatch(r'[0-9a-f]{64}', str(cached.get('sha256', '')))
                or not os.path.isfile(_cloudflared_cache_paths(cached['version'])[0])
                or not _hmac_mod.compare_digest(
                    _cloudflared_sha256(_cloudflared_cache_paths(cached['version'])[0]), cached['sha256'])):
            cached = None
    except Exception:
        cached = None

    progress('checking')
    if cached:
        # A verified component is reused without touching the network until it
        # is a few days old: the update check is slow when GitHub is rate
        # limiting and is not needed to host a game.
        try:
            cache_age = time.time() - os.path.getmtime(manifest_path)
        except OSError:
            cache_age = _CLOUDFLARED_UPDATE_CHECK_SECONDS
        if 0 <= cache_age < _CLOUDFLARED_UPDATE_CHECK_SECONDS:
            progress('starting', 'Using the previously verified Cloudflare component')
            return _cloudflared_cache_paths(cached['version'])[0], cached['version']
    try:
        version, expected_hash, asset = _cloudflared_release_metadata(timeout=min(6.0, timeout))
    except Exception:
        if cached:
            progress('starting', 'Using the previously verified Cloudflare component')
            return _cloudflared_cache_paths(cached['version'])[0], cached['version']
        pinned = _CLOUDFLARED_PINNED_RELEASES.get(_cloudflared_asset_name())
        if pinned is None:
            raise
        version, expected_hash = pinned
        asset = _cloudflared_asset_name()
        sgf_log.warning('Cloudflare release metadata unavailable; using the pinned verified release %s', version)
    if cached and cached.get('version') == version and cached.get('sha256') == expected_hash:
        try:
            os.utime(manifest_path, None)
        except OSError:
            pass
        return _cloudflared_cache_paths(version)[0], version

    binary_path, _manifest_path = _cloudflared_cache_paths(version)
    if (os.path.isfile(binary_path)
            and _hmac_mod.compare_digest(_cloudflared_sha256(binary_path), expected_hash)):
        return binary_path, version

    try:
        return _download_cloudflared_release(
            progress, timeout, version, asset, expected_hash, binary_path, manifest_path)
    except Exception:
        if cached:
            sgf_log.warning('Cloudflare component update failed; keeping the verified cached release')
            progress('starting', 'Using the previously verified Cloudflare component')
            return _cloudflared_cache_paths(cached['version'])[0], cached['version']
        raise


def _download_cloudflared_release(progress, timeout, version, asset, expected_hash,
                                  binary_path, manifest_path):
    import urllib.request as _urlrequest
    progress('downloading', version)
    url = f'https://github.com/cloudflare/cloudflared/releases/download/{version}/{asset}'
    request = _urlrequest.Request(url, headers={'User-Agent': 'SGF multiplayer relay'})
    temporary_path = os.path.join(os.path.dirname(binary_path), '.cloudflared-download.part')
    digest = _hashlib.sha256()
    total = 0
    try:
        with _urlrequest.urlopen(request, timeout=max(1.0, float(timeout))) as response:
            with open(temporary_path, 'wb') as output:
                while True:
                    chunk = response.read(1024 * 1024)
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > 80 * 1024 * 1024:
                        raise RuntimeError('Cloudflare binary exceeds the download size limit')
                    digest.update(chunk)
                    output.write(chunk)
                output.flush()
                os.fsync(output.fileno())
        if total < 1024 * 1024 or not _hmac_mod.compare_digest(digest.hexdigest(), expected_hash):
            raise RuntimeError('Downloaded Cloudflare binary failed its SHA-256 check')
        os.replace(temporary_path, binary_path)
        manifest = {'version': version, 'asset': asset, 'sha256': expected_hash}
        manifest_temp = manifest_path + '.tmp'
        with open(manifest_temp, 'w', encoding='utf-8') as stream:
            json.dump(manifest, stream, separators=(',', ':'))
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(manifest_temp, manifest_path)
        return binary_path, version
    finally:
        try:
            if os.path.exists(temporary_path):
                os.remove(temporary_path)
        except OSError:
            pass


_ACTIVE_CLOUDFLARE_SESSIONS = set()
_ACTIVE_CLOUDFLARE_SESSIONS_LOCK = threading.Lock()


def _stop_all_cloudflare_sessions():
    """Last-chance cleanup so a closed game never leaves cloudflared running."""
    with _ACTIVE_CLOUDFLARE_SESSIONS_LOCK:
        sessions = list(_ACTIVE_CLOUDFLARE_SESSIONS)
    for session in sessions:
        try:
            session.stop()
        except Exception:
            pass


atexit.register(_stop_all_cloudflare_sessions)


class CloudflareQuickTunnelSession:
    """Temporary Quick Tunnel using a per-user verified cloudflared binary."""
    _URL_PATTERN = re.compile(
        r'https://([a-z0-9-]+\.trycloudflare\.com)(?::([0-9]{1,5}))?(?:[/?\s]|$)',
        re.IGNORECASE)
    # cloudflared's own API host appears in error lines such as
    # 'failed to request quick Tunnel: Post "https://api.trycloudflare.com/tunnel"'
    # and must never be mistaken for the public tunnel address.
    _NOT_A_TUNNEL_LABELS = frozenset({'api', 'www'})
    # Printed once the tunnel has an authenticated connection to Cloudflare's
    # edge (older releases phrase it 'Connection <uuid> registered').
    _REGISTERED_PATTERN = re.compile(
        r'registered tunnel connection|connection [0-9a-f-]{36} registered', re.IGNORECASE)
    _URL_TIMEOUT = 60.0
    _EDGE_TIMEOUT = 75.0

    def __init__(self, local_port, invite):
        self.local_port = int(local_port)
        self.invite = str(invite)
        self.state = 'checking'
        self.endpoint = None
        self.public_port = None
        self.detail = ''
        self.process = None
        self.bridge = None
        self._cancelled = threading.Event()
        self._lock = threading.Lock()
        self._logs = _queue_mod.Queue(maxsize=64)
        self._thread = threading.Thread(target=self._setup, name='SGF-cloudflare-tunnel', daemon=True)

    def start(self):
        try:
            self.bridge = _CloudflareWebSocketBridge(self.local_port, self.invite).start()
        except Exception as exc:
            self._set('unavailable', str(exc))
            return self
        with _ACTIVE_CLOUDFLARE_SESSIONS_LOCK:
            _ACTIVE_CLOUDFLARE_SESSIONS.add(self)
        self._thread.start()
        return self

    def _set(self, state, detail=''):
        with self._lock:
            self.state = str(state)
            self.detail = str(detail or '')[:240]

    def snapshot(self):
        with self._lock:
            return self.state, self.endpoint, self.public_port, self.detail

    @staticmethod
    def _parse_public_url(line):
        for match in CloudflareQuickTunnelSession._URL_PATTERN.finditer(str(line or '')):
            if match.group(1).split('.', 1)[0].lower() in CloudflareQuickTunnelSession._NOT_A_TUNNEL_LABELS:
                continue
            break
        else:
            return None
        port = int(match.group(2)) if match.group(2) else 443
        if not 1 <= port <= 65535:
            raise RuntimeError('Cloudflare returned an invalid public port')
        return match.group(1).lower(), port

    @staticmethod
    def _wait_for_public_dns(host, port, timeout=15.0, resolver=None):
        """Wait until Cloudflare's DNS publishes the temporary hostname.

        The check goes through DNS-over-HTTPS on purpose: probing the OS
        resolver while the name does not exist yet makes Windows cache the
        NXDOMAIN answer and then keep failing for minutes, even after the name
        has propagated (this is what produced WinError 11001 on the host).
        """
        resolve = resolver or (lambda name, number, type=None: _resolve_via_doh(name, number))
        deadline = time.monotonic() + max(0.0, float(timeout))
        last_error = None
        unreachable = 0
        while True:
            try:
                answers = resolve(host, int(port), type=_socket_mod.SOCK_STREAM)
                unreachable = 0
                if answers:
                    return True
            except OSError as exc:
                last_error = exc
                unreachable += 1
                if resolver is None and unreachable >= 3:
                    raise RuntimeError('DNS-over-HTTPS check unavailable') from exc
            if time.monotonic() >= deadline:
                detail = type(last_error).__name__ if last_error else 'no DNS answers'
                raise RuntimeError(f'Cloudflare hostname did not resolve ({detail})')
            time.sleep(min(0.8, max(0.0, deadline - time.monotonic())))

    @staticmethod
    def _probe_edge_ready(metrics_port, timeout=1.0):
        """cloudflared's own readiness endpoint: 200 once an edge connection is up."""
        import urllib.request as _urlrequest
        try:
            with _urlrequest.urlopen(
                    f'http://127.0.0.1:{int(metrics_port)}/ready', timeout=timeout) as response:
                return response.status == 200
        except Exception:
            return False

    @staticmethod
    def _free_loopback_port():
        probe = _socket_mod.socket(_socket_mod.AF_INET, _socket_mod.SOCK_STREAM)
        try:
            probe.bind(('127.0.0.1', 0))
            return probe.getsockname()[1]
        finally:
            probe.close()

    def _read_process_output(self):
        process = self.process
        if process is None or process.stdout is None:
            return
        try:
            for line in process.stdout:
                try:
                    self._logs.put_nowait(line.rstrip())
                except _queue_mod.Full:
                    try:
                        self._logs.get_nowait()
                        self._logs.put_nowait(line.rstrip())
                    except Exception:
                        pass
        except (OSError, ValueError):
            pass

    @staticmethod
    def _redacted_tail(lines):
        text = ' | '.join(str(line).strip() for line in lines if str(line).strip())
        text = re.sub(r'\b[a-z0-9-]+\.trycloudflare\.com\b', '[relay]', text, flags=re.IGNORECASE)
        return text[-600:]

    def _setup(self):
        try:
            binary, version = _ensure_cloudflared_binary(
                progress=lambda state, detail='': self._set(state, detail))
            if self._cancelled.is_set():
                self._set('stopped')
                return
            if not self.bridge or self.bridge.state != 'ready':
                raise RuntimeError('Local WebSocket bridge did not start')
            self._set('starting', f'cloudflared {version}')
            flags = getattr(subprocess, 'CREATE_NO_WINDOW', 0) if sys.platform == 'win32' else 0
            # The metrics listener doubles as cloudflared's readiness probe
            # (/ready answers 200 once an edge connection is registered).
            metrics_port = self._free_loopback_port()
            self.process = subprocess.Popen(
                [binary, 'tunnel', '--no-autoupdate', '--url',
                 f'http://127.0.0.1:{self.bridge.port}',
                 '--metrics', f'127.0.0.1:{metrics_port}'],
                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, encoding='utf-8', errors='replace', bufsize=1,
                creationflags=flags,
            )
            process = self.process
            reader = threading.Thread(target=self._read_process_output,
                                      name='SGF-cloudflared-output', daemon=True)
            reader.start()
            self._set('verifying')
            url_deadline = time.monotonic() + self._URL_TIMEOUT
            edge_deadline = None
            registered = False
            next_probe = 0.0
            tail = []
            # Phase 1: wait for the temporary address. Phase 2: wait until the
            # tunnel really has a connection to Cloudflare's edge. Publishing
            # the invite before that point hands friends an address that
            # answers with an error page.
            while not self._cancelled.is_set():
                try:
                    line = self._logs.get(timeout=0.35)
                except _queue_mod.Empty:
                    line = ''
                if line:
                    tail.append(line)
                    del tail[:-8]
                    if self._REGISTERED_PATTERN.search(line):
                        registered = True
                if self.endpoint is None:
                    public_endpoint = self._parse_public_url(line)
                    if public_endpoint:
                        self.endpoint, self.public_port = public_endpoint
                        edge_deadline = time.monotonic() + self._EDGE_TIMEOUT
                        self._set('verifying', 'Waiting for the Cloudflare edge connection')
                if process.poll() is not None:
                    sgf_log.warning('cloudflared stopped early (code %s): %s',
                                    process.returncode, self._redacted_tail(tail))
                    raise RuntimeError(f'cloudflared exited with code {process.returncode}')
                now = time.monotonic()
                if self.endpoint is None:
                    if now >= url_deadline:
                        sgf_log.warning('No Quick Tunnel address from cloudflared: %s',
                                        self._redacted_tail(tail))
                        raise RuntimeError('Timed out waiting for a Cloudflare Quick Tunnel URL')
                    continue
                if not registered and now >= next_probe:
                    next_probe = now + 1.0
                    registered = self._probe_edge_ready(metrics_port)
                if not registered:
                    if now >= edge_deadline:
                        sgf_log.warning('cloudflared never registered an edge connection: %s',
                                        self._redacted_tail(tail))
                        raise RuntimeError('Cloudflare edge connection was not established')
                    continue
                break
            if self._cancelled.is_set():
                self._set('stopped')
                return

            self._set('verifying', 'Checking public tunnel DNS')
            try:
                self._wait_for_public_dns(self.endpoint, self.public_port, timeout=25.0)
            except RuntimeError as dns_error:
                if self._cancelled.is_set():
                    self._set('stopped')
                    return
                # The edge connection is up and the temporary URL was issued.
                # A DNS check that cannot confirm propagation must not tear the
                # relay down: guests resolve it from their own networks.
                self._set('ready', f'DNS propagation not confirmed ({type(dns_error).__name__})')
                sgf_log.warning(
                    'Cloudflare relay is connected, but DNS propagation of its temporary hostname '
                    'could not be confirmed (%s)', _describe_relay_failure(dns_error))
            else:
                if self._cancelled.is_set():
                    self._set('stopped')
                    return
                self._set('ready')
            sgf_log.info('Cloudflare relay ready (cloudflared %s)', version)
            while not self._cancelled.is_set():
                if process.poll() is not None:
                    self._set('unavailable',
                              f'Cloudflare tunnel stopped with code {process.returncode}')
                    return
                time.sleep(0.4)
        except Exception as exc:
            if not self._cancelled.is_set():
                self._set('unavailable', str(exc))
        finally:
            if self.state != 'ready':
                self._stop_process()
                if self.bridge is not None:
                    self.bridge.stop()
                with _ACTIVE_CLOUDFLARE_SESSIONS_LOCK:
                    _ACTIVE_CLOUDFLARE_SESSIONS.discard(self)

    def _stop_process(self):
        process = self.process
        self.process = None
        if process is not None:
            if process.poll() is None:
                try:
                    process.terminate()
                    process.wait(timeout=3.0)
                except Exception:
                    try:
                        process.kill()
                    except Exception:
                        pass
            try:
                if process.stdout:
                    process.stdout.close()
            except Exception:
                pass

    def stop(self):
        self._cancelled.set()
        self._stop_process()
        if self.bridge is not None:
            self.bridge.stop()
        self._set('stopped')
        with _ACTIVE_CLOUDFLARE_SESSIONS_LOCK:
            _ACTIVE_CLOUDFLARE_SESSIONS.discard(self)


