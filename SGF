    # ---- category introspection / selective deletion (contract for IA-1) --
    def list_data_categories(self):
        return [
            {'name': name, 'path': self._get_dir(name), 'size_bytes': self.get_category_size(name)}
            for name in self._USER_FACING_CATEGORIES
        ]

    def get_category_size(self, category):
        path = self._get_dir(category)
        total = 0
        try:
            for dirpath, _dirnames, filenames in os.walk(path):
                for fn in filenames:
                    try:
                        total += os.path.getsize(os.path.join(dirpath, fn))
                    except OSError:
                        pass
        except Exception:
            pass
        return total

    def delete_category(self, category, keep_dir=True):
        """Delete every file inside ONE category directory. Never touches any
        other category — deleting replays can never delete saves, etc."""
        if category not in self._CATEGORY_DIRNAMES:
            return False, f"Unknown data category: {category}"
        path = self._get_dir(category)
        try:
            import shutil as _shutil
            for entry in os.listdir(path):
                full = os.path.join(path, entry)
                if os.path.isdir(full):
                    _shutil.rmtree(full, ignore_errors=True)
                else:
                    try:
                        os.remove(full)
                    except OSError:
                        pass
            if keep_dir:
                os.makedirs(path, exist_ok=True)
            return True, None
        except Exception as e:
            return False, str(e)

    def delete_single_file(self, category, filename):
        """Delete one specific file inside one category (e.g. a single
        replay) without touching the rest of that category."""
        if category not in self._CATEGORY_DIRNAMES:
            return False, f"Unknown data category: {category}"
        path = os.path.abspath(self._get_dir(category))
        target = os.path.abspath(os.path.join(path, filename))
        if not target.startswith(path + os.sep):
            return False, "Invalid filename"
        try:
            if os.path.exists(target):
                os.remove(target)
            return True, None
        except Exception as e:
            return False, str(e)

    def open_data_folder(self):
        """Best-effort: open the root SGF Data folder in the OS file browser."""
        return _open_folder_in_os(self.get_root_dir())

    def export_data(self, dest_zip_path=None):
        """Zip settings/saves/replays/maps/mods/themes/profiles (NOT logs/
        cache/crashes/diagnostics) into one portable file for backup or
        transfer."""
        import zipfile
        if dest_zip_path is None:
            ts = datetime.now().strftime('%Y%m%d_%H%M%S')
            dest_zip_path = os.path.join(self.get_backup_dir(), f'sgf_export_{ts}.zip')
        include = ['config', 'saves', 'replays', 'maps', 'mods', 'themes']
        try:
            with zipfile.ZipFile(dest_zip_path, 'w', zipfile.ZIP_DEFLATED) as zf:
                for cat in include:
                    path = self._get_dir(cat)
                    for dirpath, _dirnames, filenames in os.walk(path):
                        for fn in filenames:
                            full = os.path.join(dirpath, fn)
                            rel = os.path.relpath(full, self.get_root_dir())
                            zf.write(full, rel)
            return dest_zip_path
        except Exception as e:
            print(f"Error exporting data: {e}")
            return None

    def factory_reset(self, categories=None, backup_first=True):
        """Broad, explicit deletion across multiple categories. Never
        deletes application code, and backs up first by default."""
        if categories is None:
            categories = ['config', 'saves', 'replays', 'maps', 'mods', 'themes', 'cache']
        backup_path = self.export_data() if backup_first else None
        results = {cat: self.delete_category(cat) for cat in categories}
        return {'backup_path': backup_path, 'results': results}


