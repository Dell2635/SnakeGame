                    elif isinstance(controls.get('bgm_enabled'), pygame.Rect) and controls['bgm_enabled'].collidepoint(mouse_pos):
                        self.temp_settings.bgm_enabled = not getattr(self.temp_settings, 'bgm_enabled', False)
                    elif controls['save_button'].collidepoint(mouse_pos):
                        # Apply changes - basic settings
                        self.settings.update_rate_ms = self.temp_settings.update_rate_ms
                        self.settings.board_size = self.temp_settings.board_size
                        self.settings.snake_color = self.temp_settings.snake_color
                        self.settings.language = self.temp_settings.language
                        self.settings.wall_collision = self.temp_settings.wall_collision
                        
                        # Apply changes - power-up settings
                        self.settings.powerups_enabled = self.temp_settings.powerups_enabled
                        self.settings.speed_boost_enabled = self.temp_settings.speed_boost_enabled
                        self.settings.slow_motion_enabled = self.temp_settings.slow_motion_enabled
                        self.settings.size_reduction_enabled = self.temp_settings.size_reduction_enabled
                        self.settings.invincibility_enabled = self.temp_settings.invincibility_enabled
