    # ------------------------------------------------------------------
    # REPLAY SYSTEM  – compact snapshot-based recording and playback
    # ------------------------------------------------------------------

    def _snap(self):
        """Create a compact, JSON-serialisable snapshot of the current game state.

        Format (12-element list – indices must stay stable):
          [snake, fruit_pos, fruit_type, score, direction,
           powerup_pos, powerup_type, active_pu_data, obstacles, portals,
           effect_state, fruit_value]

        active_pu_data: list of [type_str, remaining_ms]   (index 7)
        effect_state:   [speed_multiplier, points_multiplier,
                         invincible, ghost_mode, shield_active,
                         length_speed_multiplier]            (index 10)
        fruit_value:    int                                  (index 11)
        """
        current_time = time.time() * 1000
        pu_data = []
        if hasattr(self, 'active_powerups'):
            for p in self.active_powerups:
                remaining = max(0.0, p['duration'] - (current_time - p['start_time']))
                pu_data.append([p['type'], remaining])
        return [
            [list(s) for s in self.snake],                                 # 0
            list(self.fruit_position) if self.fruit_position else None,    # 1
            getattr(self, 'current_fruit_type', 'regular'),               # 2
            self.score,                                                     # 3
            list(self.direction),                                          # 4
            list(self.powerup_position) if self.powerup_position else None,# 5
            getattr(self, 'powerup_type', None),                          # 6
            pu_data,                                                        # 7 [[type, remaining_ms], ...]
            [list(o) for o in self.obstacles] if self.obstacles else [],  # 8
            [[list(p[0]), list(p[1]), p[2]] for p in self.portals]        # 9
            if self.portals else [],
            [                                                               # 10 effect_state
                getattr(self, 'speed_multiplier',        1.0),
                getattr(self, 'points_multiplier',       1.0),
                getattr(self, 'invincible',              False),
                getattr(self, 'ghost_mode',              False),
                getattr(self, 'shield_active',           False),
                getattr(self, 'length_speed_multiplier', 1.0),
            ],
            getattr(self, 'current_fruit_value', 1),                      # 11 fruit_value
        ]

    def _load_snap(self, snap):
        """Restore game state from a compact snapshot (for replay playback).

        Supports both:
          - Old format (10 elements): index 7 is a list of type strings
          - New format (12 elements): index 7 is [[type, remaining_ms], ...],
            index 10 is effect_state, index 11 is fruit_value
        """
        self.snake            = [tuple(s) for s in snap[0]]
        self.fruit_position   = tuple(snap[1]) if snap[1] else None
        self.current_fruit_type  = snap[2] if len(snap) > 2 else 'regular'
        self.score            = snap[3] if len(snap) > 3 else 0
        self.direction        = tuple(snap[4]) if len(snap) > 4 else (1, 0)
        self.next_direction   = self.direction
        self.powerup_position = tuple(snap[5]) if (len(snap) > 5 and snap[5]) else None
        self.powerup_type     = snap[6] if len(snap) > 6 else None

        # Restore active powerups with correct remaining time.
        # New format: [[type_str, remaining_ms], ...]
        # Old format: [type_str, ...]  — assume full 10 s duration for display
        current_time = time.time() * 1000
        pu_raw = snap[7] if len(snap) > 7 else []
        self.active_powerups = []
        for entry in pu_raw:
            if isinstance(entry, list):
                pu_type      = entry[0]
                remaining_ms = max(0.0, float(entry[1]))
            else:
                pu_type      = entry          # old format: bare string
                remaining_ms = 10000.0        # assume 10 s left for display
            self.active_powerups.append({
                'type':       pu_type,
                'start_time': current_time,
                'duration':   remaining_ms,
            })

        self.obstacles = [tuple(o) for o in snap[8]] \
            if len(snap) > 8 and snap[8] else []
        self.portals   = [(tuple(p[0]), tuple(p[1]), p[2]) for p in snap[9]] \
            if len(snap) > 9 and snap[9] else []

        # ── Restore effect-state flags (index 10, new format) ──────────────
        active_types = {p['type'] for p in self.active_powerups}
        if len(snap) > 10 and snap[10]:
            fx = snap[10]
            self.speed_multiplier        = float(fx[0]) if len(fx) > 0 else 1.0
            self.points_multiplier       = float(fx[1]) if len(fx) > 1 else 1.0
            self.invincible              = bool(fx[2])   if len(fx) > 2 else False
            self.ghost_mode              = bool(fx[3])   if len(fx) > 3 else False
            self.shield_active           = bool(fx[4])   if len(fx) > 4 else False
            self.length_speed_multiplier = float(fx[5]) if len(fx) > 5 else 1.0
        else:
            # Old format — derive best-guess effect state from active types
            if 'speed_boost' in active_types:
                self.speed_multiplier = 0.5
            elif 'slow_motion' in active_types:
                self.speed_multiplier = 2.0
            else:
                self.speed_multiplier = 1.0
            self.points_multiplier       = 2.0 if 'double_points'  in active_types else 1.0
            self.invincible              = 'invincibility' in active_types
            self.ghost_mode              = 'ghost_mode'    in active_types
            self.shield_active           = 'shield'        in active_types
            self.length_speed_multiplier = 1.0

        # ── Fruit value (index 11, new format) ────────────────────────────
        self.current_fruit_value = snap[11] if len(snap) > 11 else 1

        self.game_over = False
        self.victory   = False

    def start_replay(self, game_history):
        """Enter replay mode from a saved list of compact snapshots."""
        if not game_history:
            return False
        self.replay_mode  = True
        self.game_history = game_history
        self.replay_index = 0
        self.replay_speed = 1.0
        self.paused       = False
        self._replay_ended = False
        self._replay_ctrl_rects = {}
        self._replay_seek_held = None    # 'rewind' | 'ff' | None — for hold-to-repeat seeking
        self._replay_hold_start = 0
        self._replay_last_repeat = 0
        self._load_snap(self.game_history[0])
        return True

    def _replay_seek_repeat_interval(self, held_duration):
        """Accelerating repeat interval for hold-to-seek: starts leisurely,
        speeds up the longer the button/key is held, caps out fast but not
        so fast it feels uncontrollable."""
        if held_duration < 0.5:
            return 0.30
        elif held_duration < 1.2:
            return 0.15
        elif held_duration < 2.5:
            return 0.08
        else:
            return 0.04

    def _replay_process_held_seek(self):
        """Called once per frame: if rewind/ff is being held (mouse button
        down or arrow key down), repeat the seek at an accelerating rate."""
        if not self.replay_mode or not getattr(self, '_replay_seek_held', None):
            return
        now = time.time()
        held_duration = now - self._replay_hold_start
        interval = self._replay_seek_repeat_interval(held_duration)
        if now - self._replay_last_repeat >= interval:
            self._replay_last_repeat = now
            steps = max(1, len(self.game_history) // 10)
            if self._replay_seek_held == 'ff':
                self.replay_index = min(len(self.game_history) - 1, self.replay_index + steps)
                self._load_snap(self.game_history[self.replay_index])
                self._replay_ended = (self.replay_index >= len(self.game_history) - 1)
            else:  # 'rewind'
                self._replay_step_back(steps)
                self._replay_ended = False

    def replay_next_frame(self):
        """Advance replay by one frame. Returns False when at the last frame."""
        if not self.replay_mode or self.replay_index >= len(self.game_history) - 1:
            return False
        # Remember which powerup types are active before we advance
        prev_types = {p['type'] for p in self.active_powerups}
        self.replay_index += 1
        self._load_snap(self.game_history[self.replay_index])
        # Play the powerup sound for any powerup that newly appeared this frame
        new_types = {p['type'] for p in self.active_powerups}
        if new_types - prev_types:
            sounds().play('powerup')
        return True

    def _replay_step_back(self, steps=1):
        """Step back N frames in the replay."""
        self.replay_index = max(0, self.replay_index - steps)
        self._load_snap(self.game_history[self.replay_index])

    def _replay_seek(self, fraction):
        """Jump to a position in the replay (fraction 0.0–1.0)."""
        if not self.game_history:
            return
        idx = int(fraction * (len(self.game_history) - 1))
        self.replay_index = max(0, min(len(self.game_history) - 1, idx))
        self._load_snap(self.game_history[self.replay_index])
        self._replay_ended = (self.replay_index >= len(self.game_history) - 1)

    def replay_handle_click(self, pos):
        """Handle a mouse click on the replay control panel."""
        if not self.replay_mode or not hasattr(self, '_replay_ctrl_rects'):
            return False
        rects = self._replay_ctrl_rects

        if 'scrubber_track' in rects and rects['scrubber_track'].collidepoint(pos):
            track = rects['scrubber_track']
            frac  = max(0.0, min(1.0, (pos[0] - track.x) / max(1, track.width)))
            self._replay_seek(frac)
            self._replay_ended = (self.replay_index >= len(self.game_history) - 1)
            return True

        if 'restart' in rects and rects['restart'].collidepoint(pos):
            self.replay_index  = 0
            self.paused        = False
            self._replay_ended = False
            self._load_snap(self.game_history[0])
            return True

        if 'rewind' in rects and rects['rewind'].collidepoint(pos):
            steps = max(1, len(self.game_history) // 10)
            self._replay_step_back(steps)
            self._replay_ended = False
            self._replay_seek_held = 'rewind'
            self._replay_hold_start = time.time()
            self._replay_last_repeat = time.time()
            return True

        if 'play_pause' in rects and rects['play_pause'].collidepoint(pos):
            if self._replay_ended:
                self.replay_index  = 0
                self.paused        = False
                self._replay_ended = False
                self._load_snap(self.game_history[0])
            else:
                self.paused = not self.paused
            return True

        if 'ff' in rects and rects['ff'].collidepoint(pos):
            steps = max(1, len(self.game_history) // 10)
            self.replay_index = min(len(self.game_history) - 1,
                                    self.replay_index + steps)
            self._load_snap(self.game_history[self.replay_index])
            self._replay_ended = (self.replay_index >= len(self.game_history) - 1)
            self._replay_seek_held = 'ff'
            self._replay_hold_start = time.time()
            self._replay_last_repeat = time.time()
            return True

        for spd in [0.5, 1.0, 2.0, 4.0]:
            key = f'speed_{spd}'
            if key in rects and rects[key].collidepoint(pos):
                self.replay_speed = spd
                return True

        if 'exit' in rects and rects['exit'].collidepoint(pos):
            self._replay_exit_requested = True
            return True

        return False

    def replay_control(self, event):
        """Handle keyboard shortcuts while in replay mode."""
        if not self.replay_mode or event.type != pygame.KEYDOWN:
            return
        k = event.key
        if k == pygame.K_SPACE:
            if self._replay_ended:
                self.replay_index  = 0
                self.paused        = False
                self._replay_ended = False
                self._load_snap(self.game_history[0])
            else:
                self.paused = not self.paused
        elif k == pygame.K_RIGHT:
            steps = max(1, len(self.game_history) // 10)
            self.replay_index = min(len(self.game_history) - 1,
                                    self.replay_index + steps)
            self._load_snap(self.game_history[self.replay_index])
            self._replay_ended = (self.replay_index >= len(self.game_history) - 1)
            self._replay_seek_held = 'ff'
            self._replay_hold_start = time.time()
            self._replay_last_repeat = time.time()
        elif k == pygame.K_LEFT:
            steps = max(1, len(self.game_history) // 10)
            self._replay_step_back(steps)
            self._replay_ended = False
            self._replay_seek_held = 'rewind'
            self._replay_hold_start = time.time()
            self._replay_last_repeat = time.time()
        elif k == pygame.K_r:
            self.replay_index  = 0
            self.paused        = False
            self._replay_ended = False
            self._load_snap(self.game_history[0])
        elif k == pygame.K_ESCAPE:
            self._replay_exit_requested = True

    def draw_replay_controls(self):
        """Draw the full replay control panel overlaid at the bottom of the screen."""
        if not self.replay_mode:
            return

        sw, sh   = self.screen.get_width(), self.screen.get_height()
        # Scale relative to a comfortable desktop baseline, but never let
        # touch targets shrink below a usable size on narrow/phone screens.
        scale    = max(0.72, min(1.35, sw / 800.0))
        panel_h  = int(115 * scale)
        panel_y  = sh - panel_h

        # ── semi-transparent panel background ──────────────────────────────
        overlay = pygame.Surface((sw, panel_h), pygame.SRCALPHA)
        overlay.fill((8, 12, 28, 215))
        self.screen.blit(overlay, (0, panel_y))
        pygame.draw.line(self.screen, (50, 90, 155), (0, panel_y), (sw, panel_y), 2)

        # ── "REPLAY" badge top-left corner ─────────────────────────────────
        badge_font = get_font(self.settings.language, 'bold', max(11, int(13 * scale)))
        badge_surf = badge_font.render("  ● REC REPLAY  ", True, (255, 80, 80))
        badge_bg   = pygame.Rect(8, 8, badge_surf.get_width() + 6, badge_surf.get_height() + 4)
        pygame.draw.rect(self.screen, (60, 10, 10), badge_bg, border_radius=4)
        pygame.draw.rect(self.screen, (180, 40, 40), badge_bg, width=1, border_radius=4)
        self.screen.blit(badge_surf, (badge_bg.x + 3, badge_bg.y + 2))

        # ── scrubber / progress bar ─────────────────────────────────────────
        margin   = max(10, int(16 * scale))
        track_y  = panel_y + int(10 * scale)
        track_h  = max(10, int(14 * scale))
        track    = pygame.Rect(margin, track_y, sw - margin * 2, track_h)
        pygame.draw.rect(self.screen, (30, 45, 75), track, border_radius=track_h // 2)

        total    = max(1, len(self.game_history) - 1)
        filled_w = int((self.replay_index / total) * track.width)
        if filled_w > 0:
            pygame.draw.rect(self.screen, (50, 120, 210),
                             pygame.Rect(track.x, track.y, filled_w, track_h),
                             border_radius=track_h // 2)
        thumb_x = track.x + filled_w
        thumb_r = max(8, int(9 * scale))
        pygame.draw.circle(self.screen, (100, 170, 255), (thumb_x, track.centery), thumb_r)
        pygame.draw.circle(self.screen, (210, 235, 255), (thumb_x, track.centery), max(4, thumb_r - 4))

        # ── control buttons — sized for touch (min ~40px tall) as well as mouse ──
        btn_y   = panel_y + int(33 * scale)
        btn_h   = max(40, int(36 * scale))
        btn_fnt = get_font(self.settings.language, 'bold', max(13, int(14 * scale)))
        rects   = {'scrubber_track': track}

        def _btn(label, x, w, bg=(28, 55, 100), fg=(210, 230, 255)):
            r = pygame.Rect(x, btn_y, w, btn_h)
            pygame.draw.rect(self.screen, bg, r, border_radius=6)
            pygame.draw.rect(self.screen, (70, 120, 195), r, width=1, border_radius=6)
            s = btn_fnt.render(label, True, fg)
            self.screen.blit(s, (r.centerx - s.get_width() // 2,
                                 r.centery - s.get_height() // 2))
            return r

        cx  = margin
        gap = max(4, int(6 * scale))
        w_narrow = max(36, int(38 * scale))
        w_pp     = max(52, int(58 * scale))
        w_speed  = max(38, int(42 * scale))
        w_exit   = max(42, int(46 * scale))

        rects['restart']    = _btn("|<",  cx, w_narrow); cx += w_narrow + gap
        rects['rewind']     = _btn("<<",  cx, w_narrow); cx += w_narrow + gap

        if self._replay_ended:
            pp_lbl, pp_bg = "Replay", (30, 80, 50)
        elif self.paused:
            pp_lbl, pp_bg = "  >  ", (90, 55, 20)
        else:
            pp_lbl, pp_bg = " || ", (25, 70, 40)
        rects['play_pause'] = _btn(pp_lbl, cx, w_pp, bg=pp_bg); cx += w_pp + gap

        rects['ff']         = _btn(">>",  cx, w_narrow); cx += w_narrow + gap + int(10 * scale)

        # Speed selector — hidden on very narrow screens where it wouldn't fit;
        # players can still change speed via the settings/keyboard.
        remaining_w = sw - margin - cx
        n_speeds = len([spd for spd in [0.5, 1.0, 2.0, 4.0]])
        if remaining_w >= n_speeds * (w_speed + gap) + w_exit + gap + margin:
            for spd in [0.5, 1.0, 2.0, 4.0]:
                active = abs(self.replay_speed - spd) < 0.01
                bg = (55, 95, 165) if active else (22, 40, 78)
                fg = (255, 255, 255) if active else (140, 175, 220)
                rects[f'speed_{spd}'] = _btn(f"{spd:g}x", cx, w_speed, bg=bg, fg=fg)
                cx += w_speed + gap
            cx += 8

        rects['exit'] = _btn("Exit", cx, w_exit, bg=(85, 25, 25), fg=(255, 200, 200))

        # ── status text row (hidden on narrow/short screens where it won't fit) ──
        info_y   = panel_y + int(78 * scale)
        if sh > 260 and sw > 420:
            info_fnt = get_font(self.settings.language, 'regular', max(10, int(12 * scale)))

            cur_score = self.game_history[self.replay_index][3] \
                if self.game_history and len(self.game_history[self.replay_index]) > 3 else 0
            status = f"  Frame {self.replay_index + 1} / {len(self.game_history)}   Score: {cur_score}"
            if self._replay_ended:
                status += "   [REPLAY ENDED]"
            elif self.paused:
                status += "   [PAUSED]"
            left_s = info_fnt.render(status, True, (150, 185, 230))
            self.screen.blit(left_s, (margin, info_y))

            # Show seed used for this replay
            seed_info = info_fnt.render(
                f"  Seed: {getattr(self, 'seed', '?')}",
                True, (90, 130, 190))
            self.screen.blit(seed_info, (margin, info_y + int(14 * scale)))

            if sw > 640:
                hint = "SPACE: pause/resume   Hold ← →: seek (accelerates)   R: restart   ESC: exit"
                hint_s = info_fnt.render(hint, True, (80, 110, 155))
                self.screen.blit(hint_s, (sw - hint_s.get_width() - margin, info_y))

        # Store rects for click handling
        self._replay_ctrl_rects = rects
            
    def run(self):
        """Run the game loop"""
        running = True
        clock = pygame.time.Clock()
        replay_timer = 0
        
        while running:
            # Handle events
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif self.replay_mode:
                        # Handle replay controls
                        self.replay_control(event)
                    else:
                        # Normal game controls
                        running = self.handle_input(event)

                elif event.type == pygame.KEYUP:
                    if self.replay_mode and event.key in (pygame.K_LEFT, pygame.K_RIGHT):
                        self._replay_seek_held = None
                    
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    mp = event.pos
                    if self.replay_mode:
                        # Route all clicks through the replay control handler
                        self.replay_handle_click(mp)
                    elif (self.game_over or self.victory) and hasattr(self, '_go_buttons'):
                        gb = self._go_buttons
                        if gb.get('play_again') and gb['play_again'].collidepoint(mp):
                            self.reset_game()
                        elif gb.get('menu') and gb['menu'].collidepoint(mp):
                            running = False
                        elif gb.get('copy_seed') and gb['copy_seed'].collidepoint(mp):
                            if _copy_to_clipboard(str(self.seed)):
                                self._seed_copied_until = time.time() + 2.0
                        elif gb.get('view_replay') and gb['view_replay'].collidepoint(mp):
                            self.start_replay(self.game_history)
                    else:
                        # Check if pause button was clicked
                        pause_button = self.draw_pause_button()
                        if pause_button and pause_button.collidepoint(mp):
                            self.paused = not self.paused
                        # D-pad touch controls
                        elif hasattr(self, '_dpad_rects'):
                            dr = self._dpad_rects
                            if dr['U'].collidepoint(mp) and self.direction != (0, 1):
                                self.next_direction = (0, -1)
                            elif dr['D'].collidepoint(mp) and self.direction != (0, -1):
                                self.next_direction = (0, 1)
                            elif dr['L'].collidepoint(mp) and self.direction != (1, 0):
                                self.next_direction = (-1, 0)
                            elif dr['R'].collidepoint(mp) and self.direction != (-1, 0):
                                self.next_direction = (1, 0)
                            elif dr['C'].collidepoint(mp):
                                self.paused = not self.paused
                        
                elif event.type == pygame.MOUSEBUTTONUP and event.button == 1:
                    if self.replay_mode:
                        self._replay_seek_held = None

                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    # Recalculate cell size and board position
                    self.cell_size = min(self.screen.get_width(), self.screen.get_height()) // max(self.board_width, self.board_height)
                    self.board_offset_x = (self.screen.get_width() - (self.board_width * self.cell_size)) // 2
                    self.board_offset_y = (self.screen.get_height() - (self.board_height * self.cell_size)) // 2
            
            # Update game state
            current_time = time.time() * 1000  # Convert to milliseconds
            
            # Exit replay cleanly (returns to the caller — e.g. HighScoresScreen)
            if self._replay_exit_requested:
                running = False
                self.replay_mode = False
                self._replay_exit_requested = False
                continue

            if self.replay_mode:
                # Hold-to-repeat seeking (rewind/ff button held, or arrow key held) —
                # accelerates the longer it's held.
                self._replay_process_held_seek()

                # Handle replay animation — advance one tick per effective frame interval.
                # Use the speed_multiplier restored from the snapshot so that speed-boost
                # and slow-motion powerups change the playback cadence just as they did
                # during the original game.
                if not self.paused and not self._replay_ended:
                    replay_timer += clock.get_time() * self.replay_speed
                    snap_speed = getattr(self, 'speed_multiplier', 1.0)
                    snap_lspd  = getattr(self, 'length_speed_multiplier', 1.0)
                    effective_frame_ms = self.settings.update_rate_ms * snap_speed * snap_lspd
                    if replay_timer >= effective_frame_ms:
                        more_frames = self.replay_next_frame()
                        if not more_frames:
                            # Reached last frame — pause here, let user exit/restart
                            self._replay_ended = True
                            self.paused = True
                        replay_timer = 0
            else:
                # Normal game logic
                # Apply speed multipliers from power-ups and length to the update rate
                if hasattr(self, 'length_speed_multiplier'):
                    effective_update_rate = self.settings.update_rate_ms * self.speed_multiplier * self.length_speed_multiplier
                else:
                    effective_update_rate = self.settings.update_rate_ms * self.speed_multiplier
                
                # Move obstacles at their own interval
                if hasattr(self, 'moving_obstacles') and not self.paused and not self.game_over and not self.victory:
                    self.update_moving_obstacles()
                
                # Move the snake at its speed interval
                if (not self.paused and not self.game_over and not self.victory and 
                    current_time - self.last_update_time > effective_update_rate):
                    self.move_snake()
                    self.last_update_time = current_time
                
            # Draw game
            self.draw_board()
            
            if not self.replay_mode:
                self.draw_pause_button()
                # Draw on-screen D-pad and store rects for click handling
                self._dpad_rects = self.draw_dpad()
                
                # Draw active power-ups
                self.draw_active_powerups()
                
                # Draw combo counter if active
                if hasattr(self, 'combo_count') and self.combo_count > 1 and self.settings.combo_fruits_enabled:
                    font = get_font(self.settings.language, 'bold', 24)
                    combo_text = f"Combo: x{self.combo_count}"
                    combo_surface = font.render(combo_text, True, (255, 215, 0))  # Gold color
                    self.screen.blit(combo_surface, (20, 85))
                    
                # Draw current level if level progression is enabled
                if hasattr(self, 'current_level') and self.settings.levels_enabled:
                    font = get_font(self.settings.language, 'regular', 18)
                    level_text = f"Level: {self.current_level}"
                    level_surface = font.render(level_text, True, (200, 200, 200))
                    self.screen.blit(level_surface, (20, 55))
                
                if self.game_over or self.victory:
                    self.draw_game_over()
                
                # Draw achievement notifications
                if self.achievement_manager:
                    self.achievement_manager.draw_notification(self.screen, self.screen.get_width(), self.screen.get_height(), self.settings.language)
            else:
                # Draw active power-up HUD (shows names + timers) then replay controls
                self.draw_active_powerups()
                self.draw_replay_controls()
                
            # Update display
            pygame.display.flip()
            
            # Cap the frame rate
            clock.tick(60)
            
        # Return to main menu when the game loop ends
        return

