class SnakeAI:
    """
    Pathfinding AI for snake games.  Works for both single-player VS-AI and
    multiplayer AI slots.

    Difficulty levels
    -----------------
    easy       – safe one-step fruit seeking
    medium     – bounded BFS planning, with a safe one-step fallback
    hard       – full BFS + flood-fill safety, anti-loop logic
    impossible – hard planning plus opponent interception
    """

    DIRS = [(0, -1), (1, 0), (0, 1), (-1, 0)]   # up right down left
    MEDIUM_SEARCH_BUDGET = 2048

    def __init__(self, difficulty='medium', rng=None):
        self.difficulty  = difficulty
        # Loop-detection: store last N head positions
        self._history    = []          # list of (x, y)
        self._history_max = 12
        # Seeded RNG — falls back to the global random module if none supplied
        self._rng = rng or random

    # ── public API ──────────────────────────────────────────────────────

    def choose_direction(self, snake, occupied, fruit, board_w, board_h,
                         portals=None, powerup_pos=None, wall_collision=True,
                         opponent_snake=None):
        """Return (dx, dy) for the next move."""
        head = snake[0]

        # Record head for loop detection (hard/impossible use this)
        self._history.append(tuple(head))
        if len(self._history) > self._history_max:
            self._history.pop(0)

        # Build blocked set: obstacles + own body
        blocked = set(map(tuple, occupied))
        if len(snake) > 1:
            blocked.update(map(tuple, snake[1:]))

        # Build portal map  pos → exit_pos
        portal_map = {}
        if portals:
            for a, b, _ in portals:
                portal_map[tuple(a)] = tuple(b)
                portal_map[tuple(b)] = tuple(a)

        ctx = (board_w, board_h, wall_collision)

        if self.difficulty == 'easy':
            return self._easy(head, blocked, fruit, ctx)
        elif self.difficulty == 'medium':
            return self._medium(head, blocked, fruit, ctx, portal_map, powerup_pos)
        elif self.difficulty == 'hard':
            return self._hard(head, snake, blocked, fruit, ctx, portal_map, powerup_pos)
        else:
            return self._impossible(head, snake, blocked, fruit, ctx,
                                    portal_map, powerup_pos, opponent_snake)

    # ── difficulty implementations ───────────────────────────────────────

    def _easy(self, head, blocked, fruit, ctx):
        safe = self._safe_dirs(head, blocked, ctx)
        if not safe:
            return self.DIRS[1]
        return self._greedy_safe_dir(head, safe, fruit, ctx)

    def _medium(self, head, blocked, fruit, ctx, portal_map=None, powerup_pos=None):
        safe = self._safe_dirs(head, blocked, ctx)
        if not safe:
            return self.DIRS[1]
        target = self._best_target(head, fruit, powerup_pos, ctx, margin=1)
        portal_map = portal_map or {}
        path = self._bfs(
            head, target, blocked, ctx, portal_map,
            node_budget=self.MEDIUM_SEARCH_BUDGET)
        if path and len(path) > 1:
            direction = self._dir_from(head, path[1], ctx)
            if direction in safe:
                return direction
        return self._greedy_safe_dir(head, safe, target, ctx)

    def _greedy_safe_dir(self, head, safe, target, ctx):
        """Choose a safe move that minimizes one-step distance to the target."""
        bw, bh, wall = ctx
        scores = []
        best = None
        for direction in safe:
            nxt = self._step(head, direction, ctx)
            distance = self._manhattan(nxt, target, bw, bh,
                                       wall_collision=wall)
            if best is None or distance < best:
                best = distance
                scores = [direction]
            elif distance == best:
                scores.append(direction)
        return self._rng.choice(scores) if scores else self.DIRS[1]

    def _hard(self, head, snake, blocked, fruit, ctx, portal_map, powerup_pos):
        """
        Competent AI. BFS to fruit + flood-fill safety gate.
        Anti-loop: if the snake has been oscillating for the last 8 ticks,
        force exploration by shuffling direction priorities.
        Falls back to max-space direction (with tie-breaking randomness).
        """
        target = self._best_target(head, fruit, powerup_pos, ctx, margin=2)

        # ── loop detection ─────────────────────────────────────────────
        looping = self._is_looping(window=8)

        path = self._bfs(head, target, blocked, ctx, portal_map,
                         shuffle=looping)
        if path and len(path) > 1:
            nxt = path[1]
            d   = self._dir_from(head, nxt, ctx)
            # After moving: old head joins body, old tail leaves body.
            # nxt is the new head and must NOT be in the fill's blocked set.
            after_blocked = (set(blocked) - {tuple(snake[-1])}) | {tuple(snake[0])}
            threshold = max(len(snake) // 2, 3)
            if self._flood_fill(nxt, after_blocked, ctx) >= threshold:
                return d

        return self._escape_dir(head, snake, blocked, ctx, looping)

    def _impossible(self, head, snake, blocked, fruit, ctx,
                    portal_map, powerup_pos, opponent_snake):
        """Expert AI: hard + tracks opponent, intercepts when larger."""
        extra = set(blocked)
        if opponent_snake and len(opponent_snake) > 1:
            extra.update(map(tuple, opponent_snake[1:]))

        target   = tuple(fruit)
        opp_head = tuple(opponent_snake[0]) if opponent_snake else None

        if opp_head and len(snake) > len(opponent_snake):
            path = self._bfs(head, opp_head, extra, ctx, portal_map)
            if path and len(path) <= 6:
                target = opp_head

        if powerup_pos:
            bw, bh, _ = ctx
            wall = ctx[2]
            if self._manhattan(head, powerup_pos, bw, bh, wall) < self._manhattan(head, target, bw, bh, wall) - 1:
                target = powerup_pos

        looping = self._is_looping(window=8)
        path = self._bfs(head, target, extra, ctx, portal_map, shuffle=looping)
        if path and len(path) > 1:
            nxt = path[1]
            d   = self._dir_from(head, nxt, ctx)
            after_blocked = (set(extra) - {tuple(snake[-1])}) | {tuple(snake[0])}
            if self._flood_fill(nxt, after_blocked, ctx) >= max(len(snake) // 2, 3):
                return d

        return self._escape_dir(head, snake, extra, ctx, looping)

    # ── pathfinding helpers ──────────────────────────────────────────────

    def _step(self, pos, d, ctx):
        """Step one cell; returns None if it would hit a wall."""
        bw, bh, wall = ctx
        nx = pos[0] + d[0]
        ny = pos[1] + d[1]
        if wall:
            return (nx, ny) if (0 <= nx < bw and 0 <= ny < bh) else None
        return (nx % bw, ny % bh)

    def _safe_dirs(self, head, blocked, ctx):
        """Directions that lead to in-bounds, unblocked cells."""
        return [d for d in self.DIRS
                if (nxt := self._step(head, d, ctx)) is not None
                and nxt not in blocked]

    def _bfs(self, start, goal, blocked, ctx, portal_map, shuffle=False,
             node_budget=None):
        """
        BFS from start to goal.
        shuffle=True randomises neighbour order to escape loops.
        Returns path list or None.
        """
        if goal is None:
            return None
        goal  = tuple(goal)
        start = tuple(start)
        from collections import deque
        dirs = list(self.DIRS)
        if shuffle:
            self._rng.shuffle(dirs)
        q = deque([start])
        parents = {start: None}
        expanded = 0
        budget = (max(1, int(node_budget)) if node_budget is not None else None)
        while q:
            cur = q.popleft()
            expanded += 1
            if cur == goal:
                path = []
                node = cur
                while node is not None:
                    path.append(node)
                    node = parents[node]
                path.reverse()
                return path
            if budget is not None and expanded >= budget:
                break
            for d in dirs:
                nxt = self._step(cur, d, ctx)
                if nxt is None or nxt in blocked or nxt in parents:
                    continue
                parents[nxt] = cur
                q.append(nxt)
                if nxt in portal_map:
                    ex = portal_map[nxt]
                    if ex not in parents and ex not in blocked:
                        parents[ex] = nxt
                        q.append(ex)
        return None

    def _flood_fill(self, start, blocked, ctx):
        """Count cells reachable from start (BFS, skips None and blocked)."""
        from collections import deque
        start = tuple(start)
        if start in blocked:
            return 0
        visited = {start}
        q = deque([start])
        while q:
            cur = q.popleft()
            for d in self.DIRS:
                nxt = self._step(cur, d, ctx)
                if nxt is not None and nxt not in blocked and nxt not in visited:
                    visited.add(nxt)
                    q.append(nxt)
        return len(visited)

    def _escape_dir(self, head, snake, blocked, ctx, looping):
        """
        Fallback: pick the safe direction with the most open space.
        Uses correct after-move blocked set (old head added, old tail removed).
        When looping, adds random noise to break ties.
        """
        best_d     = None
        best_score = -1
        dirs = list(self.DIRS)
        if looping:
            self._rng.shuffle(dirs)
        # after any move: old head joins body, old tail leaves
        after_base = (set(blocked) - {tuple(snake[-1])}) | {tuple(snake[0])}
        for d in dirs:
            nxt = self._step(head, d, ctx)
            if nxt is None or nxt in blocked:
                continue
            score = self._flood_fill(nxt, after_base, ctx)
            if looping:
                score += self._rng.uniform(0, 3)
            if score > best_score:
                best_score = score
                best_d     = d
        if best_d:
            return best_d
        safe = self._safe_dirs(head, blocked, ctx)
        return self._rng.choice(safe) if safe else self.DIRS[1]

    def _is_looping(self, window=8):
        """True if the snake's head has revisited the same cell in the last `window` steps."""
        if len(self._history) < window:
            return False
        recent = self._history[-window:]
        return len(recent) != len(set(recent))

    def _best_target(self, head, fruit, powerup_pos, ctx, margin):
        if not powerup_pos:
            return tuple(fruit)
        bw, bh, _ = ctx
        wall = ctx[2]
        if self._manhattan(head, powerup_pos, bw, bh, wall) < self._manhattan(head, fruit, bw, bh, wall) - margin:
            return tuple(powerup_pos)
        return tuple(fruit)

    def _manhattan(self, a, b, bw, bh, wall_collision=False):
        dx = abs(a[0] - b[0])
        dy = abs(a[1] - b[1])
        if wall_collision:
            return dx + dy
        return min(dx, bw - dx) + min(dy, bh - dy)

    def _dir_from(self, frm, to, ctx):
        bw, bh, wall = ctx
        dx = to[0] - frm[0]
        dy = to[1] - frm[1]
        if not wall:
            if abs(dx) > 1: dx = -1 if dx > 0 else 1
            if abs(dy) > 1: dy = -1 if dy > 0 else 1
        return (dx, dy)


def _run_ai_lab_benchmark(seed=20261005, scenario_count=32):
    """Compare current AI planning tiers on the same reproducible board states."""
    count = max(4, min(128, int(scenario_count)))
    rng = random.Random(str(seed))
    board_w, board_h = 16, 12
    scenarios = []
    for _ in range(count):
        hx = rng.randint(3, board_w - 4)
        hy = rng.randint(2, board_h - 3)
        snake = [(hx, hy), (hx - 1, hy), (hx - 2, hy)]
        protected = set(snake)
        protected.update(((hx + 1, hy), (hx, hy - 1), (hx, hy + 1)))
        free = [(x, y) for y in range(board_h) for x in range(board_w)
                if (x, y) not in protected]
        fruit = rng.choice(free)
        free.remove(fruit)
        obstacle_count = min(rng.randint(0, 14), len(free))
        obstacles = set(rng.sample(free, obstacle_count))
        opponents = []
        opponent_cells = {p for p in free if p not in obstacles and p != fruit}
        opponent_pairs = [
            (head, tail)
            for head in sorted(opponent_cells)
            for tail in ((head[0], head[1] - 1), (head[0], head[1] + 1))
            if tail in opponent_cells
        ]
        if opponent_pairs:
            opp_head, opp_tail = rng.choice(opponent_pairs)
            opponents = [opp_head, opp_tail]
        wall_collision = bool(rng.getrandbits(1))
        scenarios.append((snake, obstacles, fruit, opponents, wall_collision))

    original_choose = globals().get('_original_snake_ai_choose_direction')
    if not callable(original_choose):
        original_choose = SnakeAI.choose_direction
    results = {}
    for level in ('easy', 'medium', 'hard', 'impossible'):
        legal = 0
        closer = 0
        elapsed_ns = 0
        for scenario_index, (snake, obstacles, fruit, opponent, wall) in enumerate(scenarios):
            agent = SnakeAI(level, rng=random.Random(
                f'{seed}:{level}:{scenario_index}'))
            ctx = (board_w, board_h, wall)
            distance_before = agent._manhattan(
                snake[0], fruit, board_w, board_h, wall)
            started = time.perf_counter_ns()
            move = original_choose(
                agent, snake, obstacles, fruit, board_w, board_h,
                wall_collision=wall,
                opponent_snake=(opponent if level == 'impossible' else None))
            elapsed_ns += max(0, time.perf_counter_ns() - started)
            nxt = agent._step(snake[0], move, ctx)
            is_legal = (nxt is not None and nxt not in obstacles and
                        nxt not in set(snake[1:]))
            if is_legal:
                legal += 1
                distance_after = agent._manhattan(
                    nxt, fruit, board_w, board_h, wall)
                if distance_after < distance_before:
                    closer += 1
        results[level] = {
            'samples': count,
            'legal_percent': round(100.0 * legal / count, 1),
            'closer_percent': round(100.0 * closer / count, 1),
            'average_us': round(elapsed_ns / count / 1000.0, 2),
        }
    return results


