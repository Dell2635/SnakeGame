    def show_language_selection(self):
        """Display language selection screen for first-time users.

        Uses a scrollable single-column list (reusing ScrollBar) so the
        Continue button — pinned to a fixed footer area — can never overlap
        a language option, on any window size, at any language count.
        """
        running = True
        clock = pygame.time.Clock()

        # Sort languages by native name once; list itself doesn't change.
        sorted_languages = sorted(LANGUAGES.items(), key=lambda x: x[1]['native_name'])

        row_height = 52
        row_spacing = 8
        continue_height = 56
        footer_margin = 30  # space above/below the Continue button

        scrollbar = None
        selected_language = self.settings.language

        def _layout():
            """Recompute all rects from the current screen size. Called once
            up front and again on every resize so the layout always adapts."""
            w, h = self.screen.get_size()

            title_h = max(60, int(h * 0.12))
            footer_h = continue_height + footer_margin * 2
            content_rect = pygame.Rect(0, title_h, w, max(0, h - title_h - footer_h))

            row_width = min(560, int(w * 0.85))
            row_x = (w - row_width) // 2

            content_height_total = len(sorted_languages) * (row_height + row_spacing)
            sb = ScrollBar(content_rect.x, content_rect.y, content_rect.width, content_rect.height,
                            max(content_height_total, content_rect.height))

            continue_width = min(260, int(w * 0.4))
            continue_rect = pygame.Rect((w - continue_width) // 2,
                                         h - footer_margin - continue_height,
                                         continue_width, continue_height)

            return {
                'w': w, 'h': h, 'title_h': title_h,
                'content_rect': content_rect,
                'row_width': row_width, 'row_x': row_x,
                'continue_rect': continue_rect,
                'scrollbar': sb,
            }

        layout = _layout()
        scrollbar = layout['scrollbar']

        while running:
            mouse_click_pos = None

            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit()
                    sys.exit()

                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    old_offset = scrollbar.scroll_offset
                    layout = _layout()
                    scrollbar = layout['scrollbar']
                    scrollbar.scroll_offset = scrollbar.target_scroll = min(old_offset, scrollbar.max_scroll)

                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    # Left click only — selection and Continue both require LMB.
                    mouse_click_pos = event.pos

                elif event.type in (pygame.MOUSEBUTTONUP, pygame.MOUSEMOTION, pygame.MOUSEWHEEL):
                    # Wheel and drag events are scrolling-only; never a click.
                    scrollbar.handle_event(event)

            scrollbar.update()
            content_rect = layout['content_rect']

            # Draw background
            self.screen.fill(COLORS['dark_blue'])

            # Draw title (always in English — no language is chosen yet)
            title_font = get_font("en", 'bold', 30)
            title_surface = title_font.render("Choose Your Language", True, COLORS['white'])
            self.screen.blit(title_surface, (layout['w'] // 2 - title_surface.get_width() // 2,
                                              layout['title_h'] // 2 - title_surface.get_height() // 2))

            # Draw the scrollable language list, clipped to the content area
            # so rows never bleed into the title or the Continue button.
            self.screen.set_clip(content_rect)
            offset = scrollbar.get_content_offset()
            for i, (lang_code, lang_info) in enumerate(sorted_languages):
                row_rect = pygame.Rect(layout['row_x'],
                                        content_rect.y + i * (row_height + row_spacing) - offset,
                                        layout['row_width'], row_height)
                if row_rect.bottom < content_rect.top or row_rect.top > content_rect.bottom:
                    continue  # not visible — skip drawing and skip hit-testing

                is_selected = (lang_code == selected_language)
                color = COLORS['light_blue'] if is_selected else COLORS['button']
                pygame.draw.rect(self.screen, color, row_rect, border_radius=6)
                if is_selected:
                    pygame.draw.rect(self.screen, COLORS['white'], row_rect, width=2, border_radius=6)

                lang_font = get_font(lang_code, 'regular', 24)
                text_surface = lang_font.render(lang_info['native_name'], True, COLORS['white'])
                text_rect = text_surface.get_rect(center=row_rect.center)
                self.screen.blit(text_surface, text_rect)

                if mouse_click_pos and content_rect.collidepoint(mouse_click_pos) and row_rect.collidepoint(mouse_click_pos):
                    selected_language = lang_code
                    self.settings.language = lang_code
                    self.settings.save()  # save immediately so a crash mid-flow doesn't lose the choice

            self.screen.set_clip(None)
            scrollbar.draw(self.screen)

            # Draw Continue button — pinned to the footer, never overlapped by the list above.
            continue_rect = layout['continue_rect']
            pygame.draw.rect(self.screen, COLORS['green'], continue_rect, border_radius=5)
            continue_text = get_text(selected_language, 'continue')
            continue_font = get_font(selected_language, 'bold', 24)
            text_surface = continue_font.render(continue_text, True, COLORS['white'])
            text_rect = text_surface.get_rect(center=continue_rect.center)
            self.screen.blit(text_surface, text_rect)

            if mouse_click_pos and continue_rect.collidepoint(mouse_click_pos):
                running = False

            pygame.display.flip()
            clock.tick(60)
    
