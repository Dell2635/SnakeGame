            "assets": {},
        }))

    def register_theme(self, theme, *, root_dir=None):
        if not isinstance(theme, ThemeDefinition):
            theme = ThemeDefinition(theme, root_dir=root_dir)
        elif root_dir is not None and theme.root_dir is None:
            theme.root_dir = os.path.abspath(root_dir)
        theme.validate()
        if theme.id in self._themes:
            raise ContentValidationError(
                f"Duplicate theme id: {theme.id}",
                code="duplicate_id", component="theme", owner_id=theme.id,
                version=theme.version
            )
        self._themes[theme.id] = theme
        ThemeRegistry.register(
            {"id": theme.id, "name": theme.name, "version": theme.version},
            owner_id=theme.source_owner,
        )
        return theme

    def unregister_theme_owner(self, owner_id):
        for theme_id, theme in list(self._themes.items()):
            if theme_id == "default":
                continue
            if theme.source_owner == owner_id:
                self._themes.pop(theme_id, None)
                ThemeRegistry.unregister_owner(owner_id)

    def discover(self, directory=None):
        """Discover child theme directories containing theme.json.

        The directory can be explicit (useful for tests/tools) or provided by
        IA3's centralized get_theme_dir() integration point.
        """
        directory = directory or _extension_data_dir("theme")
        if not directory or not os.path.isdir(directory):
            return []
        discovered = []
        for entry in sorted(os.listdir(directory)):
            full = os.path.join(directory, entry)
            if not os.path.isdir(full):
                continue
            manifest_path = os.path.join(full, "theme.json")
            if not os.path.isfile(manifest_path):
                continue
            try:
                with open(manifest_path, "r", encoding="utf-8") as handle:
                    manifest = json.load(handle)
                theme = ThemeDefinition(manifest, root_dir=full, source_owner=f"theme:{manifest.get('id', entry)}")
                self.register_theme(theme)
                discovered.append(theme.id)
            except Exception as exc:
                error = {
                    "component": "theme",
                    "path": manifest_path,
                    "error": str(exc),
                    "error_dict": exc.to_dict() if isinstance(exc, ContentValidationError) else None,
                }
                _append_bounded_diagnostic(self.errors, error)
                print(f"[IA4] Theme rejected: {manifest_path}: {exc}")
        return discovered

    def has(self, theme_id):
        return str(theme_id) in self._themes

    def get(self, theme_id):
        return self._themes.get(str(theme_id))

    def ids(self):
        return tuple(sorted(self._themes))

    def _resolved_manifest(self, theme_id, stack=None):
        stack = list(stack or [])
        if theme_id in stack:
            raise ContentValidationError(
                f"Theme inheritance cycle: {' -> '.join(stack + [theme_id])}",
                code="theme_inheritance_cycle", component="theme", owner_id=theme_id
            )
        theme = self._themes.get(theme_id)
        if theme is None:
            raise ContentValidationError(
                f"Unknown theme: {theme_id}",
                code="missing_theme", component="theme", owner_id=theme_id
            )
        stack.append(theme_id)
        data = {}
        parent_id = theme.extends
        if parent_id and parent_id != theme_id and parent_id in self._themes:
            data = self._resolved_manifest(parent_id, stack)
        elif parent_id and parent_id != theme_id and parent_id not in self._themes:
            # Themes always have the built-in default fallback.
            data = self._resolved_manifest("default", stack)
        return _deep_merge_dict(data, theme.data)

    def _register_active_assets(self, theme):
        owner = theme.source_owner
        if not theme.root_dir:
            return
        ASSET_MANAGER.register_source(owner, theme.root_dir, "theme")
        ASSET_MANAGER.register_assets(owner, theme.data.get("assets", {}))

    def _apply_colors(self, manifest):
        global COLORS
        merged_colors = dict(self._base_colors)
        for key, value in (manifest.get("colors") or {}).items():
            merged_colors[key] = _validate_theme_color(value, f"colors.{key}")
        merged_colors = _apply_accessibility_palette(merged_colors)
        COLORS.clear()
        COLORS.update(merged_colors)

    def resolve_font_spec(self, style="regular"):
        manifest = self._resolved_manifest(self.active_theme_id)
        fonts = manifest.get("fonts") or {}
        spec = fonts.get(style, fonts.get("default"))
        return spec

    def resolve_font_path(self, style="regular", language=None):
        spec = self.resolve_font_spec(style)
        if spec is None:
            return None
        if isinstance(spec, dict):
            asset_id = spec.get("asset")
            raw_path = spec.get("path")
            family = spec.get("family")
            if asset_id:
                return ASSET_MANAGER.get_font_path(asset_id)
            if family:
                try:
                    return pygame.font.match_font(
                        str(family), bold=(style == "bold"), italic=(style == "italic")
                    )
                except Exception:
                    return None
        else:
            raw_path = spec
        if raw_path:
            raw_path = _validate_relative_asset_path(raw_path, f"fonts.{style}")
            theme = self.get(self.active_theme_id)
            if theme and theme.root_dir:
                candidate = os.path.abspath(os.path.join(theme.root_dir, raw_path))
                try:
                    if os.path.commonpath((candidate, theme.root_dir)) == theme.root_dir and os.path.isfile(candidate):
                        return candidate
                except ValueError:
                    pass
            try:
                return pygame.font.match_font(str(raw_path))
            except Exception:
                return None
        return None

    def apply(self, theme_id):
        requested = str(theme_id or "default")
        selected = requested if requested in self._themes else "default"
        if selected != requested:
            _append_bounded_diagnostic(self.errors, {
                "component": "theme",
                "requested": requested,
                "fallback": "default",
                "error": f"Theme {requested!r} is unavailable; using default.",
            })
        previous = self._themes.get(self.active_theme_id)
        if previous and previous.source_owner != "theme:default":
            ASSET_MANAGER.unregister_owner(previous.source_owner)

        theme = self._themes[selected]
        try:
            manifest = self._resolved_manifest(selected)
            self._register_active_assets(theme)
            self._apply_colors(manifest)
        except Exception as exc:
            ASSET_MANAGER.unregister_owner(theme.source_owner)
            _append_bounded_diagnostic(self.errors, {
                "component": "theme",
                "requested": requested,
                "fallback": "default",
                "error": str(exc),
                "error_dict": exc.to_dict() if isinstance(exc, ContentValidationError) else None,
            })
            selected = "default"
            theme = self._themes["default"]
            manifest = self._resolved_manifest("default")
            self._apply_colors(manifest)

        self.active_theme_id = selected
        # get_font() is defined later in this single file. At runtime the function
        # exists before themes are activated from MainMenu/tests.
        clear_cache_fn = globals().get("clear_font_cache")
        if callable(clear_cache_fn):
            clear_cache_fn()
        if previous is None or previous.id != theme.id:
            EVENT_BUS.emit(
                "THEME_CHANGED",
                old_theme=previous.id if previous else None,
                new_theme=selected,
            )
        return selected

    select = apply

    def get(self, path, default=None):
        manifest = self._resolved_manifest(self.active_theme_id)
        current = manifest
        if isinstance(path, str):
            path = path.split(".")
        for part in path:
            if not isinstance(current, dict) or part not in current:
                return default
            current = current[part]
        return copy.deepcopy(current)

    def diagnostics(self):
        return {
            "active_theme": self.active_theme_id,
            "available_themes": list(self.ids()),
            "errors": copy.deepcopy(self.errors),
        }


THEME_MANAGER = ThemeManager()



class ModManifest:
    REQUIRED_FIELDS = (
        "id", "name", "version", "game_version", "mod_api_version",
        "dependencies", "assets", "configuration", "type",
    )
    CAPABILITIES = {
        "assets", "themes", "maps", "gameplay", "configuration",
        "filesystem", "network", "scripting",
    }

    def __init__(self, manifest, *, root_dir=None, source_path=None):
        if not isinstance(manifest, dict):
            raise ContentValidationError(
                "Mod manifest must be an object",
                code="invalid_manifest", component="mod"
            )
        for field in self.REQUIRED_FIELDS:
            if field not in manifest:
                raise ContentValidationError(
                    f"Mod manifest missing required field: {field}",
                    code="missing_required_field", component="mod", path=field
                )
        self.data = copy.deepcopy(manifest)
        self.id = str(manifest["id"]).strip()
        self.name = str(manifest["name"]).strip()
        self.version = str(manifest["version"]).strip()
        self.game_version = manifest["game_version"]
        self.mod_api_version = str(manifest["mod_api_version"]).strip()
        self.dependencies = copy.deepcopy(manifest.get("dependencies", []))
        self.assets = copy.deepcopy(manifest.get("assets", {}))
        self.configuration = copy.deepcopy(manifest.get("configuration", {}))
        self.type = str(manifest["type"]).strip().lower()
        caps = []
        for key in ("permissions", "capabilities"):
            value = manifest.get(key, [])
            if value is None:
                continue
            if not isinstance(value, list):
                raise ContentValidationError(
                    f"{key} must be a list",
                    code="invalid_permissions", component="mod", owner_id=self.id
                )
            caps.extend(str(item).strip() for item in value)
        self.capabilities = tuple(sorted(set(caps)))
        self.root_dir = os.path.abspath(root_dir) if root_dir else None
        self.source_path = source_path

    def validate(self):
        if not self.id or not self.name or not self.version or not self.type:
            raise ContentValidationError(
                "Mod id, name, version, and type must be non-empty",
                code="invalid_manifest", component="mod", owner_id=self.id,
                version=self.version
            )
        if not _version_compatible(GAME_VERSION, self.game_version):
            raise ContentValidationError(
                f"Mod {self.id} is incompatible with game {GAME_VERSION}: {self.game_version}",
                code="incompatible_game_version", component="mod",
                owner_id=self.id, version=self.version
            )
        if not _version_compatible(MOD_API_VERSION, self.mod_api_version):
            raise ContentValidationError(
                f"Mod {self.id} requires mod API {self.mod_api_version}; "
                f"current API is {MOD_API_VERSION}",
                code="incompatible_mod_api", component="mod",
                owner_id=self.id, version=self.version
            )
        unknown_caps = sorted(set(self.capabilities) - self.CAPABILITIES)
        if unknown_caps:
            raise ContentValidationError(
                f"Mod {self.id} requests unknown capabilities: {unknown_caps}",
                code="unknown_capability", component="mod",
                owner_id=self.id, version=self.version
            )
        if not isinstance(self.dependencies, list):
            raise ContentValidationError(
                f"Mod {self.id}: dependencies must be a list",
                code="invalid_dependencies", component="mod", owner_id=self.id
            )
        if not isinstance(self.assets, (dict, list)):
            raise ContentValidationError(
                f"Mod {self.id}: assets must be an object or list",
                code="invalid_assets", component="mod", owner_id=self.id
            )
        if not isinstance(self.configuration, dict):
            raise ContentValidationError(
                f"Mod {self.id}: configuration must be an object",
                code="invalid_configuration", component="mod", owner_id=self.id
            )
        for dep in self.dependencies:
            if isinstance(dep, str):
                if not dep.strip():
                    raise ContentValidationError(
                        f"Mod {self.id}: empty dependency id",
                        code="invalid_dependency", component="mod", owner_id=self.id
                    )
            elif isinstance(dep, dict):
                dep_id = dep.get("id")
                if not isinstance(dep_id, str) or not dep_id.strip():
                    raise ContentValidationError(
                        f"Mod {self.id}: dependency id is required",
                        code="invalid_dependency", component="mod", owner_id=self.id
                    )
                if "version" in dep and dep["version"] is not None and not isinstance(dep["version"], str):
                    raise ContentValidationError(
                        f"Mod {self.id}: dependency version must be a string",
                        code="invalid_dependency_version", component="mod", owner_id=self.id
                    )
            else:
                raise ContentValidationError(
                    f"Mod {self.id}: invalid dependency entry",
                    code="invalid_dependency", component="mod", owner_id=self.id
                )
        return True


class ModManager:
    """Declarative mod lifecycle manager.

    IA4 deliberately does not execute arbitrary Python from mods. A declared
    ``scripting`` capability is recorded for future enforcement, but activation
    currently handles manifests, assets, themes, and declarative content only.
    """

    def __init__(self):
        self.discovered = {}
        self.enabled = set()
        self.active = set()
        self.errors = []
        self._mod_assets = {}
        self._mod_themes = {}

    def _record_error(self, mod, exc, component="mod"):
        error = {
            "component": component,
            "mod_id": getattr(mod, "id", None),
            "version": getattr(mod, "version", None),
            "path": getattr(mod, "source_path", None),
            "error": str(exc),
            "error_dict": exc.to_dict() if isinstance(exc, ContentValidationError) else None,
        }
        _append_bounded_diagnostic(self.errors, error)
        print(
            f"[IA4] {component} error"
            f" ({error['mod_id'] or error['path'] or 'unknown'}): {error['error']}"
        )
        return error

    def discover(self, directory=None):
        directory = directory or _extension_data_dir("mod")
        previous_ids = tuple(self.discovered)
        for mod_id in previous_ids:
            ModRegistry.unregister_owner(mod_id)
        self.discovered = {}
        self.errors = []
        if not directory or not os.path.isdir(directory):
            return []
        found = []
        for entry in sorted(os.listdir(directory)):
            full = os.path.join(directory, entry)
            manifest_path = None
            root_dir = full
            if os.path.isdir(full):
                for candidate in ("mod.json", "manifest.json"):
                    p = os.path.join(full, candidate)
                    if os.path.isfile(p):
                        manifest_path = p
                        break
            elif os.path.isfile(full) and entry.lower().endswith(".json"):
                manifest_path = full
                root_dir = directory
            if not manifest_path:
                continue
            try:
                with open(manifest_path, "r", encoding="utf-8") as handle:
                    data = json.load(handle)
                manifest = ModManifest(
                    data, root_dir=root_dir, source_path=manifest_path
                )
                manifest.validate()
                if manifest.id in self.discovered:
                    raise ContentValidationError(
                        f"Duplicate mod id: {manifest.id}",
                        code="duplicate_id", component="mod",
                        owner_id=manifest.id, version=manifest.version
                    )
                self.discovered[manifest.id] = manifest
                ModRegistry.register(
                    {"id": manifest.id, "name": manifest.name, "version": manifest.version},
                    owner_id=manifest.id,
                )
                found.append(manifest.id)
            except Exception as exc:
                self._record_error(
                    ModManifest({"id": entry, "name": entry, "version": "unknown",
                                 "game_version": "*", "mod_api_version": "*",
                                 "dependencies": [], "assets": {}, "configuration": {},
                                 "type": "invalid"})
                    if isinstance(exc, ContentValidationError) else
                    type("_InvalidMod", (), {"id": entry, "version": "unknown", "source_path": manifest_path})(),
                    exc,
                )
        return found

    def _dependency_spec(self, dependency):
        if isinstance(dependency, str):
            return dependency.strip(), "*"
        return str(dependency["id"]).strip(), dependency.get("version", "*")

    def _ordered_activation(self, requested_ids):
        requested = set(str(mid) for mid in requested_ids)
        state = {}
        ordered = []

        def visit(mod_id, chain):
            if mod_id in state:
                if state[mod_id] == "done":
                    return
                if state[mod_id] == "visiting":
                    raise ContentValidationError(
                        f"Mod dependency cycle: {' -> '.join(chain + [mod_id])}",
                        code="dependency_cycle", component="mod", owner_id=mod_id
                    )
            manifest = self.discovered.get(mod_id)
            if manifest is None:
                raise ContentValidationError(
                    f"Missing mod dependency: {mod_id}",
                    code="missing_dependency", component="mod", owner_id=mod_id
                )
            state[mod_id] = "visiting"
            for dep in manifest.dependencies:
                dep_id, version_spec = self._dependency_spec(dep)
                dep_manifest = self.discovered.get(dep_id)
                if dep_manifest is None:
                    raise ContentValidationError(
                        f"Mod {mod_id} requires missing dependency {dep_id}",
                        code="missing_dependency", component="mod", owner_id=mod_id,
                        version=manifest.version
                    )
                if not _version_compatible(dep_manifest.version, version_spec):
                    raise ContentValidationError(
                        f"Mod {mod_id} requires {dep_id} {version_spec}; "
                        f"found {dep_manifest.version}",
                        code="dependency_version_mismatch", component="mod",
                        owner_id=mod_id, version=manifest.version
                    )
                visit(dep_id, chain + [mod_id])
                requested.add(dep_id)
            state[mod_id] = "done"
            ordered.append(mod_id)

        for mod_id in sorted(requested):
            visit(mod_id, [])
        return ordered

    def enable(self, mod_id):
        mod_id = str(mod_id)
        if mod_id not in self.discovered:
            return False
        self.enabled.add(mod_id)
        return True

    def disable(self, mod_id, *, unload=True):
        mod_id = str(mod_id)
        self.enabled.discard(mod_id)
        if unload and mod_id in self.active:
            self.unload(mod_id)
        return True

    def _register_content(self, manifest):
        content = manifest.data.get("content", {})
        if content is None:
            return
        if not isinstance(content, dict):
            raise ContentValidationError(
                f"Mod {manifest.id}: content must be an object",
                code="invalid_content", component="content", owner_id=manifest.id
            )
        for registry_name, entries in content.items():
            registry = _CONTENT_REGISTRY_MAP.get(str(registry_name).lower())
            if registry is None:
                raise ContentValidationError(
                    f"Mod {manifest.id}: unknown content registry {registry_name!r}",
                    code="unknown_registry", component="content", owner_id=manifest.id
                )
            if isinstance(entries, dict):
                # A mapping keyed by stable id is accepted; the entry id remains
                # authoritative when present and is otherwise filled from the key.
                normalized = []
                for content_id, item in entries.items():
                    if not isinstance(item, dict):
                        raise ContentValidationError(
                            f"Mod {manifest.id}: invalid item {content_id!r} in {registry.name}",
                            code="invalid_content_item", component=registry.name,
                            owner_id=manifest.id
                        )
                    obj = copy.deepcopy(item)
                    obj.setdefault("id", content_id)
                    normalized.append(obj)
                entries = normalized
            if not isinstance(entries, list):
                raise ContentValidationError(
                    f"Mod {manifest.id}: registry {registry.name} must contain a list/object",
                    code="invalid_content", component=registry.name, owner_id=manifest.id
                )
            for item in entries:
                obj = copy.deepcopy(item)
                content_id = obj.get("id")
                if not isinstance(content_id, str) or not content_id.strip():
                    raise ContentValidationError(
                        f"Mod {manifest.id}: {registry.name} item is missing id",
                        code="missing_id", component=registry.name, owner_id=manifest.id
                    )
                # Defensive numeric range checks when a declarative content
                # item supplies min/max/value metadata.
                for range_key in ("min", "minimum", "max", "maximum", "value"):
                    if range_key in obj and not isinstance(obj[range_key], (int, float)):
                        raise ContentValidationError(
                            f"Mod {manifest.id}: {registry.name}.{content_id}.{range_key} "
                            f"must be numeric",
                            code="invalid_numeric_range", component=registry.name,
                            owner_id=manifest.id
                        )
                lower = obj.get("min", obj.get("minimum"))
                upper = obj.get("max", obj.get("maximum"))
                if lower is not None and upper is not None and lower > upper:
                    raise ContentValidationError(
                        f"Mod {manifest.id}: invalid range for {registry.name}.{content_id}",
                        code="invalid_numeric_range", component=registry.name,
                        owner_id=manifest.id
                    )
                registry.register(obj, owner_id=manifest.id)

    def _register_themes(self, manifest):
        theme_entries = []
        if isinstance(manifest.data.get("theme"), dict):
            theme_entries.append(manifest.data["theme"])
        elif isinstance(manifest.data.get("theme"), list):
            theme_entries.extend(manifest.data["theme"])
        if isinstance(manifest.data.get("themes"), list):
            for entry in manifest.data["themes"]:
                if isinstance(entry, dict):
                    theme_entries.append(entry)
                elif isinstance(entry, str):
                    theme_path = os.path.abspath(os.path.join(manifest.root_dir, entry))
                    try:
                        if os.path.commonpath((theme_path, manifest.root_dir)) != manifest.root_dir:
                            raise ContentValidationError(
                                f"Theme path escapes mod root: {entry}",
                                code="theme_path_traversal", component="theme",
                                owner_id=manifest.id
                            )
                    except ValueError:
                        raise ContentValidationError(
                            f"Invalid theme path: {entry}",
                            code="theme_path_traversal", component="theme",
                            owner_id=manifest.id
                        )
                    with open(theme_path, "r", encoding="utf-8") as handle:
                        theme_entries.append(json.load(handle))
                else:
                    raise ContentValidationError(
                        f"Mod {manifest.id}: invalid theme entry",
                        code="invalid_theme", component="theme", owner_id=manifest.id
                    )

        for index, entry in enumerate(theme_entries):
            if not isinstance(entry, dict):
                raise ContentValidationError(
                    f"Mod {manifest.id}: theme entry {index} is not an object",
                    code="invalid_theme", component="theme", owner_id=manifest.id
                )
            theme_id = entry.get("id")
            theme = ThemeDefinition(
                entry,
                root_dir=manifest.root_dir,
                source_owner=f"mod:{manifest.id}:theme:{theme_id or index}"
            )
            THEME_MANAGER.register_theme(theme)
            self._mod_themes.setdefault(manifest.id, []).append(theme.id)

    def load(self, mod_id):
        mod_id = str(mod_id)
        manifest = self.discovered.get(mod_id)
        if manifest is None:
            raise ContentValidationError(
                f"Unknown mod: {mod_id}",
                code="unknown_mod", component="mod", owner_id=mod_id
            )
        if mod_id in self.active:
            return True

        manifest.validate()
        owner = f"mod:{manifest.id}"
        registered_theme_ids_before = set(THEME_MANAGER.ids())
        try:
            if manifest.root_dir:
                ASSET_MANAGER.register_source(owner, manifest.root_dir, "mod")
                ASSET_MANAGER.register_assets(owner, manifest.assets)
                self._mod_assets[mod_id] = owner
            self._register_content(manifest)
            self._register_themes(manifest)
            self.active.add(mod_id)
            EVENT_BUS.emit("MOD_LOADED", mod_id=mod_id, version=manifest.version)
            return True
        except Exception:
            # Roll back all declarative registrations owned by this mod.
            ASSET_MANAGER.unregister_owner(owner)
            for registry in _CONTENT_REGISTRY_MAP.values():
                registry.unregister_owner(manifest.id)
            for theme_id in sorted(set(THEME_MANAGER.ids()) - registered_theme_ids_before):
                theme = THEME_MANAGER.get(theme_id)
                if theme and theme.source_owner.startswith(f"mod:{manifest.id}:"):
                    THEME_MANAGER._themes.pop(theme_id, None)
                    ThemeRegistry.unregister_owner(theme.source_owner)
            raise

    def activate(self, mod_id):
        mod_id = str(mod_id)
        ordered = self._ordered_activation([mod_id])
        for dependency_id in ordered:
            try:
                self.load(dependency_id)
            except Exception as exc:
                dependency_manifest = self.discovered.get(dependency_id)
                self._record_error(dependency_manifest or type("_M", (), {"id": dependency_id, "version": None, "source_path": None})(), exc)
                # A dependency failure makes dependents unsafe to activate.
                return False
        return all(mid in self.active for mid in ordered)

    def activate_all(self, requested_ids=None):
        requested = set(self.enabled if requested_ids is None else map(str, requested_ids))
        if not requested:
            return []
        try:
            ordered = self._ordered_activation(requested)
        except Exception as exc:
            self._record_error(
                type("_M", (), {"id": None, "version": None, "source_path": None})(),
                exc
            )
            return []
        activated = []
        for mod_id in ordered:
            if mod_id in self.active:
                activated.append(mod_id)
                continue
            manifest = self.discovered.get(mod_id)
            try:
                self.load(mod_id)
                activated.append(mod_id)
            except Exception as exc:
                self._record_error(manifest, exc)
                # Do not allow one optional mod to prevent other independent mods
                # from loading.
        return activated

    def unload(self, mod_id):
        mod_id = str(mod_id)
        manifest = self.discovered.get(mod_id)
        owner = f"mod:{mod_id}"
        if mod_id not in self.active:
            return False
        if THEME_MANAGER.active_theme_id != "default":
            active_theme = THEME_MANAGER.get(THEME_MANAGER.active_theme_id)
            if active_theme and active_theme.source_owner.startswith(f"mod:{mod_id}:"):
                THEME_MANAGER.apply("default")
        ASSET_MANAGER.unregister_owner(owner)
        for registry in _CONTENT_REGISTRY_MAP.values():
            registry.unregister_owner(mod_id)
        for theme_id in self._mod_themes.get(mod_id, []):
            theme = THEME_MANAGER.get(theme_id)
            if theme:
                THEME_MANAGER._themes.pop(theme_id, None)
                ThemeRegistry.unregister_owner(theme.source_owner)
                ASSET_MANAGER.unregister_owner(theme.source_owner)
        self._mod_themes.pop(mod_id, None)
        self._mod_assets.pop(mod_id, None)
        self.active.discard(mod_id)
        if manifest:
            EVENT_BUS.emit("MOD_UNLOADED", mod_id=mod_id, version=manifest.version)
        return True

    def unload_all(self):
        for mod_id in sorted(tuple(self.active), reverse=True):
            self.unload(mod_id)

    def active_mod_ids(self):
        return tuple(sorted(self.active))

    def diagnostics(self):
        return {
            "discovered": tuple(sorted(self.discovered)),
            "enabled": tuple(sorted(self.enabled)),
            "active": tuple(sorted(self.active)),
            "errors": copy.deepcopy(self.errors),
        }


MOD_MANAGER = ModManager()


def refresh_extension_content():
    """Refresh externally supplied theme/mod directories.

    This function intentionally asks IA3 for paths; it never creates or chooses
    an alternative persistent data root itself.
    """
    themes = THEME_MANAGER.discover()
    mods = MOD_MANAGER.discover()
    return {"themes": themes, "mods": mods}


def get_customization_state(settings):
    """Stable profile contract for settings/profile managers."""
    return {
        "theme_id": getattr(settings, "theme_id", "default"),
        "enabled_mods": list(getattr(settings, "enabled_mods", [])),
        "mod_configuration": copy.deepcopy(getattr(settings, "mod_configuration", {})),
    }


def apply_customization_state(settings, state):
    """Apply an imported profile/customization state without touching gameplay."""
    if not isinstance(state, dict):
        return settings
    theme_id = state.get("theme_id")
    if isinstance(theme_id, str) and theme_id:
        settings.theme_id = theme_id
    mods = state.get("enabled_mods")
    if isinstance(mods, list):
        settings.enabled_mods = [str(mid) for mid in mods if str(mid).strip()]
    cfg = state.get("mod_configuration")
    if isinstance(cfg, dict):
        settings.mod_configuration = copy.deepcopy(cfg)
    return settings



# IA4 INTEGRATION NOTES
#
# Classes:
#   EventBus; ContentValidationError; ContentRegistry; AssetManager;
#   ThemeDefinition; ThemeManager; ModManifest; ModManager.
#
# Global registries/managers:
#   FruitRegistry, PowerupRegistry, ObstacleRegistry, MapRegistry,
#   ThemeRegistry, ModRegistry, AchievementRegistry;
#   EVENT_BUS, ASSET_MANAGER, THEME_MANAGER, MOD_MANAGER.
#
# Manifest schema (JSON):
#   Theme: id, name, version, game_version, theme_api_version;
#           optional extends, colors, fonts, ui, buttons, panels, icons,
#           board, snake, fruits, obstacles, effects, sounds, animations,
#           backgrounds, assets.
#   Mod: id, name, version, game_version, mod_api_version, dependencies,
#        assets, configuration, type; optional permissions/capabilities,
#        content, theme(s)/themes.
#   Asset maps use stable logical IDs -> relative paths. Paths may not escape
#   the owning theme/mod root.
#
# Version constants:
#   GAME_VERSION=1.0.0, MOD_API_VERSION=1.0.0, THEME_API_VERSION=1.0.0,
#   CONTENT_SCHEMA_VERSION=1. Compatibility is explicit; incompatible content
#   is rejected rather than guessed.
#
# Event names:
#   GAME_STARTED, GAME_OVER, LEVEL_UP, FRUIT_EATEN, POWERUP_ACTIVATED,
#   ACHIEVEMENT_UNLOCKED, THEME_CHANGED, MOD_LOADED, MOD_UNLOADED,
#   SETTINGS_CHANGED, LANGUAGE_CHANGED.
#
# Data-manager interface owned by IA3:
#   set_extension_data_provider(provider), where provider exposes
#   get_mod_dir(), get_theme_dir(), get_cache_dir(); a mapping with "mod",
#   "theme", and "cache" keys is also accepted. For compatibility, global
#   getters or DATA_DIRECTORY_MANAGER / USER_DATA_MANAGER / data_manager are
#   detected. IA4 does not create a competing persistent user-data root.
#
# Settings/profile contract:
#   Settings.theme_id, Settings.enabled_mods, and Settings.mod_configuration
#   persist through the existing unified save system. Use
#   get_customization_state() / apply_customization_state() for profile
#   import/export integration.
#
# Assumptions:
#   The pre-existing renderer continues to consume COLORS; ThemeManager applies
#   validated color overrides globally and get_font() additionally honors theme
#   font specifications. Other theme sections are available through
#   THEME_MANAGER.get(path) for incremental renderer migration.
#   Mod activation is declarative only: IA4 never executes arbitrary Python or
#   scripts from external mods. A "scripting" capability is recorded for future
#   enforcement, but currently grants no execution privilege.
#
# Unresolved integration points:
#   IA3 must call set_extension_data_provider() (or expose the documented
#   getters/manager) once its centralized data-directory manager is present.
#   Existing gameplay/UI screens can progressively consume THEME_MANAGER.get()
#   and EVENT_BUS.emit(...) without a gameplay rewrite. Mod archive extraction
#   is intentionally not implemented; directory-based packages are supported.


