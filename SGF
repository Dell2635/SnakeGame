class TutorialCharacter:
    """A playful character to guide the player through tutorials"""
    def __init__(self, screen):
        self.screen = screen
        self.x = 120  # Position X
        self.y = 480  # Position Y
        self.size = 60
        self.color = (50, 205, 50)  # Green snake color
        self.eye_color = (255, 255, 255)
        self.pupil_color = (0, 0, 0)
        self.tongue_color = (255, 100, 100)
        
        # Animation properties
        self.bounce_offset = 0
        self.bounce_speed = 0.1
        self.bounce_time = 0
        self.blink_timer = 0
        self.blinking = False
        self.talking = False
        self.talk_timer = 0
        self.emotions = ['happy', 'excited', 'thinking', 'surprised']
        self.current_emotion = 'happy'
        
        # Speech bubble
        self.speech_visible = False
        self.speech_text = ""
        self.speech_timer = 0
        self.speech_duration = 3  # seconds
        self.text_color = (30, 30, 40)
        self.bubble_color = (255, 255, 255)
        self.bubble_border = (100, 100, 150)
        
    def update(self, dt):
        """Update character animations"""
        # Bouncing animation
        self.bounce_time += dt
        self.bounce_offset = math.sin(self.bounce_time * self.bounce_speed) * 5
        
        # Blinking animation
        self.blink_timer += dt
        if self.blink_timer > 3 and not self.blinking:
            self.blinking = True
            self.blink_timer = 0
        elif self.blinking and self.blink_timer > 0.15:
            self.blinking = False
            self.blink_timer = 0
            
        # Talking animation
        if self.talking:
            self.talk_timer += dt
            if self.talk_timer > 0.3:
                self.talking = not self.talking
                self.talk_timer = 0
                
        # Speech bubble timer
        if self.speech_visible:
            self.speech_timer += dt
            if self.speech_timer > self.speech_duration:
                self.speech_visible = False
                self.speech_timer = 0
    
    def say(self, text, duration=3):
        """Make the character say something"""
        self.speech_text = text
        self.speech_visible = True
        self.speech_timer = 0
        self.speech_duration = duration
        self.talking = True
        
    def set_emotion(self, emotion):
        """Set the character's emotion"""
        if emotion in self.emotions:
            self.current_emotion = emotion
            
    def move_to(self, x, y):
        """Move character to a specific position"""
        self.x = x
        self.y = y
        
    def draw(self):
        """Draw the character with current animation state"""
        # Draw the character body (snake-like)
        y_pos = self.y + self.bounce_offset
        
        # Draw body segments
        segment_size = self.size // 2
        for i in range(3):
            segment_offset = i * (segment_size - 5)
            segment_y = y_pos + math.sin(self.bounce_time * self.bounce_speed + i * 0.5) * 3
            segment_rect = pygame.Rect(
                self.x - segment_offset, 
                segment_y, 
                segment_size, 
                segment_size
            )
            pygame.draw.rect(self.screen, self.color, segment_rect, border_radius=segment_size//3)
        
        # Draw head
        head_size = self.size // 1.5
        head_rect = pygame.Rect(
            self.x - segment_size * 3, 
            y_pos - head_size//4, 
            head_size, 
            head_size
        )
        pygame.draw.rect(self.screen, self.color, head_rect, border_radius=max(1, int(head_size//3)))
        
        # Draw eyes based on emotion
        eye_size = head_size // 5
        left_eye_pos = (head_rect.x + head_rect.width // 4, head_rect.y + head_rect.height // 3)
        right_eye_pos = (head_rect.x + head_rect.width // 4, head_rect.y + head_rect.height * 2 // 3)
        
        # Eye whites
        if not self.blinking:
            pygame.draw.circle(self.screen, self.eye_color, left_eye_pos, eye_size)
            pygame.draw.circle(self.screen, self.eye_color, right_eye_pos, eye_size)
            
            # Pupils - position varies based on emotion
            pupil_size = eye_size // 2
            pupil_offset_x = 0
            pupil_offset_y = 0
            
            if self.current_emotion == 'excited':
                pupil_offset_x = math.sin(self.bounce_time) * pupil_size // 2
            elif self.current_emotion == 'thinking':
                pupil_offset_y = -pupil_size // 2
                pupil_offset_x = pupil_size // 2
            elif self.current_emotion == 'surprised':
                pupil_size = int(eye_size * 0.7)
                
            pygame.draw.circle(self.screen, self.pupil_color, 
                              (left_eye_pos[0] + pupil_offset_x, left_eye_pos[1] + pupil_offset_y), 
                              pupil_size)
            pygame.draw.circle(self.screen, self.pupil_color, 
                              (right_eye_pos[0] + pupil_offset_x, right_eye_pos[1] + pupil_offset_y), 
                              pupil_size)
        else:
            # Closed eyes (simple lines)
            pygame.draw.line(self.screen, self.pupil_color, 
                            (left_eye_pos[0] - eye_size, left_eye_pos[1]), 
                            (left_eye_pos[0] + eye_size, left_eye_pos[1]), 2)
            pygame.draw.line(self.screen, self.pupil_color, 
                            (right_eye_pos[0] - eye_size, right_eye_pos[1]), 
                            (right_eye_pos[0] + eye_size, right_eye_pos[1]), 2)
        
        # Draw mouth/tongue
        if self.talking:
            # Open mouth with tongue
            tongue_rect = pygame.Rect(
                head_rect.x - head_size//6, 
                head_rect.y + head_rect.height//2 - head_size//12, 
                head_size//3, 
                head_size//6
            )
            pygame.draw.rect(self.screen, (80, 80, 80), tongue_rect, border_radius=tongue_rect.height//2)
            pygame.draw.rect(self.screen, self.tongue_color, 
                           (tongue_rect.x + 2, tongue_rect.y + 2, tongue_rect.width - 4, tongue_rect.height - 4),
                           border_radius=tongue_rect.height//2)
        else:
            # Simple smile
            smile_rect = pygame.Rect(
                head_rect.x - head_size//8, 
                head_rect.y + head_rect.height//2 - head_size//16, 
                head_size//4, 
                head_size//8
            )
            pygame.draw.rect(self.screen, (80, 80, 80), smile_rect, border_radius=smile_rect.height//2)
            
        # Draw speech bubble if visible
        if self.speech_visible and self.speech_text:
            # Create font for speech text
            font_size = 20
            font = pygame.font.SysFont(None, font_size)
            
            # Word wrap the text to fit in bubble
            words = self.speech_text.split(' ')
            lines = []
            current_line = ""
            max_width = 300  # Max bubble width
            
            for word in words:
                test_line = current_line + word + " "
                test_surface = font.render(test_line, True, self.text_color)
                if test_surface.get_width() <= max_width:
                    current_line = test_line
                else:
                    lines.append(current_line)
                    current_line = word + " "
            
            # Add the last line
            if current_line:
                lines.append(current_line)
                
            # Calculate bubble size
            line_height = font_size + 4
            bubble_width = max_width
            bubble_height = line_height * len(lines) + 20
            
            # Draw bubble positioned above the character
            bubble_x = head_rect.x - bubble_width//2
            bubble_y = head_rect.y - bubble_height - 20
            
            # Ensure bubble stays on screen
            if bubble_x < 10:
                bubble_x = 10
            if bubble_x + bubble_width > self.screen.get_width() - 10:
                bubble_x = self.screen.get_width() - bubble_width - 10
            if bubble_y < 10:
                bubble_y = 10
            
            # Draw bubble background
            bubble_rect = pygame.Rect(bubble_x, bubble_y, bubble_width, bubble_height)
            pygame.draw.rect(self.screen, self.bubble_color, bubble_rect, border_radius=10)
            pygame.draw.rect(self.screen, self.bubble_border, bubble_rect, border_radius=10, width=2)
            
            # Draw pointer to character
            pointer_points = [
                (head_rect.x + head_rect.width//2, bubble_y + bubble_height),
                (head_rect.x + head_rect.width//2 - 10, bubble_y + bubble_height - 10),
                (head_rect.x + head_rect.width//2 + 10, bubble_y + bubble_height - 10)
            ]
