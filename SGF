    def _draw_ghost_hud(self):
        """Race readout: ghost score/target, score difference and pace in seconds."""
        history = getattr(self, '_sgf_ghost_history', None)
        if not history or getattr(self, 'replay_mode', False):
            return
        tick = max(0, len(self.game_history) - 1)
        ghost_score = _ghost_score_at(history, tick)
        final_score = _ghost_final_score(history)
        if ghost_score is None or final_score is None:
            return
        language = self.settings.language
        font = get_font(language, 'bold', 15)
        difference = int(self.score) - ghost_score
        ahead = difference >= 0
        colour = (120, 235, 150) if ahead else (255, 200, 110)
        text = (f"{get_text(language, 'daily_ghost_race')}: "
                f"{ghost_score}/{final_score}  ({difference:+d})")
        max_width = max(120, self.screen.get_width() // 2 - 30)
        surface = render_fit(font, text, colour, max_width, padding=0)
        self.screen.blit(surface, (20, 54))
        pace = _ghost_pace_ticks(history, int(self.score), tick)
        if pace is not None:
            seconds = pace * float(getattr(self.settings, 'update_rate_ms', 150)) / 1000.0
            pace_surface = render_fit(
                font, f"{seconds:+.1f} s", (120, 235, 150) if seconds >= 0 else (255, 200, 110),
                max_width, padding=0)
            self.screen.blit(pace_surface, (20, 54 + surface.get_height() + 2))

    def _draw_daily_ghost(self):
        history = getattr(self, '_sgf_ghost_history', None)
        if not history or getattr(self, 'replay_mode', False):
            return
        ghost = _daily_ghost_frame(
            history, max(0, len(self.game_history) - 1),
            self.board_width, self.board_height)
        if not ghost:
            return
        size = (self.board_width * self.cell_size,
                self.board_height * self.cell_size)
        surface = getattr(self, '_sgf_ghost_surface', None)
        if surface is None or surface.get_size() != size:
            surface = pygame.Surface(size, pygame.SRCALPHA)
            self._sgf_ghost_surface = surface
        frame_key = (max(0, len(self.game_history) - 1), tuple(ghost))
        if getattr(self, '_sgf_ghost_rendered_key', None) != frame_key:
            surface.fill((0, 0, 0, 0))
            inset = max(1, self.cell_size // 8)
            for index, (x, y) in enumerate(ghost):
                rect = pygame.Rect(
                    x * self.cell_size + inset, y * self.cell_size + inset,
                    max(1, self.cell_size - 2 * inset),
                    max(1, self.cell_size - 2 * inset))
                color = (185, 245, 255, 145) if index == 0 else (70, 195, 245, 82)
                pygame.draw.rect(surface, color, rect,
                                 border_radius=max(1, self.cell_size // 5))
            self._sgf_ghost_rendered_key = frame_key
        self.screen.blit(surface, (self.board_offset_x, self.board_offset_y))

