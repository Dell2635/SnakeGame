        except (OSError, ValueError, TypeError):
            continue
    return challenges


def _daily_ghost_frame(history, frame_index, board_width, board_height):
    """Return a bounded replay snake position or None for an invalid frame."""
    if not isinstance(history, list) or not history:
        return None
    if type(frame_index) is not int:
        return None
    frame = history[max(0, min(frame_index, len(history) - 1))]
    if not isinstance(frame, list) or len(frame) < 5:
        return None
    snake = frame[0]
    if not isinstance(snake, list) or not snake or len(snake) > 20000:
        return None
    if any(not _validate_net_cell(cell, board_width, board_height) for cell in snake):
        return None
    return [tuple(cell) for cell in snake]


def _ghost_history_for_score(score):
    """Return a bounded single-player replay usable as a ghost, or None.

    Works for any saved or imported score: the history must be a list of
    classic snapshots whose first snake fits the score's own board.
    """
    try:
        resolved = _history_for_score(score)
        history = resolved.get('game_history')
        if (resolved.get('is_multiplayer') or resolved.get('game_mode') == 'vs_ai'
                or not isinstance(history, list) or not history or len(history) > 12000):
            return None
        custom_map = resolved.get('custom_map')
        width = int((custom_map or {}).get(
            'board_width', resolved.get('actual_board_width',
                score.get('actual_board_width',
                    resolved.get('board_size', score.get('board_size', 0))))))
        height = int((custom_map or {}).get(
            'board_height', resolved.get('actual_board_height',
                score.get('actual_board_height',
                    resolved.get('board_size', score.get('board_size', width))))))
    except (TypeError, ValueError, OverflowError, AttributeError, OSError):
        return None
    if (10 <= width <= 200 and 10 <= height <= 200 and
            _daily_ghost_frame(history, 0, width, height) is not None):
        return history
    return None


def _ghost_score_at(history, frame_index):
    """Score the ghost had at a given tick (None when the frame has no score)."""
    if not isinstance(history, list) or not history or type(frame_index) is not int:
        return None
    frame = history[max(0, min(frame_index, len(history) - 1))]
    if not isinstance(frame, list) or len(frame) < 4 or type(frame[3]) is not int:
        return None
    return max(0, frame[3])


def _ghost_final_score(history):
    return _ghost_score_at(history, len(history) - 1) if isinstance(history, list) and history else None


def _ghost_pace_ticks(history, player_score, player_tick):
    """Ticks the player is ahead (+) or behind (-) the ghost at equal score.

    Looks up the first tick at which the ghost had reached ``player_score``.
    Returns None while the player has not out-scored the ghost's whole run
    (there is nothing to compare against yet) or the history is unusable.
    """
    if not isinstance(history, list) or type(player_score) is not int or type(player_tick) is not int:
        return None
    if player_score <= 0:
        return 0
    for index, frame in enumerate(history):
        if isinstance(frame, list) and len(frame) > 3 and type(frame[3]) is int and frame[3] >= player_score:
            return index - player_tick
    return None


def _best_challenge_ghost_history(challenge_id, challenge_kind):
    fields = {
        'daily': 'daily_challenge_id',
        'custom': 'custom_challenge_id',
    }
    field = fields.get(challenge_kind)
    if not field or not isinstance(challenge_id, str) or not challenge_id:
        return None
    try:
        scores = _load_data().get('highscores', [])
        candidates = [score for score in scores if isinstance(score, dict)
            and score.get(field) == challenge_id
            and _score_has_replay(score)]
        def score_value(score):
            try:
                value = score.get('score', 0)
                return max(0, int(value)) if not isinstance(value, bool) else 0
            except (TypeError, ValueError, OverflowError):
                return 0
        candidates.sort(key=score_value, reverse=True)
        for score in candidates:
            history = _ghost_history_for_score(score)
            if history is not None:
                return history
    except (OSError, ValueError, TypeError, AttributeError):
        pass
    return None


def _best_daily_ghost_history(challenge_id):
    return _best_challenge_ghost_history(challenge_id, 'daily')


def _best_custom_ghost_history(challenge_id):
