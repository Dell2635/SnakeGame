# pygame.font.match_font only matches by family *name* — it says nothing
# about whether that font file actually contains the glyphs we need (many
# "general" fonts claim broad support but are missing whole scripts, which
# is how squares slip through even though a font was "found"). If fontTools
# is installed, we double-check each candidate's cmap table against real
# sample text before accepting it; if it's not installed, resolution still
# works exactly as before (first name match wins) — this is a pure
# enhancement, never a hard requirement.
try:
    from fontTools.ttLib import TTFont as _TTFont
    _FONTTOOLS_AVAILABLE = True
except Exception:
    _FONTTOOLS_AVAILABLE = False


def _activate_fonttools_if_installed():
    """Called after the startup checker successfully pip-installs fontTools,
    so the improved Unicode font selection kicks in immediately instead of
    only on the next launch."""
    global _FONTTOOLS_AVAILABLE, _TTFont
    if _FONTTOOLS_AVAILABLE:
        return
    try:
        from fontTools.ttLib import TTFont as _ImportedTTFont
        _TTFont = _ImportedTTFont
        _FONTTOOLS_AVAILABLE = True
        _resolved_font_path_cache.clear()  # re-resolve fonts now that verification is available
    except Exception:
        pass

_font_cmap_cache = {}       # font path -> set of covered codepoints, or None
_FONT_CMAP_CACHE_MAX = 16
_script_sample_cache = None  # script -> sample text built from LANGUAGES


def _build_script_samples():
    """Build a representative sample string per script out of the actual
    native_name strings in LANGUAGES — i.e. exactly the characters the game
    needs to render, with no separate hardcoded list to keep in sync."""
    samples = {}
    for code, info in LANGUAGES.items():
        script = _LANGUAGE_SCRIPT.get(code, 'latin')
        samples.setdefault(script, set()).update(info['native_name'])
    return {script: ''.join(chars) for script, chars in samples.items()}


def _get_script_sample(script):
    global _script_sample_cache
    if _script_sample_cache is None:
        _script_sample_cache = _build_script_samples()
    return _script_sample_cache.get(script, '')


def _get_font_cmap(font_path):
    coverage, cached = _lru_cache_get(_font_cmap_cache, font_path)
    if cached:
        return coverage
    coverage = None
    if _FONTTOOLS_AVAILABLE:
        try:
            tt = _TTFont(font_path, lazy=True, fontNumber=0)
            coverage = set(tt.getBestCmap().keys())
        except Exception:
            coverage = None
    _lru_cache_put(_font_cmap_cache, font_path, coverage, _FONT_CMAP_CACHE_MAX)
    return coverage


def _coverage_score(font_path, sample_text):
    """How much of sample_text this font can actually render.
    Returns (covers_almost_all, fraction). If fontTools isn't available or
    the font can't be parsed, we can't verify — return a neutral "trust it"
    result so behavior degrades gracefully to plain name-matching."""
    if not sample_text:
        return True, 1.0
    cmap = _get_font_cmap(font_path)
    if cmap is None:
        return True, 1.0
    needed = [ord(c) for c in sample_text if not c.isspace()]
    if not needed:
        return True, 1.0
    covered = sum(1 for cp in needed if cp in cmap)
    fraction = covered / len(needed)
    return fraction >= 0.98, fraction
# ---------------------------------------------------------------------------


def _resolve_font_path(script, style):
    """Search installed system fonts for the best match for this script and
    style, trying a priority list of family names. When fontTools is
    available, candidates are verified against real sample text and the
    best-covering one wins rather than just the first name that resolves.
    Cached per (script, style) so this search only happens once."""
    cache_key = (script, style)
    if cache_key in _resolved_font_path_cache:
        return _resolved_font_path_cache[cache_key]

    is_bold = (style == 'bold')
    is_italic = (style == 'italic')

    candidates = list(_SCRIPT_FONT_CANDIDATES.get(script, []))
    if style == 'mono':
        candidates = _MONO_CANDIDATES + candidates
    candidates += _UNIVERSAL_FALLBACK_CANDIDATES

    sample_text = _get_script_sample(script)

    best_path = None
    best_fraction = -1.0
    for name in candidates:
        try:
            path = pygame.font.match_font(name, bold=is_bold, italic=is_italic)
        except Exception:
            path = None
        if not path:
            continue

        covers_almost_all, fraction = _coverage_score(path, sample_text)
        if fraction > best_fraction:
            best_path, best_fraction = path, fraction
        if covers_almost_all:
            break  # good enough — no need to keep scanning

    _resolved_font_path_cache[cache_key] = best_path
    return best_path


def render_fit(font, text, color, max_width, padding=14):
    """Render `text` and, if it's wider than the space it has to sit in,
    shrink the resulting surface proportionally so it never spills past
    its container. Some languages render noticeably wider than English at
    the same point size (long German compound words, Arabic, etc.), and a
    fixed pixel width tuned for English text will overflow for them
    otherwise. Centralizing the shrink logic here means every button in
    the game gets this protection the same way, instead of each screen
    reimplementing (or forgetting) it.
    `max_width` is normally the button/box width; `padding` is subtracted
    from it to leave a small margin on each side."""
    surf = font.render(text, True, color)
    limit = max_width - padding
    if limit > 0 and surf.get_width() > limit:
        scale = limit / surf.get_width()
        new_size = (max(1, int(surf.get_width() * scale)), max(1, int(surf.get_height() * scale)))
        surf = pygame.transform.smoothscale(surf, new_size)
    return surf



_ACCESSIBILITY_REDUCED_MOTION = False
_ACCESSIBILITY_COLOR_CUES = False
_ACCESSIBILITY_UI_SCALE = 1.0
_ACCESSIBILITY_HIGH_CONTRAST = False


def _apply_accessibility_preferences(settings):
    global _ACCESSIBILITY_REDUCED_MOTION, _ACCESSIBILITY_COLOR_CUES
    global _ACCESSIBILITY_UI_SCALE, _ACCESSIBILITY_HIGH_CONTRAST
    _ACCESSIBILITY_REDUCED_MOTION = type(getattr(settings, 'reduced_motion', False)) is bool and settings.reduced_motion
    _ACCESSIBILITY_COLOR_CUES = type(getattr(settings, 'colorblind_cues', False)) is bool and settings.colorblind_cues
    _ACCESSIBILITY_HIGH_CONTRAST = type(getattr(settings, 'high_contrast', False)) is bool and settings.high_contrast
    try:
        scale = int(getattr(settings, 'ui_scale_percent', 100))
    except (TypeError, ValueError, OverflowError):
        scale = 100
    _ACCESSIBILITY_UI_SCALE = max(80, min(140, scale)) / 100.0
    theme_manager = globals().get('THEME_MANAGER')
    if theme_manager is not None:
        try:
            theme_manager._apply_colors(theme_manager._resolved_manifest(theme_manager.active_theme_id))
        except Exception:
            pass

def get_font(language, style, size):
    """
    Get a font with the specified style and size, with Unicode coverage
    appropriate for the language's script.

    Tries a prioritized stack of installed system fonts (Noto Sans family
    preferred) matching the language's script (Latin, Cyrillic, Greek, CJK,
    Arabic, Hebrew, Devanagari, Thai). Falls back to a broad-coverage
    universal font, and finally to pygame's bundled default font, so
    non-Latin text renders correctly instead of showing broken-glyph
    squares wherever a suitable system font is available.

    Args:
        language (str): Language code (e.g., 'en', 'ja', 'zh')
        style (str): Font style ('regular', 'bold', 'italic', 'mono')
        size (int): Font size in points

    Returns:
        pygame.font.Font: A font object for rendering text
    """
    try:
        size = max(1, int(round(int(size) * _ACCESSIBILITY_UI_SCALE)))
    except (TypeError, ValueError, OverflowError):
        size = max(1, int(size))
    theme_id = globals().get("THEME_MANAGER").active_theme_id if globals().get("THEME_MANAGER") else "default"
    cache_key = f"{theme_id}_{language}_{style}_{size}"
    font, cached = _lru_cache_get(font_cache, cache_key)
    if cached:
        return font

    script = _script_for_language(language)
    try:
        font_path = THEME_MANAGER.resolve_font_path(style, language)
    except Exception:
        font_path = None
    if not font_path:
        font_path = _resolve_font_path(script, style)

    try:
        if font_path:
            font = pygame.font.Font(font_path, size)
            # Harmless even for faces that don't have a real bold/italic
            # variant — pygame synthesizes it — and covers font files that
            # only ship one weight.
            if style == 'bold':
                font.set_bold(True)
            elif style == 'italic':
                font.set_italic(True)
        else:
            # Nothing matched on this system at all — fall back to pygame's
            # bundled default font rather than fail to render anything.
            font = pygame.font.SysFont(None, size, bold=(style == 'bold'), italic=(style == 'italic'))
    except Exception:
        font = pygame.font.SysFont(None, size, bold=(style == 'bold'), italic=(style == 'italic'))

    _lru_cache_put(font_cache, cache_key, font, _FONT_CACHE_MAX)
    return font

def clear_font_cache():
    """Clear the font cache (font objects only — resolved font *paths* stay
    cached, since which system fonts are installed doesn't change at runtime)."""
    global font_cache
    font_cache = {}
    _SAFE_MARK_CACHE.clear()


# Symbols such as the check mark are not present in every UI font; when a
# glyph is missing, pygame silently draws an empty "tofu" box. Instead of
# hard-coding a character in each screen, every screen asks for the mark here
# and gets the first candidate that the active fonts really draw.
_SAFE_MARK_CACHE = {}
_SAFE_MARK_CANDIDATES = {
    'check': ('\u2713', '\u2714', '\u221a', '+'),
    'lock': ('\U0001f512', '\u00d7', 'x'),
}


def _font_draws_glyph(font, char):
    """True when `font` really draws `char` (not the missing-glyph box)."""
    try:
        metrics = font.metrics(char)
        if not metrics or metrics[0] is None:
            return False
        glyph = font.render(char, True, (255, 255, 255))
        if glyph.get_width() <= 0:
            return False
        # A font without the glyph draws its own ".notdef" box, which is
        # identical to what a private-use code point produces.
        missing = font.render('\uffff', True, (255, 255, 255))
        if (glyph.get_size() == missing.get_size()
                and pygame.image.tostring(glyph, 'RGBA')
                == pygame.image.tostring(missing, 'RGBA')):
            return False
        return True
    except Exception:
        return False


def safe_mark(language, kind='check'):
    """Return a marker character ('check' or 'lock') that the UI fonts for
    `language` can draw. Falls back to plain ASCII, never to a broken box."""
    key = (language, kind)
    cached = _SAFE_MARK_CACHE.get(key)
    if cached is not None:
        return cached
    candidates = _SAFE_MARK_CANDIDATES.get(kind, ('+',))
    chosen = candidates[-1]
    try:
        if not pygame.font.get_init():
            # Fonts are not ready yet (startup/headless): answer with the
            # ASCII fallback but do not cache it.
            return chosen
        fonts = [get_font(language, 'regular', 16), get_font(language, 'bold', 16)]
        for char in candidates[:-1]:
            if all(_font_draws_glyph(font, char) for font in fonts):
                chosen = char
                break
    except Exception:
        return chosen
    _SAFE_MARK_CACHE[key] = chosen
    return chosen

