    def _studio_manage_custom_challenge(self, challenge):
        while True:
            selected = {'action': None}
            modifier_key = {
                'classic': 'daily_modifier_classic',
                'wrap_walls': 'daily_modifier_wrap',
            }[challenge['modifier']]

            def choose(action, screen):
                selected['action'] = action
                screen._go_back()

            detail = _SimpleMenuScreen(
                self.settings, self.screen,
                title_fn=lambda: get_text(self.settings.language, 'challenge_creator'),
                body_fn=lambda: (
                    f"{challenge['display_name']}\n"
                    f"{get_text(self.settings.language, 'seed_label')}: {challenge['seed']}\n"
                    f"{get_text(self.settings.language, modifier_key)}\n"
                    f"{get_text(self.settings.language, 'speed')}: "
                    f"{challenge['rules']['update_rate_ms']} ms"),
                entries=[
                    ('play_saved_challenge',
                     lambda: get_text(self.settings.language, 'play'),
                     COLORS['green'], lambda: choose('play', detail)),
                    ('rename_saved_challenge',
                     lambda: get_text(self.settings.language, 'challenge_rename'),
                     COLORS['blue'], lambda: choose('rename', detail)),
                    ('delete_saved_challenge',
                     lambda: get_text(self.settings.language, 'delete'),
                     COLORS['red'], lambda: choose('delete', detail)),
                ])
            self._run_sub(detail.run, name='custom_challenge_detail', owner=detail)
            action = selected['action']
            if action == 'play':
                self._run_custom_challenge(challenge)
                return
            if action == 'rename':
                rename_screen = _CustomChallengeRenameScreen(
                    self.settings, self.screen, challenge)
                self._run_sub(rename_screen.run, name='custom_challenge_rename',
                              owner=rename_screen)
                if rename_screen.renamed_challenge is not None:
                    challenge = rename_screen.renamed_challenge
                continue
            if action == 'delete':
                confirmed = {'value': False}

                def confirm_delete(screen):
                    confirmed['value'] = True
                    screen._go_back()

                confirmation = _SimpleMenuScreen(
                    self.settings, self.screen,
                    title_fn=lambda: get_text(self.settings.language, 'challenge_creator'),
                    body_fn=lambda: get_text(
                        self.settings.language, 'confirm_delete_challenge'),
                    entries=[
                        ('confirm_delete_challenge',
                         lambda: get_text(self.settings.language, 'delete'),
                         COLORS['red'], lambda: confirm_delete(confirmation)),
                    ])
                self._run_sub(confirmation.run, name='custom_challenge_delete_confirm',
                              owner=confirmation)
                if confirmed['value']:
                    try:
                        _delete_custom_challenge(challenge['challenge_id'])
                    except (OSError, ValueError, TypeError) as exc:
                        sgf_log.warning('Could not delete custom challenge: %s',
                                        type(exc).__name__)
                return
            return

    def _studio_open_challenges(self):
        modifier_labels = {
            'classic': 'daily_modifier_classic',
            'wrap_walls': 'daily_modifier_wrap',
        }
        while True:
            maps = _load_custom_maps()
            saved_challenges = _load_custom_challenges()
            entries = []
            selected = {'challenge': None, 'edit_map': False, 'saved': False}

            def _open_editor(creator_screen):
                selected['edit_map'] = True
                creator_screen._go_back()

            entries.append((
                'challenge_map_editor',
                lambda: _t_or(self.settings.language, 'map_editor', 'Map Editor'),
                COLORS['blue'], lambda: _open_editor(creator)))

            def _open_saved_challenges(creator_screen):
                selected['saved'] = True
                creator_screen._go_back()

            entries.append((
                'saved_challenges',
                lambda: get_text(self.settings.language, 'saved_challenges'),
                COLORS['blue'], lambda: _open_saved_challenges(creator)))

            listed_ids = set()
            for map_name, map_data in sorted(maps.items(), key=lambda item: item[0].casefold()):
                for modifier, modifier_key in modifier_labels.items():
                    for speed_ms in _CUSTOM_CHALLENGE_SPEEDS:
                        try:
                            digest = _custom_challenge_identity_v2(
                                map_name, map_data, modifier, speed_ms)
                            challenge_id = 'user-v2-' + digest[:24]
                        except (TypeError, ValueError):
                            continue
                        listed_ids.add(challenge_id)
                        challenge = saved_challenges.get(challenge_id)

                        def _select_map_challenge(name=map_name, data=map_data,
                                                  rule=modifier, speed=speed_ms,
                                                  existing=challenge):
                            try:
                                selected['challenge'] = existing or _create_or_load_custom_challenge(
                                    name, data, rule, speed)
                                creator._go_back()
                            except Exception as exc:
                                sgf_log.warning('Could not create custom challenge: %s', type(exc).__name__)

                        entries.append((
                            f'custom_challenge_{challenge_id}',
                            lambda name=map_name, key=modifier_key, speed=speed_ms:
                                f"{get_text(self.settings.language, 'play')}: {name} · "
                                f"{get_text(self.settings.language, key)} · "
                                f"{get_text(self.settings.language, 'speed')}: {speed} ms",
                            COLORS['purple'] if modifier == 'wrap_walls' else COLORS['green'],
                            _select_map_challenge))

            # Keep playable challenge snapshots visible even after their
            # source map is renamed or removed from the map editor.
            for challenge_id, challenge in sorted(saved_challenges.items()):
                if challenge_id in listed_ids:
                    continue
                modifier_key = modifier_labels[challenge['modifier']]
                entries.append((
                    f'custom_challenge_saved_{challenge_id}',
                    lambda ch=challenge, key=modifier_key:
                        f"{get_text(self.settings.language, 'play')}: {ch['map_name']} · "
                        f"{get_text(self.settings.language, key)} · "
                        f"{get_text(self.settings.language, 'speed')}: "
                        f"{ch['rules']['update_rate_ms']} ms",
                    COLORS['purple'] if challenge['modifier'] == 'wrap_walls' else COLORS['green'],
                    lambda ch=challenge: (selected.update(challenge=ch), creator._go_back())))

            creator = _SimpleMenuScreen(
                self.settings, self.screen,
                title_fn=lambda: get_text(self.settings.language, 'challenge_creator'),
                entries=entries)
            self._run_sub(creator.run, name="challenges", owner=creator)
            if selected['edit_map']:
                self._menu_open_map_editor()
                continue
            if selected['saved']:
                saved = _load_custom_challenges()
                selected_saved = {'challenge': None}
                saved_entries = []
                for challenge_id, challenge in sorted(saved.items()):
                    modifier_key = modifier_labels[challenge['modifier']]
                    saved_entries.append((
                        f'saved_challenge_{challenge_id}',
                        lambda ch=challenge, key=modifier_key:
                            f"{ch['display_name']} · "
                            f"{get_text(self.settings.language, key)} · "
                            f"{get_text(self.settings.language, 'speed')}: "
                            f"{ch['rules']['update_rate_ms']} ms",
                        COLORS['purple'] if challenge['modifier'] == 'wrap_walls'
                        else COLORS['green'],
                        lambda ch=challenge: (
                            selected_saved.update(challenge=ch), saved_screen._go_back())))
                saved_screen = _SimpleMenuScreen(
                    self.settings, self.screen,
                    title_fn=lambda: get_text(self.settings.language, 'saved_challenges'),
                    entries=saved_entries,
                    body_fn=(lambda: get_text(self.settings.language, 'challenge_saved_empty')
                             if not saved_entries else None)
                    if not saved_entries else None)
                self._run_sub(saved_screen.run, name='saved_challenges', owner=saved_screen)
                if selected_saved['challenge'] is not None:
                    self._studio_manage_custom_challenge(selected_saved['challenge'])
                continue
            challenge = selected['challenge']
            if challenge is not None:
                self._run_custom_challenge(challenge)
            return

    def _run_custom_challenge(self, challenge):
        best_ghost_history = _best_custom_ghost_history(
            challenge.get('challenge_id'))
        started = {'value': False, 'ghost': False}
        briefing = None

        def _begin(with_ghost=False):
            started['value'] = True
            started['ghost'] = bool(with_ghost)
            briefing._go_back()

        modifier_key = {
            'classic': 'daily_modifier_classic',
            'wrap_walls': 'daily_modifier_wrap',
        }[challenge['modifier']]
        briefing_entries = [
            ('start_custom_challenge',
             lambda: get_text(self.settings.language, 'play'),
             COLORS['green'], lambda: _begin(False)),
        ]
        if best_ghost_history:
            briefing_entries.append((
                'race_custom_challenge_ghost',
                lambda: get_text(self.settings.language, 'daily_ghost_race'),
                COLORS['purple'], lambda: _begin(True)))
        briefing = _SimpleMenuScreen(
            self.settings, self.screen,
            title_fn=lambda: get_text(self.settings.language, 'challenge_creator'),
            entries=briefing_entries,
            body_fn=lambda: f"{challenge['display_name']}\n"
                            f"{get_text(self.settings.language, 'seed_label')}: {challenge['seed']}\n"
                            f"{get_text(self.settings.language, modifier_key)}\n"
                            f"{get_text(self.settings.language, 'speed')}: "
                            f"{challenge['rules']['update_rate_ms']} ms")
        self.runtime.run_legacy(
            'custom_challenge_briefing', briefing.run, surface_owner=briefing)
        if not started['value']:
            return
        challenge_settings = copy.deepcopy(self.settings)
        for key, value in challenge['rules'].items():
            setattr(challenge_settings, key, value)
        game = SnakeGame(
            challenge_settings, self.screen, seed=challenge['seed'],
            custom_map=challenge['map'])
        game.player_name = self.player_name
        game.achievement_manager = self.achievement_manager
        game.runtime = self.runtime
        game._sgf_custom_challenge = challenge
        if started['ghost']:
            game._sgf_ghost_history = best_ghost_history
        self.runtime.run_game(
            'custom_challenge', game.run,
            metadata={'seed': challenge['seed'], 'mode': 'custom_challenge',
                      'challenge_id': challenge['challenge_id']},
            surface_owner=game)

