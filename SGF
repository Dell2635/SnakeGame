_REPLAY_FILE_EXTENSION = '.sgfr'


def _replay_export_dir():
    """Folder for shareable replay files (created on demand, next to the other data)."""
    path = os.path.join(_user_data_manager.get_root_dir(), 'exports')
    os.makedirs(path, exist_ok=True)
    return path


def save_replay_file(score_data, directory=None):
    """Write a share-code replay file (magic, version and SHA-256 inside) atomically.

    The .sgfr file holds exactly the validated share code, so a file and a
    copied code are interchangeable and both go through the same bounded,
    integrity-checked importer.
    """
    code = export_replay_share_code(score_data)
    directory = directory or _replay_export_dir()
    stem = _safe_content_id(
        f"replay-{score_data.get('score', 0)}-{score_data.get('seed') or score_data.get('date') or 'run'}",
        'replay')
    path = os.path.join(directory, stem + _REPLAY_FILE_EXTENSION)
    counter = 1
    while os.path.exists(path):
        counter += 1
        path = os.path.join(directory, f"{stem}-{counter}{_REPLAY_FILE_EXTENSION}")
    temp_path = path + '.tmp'
    with open(temp_path, 'w', encoding='ascii', newline='\n') as handle:
        handle.write(code + '\n')
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temp_path, path)
    return path


def load_replay_file(path):
    """Read an .sgfr file; the contents are validated like any pasted share code."""
    if not str(path).lower().endswith(_REPLAY_FILE_EXTENSION):
        raise ValueError('Replay files use the .sgfr extension.')
    if os.path.getsize(path) > _REPLAY_SHARE_MAX_CODE_BYTES + 16:
        raise ValueError('Replay file is too large.')
    with open(path, 'r', encoding='ascii', errors='strict') as handle:
        return import_replay_share_code(handle.read(_REPLAY_SHARE_MAX_CODE_BYTES + 16).strip())


