        screen.blit(surface, (sw // 2 - surface.get_width() // 2, y))


class _NetworkLinkMixin:
    """One secure peer connection: I/O threads, heartbeat, stall detection and resume.

    Shared by the two-player NetworkGame and by the per-guest links of the
    multi-player session, so reconnection logic exists exactly once.
    """

    HEARTBEAT_INTERVAL = 1.5      # guest -> host ping period (seconds)
    STALL_WARN_SECONDS = 3.0      # silence before the badge says "unstable"
    STALL_LOST_SECONDS = 12.0     # silence before the link is declared dead
    RECONNECT_WINDOW = 30.0       # how long both sides try to resume a match
    # Drops that can be a network hiccup. Protocol errors and rate-limit
    # violations mean the peer misbehaved, so those never trigger a resume.
    RECOVERABLE_REASONS = frozenset({
        'peer_disconnect', 'socket_error', 'send_socket_error', 'send_backpressure', 'stalled'})

    def _init_link(self, conn, is_host, session):
        """Set up the connection state shared by every session type and start its I/O."""
        self.is_host = is_host
        self.conn = conn
        self.connected = True
        self.disconnect_reason = None
        self._stop_event = threading.Event()
        self._recv_q   = _queue_mod.Queue(maxsize=256)
        self._send_q   = _queue_mod.Queue(maxsize=32)

        # Reconnection / liveness state. ``session`` carries what is needed to
        # resume: the host keeps its listeners and TLS context, the guest the
        # endpoint, invite and resume credential.
        self._session = session if isinstance(session, dict) else None
        self._conn_gen = 0
        self._conn_stop = threading.Event()
        self._recv_t = None
        self._send_t = None
        self._last_rx = time.monotonic()
        self._next_ping = time.monotonic() + 1.0
        self._ping_seq = 0
        self._ping_sent = {}
        self.latency_ms = None
        self.peer_left = False
        self._reconnect_state = None      # None | 'host_wait' | 'client_dial'
        self._reconnect_exhausted = False  # window used up: the link is finally lost
        self._reconnect_deadline = 0.0
        self._resume_results = _queue_mod.Queue()
        self._resume_pending = False
        self._dial_cancel = threading.Event()
        self._next_listener_poll = 0.0
        self._start_io(conn)
    def _queue_net_event(self, msg):
        if isinstance(msg, dict) and msg.get('t') == 'state':
            with self._recv_q.mutex:
                for idx in range(len(self._recv_q.queue) - 1, -1, -1):
                    queued = self._recv_q.queue[idx]
                    if isinstance(queued, dict) and queued.get('t') == 'state':
                        self._recv_q.queue[idx] = msg
                        self._recv_q.not_empty.notify()
                        return
        try:
            self._recv_q.put_nowait(msg)
        except _queue_mod.Full:
            # State frames are disposable; preserve control/disconnect messages.
            if isinstance(msg, dict) and msg.get('t') == 'state':
                return
            try:
                self._recv_q.get_nowait()
            except _queue_mod.Empty:
                pass
            try:
                self._recv_q.put_nowait(msg)
            except _queue_mod.Full:
                pass

    def _start_io(self, conn):
        """Attach a (new) connection and start its reader/writer threads."""
        self._conn_gen += 1
        gen = self._conn_gen
        stop = threading.Event()
        self._conn_stop = stop
        self.conn = conn
        self._last_rx = time.monotonic()
        self._recv_t = threading.Thread(target=self._recv_loop, args=(conn, gen, stop), daemon=True)
        self._recv_t.start()
        self._send_t = threading.Thread(target=self._send_loop, args=(conn, gen, stop), daemon=True)
        self._send_t.start()

    def _stop_io(self):
        """Close the current connection; its threads exit without reporting."""
        self._conn_stop.set()
        conn = self.conn
        try:
            conn.shutdown(_socket_mod.SHUT_RDWR)
        except (OSError, AttributeError):
            pass
        try:
            conn.close()
        except (OSError, AttributeError):
            pass
        for thread in (self._recv_t, self._send_t):
            if thread and thread.is_alive() and thread is not threading.current_thread():
                thread.join(timeout=0.35)

    def _report_disconnect(self, gen, reason, detail=None):
        """Record a failure of connection ``gen``; stale connections are ignored."""
        if gen != self._conn_gen or self._stop_event.is_set() or self._conn_stop.is_set():
            return
        self.connected = False
        self.disconnect_reason = reason
        event = {'t': 'disconnect', 'reason': reason, 'gen': gen}
        if detail:
            event['detail'] = detail
        self._queue_net_event(event)

    def _recv_loop(self, conn, gen, stop):
        rate_start = time.monotonic()
        rate_count = 0
        while not (stop.is_set() or self._stop_event.is_set()):
            try:
                frame_limit = NET_MAX_SESSION_INPUT_FRAME if self.is_host else NET_MAX_SESSION_STATE_FRAME
                msg = _net_recv(conn, max_frame=frame_limit)
                if msg is None:
                    self._report_disconnect(gen, 'peer_disconnect')
                    return
                now = time.monotonic()
                if now - rate_start >= 1.0:
                    rate_start, rate_count = now, 0
                rate_count += 1
                message_rate_limit = 130 if self.is_host else 75
                if rate_count > message_rate_limit:
                    raise _NetProtocolError('peer exceeded the message rate limit')
                if not _validate_net_session_message(msg, self.is_host):
                    raise _NetProtocolError('peer sent an unexpected or invalid session message')
                self._last_rx = now
                self._queue_net_event(msg)
            except _NetProtocolError as exc:
                self._report_disconnect(gen, 'protocol_error', str(exc))
                print('[network] protocol error from peer')
                return
            except (ConnectionError, BrokenPipeError, OSError) as exc:
                self._report_disconnect(gen, 'socket_error', str(exc))
                return
            except Exception as exc:
                # Do not disguise programming errors as a normal disconnect.
                self._report_disconnect(gen, 'receiver_error', repr(exc))
                print(f"[network] unexpected receiver failure: {exc}")
                return

    def _send_safe(self, msg):
        if not self.connected or self._stop_event.is_set():
            return False
        if not isinstance(msg, dict):
            return False
        is_state = msg.get('t') == 'state'
        with self._send_q.mutex:
            pending = self._send_q.queue
            if is_state:
                # State is a replaceable snapshot. Coalesce it so a slow link
                # cannot build latency or an unbounded backlog.
                for idx in range(len(pending) - 1, -1, -1):
                    if isinstance(pending[idx], dict) and pending[idx].get('t') == 'state':
                        pending[idx] = msg
                        self._send_q.not_empty.notify()
                        return True
            else:
                # Keep control/input ordering ahead of any stale snapshot.
                for idx in range(len(pending) - 1, -1, -1):
                    if isinstance(pending[idx], dict) and pending[idx].get('t') == 'state':
                        del pending[idx]
                        self._send_q.unfinished_tasks -= 1
                        break
            if len(pending) >= self._send_q.maxsize:
                queue_full = True
            else:
                pending.append(msg)
                self._send_q.unfinished_tasks += 1
                self._send_q.not_empty.notify()
                queue_full = False
        if queue_full:
            self.connected = False
            self.disconnect_reason = 'send_backpressure'
            self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason})
            return False
        return True

    def _send_loop(self, conn, gen, stop):
        while not (stop.is_set() or self._stop_event.is_set()):
            try:
                msg = self._send_q.get(timeout=0.1)
            except _queue_mod.Empty:
                continue
            try:
                _net_send(conn, msg)
            except (ConnectionError, BrokenPipeError, OSError) as exc:
                self._report_disconnect(gen, 'send_socket_error', str(exc))
                return
            except Exception as exc:
                self._report_disconnect(gen, 'send_error', repr(exc))
                print(f"[network] unexpected send failure: {exc}")
                return
            finally:
                self._send_q.task_done()

    def link_state(self):
        """'connected' | 'unstable' | 'reconnecting' | 'waiting' | 'left' | 'lost'."""
        if self.peer_left:
            return 'left'
        if self._reconnect_state == 'host_wait':
            return 'waiting'
        if self._reconnect_state == 'client_dial':
            return 'reconnecting'
        if not self.connected:
            return 'lost'
        if time.monotonic() - self._last_rx > self.STALL_WARN_SECONDS:
            return 'unstable'
        return 'connected'

    def reconnect_seconds_left(self):
        return max(0, int(math.ceil(self._reconnect_deadline - time.monotonic())))

    def _clear_send_queue(self):
        with self._send_q.mutex:
            self._send_q.queue.clear()
            self._send_q.unfinished_tasks = 0

    def _begin_reconnect(self):
        """Pause and try to resume after a recoverable drop (both roles)."""
        self._stop_io()
        self._clear_send_queue()
        self._reconnect_deadline = time.monotonic() + self.RECONNECT_WINDOW
        sgf_log.info('Multiplayer link lost (%s); trying to resume', self.disconnect_reason)
        if self.is_host:
            self._reconnect_state = 'host_wait'
            return
        self._reconnect_state = 'client_dial'
        self._dial_cancel = threading.Event()
        threading.Thread(target=self._dial_loop,
                         args=(self._reconnect_deadline, self._dial_cancel),
                         name='SGF-resume-dial', daemon=True).start()

    def _dial_loop(self, deadline, cancel):
        """Guest side: keep trying to rejoin the same match until the deadline."""
        session = self._session or {}
        while not cancel.is_set() and time.monotonic() < deadline:
            stream = None
            try:
                remaining = max(2.0, min(8.0, deadline - time.monotonic()))
                stream, _token = _open_secure_peer_stream(
                    session['host'], session['port'], session['invite'], cancel, remaining)
                stream.settimeout(6.0)
                _net_send(stream, {'t': 'secure_resume', 'token': session['resume']})
                reply = _net_recv(stream)
                if isinstance(reply, dict) and reply.get('t') == 'resumed' and set(reply) == {'t', 'v'}:
                    stream.settimeout(15.0)
                    self._resume_results.put((True, stream))
                    return
            except Exception as exc:
                sgf_log.info('Resume attempt failed: %s', _describe_relay_failure(exc))
            if stream is not None:
                try:
                    stream.close()
                except OSError:
                    pass
            wake = time.monotonic() + 1.0
            while time.monotonic() < wake and not cancel.is_set():
                time.sleep(0.05)
        self._resume_results.put((False, None))

    def _adopt_connection(self, conn):
        """Switch to a freshly resumed connection and carry on the same match."""
        self._stop_io()   # a half-open old connection is replaced by the guest's new one
        self._clear_send_queue()
        with self._recv_q.mutex:
            self._recv_q.queue.clear()
        self._start_io(conn)
        self.connected = True
        self.disconnect_reason = None
        self.peer_left = False
        self._reconnect_state = None
        self._reconnect_exhausted = False
        self._initial_board_sent = False
        self._next_ping = time.monotonic() + 0.2
        sgf_log.info('Multiplayer link resumed')

    def _poll_resume_listeners(self, now):
        """Host side: admit the original guest back (works while still 'connected')."""
        session = self._session
        if not self.is_host or not session or not session.get('listeners'):
            return
        try:
            ok, value = self._resume_results.get_nowait()
        except _queue_mod.Empty:
            ok = value = None
        else:
            self._resume_pending = False
            if ok:
                self._adopt_connection(value)
                return
        if self._resume_pending or now < self._next_listener_poll:
            return
        self._next_listener_poll = now + 0.2
        for listener in session['listeners']:
            try:
                raw, address = listener.accept()
            except (BlockingIOError, _socket_mod.timeout, OSError):
                continue
            peer_ip = address[0] if address else ''
            if not _allow_network_handshake_attempt(
                    peer_ip, session.setdefault('attempts', {}), max_attempts=30):
                raw.close()
                continue
            try:
                raw.setsockopt(_socket_mod.IPPROTO_TCP, _socket_mod.TCP_NODELAY, 1)
                threading.Thread(
                    target=_finish_secure_host_resume,
                    args=(raw, session['tls_context'], session['resume_token'],
                          self._resume_results, self._dial_cancel),
                    name='SGF-secure-resume', daemon=True).start()
                self._resume_pending = True
            except Exception:
                try:
                    raw.close()
                except OSError:
                    pass
            break

    def _service_link(self):
        """Per-frame link maintenance: heartbeat, stall detection, resume."""
        now = time.monotonic()
        if self.is_host:
            self._poll_resume_listeners(now)
        elif self._reconnect_state == 'client_dial':
            try:
                ok, value = self._resume_results.get_nowait()
            except _queue_mod.Empty:
                pass
            else:
                if ok:
                    self._adopt_connection(value)
                else:
                    self._reconnect_state = None   # gave up: final "connection lost"
                    self._reconnect_exhausted = True
                return
        if self._reconnect_state is not None:
            if self._reconnect_state == 'host_wait' and now >= self._reconnect_deadline:
                self._reconnect_state = None
                self._reconnect_exhausted = True
                sgf_log.warning('The guest did not return within the reconnect window')
            return
        if self.connected:
            if not self.is_host and now >= self._next_ping:
                self._ping_seq = (self._ping_seq + 1) % (2 ** 31)
                self._ping_sent[self._ping_seq] = now
                for stale in sorted(self._ping_sent)[:-8]:
                    self._ping_sent.pop(stale, None)
                self._send_safe({'t': 'ping', 'n': self._ping_seq})
                self._next_ping = now + self.HEARTBEAT_INTERVAL
            if now - self._last_rx > self.STALL_LOST_SECONDS:
                self.connected = False
                self.disconnect_reason = 'stalled'
        if (not self.connected and not self.peer_left and self._session is not None
                and not self._reconnect_exhausted
                and self.disconnect_reason in self.RECOVERABLE_REASONS
                and not self._stop_event.is_set()):
            self._begin_reconnect()

    # ── host helpers ────────────────────────────────────────────────────

    def _handle_link_message(self, msg):
        """Handle link-level messages. Returns 'handled', 'stop', or None for game messages."""
        t = msg.get('t')
        if t == 'disconnect':
            if msg.get('gen', self._conn_gen) != self._conn_gen:
                return 'handled'     # a connection that was already replaced
            self.connected = False
            self.disconnect_reason = msg.get('reason', 'peer_disconnect')
            return 'stop'
        if t == 'ping' and self.is_host:
            self._send_safe({'t': 'pong', 'n': msg.get('n', 0)})
            return 'handled'
        if t == 'pong' and not self.is_host:
            sent_at = self._ping_sent.pop(msg.get('n'), None)
            if sent_at is not None:
                self.latency_ms = int(round((time.monotonic() - sent_at) * 1000))
            return 'handled'
        if t == 'bye':
            # Deliberate exit by the other side: no reconnect window.
            self.peer_left = True
            self.connected = False
            self.disconnect_reason = 'peer_left'
            return 'stop'
        return None



class NetworkGame(_NetworkLinkMixin):
    """
    LAN multiplayer game session.

    is_host=True  → runs the full simulation (authoritative); sends state to client.
    is_host=False → renders state received from host; sends key presses to host.

    Both players use WASD or Arrow keys on their own device.
    """

    def __init__(self, settings, screen, is_host, conn, mode='1v1', custom_map=None,
                 seed=None, tunnel_session=None, session=None):
        self.settings  = settings
        self.screen    = screen
        self.is_host   = is_host
        self.conn      = conn
        self.mode      = mode
        self.custom_map = custom_map  # same map dict on both peers — sent by host during handshake
        self.tunnel_session = tunnel_session if is_host else None
        self.seed      = seed if seed else generate_seed()
        self._init_link(conn, is_host, session)
        self._input_window_start = time.monotonic()
        self._input_window_count = 0
        self._pause_window_start = time.monotonic()
        self._pause_window_count = 0
        self._restart_window_start = time.monotonic()
        self._restart_window_count = 0

        if is_host:
            # Host owns the authoritative MultiplayerGame
            self.mp = MultiplayerGame(settings, screen, mode, seed=self.seed, custom_map=custom_map)
            if 'DEV_TOOLS' in globals(): DEV_TOOLS.register_game(self.mp)
        else:
            # Client holds the last rendered state dict
            self.render_state = None
            self._local_dir   = (0, -1)   # for 180° guard
            # Client: shadow MultiplayerGame purely for replay recording —
            # built with the SAME custom_map the host sent during handshake,
            # so the client's saved replay has the same board/obstacles too.
            self._client_recorder = MultiplayerGame(settings, screen, mode, seed=self.seed, custom_map=custom_map)
            self._client_recorder.mp_history = []
            self._client_recorder._mp_history_position_samples = 0
            self._client_recorder._mp_history_truncated = False
            if 'DEV_TOOLS' in globals(): DEV_TOOLS.register_game(self._client_recorder)

        # Both peers keep a saved flag so we only persist once per match
        self._mp_saved = False
        self._initial_board_sent = False

    # ── background receiver ──────────────────────────────────────────────

    def close(self):
        # Tell the peer this is deliberate so it does not wait for a reconnect.
        if self.connected and not self.peer_left and not self._stop_event.is_set():
            if self._send_safe({'t': 'bye'}):
                flush_deadline = time.monotonic() + 0.4
                while (time.monotonic() < flush_deadline
                       and (self._send_q.unfinished_tasks > 0) and self.connected):
                    time.sleep(0.01)
        self._stop_event.set()
        self._dial_cancel.set()
        self.connected = False
        self._stop_io()
        session = self._session
        if session:
            for listener in session.get('listeners', []) or []:
                try:
                    listener.close()
                except OSError:
                    pass
            session['listeners'] = []
        tunnel_session = getattr(self, 'tunnel_session', None)
        if tunnel_session is not None:
            self.tunnel_session = None
            tunnel_session.stop()

    # ── liveness, heartbeat and resume ───────────────────────────────────

    def _state_dict(self):
        mp = self.mp
        return {
            't':  'state',
            'p1': [list(s) for s in mp.p1_snake],
            'p2': [list(s) for s in mp.p2_snake],
            'f':  list(mp.fruit_pos) if mp.fruit_pos else None,
            'ft': getattr(mp, 'fruit_type', 'regular'),
            's1': mp.p1_score,
            's2': mp.p2_score,
            'a1': mp.p1_alive,
            'a2': mp.p2_alive,
            'go': mp.game_over,
            'pa': mp.paused,
            'w':  mp.winner,
            'obs': [list(o) for o in mp.obstacles],
            'bw': mp.board_width,
            'bh': mp.board_height,
            'cs': mp.cell_size,
            'ox': mp.board_offset_x,
            'oy': mp.board_offset_y,
            'seed': getattr(mp, 'seed', None),
            # Authoritative per-frame replay snapshot (exact same structure
            # SnakeGame/MultiplayerGame use for their own replay history).
            # Sending this verbatim — rather than having the client
            # reconstruct its own snapshot from a subset of the fields above
            # — guarantees both peers end up with the byte-for-byte same
            # replay record for this match (same fruit_type, same
            # directions, same everything), instead of two independently
            # drifting "shadow" recordings.
            'snap': mp._mp_snap(),
        }

    def _apply_client_input(self, d_list):
        """Apply a direction from the client to P2 (avoids 180° reversal)."""
        nd = tuple(d_list)
        cur = self.mp.p2_dir
        if not (nd[0] == -cur[0] and nd[1] == -cur[1]):
            self.mp.p2_next = nd

    def _host_key(self, key):
        """Host controls P1 (WASD or Arrows)."""
        mp = self.mp
        mapping = {
            pygame.K_w: (0,-1), pygame.K_UP:    (0,-1),
            pygame.K_s: (0, 1), pygame.K_DOWN:  (0, 1),
            pygame.K_a: (-1,0), pygame.K_LEFT:  (-1,0),
            pygame.K_d: ( 1,0), pygame.K_RIGHT: ( 1,0),
        }
        if key not in mapping:
            return
        nd = mapping[key]
        cur = mp.p1_dir
        if not (nd[0] == -cur[0] and nd[1] == -cur[1]):
            mp.p1_next = nd

    # ── client helpers ───────────────────────────────────────────────────

    def _client_key(self, key):
        """Client controls P2; sends direction to host."""
        mapping = {
            pygame.K_w: (0,-1), pygame.K_UP:    (0,-1),
            pygame.K_s: (0, 1), pygame.K_DOWN:  (0, 1),
            pygame.K_a: (-1,0), pygame.K_LEFT:  (-1,0),
            pygame.K_d: ( 1,0), pygame.K_RIGHT: ( 1,0),
        }
        if key not in mapping:
            return
        nd = mapping[key]
        cur = self._local_dir
        if nd[0] == -cur[0] and nd[1] == -cur[1]:
            return
        self._local_dir = nd
        self._send_safe({'t': 'input', 'd': list(nd)})

    # ── rendering (client-side) ─────────────────────────────────────────

    def _draw_client(self):
        sw, sh = self.screen.get_width(), self.screen.get_height()
        background_color, board_color, grid_color = _map_theme_colors(self.settings)
        self.screen.fill(background_color)
        st = self.render_state

        if st is None:
            f = get_font(self.settings.language, 'bold', 24)
            s = f.render(get_text(self.settings.language, 'waiting_for_host'), True, COLORS['white'])
            self.screen.blit(s, (sw//2 - s.get_width()//2, sh//2 - s.get_height()//2))
            return

        bw = st.get('bw', 15); bh = st.get('bh', 15)
        cs = st.get('cs', 24); ox = st.get('ox', 0); oy = st.get('oy', 62)

        # Board
        pygame.draw.rect(self.screen, board_color,
                         pygame.Rect(ox, oy, bw*cs, bh*cs))
        for x in range(bw+1):
            pygame.draw.line(self.screen, grid_color,
                             (ox+x*cs, oy), (ox+x*cs, oy+bh*cs), 1)
        for y in range(bh+1):
            pygame.draw.line(self.screen, grid_color,
                             (ox, oy+y*cs), (ox+bw*cs, oy+y*cs), 1)

        # Obstacles
        for obs in st.get('obs', []):
            r = pygame.Rect(ox+obs[0]*cs, oy+obs[1]*cs, cs, cs)
            pygame.draw.rect(self.screen, COLORS.get('obstacle', (100,100,100)), r)

        # Fruit
        fp = st.get('f')
        if fp:
            fr = pygame.Rect(ox+fp[0]*cs, oy+fp[1]*cs, cs, cs)
            if cs >= 10 and self.settings.fruit_types_enabled:
                draw_fruit(self.screen, fr, st.get('ft', 'regular'))
            else:
                pygame.draw.rect(self.screen, COLORS['fruit'], fr)

        # Snakes
        def _ds(seg_list, bc, hc, alive):
            bc2 = bc if alive else (100,100,100)
            hc2 = hc if alive else (70,70,70)
            for i, seg in enumerate(seg_list or []):
                r = pygame.Rect(ox+seg[0]*cs+1, oy+seg[1]*cs+1, cs-2, cs-2)
                pygame.draw.rect(self.screen, hc2 if i==0 else bc2, r,
                                 border_radius=max(1, cs//5))

        _ds(st.get('p2',[]), MultiplayerGame.P2_BODY, MultiplayerGame.P2_HEAD, st.get('a2',True))
        _ds(st.get('p1',[]), MultiplayerGame.P1_BODY, MultiplayerGame.P1_HEAD, st.get('a1',True))

        # HUD
        hf = get_font(self.settings.language, 'bold',    20)
        sf = get_font(self.settings.language, 'regular', 14)
        lang = self.settings.language
        if self.mode == '1v1':
            p1c = (100,255,100) if st.get('a1',True) else (130,130,130)
            p2c = ( 80,215,255) if st.get('a2',True) else (130,130,130)
            self.screen.blit(hf.render(f"{get_text(lang, 'host_p1_score')}: {st.get('s1',0)}", True, p1c), (10, 8))
            s2 = hf.render(f"{get_text(lang, 'you_p2_score')}: {st.get('s2',0)}", True, p2c)
            self.screen.blit(s2, (sw - s2.get_width() - 10, 8))
        else:
            sc = st.get('s1',0) + st.get('s2',0)
            ss = hf.render(f"{get_text(lang, 'coop_score')}: {sc}", True, COLORS['white'])
            self.screen.blit(ss, (sw//2 - ss.get_width()//2, 8))
        tag = "1v1" if self.mode == '1v1' else get_text(lang, 'coop_label')
        ht = sf.render(get_text(lang, 'lan_controls_hint').format(mode=tag), True, (80,110,160))
        self.screen.blit(ht, (sw//2 - ht.get_width()//2, 44))

        # Game-over overlay
        if st.get('go'):
            ov = pygame.Surface((sw, sh), pygame.SRCALPHA)
            ov.fill((0,0,0,180)); self.screen.blit(ov, (0,0))
            bf = get_font(self.settings.language, 'bold',    50)
            mf2= get_font(self.settings.language, 'bold',    28)
            sf2= get_font(self.settings.language, 'regular', 20)
            w = st.get('w')
            if self.mode == '1v1':
                if   w==1:       txt,col = get_text(lang, 'host_wins'),    (100,255,100)
                elif w==2:       txt,col = get_text(lang, 'you_win_exclaim'), ( 80,215,255)
                elif w=='draw':  txt,col = get_text(lang, 'draw_exclaim'), (255,215,  0)
                else:            txt,col = get_text(lang, 'game_over'),    (200,200,200)
                sc_txt = f"{get_text(lang, 'host_p1_score')}: {st.get('s1',0)}     {get_text(lang, 'you_p2_score')}: {st.get('s2',0)}"
            else:
                if w=='coop_win': txt,col = get_text(lang, 'you_win_exclaim'), (100,255,100)
                else:             txt,col = get_text(lang, 'game_over'),  (255,80,80)
                sc_txt = f"{get_text(lang, 'team_score')}: {st.get('s1',0)+st.get('s2',0)}"
            for surf, y in [
                (bf.render(txt, True, col), sh//2-110),
                (mf2.render(sc_txt, True, COLORS['white']), sh//2-30),
                (sf2.render(get_text(lang, 'esc_back_menu'), True, (190,190,210)), sh//2+50),
            ]:
                self.screen.blit(surf, (sw//2 - surf.get_width()//2, y))
            _draw_replay_save_widget(
                self.screen, lang,
                getattr(self._client_recorder, '_replay_save_game_id', None),
                sw // 2, 68)
        elif st.get('pa'):
            ov = pygame.Surface((sw, sh), pygame.SRCALPHA)
            ov.fill((0, 0, 0, 145))
            self.screen.blit(ov, (0, 0))
            paused = hf.render(get_text(lang, 'paused').upper(), True, COLORS['white'])
            self.screen.blit(paused, paused.get_rect(center=(sw // 2, sh // 2)))
            resume_hint = sf.render(get_text(lang, 'press_p_to_resume'), True, (190, 205, 230))
            self.screen.blit(resume_hint, resume_hint.get_rect(center=(sw // 2, sh // 2 + 34)))

    def _link_label(self):
        """'NET' for relay sessions, 'LAN' otherwise."""
        session = self._session or {}
        relay = (self.tunnel_session is not None
                 or _is_cloudflare_quick_hostname(session.get('host', '')))
        return 'NET' if relay else 'LAN'

    def _draw_host_net_badge(self):
        """Top-right link badge for both roles: transport, state and latency."""
        lang = self.settings.language
        sf = get_font(lang, 'regular', 13)
        tag = "1v1" if self.mode == '1v1' else get_text(lang, 'coop_label')
        state = self.link_state()
        if state == 'connected':
            colour = (80, 255, 80)
            status = f"● {get_text(lang, 'connected_label')}"
            if self.latency_ms is not None:
                status += f" · {self.latency_ms} ms"
        elif state == 'unstable':
            colour = (255, 200, 80)
            status = f"● {_net_ui_text(lang, 'link_unstable')}"
        else:
            colour = (255, 80, 80)
            status = f"✕ {get_text(lang, 'disconnected_label')}"
        s = sf.render(f"[{self._link_label()} {tag}] {status}", True, colour)
        self.screen.blit(s, (self.screen.get_width() - s.get_width() - 8, 44))

    def _draw_conn_lost(self):
        """Full-screen state for a link that is gone, being resumed, or ended."""
        _draw_link_overlay(self.screen, self.settings, self)

    def _drain_network_messages(self):
        """Apply up to 16 queued peer messages (shared by run() and tests)."""
        for _message_budget in range(16):
            try:
                msg = self._recv_q.get_nowait()
            except _queue_mod.Empty:
                break
            if not isinstance(msg, dict):
                self.connected = False
                self.disconnect_reason = 'protocol_error'
                break
            outcome = self._handle_link_message(msg)
            if outcome == 'handled':
                continue
            if outcome == 'stop':
                break
            t = msg.get('t')
            if self.is_host:
                if t in ('pause_req', 'resume_req'):
                    self._pause_window_start, self._pause_window_count, _rate_ok = _network_rate_window(
                        self._pause_window_start, self._pause_window_count,
                        time.monotonic(), limit=4)
                    if not _rate_ok:
                        self.connected = False
                        self.disconnect_reason = 'pause_rate_limit'
                        self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason})
                        break
                elif t == 'restart_req':
                    self._restart_window_start, self._restart_window_count, _rate_ok = _network_rate_window(
                        self._restart_window_start, self._restart_window_count,
                        time.monotonic(), limit=2)
                    if not _rate_ok:
                        self.connected = False
                        self.disconnect_reason = 'restart_rate_limit'
                        self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason})
                        break
                if t == 'pause_req':
                    if not self.mp.game_over and not self.mp.paused:
                        self.mp.paused = True
                        if getattr(self, 'runtime', None) is not None:
                            self.runtime.set_game_paused(True, {'game': 'network'})
                elif t == 'resume_req':
                    if not self.mp.game_over and self.mp.paused:
                        self.mp.paused = False
                        if getattr(self, 'runtime', None) is not None:
                            self.runtime.set_game_paused(False, {'game': 'network'})
                elif t == 'input':
                    now = time.monotonic()
                    if now - self._input_window_start >= 1.0:
                        self._input_window_start = now
                        self._input_window_count = 0
                    self._input_window_count += 1
                    if self._input_window_count > 120:
                        self.connected = False
                        self.disconnect_reason = 'input_rate_limit'
                        self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason})
                        break
                    d = msg.get('d')
                    if _validate_net_direction(d):
                        self._apply_client_input(d)
                    else:
                        self.connected = False
                        self.disconnect_reason = 'protocol_error'
                        self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason, 'detail': 'invalid direction payload'})
                        break
                elif t == 'restart_req' and self.mp.game_over:
                    self.mp.reset()
                    self._mp_saved = False
                    if self.connected:
                        try:
                            self._send_safe({'t': 'restart'})
                        except OSError:
                            self.connected = False
                        except Exception as _e:
                            print(f"[network] unexpected error sending restart: {_e}")
                            self.connected = False
                elif t not in ('restart_req', 'pause_req'):
                    self.connected = False
                    self.disconnect_reason = 'protocol_error'
                    self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason, 'detail': 'unexpected message for host'})
                    break
            else:
                if t == 'state':
                    if not _validate_net_state_message(msg):
                        self.connected = False
                        self.disconnect_reason = 'protocol_error'
                        print('[network] rejected invalid state payload from host')
                        break
                    previous_state = self.render_state
                    old_score = None
                    new_score = (msg.get('s1', 0) + msg.get('s2', 0)
                                 if self.mode == 'coop' else msg.get('s2', 0))
                    if previous_state is not None:
                        old_score = (previous_state.get('s1', 0) + previous_state.get('s2', 0)
                                     if self.mode == 'coop' else previous_state.get('s2', 0))
                        if new_score > old_score:
                            _trigger_mobile_haptic(30)
                        if msg.get('go') and not previous_state.get('go'):
                            _trigger_mobile_haptic(90)
                    elif msg.get('go'):
                        _trigger_mobile_haptic(90)
                    self.render_state = msg
                    # Record this frame using the host's exact authoritative
                    # snapshot — not a client-side reconstruction — so both
                    # peers end up with the identical replay record for
                    # this match (same fruit types, directions, everything).
                    rec = self._client_recorder
                    rec.board_width  = msg.get('bw', rec.board_width)
                    rec.board_height = msg.get('bh', rec.board_height)
                    rec.seed = msg.get('seed', rec.seed)
                    snap = msg.get('snap')
                    if snap and (not rec.mp_history or rec.mp_history[-1] != snap):
                        _append_mp_replay_snapshot(rec, snap)
                    # Keep a few fields mirrored on rec itself too, in case
                    # save_match() or anything else reads current state
                    # directly rather than through mp_history.
                    rec.p1_score  = msg.get('s1', 0)
                    rec.p2_score  = msg.get('s2', 0)
                    if old_score is not None and new_score > old_score:
                        _track_game_fruit(rec, previous_state.get('ft', 'regular'))
                    rec._sgf_xp_score_override = (
                        new_score if self.mode == 'coop' else msg.get('s2', 0))
                    rec._sgf_xp_victory_override = (
                        msg.get('w') == 'coop_win' if self.mode == 'coop'
                        else msg.get('w') == 2)
                    rec.game_over = msg.get('go', False)
                    rec.winner    = msg.get('w')
                elif t == 'restart':
                    self.render_state = None
                    self._client_recorder.mp_history = []
                    self._client_recorder._mp_history_position_samples = 0
                    self._client_recorder._mp_history_truncated = False
                    _clear_game_xp_award(self._client_recorder)
                    self._client_recorder.fruits_eaten = 0
                    self._client_recorder.unique_fruits_collected = set()
                    self._client_recorder._sgf_xp_score_override = 0
                    self._client_recorder._sgf_xp_victory_override = False
                    self._mp_saved = False
                elif t == 'lan_leaderboard':
                    if not _validate_lan_leaderboard_message(msg):
                        self.connected = False
                        self.disconnect_reason = 'protocol_error'
                        self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason,
                                               'detail': 'invalid LAN leaderboard payload'})
                        break
                    _merge_lan_leaderboard(msg['entries'])
                else:
                    self.connected = False
                    self.disconnect_reason = 'protocol_error'
                    self._queue_net_event({'t': 'disconnect', 'reason': self.disconnect_reason, 'detail': 'unexpected message for client'})
                    break

    # ── main loop ────────────────────────────────────────────────────────

    def run(self):
        running = True
        clock   = pygame.time.Clock()

        while running:
            _pump_audio()
            frame_start = time.perf_counter()
            input_start = frame_start
            self._drain_network_messages()
            self._service_link()

            # Connection-lost screen
            if not self.connected:
                self._draw_conn_lost()
                _legacy_nav_draw(locals().get('self'))
                pygame.display.flip()
                for event in pygame.event.get():
                    if _legacy_nav_event(locals().get('self'), event, locals()):
                        continue
                    if getattr(self, 'runtime', None) is not None:
                        handled, _actions = self.runtime.input.route(event)
                        if handled:
                            continue
                    if event.type == pygame.QUIT:
                        running = False
                    elif event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                        running = False
                clock.tick(30)
                continue

            # Event handling
            for event in pygame.event.get():
                if _legacy_nav_event(locals().get('self'), event, locals()):
                    continue
                if _is_app_background_event(event):
                    if self.is_host:
                        if not self.mp.game_over:
                            self.mp.paused = True
                            if getattr(self, 'runtime', None) is not None:
                                self.runtime.set_game_paused(True, {'game': 'network'})
                    elif not (self.render_state and self.render_state.get('go')):
                        self._send_safe({'t': 'pause_req'})
                    continue
                if getattr(self, 'runtime', None) is not None:
                    handled, _actions = self.runtime.input.route(event)
                    if handled:
                        continue
                if event.type == pygame.QUIT:
                    running = False
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F8 and DEV_TOOLS.unlocked:
                        target_game = getattr(self, 'mp', None) or getattr(self, '_client_recorder', None) or self
                        DEV_TOOLS.open_panel(self.screen, target_game)
                        continue
                    k = event.key
                    if k == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif k == pygame.K_ESCAPE:
                        running = False
                    elif k == pygame.K_r:
                        if self.is_host and self.mp.game_over:
                            self.mp.reset()
                            try:
                                self._send_safe({'t': 'restart'})
                            except OSError:
                                self.connected = False
                            except Exception as _e:
                                print(f"[network] unexpected error sending restart: {_e}")
                                self.connected = False
                        elif not self.is_host:
                            try:
                                self._send_safe({'t': 'restart_req'})
                            except OSError:
                                self.connected = False
                            except Exception as _e:
                                print(f"[network] unexpected error sending restart_req: {_e}")
                                self.connected = False
                    elif k == pygame.K_p and self.is_host and not self.mp.game_over:
                        self.mp.paused = not self.mp.paused
                        if getattr(self, 'runtime', None) is not None:
                            self.runtime.set_game_paused(self.mp.paused, {'game': 'network'})
                    elif (k == pygame.K_p and not self.is_host and self.render_state
                          and self.render_state.get('pa') and not self.render_state.get('go')):
                        self._send_safe({'t': 'resume_req'})
                    elif self.is_host and not self.mp.game_over and not self.mp.paused:
                        self._host_key(k)
                    elif not self.is_host:
                        go = self.render_state.get('go') if self.render_state else False
                        if not go:
                            self._client_key(k)
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode(
                        (event.w, event.h), pygame.RESIZABLE)
                    if self.is_host:
                        self.mp._init_layout()

            # Host: tick + send state
            if self.is_host:
                now = time.time() * 1000
                if not self.mp.paused and not self.mp.game_over:
                    if now - self.mp.last_tick >= DEV_TOOLS.scaled_update_interval(self.settings.update_rate_ms):
                        DEV_TOOLS.apply_frame_cheats(self.mp)
                        self.mp.tick()
                        self.mp.last_tick = now
                # Send state every frame so the client stays fresh
                if self.connected:
                    if not self._initial_board_sent:
                        self._initial_board_sent = self._send_safe({
                            't': 'lan_leaderboard', 'entries': _lan_leaderboard_snapshot()})
                    self._send_safe(self._state_dict())

                self.mp.draw()
                self._draw_host_net_badge()
            else:
                self._draw_client()
                self._draw_host_net_badge()

            # Persist the match locally on whichever peer sees game-over
            if not self._mp_saved:
                if self.is_host and self.mp.game_over:
                    self.mp.save_match(p1_name='Host', p2_name='Client', source='lan_host')
                    self._mp_saved = True
                    self._send_safe({'t': 'lan_leaderboard', 'entries': _lan_leaderboard_snapshot()})
                elif (not self.is_host) and self.render_state and self.render_state.get('go'):
                    self._client_recorder.save_match(
                        p1_name='Host', p2_name='You', source='lan_client')
                    self._mp_saved = True

            _legacy_nav_draw(locals().get('self'))
            render_start = time.perf_counter()
            # The game draw/client draw already happened above.  Render time here
            # intentionally measures only the DEV overlay/flip bookkeeping.
            DEV_TOOLS.draw_dev_indicator(self.screen, replay=False)
            render_ms = (time.perf_counter() - render_start) * 1000.0
            frame_ms = clock.tick(60)
            input_ms = (time.perf_counter() - input_start) * 1000.0
            target = self.mp if self.is_host else self._client_recorder
            _dev_game_frame_hook(target, frame_ms, render_ms=render_ms, input_ms=input_ms)
            pygame.display.flip()

        # Cleanup: stop receiver and close the socket cleanly so daemon threads
        # cannot outlive the game screen or keep a launcher process alive.
        self.close()
        _runtime_emit(self, 'NETWORK_DISCONNECTED', {'reason': self.disconnect_reason or 'local_exit'})


##############
# NETWORK MATCH FOR 3-4 PLAYERS
##############
class _PeerLink(_NetworkLinkMixin):
    """Link to one remote player of a multi-player session."""

    def __init__(self, conn, is_host, session=None):
        self._init_link(conn, is_host, session)

    def _poll_resume_listeners(self, now):
        return   # the match admits returning guests for every slot at once


_DIRECTION_NAMES = {(0, -1): 'up', (0, 1): 'down', (-1, 0): 'left', (1, 0): 'right'}
_KEY_DIRECTIONS = {
    pygame.K_w: (0, -1), pygame.K_UP: (0, -1), pygame.K_s: (0, 1), pygame.K_DOWN: (0, 1),
    pygame.K_a: (-1, 0), pygame.K_LEFT: (-1, 0), pygame.K_d: (1, 0), pygame.K_RIGHT: (1, 0),
}


class NetworkMatchN:
    """Network match for 3-4 players.

    The host runs the authoritative LocalMultiplayerNGame; every guest owns one
    link to the host, sends only its direction and draws the snapshots it
    receives with the very same engine (snapshots are validated by the engine's
    own loader). A guest that drops gets the same 30 s resume window as in a
    two-player match; the match pauses meanwhile, and a guest that does not
    return (or leaves on purpose) is eliminated while the others play on.
    """
    SEND_KEEPALIVE_SECONDS = 0.25
    MAX_RECORDED_FRAMES = 24000

    def __init__(self, settings, screen, is_host, mode, seed, custom_map, names,
                 you=0, links=None, link=None, tunnel_session=None, session=None):
        self.settings = settings
        self.screen = screen
        self.is_host = is_host
        self.mode = 'coop' if mode == 'coop' else '1v1'
        self.seed = seed if seed else generate_seed()
        self.custom_map = custom_map
        self.names = [_clean_player_name(name, f'Player {i + 1}') for i, name in enumerate(names)][:4]
        self.count = len(self.names)
        self.you = int(you)
        self.tunnel_session = tunnel_session if is_host else None
        self._session = session if isinstance(session, dict) else None
        self.links = list(links or [])           # host: slot i + 1 -> links[i]
        self.link = link                         # guest: the link to the host
        self.engine = LocalMultiplayerNGame(
            settings, screen, self.mode, player_count=self.count,
            player_configs=[{'name': name} for name in self.names],
            seed=self.seed, custom_map=custom_map)
        self.engine.save_source = 'lan_host' if is_host else 'lan_client'
        self.runtime = None
        self.slot_state = ['ok'] * self.count     # host's view of every slot
        self.guest_status = ['ok'] * self.count   # what the host last told a guest
        self._last_sent = (-1, None, None)
        self._last_send_time = 0.0
        self._resume_results = _queue_mod.Queue()
        self._resume_pending = False
        self._next_poll = 0.0
        self._cancel = threading.Event()
        self._recorded = 1
        self._saved = False
        self._closed = False
        if is_host:
            for slot, peer in enumerate(self.links, start=1):
                peer._session = {'slot': slot}   # marks the link as resumable
        if 'DEV_TOOLS' in globals():
            DEV_TOOLS.register_game(self.engine)

    # -- state shared by both roles ------------------------------------------

    def connected_players(self):
        if self.is_host:
            return 1 + sum(1 for state in self.slot_state[1:] if state == 'ok')
        return sum(1 for state in self.guest_status if state == 'ok')

    def waiting_names(self):
        states = self.slot_state if self.is_host else self.guest_status
        return [self.names[i] for i, state in enumerate(states) if state == 'wait']

    def _announce_start(self):
        """Host: tell every guest the match began (its slot and the final roster)."""
        for slot, peer in enumerate(self.links, start=1):
            peer._send_safe({'t': 'nstart', 'count': self.count, 'you': slot,
                             'names': list(self.names)})

    # -- host ----------------------------------------------------------------

    def _peer_state(self, peer):
        state = peer.link_state()
        if state in ('connected', 'unstable'):
            return 'ok'
        if state in ('waiting', 'reconnecting'):
            return 'wait'
        return 'left'

    def _eliminate(self, slot):
        if self.engine.alive[slot]:
            self.engine.alive[slot] = False
        self.slot_state[slot] = 'left'

    def _apply_direction(self, slot, vector):
        name = _DIRECTION_NAMES.get(tuple(vector))
        if name and self.engine.alive[slot]:
            self.engine._request_direction(slot, name)

    def _restart(self):
        self.engine.reset()
        self.engine.save_source = 'lan_host'
        self._last_sent = (-1, None, None)
        for slot, state in enumerate(self.slot_state):
            if state == 'left':
                self.engine.alive[slot] = False

    def _drain_peer(self, slot, peer):
        for _ in range(16):
            try:
                msg = peer._recv_q.get_nowait()
            except _queue_mod.Empty:
                break
            outcome = peer._handle_link_message(msg)
            if outcome == 'handled':
                continue
            if outcome == 'stop':
                break
            kind = msg.get('t')
            if kind == 'input':
                self._apply_direction(slot, msg['d'])
            elif kind == 'pause_req' and not self.engine.game_over:
                self.engine.paused = True
            elif kind == 'resume_req' and self.engine.paused and not self.engine.game_over:
                self.engine.paused = False
            elif kind == 'restart_req' and self.engine.game_over:
                self._restart()

    def _poll_resume(self, now):
        session = self._session
        if not session or not session.get('listeners'):
            return
        try:
            result = self._resume_results.get_nowait()
        except _queue_mod.Empty:
            result = None
        if result is not None:
            self._resume_pending = False
            ok, value, slot = result
            if ok and slot is not None and 1 <= slot <= len(self.links) and self.slot_state[slot] != 'left':
                self.links[slot - 1]._adopt_connection(value)
            elif ok:
                try:
                    value.close()
                except OSError:
                    pass
        if self._resume_pending or now < self._next_poll:
            return
        self._next_poll = now + 0.2
        tokens = {slot: session['resume_tokens'][slot] for slot in range(1, self.count)
                  if self.slot_state[slot] != 'left' and slot in session.get('resume_tokens', {})}
        for listener in session['listeners']:
            try:
                raw, address = listener.accept()
            except (BlockingIOError, _socket_mod.timeout, OSError):
                continue
            peer_ip = address[0] if address else ''
            if not tokens or not _allow_network_handshake_attempt(
                    peer_ip, session.setdefault('attempts', {}), max_attempts=60):
                raw.close()
                continue
            try:
                raw.setsockopt(_socket_mod.IPPROTO_TCP, _socket_mod.TCP_NODELAY, 1)
                threading.Thread(
                    target=_finish_secure_host_resume_any,
                    args=(raw, session['tls_context'], tokens, self._resume_results, self._cancel),
                    name='SGF-secure-resume', daemon=True).start()
                self._resume_pending = True
            except Exception:
                try:
                    raw.close()
                except OSError:
                    pass
            break

    def host_step(self, now=None):
        """One host frame of networking + simulation (also driven directly by tests)."""
        now = time.monotonic() if now is None else now
        for slot, peer in enumerate(self.links, start=1):
            self._drain_peer(slot, peer)
            peer._service_link()
            state = self._peer_state(peer)
            if state == 'left' and self.slot_state[slot] != 'left':
                self._eliminate(slot)
            elif self.slot_state[slot] != 'left':
                self.slot_state[slot] = state
        self._poll_resume(now)
        waiting = any(state == 'wait' for state in self.slot_state)
        engine = self.engine
        if not (engine.paused or engine.game_over or waiting):
            wall = time.time() * 1000
            if wall - engine.last_tick >= DEV_TOOLS.scaled_update_interval(self.settings.update_rate_ms):
                DEV_TOOLS.apply_frame_cheats(engine)
                engine.tick()
                engine.last_tick = wall
        self._broadcast_state(now)

    def _broadcast_state(self, now):
        engine = self.engine
        signature = (len(engine.mp_history), engine.paused, tuple(self.slot_state))
        if signature == self._last_sent and now - self._last_send_time < self.SEND_KEEPALIVE_SECONDS:
            return
        self._last_sent = signature
        self._last_send_time = now
        message = {'t': 'nstate', 'snap': engine._mp_snap(), 'pa': engine.paused,
                   'st': list(self.slot_state)}
        for peer in self.links:
            if peer.connected:
                peer._send_safe(message)

    # -- guest ---------------------------------------------------------------

    def guest_step(self):
        link = self.link
        for _ in range(16):
            try:
                msg = link._recv_q.get_nowait()
            except _queue_mod.Empty:
                break
            outcome = link._handle_link_message(msg)
            if outcome == 'handled':
                continue
            if outcome == 'stop':
                break
            if msg.get('t') != 'nstate':
                continue
            snap = msg['snap']
            if (not isinstance(snap.get('snakes'), list) or len(snap['snakes']) != self.count
                    or not self.engine._mp_load_snap(snap)):
                link._report_disconnect(link._conn_gen, 'protocol_error', 'invalid match snapshot')
                break
            self.engine.paused = msg['pa']
            if len(msg['st']) == self.count:
                self.guest_status = list(msg['st'])
            if self._recorded < self.MAX_RECORDED_FRAMES:
                self.engine.mp_history.append(snap)
                self._recorded += 1
            if not snap.get('game_over'):
                self._saved = False
                self.engine._match_saved = False
        link._service_link()
        if self.engine.game_over and not self._saved:
            self._saved = True
            self.engine.save_match(source='lan_client')

    # -- input / drawing -----------------------------------------------------

    def _handle_key(self, key):
        vector = _KEY_DIRECTIONS.get(key)
        if vector is None:
            return
        if self.is_host:
            self._apply_direction(0, vector)
            return
        current = self.engine.directions[self.you] if self.engine.directions else (0, 0)
        if vector == (-current[0], -current[1]):
            return
        self.link._send_safe({'t': 'input', 'd': list(vector)})

    def _draw_status(self):
        lang = self.settings.language
        font = get_font(lang, 'regular', 13)
        if self.is_host:
            label = f"[{self._transport_label()} {self.count}P] ● {self.connected_players()}/{self.count}"
            colour = (80, 255, 80) if self.connected_players() == self.count else (255, 200, 80)
        else:
            state = self.link.link_state()
            if state == 'connected':
                label = f"[{self._transport_label()} {self.count}P] ● {get_text(lang, 'connected_label')}"
                if self.link.latency_ms is not None:
                    label += f" · {self.link.latency_ms} ms"
                colour = (80, 255, 80)
            elif state == 'unstable':
                label = f"[{self._transport_label()} {self.count}P] ● {_net_ui_text(lang, 'link_unstable')}"
                colour = (255, 200, 80)
            else:
                label = f"[{self._transport_label()} {self.count}P] ✕ {get_text(lang, 'disconnected_label')}"
                colour = (255, 80, 80)
        surface = font.render(label, True, colour)
        self.screen.blit(surface, (self.screen.get_width() - surface.get_width() - 8, 44))

    def _transport_label(self):
        session = self._session or {}
        relay = (self.tunnel_session is not None
                 or _is_cloudflare_quick_hostname(session.get('host', '')))
        return 'NET' if relay else 'LAN'

    def _draw_waiting(self):
        names = self.waiting_names()
        if not names:
            return
        lang = self.settings.language
        sw, sh = self.screen.get_size()
        overlay = pygame.Surface((sw, 70), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 170))
        self.screen.blit(overlay, (0, sh // 2 - 35))
        seconds = None
        if self.is_host:
            seconds = max((peer.reconnect_seconds_left() for peer in self.links
                           if peer._reconnect_state == 'host_wait'), default=None)
        text = f"{', '.join(names)} · {_net_ui_text(lang, 'waiting_player_title')}"
        if seconds is not None:
            text += f" · {seconds} s"
        surface = render_fit(get_font(lang, 'bold', 20), text, (255, 205, 110), sw - 32, padding=0)
        self.screen.blit(surface, (sw // 2 - surface.get_width() // 2, sh // 2 - surface.get_height() // 2))

    def draw(self):
        if not self.is_host and not self.link.connected:
            _draw_link_overlay(self.screen, self.settings, self.link)
            return
        self.engine.draw()
        self._draw_status()
        self._draw_waiting()

    def close(self):
        if self._closed:
            return
        self._closed = True
        self._cancel.set()
        for peer in ([self.link] if self.link is not None else []) + list(self.links):
            try:
                if peer.connected and not peer.peer_left:
                    peer._send_safe({'t': 'bye'})
            except Exception:
                pass
        flush_deadline = time.monotonic() + 0.4
        while time.monotonic() < flush_deadline and any(
                peer._send_q.unfinished_tasks > 0 and peer.connected
                for peer in ([self.link] if self.link is not None else []) + list(self.links)):
            time.sleep(0.01)
        for peer in ([self.link] if self.link is not None else []) + list(self.links):
            peer._stop_event.set()
            peer._dial_cancel.set()
            peer.connected = False
            peer._stop_io()
        session = self._session
        if session:
            for listener in session.get('listeners', []) or []:
                try:
                    listener.close()
                except OSError:
                    pass
            session['listeners'] = []
        tunnel, self.tunnel_session = self.tunnel_session, None
        if tunnel is not None:
            tunnel.stop()

    def run(self):
        clock = pygame.time.Clock()
        running = True
        while running:
            _pump_audio()
            if self.is_host:
                self.host_step()
            else:
                self.guest_step()
            for event in pygame.event.get():
                if _legacy_nav_event(locals().get('self'), event, locals()):
                    continue
                if event.type == pygame.QUIT:
                    running = False
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    self.engine.screen = self.screen
                    self.engine._init_layout()
                elif event.type == pygame.KEYDOWN:
                    key = event.key
                    if key == pygame.K_ESCAPE:
                        running = False
                    elif key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                        self.engine.screen = self.screen
                        self.engine._init_layout()
                    elif key == pygame.K_p and not self.engine.game_over:
                        if self.is_host:
                            self.engine.paused = not self.engine.paused
                        elif self.link.connected:
                            self.link._send_safe({'t': 'resume_req' if self.engine.paused else 'pause_req'})
                    elif key == pygame.K_r and self.engine.game_over:
                        if self.is_host:
                            self._restart()
                        elif self.link.connected:
                            self.link._send_safe({'t': 'restart_req'})
                    elif self.is_host and not self.engine.paused or (not self.is_host and self.link.connected):
                        self._handle_key(key)
            self.draw()
            _legacy_nav_draw(locals().get('self'))
            DEV_TOOLS.draw_dev_indicator(self.screen, replay=False)
            pygame.display.flip()
            clock.tick(60)
        self.close()
        _runtime_emit(self, 'NETWORK_DISCONNECTED', {'reason': 'local_exit'})


