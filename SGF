    # ------------------------------------------------------------------
    # REPLAY SYSTEM  – compact snapshot-based recording and playback
    # ------------------------------------------------------------------

    def _snap(self):
        """Create a compact, JSON-serialisable snapshot of the current game state.

        Format (12-element list – indices must stay stable):
          [snake, fruit_pos, fruit_type, score, direction,
           powerup_pos, powerup_type, active_pu_data, obstacles, portals,
           effect_state, fruit_value]

        active_pu_data: list of [type_str, remaining_ms]   (index 7)
        effect_state:   [speed_multiplier, points_multiplier,
                         invincible, ghost_mode, shield_active,
                         length_speed_multiplier]            (index 10)
        fruit_value:    int                                  (index 11)
        """
        current_time = time.time() * 1000
        pu_data = []
        if hasattr(self, 'active_powerups'):
            for p in self.active_powerups:
                remaining = max(0.0, p['duration'] - (current_time - p['start_time']))
                pu_data.append([p['type'], remaining])
        return [
            [list(s) for s in self.snake],                                 # 0
            list(self.fruit_position) if self.fruit_position else None,    # 1
            getattr(self, 'current_fruit_type', 'regular'),               # 2
            self.score,                                                     # 3
            list(self.direction),                                          # 4
            list(self.powerup_position) if self.powerup_position else None,# 5
            getattr(self, 'powerup_type', None),                          # 6
            pu_data,                                                        # 7 [[type, remaining_ms], ...]
            [list(o) for o in self.obstacles] if self.obstacles else [],  # 8
            [[list(p[0]), list(p[1]), p[2]] for p in self.portals]        # 9
            if self.portals else [],
            [                                                               # 10 effect_state
                getattr(self, 'speed_multiplier',        1.0),
                getattr(self, 'points_multiplier',       1.0),
                getattr(self, 'invincible',              False),
                getattr(self, 'ghost_mode',              False),
                getattr(self, 'shield_active',           False),
                getattr(self, 'length_speed_multiplier', 1.0),
            ],
            getattr(self, 'current_fruit_value', 1),                      # 11 fruit_value
        ]

    def _load_snap(self, snap):
        """Restore game state from a compact snapshot (for replay playback).

        Supports both:
          - Old format (10 elements): index 7 is a list of type strings
          - New format (12 elements): index 7 is [[type, remaining_ms], ...],
            index 10 is effect_state, index 11 is fruit_value
        """
        self.snake            = [tuple(s) for s in snap[0]]
        self.fruit_position   = tuple(snap[1]) if snap[1] else None
        self.current_fruit_type  = snap[2] if len(snap) > 2 else 'regular'
        self.score            = snap[3] if len(snap) > 3 else 0
        self.direction        = tuple(snap[4]) if len(snap) > 4 else (1, 0)
        self.next_direction   = self.direction
        self.powerup_position = tuple(snap[5]) if (len(snap) > 5 and snap[5]) else None
        self.powerup_type     = snap[6] if len(snap) > 6 else None

        # Restore active powerups with correct remaining time.
        # New format: [[type_str, remaining_ms], ...]
        # Old format: [type_str, ...]  — assume full 10 s duration for display
        current_time = time.time() * 1000
        pu_raw = snap[7] if len(snap) > 7 else []
        self.active_powerups = []
        for entry in pu_raw:
            if isinstance(entry, list):
                pu_type      = entry[0]
                remaining_ms = max(0.0, float(entry[1]))
            else:
                pu_type      = entry          # old format: bare string
                remaining_ms = 10000.0        # assume 10 s left for display
            self.active_powerups.append({
                'type':       pu_type,
                'start_time': current_time,
                'duration':   remaining_ms,
            })

        self.obstacles = [tuple(o) for o in snap[8]] \
            if len(snap) > 8 and snap[8] else []
        self.portals   = [(tuple(p[0]), tuple(p[1]), p[2]) for p in snap[9]] \
            if len(snap) > 9 and snap[9] else []

        # ── Restore effect-state flags (index 10, new format) ──────────────
        active_types = {p['type'] for p in self.active_powerups}
        if len(snap) > 10 and snap[10]:
            fx = snap[10]
            self.speed_multiplier        = float(fx[0]) if len(fx) > 0 else 1.0
            self.points_multiplier       = float(fx[1]) if len(fx) > 1 else 1.0
            self.invincible              = bool(fx[2])   if len(fx) > 2 else False
            self.ghost_mode              = bool(fx[3])   if len(fx) > 3 else False
            self.shield_active           = bool(fx[4])   if len(fx) > 4 else False
            self.length_speed_multiplier = float(fx[5]) if len(fx) > 5 else 1.0
        else:
            # Old format — derive best-guess effect state from active types
            if 'speed_boost' in active_types:
                self.speed_multiplier = 0.5
            elif 'slow_motion' in active_types:
                self.speed_multiplier = 2.0
            else:
                self.speed_multiplier = 1.0
            self.points_multiplier       = 2.0 if 'double_points'  in active_types else 1.0
            self.invincible              = 'invincibility' in active_types
            self.ghost_mode              = 'ghost_mode'    in active_types
            self.shield_active           = 'shield'        in active_types
            self.length_speed_multiplier = 1.0

        # ── Fruit value (index 11, new format) ────────────────────────────
        self.current_fruit_value = snap[11] if len(snap) > 11 else 1

        self.game_over = False
        self.victory   = False

    def start_replay(self, game_history):
        """Enter replay mode from a saved list of compact snapshots."""
        if not game_history:
            return False
        self.replay_mode  = True
        self.game_history = game_history
        self.replay_index = 0
        self.replay_speed = 1.0
        self.paused       = False
        self._replay_ended = False
        self._replay_ctrl_rects = {}
        self._load_snap(self.game_history[0])
        return True

    def replay_next_frame(self):
        """Advance replay by one frame. Returns False when at the last frame."""
        if not self.replay_mode or self.replay_index >= len(self.game_history) - 1:
            return False
        # Remember which powerup types are active before we advance
        prev_types = {p['type'] for p in self.active_powerups}
        self.replay_index += 1
        self._load_snap(self.game_history[self.replay_index])
        # Play the powerup sound for any powerup that newly appeared this frame
        new_types = {p['type'] for p in self.active_powerups}
        if new_types - prev_types:
            sounds().play('powerup')
        return True

    def _replay_step_back(self, steps=1):
        """Step back N frames in the replay."""
        self.replay_index = max(0, self.replay_index - steps)
        self._load_snap(self.game_history[self.replay_index])

    def _replay_seek(self, fraction):
        """Jump to a position in the replay (fraction 0.0–1.0)."""
        if not self.game_history:
            return
        idx = int(fraction * (len(self.game_history) - 1))
        self.replay_index = max(0, min(len(self.game_history) - 1, idx))
        self._load_snap(self.game_history[self.replay_index])
        self._replay_ended = (self.replay_index >= len(self.game_history) - 1)

    def replay_handle_click(self, pos):
        """Handle a mouse click on the replay control panel."""
        if not self.replay_mode or not hasattr(self, '_replay_ctrl_rects'):
            return False
        rects = self._replay_ctrl_rects

        if 'scrubber_track' in rects and rects['scrubber_track'].collidepoint(pos):
            track = rects['scrubber_track']
            frac  = max(0.0, min(1.0, (pos[0] - track.x) / max(1, track.width)))
            self._replay_seek(frac)
            self._replay_ended = (self.replay_index >= len(self.game_history) - 1)
            return True

        if 'restart' in rects and rects['restart'].collidepoint(pos):
            self.replay_index  = 0
            self.paused        = False
            self._replay_ended = False
            self._load_snap(self.game_history[0])
            return True

        if 'rewind' in rects and rects['rewind'].collidepoint(pos):
            steps = max(1, len(self.game_history) // 10)
            self._replay_step_back(steps)
            self._replay_ended = False
            return True

        if 'play_pause' in rects and rects['play_pause'].collidepoint(pos):
            if self._replay_ended:
                self.replay_index  = 0
                self.paused        = False
                self._replay_ended = False
                self._load_snap(self.game_history[0])
            else:
                self.paused = not self.paused
            return True

        if 'ff' in rects and rects['ff'].collidepoint(pos):
            steps = max(1, len(self.game_history) // 10)
            self.replay_index = min(len(self.game_history) - 1,
                                    self.replay_index + steps)
            self._load_snap(self.game_history[self.replay_index])
            self._replay_ended = (self.replay_index >= len(self.game_history) - 1)
            return True

        for spd in [0.5, 1.0, 2.0, 4.0]:
            key = f'speed_{spd}'
            if key in rects and rects[key].collidepoint(pos):
                self.replay_speed = spd
                return True

        if 'exit' in rects and rects['exit'].collidepoint(pos):
            self._replay_exit_requested = True
            return True

        return False

    def replay_control(self, event):
        """Handle keyboard shortcuts while in replay mode."""
        if not self.replay_mode or event.type != pygame.KEYDOWN:
            return
        k = event.key
        if k == pygame.K_SPACE:
            if self._replay_ended:
                self.replay_index  = 0
                self.paused        = False
                self._replay_ended = False
                self._load_snap(self.game_history[0])
            else:
                self.paused = not self.paused
        elif k == pygame.K_RIGHT:
            steps = max(1, len(self.game_history) // 10)
            self.replay_index = min(len(self.game_history) - 1,
                                    self.replay_index + steps)
            self._load_snap(self.game_history[self.replay_index])
            self._replay_ended = (self.replay_index >= len(self.game_history) - 1)
        elif k == pygame.K_LEFT:
            steps = max(1, len(self.game_history) // 10)
            self._replay_step_back(steps)
            self._replay_ended = False
        elif k == pygame.K_r:
            self.replay_index  = 0
            self.paused        = False
            self._replay_ended = False
            self._load_snap(self.game_history[0])
        elif k == pygame.K_ESCAPE:
            self._replay_exit_requested = True

    def draw_replay_controls(self):
        """Draw the full replay control panel overlaid at the bottom of the screen."""
        if not self.replay_mode:
            return

        sw, sh   = self.screen.get_width(), self.screen.get_height()
        panel_h  = 115
        panel_y  = sh - panel_h

        # ── semi-transparent panel background ──────────────────────────────
        overlay = pygame.Surface((sw, panel_h), pygame.SRCALPHA)
        overlay.fill((8, 12, 28, 215))
        self.screen.blit(overlay, (0, panel_y))
        pygame.draw.line(self.screen, (50, 90, 155), (0, panel_y), (sw, panel_y), 2)

        # ── "REPLAY" badge top-left corner ─────────────────────────────────
        badge_font = get_font(self.settings.language, 'bold', 13)
        badge_surf = badge_font.render("  ● REC REPLAY  ", True, (255, 80, 80))
        badge_bg   = pygame.Rect(8, 8, badge_surf.get_width() + 6, badge_surf.get_height() + 4)
        pygame.draw.rect(self.screen, (60, 10, 10), badge_bg, border_radius=4)
        pygame.draw.rect(self.screen, (180, 40, 40), badge_bg, width=1, border_radius=4)
        self.screen.blit(badge_surf, (badge_bg.x + 3, badge_bg.y + 2))

        # ── scrubber / progress bar ─────────────────────────────────────────
        margin   = 16
        track_y  = panel_y + 10
        track_h  = 14
        track    = pygame.Rect(margin, track_y, sw - margin * 2, track_h)
        pygame.draw.rect(self.screen, (30, 45, 75), track, border_radius=7)

        total    = max(1, len(self.game_history) - 1)
        filled_w = int((self.replay_index / total) * track.width)
        if filled_w > 0:
            pygame.draw.rect(self.screen, (50, 120, 210),
                             pygame.Rect(track.x, track.y, filled_w, track_h),
                             border_radius=7)
        thumb_x = track.x + filled_w
        pygame.draw.circle(self.screen, (100, 170, 255), (thumb_x, track.centery), 9)
        pygame.draw.circle(self.screen, (210, 235, 255), (thumb_x, track.centery), 5)

        # ── control buttons ─────────────────────────────────────────────────
        btn_y   = panel_y + 33
        btn_h   = 36
        btn_fnt = get_font(self.settings.language, 'bold', 14)
        rects   = {'scrubber_track': track}

        def _btn(label, x, w, bg=(28, 55, 100), fg=(210, 230, 255)):
            r = pygame.Rect(x, btn_y, w, btn_h)
            pygame.draw.rect(self.screen, bg, r, border_radius=6)
            pygame.draw.rect(self.screen, (70, 120, 195), r, width=1, border_radius=6)
            s = btn_fnt.render(label, True, fg)
            self.screen.blit(s, (r.centerx - s.get_width() // 2,
                                 r.centery - s.get_height() // 2))
