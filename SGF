class SettingsScreen:
    def __init__(self, settings, screen):
        self.settings = settings
        self.screen = screen
        self.temp_settings = None  # For storing temporary settings changes
        self.refresh_input_active = False
        self.refresh_input_text = ""  # Will be set in run()
        self.board_size_input_active = False
        self.board_size_input_text = ""  # Will be set in run()
        
        # Track current settings page (0: General, 1: Colors, 2: Powerups, 3: Fruits, 4: Gameplay, 5: Sound)
        self.current_page = 0  # Default to General settings page
        self.page_names = ["general", "colors", "powerups", "fruits", "gameplay", "sound"]

        # Slider drag state — lets sliders be dragged continuously (hold +
        # move) rather than only jumping to value on a single click.
        self._active_slider = None       # key into `controls`, or None
        self._active_slider_range = (0, 1)

    def _slider_value_at(self, controls, key, mouse_x, min_val, max_val):
        """Compute the slider value for a given mouse x position, clamped to
        the slider's own rect (shared by click-to-jump and drag-to-follow)."""
        rect = controls.get(key)
        if not rect or rect.width == 0:
            return None
        percentage = max(0, min(1, (mouse_x - rect.x) / rect.width))
        return int(round(min_val + percentage * (max_val - min_val)))
        
    def create_text_input(self, rect, value, label, is_active=False, input_type="refresh_rate"):
        """Create and render a text input field for numeric values"""
        # Draw label
        font = get_font(self.settings.language, 'regular', 20)
        text_surface = font.render(label, True, COLORS['white'])
        self.screen.blit(text_surface, (rect.x, rect.y - 30))
        
        # Draw input box with highlight if active
        box_color = COLORS['light_gray'] if is_active else COLORS['gray']
        pygame.draw.rect(self.screen, box_color, rect, border_radius=5)
        
        # Choose which input field we're working with
        if input_type == "refresh_rate":
            # For refresh rate input field
            if self.refresh_input_active or is_active:
                display_text = self.refresh_input_text
            else:
                display_text = str(value)
                
            # Add "ms" suffix for refresh rate
            display_text_with_suffix = f"{display_text} ms" if display_text else "ms"
        else:  # board_size
            # For board size input field
            if self.board_size_input_active or is_active:
                display_text = self.board_size_input_text
            else:
                display_text = str(value)
                
            # Display text as simple number
            display_text_with_suffix = display_text
            
        # Render text
        text_font = get_font(self.settings.language, 'regular', 20)
        text_color = COLORS['black']
        text_surface = text_font.render(display_text_with_suffix, True, text_color)
        
        # Center text in input box
        text_x = rect.x + (rect.width - text_surface.get_width()) // 2
        text_y = rect.y + (rect.height - text_surface.get_height()) // 2
        self.screen.blit(text_surface, (text_x, text_y))
        
        # Draw a helpful guide based on input type (single line, kept short so
        # rows have a small, predictable footprint and never bleed into the
        # next control).
        guide_font = get_font(self.settings.language, 'regular', 16)

        if input_type == "refresh_rate":
            guide_text = "Suggested: 16ms (60fps) – 1000ms (very slow). Range: 1–10000ms."
        else:  # board_size
            guide_text = "Suggested: 10 (easy) – 80 (extreme). Range: 3–100."

        guide_surface = guide_font.render(guide_text, True, COLORS['light_gray'])
        guide_x = rect.x
        guide_y = rect.y + rect.height + 8
        self.screen.blit(guide_surface, (guide_x, guide_y))
        
        return rect
        
    def create_button(self, rect, text, color=COLORS['button']):
        """Create and render a button control"""
        pygame.draw.rect(self.screen, color, rect, border_radius=10)
        
        font = get_font(self.settings.language, 'bold', 18)
        text_surface = font.render(text, True, COLORS['white'])
        text_rect = text_surface.get_rect(center=rect.center)
        self.screen.blit(text_surface, text_rect)
        
        return rect
        
    def create_dropdown(self, rect, options, selected_index, label):
        """Create and render a dropdown control"""
        # Draw label
        font = get_font(self.settings.language, 'regular', 18)
        text_surface = font.render(label, True, COLORS['white'])
        self.screen.blit(text_surface, (rect.x, rect.y - 30))
        
        # Draw dropdown
        pygame.draw.rect(self.screen, COLORS['dropdown'], rect, border_radius=5)
        
        # Draw selected option
        text_surface = font.render(options[selected_index], True, COLORS['white'])
        text_rect = text_surface.get_rect(center=rect.center)
        self.screen.blit(text_surface, text_rect)
        
        # Draw dropdown arrow
        arrow_points = [
            (rect.x + rect.width - 20, rect.y + rect.height // 2 - 5),
            (rect.x + rect.width - 10, rect.y + rect.height // 2 + 5),
            (rect.x + rect.width - 30, rect.y + rect.height // 2 + 5)
        ]
        pygame.draw.polygon(self.screen, COLORS['white'], arrow_points)
        
        return rect
        
    def create_checkbox(self, rect, checked, label):
        """Create and render a checkbox control with label"""
        # Draw label
        font = get_font(self.settings.language, 'regular', 20)
        text_surface = font.render(label, True, COLORS['white'])
        
        # Create checkbox rect
        checkbox_size = 24
        checkbox_rect = pygame.Rect(rect.x, rect.y, checkbox_size, checkbox_size)
        
        # Draw checkbox border
        pygame.draw.rect(self.screen, COLORS['white'], checkbox_rect, border_radius=5, width=2)
        
        # Fill checkbox if checked
        if checked:
            inner_rect = pygame.Rect(checkbox_rect.x + 4, checkbox_rect.y + 4, 
                                     checkbox_rect.width - 8, checkbox_rect.height - 8)
            pygame.draw.rect(self.screen, COLORS['light_blue'], inner_rect, border_radius=3)
            
        # Draw label next to checkbox
        self.screen.blit(text_surface, (checkbox_rect.right + 10, checkbox_rect.y + checkbox_rect.height//2 - text_surface.get_height()//2))
        
        return checkbox_rect
    
    def create_slider(self, rect, min_value, max_value, current_value, label, color=None):
        """Create and render a slider control"""
        if color is None:
            color = COLORS.get('slider', (60, 180, 120))
            
        # Draw label and current value
        font = get_font(self.settings.language, 'regular', 18)
        text_surface = font.render(f"{label}: {current_value}", True, COLORS['white'])
        self.screen.blit(text_surface, (rect.x, rect.y - 24))
        
        # Draw slider track
        track_height = 8
        track_rect = pygame.Rect(
            rect.x,
            rect.y + (rect.height - track_height) // 2,
            rect.width,
            track_height
        )
        pygame.draw.rect(self.screen, COLORS.get('slider_track', (60, 70, 100)), track_rect, border_radius=4)
        
        # Calculate handle position
        if max_value == min_value:  # Avoid division by zero
            handle_pos = rect.x
        else:
            handle_pos = rect.x + ((current_value - min_value) / (max_value - min_value)) * rect.width
            
        # Draw handle
        handle_size = 20
        handle_rect = pygame.Rect(
            int(handle_pos - handle_size // 2),
            rect.y + (rect.height - handle_size) // 2,
            handle_size,
            handle_size
        )
        pygame.draw.rect(self.screen, color, handle_rect, border_radius=handle_size//2)
        
        # Draw min and max values
        small_font = get_font(self.settings.language, 'regular', 16)
        min_text = small_font.render(str(min_value), True, COLORS['light_gray'])
        max_text = small_font.render(str(max_value), True, COLORS['light_gray'])
        
        self.screen.blit(min_text, (rect.x, rect.y + rect.height + 3))
        self.screen.blit(max_text, (rect.x + rect.width - max_text.get_width(), rect.y + rect.height + 3))
        
        return rect
        
    def draw_general_settings(self, screen_width, screen_height, margin_x, content_width, start_y, spacing, controls, language_dropdown_open):
        """Draw the general settings page"""
        # Row gaps sized to what each control actually draws below itself:
        # a text input has a label above (30px) + box + one guide line below,
        # a dropdown/checkbox has just a label/box with nothing below. Using
        # a uniform "spacing" for all rows caused later rows to overlap the
        # taller ones (labels landing on top of the previous guide text).
        box_h = int(screen_height * 0.05)
        gap_after_text_input = box_h + 8 + 16 + 10 + 30  # box + guide gap + guide line + buffer + next label offset
        gap_after_dropdown = box_h + 10 + 30             # box + buffer + next label offset

        update_rate_y = start_y
        language_y = update_rate_y + gap_after_text_input
        board_size_y = language_y + gap_after_dropdown
        wall_collision_y = board_size_y + gap_after_text_input
        
        # Store these values as instance variables for reuse
        self.update_rate_y = update_rate_y
        self.language_y = language_y
        self.board_size_y = board_size_y
        self.wall_collision_y = wall_collision_y
        
        # Update rate text input field (milliseconds)
        update_rate_rect = pygame.Rect(margin_x, update_rate_y, content_width, int(screen_height * 0.05))
        controls['update_rate_input'] = self.create_text_input(
            update_rate_rect, 
            self.temp_settings.update_rate_ms, 
            get_text(self.settings.language, 'update_rate'),
            self.refresh_input_active
        )
        
        # Language dropdown
        language_options = [LANGUAGES[code]['native_name'] for code in sorted(LANGUAGES.keys())]
        try:
            language_index = sorted(LANGUAGES.keys()).index(self.temp_settings.language)
        except ValueError:
            # If language not found in list, default to English
            language_index = sorted(LANGUAGES.keys()).index('en')
            self.temp_settings.language = 'en'
            
        language_rect = pygame.Rect(margin_x, language_y, content_width, int(screen_height * 0.05))
        controls['language_dropdown'] = self.create_dropdown(
            language_rect, 
            language_options, 
            language_index, 
            get_text(self.settings.language, 'language')
        )
        
        # Define scroll offsets for dropdowns (static variables through attributes)
        if not hasattr(self, 'language_scroll_offset'):
            self.language_scroll_offset = 0
        if not hasattr(self, 'board_size_scroll_offset'):
            self.board_size_scroll_offset = 0

        # Board size and wall collision are always drawn BEFORE the open dropdown
        # so the dropdown overlays them correctly (correct z-order).
        board_size_rect = pygame.Rect(margin_x, board_size_y, content_width, int(screen_height * 0.05))
        controls['board_size_input'] = self.create_text_input(
            board_size_rect,
            self.temp_settings.board_size,
            get_text(self.settings.language, 'board_size'),
            self.board_size_input_active,
            input_type="board_size"
        )

        wall_collision_rect = pygame.Rect(margin_x, wall_collision_y, 24, 24)
        controls['wall_collision'] = self.create_checkbox(
            wall_collision_rect,
            self.temp_settings.wall_collision,
            get_text(self.settings.language, 'wall_collision')
        )

        # Show language options LAST so they render on top of everything below
        if language_dropdown_open:
            controls['language_options'], controls['language_scrollbar'], self.language_scroll_offset = self.show_dropdown_options(
                language_rect,
                language_options,
                language_index,
                language_dropdown_open,
                self.language_scroll_offset
            )
        else:
            controls['language_options'] = []
            controls['language_scrollbar'] = None

        # Return the updated controls
        return controls
        
