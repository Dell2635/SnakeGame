class ScrollBar:
    """A scrollable interface component with smooth scrolling.

    Backward compatible with the original API (rect / content_height /
    scroll_offset / target_scroll / max_scroll / handle_event / update / draw /
    get_content_offset). Extended for the UI foundation:

      * `wheel_rect`     region that captures the mouse wheel (defaults to `rect`;
                         previously the wheel only worked over the thin bar itself)
      * set_geometry() / set_content_height()   re-fit without re-creating the bar
                         (keeps the scroll position; clamps to the new max)
      * scroll_by / scroll_to / page / home / end / ensure_visible
      * handle_key(action)   semantic-action keyboard scrolling
      * handle_event(event, mouse_pos=None)   explicit position (testable, no global state)
      * track click centres the thumb on the click; drag uses event.pos; no
        divide-by-zero on very short tracks
      * update(dt=None)  optional dt makes the easing frame-rate independent
    """
    def __init__(self, x, y, width, height, content_height):
        self.rect = pygame.Rect(x, y, width, height)
        self.content_height = content_height
        self.scroll_offset = 0
        self.max_scroll = max(0, content_height - height)

        # Scrollbar appearance
        self.bar_width = 12
        self.bar_rect = pygame.Rect(x + width - self.bar_width, y, self.bar_width, height)
        self.track_color = COLORS.get('scrollbar_track', (40, 40, 50))
        self.thumb_color = COLORS.get('scrollbar_thumb', (80, 80, 100))
        self.thumb_hover_color = COLORS.get('scrollbar_thumb_hover', (100, 100, 120))

        # Scrollbar state
        self.dragging = False
        self.hover = False
        self.last_mouse_y = 0
        self._grab_dy = 0

        # Smooth scrolling
        self.target_scroll = 0
        self.scroll_speed = 0.15

        # Extensions
        self.wheel_rect = None          # None -> self.rect
        self.line_step = UI_STYLE['scroll_line']

    # ── geometry / bounds ────────────────────────────────────────────────
    def _clamp(self, v):
        return max(0, min(self.max_scroll, v))

    def set_geometry(self, x, y, width, height):
        self.rect = pygame.Rect(x, y, width, height)
        self.bar_rect = pygame.Rect(x + width - self.bar_width, y, self.bar_width, height)
        self._refresh_bounds()

    def set_content_height(self, content_height):
        self.content_height = max(0, int(content_height))
        self._refresh_bounds()

    def _refresh_bounds(self):
        self.max_scroll = max(0, self.content_height - self.rect.height)
        self.target_scroll = self._clamp(self.target_scroll)
        self.scroll_offset = self._clamp(self.scroll_offset)

    @property
    def needs_scroll(self):
        # Some legacy screens update content_height directly. Refresh here so
        # visibility/max-scroll/thumb geometry always follow the current content.
        self._refresh_bounds()
        return self.max_scroll > 0

    # ── programmatic / keyboard scrolling ────────────────────────────────
    def scroll_to(self, y, immediate=False):
        self.target_scroll = self._clamp(y)
        if immediate:
            self.scroll_offset = self.target_scroll

    def scroll_by(self, dy, immediate=False):
        self.scroll_to(self.target_scroll + dy, immediate)

    def page(self, direction, immediate=False):
        """direction: +1 = down, -1 = up. One page = viewport minus a line of context."""
        self.scroll_by(direction * max(self.line_step, self.rect.height - self.line_step), immediate)

    def home(self, immediate=False):
        self.scroll_to(0, immediate)

    def end(self, immediate=False):
        self.scroll_to(self.max_scroll, immediate)

    def ensure_visible(self, top, bottom, margin=6, immediate=False):
        """Scroll minimally so content-space span [top, bottom] is inside the viewport."""
        view_top, view_h = self.target_scroll, self.rect.height
        if bottom - top + 2 * margin >= view_h:
            self.scroll_to(top - margin, immediate)
        elif top - margin < view_top:
            self.scroll_to(top - margin, immediate)
        elif bottom + margin > view_top + view_h:
            self.scroll_to(bottom + margin - view_h, immediate)

    def handle_key(self, action):
        """Semantic-action keyboard scrolling. Returns True if it scrolled/consumed."""
        if self.max_scroll <= 0:
            return False
        if action == 'MOVE_UP':
            self.scroll_by(-self.line_step)
        elif action == 'MOVE_DOWN':
            self.scroll_by(self.line_step)
        elif action == 'PAGE_UP':
            self.page(-1)
        elif action == 'PAGE_DOWN':
            self.page(1)
        elif action == 'HOME':
            self.home()
        elif action == 'END':
            self.end()
        else:
            return False
        return True

    def can_scroll(self, direction):
        """direction -1 up / +1 down: is there content left in that direction?"""
        if direction < 0:
            return self.target_scroll > 0
        return self.target_scroll < self.max_scroll

    # ── thumb ────────────────────────────────────────────────────────────
    def get_thumb_rect(self):
        """Calculate the thumb rectangle based on current scroll position"""
        self._refresh_bounds()
        if self.max_scroll <= 0 or self.content_height <= 0:
            return pygame.Rect(0, 0, 0, 0)  # No scrolling needed

        thumb_height = max(20, int(self.rect.height * self.rect.height / self.content_height))
        thumb_height = min(thumb_height, self.rect.height)
        travel = self.rect.height - thumb_height
        thumb_y = self.bar_rect.y + (self.scroll_offset / self.max_scroll) * travel

        return pygame.Rect(self.bar_rect.x, int(thumb_y), self.bar_width, thumb_height)

    # ── mouse ────────────────────────────────────────────────────────────
    def handle_event(self, event, mouse_pos=None):
        """Handle mouse events for scrolling. `mouse_pos` overrides the global
        pygame.mouse.get_pos() (used by tests and by managers that already know it)."""
        self._refresh_bounds()
        if event.type == pygame.MOUSEBUTTONDOWN:
            if event.button == 1 and self.max_scroll > 0:  # Left click
                pos = getattr(event, 'pos', None) or mouse_pos or pygame.mouse.get_pos()
                thumb_rect = self.get_thumb_rect()

                if thumb_rect.collidepoint(pos):
                    self.dragging = True
                    self.last_mouse_y = pos[1]
                    self._grab_dy = pos[1] - thumb_rect.y
                elif self.bar_rect.collidepoint(pos):
                    # Click on track - centre the thumb on the click
                    travel = self.rect.height - thumb_rect.height
                    if travel > 0:
                        rel = pos[1] - self.bar_rect.y - thumb_rect.height / 2
                        self.target_scroll = self._clamp(rel / travel * self.max_scroll)

        elif event.type == pygame.MOUSEBUTTONUP:
            if event.button == 1:
                self.dragging = False

        elif event.type == pygame.MOUSEMOTION:
            pos = getattr(event, 'pos', None) or mouse_pos or pygame.mouse.get_pos()
            thumb_rect = self.get_thumb_rect()
            self.hover = thumb_rect.collidepoint(pos) or self.bar_rect.collidepoint(pos)

            if self.dragging:
                travel = self.rect.height - thumb_rect.height
                if travel > 0:
                    rel = pos[1] - self._grab_dy - self.bar_rect.y
                    self.target_scroll = self._clamp(rel / travel * self.max_scroll)
                    self.last_mouse_y = pos[1]

        elif event.type == pygame.MOUSEWHEEL:
            pos = mouse_pos or pygame.mouse.get_pos()
            region = self.wheel_rect
            if region is None:
                # Legacy callers historically passed only the thin scrollbar
                # rect. Make the wheel usable across the page's vertical span
                # while preserving explicit wheel_rect ownership for UIScrollView.
                surf = pygame.display.get_surface()
                if surf is not None:
                    region = pygame.Rect(0, self.rect.y, surf.get_width(), self.rect.height)
                else:
                    region = self.rect
            if region.collidepoint(pos):
                self.target_scroll = self._clamp(self.target_scroll - event.y * self.line_step)

    def update(self, dt=None):
        """Update smooth scrolling animation. Pass dt (seconds) for frame-rate
        independent easing; without it the legacy per-frame factor is used."""
        if globals().get('_ACCESSIBILITY_REDUCED_MOTION', False):
            self.scroll_offset = self.target_scroll
            return
        if abs(self.target_scroll - self.scroll_offset) > 0.5:
            if dt is None:
                k = self.scroll_speed
            else:
                k = 1.0 - (1.0 - self.scroll_speed) ** (max(0.0, dt) * 60.0)
            self.scroll_offset += (self.target_scroll - self.scroll_offset) * k
        else:
            self.scroll_offset = self.target_scroll

    def draw(self, screen):
        """Draw the scrollbar"""
        self._refresh_bounds()
        if self.max_scroll <= 0:
            return  # No scrolling needed

        # Draw track
        pygame.draw.rect(screen, self.track_color, self.bar_rect, border_radius=6)

        # Draw thumb
        thumb_rect = self.get_thumb_rect()
        thumb_color = self.thumb_hover_color if self.hover or self.dragging else self.thumb_color
        pygame.draw.rect(screen, thumb_color, thumb_rect, border_radius=6)

    def get_content_offset(self):
        """Get the current content offset for rendering"""
        return int(self.scroll_offset)

