_ui_glow_cache = {}


def ui_draw_focus_ring(surface, rect, radius=8):
    """Two-tone ring (dark outline + bright band) so focus is visible on any background."""
    pygame.draw.rect(surface, UI_STYLE['focus_outline'], rect.inflate(10, 10),
                     width=2, border_radius=radius + 4)
    pygame.draw.rect(surface, UI_STYLE['focus_color'], rect.inflate(6, 6),
                     width=2, border_radius=radius + 2)


def _ui_shade(color, delta):
    return tuple(max(0, min(255, c + delta)) for c in color[:3])


class UIWidget:
    """Common base: rect, state (normal/hover/focused/pressed/disabled), mouse +
    semantic-action input, focus participation, drawing hook."""
    focusable = True
    interactive = True          # receives mouse hit-tests
    captures_text = False

    def __init__(self, rect=None, key=None, enabled=True, visible=True,
                 on_activate=None, tab_index=None):
        self.rect = pygame.Rect(rect) if rect is not None else pygame.Rect(0, 0, 0, 0)
        self.key = key
        self.enabled, self.visible = enabled, visible
        self.on_activate = on_activate
        self.tab_index = tab_index
        self.hover = self.pressed = self.focused = False
        self.ui = None
        self.scroll_parent = None       # owning UIScrollView (if any)
        self.content_rect = None        # rect in the scroll view's content space

    # -- state --------------------------------------------------------------
    @property
    def state(self):
        if not self.enabled:
            return 'disabled'
        if self.pressed:
            return 'pressed'
        if self.focused and (self.ui is None or self.ui.focus_visible):
            return 'focused'
        return 'hover' if self.hover else 'normal'

    @property
    def show_focus(self):
        return self.focused and self.enabled and (self.ui is None or self.ui.focus_visible)

    def lang(self):
        return self.ui.language if self.ui is not None else 'en'

    @staticmethod
    def val(v):
        return v() if callable(v) else v

    def is_focusable(self):
        return self.focusable and self.enabled and self.visible and self.rect.w > 0 and self.rect.h > 0

    def hit(self, pos):
        if not (self.visible and self.interactive and self.rect.collidepoint(pos)):
            return False
        sp = self.scroll_parent
        return sp is None or sp.viewport.collidepoint(pos)

    # -- behaviour hooks ------------------------------------------------------
    def activate(self):
        if self.enabled and self.on_activate:
            self.on_activate()

    def on_focus(self):
        pass

    def on_blur(self):
        pass

    def handle_action(self, action, event=None):
        """Semantic keyboard input while focused. Return True if consumed."""
        if action == 'CONFIRM':
            self.activate()
            return True
        return False

    def handle_text(self, event):
        return False

    def mouse_down(self, pos):
        pass

    def mouse_drag(self, pos):
        pass

    def mouse_up(self, pos, inside):
        if inside:
            self.activate()

    def draw(self, surface):
        pass

    def draw_overlay(self, surface):
        pass


class UILabel(UIWidget):
    focusable = False
    interactive = False

    def __init__(self, text, rect=None, style='regular', size=16, color=None,
                 align='left', wrap=False, line_gap=2, key=None, valign='top'):
        super().__init__(rect, key=key)
        self.text, self.style, self.size = text, style, size
        self.color = color if color is not None else COLORS['white']
        self.align, self.wrap, self.line_gap, self.valign = align, wrap, line_gap, valign

    def _lines(self, width):
        txt = self.val(self.text)
        if not self.wrap:
            return [txt]
        return ui_wrap_text(self.lang(), self.style, self.size, txt, width)

    def line_height(self):
        return get_font(self.lang(), self.style, self.size).get_height()

    def measure(self, width):
        """Height needed when laid out `width` px wide (wrapped labels grow, others don't)."""
        lines = self._lines(width)
        lh = self.line_height()
        return len(lines) * lh + (len(lines) - 1) * self.line_gap

    def text_width(self):
        return ui_text_size(self.lang(), self.style, self.size, self.val(self.text))[0]

    def draw(self, surface):
        if not self.visible or self.rect.w <= 0:
            return
        lang, r = self.lang(), self.rect
        old = surface.get_clip()
        surface.set_clip(old.clip(r))
        lines = self._lines(r.w)
        lh = self.line_height()
        total = len(lines) * lh + (len(lines) - 1) * self.line_gap
        y = r.y + ((r.h - total) // 2 if self.valign == 'center' else 0)
        for line in lines:
            if line:
                s = ui_text_surface(lang, self.style, self.size, line, self.color,
                                    None if self.wrap else r.w)
                x = r.x if self.align == 'left' else r.right - s.get_width() if self.align == 'right' \
                    else r.x + (r.w - s.get_width()) // 2
                surface.blit(s, (x, y))
            y += lh + self.line_gap
        surface.set_clip(old)


class UIPanel(UIWidget):
