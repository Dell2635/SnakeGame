            total_height = max(visible_height, content_bottom - viewport_top)
            thumb_h = max(24, int(track.height * visible_height / total_height))
            travel = max(0, track.height - thumb_h)
            thumb_y = track.y + int(travel * offset / self.data_scroll_max)
            pygame.draw.rect(self.screen, COLORS['light_blue'],
                             pygame.Rect(track.x, thumb_y, track.width, thumb_h), border_radius=4)

        if self.confirm_data_action:
            self._draw_data_confirm_overlay()

        return controls

    def _draw_data_confirm_overlay(self):
        """Modal confirming a destructive Settings > Data action, matching
        the look of the existing High Scores delete-confirmation dialog."""
        lang = self.settings.language
        action = self.confirm_data_action
        overlay = pygame.Surface(self.screen.get_size(), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 170))
        self.screen.blit(overlay, (0, 0))

        cx, cy = self.screen.get_width() // 2, self.screen.get_height() // 2
        lines = action.get('message_lines', [])
        screen_w, screen_h = self.screen.get_size()
        dlg_w = min(480, max(1, screen_w - 24))
        dlg_h = min(max(150, 120 + 26 * len(lines)), max(1, screen_h - 24))
        dlg = pygame.Rect(cx - dlg_w // 2, cy - dlg_h // 2, dlg_w, dlg_h)
        self._data_confirm_dialog_rect = dlg
        pygame.draw.rect(self.screen, (40, 40, 60), dlg, border_radius=10)
        pygame.draw.rect(self.screen, COLORS['red'], dlg, border_radius=10, width=2)

        msg_font = get_font(lang, 'bold', max(12, min(18, dlg_w // 22)))
        y = dlg.y + 24
        for line in lines:
            surf = render_fit(msg_font, line, COLORS['white'], dlg.width - 30)
            self.screen.blit(surf, surf.get_rect(center=(cx, y)))
            y += 26

        is_notice = action.get('kind') == 'notice'
        yes_r = (pygame.Rect(cx - 45, dlg.bottom - 50, 90, 34) if is_notice
                 else pygame.Rect(cx - 110, dlg.bottom - 50, 90, 34))
        no_r = None if is_notice else pygame.Rect(cx + 20, dlg.bottom - 50, 90, 34)
        pygame.draw.rect(self.screen, COLORS['button'] if is_notice else (180, 50, 50),
                         yes_r, border_radius=6)
        if no_r:
            pygame.draw.rect(self.screen, COLORS['button'], no_r, border_radius=6)
        btn_font = get_font(lang, 'bold', 18)
        yt = render_fit(btn_font, get_text(lang, 'close') if is_notice else
                        _t_or(lang, 'confirm', 'Confirm'),
                        COLORS['white'], yes_r.width - 8, padding=2)
        self.screen.blit(yt, yt.get_rect(center=yes_r.center))
        if no_r:
            nt = render_fit(btn_font, get_text(lang, 'cancel'),
                            COLORS['white'], no_r.width - 8, padding=2)
            self.screen.blit(nt, nt.get_rect(center=no_r.center))
        self._data_confirm_yes_rect = yes_r
        self._data_confirm_no_rect = no_r

    def _show_data_action_notice(self, translation_key):
        self.confirm_data_action = {
            'kind': 'notice',
            'message_lines': [get_text(self.settings.language, translation_key)],
        }

    def _execute_data_action(self, action):
        """Apply a confirmed Settings > Data action. Never touches a
        category other than the one explicitly requested."""
        kind = action.get('kind')
        if kind == 'notice':
            return True
        if kind == 'delete_category':
            result, _error = delete_category(action['category'])
            return bool(result)
        elif kind == 'replay_clean':
            count, freed = replay_storage_clean(action['scan'])
            self.data_replay_message = _replay_tool_label(
                self.settings.language, 'done_clean', count=count, size=_format_bytes(freed))
            self._data_replay_invalidate()
            return True
        elif kind == 'replay_delete':
            count, freed = replay_storage_delete(action['entries'])
            self.data_replay_message = _replay_tool_label(
                self.settings.language, 'done_delete', count=count, size=_format_bytes(freed))
            self.data_replay_selection.clear()
            self._data_replay_invalidate()
            return True
        elif kind == 'reset_settings':
            # Clears only the persisted `settings` section — saves, high
            # scores, achievements, and encyclopedia progress are untouched.
            backup_path = export_data()
            if not backup_path:
                self._show_data_action_notice('data_backup_failed')
                return False
            try:
                gd = _load_data()
                gd['settings'] = {}
                if not _save_data(gd):
                    self._show_data_action_notice('data_settings_reset_failed')
                    return False
            except Exception as e:
                print(f"Error resetting settings: {e}")
                self._show_data_action_notice('data_settings_reset_failed')
                return False
            self.settings.reset_to_defaults()
            _apply_accessibility_preferences(self.settings)
            if self.temp_settings is not None:
                self.temp_settings.reset_to_defaults()
            self._show_data_action_notice('data_settings_reset_done')
            return False
        elif kind == 'factory_reset':
            result = factory_reset()
            if result.get('error') == 'backup_failed':
                self._show_data_action_notice('data_backup_failed')
                return False
            failed_categories = [category for category, outcome in result.get('results', {}).items()
                                 if not isinstance(outcome, tuple) or not outcome[0]]
            if failed_categories:
                self._show_data_action_notice('data_factory_reset_partial')
                return False
            self.settings.reset_to_defaults()
            self.settings.first_time = True
            _apply_accessibility_preferences(self.settings)
            if self.temp_settings is not None:
                self.temp_settings.reset_to_defaults()
            self._show_data_action_notice('data_factory_reset_done')
            return False
        return True

    def draw_color_picker(self, rect, current_color, label):
