                scale = max_w / text_surf.get_width()
                new_size = (max_w, max(1, int(text_surf.get_height() * scale)))
                text_surf = pygame.transform.smoothscale(text_surf, new_size)
            self.screen.blit(text_surf, text_surf.get_rect(center=rect.center))
            buttons[key] = rect

        self._go_buttons = buttons

        # Brief "Copied!" confirmation after using the Copy Seed button
        if getattr(self, '_seed_copied_until', 0) > time.time():
            note_font = get_font(self.settings.language, 'regular', 18)
            note = note_font.render(get_text(self.settings.language, 'seed_copied'), True, (140, 220, 140))
            self.screen.blit(note, note.get_rect(center=(sw // 2, by + btn_h + 26)))

        # Keyboard-shortcut hints still shown for desktop users
        instr_font = get_font(self.settings.language, 'regular', 16)
        instr_text = get_text(self.settings.language, 'press_r_to_restart')
        instr_surface = instr_font.render(instr_text, True, (160, 160, 175))
        self.screen.blit(instr_surface, instr_surface.get_rect(center=(sw // 2, by + btn_h + 50)))
        instr2_text = get_text(self.settings.language, 'press_esc_to_menu')
