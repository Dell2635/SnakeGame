def get_contrasting_text_color(bg_color):
    """
    Determine whether white or black text will be more legible on the given background color
    
    Args:
        bg_color (tuple): RGB color tuple
        
    Returns:
        tuple: Either black or white RGB color tuple
    """
    r, g, b = bg_color[:3]  # Extract RGB values, ignoring alpha if present
    
    # Calculate luminance using the formula: 0.299R + 0.587G + 0.114B
    luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255
    
    # Use white text on dark backgrounds, black text on light backgrounds
    if luminance < 0.5:
        return COLORS['white']
    else:
        return COLORS['black']

