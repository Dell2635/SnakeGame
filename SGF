                    tail_y = center_y - dy * arrow_size
                    
                    # Draw the arrow
                    pygame.draw.line(self.screen, (0, 0, 0), (tail_x, tail_y), (head_x, head_y), 2)
                    
                    # Draw arrowhead
                    if dx == 0:  # Vertical arrow
                        if dy > 0:  # Down
                            pygame.draw.line(self.screen, (0, 0, 0), (head_x, head_y), (head_x - 3, head_y - 5), 2)
                            pygame.draw.line(self.screen, (0, 0, 0), (head_x, head_y), (head_x + 3, head_y - 5), 2)
                        else:  # Up
                            pygame.draw.line(self.screen, (0, 0, 0), (head_x, head_y), (head_x - 3, head_y + 5), 2)
                            pygame.draw.line(self.screen, (0, 0, 0), (head_x, head_y), (head_x + 3, head_y + 5), 2)
                    else:  # Horizontal arrow
                        if dx > 0:  # Right
                            pygame.draw.line(self.screen, (0, 0, 0), (head_x, head_y), (head_x - 5, head_y - 3), 2)
                            pygame.draw.line(self.screen, (0, 0, 0), (head_x, head_y), (head_x - 5, head_y + 3), 2)
