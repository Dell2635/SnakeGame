class SnakeAI:
    """
    Pathfinding AI for snake games.  Works for both single-player VS-AI and
    multiplayer AI slots.

    Difficulty levels
    -----------------
    easy       – bumbling noob: mostly random, rarely heads toward fruit
    medium     – clumsy player: greedy one-step toward fruit, frequent detours
    hard       – competent: BFS + flood-fill safety, anti-loop logic
    impossible – expert: BFS + flood-fill + player interception, no loops
    """

    DIRS = [(0, -1), (1, 0), (0, 1), (-1, 0)]   # up right down left

    def __init__(self, difficulty='medium', rng=None):
        self.difficulty  = difficulty
        # Loop-detection: store last N head positions
        self._history    = []          # list of (x, y)
        self._history_max = 12
        # Seeded RNG — falls back to the global random module if none supplied
        self._rng = rng or random

    # ── public API ──────────────────────────────────────────────────────

    def choose_direction(self, snake, occupied, fruit, board_w, board_h,
                         portals=None, powerup_pos=None, wall_collision=True,
                         opponent_snake=None):
        """Return (dx, dy) for the next move."""
        head = snake[0]

        # Record head for loop detection (hard/impossible use this)
        self._history.append(tuple(head))
        if len(self._history) > self._history_max:
            self._history.pop(0)

        # Build blocked set: obstacles + own body
        blocked = set(map(tuple, occupied))
        if len(snake) > 1:
            blocked.update(map(tuple, snake[1:]))

        # Build portal map  pos → exit_pos
        portal_map = {}
        if portals:
            for a, b, _ in portals:
                portal_map[tuple(a)] = tuple(b)
                portal_map[tuple(b)] = tuple(a)

        ctx = (board_w, board_h, wall_collision)

        if self.difficulty == 'easy':
            return self._easy(head, blocked, fruit, ctx)
        elif self.difficulty == 'medium':
            return self._medium(head, blocked, fruit, ctx)
        elif self.difficulty == 'hard':
            return self._hard(head, snake, blocked, fruit, ctx, portal_map, powerup_pos)
        else:
            return self._impossible(head, snake, blocked, fruit, ctx,
                                    portal_map, powerup_pos, opponent_snake)

    # ── difficulty implementations ───────────────────────────────────────

    def _easy(self, head, blocked, fruit, ctx):
        """
        Bumbling noob.
        • 65 % of the time: picks a completely random safe direction
        • 25 % of the time: moves one step that reduces one axis toward fruit
        • 10 % of the time: moves even if it means dying (pure chaos)
        No BFS, no flood-fill, no planning.
        """
        safe = self._safe_dirs(head, blocked, ctx)

        roll = self._rng.random()

        if roll < 0.10:
            # Pure chaos – ignore safety
            all_dirs = [d for d in self.DIRS
                        if self._step(head, d, ctx) is not None]
            return self._rng.choice(all_dirs) if all_dirs else self.DIRS[1]

        if not safe:
            return self.DIRS[1]

        if roll < 0.75:               # 65 % after the 10 % chaos band
            return self._rng.choice(safe)

        # Remaining 25 %: greedily pick ONE axis toward fruit (may still be wrong)
        fx, fy = fruit
        hx, hy = head
        # Build candidates for each axis separately, pick one axis at random
        x_dirs = []
        y_dirs = []
        if fx > hx: x_dirs.append((1,  0))
        if fx < hx: x_dirs.append((-1, 0))
        if fy > hy: y_dirs.append((0,  1))
        if fy < hy: y_dirs.append((0, -1))
        candidates = []
        if x_dirs and y_dirs:
            # Only move on the randomly chosen axis (not always optimal)
            candidates = self._rng.choice([x_dirs, y_dirs])
        else:
            candidates = x_dirs or y_dirs
        good = [d for d in candidates if d in safe]
        return self._rng.choice(good) if good else self._rng.choice(safe)

    def _medium(self, head, blocked, fruit, ctx):
        """
        Clumsy casual player.
        No BFS — uses one-step greedy (Manhattan direction).
        • 30 % random safe move (detour / mistake)
        • 70 % move toward fruit on the closer axis first, but no look-ahead.
        Occasionally heads the wrong way when both axes are equidistant.
        """
        safe = self._safe_dirs(head, blocked, ctx)
        if not safe:
            return self.DIRS[1]

        if self._rng.random() < 0.30:
            return self._rng.choice(safe)

        fx, fy = fruit
        hx, hy = head
        dx_dist = fx - hx
        dy_dist = fy - hy

        # Build a preference list: closer axis first, but not always correct
        prefs = []
        if abs(dx_dist) >= abs(dy_dist):
            if dx_dist > 0: prefs.append((1, 0))
            elif dx_dist < 0: prefs.append((-1, 0))
            if dy_dist > 0: prefs.append((0, 1))
            elif dy_dist < 0: prefs.append((0, -1))
        else:
            if dy_dist > 0: prefs.append((0, 1))
            elif dy_dist < 0: prefs.append((0, -1))
            if dx_dist > 0: prefs.append((1, 0))
            elif dx_dist < 0: prefs.append((-1, 0))

        # Medium sometimes ignores the optimal axis and tries the second one first
        if self._rng.random() < 0.20 and len(prefs) >= 2:
            prefs = [prefs[1], prefs[0]]

        for d in prefs:
            if d in safe:
                return d
        return self._rng.choice(safe)

    def _hard(self, head, snake, blocked, fruit, ctx, portal_map, powerup_pos):
        """
        Competent AI. BFS to fruit + flood-fill safety gate.
        Anti-loop: if the snake has been oscillating for the last 8 ticks,
        force exploration by shuffling direction priorities.
        Falls back to max-space direction (with tie-breaking randomness).
        """
        target = self._best_target(head, fruit, powerup_pos, ctx, margin=2)

        # ── loop detection ─────────────────────────────────────────────
        looping = self._is_looping(window=8)

        path = self._bfs(head, target, blocked, ctx, portal_map,
                         shuffle=looping)
        if path and len(path) > 1:
            nxt = path[1]
            d   = self._dir_from(head, nxt, ctx)
            # After moving: old head joins body, old tail leaves body.
            # nxt is the new head and must NOT be in the fill's blocked set.
            after_blocked = (set(blocked) - {tuple(snake[-1])}) | {tuple(snake[0])}
            threshold = max(len(snake) // 2, 3)
            if self._flood_fill(nxt, after_blocked, ctx) >= threshold:
                return d

        return self._escape_dir(head, snake, blocked, ctx, looping)

    def _impossible(self, head, snake, blocked, fruit, ctx,
                    portal_map, powerup_pos, opponent_snake):
        """Expert AI: hard + tracks opponent, intercepts when larger."""
        extra = set(blocked)
        if opponent_snake and len(opponent_snake) > 1:
            extra.update(map(tuple, opponent_snake[1:]))

        target   = tuple(fruit)
        opp_head = tuple(opponent_snake[0]) if opponent_snake else None

        if opp_head and len(snake) > len(opponent_snake):
            path = self._bfs(head, opp_head, extra, ctx, portal_map)
            if path and len(path) <= 6:
                target = opp_head

        if powerup_pos:
            bw, bh, _ = ctx
            if self._manhattan(head, powerup_pos, bw, bh) < self._manhattan(head, target, bw, bh) - 1:
                target = powerup_pos

        looping = self._is_looping(window=8)
        path = self._bfs(head, target, extra, ctx, portal_map, shuffle=looping)
        if path and len(path) > 1:
            nxt = path[1]
            d   = self._dir_from(head, nxt, ctx)
            after_blocked = (set(extra) - {tuple(snake[-1])}) | {tuple(snake[0])}
            if self._flood_fill(nxt, after_blocked, ctx) >= max(len(snake) // 2, 3):
                return d

        return self._escape_dir(head, snake, extra, ctx, looping)

    # ── pathfinding helpers ──────────────────────────────────────────────

    def _step(self, pos, d, ctx):
        """Step one cell; returns None if it would hit a wall."""
        bw, bh, wall = ctx
        nx = pos[0] + d[0]
        ny = pos[1] + d[1]
        if wall:
            return (nx, ny) if (0 <= nx < bw and 0 <= ny < bh) else None
        return (nx % bw, ny % bh)

    def _safe_dirs(self, head, blocked, ctx):
        """Directions that lead to in-bounds, unblocked cells."""
        return [d for d in self.DIRS
                if (nxt := self._step(head, d, ctx)) is not None
                and nxt not in blocked]

    def _bfs(self, start, goal, blocked, ctx, portal_map, shuffle=False):
        """
        BFS from start to goal.
        shuffle=True randomises neighbour order to escape loops.
        Returns path list or None.
        """
        if goal is None:
            return None
        goal  = tuple(goal)
        start = tuple(start)
        from collections import deque
        dirs = list(self.DIRS)
        if shuffle:
            self._rng.shuffle(dirs)
        q    = deque([[start]])
        seen = {start}
        while q:
            path = q.popleft()
            cur  = path[-1]
            if cur == goal:
                return path
            for d in dirs:
                nxt = self._step(cur, d, ctx)
                if nxt is None or nxt in blocked or nxt in seen:
                    continue
                seen.add(nxt)
                new_path = path + [nxt]
                q.append(new_path)
                if nxt in portal_map:
                    ex = portal_map[nxt]
                    if ex not in seen and ex not in blocked:
                        seen.add(ex)
                        q.append(new_path + [ex])
        return None

    def _flood_fill(self, start, blocked, ctx):
        """Count cells reachable from start (BFS, skips None and blocked)."""
        from collections import deque
        start = tuple(start)
        if start in blocked:
            return 0
        visited = {start}
        q = deque([start])
        while q:
            cur = q.popleft()
            for d in self.DIRS:
                nxt = self._step(cur, d, ctx)
                if nxt is not None and nxt not in blocked and nxt not in visited:
                    visited.add(nxt)
                    q.append(nxt)
        return len(visited)

    def _escape_dir(self, head, snake, blocked, ctx, looping):
        """
        Fallback: pick the safe direction with the most open space.
        Uses correct after-move blocked set (old head added, old tail removed).
        When looping, adds random noise to break ties.
        """
        best_d     = None
        best_score = -1
        dirs = list(self.DIRS)
        if looping:
            self._rng.shuffle(dirs)
        # after any move: old head joins body, old tail leaves
        after_base = (set(blocked) - {tuple(snake[-1])}) | {tuple(snake[0])}
        for d in dirs:
            nxt = self._step(head, d, ctx)
            if nxt is None or nxt in blocked:
                continue
            score = self._flood_fill(nxt, after_base, ctx)
            if looping:
                score += self._rng.uniform(0, 3)
            if score > best_score:
                best_score = score
                best_d     = d
        if best_d:
            return best_d
        safe = self._safe_dirs(head, blocked, ctx)
        return self._rng.choice(safe) if safe else self.DIRS[1]

    def _is_looping(self, window=8):
        """True if the snake's head has revisited the same cell in the last `window` steps."""
        if len(self._history) < window:
            return False
        recent = self._history[-window:]
        return len(recent) != len(set(recent))

    def _best_target(self, head, fruit, powerup_pos, ctx, margin):
        if not powerup_pos:
            return tuple(fruit)
        bw, bh, _ = ctx
        if self._manhattan(head, powerup_pos, bw, bh) < self._manhattan(head, fruit, bw, bh) - margin:
            return tuple(powerup_pos)
        return tuple(fruit)

    def _manhattan(self, a, b, bw, bh):
        dx = abs(a[0] - b[0])
        dy = abs(a[1] - b[1])
        return min(dx, bw - dx) + min(dy, bh - dy)

    def _dir_from(self, frm, to, ctx):
        bw, bh, wall = ctx
        dx = to[0] - frm[0]
        dy = to[1] - frm[1]
        if not wall:
            if abs(dx) > 1: dx = -1 if dx > 0 else 1
            if abs(dy) > 1: dy = -1 if dy > 0 else 1
        return (dx, dy)


