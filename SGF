            shown = self.seed_text if self.seed_text and self.seed_mode=='custom' else 'Random seed'
            self.screen.blit(sf.render(shown[-36:],True,
                                       COLORS['white'] if self.seed_mode=='custom' and self.seed_text else (100,110,140)),
