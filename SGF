def _custom_challenges_dir():
    path = os.path.join(_user_data_manager.get_save_dir(), 'challenges')
    os.makedirs(path, exist_ok=True)
    return path


def _custom_challenge_map_snapshot(map_name, map_data):
    """Validate and copy the stable subset of a user map used by a challenge."""
    if not isinstance(map_name, str) or not map_name.strip() or len(map_name) > 80:
        raise ValueError('Challenge map name is invalid')
    if not isinstance(map_data, dict):
        raise ValueError('Challenge map data is invalid')
    width, height = map_data.get('board_width'), map_data.get('board_height')
    obstacles, portals = map_data.get('obstacles', []), map_data.get('portals', [])
    if (type(width) is not int or type(height) is not int or
            not 5 <= width <= 60 or not 5 <= height <= 60 or
            not isinstance(obstacles, list) or len(obstacles) > 5000 or
            not isinstance(portals, list) or len(portals) > 100):
        raise ValueError('Challenge map is outside supported limits')
    checked_obstacles = []
    occupied = set()
    for cell in obstacles:
        if (not isinstance(cell, (list, tuple)) or len(cell) != 2 or
                any(type(value) is not int for value in cell) or
                not (0 <= cell[0] < width and 0 <= cell[1] < height)):
            raise ValueError('Challenge map obstacle is invalid')
        checked_obstacles.append([cell[0], cell[1]])
        occupied.add((cell[0], cell[1]))
    if len(occupied) != len(checked_obstacles):
        raise ValueError('Challenge map contains duplicate obstacles')
    checked_portals = []
    portal_cells = set()
    for portal in portals:
        if (not isinstance(portal, (list, tuple)) or len(portal) != 5 or
                any(type(value) is not int for value in portal)):
            raise ValueError('Challenge map portal is invalid')
        x1, y1, x2, y2, palette = portal
        if (not (0 <= x1 < width and 0 <= x2 < width and
                 0 <= y1 < height and 0 <= y2 < height and 0 <= palette < 4) or
                (x1, y1) == (x2, y2)):
            raise ValueError('Challenge map portal is outside supported limits')
        endpoints = ((x1, y1), (x2, y2))
        if any(cell in occupied or cell in portal_cells for cell in endpoints):
            raise ValueError('Challenge map portal overlaps another object')
        portal_cells.update(endpoints)
        checked_portals.append([x1, y1, x2, y2, palette])
    return {
        'board_width': width, 'board_height': height,
        'obstacles': checked_obstacles, 'portals': checked_portals,
    }


def _custom_challenge_path(challenge_id):
    if not isinstance(challenge_id, str) or not re.fullmatch(
            r'user-v[12]-[0-9a-f]{24}', challenge_id):
        raise ValueError('Challenge identifier is invalid')
    return os.path.join(_custom_challenges_dir(), challenge_id + '.json')


def _custom_challenge_identity(map_name, map_data, modifier):
    if modifier not in _CUSTOM_CHALLENGE_MODIFIERS:
        raise ValueError('Challenge modifier is invalid')
    custom_map = _custom_challenge_map_snapshot(map_name, map_data)
    canonical = json.dumps(
        {'map_name': map_name, 'map': custom_map, 'modifier': modifier},
        sort_keys=True, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
    return hashlib.sha256(b'SGF:custom-challenge:v1:' + canonical).hexdigest()


def _custom_challenge_identity_v2(map_name, map_data, modifier, update_rate_ms):
    if modifier not in _CUSTOM_CHALLENGE_MODIFIERS or update_rate_ms not in _CUSTOM_CHALLENGE_SPEEDS:
        raise ValueError('Challenge rules are invalid')
    custom_map = _custom_challenge_map_snapshot(map_name, map_data)
    canonical = json.dumps({
        'map_name': map_name, 'map': custom_map, 'modifier': modifier,
        'update_rate_ms': update_rate_ms,
    }, sort_keys=True, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
    return hashlib.sha256(b'SGF:custom-challenge:v2:' + canonical).hexdigest()


def _validate_custom_challenge(record):
    if (not isinstance(record, dict) or
            type(record.get('schema_version')) is not int or
            record.get('schema_version') not in (1, 2, _CUSTOM_CHALLENGE_SCHEMA) or
            type(record.get('challenge_version')) is not int or
            record.get('challenge_version') not in (1, 2) or
            record.get('modifier') not in _CUSTOM_CHALLENGE_MODIFIERS):
        raise ValueError('Challenge record version or modifier is invalid')
    challenge_id = record.get('challenge_id')
    _custom_challenge_path(challenge_id)
    map_name = record.get('map_name')
    custom_map = _custom_challenge_map_snapshot(map_name, record.get('map'))
    display_name = record.get('display_name', map_name)
    if (not isinstance(display_name, str) or not display_name.strip() or
            len(display_name.strip()) > 80 or
            any(ord(char) < 32 for char in display_name)):
        raise ValueError('Challenge display name is invalid')
    seed = record.get('seed')
    if not isinstance(seed, str) or not re.fullmatch(r'SGFC-[0-9a-f]{16}', seed):
        raise ValueError('Challenge seed is invalid')
    rules = record.get('rules')
    if not isinstance(rules, dict):
        raise ValueError('Challenge rules are invalid')
    if (type(rules.get('update_rate_ms')) is not int or
            not 50 <= rules['update_rate_ms'] <= 1000 or
            type(rules.get('wall_collision')) is not bool or
            rules['wall_collision'] != (record['modifier'] != 'wrap_walls')):
        raise ValueError('Challenge rules are outside supported limits')
    if record['challenge_version'] == 1:
        digest = _custom_challenge_identity(map_name, custom_map, record['modifier'])
        expected_id = 'user-v1-' + digest[:24]
    else:
        if (record.get('schema_version') < 3 or
                rules['update_rate_ms'] not in _CUSTOM_CHALLENGE_SPEEDS):
            raise ValueError('Challenge speed rule is missing or unsupported')
        digest = _custom_challenge_identity_v2(
            map_name, custom_map, record['modifier'], rules['update_rate_ms'])
        expected_id = 'user-v2-' + digest[:24]
    if (challenge_id != expected_id or seed != 'SGFC-' + digest[24:40]):
        raise ValueError('Challenge identity does not match its rules and map')
    return {
        'schema_version': _CUSTOM_CHALLENGE_SCHEMA,
        'challenge_id': challenge_id,
        'challenge_version': record['challenge_version'],
        'map_name': map_name,
        'display_name': display_name.strip(),
        'map': custom_map,
        'seed': seed,
        'modifier': record['modifier'],
        'rules': {
            'board_size': max(custom_map['board_width'], custom_map['board_height']),
            'update_rate_ms': rules['update_rate_ms'],
            'wall_collision': rules['wall_collision'],
            'powerups_enabled': False,
            'fruit_types_enabled': False,
            'enable_obstacles': bool(custom_map['obstacles']),
            'enable_portals': bool(custom_map['portals']),
            'portal_pairs': len(custom_map['portals']),
            'obstacle_count': len(custom_map['obstacles']),
        },
    }


def _create_or_load_custom_challenge(map_name, map_data, modifier, update_rate_ms=150):
    if modifier not in _CUSTOM_CHALLENGE_MODIFIERS:
        raise ValueError('Challenge modifier is invalid')
    if type(update_rate_ms) is not int or update_rate_ms not in _CUSTOM_CHALLENGE_SPEEDS:
        raise ValueError('Challenge speed is invalid')
    custom_map = _custom_challenge_map_snapshot(map_name, map_data)
    digest = _custom_challenge_identity_v2(
        map_name, custom_map, modifier, update_rate_ms)
    challenge_id = 'user-v2-' + digest[:24]
    path = _custom_challenge_path(challenge_id)
    if os.path.isfile(path):
        with open(path, 'r', encoding='utf-8') as challenge_file:
            return _validate_custom_challenge(json.load(challenge_file))
    record = {
        'schema_version': _CUSTOM_CHALLENGE_SCHEMA,
        'challenge_id': challenge_id,
        'challenge_version': 2,
        'map_name': map_name,
        'display_name': map_name,
        'map': custom_map,
        'seed': 'SGFC-' + digest[24:40],
        'modifier': modifier,
        'rules': {
            'update_rate_ms': update_rate_ms,
            'wall_collision': modifier != 'wrap_walls',
        },
    }
    record = _validate_custom_challenge(record)
    _atomic_write_json(path, record)
    with open(path, 'r', encoding='utf-8') as challenge_file:
        saved = _validate_custom_challenge(json.load(challenge_file))
    if saved != record:
        raise ValueError('Saved challenge failed validation')
    return saved


def _rename_custom_challenge(challenge_id, display_name):
    """Change a challenge's label without changing its deterministic ID/seed."""
    display_name = display_name.strip() if isinstance(display_name, str) else ''
    if (not display_name or len(display_name) > 80 or
            any(ord(char) < 32 for char in display_name)):
        raise ValueError('Challenge display name is invalid')
    path = _custom_challenge_path(challenge_id)
    with open(path, 'r', encoding='utf-8') as challenge_file:
        record = _validate_custom_challenge(json.load(challenge_file))
    record['display_name'] = display_name
    _atomic_write_json(path, record)
    with open(path, 'r', encoding='utf-8') as challenge_file:
        saved = _validate_custom_challenge(json.load(challenge_file))
    if saved != record:
        raise ValueError('Renamed challenge failed validation')
    return saved


def _delete_custom_challenge(challenge_id):
    """Delete only the selected challenge definition, retaining match data."""
    path = _custom_challenge_path(challenge_id)
    if not os.path.isfile(path):
        return False
    with open(path, 'r', encoding='utf-8') as challenge_file:
        _validate_custom_challenge(json.load(challenge_file))
    os.remove(path)
    return not os.path.exists(path)


def _load_custom_challenges():
    challenges = {}
    try:
        filenames = os.listdir(_custom_challenges_dir())
    except OSError:
        return challenges
    for filename in filenames:
        if not re.fullmatch(r'user-v[12]-[0-9a-f]{24}\.json', filename):
