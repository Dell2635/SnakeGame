                        trail_surface.fill((*COLORS['moving_obstacle'][:3], trail_alpha // i))
                        self.screen.blit(trail_surface, trail_rect)
            
            # Second moving obstacle (vertical)
            y_pos = (0.5 + math.sin(time_offset * 1.5 + math.pi) * 0.5) * 4  # Range from 0 to 4
            moving_rect2 = pygame.Rect(
                board_rect.x + 2 * cell_size,
                board_rect.y + y_pos * cell_size,
                cell_size,
                cell_size
            )
            pygame.draw.rect(self.screen, COLORS['moving_obstacle'], moving_rect2)
            
            # Add direction indicator
            dir_x = math.cos(time_offset * 2) * -1  # Reverse cosine for correct movement direction
            dir_y = math.cos(time_offset * 1.5 + math.pi) * -1
            arrow_length = cell_size // 3
            
            # Draw direction arrow for horizontal obstacle
            pygame.draw.line(self.screen, COLORS['white'],
                          (moving_rect1.centerx, moving_rect1.centery),
                          (moving_rect1.centerx + arrow_length * dir_x, moving_rect1.centery),
                          2)
            # Draw arrowhead
            if dir_x != 0:
                pygame.draw.polygon(self.screen, COLORS['white'], [
                    (moving_rect1.centerx + arrow_length * dir_x, moving_rect1.centery),
                    (moving_rect1.centerx + arrow_length * dir_x * 0.7, moving_rect1.centery + 5),
                    (moving_rect1.centerx + arrow_length * dir_x * 0.7, moving_rect1.centery - 5)
                ])
            
            # Draw direction arrow for vertical obstacle
            pygame.draw.line(self.screen, COLORS['white'],
                          (moving_rect2.centerx, moving_rect2.centery),
                          (moving_rect2.centerx, moving_rect2.centery + arrow_length * dir_y),
                          2)
            # Draw arrowhead
            if dir_y != 0:
                pygame.draw.polygon(self.screen, COLORS['white'], [
                    (moving_rect2.centerx, moving_rect2.centery + arrow_length * dir_y),
                    (moving_rect2.centerx + 5, moving_rect2.centery + arrow_length * dir_y * 0.7),
                    (moving_rect2.centerx - 5, moving_rect2.centery + arrow_length * dir_y * 0.7)
                ])
                
        # Draw page indicator dots
        dot_radius = 5
        dot_spacing = 15
        dots_width = (self.total_pages - 1) * dot_spacing + dot_radius * 2
        dots_x = self.screen.get_width() // 2 - dots_width // 2
        dots_y = _dots_y
        
        for i in range(self.total_pages):
            if i == self.current_page:
                # Current page - larger, animated dot
                pulse = (0.0 if reduced_motion else
                         (math.sin(pygame.time.get_ticks() / 300) + 1) / 4)
                current_radius = dot_radius + int(pulse * 3)
                pygame.draw.circle(self.screen, COLORS['white'], 
                                (dots_x + i * dot_spacing, dots_y), current_radius)
            else:
                # Other pages - smaller, inactive dots
                pygame.draw.circle(self.screen, COLORS['inactive_dot'], 
                                (dots_x + i * dot_spacing, dots_y), dot_radius)
                
        # Draw navigation buttons with hover effects — all proportionally positioned
        _nav_btn_h = max(32, min(50, int(_sh * 0.065)))
        _nav_btn_w = max(100, min(160, int(_sw * 0.16)))
        _back_w = max(80, int(_sw * 0.12))
        
        # Back button (always visible) — top-left, proportional
        back_rect = pygame.Rect(int(_sw * 0.05), int(_sh * 0.065), _back_w, _nav_btn_h)
        back_text = get_text(self.settings.language, 'back')
        self.create_button(back_rect, back_text, COLORS['button'], self.button_hover["back"])
        
        # Previous button (if not on first page) — bottom-left area
        prev_rect = None
        if self.current_page > 0:
            prev_rect = pygame.Rect(int(_sw * 0.22), _nav_y, _nav_btn_w, _nav_btn_h)
            prev_text = get_text(self.settings.language, 'previous')
            self.create_button(prev_rect, prev_text, COLORS['button'], self.button_hover["prev"])
            
        # Next/Finish button — bottom-right area
        next_rect = pygame.Rect(int(_sw * 0.55), _nav_y, _nav_btn_w, _nav_btn_h)
        if self.current_page < self.total_pages - 1:
            next_text = get_text(self.settings.language, 'next')
        else:
            next_text = get_text(self.settings.language, 'finish')
        self.create_button(next_rect, next_text, COLORS['green'], self.button_hover["next"])
        
        # Apply transition effect if in transition
        if self.transition_alpha > 0:
            self.transition_surface.set_alpha(self.transition_alpha)
            self.screen.blit(self.transition_surface, (0, 0))
            
            if manage_transition:
                # Update transition alpha
                if self.transition_in:
                    self.transition_alpha = max(0, self.transition_alpha - self.transition_speed)
                else:
                    self.transition_alpha = min(255, self.transition_alpha + self.transition_speed)
                    
                    # If transition out is complete, change page and start transition in
                    if self.transition_alpha >= 255:
                        if self.transition_target_page is not None:
                            self.current_page = self.transition_target_page
                            self.transition_target_page = None
                        self.transition_in = True
        
        # Update display
        _legacy_nav_draw(locals().get('self'))
        pygame.display.flip()
        
        return back_rect, prev_rect, next_rect
        
    def draw_key(self, key_text, x, y, width=50, height=50, highlight=False, custom_color=None):
