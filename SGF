    def verify_replay(self):
        g = self.current_game
        history = list(getattr(g, 'game_history', []) or []) if g is not None else []
        if not history:
            self.toast('No replay data to verify')
            return False
        valid = True
        errors = []
        for index, snapshot in enumerate(history):
            if isinstance(snapshot, dict):
                if 'dev_modified' in snapshot and not isinstance(snapshot['dev_modified'], bool):
                    valid = False; errors.append(f'{index}: invalid dev flag')
                if 'snake' not in snapshot and 'p1_snake' not in snapshot and 'snake_state' not in snapshot:
                    valid = False; errors.append(f'{index}: missing snake state')
            elif isinstance(snapshot, list):
                if len(snapshot) < 12:
                    valid = False; errors.append(f'{index}: legacy snapshot too short')
            else:
                valid = False; errors.append(f'{index}: invalid snapshot type')
            if len(errors) >= 5:
                break
        self.replay_verified = bool(valid)
        self.determinism_status = 'VERIFIED' if valid else 'FAILED'
        self.toast('Replay verified' if valid else f'Replay verification failed ({errors[0]})')
        return valid

