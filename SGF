                        self.settings.combo_fruits_enabled = self.temp_settings.combo_fruits_enabled
                        self.settings.levels_enabled = self.temp_settings.levels_enabled
                        self.settings.increasing_speed_enabled = self.temp_settings.increasing_speed_enabled
                        
                        # Apply changes - frequency settings
