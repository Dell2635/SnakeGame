# IA5 protocol constants are defined before the network helpers because
# these helpers execute during module import.
IA5_NET_PROTOCOL_VERSION = 1
IA5_NET_MAX_FRAME = 4_000_000

class _NetProtocolError(Exception):
    """Remote payload violated the established SGF TCP framing/protocol."""


NET_PROTOCOL_VERSION = IA5_NET_PROTOCOL_VERSION
NET_MAX_FRAME = IA5_NET_MAX_FRAME


def _validate_net_direction(direction):
    if not isinstance(direction, (list, tuple)) or len(direction) != 2:
        return False
    try:
        dx, dy = int(direction[0]), int(direction[1])
    except (TypeError, ValueError):
        return False
    if isinstance(direction[0], bool) or isinstance(direction[1], bool):
        return False
    return (dx, dy) in ((1, 0), (-1, 0), (0, 1), (0, -1))


def _validate_net_cell(position, width=None, height=None):
    if not isinstance(position, (list, tuple)) or len(position) != 2:
        return False
    try:
        x, y = int(position[0]), int(position[1])
    except (TypeError, ValueError):
        return False
    if isinstance(position[0], bool) or isinstance(position[1], bool):
        return False
    if width is not None and not (0 <= x < width):
        return False
    if height is not None and not (0 <= y < height):
        return False
    return True


def _validate_net_map(map_data):
    if map_data is None:
        return True
    if not isinstance(map_data, dict):
        return False
    try:
        bw = int(map_data.get('board_width', 0))
        bh = int(map_data.get('board_height', 0))
    except (TypeError, ValueError):
        return False
    if not (5 <= bw <= 100 and 5 <= bh <= 100):
        return False
    obstacles = map_data.get('obstacles', [])
    if not isinstance(obstacles, list) or len(obstacles) > min(bw * bh, 5000):
        return False
    for pos in obstacles:
        if not isinstance(pos, (list, tuple)) or len(pos) != 2:
            return False
        try:
            x, y = int(pos[0]), int(pos[1])
        except (TypeError, ValueError):
            return False
        if not (0 <= x < bw and 0 <= y < bh):
            return False
    portals = map_data.get('portals', [])
    if not isinstance(portals, list) or len(portals) > min((bw * bh) // 2, 64):
        return False
    for portal in portals:
        if not isinstance(portal, (list, tuple)) or len(portal) != 5:
            return False
        try:
            x1, y1, x2, y2 = map(int, portal[:4])
            palette = int(portal[4])
        except (TypeError, ValueError):
            return False
        if not (0 <= x1 < bw and 0 <= y1 < bh and 0 <= x2 < bw and 0 <= y2 < bh):
            return False
        if (x1, y1) == (x2, y2) or palette < 0 or palette > 255:
            return False
    return True


def _validate_net_snapshot(snap):
    """Validate the replay snapshot shape before it can enter persistence."""
    if not isinstance(snap, (list, tuple)) or not (15 <= len(snap) <= 16):
        return False
    try:
        bw, bh = int(snap[12]), int(snap[13])
    except (TypeError, ValueError):
        return False
    if not (5 <= bw <= 100 and 5 <= bh <= 100):
        return False
    for idx in (0, 1, 9):
        positions = snap[idx]
        if not isinstance(positions, list) or len(positions) > 10000:
            return False
        for pos in positions:
            if not _validate_net_cell(pos, bw, bh):
                return False
    if not _validate_net_direction(snap[2]) or not _validate_net_direction(snap[3]):
        return False
    if not isinstance(snap[4], (int, float)) or isinstance(snap[4], bool):
        return False
    if not isinstance(snap[5], (int, float)) or isinstance(snap[5], bool):
        return False
    if not isinstance(snap[6], bool) or not isinstance(snap[7], bool):
        return False
    if snap[8] is not None and not _validate_net_cell(snap[8], bw, bh):
        return False
    if not isinstance(snap[10], bool):
        return False
    if snap[11] not in (None, 1, 2, 'draw', 'coop_win', 'coop_lose'):
        return False
    if snap[14] not in ('1v1', 'coop'):
        return False
    return len(snap) < 16 or isinstance(snap[15], str)


def _validate_net_state_message(msg):
    if not isinstance(msg, dict) or msg.get('t') != 'state':
        return False
    try:
        bw, bh = int(msg.get('bw', 0)), int(msg.get('bh', 0))
    except (TypeError, ValueError):
        return False
    if not (5 <= bw <= 100 and 5 <= bh <= 100):
        return False
    for key in ('p1', 'p2', 'obs'):
        if not isinstance(msg.get(key, []), list) or len(msg.get(key, [])) > 10000:
            return False
        for pos in msg.get(key, []):
            if not _validate_net_cell(pos, bw, bh):
                return False
    if msg.get('f') is not None and not _validate_net_cell(msg.get('f'), bw, bh):
        return False
    snap = msg.get('snap')
    if snap is not None and not _validate_net_snapshot(snap):
        return False
    if msg.get('ft') is not None and not isinstance(msg.get('ft'), str):
        return False
    if not isinstance(msg.get('a1', True), bool) or not isinstance(msg.get('a2', True), bool):
        return False
    if not isinstance(msg.get('go', False), bool):
        return False
    if msg.get('w') not in (None, 1, 2, 'draw', 'coop_win', 'coop_lose'):
        return False
    for score_key in ('s1', 's2'):
        if not isinstance(msg.get(score_key, 0), (int, float)) or isinstance(msg.get(score_key, 0), bool):
            return False
    return True


def _net_send(sock, msg):
    """Send one length-prefixed JSON message, enforcing the SGF wire limit."""
    if not isinstance(msg, dict):
        raise TypeError('network messages must be dicts')
    wire = dict(msg)
    wire.setdefault('v', NET_PROTOCOL_VERSION)
    data = json.dumps(wire, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
    if len(data) > NET_MAX_FRAME:
        raise _NetProtocolError(f'outgoing frame exceeds {NET_MAX_FRAME} bytes')
    sock.sendall(struct.pack('!I', len(data)) + data)


def _net_recv(sock):
    """Receive one framed message.

    Clean EOF returns None. Malformed framing/JSON/version is a protocol error
    so callers can distinguish remote bad input from an expected disconnect.
    """
    def _exact(n):
        buf = b''
        while len(buf) < n:
            chunk = sock.recv(n - len(buf))
            if not chunk:
                return None
            buf += chunk
        return buf

    raw_len = _exact(4)
    if raw_len is None:
        return None
    length = struct.unpack('!I', raw_len)[0]
    if length <= 0 or length > NET_MAX_FRAME:
        raise _NetProtocolError(f'invalid frame length: {length}')
    data = _exact(length)
    if data is None:
        return None
    try:
        msg = json.loads(data.decode('utf-8'))
    except (json.JSONDecodeError, UnicodeDecodeError) as exc:
        raise _NetProtocolError(f'malformed JSON payload: {exc}') from exc
    if not isinstance(msg, dict):
        raise _NetProtocolError('network payload must be a JSON object')
    version = msg.get('v', 1)  # backward compatible with pre-v1 peers
    if version != NET_PROTOCOL_VERSION:
        raise _NetProtocolError(f'unsupported protocol version: {version!r}')
    return msg

def _get_local_ips():
    """Return a de-duplicated list of likely LAN IPv4 addresses."""
    seen = {}
    # Method 1: route-based (works for Wi-Fi, Ethernet, USB-tethering)
    for target in ('8.8.8.8', '192.168.0.1', '10.0.0.1'):
        try:
            s = _socket_mod.socket(_socket_mod.AF_INET, _socket_mod.SOCK_DGRAM)
            s.connect((target, 80))
            ip = s.getsockname()[0]
            s.close()
            if ip and not ip.startswith('127.'):
                seen[ip] = True
        except Exception:
            pass
    # Method 2: hostname resolution
    try:
        for info in _socket_mod.getaddrinfo(_socket_mod.gethostname(), None):
            ip = info[4][0]
            if ip and not ip.startswith('127.') and ':' not in ip:
                seen[ip] = True
    except Exception:
        pass
    return list(seen.keys())


