    def _system_stats_uncached(self, screen):
        info = pygame.display.Info() if pygame.get_init() and pygame.display.get_init() else None
        refresh = None
        try:
            refresh = pygame.display.get_current_refresh_rate()
        except Exception:
            refresh = None
        renderer = None
        try:
            renderer = pygame.display.get_driver()
        except Exception:
            pass
        audio_driver = None
        try:
            # pygame exposes mixer version, not necessarily the OS audio driver.
            audio_driver = 'available' if pygame.mixer.get_init() else 'N/A'
        except Exception:
            audio_driver = 'N/A'
        total_ram = None
        try:
            if sys.platform.startswith('linux'):
                with open('/proc/meminfo', 'r', encoding='utf-8', errors='replace') as f:
                    for line in f:
                        if line.startswith('MemTotal:'):
                            total_ram = f'{int(line.split()[1]) / 1024.0:.0f} MB'
                            break
            else:
                import psutil as _psutil
                total_ram = f'{_psutil.virtual_memory().total / 1024.0 / 1024.0:.0f} MB'
        except Exception:
            total_ram = 'N/A'
        return {
            'OS': _platform_mod.platform(),
            'Architecture': _platform_mod.machine() or 'N/A',
            'CPU': _platform_mod.processor() or 'N/A',
            'GPU': 'N/A',
            'Total RAM': total_ram,
            'Python': sys.version.split()[0],
            'Pygame': getattr(getattr(pygame, 'version', None), 'ver', 'N/A'),
            'Resolution': f'{screen.get_width()}x{screen.get_height()}' if screen else 'N/A',
            'Refresh rate': _dev_safe_text(refresh),
            'VSync': _dev_safe_text(getattr(info, 'current_h', None) if False else None),
            'Fullscreen': 'YES' if _is_fullscreen else 'NO',
            'Renderer': _dev_safe_text(renderer),
            'Audio driver': _dev_safe_text(audio_driver),
        }

