    def draw_color_grid(self, area, current_color, label):
        """Snake colour swatches in a wrapping grid with a live preview below.
        `area` gives x, y and the available width; returns [(rect, color)]."""
        lang = self.settings.language
        if area.w < 60:
            return []
        label_surface = render_fit(get_font(lang, 'regular', 20), label,
                                   COLORS['white'], area.w, padding=0)
        self.screen.blit(label_surface, (area.x, area.y - 30))
        gap = 6
        size = max(22, min(34, (area.w - 5 * gap) // 6))
        columns = max(1, (area.w + gap) // (size + gap))
        rects = []
        for index, (_name, color) in enumerate(COLOR_OPTIONS.items()):
            row, col = divmod(index, columns)
            rect = pygame.Rect(area.x + col * (size + gap),
                               area.y + row * (size + gap), size, size)
            pygame.draw.rect(self.screen, color, rect, border_radius=5)
            if tuple(current_color) == tuple(color):
                pygame.draw.rect(self.screen, COLORS['white'], rect, width=3, border_radius=5)
            rects.append((rect, color))
        rows = (len(COLOR_OPTIONS) + columns - 1) // columns
        preview_y = area.y + rows * (size + gap) + 10
        body_color = tuple(current_color)
        head_color = tuple(min(255, int(c) + 60) for c in body_color)
        seg = max(16, size - 6)
        for i in range(5):
            seg_rect = pygame.Rect(area.x + i * (seg + 3), preview_y, seg, seg)
            if seg_rect.right > area.right:
                break
            pygame.draw.rect(self.screen, head_color if i == 0 else body_color,
                             seg_rect, border_radius=5)
        return rects

