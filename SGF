    """Load standalone .json maps from SGF Data/maps/imported/."""
    maps = {}
    path = _imported_maps_dir()
    try:
        for filename in sorted(os.listdir(path)):
            if not filename.lower().endswith('.json'):
                continue
            full = os.path.join(path, filename)
            try:
                with open(full, 'r', encoding='utf-8') as f:
                    data = json.load(f)
                if not _validate_net_map(data):
                    continue
                name = str(data.get('name') or os.path.splitext(filename)[0]).strip() or filename
