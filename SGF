def _copy_to_clipboard(text):
    """Best-effort clipboard copy. Uses pygame.scrap where available; silently
    does nothing if the platform/build doesn't support it (the seed is always
    shown on-screen too, so the player can still note it down manually)."""
    try:
        if not pygame.scrap.get_init():
            pygame.scrap.init()
        pygame.scrap.put(pygame.SCRAP_TEXT, text.encode('utf-8'))
        return True
    except Exception:
        try:
            import tkinter as _tk
            _r = _tk.Tk()
            _r.withdraw()
            _r.clipboard_clear()
            _r.clipboard_append(text)
            _r.update()
            _r.destroy()
            return True
        except Exception:
            return False


def _toggle_fullscreen(screen):
    """Toggle between windowed and fullscreen. Returns the new screen surface.

    Uses SDL2's "fullscreen desktop" mode (borderless, matches the current
    desktop resolution) rather than exclusive fullscreen. Exclusive
    fullscreen actually changes the monitor's video mode at the OS level,
    which is what caused other windows to lose their maximized state and
    the whole desktop to flicker/rearrange on Windows.

    We explicitly query the real desktop resolution via pygame.display.Info()
    rather than relying on the "(0, 0) means use current size" shorthand —
    that shorthand isn't reliably honored on every platform/SDL build, and
    when it silently fails you get a tiny/oddly-placed window instead of
    real fullscreen (with the window's title bar and desktop still visible
    around it), rather than a clean error.
    """
    global _is_fullscreen, _windowed_size, _windowed_pos
    if _is_fullscreen:
        _is_fullscreen = False
        if _windowed_pos is not None:
            try:
                os.environ['SDL_VIDEO_WINDOW_POS'] = f"{_windowed_pos[0]},{_windowed_pos[1]}"
            except Exception:
                pass
        new_screen = pygame.display.set_mode(_windowed_size, pygame.RESIZABLE)
    else:
        _windowed_size = screen.get_size()
        try:
            _windowed_pos = pygame.display.get_window_position()
        except Exception:
            _windowed_pos = None
        _is_fullscreen = True
        try:
            desktop_sizes = pygame.display.get_desktop_sizes()
            target_size = desktop_sizes[0] if desktop_sizes else None
        except Exception:
            target_size = None
        if not target_size:
            try:
                info = pygame.display.Info()
                target_size = (info.current_w, info.current_h)
            except Exception:
                target_size = (0, 0)  # last-resort fallback to the old shorthand
        new_screen = pygame.display.set_mode(target_size, pygame.FULLSCREEN)
    pygame.display.flip()
    return new_screen

