def _cloudflare_status_text(language, state, detail=''):
    labels = _CLOUDFLARE_STATUS_LABELS.get(language, _CLOUDFLARE_STATUS_LABELS['en'])
    index = {'checking': 0, 'downloading': 1, 'starting': 2,
             'verifying': 3, 'ready': 4, 'unavailable': 5}.get(state)
    if index is None:
        return ''
    # Process/download diagnostics can contain platform-specific paths or
    # untranslated dependency messages. Keep the player-facing state clear and
    # localized; details remain available in the session's diagnostics.
    return labels[index]


