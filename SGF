def _toggle_fullscreen(screen):
    """Toggle between windowed and fullscreen. Returns the new screen surface."""
    global _is_fullscreen, _windowed_size
    if _is_fullscreen:
        _is_fullscreen = False
        new_screen = pygame.display.set_mode(_windowed_size, pygame.RESIZABLE)
    else:
        _windowed_size = screen.get_size()
        _is_fullscreen = True
        info = pygame.display.Info()
        w, h = info.current_w, info.current_h
        new_screen = pygame.display.set_mode(
            (w, h),
            pygame.FULLSCREEN | pygame.HWSURFACE | pygame.DOUBLEBUF
        )
    pygame.display.flip()
    return new_screen

