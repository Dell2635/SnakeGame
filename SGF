    def _draw_metric_overlay(self, surface):
        if not self.active:
            return
        # The in-game overlay only displays the latest two readings. A full
        # telemetry snapshot computes sorted rolling summaries for every
        # metric and is unnecessary on this per-frame path.
        latest = self.telemetry.samples[-1] if self.telemetry.samples else {}
        rows = [
            ('FPS', latest.get('fps')), ('Frame', latest.get('frame_ms')),
        ]
        y = 42
        for label, val in rows:
            if val is None:
                continue
            if label == 'FPS':
                s = f'{label} {val:.1f}'
            else:
                s = f'{label} {val:.2f} ms'
            font = get_font('en', 'bold', 14)
            surf = font.render(s, True, COLORS['white'])
            surface.blit(surf, (surface.get_width() - surf.get_width() - 12, y))
            y += 18

