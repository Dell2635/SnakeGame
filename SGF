    def _update_prompt_tick(self):
        """Offer a found update once per session, from the main menu only."""
        checker = getattr(self, '_update_checker', None)
        if checker is None or checker.prompted or checker.result is None:
            return
        checker.prompted = True
        info = checker.result
        if (info.get('status') == 'available'
                and (info.get('installed') or info.get('staged')
                     or info.get('version') != _load_update_state().get('skipped_version'))):
            screen = UpdateAvailableScreen(self.settings, self.screen, checker)
            self._run_sub(screen.run, name='update_available', owner=screen)
            self._update_maybe_restart()

