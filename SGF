class SoundManager:
    """Generates and plays simple synthesized sound effects using pygame.mixer."""
    def __init__(self):
        self._sounds = {}
        self._enabled = True
        self._sfx_enabled = True
        self._bgm_sound = None
        self._bgm_channel = None
        self._bgm_channels = []
        self._bgm_sounds = {}
        self._bgm_context = 'menu'
        self._bgm_track_key = None
        self._bgm_playlist = False
        self._bgm_playing_context = None
        self._bgm_volume = 0.0
        self._music_track_cursors = {}
        self._bgm_ready = _queue_mod.Queue()
        self._bgm_building = set()
        self._bgm_build_lock = threading.Lock()
        try:
            if not pygame.mixer.get_init():
                pygame.mixer.init(frequency=22050, size=-16, channels=1, buffer=512)
            pygame.mixer.set_reserved(2)
            self._bgm_channels = [pygame.mixer.Channel(0), pygame.mixer.Channel(1)]
            self._build()
            event_bus = globals().get('EVENT_BUS')
            if event_bus is not None:
                event_bus.subscribe('THEME_CHANGED', self._on_audio_content_changed)
                event_bus.subscribe('MOD_LOADED', self._on_audio_content_changed)
                event_bus.subscribe('MOD_UNLOADED', self._on_audio_content_changed)
        except Exception:
            self._enabled = False

    @staticmethod
    def _wave(freq, dur_ms, vol=0.45, rate=22050):
        import struct
        n = int(rate * dur_ms / 1000)
        data = [int(32767 * vol * math.sin(2 * math.pi * freq * i / rate)) for i in range(n)]
        # short fade-out to remove click
        fade = min(n, int(rate * 0.02))
        for i in range(fade):
            data[n - 1 - i] = int(data[n - 1 - i] * (i / fade))
        return struct.pack('<' + 'h' * n, *data)

    def _build(self):
        specs = {
            'eat':      (880, 80,  0.40),
            'eat_gold': (1047,120, 0.50),
            'click':    (660, 50,  0.25),
            'powerup':  (528, 200, 0.45),
            'portal':   (330, 180, 0.40),
            'gameover': (220, 500, 0.50),
            'victory':  (784, 400, 0.55),
            'levelup':  (698, 250, 0.50),
            'combo':    (1175,100, 0.45),
        }
        for name, (f, d, v) in specs.items():
            try:
                self._sounds[name] = pygame.mixer.Sound(buffer=self._wave(f, d, v))
            except Exception:
                pass

    def play(self, name):
        if name in ('gameover', 'victory'):
            self.set_music_context('game_over')
        if self._enabled and self._sfx_enabled:
            try:
                s = self._sounds.get(name)
                if s:
                    s.play()
            except Exception:
                pass

    @staticmethod
    def _build_bgm_buffer(rate=22050, step_ms=220):
        """Compose an 8-bar loop with changing harmony, bass and plucked lead."""
        from array import array
        chords = ((130.81, 164.81, 196.00), (110.00, 130.81, 164.81),
                  (174.61, 220.00, 261.63), (196.00, 246.94, 293.66))
        melody = (523.25, 0, 659.25, 783.99, 659.25, 0, 587.33, 523.25,
                  440.00, 0, 523.25, 659.25, 587.33, 0, 523.25, 440.00,
                  392.00, 0, 523.25, 659.25, 783.99, 0, 659.25, 523.25,
                  493.88, 0, 587.33, 659.25, 587.33, 523.25, 493.88, 392.00,
                  523.25, 0, 659.25, 880.00, 783.99, 0, 659.25, 587.33,
                  440.00, 0, 523.25, 659.25, 698.46, 0, 659.25, 523.25,
                  392.00, 0, 523.25, 659.25, 783.99, 0, 880.00, 783.99,
                  587.33, 0, 523.25, 493.88, 523.25, 587.33, 659.25, 523.25)
        n_step = int(rate * step_ms / 1000)
        total_n = n_step * len(melody)
        # Build each required oscillator once per note-step. The older version
        # called sin() 7+ times for every audio sample, causing a visible pause
        # on first play and every context switch. Recurrence keeps audio
        # preparation bounded and avoids repeated transcendental operations.
        def tone(frequency):
            angle = 2 * math.pi * frequency / rate
            step_sin, step_cos = math.sin(angle), math.cos(angle)
            current_sin, current_cos = 0.0, 1.0
            samples = array('f')
            for _ in range(n_step):
                samples.append(current_sin)
                current_sin, current_cos = (
                    current_sin * step_cos + current_cos * step_sin,
                    current_cos * step_cos - current_sin * step_sin)
            return samples

        chord_waves = []
        bass_waves = []
        for chord in chords:
            fundamentals = [tone(f) for f in chord]
            harmonics = [tone(f * 2) for f in chord]
            chord_waves.append(array('f', (
                .035 * fundamentals[0][i] + .009 * harmonics[0][i] +
                .035 * fundamentals[1][i] + .009 * harmonics[1][i] +
                .035 * fundamentals[2][i] + .009 * harmonics[2][i]
                for i in range(n_step))))
            bass_waves.append(tone(chord[0] / 2))
        lead_waves = {}
        for frequency in {f for f in melody if f}:
            fundamental, harmonic, overtone = tone(frequency), tone(frequency * 2), tone(frequency * 3)
            lead_waves[frequency] = array('f', (
                .16 * fundamental[i] + .035 * harmonic[i] + .012 * overtone[i]
                for i in range(n_step)))
        attack = max(1, int(rate * .012))
        release = max(1, int(rate * .035))
        fade = array('f', (min(1.0, i / attack, max(0.0, (n_step-i) / release))
                           for i in range(n_step)))
        bass_decay = array('f', (max(0.0, 1.0 - (i / rate) / .19)
                                 for i in range(n_step)))
        data = array('f', [0.0]) * total_n
        for step_i, lead in enumerate(melody):
            chord_i = (step_i // 8) % len(chords)
            accompaniment = chord_waves[chord_i]
            bass = bass_waves[chord_i]
            lead_wave = lead_waves.get(lead)
            base = step_i * n_step
            for i in range(n_step):
                layer = accompaniment[i]
                if step_i % 2 == 0:
                    layer += .075 * bass[i] * bass_decay[i]
                if lead_wave is not None:
                    layer += lead_wave[i]
                data[base+i] = fade[i] * layer

        # Defensive normalize, then pack as 16-bit PCM
        peak = max(0.001, max(abs(x) for x in data))
        scale = min(1.0, 0.9 / peak)
        ints = [int(max(-32767, min(32767, x * scale * 32767))) for x in data]
        return struct.pack('<' + 'h' * total_n, *ints)

    def _ensure_bgm(self, context='menu'):
        tempos = {'menu': 242, 'tutorial': 270, 'gameplay': 190,
                  'multiplayer': 190, 'studio': 242, 'mods': 242,
                  'credits': 260, 'game_over': 300}
        key = f'builtin:{context}'
        if key not in self._bgm_sounds and self._enabled:
            with self._bgm_build_lock:
                if key not in self._bgm_building and key not in self._bgm_sounds:
                    self._bgm_building.add(key)
                    worker = threading.Thread(
                        target=self._prepare_bgm_bytes,
                        args=(key, tempos.get(context, 220)),
                        name=f'sgf-music-{context}', daemon=True)
                    worker.start()
        return self._bgm_sounds.get(key)

    def _prepare_bgm_bytes(self, key, step_ms):
        """Pure-Python buffer preparation; no Pygame calls run on the worker."""
        try:
            result = self._build_bgm_buffer(step_ms=step_ms)
        except Exception as exc:
            result = exc
        self._bgm_ready.put((key, result))

    def pump_audio(self):
        """Finish decoded music on the main thread and start the latest context."""
        updated = False
        while True:
            try:
                key, result = self._bgm_ready.get_nowait()
            except _queue_mod.Empty:
                break
            with self._bgm_build_lock:
                self._bgm_building.discard(key)
            if isinstance(result, Exception):
                sgf_log.warning('Built-in music preparation failed: %s', result)
                self._bgm_sounds[key] = None
                continue
            try:
                self._bgm_sounds[key] = pygame.mixer.Sound(buffer=result)
                updated = True
            except Exception as exc:
                sgf_log.warning('Built-in music decode failed: %s', exc)
                self._bgm_sounds[key] = None
        desired_key = f'builtin:{self._bgm_context}'
        if (updated and self._bgm_volume > 0 and self._bgm_track_key != desired_key and
                self._bgm_sounds.get(desired_key) is not None):
            self.set_music_context(self._bgm_context)
        if (self._enabled and self._bgm_volume > 0 and self._bgm_playlist and
                self._bgm_playing_context == self._bgm_context and
                self._bgm_channel is not None and not self._bgm_channel.get_busy()):
            context = self._bgm_context
            self._music_track_cursors[context] = self._music_track_cursors.get(context, 0) + 1
            self.set_music_context(context)

    def _on_audio_content_changed(self, payload):
        if self._bgm_volume > 0:
            self.set_music_context(self._bgm_context)

    def _resolve_external_bgm(self, context):
        # Theme sound manifests accept context -> asset id/descriptor/list.
        # Optional or invalid tracks fall back to the built-in soundtrack.
        try:
            spec = THEME_MANAGER.get('sounds.music', {})
            if isinstance(spec, dict) and isinstance(spec.get('tracks'), list):
                raw = []
                for track in spec['tracks']:
                    if not isinstance(track, dict):
                        continue
                    contexts = track.get('contexts', ['*'])
                    if isinstance(contexts, str):
                        contexts = [contexts]
                    if isinstance(contexts, list) and any(
                            isinstance(value, str) and value in ('*', context)
                            for value in contexts):
                        raw.append(track)
            elif isinstance(spec, dict) and 'asset' in spec:
                raw = spec
            else:
                raw = (spec if isinstance(spec, (str, list)) else
                       spec.get(context, spec.get('default', spec.get('*')))
                       if isinstance(spec, dict) else None)
            entries = raw if isinstance(raw, list) else [raw]
            candidates = []
            for entry in entries:
                descriptor = entry if isinstance(entry, dict) else {'asset': entry}
                asset_id = descriptor.get('asset')
                license_id = descriptor.get('license') or THEME_MANAGER.get('license')
                owner = ASSET_MANAGER.owner_of(asset_id) if isinstance(asset_id, str) else None
                path = ASSET_MANAGER.resolve(asset_id) if isinstance(asset_id, str) else None
                if (not isinstance(license_id, str) or not license_id.strip() or
                        not isinstance(owner, str) or not owner.startswith('theme:') or
                        not path or os.path.getsize(path) > 4 * 1024 * 1024):
                    continue
                sound = ASSET_MANAGER.get_sound(asset_id)
                gain = float(descriptor.get('volume', 1.0))
                if (sound is not None and 1.5 <= sound.get_length() <= 240 and
                        math.isfinite(gain) and 0.0 <= gain <= 1.0):
                    candidates.append((f'theme:{THEME_MANAGER.active_theme_id}:{asset_id}', sound, gain))
            if candidates:
                index = self._music_track_cursors.get(context, 0) % len(candidates)
                key, sound, gain = candidates[index]
                return key, sound, gain, len(candidates) > 1
        except Exception as exc:
            sgf_log.warning('Optional theme music was skipped: %s', exc)

        # A mod can declare {"music":{"tracks":[{"asset":..., "contexts": [...],
        # "license":..., "volume": 0..1}]}}. It must own the referenced
        # registered asset and provide its license; scripts are never run.
        manager = globals().get('MOD_MANAGER')
        if manager is not None:
            candidates = []
            for mod_id in sorted(getattr(manager, 'active', ())):
                manifest = getattr(manager, 'discovered', {}).get(mod_id)
                music = getattr(manifest, 'data', {}).get('music') if manifest else None
                tracks = music.get('tracks', []) if isinstance(music, dict) else music
                if not isinstance(tracks, list):
                    continue
                for track in tracks:
                    if not isinstance(track, dict):
                        continue
                    contexts = track.get('contexts', ['*'])
                    if isinstance(contexts, str):
                        contexts = [contexts]
                    if (not isinstance(contexts, list) or not any(
                            entry in ('*', context) for entry in contexts
                            if isinstance(entry, str))):
                        continue
                    asset_id, license_id = track.get('asset'), track.get('license')
                    if (not isinstance(asset_id, str) or not asset_id.strip() or
                            not isinstance(license_id, str) or not license_id.strip() or
                            ASSET_MANAGER.owner_of(asset_id) != f'mod:{mod_id}'):
                        continue
                    try:
                        path = ASSET_MANAGER.resolve(asset_id)
                        if not path or os.path.getsize(path) > 4 * 1024 * 1024:
                            continue
                        sound = ASSET_MANAGER.get_sound(asset_id)
                        gain = float(track.get('volume', 1.0))
                        if (sound is not None and 1.5 <= sound.get_length() <= 240 and
                                math.isfinite(gain) and 0.0 <= gain <= 1.0):
                            candidates.append((f'mod:{mod_id}:{asset_id}', sound, gain))
                    except Exception as exc:
                        sgf_log.warning('Optional mod music track was skipped: %s', exc)
            if candidates:
                index = self._music_track_cursors.get(context, 0) % len(candidates)
                key, sound, gain = candidates[index]
                return key, sound, gain, len(candidates) > 1
        return None

    def set_music_context(self, context, volume=None):
        """Switch context once with a short crossfade; safe to call repeatedly."""
        allowed = {'menu', 'gameplay', 'tutorial', 'multiplayer', 'game_over',
                   'studio', 'mods', 'credits'}
        context = str(context or 'menu').strip().lower()
        if context not in allowed:
            context = 'menu'
        if context != self._bgm_context:
            self._music_track_cursors[context] = self._music_track_cursors.get(context, -1) + 1
        self._bgm_context = context
        if volume is not None:
            self._bgm_volume = _normalize_sound_fraction(volume)
        if not self._enabled or self._bgm_volume <= 0:
            self.stop_bgm()
            return
        try:
            external = self._resolve_external_bgm(context)
            if external:
                key, sound, gain, *playlist_state = external
                playlist = bool(playlist_state[0]) if playlist_state else False
            else:
                key, sound, gain = f'builtin:{context}', self._ensure_bgm(context), 1.0
                playlist = False
            if sound is None:
                # Built-in buffers are prepared away from the UI thread. Keep
                # the previous context audible until the new one is ready.
                self._bgm_playlist = False
                self.pump_audio()
                return
            if key == self._bgm_track_key and self._bgm_channel is not None and self._bgm_channel.get_busy():
                self._bgm_channel.set_volume(self._bgm_volume * gain)
                return
            old = next((ch for ch in self._bgm_channels if ch is self._bgm_channel), None)
            new = next((ch for ch in self._bgm_channels if ch is not old), None)
            if new is None:
                return
            if old is not None:
                old.fadeout(450)
            sound.set_volume(self._bgm_volume * gain)
            new.play(sound, loops=0 if playlist else -1, fade_ms=450)
            self._bgm_channel = new
            self._bgm_sound = sound
            self._bgm_track_key = key
            self._bgm_playlist = playlist
            self._bgm_playing_context = context
        except Exception as exc:
            sgf_log.warning('Music context %s failed: %s', context, exc)

    def play_bgm(self, volume=0.5):
        """Start looping background music if it isn't already playing.
        Safe to call repeatedly — a no-op if it's already running."""
        if not self._enabled:
            return
        self.set_music_context(self._bgm_context,
                               volume=_normalize_sound_fraction(volume, 0.5))

    def stop_bgm(self):
        try:
            for channel in self._bgm_channels:
                channel.stop()
        except Exception:
            pass
        finally:
            self._bgm_channel = None
            self._bgm_track_key = None
            self._bgm_playlist = False
            self._bgm_playing_context = None
            self._bgm_volume = 0.0

    def set_bgm_volume(self, volume):
        volume = _normalize_sound_fraction(volume)
        self._bgm_volume = volume
        try:
            if self._bgm_channel:
                self._bgm_channel.set_volume(volume)
            if self._bgm_sound:
                self._bgm_sound.set_volume(volume)
        except Exception:
            pass

    def set_sfx_state(self, enabled, volume):
        self._sfx_enabled = _normalize_sound_toggle(enabled, True)
        volume = _normalize_sound_fraction(volume)
        for sound in self._sounds.values():
            try:
                sound.set_volume(volume)
            except Exception:
                pass

# Module-level sound manager (lazily initialised)
_SOUND_MGR = None


def _normalize_sound_percent(value, default=80):
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        value = default
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        value = 80
    if isinstance(value, float) and not math.isfinite(value):
        value = default
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        value = 80
    if isinstance(value, float) and not math.isfinite(value):
        value = 80
    if value <= 0:
        return 0
    if value >= 100:
        return 100
    return int(round(value))


def _normalize_sound_toggle(value, default):
    return value if type(value) is bool else bool(default)


def _normalize_sound_fraction(value, default=0.0):
    try:
        value = float(value)
    except (TypeError, ValueError, OverflowError):
        value = float(default)
    if not math.isfinite(value):
        value = float(default)
    return max(0.0, min(1.0, value))

def sounds():
    global _SOUND_MGR
    if _SOUND_MGR is None:
        _SOUND_MGR = SoundManager()
    return _SOUND_MGR


def _pump_audio():
    manager = _SOUND_MGR
    if manager is not None:
        manager.pump_audio()


def _apply_sfx_state(settings):
    """Apply the master and effects volume to sound effects."""
    try:
        sounds().set_sfx_state(
            _normalize_sound_toggle(getattr(settings, 'sfx_enabled', True), True),
            (_normalize_sound_percent(getattr(settings, 'master_volume', 80)) *
             _normalize_sound_percent(getattr(settings, 'sfx_volume', 100), 100) /
             10000.0),
        )
    except Exception:
        pass


def _apply_bgm_state(settings):
    """Start or stop background music to match current settings. Safe to
    call anytime — on startup, or right after Settings are saved — so a
    toggle takes effect immediately without needing a restart."""
    try:
        mgr = sounds()
        if _normalize_sound_toggle(getattr(settings, 'bgm_enabled', False), False):
            volume = (_normalize_sound_percent(getattr(settings, 'master_volume', 80)) *
                      _normalize_sound_percent(getattr(settings, 'bgm_volume', 100), 100) /
                      10000.0) * 0.5
            mgr.play_bgm(volume=volume)
        else:
            mgr.stop_bgm()
    except Exception:
        pass

def draw_apple(surface, rect, color=(255, 50, 50)):
    """Draw a realistic apple texture"""
    # Draw the main apple body
    pygame.draw.circle(surface, color, rect.center, rect.width // 2 - 2)
    
    # Add some shading to create a 3D effect
    darker_color = (max(0, color[0] - 60), max(0, color[1] - 60), max(0, color[2] - 60))
    shadow_rect = pygame.Rect(rect.centerx - rect.width // 4, rect.centery, rect.width // 2, rect.height // 2)
    pygame.draw.ellipse(surface, darker_color, shadow_rect)
    
    # Add a small indentation at the top (where the stem goes)
    indent_rect = pygame.Rect(rect.centerx - 3, rect.top + 2, 6, 4)
    pygame.draw.ellipse(surface, darker_color, indent_rect)
    
    # Draw a stem
    stem_rect = pygame.Rect(rect.centerx - 2, rect.top + 1, 4, 7)
    pygame.draw.rect(surface, (101, 67, 33), stem_rect, border_radius=1)  # Brown stem
    
    # Draw a leaf
    leaf_points = [
        (rect.centerx + 2, rect.top + 6),
        (rect.centerx + 8, rect.top + 3),
        (rect.centerx + 4, rect.top)
    ]
    pygame.draw.polygon(surface, (50, 205, 50), leaf_points)  # Green leaf
    
    # Add highlight for shininess
    highlight_pos = (rect.centerx - rect.width // 6, rect.centery - rect.height // 4)
    highlight_radius = max(2, rect.width // 10)
    pygame.draw.circle(surface, (255, 255, 255, 150), highlight_pos, highlight_radius)

