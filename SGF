def _daily_challenge_for_date(challenge_date=None):
    """Return deterministic daily rules and a shared pace for its ISO week."""
    if challenge_date is None:
        challenge_date = datetime.now(_datetime_timezone.utc).date()
    elif isinstance(challenge_date, datetime):
        challenge_date = challenge_date.date()
    date_text = challenge_date.isoformat()
    digest = hashlib.sha256(f'SGF:daily:v2:{date_text}'.encode('ascii')).hexdigest()
    week_start = challenge_date - timedelta(days=challenge_date.weekday())
    week_text = week_start.isoformat()
    weekly_digest = hashlib.sha256(
        f'SGF:weekly-pace:v1:{week_text}'.encode('ascii')).hexdigest()
    weekly_profiles = (('calm', 175), ('steady', 150), ('quick', 125))
    weekly_modifier, weekly_speed = weekly_profiles[
        int(weekly_digest[:8], 16) % len(weekly_profiles)]
    variants = (
        ('classic', {'wall_collision': True, 'powerups_enabled': False,
                     'enable_obstacles': False}),
        ('wrap_walls', {'wall_collision': False, 'powerups_enabled': False,
                        'enable_obstacles': False}),
        ('obstacles', {'wall_collision': True, 'powerups_enabled': False,
                       'enable_obstacles': True}),
    )
    modifier, modifier_rules = variants[int(digest[:8], 16) % len(variants)]
    rules = {
        'board_size': 20, 'update_rate_ms': weekly_speed,
        'fruit_types_enabled': False, 'enable_portals': False,
        'portal_pairs': 0, 'obstacle_count': 8 if modifier == 'obstacles' else 0,
        **modifier_rules,
    }
    return {
        'challenge_id': f'daily-v2-{date_text}', 'challenge_version': 2,
        'date': date_text, 'seed': f'SGF-{digest[8:24]}',
        'mode': 'single_player', 'modifier': modifier,
        'weekly_modifier': weekly_modifier, 'week_start': week_text, 'rules': rules,
        'map': None,
    }


