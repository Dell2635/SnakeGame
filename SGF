_MODDING_GUIDE_LABELS = {
    'en': ('Modding Guide', 'Create a folder inside Mods and add mod.json or manifest.json. Include id, name, version, game_version, mod_api_version, dependencies, assets, configuration and type. Use supported assets, content and theme data, and request only the capabilities you need. Dependencies are checked before activation. Mods are declarative: SGF does not run arbitrary Python scripts. Reload, select and preview mods, then choose Apply; if validation or saving fails, the previous setup is restored.'),
