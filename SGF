            text = render_fit(label_font, f"{label} — {_format_bytes(size_bytes)}", COLORS['white'], row_rect.width - del_btn_w - 50, padding=0)
            self.screen.blit(text, (row_rect.x + 34, row_rect.y + 3))
            if cat_key == 'replays':
