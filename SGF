def _update_label(language, key, **values):
    table = _UPDATE_LABELS.get(language) or _UPDATE_LABELS['en']
    text = table.get(key) or _UPDATE_LABELS['en'].get(key, key)
    try:
        return text.format(**values) if values else text
    except (KeyError, IndexError, ValueError):
        return text


def _update_version_tuple(text):
    """'v1.2.3' / '1.2' -> (1, 2, 3) / (1, 2, 0); None when not a version."""
    match = re.fullmatch(r'[vV]?(\d+)(?:\.(\d+))?(?:\.(\d+))?(?:\.(\d+))?', str(text or '').strip())
    if not match:
        return None
    parts = [int(part) if part is not None else 0 for part in match.groups()]
    return tuple(parts)


def _update_is_newer(remote, local):
    remote_t, local_t = _update_version_tuple(remote), _update_version_tuple(local)
    return bool(remote_t and local_t and remote_t > local_t)


def _update_state_path():
    return os.path.join(_user_data_manager.get_config_dir(), 'update_state.json')


def _load_update_state():
    state = {'enabled': True, 'mode': 'auto', 'last_check': 0.0, 'skipped_version': ''}
    try:
        with open(_update_state_path(), 'r', encoding='utf-8') as handle:
            stored = json.load(handle)
        if isinstance(stored, dict):
            mode = stored.get('mode')
            if mode not in _UPDATE_MODES:
                mode = 'auto' if stored.get('enabled', True) else 'off'
            state['mode'] = mode
            state['enabled'] = mode != 'off'
            state['last_check'] = float(stored.get('last_check') or 0.0)
            skipped = stored.get('skipped_version')
            state['skipped_version'] = skipped if isinstance(skipped, str) else ''
    except (OSError, ValueError, TypeError):
        pass
    return state


def _save_update_state(state):
    try:
        mode = state.get('mode') if state.get('mode') in _UPDATE_MODES else (
            'auto' if state.get('enabled', True) else 'off')
        _atomic_write_json(_update_state_path(), {
            'version': 2, 'mode': mode, 'enabled': mode != 'off',
            'last_check': float(state.get('last_check') or 0.0),
            'skipped_version': str(state.get('skipped_version') or '')})
        return True
    except Exception as exc:
        _logging_mod.getLogger('sgf').warning('Could not save update state: %s', exc)
        return False


def _update_check_due(state, now=None):
    now = time.time() if now is None else now
    return bool(state.get('enabled', True)) and (
        now - float(state.get('last_check') or 0.0) >= _UPDATE_CHECK_INTERVAL_SECONDS)


def _update_http_get(url, headers, limit):
    """(status, body) for an https GET, reading at most `limit` bytes."""
    import urllib.request as _urlrequest
    import urllib.error as _urlerror
    if not url.startswith('https://'):
        raise ValueError('Only https URLs are allowed')
    request = _urlrequest.Request(url, headers=dict(headers, **{'User-Agent': 'SGF update check'}))
    try:
        with _urlrequest.urlopen(request, timeout=6.0) as response:
            return response.status, response.read(limit + 1)
    except _urlerror.HTTPError as exc:
        return exc.code, b''


def _update_release_candidate(body, frozen):
    release = json.loads(body.decode('utf-8'))
    if not isinstance(release, dict) or release.get('draft') or release.get('prerelease'):
        return None
    tag = str(release.get('tag_name') or '')
    if _update_version_tuple(tag) is None:
        return None
    page = str(release.get('html_url') or '')
    if not page.startswith(f'https://github.com/{GAME_UPDATE_REPO}/'):
        page = f'https://github.com/{GAME_UPDATE_REPO}/releases'
    asset, asset_url, sums_url = '', '', ''
    prefix = f'https://github.com/{GAME_UPDATE_REPO}/releases/download/'
    if frozen:
        for item in release.get('assets') or []:
            if not isinstance(item, dict):
                continue
            name = str(item.get('name') or '')
            link = str(item.get('browser_download_url') or '')
            if not link.startswith(prefix):
                continue
            if name.lower().endswith('.exe') and not asset:
                asset, asset_url = name, link
            elif name.lower() in ('sha256sums', 'sha256sums.txt', 'sha256sum.txt'):
                sums_url = link
    return {'version': tag.lstrip('vV'), 'source': 'release', 'url': page,
            'notes': str(release.get('body') or '').strip()[:600], 'asset': asset,
            'asset_url': asset_url, 'sums_url': sums_url}


def fetch_update_info(local_version=None, fetch=None, frozen=None):
    """Compare this game with the newest release (and, when running from
    source, with GAME_VERSION in the repository). Returns a dict with
    status 'available' | 'up_to_date' | 'error'. `fetch` is injectable."""
    local = local_version or GAME_VERSION
    fetch = fetch or _update_http_get
    frozen = bool(getattr(sys, 'frozen', False)) if frozen is None else frozen
    candidates, attempts, errors = [], 0, 0
    attempts += 1
    try:
        status, body = fetch(
            f'https://api.github.com/repos/{GAME_UPDATE_REPO}/releases/latest',
            {'Accept': 'application/vnd.github+json'}, 400000)
        if status == 200:
            candidate = _update_release_candidate(body, frozen)
            if candidate:
                candidates.append(candidate)
        elif status != 404:      # 404 simply means "no release published yet"
            errors += 1
    except Exception:
        errors += 1
    if not frozen:
        attempts += 1
        found = False
        for name in _UPDATE_SOURCE_FILES:
            try:
                status, body = fetch(
                    f'https://raw.githubusercontent.com/{GAME_UPDATE_REPO}/main/{name}',
                    {'Range': f'bytes=0-{_UPDATE_RANGE_BYTES - 1}'}, _UPDATE_RANGE_BYTES)
            except Exception:
                continue
            if status in (200, 206):
                match = _UPDATE_VERSION_RE.search(body.decode('utf-8', 'replace'))
                if match:
                    candidates.append({
                        'version': match.group(1), 'source': 'source',
                        'url': f'https://github.com/{GAME_UPDATE_REPO}', 'notes': '', 'asset': '',
                        'file': name})
                    found = True
                    break
        if not found:
            errors += 1
    if not candidates:
        return {'status': 'error' if errors >= attempts else 'up_to_date', 'local': local}
    best = max(candidates, key=lambda c: (_update_version_tuple(c['version']), c['source'] == 'release'))
    result = dict(best, local=local)
    result['status'] = 'available' if _update_is_newer(best['version'], local) else 'up_to_date'
    return result


def _update_target_script():
    """Path of the running script when it can be replaced, else None."""
    if getattr(sys, 'frozen', False):
        return None
    try:
        return os.path.abspath(__file__)
    except NameError:
        return None


def _update_install_blocker(frozen=None, script_path=None):
    """Why the game must not replace itself here (a reason key) or None."""
    frozen = bool(getattr(sys, 'frozen', False)) if frozen is None else frozen
    if frozen:
        return None if sys.platform == 'win32' else 'unsupported'
    path = script_path or _update_target_script()
    if not path:
        return 'unsupported'
    folder = os.path.dirname(path)
    if '_snake_game_runtime' in path.replace('\\', '/').split('/'):
        return 'launcher'          # a launcher re-extracts its own copy
    if os.path.isdir(os.path.join(folder, '.git')):
        return 'dev'               # never overwrite a development checkout
    if not os.access(folder, os.W_OK):
        return 'readonly'
    return None


def update_install_source(info, script_path, fetch=None):
    """Download the new script, verify it and replace `script_path`.
    Verified: https from the project's repository only, size limit, valid UTF-8
    and Python syntax, and the downloaded file must itself declare a version
    newer than the running one. The old script is kept as <name>.<old version>.bak.
    Returns (ok, reason_key)."""
    fetch = fetch or _update_http_get
    name = info.get('file') or os.path.basename(script_path)
    if name not in _UPDATE_SOURCE_FILES:
        return False, 'download'
    new_path = script_path + '.new'
    try:
        status, body = fetch(
            f'https://raw.githubusercontent.com/{GAME_UPDATE_REPO}/main/{name}', {}, _UPDATE_MAX_SOURCE_BYTES)
        if status != 200 or not body or len(body) > _UPDATE_MAX_SOURCE_BYTES:
            return False, 'download'
        text = body.decode('utf-8')
        match = _UPDATE_VERSION_RE.search(text)
        if not match or not _update_is_newer(match.group(1), info.get('local') or GAME_VERSION):
            return False, 'checksum'
        compile(text, 'SGF_update', 'exec')
        if 'GAME_VERSION' not in text or '__main__' not in text:
            return False, 'checksum'
        with open(new_path, 'wb') as handle:
            handle.write(body)
            handle.flush()
            os.fsync(handle.fileno())
        backup = f"{script_path}.{info.get('local') or GAME_VERSION}.bak"
        _shutil_mod.copy2(script_path, backup)
        os.replace(new_path, script_path)
        return True, ''
    except (SyntaxError, UnicodeDecodeError, ValueError):
        return False, 'checksum'
    except OSError as exc:
        _logging_mod.getLogger('sgf').warning('Update install failed: %s', exc)
        return False, 'readonly'
    except Exception as exc:
        _logging_mod.getLogger('sgf').warning('Update install failed: %s', type(exc).__name__)
        return False, 'download'
    finally:
        try:
            if os.path.exists(new_path):
                os.remove(new_path)
        except OSError:
            pass


def update_stage_release(info, exe_path, fetch=None):
    """Download the release .exe and verify its SHA-256 against the release's
    SHA256SUMS file. Without that file nothing is installed. The verified file
    is stored as <exe>.new and swapped in by update_restart_into_new()."""
    fetch = fetch or _update_http_get
    if not (info.get('asset_url') and info.get('sums_url')):
        return False, 'checksum'
    new_path = exe_path + '.new'
    try:
        status, sums = fetch(info['sums_url'], {}, 1024 * 1024)
        if status != 200:
            return False, 'checksum'
        expected = ''
        for line in sums.decode('utf-8', 'replace').splitlines():
            parts = line.replace('*', ' ').split()
            if len(parts) >= 2 and parts[-1] == info['asset']:
                expected = parts[0].lower()
        if not re.fullmatch(r'[0-9a-f]{64}', expected):
            return False, 'checksum'
        status, body = fetch(info['asset_url'], {}, _UPDATE_MAX_EXE_BYTES)
        if status != 200 or not body or len(body) > _UPDATE_MAX_EXE_BYTES:
            return False, 'download'
        if hashlib.sha256(body).hexdigest() != expected:
            return False, 'checksum'
        with open(new_path, 'wb') as handle:
            handle.write(body)
            handle.flush()
            os.fsync(handle.fileno())
        return True, ''
    except OSError:
        return False, 'readonly'
    except Exception as exc:
        _logging_mod.getLogger('sgf').warning('Update download failed: %s', type(exc).__name__)
        return False, 'download'


def update_restart():
    """Start the game again and leave this process (called after the UI has
    closed pygame). Source install: relaunch the script. Windows exe: a small
    batch file swaps <exe>.new in once this process has exited, then starts it."""
    if getattr(sys, 'frozen', False):
        exe = sys.executable
        if not os.path.exists(exe + '.new'):
            subprocess.Popen([exe])
            return
        bat = os.path.join(tempfile.gettempdir(), f'sgf_update_{os.getpid()}.bat')
        with open(bat, 'w', encoding='utf-8') as handle:
            handle.write(
                '@echo off\r\n'
                'for /L %%i in (1,1,60) do (\r\n'
                f'  move /Y "{exe}" "{exe}.old" >nul 2>&1 && goto swapped\r\n'
                '  timeout /t 1 /nobreak >nul\r\n'
                ')\r\n'
                'goto done\r\n'
                ':swapped\r\n'
                f'move /Y "{exe}.new" "{exe}" >nul 2>&1\r\n'
                ':done\r\n'
                f'start "" "{exe}"\r\n'
                'del "%~f0"\r\n')
        subprocess.Popen(['cmd', '/c', bat], creationflags=0x00000008 | 0x08000000, close_fds=True)
    else:
        subprocess.Popen([sys.executable] + sys.argv)


class UpdateChecker:
    """Runs fetch_update_info (and, in 'auto' mode, the install) on a worker
    thread; the UI only reads `result`."""

    def __init__(self, fetch=None):
        self.fetch = fetch
        self.result = None
        self.checking = False
        self.prompted = False
        self.installing = False
        self.restart_requested = False

    def install(self, info=None):
        """Install the update described by `info`; fills result['installed'],
        result['staged'] or result['install_error'] (a reason key)."""
        info = info or self.result
        if not info or info.get('status') != 'available':
            return False
        blocker = _update_install_blocker()
        if blocker:
            info['install_error'] = blocker
            return False
        self.installing = True
        try:
            if getattr(sys, 'frozen', False):
                ok, reason = update_stage_release(info, sys.executable, self.fetch)
                key = 'staged'
            else:
                ok, reason = update_install_source(info, _update_target_script(), self.fetch)
                key = 'installed'
            if ok:
                info[key] = True
                info.pop('install_error', None)
            else:
                info['install_error'] = reason
            return ok
        finally:
            self.installing = False

    def start(self, force=False):
        if os.environ.get('SGF_NO_UPDATE_CHECK') == '1' or self.checking:
            return False
        state = _load_update_state()
        if not force and not _update_check_due(state):
            return False
        self.checking, self.result = True, None

        def work():
            info = {'status': 'error', 'local': GAME_VERSION}
            try:
                info = fetch_update_info(fetch=self.fetch)
            except Exception as exc:
                _logging_mod.getLogger('sgf').warning('Update check failed: %s', type(exc).__name__)
            if info.get('status') != 'error':
                latest = _load_update_state()
                latest['last_check'] = time.time()
                _save_update_state(latest)
            if info.get('status') == 'available' and _load_update_state().get('mode') == 'auto':
                try:
                    self.install(info)
                except Exception as exc:
                    info['install_error'] = 'download'
                    _logging_mod.getLogger('sgf').warning('Auto update failed: %s', type(exc).__name__)
            self.result = info
            self.checking = False

        threading.Thread(target=work, name='update-check', daemon=True).start()
        return True


class UpdateAvailableScreen(_SimpleMenuScreen):
    """Shows the update state (checking / up to date / installed / available /
    offline) and the actions that make sense for it."""

    def __init__(self, settings, screen, checker):
        self.checker = checker
        lang = lambda: settings.language
        entries = [
            ('update_primary', self._primary_label, COLORS['green'], self._primary),
            ('update_open', lambda: _update_label(lang(), 'open'), COLORS['blue'], self._open_page),
            ('update_skip', lambda: _update_label(lang(), 'skip'), COLORS['button'], self._skip),
            ('update_mode', self._mode_label, COLORS['button'], self._cycle_mode),
        ]
        super().__init__(settings, screen,
                         title_fn=lambda: _update_label(lang(), 'title'),
                         entries=entries, body_fn=self._body)

    def _info(self):
        return self.checker.result

    def _done(self, info):
        return bool(info and (info.get('installed') or info.get('staged')))

    def _body(self):
        lang = self.settings.language
        mode = _load_update_state().get('mode', 'auto')
        info = self._info()
        if mode == 'off' and info is None:
            return _update_label(lang, 'disabled')
        if self.checker.checking or self.checker.installing or info is None:
            return _update_label(lang, 'checking')
        if info['status'] == 'error':
            return _update_label(lang, 'error')
        if info['status'] == 'up_to_date':
            return _update_label(lang, 'up_to_date', local=info['local'])
        if info.get('installed'):
            return _update_label(lang, 'installed', version=info['version'])
        if info.get('staged'):
            return _update_label(lang, 'staged', version=info['version'])
        text = _update_label(lang, 'available', version=info['version'], local=info['local'])
        if info.get('notes'):
            text += '\n\n' + _update_label(lang, 'notes') + '\n' + info['notes'][:300]
        if info.get('install_error'):
            reason = _update_label(lang, 'reason_' + str(info['install_error']))
            text += '\n\n' + _update_label(lang, 'install_error', reason=reason)
        return text

    def _primary_label(self):
        lang = self.settings.language
        info = self._info()
        if self._done(info):
            return _update_label(lang, 'restart')
        if info and info.get('status') == 'available' and not info.get('install_error'):
            return _update_label(lang, 'install')
        return _update_label(lang, 'open')

    def _primary(self):
        info = self._info()
        if self._done(info):
            self.checker.restart_requested = True
            self._running = False
        elif (info and info.get('status') == 'available' and not info.get('install_error')
                and not self.checker.installing):
            # Download and verify off the UI thread; the body shows progress.
            threading.Thread(target=self.checker.install, args=(info,),
                             name='update-install', daemon=True).start()
        else:
            self._open_page()

    def _mode_label(self):
        return _update_label(self.settings.language, 'mode_' + _load_update_state().get('mode', 'auto'))

    def _open_page(self):
        info = self._info()
        if info and info.get('status') == 'available' and str(info.get('url', '')).startswith('https://github.com/'):
            try:
                webbrowser.open(info['url'])
            except Exception as exc:
                _logging_mod.getLogger('sgf').warning('Could not open the download page: %s', exc)

    def _skip(self):
        info = self._info()
        if info and info.get('status') == 'available':
            state = _load_update_state()
            state['skipped_version'] = info['version']
            _save_update_state(state)
            self._running = False

    def _cycle_mode(self):
        state = _load_update_state()
        current = state.get('mode', 'auto')
        state['mode'] = _UPDATE_MODES[(_UPDATE_MODES.index(current) + 1) % len(_UPDATE_MODES)]
        _save_update_state(state)


class ProfileScreen(_SimpleMenuScreen):
    """MP\\Player Hub\\Profile — the player-name field that used to sit
    directly on the Main Menu (spec: 'the name on the main menu ... should
    move to MP\\PH\\Profile'). Built on _SimpleMenuScreen so it gets the
    same Back button/keyboard focus/layout for free; the name field itself
    is inserted right after the title."""

    def __init__(self, settings, screen, get_name, on_name_change):
        self._get_name = get_name
        self._on_name_change = on_name_change
        super().__init__(settings, screen,
                         title_fn=lambda: _t_or(settings.language, 'profile', 'Profile'),
                         entries=[])

    def _init_ui(self):
        super()._init_ui()
        self.ui.focus_key('name_input')

    def _populate_widgets(self):
        w = self._widgets
        w['title'] = UILabel(self.title_fn, size=40, align='center', style='bold')
        w['name_label'] = UILabel(lambda: get_text(self.settings.language, 'name'), size=22, align='center')
