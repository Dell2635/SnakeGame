_MP_CONTROL_PRESETS = (
    {'up': 'w', 'down': 's', 'left': 'a', 'right': 'd'},
    {'up': 'up', 'down': 'down', 'left': 'left', 'right': 'right'},
    {'up': 't', 'down': 'g', 'left': 'f', 'right': 'h'},
    {'up': 'i', 'down': 'k', 'left': 'j', 'right': 'l'},
)


def _normalize_mp_player_configs(configs, count):
    result = []
    raw = configs if isinstance(configs, list) else []
    for i in range(max(1, min(4, int(count or 1)))):
        src = raw[i] if i < len(raw) and isinstance(raw[i], dict) else {}
        base = dict(_MP_CONTROL_PRESETS[i % len(_MP_CONTROL_PRESETS)])
        bindings = src.get('bindings', {})
        if isinstance(bindings, dict):
            for action in ('up', 'down', 'left', 'right'):
                value = bindings.get(action)
                if isinstance(value, str) and value.strip():
                    base[action] = value.strip().lower()
        result.append({
            'name': str(src.get('name', f'Player {i + 1}'))[:20] or f'Player {i + 1}',
            'bindings': base,
        })
    return result


def _mp_key_matches(key, key_name):
    try:
        return pygame.key.name(int(key)).lower() == str(key_name).lower()
    except Exception:
        return False


class LocalMultiplayerNGame:
    """Deterministic local multiplayer engine supporting one to four players.

    The control table is data-driven and accepts overrides from the shared
    keybind/action-mapping layer. The built-in presets are only defaults.
    """

    PLAYER_COLORS = (
        ((50, 205, 50), (20, 165, 20)),
        ((0, 200, 230), (0, 130, 160)),
        ((225, 100, 225), (155, 45, 155)),
        ((255, 175, 60), (190, 110, 15)),
    )

    def __init__(self, settings, screen, mode='1v1', player_count=2,
                 player_configs=None, seed=None, custom_map=None):
        self.settings = settings
        self.screen = screen
        self.mode = 'coop' if mode == 'coop' else '1v1'
        self.player_count = max(1, min(4, int(player_count or 1)))
        self.player_configs = _normalize_mp_player_configs(player_configs, self.player_count)
        self.seed = seed if seed else generate_seed()
        self.custom_map = custom_map
        self.runtime = None
        self.replay_mode = False
        self.replay_index = 0
        self.replay_speed = 1.0
        self._replay_exit = False
        self._match_saved = False
        self.mp_history = []
        self._init_layout()
        self.reset()

    def _board_size(self):
        value = self.settings.board_size
        if isinstance(value, str):
            return {'small': 10, 'medium': 15, 'large': 20, 'extra_large': 25}.get(value, 15)
        return max(10, int(value))

    def _init_layout(self):
        if isinstance(self.custom_map, dict):
            self.board_width = int(self.custom_map.get('board_width', self._board_size()))
            self.board_height = int(self.custom_map.get('board_height', self._board_size()))
        else:
            self.board_width = self.board_height = self._board_size()
        sw, sh = self.screen.get_size()
        hud_h = 72
        self.cell_size = max(4, min(sw, sh - hud_h) // max(self.board_width, self.board_height, 1))
        self.board_offset_x = (sw - self.board_width * self.cell_size) // 2
        self.board_offset_y = hud_h + (sh - hud_h - self.board_height * self.cell_size) // 2

    def _spawn_positions(self):
        bw, bh = self.board_width, self.board_height
        candidates = [
            (max(1, bw // 6), max(1, bh // 2)),
            (min(bw - 2, 5 * bw // 6), max(1, bh // 2)),
            (max(1, bw // 2), max(1, bh // 6)),
            (max(1, bw // 2), min(bh - 2, 5 * bh // 6)),
        ]
        out = []
        used = set()
        for cell in candidates:
            if cell not in used and 0 <= cell[0] < bw and 0 <= cell[1] < bh:
                out.append(cell)
                used.add(cell)
        while len(out) < self.player_count:
            fallback = (len(out) % max(1, bw), (len(out) * 3) % max(1, bh))
            if fallback not in used:
                out.append(fallback)
                used.add(fallback)
        return out[:self.player_count]

    def reset(self):
        self.rng = SeedRNG(self.seed)
        self._init_layout()
        self.snakes = [[pos] for pos in self._spawn_positions()]
        dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]
        self.directions = [dirs[i % 4] for i in range(self.player_count)]
        self.next_directions = list(self.directions)
        self.scores = [0] * self.player_count
        self.alive = [True] * self.player_count
        self.obstacles = []
        if isinstance(self.custom_map, dict):
            self.obstacles = [tuple(o) for o in self.custom_map.get('obstacles', [])]
        elif getattr(self.settings, 'enable_obstacles', False):
            self._gen_obstacles()
        self.portals = []
        if isinstance(self.custom_map, dict):
            self.portals = [tuple(p) for p in self.custom_map.get('portals', []) if len(p) == 5]
        self.fruit_pos = self._new_fruit()
        self.game_over = False
        self.winner = None
        self.paused = False
        self.last_tick = time.time() * 1000
        self.mp_history = [self._mp_snap()]

    def _gen_obstacles(self):
        starts = set(sum((snake for snake in self.snakes), []))
        available = [(x, y) for x in range(self.board_width) for y in range(self.board_height)
                     if (x, y) not in starts]
        count = min(getattr(self.settings, 'obstacle_count', 5),
                    len(available) // 6, 20)
        self.obstacles = self.rng.sample(available, count) if count else []

    def _new_fruit(self):
        occupied = set(self.obstacles)
        for snake in self.snakes:
            occupied.update(snake)
        for p in self.portals:
            occupied.add((p[0], p[1])); occupied.add((p[2], p[3]))
        available = [(x, y) for x in range(self.board_width)
                     for y in range(self.board_height) if (x, y) not in occupied]
        return self.rng.choice(available) if available else None

    def _teleport(self, cell):
        for p in self.portals:
            a = (p[0], p[1]); b = (p[2], p[3])
            if cell == a:
                return b
            if cell == b:
                return a
        return cell

    def _runtime_actions(self, event):
        router = getattr(self.runtime, 'input', None)
        mapper = getattr(router, '_action_mapper', None) if router else None
        for method_name in ('actions_for_event', 'resolve', 'map_event'):
            fn = getattr(mapper, method_name, None)
            if callable(fn):
                try:
                    result = fn(event)
                    if isinstance(result, str):
                        return (result,)
                    return tuple(result or ())
                except Exception:
                    return ()
        return ()

    def handle_event(self, event):
        if event.type == pygame.KEYDOWN:
            actions = self._runtime_actions(event)
            action_map = {
                'MOVE_UP': 'up', 'MOVE_DOWN': 'down',
                'MOVE_LEFT': 'left', 'MOVE_RIGHT': 'right',
            }
            for i in range(self.player_count):
                for action, direction in action_map.items():
                    if f'P{i + 1}_{action}' in actions or f'PLAYER{i + 1}_{action}' in actions:
                        self._request_direction(i, direction)
            if not actions:
                for i, cfg in enumerate(self.player_configs):
                    if _mp_key_matches(event.key, cfg['bindings']['up']):
                        self._request_direction(i, 'up')
                    elif _mp_key_matches(event.key, cfg['bindings']['down']):
                        self._request_direction(i, 'down')
                    elif _mp_key_matches(event.key, cfg['bindings']['left']):
                        self._request_direction(i, 'left')
                    elif _mp_key_matches(event.key, cfg['bindings']['right']):
                        self._request_direction(i, 'right')
            if event.key in (pygame.K_ESCAPE,):
                return 'back'
            if event.key == pygame.K_p:
                self.paused = not self.paused
            if self.game_over and event.key == pygame.K_r:
                self.reset()
        return None

    def _request_direction(self, i, direction):
        vectors = {'up': (0, -1), 'down': (0, 1), 'left': (-1, 0), 'right': (1, 0)}
        new_dir = vectors[direction]
        cur = self.directions[i]
        if new_dir != (-cur[0], -cur[1]):
            self.next_directions[i] = new_dir

    def _new_head(self, i):
        if not self.alive[i]:
            return None
        hx, hy = self.snakes[i][0]
        dx, dy = self.next_directions[i]
        nx, ny = hx + dx, hy + dy
        if getattr(self.settings, 'wall_collision', True):
            if not (0 <= nx < self.board_width and 0 <= ny < self.board_height):
                return None
            return (nx, ny)
        return (nx % self.board_width, ny % self.board_height)

    def tick(self):
        if self.game_over or self.paused:
            return
        self.directions = list(self.next_directions)
        heads = [self._new_head(i) for i in range(self.player_count)]
        dead = [h is None for h in heads]

        obstacle_set = set(self.obstacles)
        body_occupied = set()
        for snake in self.snakes:
            body_occupied.update(snake[:-1])

        # Same-cell and crossing head collisions are fatal in competitive play.
        for i in range(self.player_count):
            hi = heads[i]
            if hi is None:
                continue
            if hi in obstacle_set or hi in body_occupied:
                dead[i] = True
            for j in range(i + 1, self.player_count):
                hj = heads[j]
                if hj is not None and (hi == hj or (hi == self.snakes[j][0] and hj == self.snakes[i][0])):
                    dead[i] = dead[j] = True

        ate = [False] * self.player_count
        for i, head in enumerate(heads):
            if dead[i]:
                continue
            head = self._teleport(head)
            heads[i] = head
            self.snakes[i].insert(0, head)
            if head == self.fruit_pos and not any(ate):
                ate[i] = True
                self.scores[i] += max(1, int(10 * 1000 / max(1, self.settings.update_rate_ms)))
            else:
                self.snakes[i].pop()

        if any(ate):
            self.fruit_pos = self._new_fruit()

        for i, d in enumerate(dead):
            if d:
                self.alive[i] = False

        if self.mode == 'coop':
            if not all(self.alive):
                self.game_over = True
                self.winner = 'coop_lose'
            elif self.fruit_pos is None:
                self.game_over = True
                self.winner = 'coop_win'
        else:
            alive = [i for i, flag in enumerate(self.alive) if flag]
            if len(alive) <= 1:
                self.game_over = True
                self.winner = alive[0] + 1 if alive else 'draw'
        self.mp_history.append(self._mp_snap())
        if self.game_over:
            self.save_match(source='local')

    def _mp_snap(self):
        return {
            'snakes': [[list(c) for c in s] for s in self.snakes],
            'directions': [list(d) for d in self.directions],
            'next_directions': [list(d) for d in self.next_directions],
            'scores': list(self.scores),
            'alive': list(self.alive),
            'fruit': list(self.fruit_pos) if self.fruit_pos else None,
            'obstacles': [list(o) for o in self.obstacles],
            'game_over': self.game_over,
            'winner': self.winner,
            'board_width': self.board_width,
            'board_height': self.board_height,
            'mode': self.mode,
            'player_configs': _copy_json_safe(self.player_configs),
        }

    def draw(self):
        self.screen.fill(COLORS['background'])
        self._draw_board()
        self._draw_hud()
        for i in range(self.player_count):
            body, head = self.PLAYER_COLORS[i]
            self._draw_snake(self.snakes[i], body, head, self.alive[i])
        if self.game_over:
            f = get_font(self.settings.language, 'bold', 28)
            label = "Draw" if self.winner == 'draw' else (
                "Co-op lost" if self.winner == 'coop_lose' else
                "Co-op won" if self.winner == 'coop_win' else
                f"{self.player_configs[self.winner - 1]['name']} wins!"
            )
            s = render_fit(f, label, COLORS['white'], self.screen.get_width() - 40)
            self.screen.blit(s, s.get_rect(center=(self.screen.get_width() // 2,
                                                    self.screen.get_height() - 62)))

    def _draw_hud(self):
        f = get_font(self.settings.language, 'bold', 17)
        title = f"{self.mode.upper()} • {self.player_count} PLAYERS"
        self.screen.blit(f.render(title, True, COLORS['white']), (10, 8))
        x = 10
        for i in range(self.player_count):
            c = self.PLAYER_COLORS[i][0]
            label = f"{self.player_configs[i]['name']}: {self.scores[i]}"
            s = f.render(label, True, c if self.alive[i] else (100, 100, 100))
            self.screen.blit(s, (x, 34))
            x += min(190, self.screen.get_width() // max(1, self.player_count))

    def _draw_board(self):
        bx, by = self.board_offset_x, self.board_offset_y
        pygame.draw.rect(self.screen, COLORS['board_background'],
                         pygame.Rect(bx, by, self.board_width * self.cell_size,
                                     self.board_height * self.cell_size))
        for o in self.obstacles:
            x, y = o
            pygame.draw.rect(self.screen, COLORS['obstacle'],
                             pygame.Rect(bx + x * self.cell_size, by + y * self.cell_size,
                                         self.cell_size, self.cell_size))
        if self.fruit_pos:
            fx, fy = self.fruit_pos
            pygame.draw.circle(self.screen, COLORS['fruit'],
                               (bx + fx * self.cell_size + self.cell_size // 2,
                                by + fy * self.cell_size + self.cell_size // 2),
                               max(2, self.cell_size // 3))
        for p in self.portals:
            for x, y in ((p[0], p[1]), (p[2], p[3])):
                pygame.draw.rect(self.screen, COLORS['portal1'],
                                 pygame.Rect(bx + x*self.cell_size, by + y*self.cell_size,
                                             self.cell_size, self.cell_size), width=max(1, self.cell_size//5))

    def _draw_snake(self, snake, body, head, alive):
        bx, by = self.board_offset_x, self.board_offset_y
        alpha_body = body if alive else tuple(max(40, c // 3) for c in body)
        for j, (x, y) in enumerate(snake):
            rect = pygame.Rect(bx + x*self.cell_size + 1, by + y*self.cell_size + 1,
                               max(2, self.cell_size - 2), max(2, self.cell_size - 2))
            pygame.draw.rect(self.screen, head if j == 0 and alive else alpha_body, rect, border_radius=3)

    def save_match(self, source='local'):
        """Persist a completed 1-4 player local match using the existing save format."""
        if self._match_saved or not self.mp_history:
            return
        self._match_saved = True
        try:
            data = _load_data()
            highscores = data.get('highscores', [])
            if not isinstance(highscores, list):
                highscores = []
            game_id = f"mp-{int(time.time())}-{self.rng.randint(1000, 9999)}"
            names = [cfg['name'] for cfg in self.player_configs]
            entry = {
                'name': " vs ".join(names) if self.mode == '1v1' else " + ".join(names),
                'score': max(self.scores) if self.scores else 0,
                'date': datetime.now().strftime('%Y-%m-%d %H:%M'),
                'board_size': self.board_width,
                'update_rate_ms': self.settings.update_rate_ms,
                'victory': False,
                'wall_collision': self.settings.wall_collision,
                'powerups_enabled': False,
                'fruit_types_enabled': getattr(self.settings, 'fruit_types_enabled', True),
                'obstacles_enabled': getattr(self.settings, 'enable_obstacles', False),
                'portals_enabled': bool(self.portals),
                'portal_pairs': len(self.portals),
                'game_id': game_id,
                'seed': self.seed,
                'has_replay': len(self.mp_history) > 1,
                'settings': {
                    k: v for k, v in vars(self.settings).items()
                    if isinstance(v, (int, float, str, bool, list, dict)) and v is not None
                },
                'is_multiplayer': True,
                'mp_mode': self.mode,
                'mp_source': source,
                'player_count': self.player_count,
                'player_names': names,
                'player_scores': list(self.scores),
                'winner': self.winner,
                'custom_map': self.custom_map,
                'actual_board_width': self.board_width,
                'actual_board_height': self.board_height,
                'mp_history': self.mp_history,
            }
            highscores.append(entry)
            highscores.sort(key=lambda x: x.get('score', 0), reverse=True)
            data['highscores'] = highscores[:50]
            _save_data(data)
        except Exception as exc:
            print(f"Error saving local multiplayer match: {exc}")

    def run(self):
        clock = pygame.time.Clock()
        while True:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit(); sys.exit()
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    self._init_layout()
                else:
                    action = self.handle_event(event)
                    if action == 'back':
                        return None
            if not self.game_over and not self.paused:
                now = time.time() * 1000
                step = max(20, int(self.settings.update_rate_ms))
                while now - self.last_tick >= step:
                    self.last_tick += step
                    self.tick()
                    if self.game_over:
                        break
            self.draw()
            pygame.display.flip()
            clock.tick(60)
        return None


