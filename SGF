    def draw_animated_snake(self, x, y):
        """Draw an animated snake illustration"""
        segment_size = 20
        spacing = 5
        
        # Make snake appear to move by shifting positions
        time_offset = pygame.time.get_ticks() / 300
        x_shift = math.sin(time_offset) * 5
        
        # Draw snake body segments with wave effect
        for i in range(5):
            # Add wave effect
            wave_y = math.sin(time_offset - i * 0.5) * 10
            
            segment_rect = pygame.Rect(
                x - ((i + 1) * (segment_size + spacing)) + 100 + x_shift,
                y + wave_y,
                segment_size,
                segment_size
            )
            pygame.draw.rect(self.screen, COLORS['snake'], segment_rect, border_radius=3)
            
        # Draw snake head
        head_wave_y = math.sin(time_offset) * 10
        head_rect = pygame.Rect(
            x - (0 * (segment_size + spacing)) + 100 + x_shift,
            y + head_wave_y,
            segment_size + 5,
            segment_size
        )
        pygame.draw.rect(self.screen, COLORS['snake_head'], head_rect, border_radius=5)
        
        # Draw eyes with blinking
        # Blink every 3 seconds
        eyes_open = (pygame.time.get_ticks() / 1000) % 3 > 0.2
        
        if eyes_open:
            pygame.draw.circle(self.screen, COLORS['white'], (head_rect.right - 5, head_rect.y + 7), 3)
            pygame.draw.circle(self.screen, COLORS['white'], (head_rect.right - 5, head_rect.bottom - 7), 3)
        else:
            # Draw closed eyes as small lines
            pygame.draw.line(self.screen, COLORS['white'], 
                          (head_rect.right - 8, head_rect.y + 7), 
                          (head_rect.right - 2, head_rect.y + 7), 2)
            pygame.draw.line(self.screen, COLORS['white'], 
                          (head_rect.right - 8, head_rect.bottom - 7), 
                          (head_rect.right - 2, head_rect.bottom - 7), 2)
        
        # Draw fruit with pulsating effect
        fruit_pulse = (math.sin(time_offset * 2) + 1) / 8
        fruit_size = segment_size + int(fruit_pulse * segment_size)
        fruit_rect = pygame.Rect(
            x + 50 - fruit_size // 2,
            y - fruit_size // 2,
            fruit_size,
            fruit_size
        )
        pygame.draw.rect(self.screen, COLORS['fruit'], fruit_rect, border_radius=fruit_size // 2)
        
        # Add shine effect to fruit
        shine_pos = time_offset % (2 * math.pi)
        shine_x = fruit_rect.x + fruit_rect.width * 0.3 + math.cos(shine_pos) * (fruit_rect.width * 0.2)
        shine_y = fruit_rect.y + fruit_rect.height * 0.3 + math.sin(shine_pos) * (fruit_rect.height * 0.2)
        pygame.draw.circle(self.screen, COLORS['white'], (int(shine_x), int(shine_y)), 3)
        
    def start_transition_to_page(self, target_page):
        """Start transition animation to a new page"""
        if target_page != self.current_page:
            self.transition_alpha = 0
            self.transition_in = False
            self.transition_target_page = target_page
            self.transitioning = True  # actually start the transition loop
            
    def run(self):
        """Run the tutorial screen with smooth transitions and animated character guide"""
        running = True
        clock = pygame.time.Clock()
        
        # Position the guide character
        self.guide.move_to(120, 480)
        
        # Start with a transition in
        self.transition_alpha = 255
        self.transition_in = True
        self.transition_target_page = None
        self.transitioning = True
        
        # First-time display flags for each page
        page_first_visit = {i: True for i in range(self.total_pages)}
        
        # Initialize the character with a welcome tip
        self.guide.set_emotion('excited')
        
        # Animation variables for snake
        snake_segments = []
        snake_target_positions = []
        snake_animation_speed = 0.15
        snake_animation_progress = 0.0
        snake_direction = 'right'
        grid_size = 20
        snake_size = 18
        
        # For smooth animation
        last_time = time.time()
        demo_key_pressed = None
        demo_key_timer = 0
        
        while running:
            # Track time between frames for animations
            current_time = time.time()
            dt = current_time - last_time
            last_time = current_time
            
            # Update character animations
            self.guide.update(dt)
            
            # Get mouse position for hover effects
            mouse_pos = pygame.mouse.get_pos()
            
            # Draw tutorial content with transitions
            back_rect, prev_rect, next_rect = self.draw_tutorial()
            
            # Update button hover states
            self.button_hover["back"] = back_rect.collidepoint(mouse_pos)
            self.button_hover["prev"] = prev_rect and prev_rect.collidepoint(mouse_pos)
            self.button_hover["next"] = next_rect.collidepoint(mouse_pos)
            
            # Show tips when first visiting a page
            if page_first_visit[self.current_page] and not self.transitioning and self.transition_alpha == 0:
                if self.current_page in self.tutorial_tips:
                    tips = self.tutorial_tips[self.current_page]
                    if tips and len(tips) > 0:
                        self.guide.say(tips[0], 5)
                        self.guide.set_emotion('excited' if self.current_page == 0 else 'happy')
                page_first_visit[self.current_page] = False
            
            # Create animated snake demo when on page 1 (basics)
            if self.current_page == 1 and not self.transitioning:
                # Initialize snake if empty
                if not snake_segments:
                    # Create starting positions
                    snake_segments = [(300 + i*grid_size, 300) for i in range(5)]
                    snake_target_positions = snake_segments.copy()
                
                # Update snake animation
                snake_animation_progress += snake_animation_speed * dt * 60
                
                # Move snake when animation completes
                if snake_animation_progress >= 1.0:
                    snake_animation_progress = 0.0
                    
                    # Update segments (move body parts to follow the head)
                    for i in range(len(snake_segments)-1, 0, -1):
                        snake_target_positions[i] = snake_segments[i-1]
                    
                    # Move head based on direction
                    head_x, head_y = snake_segments[0]
                    if snake_direction == 'right':
                        head_x += grid_size
                        if head_x > 500:  # Turn at edge
                            head_x = 500
                            snake_direction = 'down'
                    elif snake_direction == 'down':
                        head_y += grid_size
                        if head_y > 400:  # Turn at edge
                            head_y = 400
                            snake_direction = 'left'
                    elif snake_direction == 'left':
                        head_x -= grid_size
                        if head_x < 200:  # Turn at edge
                            head_x = 200
                            snake_direction = 'up'
                    elif snake_direction == 'up':
                        head_y -= grid_size
                        if head_y < 250:  # Turn at edge
                            head_y = 250
                            snake_direction = 'right'
                            
                    # Set new head position
                    snake_target_positions[0] = (head_x, head_y)
                
                # Smoothly animate between positions
                for i in range(len(snake_segments)):
                    # Interpolate between old and new positions
                    old_x, old_y = snake_segments[i]
                    target_x, target_y = snake_target_positions[i]
                    new_x = old_x + (target_x - old_x) * snake_animation_progress
                    new_y = old_y + (target_y - old_y) * snake_animation_progress
                    snake_segments[i] = (new_x, new_y)
                    
                # Draw the animated snake
                for i, (x, y) in enumerate(snake_segments):
                    # Snake head (first segment)
                    if i == 0:
                        pygame.draw.rect(self.screen, 
                                      COLORS['snake_head'], 
                                      (x-snake_size//2, y-snake_size//2, snake_size, snake_size),
                                      border_radius=snake_size//3)
                        
                        # Draw eyes
                        eye_offset_x = 0
                        eye_offset_y = 0
                        if snake_direction == 'right':
                            eye_offset_x = 4
                        elif snake_direction == 'left':
                            eye_offset_x = -4
                        elif snake_direction == 'down':
                            eye_offset_y = 4
                        elif snake_direction == 'up':
                            eye_offset_y = -4
                            
                        pygame.draw.circle(self.screen, COLORS['white'], 
                                        (int(x + eye_offset_x - 2), int(y + eye_offset_y - 2)), 3)
                        pygame.draw.circle(self.screen, COLORS['white'], 
                                        (int(x + eye_offset_x - 2), int(y + eye_offset_y + 2)), 3)
                    else:
                        # Body segments with slight pulsing effect
                        pulse = math.sin(current_time * 3 + i) * 10
                        segment_color = COLORS['snake']
                        pygame.draw.rect(self.screen, 
                                      segment_color, 
                                      (x-snake_size//2, y-snake_size//2, snake_size, snake_size),
                                      border_radius=snake_size//4)
            
            # Update demo key visualization on page 1 (controls)
            if self.current_page == 1 and self.demo_key_pressed:
                demo_key_timer += dt
                if demo_key_timer > 0.5:
                    self.demo_key_pressed = None
                    demo_key_timer = 0
                
            # Draw the character guide
            self.guide.draw()
            
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                    pygame.quit()
                    sys.exit()
                    
                elif event.type == pygame.MOUSEBUTTONDOWN:
                    if event.button == 1:  # Left mouse button
                        
                        # Check if back button was clicked
                        if back_rect.collidepoint(event.pos):
                            running = False
                            
                        # Check if previous button was clicked
                        if prev_rect and prev_rect.collidepoint(event.pos):
                            if self.transition_alpha == 0 and not self.transitioning:  # Only if not already transitioning
                                self.start_transition_to_page(max(0, self.current_page - 1))
                                # Change character emotion
                                self.guide.set_emotion('thinking')
                                # New tip after page change
                                if self.current_page - 1 in self.tutorial_tips and len(self.tutorial_tips[self.current_page - 1]) > 1:
                                    self.guide.say(self.tutorial_tips[self.current_page - 1][1], 4)
                            
                        # Check if next/finish button was clicked
                        if next_rect.collidepoint(event.pos):
                            if self.transition_alpha == 0 and not self.transitioning:  # Only if not already transitioning
                                if self.current_page < self.total_pages - 1:
                                    self.start_transition_to_page(self.current_page + 1)
                                    # Change character emotion
                                    self.guide.set_emotion('excited')
                                    # New tip after page change
                                    if self.current_page + 1 in self.tutorial_tips and len(self.tutorial_tips[self.current_page + 1]) > 0:
                                        self.guide.say(self.tutorial_tips[self.current_page + 1][0], 4)
                                else:
                                    # Final page, exit with fade out
                                    self.transition_alpha = 0
                                    self.transition_in = False
                                    self.transitioning = True
                                    self.transition_target_page = None
                                    
                                    # Wait for fade out to complete before exiting
                                    fade_complete = False
                                    while not fade_complete:
                                        pygame.event.pump()  # keep OS happy, prevent freeze
                                        # Update transition
                                        if self.transition_in:
                                            self.transition_alpha = max(0, self.transition_alpha - self.transition_speed)
                                        else:
                                            self.transition_alpha = min(255, self.transition_alpha + self.transition_speed)
                                            
                                        if self.transition_alpha >= 255:
                                            fade_complete = True
                                            
                                        # Redraw and apply transition
                                        self.draw_tutorial()
                                        self.transition_surface.set_alpha(self.transition_alpha)
                                        self.screen.blit(self.transition_surface, (0, 0))
                                        pygame.display.flip()
                                        clock.tick(60)
                                    
                                    running = False
                            
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    # Navigate with arrow keys
                    elif event.key == pygame.K_LEFT and self.current_page > 0:
                        if self.transition_alpha == 0 and not self.transitioning:  # Only if not already transitioning
                            self.start_transition_to_page(self.current_page - 1)
                            # React to key press
                            self.guide.set_emotion('thinking')
                            
                    elif event.key == pygame.K_RIGHT and self.current_page < self.total_pages - 1:
                        if self.transition_alpha == 0 and not self.transitioning:  # Only if not already transitioning
                            self.start_transition_to_page(self.current_page + 1)
                            # React to key press
                            self.guide.set_emotion('excited')
                            
                    # Close tutorial with Escape key
                    elif event.key == pygame.K_ESCAPE:
                        running = False
                        
                    # Demo controls for page 1 (Controls page)
                    if self.current_page == 1:
                        if event.key in (pygame.K_UP, pygame.K_w):
                            self.demo_key_pressed = "up"
                            demo_key_timer = 0
                            self.guide.say("Great! Press Up to move upward!", 2)
                        elif event.key in (pygame.K_DOWN, pygame.K_s):
                            self.demo_key_pressed = "down"
                            demo_key_timer = 0
                            self.guide.say("Perfect! Down arrow moves downward!", 2)
                        elif event.key in (pygame.K_LEFT, pygame.K_a):
                            self.demo_key_pressed = "left"
                            demo_key_timer = 0
                            self.guide.say("That's it! Left arrow moves left!", 2)
                        elif event.key in (pygame.K_RIGHT, pygame.K_d):
                            self.demo_key_pressed = "right"
                            demo_key_timer = 0
                            self.guide.say("Nice! Right arrow moves right!", 2)
                        
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    # Resize transition surface to match new screen size
                    self.transition_surface = pygame.Surface((event.w, event.h))
                    self.transition_surface.fill((0, 0, 0))
            
            # Handle page transitions
            if self.transitioning:
                if self.transition_in:
                    self.transition_alpha -= self.transition_speed
                    if self.transition_alpha <= 0:
                        self.transition_alpha = 0
                        self.transitioning = False
                else:
                    self.transition_alpha += self.transition_speed
                    if self.transition_alpha >= 255:
                        self.transition_alpha = 255
                        self.transition_in = True
                        if self.transition_target_page is not None:
                            self.current_page = self.transition_target_page
                            self.transition_target_page = None
                
            # Apply transition overlay if needed
            if self.transition_alpha > 0:
                self.transition_surface.set_alpha(self.transition_alpha)
                self.screen.blit(self.transition_surface, (0, 0))
            
            # Update display
            pygame.display.flip()
            
            # Cap the frame rate
            clock.tick(60)
        

        
