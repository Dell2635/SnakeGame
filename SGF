            pygame.draw.rect(self.screen,(30,160,60),start_rect,border_radius=8)
            pygame.draw.rect(self.screen,(160,50,50),back_rect,border_radius=8)
            for r,l in ((previous_rect,get_text(self.settings.language,'previous')),(start_rect,'Start'),(back_rect,get_text(self.settings.language,'back'))):
                self.screen.blit(render_fit(bf,l,COLORS['white'],r.width),
                                 render_fit(bf,l,COLORS['white'],r.width).get_rect(center=r.center))

            _legacy_nav_draw(locals().get('self'))
            pygame.display.flip()

            for event in pygame.event.get():
                if _legacy_nav_event(locals().get('self'), event, locals()):
                    continue
                if event.type == pygame.QUIT:
                    pygame.quit(); sys.exit()
                elif event.type == pygame.KEYDOWN:
                    if self.seed_active and self.seed_mode == 'custom':
                        if event.key in (pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_ESCAPE):
                            self.seed_active=False
                        elif event.key==pygame.K_BACKSPACE:
                            self.seed_text=self.seed_text[:-1]
                        elif event.unicode and event.unicode!=' ' and len(self.seed_text)<64:
                            self.seed_text += event.unicode
                    elif self.name_active_index is not None:
                        if event.key in (pygame.K_RETURN, pygame.K_KP_ENTER, pygame.K_ESCAPE):
                            self.name_active_index=None
                        elif event.key==pygame.K_BACKSPACE:
                            self.ai_configs[self.name_active_index]['name']=self.ai_configs[self.name_active_index]['name'][:-1]
                        elif event.unicode and event.unicode.isprintable() and len(self.ai_configs[self.name_active_index]['name'])<20:
                            self.ai_configs[self.name_active_index]['name'] += event.unicode
                    else:
                        if event.key==pygame.K_ESCAPE:
                            return NAV_BACK_LEVEL
                        elif event.key==pygame.K_RETURN and self.ai_count==0:
                            return self._save(_seed_from_setting(self.seed_mode,self.seed_text))
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    mp=event.pos
                    if minus.collidepoint(mp):
                        self.ai_count=max(0,self.ai_count-1)
                    elif plus.collidepoint(mp):
                        self.ai_count=min(self.max_ai,self.ai_count+1)
                    elif random_rect.collidepoint(mp):
                        self.seed_mode='random'; self.seed_active=False
                    elif custom_rect.collidepoint(mp):
                        self.seed_mode='custom'
                    elif seed_rect.collidepoint(mp) and self.seed_mode=='custom':
                        self.seed_active=True
                    elif previous_rect.collidepoint(mp):
                        return NAV_PREVIOUS
                    elif start_rect.collidepoint(mp):
                        return self._save(_seed_from_setting(self.seed_mode,self.seed_text))
                    elif back_rect.collidepoint(mp):
                        return NAV_BACK_LEVEL
                    else:
                        for idx,diff_r,skin_r,name_r in rows:
                            if diff_r.collidepoint(mp):
                                self.selected_ai=idx; self.name_active_index=None; self._cycle_difficulty(idx); break
                            if skin_r.collidepoint(mp):
                                self.selected_ai=idx; self.name_active_index=None; self._cycle_skin(idx); break
                            if name_r.collidepoint(mp):
                                self.selected_ai=idx; self.name_active_index=idx
                                break
                elif event.type == pygame.VIDEORESIZE:
                    self.screen=pygame.display.set_mode((event.w,event.h),pygame.RESIZABLE)
            clock.tick(60)

