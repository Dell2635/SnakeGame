                custom_rect = pygame.Rect(sw // 2 - btn_w // 2, cy + btn_h + gap, btn_w, btn_h)
                back_rect = pygame.Rect(sw // 2 - btn_w // 2, cy + (btn_h + gap) * 2 + gap,
                                        btn_w, max(44, int(sh * 0.075)))

                pygame.draw.rect(self.screen, COLORS['green'], proc_rect, border_radius=10)
                pygame.draw.rect(self.screen, (60, 130, 160), custom_rect, border_radius=10)
                pygame.draw.rect(self.screen, COLORS['button'], back_rect, border_radius=10)

                for rect, label in ((proc_rect, "Random (Procedural)"), (custom_rect, "Custom Map"),
                                     (back_rect, get_text(self.settings.language, 'back'))):
                    s = bf.render(label, True, COLORS['white'])
                    self.screen.blit(s, s.get_rect(center=rect.center))

                pygame.display.flip()

                for event in pygame.event.get():
                    if event.type == pygame.QUIT:
                        pygame.quit(); sys.exit()
                    elif event.type == pygame.KEYDOWN:
                        if event.key == pygame.K_ESCAPE:
                            return None
                    elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                        mp = event.pos
                        if proc_rect.collidepoint(mp):
                            return None
                        if custom_rect.collidepoint(mp):
                            self._mode = 'list'
                        if back_rect.collidepoint(mp):
                            return None
                    elif event.type == pygame.VIDEORESIZE:
                        self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                clock.tick(60)

            else:  # 'list'
                maps = self._all_maps()
                names = sorted(maps.keys())

                title = tf.render("Choose a Custom Map", True, COLORS['white'])
                self.screen.blit(title, (sw // 2 - title.get_width() // 2, int(sh * 0.06)))

                box = pygame.Rect(int(sw * 0.15), int(sh * 0.18), int(sw * 0.7), int(sh * 0.62))
                pygame.draw.rect(self.screen, (20, 26, 48), box, border_radius=10)
                pygame.draw.rect(self.screen, (90, 130, 200), box, width=2, border_radius=10)

                row_h = 44
                content_rect = pygame.Rect(box.x + 10, box.y + 10, box.width - 20, box.height - 20)
                if self.scrollbar is None:
                    self.scrollbar = ScrollBar(content_rect.right - 14, content_rect.y, 14,
                                               content_rect.height, max(len(names) * row_h, content_rect.height))
                self.scrollbar.content_height = max(len(names) * row_h, content_rect.height)
                self.scrollbar.max_scroll = max(0, self.scrollbar.content_height - content_rect.height)
                self.scrollbar.update()

                self.screen.set_clip(content_rect)
                offset = self.scrollbar.get_content_offset()
                row_font = get_font(self.settings.language, 'regular', 16)
                row_rects = []
                for i, name in enumerate(names):
                    ry = content_rect.y + i * row_h - offset
                    row_rect = pygame.Rect(content_rect.x, ry, content_rect.width - 20, row_h - 6)
                    if row_rect.bottom < content_rect.top or row_rect.top > content_rect.bottom:
                        row_rects.append((name, row_rect))
                        continue
                    pygame.draw.rect(self.screen, (32, 40, 68), row_rect, border_radius=6)
                    info = maps[name]
                    label = f"{name}  ({info.get('board_width','?')}x{info.get('board_height','?')})"
                    ls = row_font.render(label, True, COLORS['white'])
                    self.screen.blit(ls, (row_rect.x + 10, row_rect.centery - ls.get_height() // 2))
                    row_rects.append((name, row_rect))
                self.screen.set_clip(None)
                self.scrollbar.draw(self.screen)

                if not names:
                    empty_font = get_font(self.settings.language, 'regular', 16)
                    es = empty_font.render("No saved maps yet — make one in the Map Editor first.",
                                          True, (140, 155, 185))
                    self.screen.blit(es, (content_rect.centerx - es.get_width() // 2, content_rect.y + 20))

                back_rect = pygame.Rect(sw // 2 - 70, box.bottom + 16, 140, 40)
                pygame.draw.rect(self.screen, COLORS['button'], back_rect, border_radius=8)
                bs = bf.render(get_text(self.settings.language, 'back'), True, COLORS['white'])
                self.screen.blit(bs, bs.get_rect(center=back_rect.center))

                pygame.display.flip()

                for event in pygame.event.get():
                    if event.type == pygame.QUIT:
                        pygame.quit(); sys.exit()
                    elif event.type == pygame.KEYDOWN:
                        if event.key == pygame.K_ESCAPE:
                            self._mode = 'choice'
                    elif event.type == pygame.MOUSEWHEEL:
                        self.scrollbar.handle_event(event)
                    elif event.type in (pygame.MOUSEBUTTONUP, pygame.MOUSEMOTION):
                        self.scrollbar.handle_event(event)
                    elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                        mp = event.pos
                        if back_rect.collidepoint(mp):
                            self._mode = 'choice'
                        else:
                            for name, row_rect in row_rects:
                                if row_rect.collidepoint(mp):
                                    return maps[name]
                    elif event.type == pygame.VIDEORESIZE:
                        self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                        self.scrollbar = None
                clock.tick(60)


class VSAIConfigScreen:
    """
    Simple configuration screen: choose number of AI opponents and difficulty.
    Returns (ai_count, ai_difficulty) or None if cancelled.
    """
    DIFFICULTIES = ['easy', 'medium', 'hard', 'impossible']
    DIFF_LABELS  = ['Easy', 'Medium', 'Hard', 'Impossible']
    DIFF_COLOURS = [
        (80, 200,  80),   # green  – easy
        (200, 160,  40),  # gold   – medium
        (200,  80,  40),  # orange – hard
        (200,  40,  40),  # red    – impossible
    ]

    def __init__(self, settings, screen):
        self.settings      = settings
        self.screen        = screen
        self.diff_idx      = 1   # default: medium
        self.ai_count      = 1
        self.seed_text     = ''           # typed seed (empty = auto-generate)
        self.seed_active   = False        # whether seed field has focus

    def run(self):
        clock = pygame.time.Clock()
        while True:
            sw, sh = self.screen.get_width(), self.screen.get_height()
            self.screen.fill(COLORS['dark_blue'])

            # Animated background dots
            t = pygame.time.get_ticks() / 1000.0
            for i in range(20):
                px = int(sw * ((i * 137) % 100) / 100)
                py = int(sh * ((i * 97  + t * 12) % 100) / 100)
                pygame.draw.circle(self.screen, (30, 50, 110), (px, py), 2)

            _ref = min(sw, sh)
            tf   = get_font(self.settings.language, 'bold',    max(28, int(_ref * 0.06)))
            hf   = get_font(self.settings.language, 'bold',    max(18, int(_ref * 0.038)))
            bf   = get_font(self.settings.language, 'bold',    max(16, int(_ref * 0.032)))
            sf   = get_font(self.settings.language, 'regular', max(13, int(_ref * 0.025)))

            # Title
            title = tf.render("VS AI — Setup", True, COLORS['white'])
            self.screen.blit(title, (sw // 2 - title.get_width() // 2, int(sh * 0.08)))

            cy = int(sh * 0.24)

            # ── Number of AI opponents ────────────────────────────────────
            lbl = hf.render("AI Opponents:", True, COLORS['light_gray'])
            self.screen.blit(lbl, (sw // 2 - lbl.get_width() // 2, cy))
            cy += lbl.get_height() + int(sh * 0.015)

            btn_w = max(50, int(sw * 0.08))
            btn_h = max(36, int(sh * 0.065))
            gap   = int(sw * 0.025)
            total_w = 4 * btn_w + 3 * gap
            bx0     = sw // 2 - total_w // 2

            count_rects = []
            for idx in range(1, 5):
                r = pygame.Rect(bx0 + (idx - 1) * (btn_w + gap), cy, btn_w, btn_h)
                col = (0, 140, 200) if idx == self.ai_count else COLORS.get('button', (60, 70, 120))
                pygame.draw.rect(self.screen, col, r, border_radius=8)
                t_surf = bf.render(str(idx), True, COLORS['white'])
                self.screen.blit(t_surf, t_surf.get_rect(center=r.center))
                count_rects.append((r, idx))

            cy += btn_h + int(sh * 0.05)

            # ── Difficulty ────────────────────────────────────────────────
            lbl2 = hf.render("Difficulty:", True, COLORS['light_gray'])
            self.screen.blit(lbl2, (sw // 2 - lbl2.get_width() // 2, cy))
            cy += lbl2.get_height() + int(sh * 0.015)

            d_btn_w = max(90, int(sw * 0.14))
            d_gap   = int(sw * 0.02)
            d_total = len(self.DIFFICULTIES) * d_btn_w + (len(self.DIFFICULTIES) - 1) * d_gap
            dx0     = sw // 2 - d_total // 2

            diff_rects = []
            for di, (dlbl, dcol) in enumerate(zip(self.DIFF_LABELS, self.DIFF_COLOURS)):
                r = pygame.Rect(dx0 + di * (d_btn_w + d_gap), cy, d_btn_w, btn_h)
                bc = dcol if di == self.diff_idx else COLORS.get('button', (60, 70, 120))
                pygame.draw.rect(self.screen, bc, r, border_radius=8)
                if di == self.diff_idx:
                    pygame.draw.rect(self.screen, (255, 255, 255), r, 2, border_radius=8)
                t_surf = bf.render(dlbl, True, COLORS['white'])
                self.screen.blit(t_surf, t_surf.get_rect(center=r.center))
                diff_rects.append((r, di))

            cy += btn_h + int(sh * 0.04)

            # Difficulty description
            descriptions = [
                "Random movement — easy to beat",
                "Greedy pathfinding — a real challenge",
                "BFS + flood-fill safety — tough opponent",
                "Full look-ahead — nearly unbeatable",
            ]
            desc = sf.render(descriptions[self.diff_idx], True, (170, 180, 210))
            self.screen.blit(desc, (sw // 2 - desc.get_width() // 2, cy))
            cy += desc.get_height() + int(sh * 0.04)

            # ── Seed input ────────────────────────────────────────────────
            seed_lbl = hf.render("Seed:", True, COLORS['light_gray'])
            self.screen.blit(seed_lbl, (sw // 2 - seed_lbl.get_width() // 2, cy))
            cy += seed_lbl.get_height() + int(sh * 0.012)

            seed_box_w = max(260, int(sw * 0.38))
            seed_box_h = btn_h
            seed_box_x = sw // 2 - seed_box_w // 2
            seed_rect = pygame.Rect(seed_box_x, cy, seed_box_w, seed_box_h)
            seed_border = (0, 190, 255) if self.seed_active else (60, 70, 120)
            pygame.draw.rect(self.screen, (20, 25, 50), seed_rect, border_radius=6)
            pygame.draw.rect(self.screen, seed_border, seed_rect, 2, border_radius=6)
            seed_display = self.seed_text if self.seed_text else 'auto'
            seed_col     = COLORS['white'] if self.seed_text else (100, 110, 140)
            st = sf.render(seed_display[-32:], True, seed_col)
            self.screen.blit(st, (seed_box_x + 8, cy + (seed_box_h - st.get_height()) // 2))
            hint_s = sf.render("Leave blank for a random seed", True, (100, 110, 140))
            self.screen.blit(hint_s, (sw // 2 - hint_s.get_width() // 2,
                                      cy + seed_box_h + 4))
            cy += seed_box_h + hint_s.get_height() + int(sh * 0.035)

            # ── Start / Back buttons ──────────────────────────────────────
            start_w = max(130, int(sw * 0.18))
            back_w  = max(100, int(sw * 0.13))
            row_gap = int(sw * 0.04)

            start_rect = pygame.Rect(sw // 2 - start_w // 2 + (back_w + row_gap) // 2,
                                     cy, start_w, btn_h + 4)
            back_rect  = pygame.Rect(sw // 2 - back_w  // 2 - (start_w + row_gap) // 2,
                                     cy, back_w,  btn_h + 4)

            pygame.draw.rect(self.screen, (30, 160,  60), start_rect, border_radius=10)
            pygame.draw.rect(self.screen, (160, 50,  50), back_rect,  border_radius=10)

            ss = bf.render("Start Game", True, COLORS['white'])
            bs = bf.render("Back",       True, COLORS['white'])
            self.screen.blit(ss, ss.get_rect(center=start_rect.center))
            self.screen.blit(bs, bs.get_rect(center=back_rect.center))

            pygame.display.flip()

            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit(); sys.exit()
                elif event.type == pygame.KEYDOWN:
                    if self.seed_active:
                        if event.key == pygame.K_RETURN:
                            self.seed_active = False
                        elif event.key == pygame.K_ESCAPE:
                            self.seed_active = False
                        elif event.key == pygame.K_BACKSPACE:
                            self.seed_text = self.seed_text[:-1]
                        elif event.unicode and event.unicode != ' ' and len(self.seed_text) < 64:
                            self.seed_text += event.unicode
                    else:
                        if event.key == pygame.K_F11:
                            self.screen = _toggle_fullscreen(self.screen)
                        elif event.key == pygame.K_ESCAPE:
                            return None
                        elif event.key == pygame.K_RETURN:
                            seed = self.seed_text.strip() or generate_seed()
                            return (self.ai_count,
                                    self.DIFFICULTIES[self.diff_idx],
                                    seed)
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    mp = event.pos
                    if seed_rect.collidepoint(mp):
                        self.seed_active = True
                    else:
                        self.seed_active = False
                    for r, idx in count_rects:
                        if r.collidepoint(mp):
                            self.ai_count = idx
                    for r, di in diff_rects:
                        if r.collidepoint(mp):
                            self.diff_idx = di
                    if start_rect.collidepoint(mp):
                        seed = self.seed_text.strip() or generate_seed()
                        return (self.ai_count,
                                self.DIFFICULTIES[self.diff_idx],
                                seed)
                    if back_rect.collidepoint(mp):
                        return None
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode(
                        (event.w, event.h), pygame.RESIZABLE)
            clock.tick(60)


