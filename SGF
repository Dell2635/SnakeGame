    def _build_menu(self):
        """(Re)compute the whole menu layout from the current window size + language.
        One UIVerticalFlow decides fit -> compress -> scroll for title, buttons and
        the name field together, so nothing can fall outside the window."""
        ui, view, W = self.ui, self.menu_view, self._menu_widgets
        sw, sh = self.screen.get_size()
        lang = self.settings.language
        ui.language = lang
        view.set_rect(pygame.Rect(0, 0, sw, sh))
        ref = min(sw, sh)
        font_size = max(15, min(24, int(ref * 0.04)))
        btn_h = max(36, min(60, int(sh * 0.075)))
        min_btn_h = max(26, int(btn_h * 0.66))
        gap = max(6, min(20, int(btn_h * 0.3)))
        title_size = max(32, min(64, int(ref * 0.085)))
        W['title'].base_size = title_size
        title_h = get_font(lang, 'bold', title_size).get_height() + 20
        # width follows the (translated) labels, so long strings widen the column
        # instead of being shrunk to illegibility; render_fit() is the last resort.
        widest = 0
        for k in self._menu_order:
            b = W[k]
            if isinstance(b, UIButton):
                b.font_size = font_size
                widest = max(widest, ui_text_size(lang, 'bold', font_size, b.val(b.text))[0])
        bw = min(int(sw * 0.92), max(max(160, min(280, int(sw * 0.22))), widest + 44))
        pad_v = max(8, int(sh * 0.03))

        def build(width):
            flow = UIVerticalFlow(pygame.Rect(0, 0, width, sh), padding=(0, pad_v), spacing=gap,
                                  min_spacing=2, valign='center')
            for k in self._menu_order:
                if k == 'title':
                    flow.add(k, title_h, min_h=int(title_h * 0.55))
                elif k == 'play':
                    flow.add(k, btn_h, min_h=min_btn_h, w=bw, gap=max(gap, int(sh * 0.04)), min_gap=4)
                else:
                    flow.add(k, btn_h, min_h=min_btn_h, w=bw)
            res = flow.solve()
            self._menu_flow = res
            for k in self._menu_order:
                view.add(W[k], res.rects[k])
            return res.content_height if res.mode == 'scroll' else view.viewport.h

        fk = ui.focused.key if ui.focused is not None else None
        view.relayout(build)
        if fk is not None:
            ui.focus_key(fk)

    def _run_sub(self, fn, name=None, owner=None):
        """Run a sub-screen (own event loop) and resynchronise afterwards.

        When `name` is given, the transition is routed through IA5's
        ScreenManager (self.runtime.run_legacy) so back-navigation, modal
        ownership and lifecycle events keep working for screens reached
        through the new widget-based menu. Without a name, fn() is called
        directly — used for flows (like the Play menu) that already drive
        their own runtime.run_legacy/run_game calls internally.
        """
        if name is not None and getattr(self, 'runtime', None) is not None:
            self.runtime.run_legacy(name, fn, surface_owner=owner or self)
        else:
            fn()
        self.screen = pygame.display.get_surface() or self.screen
        self.current_language = self.settings.language
        self.ui.pulse = 0.0
        self.ui.mouse_owner = None

