    def draw_board(self):
        """Draw the game board"""
        # Draw background
        self.screen.fill(COLORS['background'])
        
        # Draw game board
        board_rect = pygame.Rect(
            self.board_offset_x, 
            self.board_offset_y, 
            self.board_width * self.cell_size, 
            self.board_height * self.cell_size
        )
        pygame.draw.rect(self.screen, COLORS['board_background'], board_rect)
        
        # Draw grid lines
        for x in range(self.board_width + 1):
            pygame.draw.line(
                self.screen, 
                COLORS['grid_line'], 
                (self.board_offset_x + x * self.cell_size, self.board_offset_y),
                (self.board_offset_x + x * self.cell_size, self.board_offset_y + self.board_height * self.cell_size),
                1
            )
        for y in range(self.board_height + 1):
            pygame.draw.line(
                self.screen, 
                COLORS['grid_line'], 
                (self.board_offset_x, self.board_offset_y + y * self.cell_size),
                (self.board_offset_x + self.board_width * self.cell_size, self.board_offset_y + y * self.cell_size),
                1
            )
            
        # Draw obstacles if enabled
        if self.settings.enable_obstacles:
            for obstacle in self.obstacles:
                obstacle_rect = pygame.Rect(
                    self.board_offset_x + obstacle[0] * self.cell_size,
                    self.board_offset_y + obstacle[1] * self.cell_size,
                    self.cell_size,
                    self.cell_size
                )
                
                # Draw obstacle with a rock-like appearance
                pygame.draw.rect(self.screen, COLORS.get('obstacle', (100, 100, 100)), obstacle_rect)
                
                # Add some texture to make it look like a rock/wall if cell is big enough
                if self.cell_size > 10:
                    # Draw diagonal lines for texture
                    line_color = COLORS.get('obstacle_highlight', (130, 130, 130))
                    line_width = max(1, self.cell_size // 10)
                    
                    # Draw X pattern
                    pygame.draw.line(
                        self.screen,
                        line_color,
                        (obstacle_rect.left, obstacle_rect.top),
                        (obstacle_rect.right, obstacle_rect.bottom),
                        line_width
                    )
                    pygame.draw.line(
                        self.screen,
                        line_color,
                        (obstacle_rect.left, obstacle_rect.bottom),
                        (obstacle_rect.right, obstacle_rect.top),
                        line_width
                    )
            
        # Draw power-up if present
        if self.powerup_position and self.powerup_type:
            powerup_rect = pygame.Rect(
                self.board_offset_x + self.powerup_position[0] * self.cell_size,
                self.board_offset_y + self.powerup_position[1] * self.cell_size,
                self.cell_size,
                self.cell_size
            )
            
            # Get color based on power-up type
            if self.powerup_type == 'speed_boost':
                color = COLORS['powerup_speed_boost']
            elif self.powerup_type == 'slow_motion':
                color = COLORS['powerup_slow_motion']
            elif self.powerup_type == 'size_reduction':
                color = COLORS['powerup_size_reduction']
            elif self.powerup_type == 'invincibility':
                color = COLORS['powerup_invincibility']
            elif self.powerup_type == 'double_points':
                color = COLORS['powerup_double_points']
            elif self.powerup_type == 'ghost_mode':
                color = COLORS['powerup_ghost_mode']
            elif self.powerup_type == 'shield':
                color = COLORS['powerup_shield']
            else:
                color = COLORS['white']
                
            # Draw power-up as a diamond shape
            if self.cell_size > 10:  # Only draw special shape if cell size is big enough
                center_x = powerup_rect.x + powerup_rect.width // 2
                center_y = powerup_rect.y + powerup_rect.height // 2
                size = min(powerup_rect.width, powerup_rect.height) // 2 - 2
                
                # Draw diamond shape (4 points)
                points = [
                    (center_x, center_y - size),  # Top
                    (center_x + size, center_y),  # Right
                    (center_x, center_y + size),  # Bottom
                    (center_x - size, center_y)   # Left
                ]
                
                pygame.draw.polygon(self.screen, color, points)
            else:
                # Small cell size, just draw a colored square
                pygame.draw.rect(self.screen, color, powerup_rect)
            
        # Draw fruit with correct type coloring
        if self.fruit_position:
            fruit_rect = pygame.Rect(
                self.board_offset_x + self.fruit_position[0] * self.cell_size,
                self.board_offset_y + self.fruit_position[1] * self.cell_size,
                self.cell_size,
                self.cell_size
            )
            
            # Check if we have fruit types enabled
            if hasattr(self, 'current_fruit_type') and self.settings.fruit_types_enabled:
                # Use textured fruits if cells are large enough
                if self.cell_size >= 10:
                    draw_fruit(self.screen, fruit_rect, self.current_fruit_type)
                else:
                    # For very small cells, use simple colored circles
                    center_x = fruit_rect.centerx
                    center_y = fruit_rect.centery
                    radius = self.cell_size // 2 - 1
                    
                    # Get color based on fruit type
                    fruit_color = get_fruit_color(self.current_fruit_type)
                    pygame.draw.circle(self.screen, fruit_color, (center_x, center_y), radius)
            else:
                # Just draw a regular fruit (red square)
                pygame.draw.rect(self.screen, COLORS.get('fruit', (255, 0, 0)), fruit_rect)
                    
            # Show combo indicator if combo is active and cell is big enough
            if (hasattr(self, 'combo_count') and self.combo_count > 1 and 
                self.settings.combo_fruits_enabled and self.cell_size > 15):
                combo_font = get_font(self.settings.language, 'bold', max(10, self.cell_size // 3))
                combo_text = f"{self.combo_count}x"
                text_surface = combo_font.render(combo_text, True, (255, 255, 255))
                self.screen.blit(text_surface, (fruit_rect.right - text_surface.get_width() - 2, 
                                               fruit_rect.top + 2))
                                               
        # Draw moving obstacles
        if hasattr(self, 'moving_obstacles'):
            for mo in self.moving_obstacles:
                mo_rect = pygame.Rect(
                    self.board_offset_x + mo['position'][0] * self.cell_size,
                    self.board_offset_y + mo['position'][1] * self.cell_size,
                    self.cell_size,
                    self.cell_size
                )
                
                # Draw obstacle with its color
                pygame.draw.rect(self.screen, mo['color'], mo_rect)
                
                # Add arrow to show movement direction if cell is big enough
                if self.cell_size > 15:
                    dx, dy = mo['direction']
                    
                    # Calculate arrow points
                    center_x = mo_rect.centerx
                    center_y = mo_rect.centery
                    arrow_size = max(5, self.cell_size // 4)
                    
                    # Arrow head position
                    head_x = center_x + dx * arrow_size
                    head_y = center_y + dy * arrow_size
                    
                    # Arrow tail position (opposite direction)
                    tail_x = center_x - dx * arrow_size
                    tail_y = center_y - dy * arrow_size
                    
                    # Draw the arrow
                    pygame.draw.line(self.screen, (0, 0, 0), (tail_x, tail_y), (head_x, head_y), 2)
                    
                    # Draw arrowhead
                    if dx == 0:  # Vertical arrow
                        if dy > 0:  # Down
