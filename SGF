class NetworkLobbyScreen:
    """UI for LAN host/join setup. Returns (is_host, conn, mode) or None."""

    PORT = 12345

    def __init__(self, settings, screen):
        self.settings = settings
        self.screen   = screen
        self._pending_map = None
        self._pending_seed = None
        self._seed = None

    # ── public entry-point ───────────────────────────────────────────────

    def run(self, seed=None):
        """Show mode → host/join flow. Returns (is_host, conn, mode, map, seed)."""
        self._seed = seed if seed else generate_seed()
        net_mode = self._pick_mode()
        if net_mode is None:
            return None
        while True:
            choice = self._pick_host_join()
            if choice is None:
                return None
            elif choice == 'host':
                result = self._host_flow(net_mode, self._seed)
                if result:
                    return result
            elif choice == 'join':
                result = self._join_flow(net_mode, self._seed)
                if result:
                    return result

