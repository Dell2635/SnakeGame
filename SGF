# Font cache to avoid reloading the same fonts
font_cache = {}

def get_font(language, style, size):
    """
    Get a font with the specified style and size, appropriate for the language
    
    Args:
        language (str): Language code (e.g., 'en', 'ja', 'zh')
        style (str): Font style ('regular', 'bold', 'italic', 'mono')
        size (int): Font size in points
        
    Returns:
        pygame.font.Font: A font object for rendering text
    """
    # Create a cache key
    cache_key = f"{language}_{style}_{size}"
    
    # Return cached font if available
    if cache_key in font_cache:
        return font_cache[cache_key]
    
    # Select appropriate font family based on style
    if style == 'bold':
        font = pygame.font.SysFont(None, size, bold=True)
    elif style == 'italic':
        font = pygame.font.SysFont(None, size, italic=True)
    else:
        font = pygame.font.SysFont(None, size)
    
    # Cache the font
    font_cache[cache_key] = font
    
    return font

def clear_font_cache():
    """Clear the font cache"""
    global font_cache
    font_cache = {}

