class UIAnimatedTitle(UIWidget):
    """The floating, glowing game title. Text and glow surfaces are cached; the
    animation only changes an alpha value and a y offset per frame."""
    focusable = False
    interactive = False

    def __init__(self, text, base_size, key='title'):
        super().__init__(key=key)
        self.text, self.base_size = text, base_size

    def draw(self, surface):
        r = self.rect
        if r.w <= 0 or r.h <= 0:
            return
        lang = self.lang()
        avail = max(10, r.h - 10)
        fh = get_font(lang, 'bold', self.base_size).get_height()
        size = self.base_size if fh <= avail else max(14, int(self.base_size * avail / fh))
        s = ui_text_surface(lang, 'bold', size, self.val(self.text), COLORS['white'], max(1, r.w - 20))
        if _ACCESSIBILITY_REDUCED_MOTION:
            surface.blit(s, s.get_rect(center=r.center))
            return
        t = pygame.time.get_ticks()
        gw, gh = s.get_width() + 20, s.get_height() + 20
        glow_key = (gw, gh)
        g, cached = _lru_cache_get(_ui_title_glow_cache, glow_key)
        if not cached:
            g = pygame.Surface((gw, gh), pygame.SRCALPHA)
            pygame.draw.ellipse(g, (100, 150, 255, 255), g.get_rect())
            _lru_cache_put(_ui_title_glow_cache, glow_key, g, 8)
        g.set_alpha(int(100 + 50 * math.sin(t / 1000.0)))
        y = r.y + 5 + int(math.sin(t / 800.0) * 5) + max(0, (avail - s.get_height()) // 2)
        surface.blit(g, (r.centerx - gw // 2, y - 10))
        surface.blit(s, (r.centerx - s.get_width() // 2, y))


class _SimpleMenuScreen:
    """Reusable 'title (+ optional body text) + list of buttons + Back' screen.

    Player Hub, Studio, Mods and any future top-level category page
    (MAIN MENU\\Player Hub, MAIN MENU\\Studio, MAIN MENU\\Mods, ...) build on
    this instead of each hand-rolling another one-off menu loop — the same
    fit->compress->scroll layout and full keyboard focus/navigation the Main
    Menu uses (IA1's UI foundation: UIManager/UIVerticalFlow/UIScrollView) is
    written once here. Also doubles as a plain "coming soon" placeholder
    screen when `entries` is empty and `body_fn` explains what's missing —
    so unfinished areas of the new navigation tree are still real, navigable
    screens rather than silently absent buttons.
    """

    def __init__(self, settings, screen, title_fn, entries, body_fn=None):
        """entries: list of (key, text_fn, color, handler) — same shape as
        MainMenu._menu_entries(); handler() is called on activation. A
        'Back' entry is added automatically."""
        self.settings = settings
        self.screen = screen
        self.title_fn = title_fn
        self.entries = entries
        self.body_fn = body_fn
        self.runtime = None  # set by whoever opens this, like every other sub-screen
        self.current_language = settings.language
        # Optional live preview: a subclass sets preview_draw(surface, rect)
        # and the menu then takes the left part of the window while the
        # preview fills the right part (see _preview_split()).
        if not hasattr(self, 'preview_draw'):
            self.preview_draw = None
        self._init_ui()

    def _preview_split(self):
        """(menu_width, preview_rect or None) for the current window size."""
        sw, sh = self.screen.get_size()
        if self.preview_draw is None or sw < 520:
            return sw, None
        menu_w = int(sw * 0.52)
        margin = max(12, int(sw * 0.03))
        rect = pygame.Rect(menu_w, margin, sw - menu_w - margin, sh - 2 * margin)
        return menu_w, rect

    def _init_ui(self):
        self.ui = UIManager(lambda: self.screen.get_rect(), self.settings.language)
        self.view = UIScrollView(self.screen.get_rect())
        self.ui.add(self.view)
        self._widgets = {}
        self._order = []
        self._populate_widgets()
        self._sig = None
        self._clock = pygame.time.Clock()
        self._dt = 1 / 60.0
        self._running = True
        self._build()
        w = self._widgets
        first = next((k for k in self._order if isinstance(w[k], UIButton)), 'back')
        self.ui.focus_key(first)

    def _populate_widgets(self):
        """Fill self._widgets / self._order. Subclasses that need extra
        widgets (a text field, a list of checkboxes, ...) override this —
        never _init_ui() itself, since _init_ui() calls _build() right
        after this returns and _build() is often overridden too; building
        before every widget it needs exists would crash."""
        w = self._widgets
        w['title'] = UILabel(self.title_fn, size=40, align='center', style='bold')
        self._order.append('title')
        if self.body_fn is not None:
            w['body'] = UILabel(self.body_fn, align='center', wrap=True, size=20)
            self._order.append('body')
        for key, text_fn, color, handler in self.entries:
            w[key] = UIButton(text_fn, color=color, key=key, on_activate=handler)
            self._order.append(key)
        w['back'] = UIButton(lambda: get_text(self.settings.language, 'back'),
                             color=COLORS['red'], key='back', on_activate=self._go_back)
        self._order.append('back')

    def _go_back(self):
        self._running = False

    def _build(self):
        ui, view, W = self.ui, self.view, self._widgets
        sw, sh = self.screen.get_size()
        sw, _preview_rect = self._preview_split()  # menu column width
        lang = self.settings.language
        ui.language = lang
        view.set_rect(pygame.Rect(0, 0, sw, sh))
        ref = min(sw, sh)
        font_size = max(15, min(24, int(ref * 0.04)))
        btn_h = max(36, min(60, int(sh * 0.075)))
        min_btn_h = max(26, int(btn_h * 0.66))
        gap = max(6, min(20, int(btn_h * 0.3)))
        title_size = max(28, min(52, int(ref * 0.07)))
        title_h = get_font(lang, 'bold', title_size).get_height() + 20
        W['title'].size = title_size
        widest = 0
        for k in self._order:
            b = W[k]
            if isinstance(b, UIButton):
                b.font_size = font_size
                widest = max(widest, ui_text_size(lang, 'bold', font_size, b.val(b.text))[0])
        bw = min(int(sw * 0.92), max(max(160, min(320, int(sw * 0.28))), widest + 44))
        pad_v = max(8, int(sh * 0.03))

        def build(width):
            flow = UIVerticalFlow(pygame.Rect(0, 0, width, sh), padding=(0, pad_v), spacing=gap,
                                  min_spacing=2, valign='center')
            for k in self._order:
                if k == 'title':
                    flow.add(k, title_h, min_h=int(title_h * 0.55))
                elif k == 'body':
                    body_h = W['body'].measure(bw) + 16
                    flow.add(k, body_h, min_h=int(body_h * 0.5), w=bw, gap=gap * 2, min_gap=4)
                elif k == 'back':
                    flow.add(k, btn_h, min_h=min_btn_h, w=bw, gap=gap * 2, min_gap=4)
                else:
                    flow.add(k, btn_h, min_h=min_btn_h, w=bw)
            res = flow.solve()
            for k in self._order:
                view.add(W[k], res.rects[k])
            last_child_bottom = max(
                (rect.bottom for rect in res.rects.values()), default=0)
            return max(view.viewport.h, res.content_height,
                       last_child_bottom + pad_v)

        fk = ui.focused.key if ui.focused is not None else None
        view.relayout(build)
        if fk is not None:
            ui.focus_key(fk)

    def draw(self):
        _pump_audio()
        frame_start = time.perf_counter()
        scr = self.screen
        scr.fill(COLORS['dark_blue'])
        sig = (scr.get_width(), scr.get_height(), self.settings.language)
        if sig != self._sig:
            self._sig = sig
            self._build()
        self.ui.language = self.settings.language
        self.ui.update(self._dt)
        self.ui.draw(scr)
        _menu_w, preview_rect = self._preview_split()
        if preview_rect is not None and self.preview_draw is not None:
            try:
                self.preview_draw(scr, preview_rect)
            except Exception as exc:
                sgf_log.warning('Preview draw failed: %s', type(exc).__name__)
        pygame.display.flip()
        render_ms = (time.perf_counter() - frame_start) * 1000.0
        DEV_TOOLS.telemetry.record_frame(
            max(self._dt * 1000.0, render_ms), render_ms=render_ms, ui_ms=render_ms)

    def run(self):
        self._running = True
        while self._running:
            self._dt = self._clock.tick(60) / 1000.0
            self.draw()
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit()
                    sys.exit()
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                elif (event.type == pygame.KEYDOWN and event.key == pygame.K_F8
                      and 'DEV_TOOLS' in globals() and DEV_TOOLS.unlocked):
                    DEV_TOOLS.open_panel(self.screen, game=None)
                elif (event.type == pygame.KEYDOWN and event.key == pygame.K_F9
                      and 'DEV_TOOLS' in globals() and DEV_TOOLS.unlocked):
                    DEV_TOOLS.toggle_overlay_hidden()
                else:
                    action = self.ui.handle_event(event)
                    if action == 'BACK':
                        self._running = False
                    elif action == 'TOGGLE_FULLSCREEN':
                        self.screen = _toggle_fullscreen(self.screen)
        self.current_language = self.settings.language


class ThemeEditorScreen(_SimpleMenuScreen):
    """Preview themes in place and either persist the choice or roll it back."""

    def __init__(self, settings, screen):
        self.theme_manager = THEME_MANAGER
        self.original_active_theme_id = self.theme_manager.active_theme_id
        self.original_setting_theme_id = getattr(settings, 'theme_id', 'default')
        self.preview_theme_id = self.original_active_theme_id
        self.preview_valid = True
        self.preview_error_key = None
        self.committed = False

        entries = []
        for theme_id in self.theme_manager.ids():
            theme = self.theme_manager.get(theme_id)
            theme_name = theme.name if theme else theme_id
            entries.append((
                f'theme_{theme_id}',
                lambda name=theme_name, tid=theme_id:
                    f"{safe_mark(self.settings.language, 'check')} {name}"
                    if self.preview_theme_id == tid else name,
                COLORS['blue'],
                lambda tid=theme_id: self._preview_theme(tid),
            ))
        entries.append((
            'apply_theme',
            lambda: get_text(self.settings.language, 'theme_apply'),
            COLORS['green'], self._commit_preview))
        super().__init__(
            settings, screen,
            title_fn=lambda: get_text(self.settings.language, 'theme_editor'),
            entries=entries, body_fn=self._status_text)

    def _status_text(self):
        if self.preview_error_key:
            return get_text(self.settings.language, self.preview_error_key)
        theme = self.theme_manager.get(self.preview_theme_id)
        return get_text(self.settings.language, 'theme_preview_status').format(
            theme=theme.name if theme else self.preview_theme_id)

    def _preview_theme(self, theme_id):
        try:
            applied = self.theme_manager.apply(theme_id)
            self.preview_theme_id = applied
            self.preview_valid = applied == theme_id
            self.preview_error_key = (
                None if self.preview_valid else 'theme_preview_failed')
        except Exception:
            self.preview_valid = False
            self.preview_error_key = 'theme_preview_failed'

    def _commit_preview(self):
        if not self.preview_valid:
            return
        try:
            self.settings.theme_id = self.preview_theme_id
            if self.settings.save() is False:
                raise IOError('Theme settings could not be saved')
        except Exception:
            self.settings.theme_id = self.original_setting_theme_id
            self.theme_manager.apply(self.original_active_theme_id)
            self.preview_theme_id = self.theme_manager.active_theme_id
            self.preview_valid = self.preview_theme_id == self.original_active_theme_id
            self.preview_error_key = 'theme_save_failed'
            return
        self.committed = True
        self._running = False

    def _go_back(self):
        if not self.committed:
            self.settings.theme_id = self.original_setting_theme_id
            if self.theme_manager.active_theme_id != self.original_active_theme_id:
                self.theme_manager.apply(self.original_active_theme_id)
        super()._go_back()


class CosmeticSelectionScreen(_SimpleMenuScreen):
    """Stage an appearance choice, preview it, then save or roll it back."""

    def __init__(self, settings, screen, *, title_fn, options, initial_value,
                 preview_fn, commit_fn, selected_key, extra_status_fn=None,
                 can_select_fn=None, preview_draw=None):
        self.preview_draw = preview_draw
        self.original_value = initial_value
        self.preview_value = initial_value
        self.preview_fn = preview_fn
        self.commit_fn = commit_fn
        self.selected_key = selected_key
        self.extra_status_fn = extra_status_fn
        self.can_select_fn = can_select_fn
        self.apply_error = False
        self.committed = False
        self._option_names = {value: label_fn for value, label_fn, _color in options}

        entries = []
        for value, label_fn, color in options:
            def label(value=value, label_fn=label_fn):
                name = label_fn()
                if self.preview_value == value:
                    return (f"{safe_mark(self.settings.language, 'check')} {name} · "
                            f"{get_text(self.settings.language, self.selected_key)}")
                return name
            entries.append((
                f'appearance_{value}', label, color,
                lambda value=value: self._preview_selection(value)))
        entries.append((
            'apply_selection',
            lambda: get_text(self.settings.language, 'apply_selection'),
            COLORS['green'], self._commit_selection))
        super().__init__(settings, screen, title_fn=title_fn, entries=entries,
                         body_fn=self._status_text)

    def _status_text(self):
        if self.apply_error:
            return get_text(self.settings.language, 'cosmetic_save_failed')
        label_fn = self._option_names.get(self.preview_value)
        name = label_fn() if label_fn else str(self.preview_value)
        status = get_text(self.settings.language, 'cosmetic_preview_status').format(
            name=name)
        if self.extra_status_fn:
            status += '\n' + self.extra_status_fn()
        return status

    def _preview_selection(self, value):
        if self.can_select_fn and not self.can_select_fn(value):
            return
        self.preview_fn(value)
        self.preview_value = value
        self.apply_error = False

    def _commit_selection(self):
        try:
            result = self.commit_fn(self.preview_value)
            if result is False:
                raise IOError('Appearance selection could not be saved')
        except Exception:
            self.preview_fn(self.original_value)
            self.preview_value = self.original_value
            self.apply_error = True
            return
        self.committed = True
        self._running = False

    def _go_back(self):
        if not self.committed:
            self.preview_fn(self.original_value)
            self.preview_value = self.original_value
        super()._go_back()


