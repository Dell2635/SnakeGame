    def export_graph(self, metric, path, surface_size=(900, 500)):
        rows = self.telemetry.metric_values(metric)
        surf = pygame.Surface(surface_size, pygame.SRCALPHA)
        surf.fill((12, 15, 24))
        pygame.draw.rect(surf, (50, 60, 80), surf.get_rect(), 2)
        font = get_font('en', 'bold', 22)
        title = font.render(f'{metric.upper()} — LAST 60 SECONDS', True, COLORS['white'])
        surf.blit(title, (20, 16))
        chart = pygame.Rect(60, 70, surface_size[0] - 90, surface_size[1] - 120)
        pygame.draw.rect(surf, (20, 26, 40), chart)
        now = time.perf_counter() - self.telemetry.started_at
        duration = self.telemetry.MAX_SECONDS
        for second in (0, 10, 20, 30, 40, 50, 60):
            x = chart.x + int(second / duration * max(1, chart.w - 1))
            pygame.draw.line(surf, (42, 50, 66), (x, chart.y), (x, chart.bottom - 1), 1)
            label = get_font('en', 'regular', 11).render(f'{second}s', True, (145, 155, 175))
            surf.blit(label, label.get_rect(midtop=(x, chart.bottom + 3)))
        if metric == 'frame_ms':
            rows_vals = [float(r[metric]) for r in rows if r.get(metric) is not None]
            if rows_vals:
                lo_ref, hi_ref = min(min(rows_vals), 33.33), max(max(rows_vals), 33.33)
                span_ref = max(1e-6, hi_ref - lo_ref)
                for ref_ms, label in ((16.67, '60 FPS'), (33.33, '30 FPS')):
                    yy = chart.bottom - int((ref_ms - lo_ref) / span_ref * chart.h)
                    pygame.draw.line(surf, (100, 90, 70), (chart.x, yy), (chart.right, yy), 1)
                    surf.blit(get_font('en', 'regular', 12).render(label, True, (165, 155, 135)), (chart.x + 4, max(chart.y, yy - 15)))
        if rows:
            vals = [float(r[metric]) for r in rows if r.get(metric) is not None]
            if vals:
                lo, hi = min(vals), max(vals)
                pts = _dev_graph_points(
                    rows, metric, now=now, duration=duration,
                    width=chart.w, height=chart.h, low=lo, high=hi)
                pts = [(chart.x + x, chart.y + y) for x, y in pts]
                if len(pts) > 1:
                    pygame.draw.lines(surf, (100, 220, 140), False, pts, 2)
                elif pts:
                    pygame.draw.circle(surf, (100, 220, 140), pts[0], 2)
                stats_y = surface_size[1] - 20
                surf.blit(get_font('en', 'regular', 12).render(f'Min {lo:.3f}', True, COLORS['light_gray']), (chart.x, stats_y))
                surf.blit(get_font('en', 'regular', 12).render(f'Max {hi:.3f}', True, COLORS['light_gray']), (chart.right - 90, stats_y))
        else:
            empty = get_font('en', 'regular', 14).render('No samples yet.', True, (170, 180, 195))
            surf.blit(empty, empty.get_rect(center=chart.center))
        os.makedirs(os.path.dirname(path), exist_ok=True)
        pygame.image.save(surf, path)
        return path

