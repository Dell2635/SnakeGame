        extras = [
            f"Frame spikes {snap.get('frame_spikes', 0)}",
            f"Performance incidents {snap.get('incident_count', 0)}",
            f"Max frame time {snap.get('max_frame_ms', 0.0):.2f} ms",
            f"Loaded assets {snap.get('loaded_assets', 0)}",
            f"Active entities {snap.get('active_entities', 0)}",
            f"Particles {snap.get('particles', 0)}",
