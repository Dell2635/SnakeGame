    def _handle_runtime_global_input(self, event, actions):
        """Handle the one global shortcut owned by IA5 without duplicating Action Mapping."""
        if event.type != pygame.KEYDOWN or event.key != pygame.K_F11:
            return False
        active = self.runtime.current_screen
        owner = getattr(active, 'owner', None)
        target = owner if owner is not None and hasattr(owner, 'screen') else self
        target.screen = _toggle_fullscreen(target.screen)
        self.screen = target.screen if target is self else self.screen
        self.runtime.sync_surface(target.screen)
        if active is not None and hasattr(active, 'screen'):
            active.screen = target.screen
        return True

