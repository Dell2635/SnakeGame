    def _handle_play_menu(self):
        """Play -> Singleplayer/Multiplayer. Reuses the existing config
        screens and game classes unchanged; this just adds the nested
        navigation in front of them."""
        while True:
            choice = PlayMenuScreen(self.settings, self.screen).run()

            if choice == 'singleplayer':
                while True:
                    mode = SingleplayerModeScreen(self.settings, self.screen).run()
                    if mode == 'no_ai':
                        cfg = SinglePlayerConfigScreen(self.settings, self.screen).run()
                        if cfg:
                            (chosen_seed,) = cfg
                            chosen_map = MapPickerScreen(self.settings, self.screen).run()
                            sp_game = SnakeGame(self.settings, self.screen, seed=chosen_seed, custom_map=chosen_map)
                            sp_game.player_name = self.player_name
                            sp_game.achievement_manager = self.achievement_manager
                            sp_game.run()
                            return
                        continue  # cancelled seed entry — back to No AI/With AI choice
                    elif mode == 'with_ai':
                        cfg = VSAIConfigScreen(self.settings, self.screen).run()
                        if cfg:
                            ai_count, ai_diff, seed = cfg
                            chosen_map = MapPickerScreen(self.settings, self.screen).run()
                            vs_game = VSAIGame(self.settings, self.screen,
                                     ai_count=ai_count,
                                     ai_difficulty=ai_diff,
                                     seed=seed,
                                     custom_map=chosen_map)
                            vs_game.player_name = self.player_name
                            vs_game.achievement_manager = self.achievement_manager
                            vs_game.run()
                            return
                        continue  # cancelled AI setup — back to No AI/With AI choice
                    else:
                        break  # mode is None (back) — return to the Play menu

            elif choice == 'multiplayer':
                mp_result = self.multiplayer_screen.run()
                if mp_result is None:
                    pass  # user cancelled — loop back to the Play menu
                elif mp_result[0] == 'network':
                    _mp_seed = mp_result[1] if len(mp_result) > 1 else generate_seed()
                    self.network_lobby.screen = self.screen
                    result = self.network_lobby.run()
                    if result:
                        is_host, conn, net_mode, net_custom_map = result
                        ng = NetworkGame(self.settings, self.screen,
                                         is_host, conn, net_mode, custom_map=net_custom_map)
                        ng.run()
                    return
                else:
                    mp_mode = mp_result[0]
                    mp_seed = mp_result[1] if len(mp_result) > 1 else generate_seed()
                    chosen_map = MapPickerScreen(self.settings, self.screen).run()
                    mp_game = MultiplayerGame(
                        self.settings, self.screen, mp_mode, seed=mp_seed, custom_map=chosen_map)
                    mp_game.run()
                    return

            else:
                # choice is None — user backed all the way out of Play
                return
    
    def run(self):
        """Main game loop"""
        running = True
        
        while running:
            play_rect, highscores_rect, settings_rect, achievements_rect, credits_rect, exit_rect, input_rect, map_editor_rect, encyclopedia_rect = self.draw_menu()
            # Initialize the achievement manager in case it doesn't exist yet
            if not hasattr(self, 'achievement_manager'):
                self.achievement_manager = AchievementManager()
                self.achievement_manager.load_state()
            
            # Check for language change
            if self.current_language != self.settings.language:
                self.current_language = self.settings.language
                
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                    
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    mouse_pos = event.pos
                    
                    # Check button clicks
                    if play_rect.collidepoint(mouse_pos):
                        if not self.player_name.strip():
                            # Flash the name input to indicate it's required
                            self.name_input_active = True
                        else:
                            self._handle_play_menu()

                    elif highscores_rect.collidepoint(mouse_pos):
                        self.highscores_screen.run()
                        
                    elif settings_rect.collidepoint(mouse_pos):
                        self.settings_screen.run()
                        
                    elif achievements_rect.collidepoint(mouse_pos):
                        self.show_achievements()
                        
                    elif map_editor_rect.collidepoint(mouse_pos):
                        MapEditorScreen(self.settings, self.screen).run()
                        
                    elif encyclopedia_rect.collidepoint(mouse_pos):
                        EncyclopediaScreen(self.settings, self.screen).run()
                        
                    elif credits_rect.collidepoint(mouse_pos):
                        self.show_credits()
                        
                    elif exit_rect.collidepoint(mouse_pos):
                        running = False
                        
                    elif input_rect.collidepoint(mouse_pos):
                        self.name_input_active = True
                    else:
                        self.name_input_active = False
                        
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_F11:
                        self.screen = _toggle_fullscreen(self.screen)
                    elif self.name_input_active:
                        if event.key == pygame.K_RETURN:
                            self.name_input_active = False
                        elif event.key == pygame.K_BACKSPACE:
                            self.player_name = self.player_name[:-1]
                            self.save_player_name()  # Save name on change
                        elif len(self.player_name) < 15:  # Limit name length
                            self.player_name += event.unicode
                            self.save_player_name()  # Save name on change
                            
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
            
            # Draw achievement notifications
            if self.achievement_manager:
                self.achievement_manager.draw_notification(self.screen, self.screen.get_width(), self.screen.get_height(), self.settings.language)
            # Cap the frame rate
            pygame.time.Clock().tick(60)
            
        pygame.quit()
        sys.exit()

##############
# STARTUP ENVIRONMENT CHECK
##############
# Verifies the runtime environment (Python, pygame, and any other required
# dependency) before the main menu launches. "Required" issues must be
# resolved, or the player must explicitly choose to close the game.
# "Optional" issues can be installed now or deferred with a cooldown; a
# deferred optional issue is shown again immediately if it later becomes
# required (i.e. the minimum version was raised past what was deferred).

_REQUIRED_PYTHON_VERSION = (3, 8)        # minimum Python version the game needs
_REQUIRED_PYGAME_VERSION = (2, 0, 0)     # minimum pygame version the game needs
_RECOMMENDED_PYGAME_VERSION = (2, 5, 0)  # newer pygame: recommended, not required
_DEFAULT_REMIND_DAYS = 7
_STARTUP_CHECK_DATA_KEY = 'startup_check'  # section name inside the unified save file


def _parse_version_string(version_str):
    """Parse a dotted version string like '2.5.2' into a tuple of ints (2, 5, 2)."""
    parts = []
    for chunk in str(version_str).split('.'):
        digits = ''
        for ch in chunk:
            if ch.isdigit():
                digits += ch
            else:
                break
        parts.append(int(digits) if digits else 0)
    return tuple(parts) if parts else (0,)


def _version_tuple_to_str(version_tuple):
    return '.'.join(str(part) for part in version_tuple)


def _collect_environment_issues():
    """Check the runtime environment and return a list of issue dicts."""
    issues = []

    # --- Python interpreter version ---
    current_py = sys.version_info[:2]
    if current_py < _REQUIRED_PYTHON_VERSION:
        issues.append({
            'id': 'python',
            'title': 'Python',
            'message': (
                f"This game needs Python {_version_tuple_to_str(_REQUIRED_PYTHON_VERSION)}+ "
                f"to run. You currently have Python {_version_tuple_to_str(current_py)}."
            ),
            'required_str': _version_tuple_to_str(_REQUIRED_PYTHON_VERSION),
            'level': 'required',
            'action': 'browser',
            'url': 'https://www.python.org/downloads/',
        })

    # --- pygame version ---
    try:
        current_pg_str = pygame.version.ver
    except Exception:
        current_pg_str = '0.0.0'
    current_pg = _parse_version_string(current_pg_str)

    if current_pg < _REQUIRED_PYGAME_VERSION:
        issues.append({
            'id': 'pygame',
            'title': 'pygame',
            'message': (
                f"This game needs pygame {_version_tuple_to_str(_REQUIRED_PYGAME_VERSION)}+ "
                f"to run. You currently have pygame {current_pg_str}."
            ),
            'required_str': _version_tuple_to_str(_REQUIRED_PYGAME_VERSION),
            'level': 'required',
            'action': 'pip',
            'pip_package': 'pygame',
        })
    elif current_pg < _RECOMMENDED_PYGAME_VERSION:
        issues.append({
            'id': 'pygame',
            'title': 'pygame update available',
            'message': (
                f"A newer pygame ({_version_tuple_to_str(_RECOMMENDED_PYGAME_VERSION)}+) is "
                f"recommended for the best experience. You have pygame {current_pg_str}."
            ),
            'required_str': _version_tuple_to_str(_RECOMMENDED_PYGAME_VERSION),
            'level': 'optional',
            'action': 'pip',
            'pip_package': 'pygame',
        })

    # --- fontTools (optional): improves Unicode font selection so non-Latin
    # text (Arabic, Thai, Hindi, etc.) picks a font that actually has the
    # needed glyphs instead of showing broken-glyph squares ---
    if not _FONTTOOLS_AVAILABLE:
        issues.append({
            'id': 'fonttools',
            'title': 'fontTools (better Unicode text)',
            'message': (
                "Installing the fontTools library lets the game verify which fonts "
                "actually support each language's characters, avoiding broken-glyph "
                "squares for scripts like Arabic, Thai, or Hindi. The game works "
                "without it, with slightly less reliable font selection for those languages."
            ),
            'required_str': 'any',
            'level': 'optional',
            'action': 'pip',
            'pip_package': 'fonttools',
        })

    return issues


def _load_startup_defer_data():
    try:
        gd = _load_data()
        return gd.get(_STARTUP_CHECK_DATA_KEY, {})
    except Exception:
        return {}


def _save_startup_defer(issue_id, required_str, remind_days=_DEFAULT_REMIND_DAYS):
    try:
        gd = _load_data()
        section = gd.get(_STARTUP_CHECK_DATA_KEY, {})
        section[issue_id] = {
            'deferred_for_version': required_str,
            'remind_until': (datetime.now() + timedelta(days=remind_days)).isoformat(),
        }
        gd[_STARTUP_CHECK_DATA_KEY] = section
        _save_data(gd)
    except Exception as e:
        print(f"Error saving startup-check deferral: {e}")


def _issue_is_currently_deferred(issue, defer_data):
    """An optional issue stays hidden while a deferral is active for the same
    requirement. If the requirement changed (e.g. escalated to 'required' or the
    minimum version was raised) the deferral no longer applies."""
    if issue['level'] != 'optional':
        return False
    record = defer_data.get(issue['id'])
    if not record:
        return False
    if record.get('deferred_for_version') != issue['required_str']:
        return False
    try:
        remind_until = datetime.fromisoformat(record['remind_until'])
    except Exception:
        return False
    return datetime.now() < remind_until


class _StartupDialogButton:
    def __init__(self, rect, label, color, hover_color):
        self.rect = rect
        self.label = label
        self.color = color
        self.hover_color = hover_color

    def draw(self, surface, font, mouse_pos):
        hovered = self.rect.collidepoint(mouse_pos)
        pygame.draw.rect(surface, self.hover_color if hovered else self.color, self.rect, border_radius=6)
        pygame.draw.rect(surface, COLORS['white'], self.rect, width=1, border_radius=6)
        text = font.render(self.label, True, COLORS['white'])
        surface.blit(text, text.get_rect(center=self.rect.center))


def _wrap_text(text, font, max_width):
    words = text.split(' ')
    lines = []
    current = ''
    for word in words:
        trial = f"{current} {word}".strip()
        if font.size(trial)[0] <= max_width:
            current = trial
        else:
            if current:
                lines.append(current)
            current = word
    if current:
        lines.append(current)
    return lines


class StartupCheckDialog:
    """A small, self-contained modal pygame loop used only at startup, before
    Settings/MainMenu exist. Runs its own tiny window and event loop so it never
    blocks or freezes regardless of how long an install takes (installs run on a
    background thread while this loop keeps rendering/pumping events)."""

    def __init__(self):
        self.screen = pygame.display.set_mode((640, 420), pygame.RESIZABLE)
        pygame.display.set_caption("Snake Game — Startup Check")
        self.clock = pygame.time.Clock()
        self.title_font = pygame.font.SysFont(None, 30, bold=True)
        self.body_font = pygame.font.SysFont(None, 22)
        self.button_font = pygame.font.SysFont(None, 22, bold=True)

    def _run_install_thread(self, issue, result_holder):
        try:
            if issue['action'] == 'pip':
                subprocess.check_call([
                    sys.executable, '-m', 'pip', 'install', '--upgrade', issue['pip_package']
                ])
                result_holder['success'] = True
            elif issue['action'] == 'browser':
                webbrowser.open(issue['url'])
                result_holder['success'] = True  # we can't verify a manual install; treat as handled
            else:
                result_holder['success'] = False
                result_holder['error'] = 'No install action available.'
        except Exception as e:
            result_holder['success'] = False
            result_holder['error'] = str(e)
        finally:
            result_holder['done'] = True

    def _perform_install(self, issue):
        """Runs the install/update action on a background thread while keeping
        this dialog's event loop alive, so the UI never appears frozen."""
        result_holder = {'done': False, 'success': False, 'error': None}
        thread = threading.Thread(target=self._run_install_thread, args=(issue, result_holder), daemon=True)
        thread.start()

        dots = 0
        while not result_holder['done']:
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit()
                    sys.exit()
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)

            self.screen.fill(COLORS['dark_blue'])
            w, h = self.screen.get_size()
            dots = (dots + 1) % 90
            msg = f"Installing/updating {issue['title']}" + '.' * (1 + dots // 30)
            text = self.body_font.render(msg, True, COLORS['white'])
            self.screen.blit(text, text.get_rect(center=(w // 2, h // 2)))
            pygame.display.flip()
            self.clock.tick(30)

        return result_holder

    def _show_message(self, title, lines, buttons):
        """Generic modal: draws a title, wrapped body lines, and a row of
        buttons; returns the .label of whichever button was clicked, or None
        if the window was resized (loop just continues)."""
        while True:
            mouse_click_pos = None
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    pygame.quit()
                    sys.exit()
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                    # Left click only — this dialog never treats right-click,
                    # middle-click, or the scroll wheel as activation.
                    mouse_click_pos = event.pos
                elif event.type == pygame.KEYDOWN:
                    if event.key in (pygame.K_y, pygame.K_RETURN) and len(buttons) >= 1:
                        return buttons[0].label
                    elif event.key in (pygame.K_n, pygame.K_ESCAPE) and len(buttons) >= 2:
                        return buttons[1].label

            w, h = self.screen.get_size()
            self.screen.fill(COLORS['dark_blue'])

            title_surf = self.title_font.render(title, True, COLORS['white'])
            self.screen.blit(title_surf, (w // 2 - title_surf.get_width() // 2, 40))

            y = 100
            for line in lines:
                line_surf = self.body_font.render(line, True, COLORS['light_gray'])
                self.screen.blit(line_surf, (w // 2 - line_surf.get_width() // 2, y))
                y += 28

            # Lay out buttons evenly, never overlapping regardless of window size.
            btn_w, btn_h = 190, 46
            spacing = 20
            total_w = len(buttons) * btn_w + (len(buttons) - 1) * spacing
            start_x = w // 2 - total_w // 2
            btn_y = max(y + 40, h - btn_h - 40)
            mouse_pos = pygame.mouse.get_pos()
            for i, button in enumerate(buttons):
                button.rect = pygame.Rect(start_x + i * (btn_w + spacing), btn_y, btn_w, btn_h)
                button.draw(self.screen, self.button_font, mouse_pos)
                if mouse_click_pos and button.rect.collidepoint(mouse_click_pos):
                    return button.label

            pygame.display.flip()
            self.clock.tick(60)

    def resolve_issue(self, issue):
        """Runs the full flow for a single issue. Returns once it's resolved
        (installed, deferred, or — for required issues — the game is closed)."""
        if issue['level'] == 'required':
            while True:
                choice = self._show_message(
                    f"{issue['title']} needs an update",
                    _wrap_text(issue['message'], self.body_font, 560) + ['', 'Install/update now?'],
                    [
                        _StartupDialogButton(pygame.Rect(0, 0, 0, 0), 'Yes', COLORS['green'], COLORS['button_hover']),
                        _StartupDialogButton(pygame.Rect(0, 0, 0, 0), 'No', COLORS['button'], COLORS['button_hover']),
                    ],
                )
                if choice == 'Yes':
                    result = self._perform_install(issue)
                    if result['success']:
                        return
                    # Install failed — loop back and ask again (still required).
                    self._show_message(
                        "Update failed",
                        _wrap_text(f"Could not update {issue['title']}: {result.get('error', 'unknown error')}",
                                   self.body_font, 560),
                        [_StartupDialogButton(pygame.Rect(0, 0, 0, 0), 'OK', COLORS['button'], COLORS['button_hover'])],
                    )
                    continue
                else:
                    # User said no — this is required, so ask once more: install or close.
                    final_choice = self._show_message(
                        f"{issue['title']} is required",
                        [f"The game can't run correctly without this update."],
                        [
                            _StartupDialogButton(pygame.Rect(0, 0, 0, 0), 'Install Now', COLORS['green'], COLORS['button_hover']),
                            _StartupDialogButton(pygame.Rect(0, 0, 0, 0), 'Close Game', COLORS['red'], COLORS['button_hover']),
                        ],
                    )
                    if final_choice == 'Install Now':
                        result = self._perform_install(issue)
                        if result['success']:
                            return
                        continue  # failed again — loop back to the top-level yes/no
                    else:
                        pygame.quit()
                        sys.exit()
        else:
            # Optional issue: Install now, or remind me later.
            choice = self._show_message(
                issue['title'],
                _wrap_text(issue['message'], self.body_font, 560),
                [
                    _StartupDialogButton(pygame.Rect(0, 0, 0, 0), 'Install Now', COLORS['green'], COLORS['button_hover']),
                    _StartupDialogButton(pygame.Rect(0, 0, 0, 0), f'Remind in {_DEFAULT_REMIND_DAYS}d', COLORS['button'], COLORS['button_hover']),
                ],
            )
            if choice == 'Install Now':
                result = self._perform_install(issue)
                if result['success'] and issue['id'] == 'fonttools':
                    _activate_fonttools_if_installed()
                if not result['success']:
                    self._show_message(
                        "Update failed",
                        _wrap_text(f"Could not update {issue['title']}: {result.get('error', 'unknown error')}. "
                                   f"You can try again from a future startup.", self.body_font, 560),
                        [_StartupDialogButton(pygame.Rect(0, 0, 0, 0), 'OK', COLORS['button'], COLORS['button_hover'])],
                    )
                    _save_startup_defer(issue['id'], issue['required_str'], remind_days=1)
            else:
                _save_startup_defer(issue['id'], issue['required_str'])


def run_startup_environment_check():
    """Entry point called once before MainMenu is created. Silently does
    nothing if the environment is fine — no dialog is ever shown unless
    there's an actual issue, so normal startup is never slowed down."""
    issues = _collect_environment_issues()
    if not issues:
        return

    defer_data = _load_startup_defer_data()
    pending = [issue for issue in issues if not _issue_is_currently_deferred(issue, defer_data)]
    if not pending:
        return

    dialog = StartupCheckDialog()
    for issue in pending:
        dialog.resolve_issue(issue)


